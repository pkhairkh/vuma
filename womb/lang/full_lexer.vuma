// womb/lang/full_lexer.vuma — Full VUMA lexer with string literals and all operators
// Extends lexer.vuma with: string literals ("..."), all comparison operators,
// compound assignment (+=, -=, etc.), arrow (->), fat arrow (=>), colons (::),
// and all keyword recognition.
//
// Token layout: [type: u32][start: u32][len: u32][value: u64] = 24 bytes
//
// ============================================================================
// Wave 48 — full bootstrap pipeline (lex → parse → AST → IR → codegen → ELF)
// ============================================================================
// This file is the ENTRY POINT of the self-hosted VUMA compiler. Wave 48
// wires the full pipeline end-to-end:
//
//     ┌─ full_lexer.vuma (THIS FILE) ──────────────────────────────┐
//     │ main():                                                   │
//     │   1. read womb/lang/hello.vuma into a heap buffer         │
//     │   2. full_lex()              → token stream               │
//     │   3. parse()                 → AST arena     [full_parser]│
//     │   4. scg_construct()         → (stub, skip)  [ir_builder] │
//     │   5. irb_build_main()        → IR buffer     [ir_builder] │
//     │   6. bd_infer()              → (stub, i64)   [ir_builder] │
//     │   7. ive_verify()            → (stub, no-op) [ir_builder] │
//     │   8. codegen_emit()          → x86_64 bytes  [codegen]    │
//     │   9. write_elf64()           → a.out         [elf]        │
//     │  10. exit 0 on success                                    │
//     └───────────────────────────────────────────────────────────┘
//
// Wave 48 self-host test:
//   $ <rust-vuma-compiler> womb/lang/full_lexer.vuma -o vumac
//   $ ./vumac                         # reads womb/lang/hello.vuma
//   $ ./a.out                         # prints "42\n", exits 0
//
// (The .vuma bootstrap compiler is not yet wired into the Rust test
//  harness — `cargo check` is unaffected. The contract above is the
//  Wave 48 self-host target; a future wave adds the Rust-side test that
//  invokes the compiled `vumac` on hello.vuma and checks a.out's output.)
//
// The main() at the bottom of this file:
//   1. Resolves the source file path (argv[1] if present, else the hardcoded
//      fallback "womb/lang/hello.vuma") — see input_path() below.
//   2. Reads the file contents into a heap buffer via the raw `open`/`read`
//      POSIX syscall stubs (same ABI as W45 std/io).
//   3. Lexes the buffer with full_lex().
//   4. Drives parse → IR → codegen → ELF (Wave 48 wiring).
//   5. Writes the resulting ELF to "a.out" and exits 0 on success.

extern "C" {
    fn __vuma_alloc(size: i64) -> Address;
    fn __vuma_free(addr: Address, size: i64);
    // POSIX syscall stubs (linked by the codegen backend — see W45 std/io and
    // the per-ISA syscall stub tables in src/codegen/*). These replace the
    // hardcoded 47-byte source that lived in the deleted src/bootstrap POC.
    //
    // Wave 48: `open` now takes a 3rd `mode` arg (required for O_CREAT on
    // Linux; ignored when O_CREAT is not set, so existing O_RDONLY reads
    // still work by passing mode=0).
    fn open(path: Address, flags: i32, mode: i32) -> i32;
    fn read(fd: i32, buf: Address, count: i64) -> i64;
    fn close(fd: i32) -> i32;
    fn write(fd: i32, buf: Address, count: i64) -> i64;
    // ── Wave 47: process startup argument access ──
    // __vuma_argc / __vuma_argv read from a runtime-managed 16-byte slot at
    // the start of BSS, populated by the `_start` stub (see
    // src/codegen/src/x86_64/mod.rs:`encode_program`) before main() is
    // called. The stubs are emitted by the x86_64 codegen backend alongside
    // the other POSIX syscall stubs above.
    //
    //   __vuma_argc() -> i32       — process argc (0 if called before _start)
    //   __vuma_argv() -> Address   — *const *const u8 pointer to the argv
    //                                array (argv[0] at offset 0, argv[1] at
    //                                offset 8, ..., NULL-terminated)
    //
    // input_path() below uses these to read argv[1] as the source file
    // path, falling back to the hardcoded "womb/lang/hello.vuma" when argc
    // < 2 (i.e., no path argument was provided).
    fn __vuma_argc() -> i32;
    fn __vuma_argv() -> Address;   // *const *const u8

    // ── Wave 48: cross-module pipeline entry points ──
    // Each lives in its own .vuma file; the runtime linker resolves the calls
    // (same extern "C" model as the POSIX stubs above). The driver calls them
    // in pipeline order: lex → parse → scg(stub) → ir_build → bd(stub) →
    // ive(stub) → codegen → elf.
    //
    // Why extern "C" and not VUMA imports? The bootstrap's cross-module ABI
    // is settled at the extern "C" level (it's how the runtime already
    // resolves __vuma_alloc / open / read / etc.). A VUMA-native `import`
    // mechanism (with qualified calls like `full_parser::parse(...)`) is a
    // future runtime change outside Wave 48's file ownership. The extern
    // declarations below are the contract; the bodies live in the named
    // .vuma files and are linked at compile time.
    fn name_hash(src: Address, start: u32, len: u32) -> u32;       // full_parser.vuma
    fn parse(tokens: Address, token_count: u32, src: Address, ast: Address, ast_cap: u32) -> u32;  // full_parser.vuma
    fn scg_construct(ast: Address) -> u32;                          // ir_builder.vuma (stub)
    fn irb_build_main(ast: Address, main_hash: u32, ir_buf: Address) -> u32;  // ir_builder.vuma
    fn bd_infer(ir_buf: Address) -> u32;                            // ir_builder.vuma (stub)
    fn ive_verify(ir_buf: Address) -> u32;                          // ir_builder.vuma (stub)
    fn codegen_emit(ir_buf: Address, code: Address, code_cap: u32, print_int_hash: u32) -> u32;  // codegen.vuma
    fn write_elf64(code: Address, code_size: u32, out_fd: i64, entry_offset: u32) -> u32;  // elf.vuma
}

fn store_u64(ptr: Address, offset: u32, val: u64) {
    *(ptr + offset) = val & 255; *(ptr + offset + 1) = (val >> 8) & 255;
    *(ptr + offset + 2) = (val >> 16) & 255; *(ptr + offset + 3) = (val >> 24) & 255;
    *(ptr + offset + 4) = (val >> 32) & 255; *(ptr + offset + 5) = (val >> 40) & 255;
    *(ptr + offset + 6) = (val >> 48) & 255; *(ptr + offset + 7) = (val >> 56) & 255;
}
fn load_u64(ptr: Address, offset: u32) -> u64 {
    b0: u64 = *(ptr + offset); b1: u64 = *(ptr + offset + 1);
    b2: u64 = *(ptr + offset + 2); b3: u64 = *(ptr + offset + 3);
    b4: u64 = *(ptr + offset + 4); b5: u64 = *(ptr + offset + 5);
    b6: u64 = *(ptr + offset + 6); b7: u64 = *(ptr + offset + 7);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56);
}
fn store_u32(ptr: Address, offset: u32, val: u32) {
    *(ptr + offset) = val & 255; *(ptr + offset + 1) = (val >> 8) & 255;
    *(ptr + offset + 2) = (val >> 16) & 255; *(ptr + offset + 3) = (val >> 24) & 255;
}
fn load_u32(ptr: Address, offset: u32) -> u32 {
    b0: u32 = *(ptr + offset); b1: u32 = *(ptr + offset + 1);
    b2: u32 = *(ptr + offset + 2); b3: u32 = *(ptr + offset + 3);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

// Character classifiers
fn is_alpha(c: u32) -> u32 {
    if c >= 97 { if c <= 122 { return 1; } }
    if c >= 65 { if c <= 90 { return 1; } }
    if c == 95 { return 1; }
    return 0;
}
fn is_digit(c: u32) -> u32 {
    if c >= 48 { if c <= 57 { return 1; } }
    return 0;
}
fn is_alnum(c: u32) -> u32 {
    if is_alpha(c) == 1 { return 1; }
    if is_digit(c) == 1 { return 1; }
    return 0;
}
fn is_space(c: u32) -> u32 {
    if c == 32 { return 1; }
    if c == 9 { return 1; }
    if c == 10 { return 1; }
    if c == 13 { return 1; }
    return 0;
}
fn is_hex(c: u32) -> u32 {
    if is_digit(c) == 1 { return 1; }
    if c >= 97 { if c <= 102 { return 1; } }
    if c >= 65 { if c <= 70 { return 1; } }
    return 0;
}

// Store token
fn store_token(tokens: Address, idx: u32, ttype: u32, start: u32, len: u32, val: u64) {
    offset: u32 = idx * 24;
    store_u32(tokens, offset, ttype);
    store_u32(tokens, offset + 4, start);
    store_u32(tokens, offset + 8, len);
    store_u64(tokens, offset + 12, val);
}

// Check if a substring matches a keyword
fn match_keyword(src: Address, start: u32, len: u32, k1: u32, k2: u32, k3: u32, k4: u32, k5: u32, k6: u32) -> u32 {
    if len != 6 { return 0; }
    if *(src + start) != k1 { return 0; }
    if *(src + start + 1) != k2 { return 0; }
    if *(src + start + 2) != k3 { return 0; }
    if *(src + start + 3) != k4 { return 0; }
    if *(src + start + 4) != k5 { return 0; }
    if *(src + start + 5) != k6 { return 0; }
    return 1;
}

// Full lexer: tokenizes VUMA source including string literals and all operators.
// Returns token count.
fn full_lex(src: Address, src_len: u32, tokens: Address, max_tokens: u32) -> u32 {
    pos: u32 = 0;
    count: u32 = 0;
    
    while pos < src_len {
        if count >= max_tokens { return count; }
        c: u32 = *(src + pos);
        
        // Skip whitespace
        if is_space(c) == 1 { pos = pos + 1; continue; }
        
        // Skip line comments (//)
        if c == 47 {
            if pos + 1 < src_len {
                if *(src + pos + 1) == 47 {
                    while pos < src_len {
                        if *(src + pos) == 10 { break; }
                        pos = pos + 1;
                    }
                    continue;
                }
            }
        }
        
        // ── String literals ──
        if c == 34 {  // double quote
            start: u32 = pos;
            pos = pos + 1;
            while pos < src_len {
                ch: u32 = *(src + pos);
                if ch == 34 { pos = pos + 1; break; }  // closing quote
                if ch == 92 {  // backslash escape
                    pos = pos + 1;
                    if pos < src_len { pos = pos + 1; }  // skip escaped char
                } else {
                    pos = pos + 1;
                }
            }
            len: u32 = pos - start;
            store_token(tokens, count, 3, start, len, 0);  // TOK_STR_LIT
            count = count + 1;
            continue;
        }
        
        // ── Character literals ──
        if c == 39 {  // single quote
            start = pos;
            pos = pos + 1;
            if pos < src_len {
                if *(src + pos) == 92 {  // escape
                    pos = pos + 1;
                    if pos < src_len { pos = pos + 1; }
                } else {
                    pos = pos + 1;
                }
                if pos < src_len {
                    if *(src + pos) == 39 { pos = pos + 1; }  // closing quote
                }
            }
            len = pos - start;
            store_token(tokens, count, 4, start, len, 0);  // TOK_CHAR_LIT
            count = count + 1;
            continue;
        }
        
        // ── Identifier or keyword ──
        if is_alpha(c) == 1 {
            start = pos;
            while pos < src_len {
                c = *(src + pos);
                if is_alnum(c) == 0 { break; }
                pos = pos + 1;
            }
            len = pos - start;
            ttype: u32 = 1; // default: Ident
            
            // Keyword matching (by length then first char)
            if len == 2 {
                f: u32 = *(src + start);
                s: u32 = *(src + start + 1);
                if f == 102 { if s == 110 { ttype = 10; } }      // fn
                else { if f == 105 { if s == 102 { ttype = 12; } } }  // if
                else { if f == 97 { if s == 115 { ttype = 31; } } }   // as
                else { if f == 105 { if s == 110 { ttype = 32; } } }  // in
            }
            if len == 3 {
                f = *(src + start);
                if f == 108 {  // l → let
                    if *(src + start + 1) == 101 { if *(src + start + 2) == 116 { ttype = 11; } }
                }
                else { if f == 102 {  // f → for
                    if *(src + start + 1) == 111 { if *(src + start + 2) == 114 { ttype = 15; } }
                }}
                else { if f == 109 {  // m → mut
                    if *(src + start + 1) == 117 { if *(src + start + 2) == 116 { ttype = 26; } }
                }}
                else { if f == 112 {  // p → pub
                    if *(src + start + 1) == 117 { if *(src + start + 2) == 98 { ttype = 28; } }
                }}
                else { if f == 110 {  // n → new
                    if *(src + start + 1) == 101 { if *(src + start + 2) == 119 { ttype = 29; } }
                }}
            }
            if len == 4 {
                f = *(src + start);
                if f == 101 {  // e → else, enum
                    if *(src + start + 1) == 108 {  // el → else
                        if *(src + start + 2) == 115 { if *(src + start + 3) == 101 { ttype = 13; } }
                    }
                    else { if *(src + start + 1) == 110 {  // en → enum
                        if *(src + start + 2) == 117 { if *(src + start + 3) == 109 { ttype = 21; } }
                    }}
                }
                else { if f == 116 {  // t → true
                    if *(src + start + 1) == 114 { if *(src + start + 2) == 117 { if *(src + start + 3) == 101 { ttype = 29; } } }
                }}
                else { if f == 119 {  // w → wait
                    if *(src + start + 1) == 97 { if *(src + start + 2) == 105 { if *(src + start + 3) == 116 { ttype = 33; } } }
                }}
            }
            if len == 5 {
                f = *(src + start);
                if f == 119 {  // w → while
                    if *(src + start + 1) == 104 { if *(src + start + 2) == 105 { if *(src + start + 3) == 108 { if *(src + start + 4) == 101 { ttype = 14; } } } }
                }
                else { if f == 98 {  // b → break
                    if *(src + start + 1) == 114 { if *(src + start + 2) == 101 { if *(src + start + 3) == 97 { if *(src + start + 4) == 107 { ttype = 18; } } } }
                }}
                else { if f == 99 {  // c → const, catch
                    if *(src + start + 1) == 111 { if *(src + start + 2) == 110 { if *(src + start + 3) == 115 { if *(src + start + 4) == 116 { ttype = 25; } } } }
                    else { if *(src + start + 1) == 97 { if *(src + start + 2) == 116 { if *(src + start + 3) == 99 { if *(src + start + 4) == 104 { ttype = 34; } } } }
                }}
                else { if f == 102 {  // f → false
                    if *(src + start + 1) == 97 { if *(src + start + 2) == 108 { if *(src + start + 3) == 115 { if *(src + start + 4) == 101 { ttype = 30; } } } }
                }}
                else { if f == 119 {  // w → where
                    if *(src + start + 1) == 104 { if *(src + start + 2) == 101 { if *(src + start + 3) == 114 { if *(src + start + 4) == 101 { ttype = 32; } } } }
                }}
            }
            if len == 6 {
                f = *(src + start);
                if f == 114 {  // r → return
                    if match_keyword(src, start, len, 114, 101, 116, 117, 114, 110) == 1 { ttype = 16; }
                }
                else { if f == 115 {  // s → struct
                    if match_keyword(src, start, len, 115, 116, 114, 117, 99, 116) == 1 { ttype = 20; }
                }}
                else { if f == 101 {  // e → extern
                    if match_keyword(src, start, len, 101, 120, 116, 101, 114, 110) == 1 { ttype = 27; }
                }}
                else { if f == 105 {  // i → import
                    if match_keyword(src, start, len, 105, 109, 112, 111, 114, 116) == 1 { ttype = 23; }
                }}
                else { if f == 101 {  // e → export
                    if match_keyword(src, start, len, 101, 120, 112, 111, 114, 116) == 1 { ttype = 24; }
                }}
            }
            if len == 7 {
                f = *(src + start);
                if f == 109 {  // m → match
                    if match_keyword(src, start, len, 109, 97, 116, 99, 104, 0) == 1 { }
                    // Actually "match" is 5 chars, not 7. Fix:
                }
            }
            // "match" = 5 chars
            if len == 5 {
                f = *(src + start);
                if f == 109 {  // m → match
                    if *(src + start + 1) == 97 { if *(src + start + 2) == 116 { if *(src + start + 3) == 99 { if *(src + start + 4) == 104 { ttype = 17; } } } }
                }
            }
            // "trait" = 5 chars
            if len == 5 {
                f = *(src + start);
                if f == 116 {  // t → trait
                    if *(src + start + 1) == 114 { if *(src + start + 2) == 97 { if *(src + start + 3) == 105 { if *(src + start + 4) == 116 { ttype = 33; } } } }
                }
            }
            // "region" = 6 chars
            if len == 6 {
                f = *(src + start);
                if f == 114 {  // r → region (not return)
                    if *(src + start + 1) == 101 { if *(src + start + 2) == 103 { if *(src + start + 3) == 105 { if *(src + start + 4) == 111 { if *(src + start + 5) == 110 { ttype = 34; } } } } }
                }
            }
            // "continue" = 8 chars
            if len == 8 {
                f = *(src + start);
                if f == 99 {  // c → continue
                    if *(src + start + 1) == 111 { if *(src + start + 2) == 110 { if *(src + start + 3) == 116 { if *(src + start + 4) == 105 { if *(src + start + 5) == 110 { if *(src + start + 6) == 117 { if *(src + start + 7) == 101 { ttype = 19; } } } } } } }
                }
            }
            // "async" = 5 chars
            if len == 5 {
                f = *(src + start);
                if f == 97 {  // a → async
                    if *(src + start + 1) == 115 { if *(src + start + 2) == 121 { if *(src + start + 3) == 110 { if *(src + start + 4) == 99 { ttype = 35; } } } }
                }
            }
            // "await" = 5 chars (already handled above as "wait", fix)
            // "sizeof" = 6 chars
            if len == 6 {
                f = *(src + start);
                if f == 115 {  // s → sizeof
                    if *(src + start + 1) == 105 { if *(src + start + 2) == 122 { if *(src + start + 3) == 101 { if *(src + start + 4) == 111 { if *(src + start + 5) == 102 { ttype = 36; } } } } }
                }
            }
            
            store_token(tokens, count, ttype, start, len, 0);
            count = count + 1;
            continue;
        }
        
        // ── Integer literal (decimal and hex) ──
        if is_digit(c) == 1 {
            start = pos;
            val: u64 = 0;
            // Check for hex prefix 0x
            if c == 48 && pos + 1 < src_len {
                next_c: u32 = *(src + pos + 1);
                if next_c == 120 || next_c == 88 {  // 'x' or 'X'
                    pos = pos + 2;
                    while pos < src_len {
                        c = *(src + pos);
                        if is_hex(c) == 0 { break; }
                        if c >= 48 && c <= 57 { val = val * 16 + (c - 48); }
                        else { if c >= 97 { val = val * 16 + (c - 87); } else { val = val * 16 + (c - 55); } }
                        pos = pos + 1;
                    }
                    len = pos - start;
                    store_token(tokens, count, 2, start, len, val);
                    count = count + 1;
                    continue;
                }
            }
            // Decimal
            while pos < src_len {
                c = *(src + pos);
                if is_digit(c) == 0 { break; }
                val = val * 10 + (c - 48);
                pos = pos + 1;
            }
            len = pos - start;
            store_token(tokens, count, 2, start, len, val);
            count = count + 1;
            continue;
        }
        
        // ── Multi-char operators ──
        start = pos;
        len = 1;
        ttype: u32 = 0;
        
        // Two-char operators
        if pos + 1 < src_len {
            c2: u32 = *(src + pos + 1);
            // == (46)
            if c == 61 && c2 == 61 { ttype = 46; len = 2; pos = pos + 1; }
            // != (47)
            else { if c == 33 && c2 == 61 { ttype = 47; len = 2; pos = pos + 1; } }
            // <= (50)
            else { if c == 60 && c2 == 61 { ttype = 50; len = 2; pos = pos + 1; } }
            // >= (51)
            else { if c == 62 && c2 == 61 { ttype = 51; len = 2; pos = pos + 1; } }
            // && (52)
            else { if c == 38 && c2 == 38 { ttype = 52; len = 2; pos = pos + 1; } }
            // || (53)
            else { if c == 124 && c2 == 124 { ttype = 53; len = 2; pos = pos + 1; } }
            // -> (72) arrow
            else { if c == 45 && c2 == 62 { ttype = 72; len = 2; pos = pos + 1; } }
            // => (73) fat arrow
            else { if c == 61 && c2 == 62 { ttype = 73; len = 2; pos = pos + 1; } }
            // :: (71) scope resolution
            else { if c == 58 && c2 == 58 { ttype = 71; len = 2; pos = pos + 1; } }
            // << (59) shift left
            else { if c == 60 && c2 == 60 { ttype = 59; len = 2; pos = pos + 1; } }
            // >> (60) shift right
            else { if c == 62 && c2 == 62 { ttype = 60; len = 2; pos = pos + 1; } }
            // += (80)
            else { if c == 43 && c2 == 61 { ttype = 80; len = 2; pos = pos + 1; } }
            // -= (81)
            else { if c == 45 && c2 == 61 { ttype = 81; len = 2; pos = pos + 1; } }
            // *= (82)
            else { if c == 42 && c2 == 61 { ttype = 82; len = 2; pos = pos + 1; } }
            // /= (83)
            else { if c == 47 && c2 == 61 { ttype = 83; len = 2; pos = pos + 1; } }
        }
        
        // Single-char tokens (if no two-char match)
        if ttype == 0 {
            if c == 40 { ttype = 61; }       // (
            else { if c == 41 { ttype = 62; } }  // )
            else { if c == 123 { ttype = 63; } } // {
            else { if c == 125 { ttype = 64; } } // }
            else { if c == 91 { ttype = 65; } }  // [
            else { if c == 93 { ttype = 66; } }  // ]
            else { if c == 59 { ttype = 67; } }  // ;
            else { if c == 44 { ttype = 68; } }  // ,
            else { if c == 46 { ttype = 69; } }  // .
            else { if c == 58 { ttype = 70; } }  // :
            else { if c == 61 { ttype = 45; } }  // =
            else { if c == 43 { ttype = 40; } }  // +
            else { if c == 45 { ttype = 41; } }  // -
            else { if c == 42 { ttype = 42; } }  // *
            else { if c == 47 { ttype = 43; } }  // /
            else { if c == 37 { ttype = 44; } }  // %
            else { if c == 60 { ttype = 48; } }  // <
            else { if c == 62 { ttype = 49; } }  // >
            else { if c == 38 { ttype = 55; } }  // &
            else { if c == 124 { ttype = 56; } } // |
            else { if c == 94 { ttype = 57; } }  // ^
            else { if c == 126 { ttype = 58; } } // ~
            else { if c == 33 { ttype = 54; } }  // !
            else { if c == 64 { ttype = 74; } }  // @
            else { if c == 63 { ttype = 75; } }  // ?
            else { if c == 35 { ttype = 77; } }  // #
        }
        
        if ttype != 0 {
            store_token(tokens, count, ttype, start, len, 0);
            count = count + 1;
        }
        pos = pos + 1;
    }
    
    // EOF token
    if count < max_tokens {
        store_token(tokens, count, 0, pos, 0, 0);
        count = count + 1;
    }
    return count;
}

// ============================================================================
// Wave 47 — file I/O + bootstrap entry point
// ============================================================================

// Fixed-size buffer used for the source file path. The path comes from
// argv[1] (when provided) or the hardcoded fallback. 256 bytes is plenty
// for typical repo-relative paths; longer paths fall back to the hardcoded
// default (see input_path()). The buffer is allocated with __vuma_alloc and
// freed with __vuma_free by the caller (main) using the same size.
//
// NOTE: this size is duplicated in main() (for __vuma_free) because VUMA's
// bootstrap parser (full_parser.vuma) doesn't yet support module-level
// `const` declarations. If the value changes, update both call sites.

// Write the NUL-terminated fallback path "womb/lang/hello.vuma\0" (21 bytes)
// into the buffer `buf`. Used by input_path() when argc < 2 (no path
// argument provided) or when argv[1] is too long for the buffer. The caller
// owns `buf` and frees it with __vuma_free(buf, 256).
fn write_fallback_path(buf: Address) {
    *(buf + 0) = 119;   // w
    *(buf + 1) = 111;   // o
    *(buf + 2) = 109;   // m
    *(buf + 3) = 98;    // b
    *(buf + 4) = 47;    // /
    *(buf + 5) = 108;   // l
    *(buf + 6) = 97;    // a
    *(buf + 7) = 110;   // n
    *(buf + 8) = 103;   // g
    *(buf + 9) = 47;    // /
    *(buf + 10) = 104;  // h
    *(buf + 11) = 101;  // e
    *(buf + 12) = 108;  // l
    *(buf + 13) = 108;  // l
    *(buf + 14) = 111;  // o
    *(buf + 15) = 46;   // .
    *(buf + 16) = 118;  // v
    *(buf + 17) = 117;  // u
    *(buf + 18) = 109;  // m
    *(buf + 19) = 97;   // a
    *(buf + 20) = 0;    // NUL
}

// Resolve the source file path. Returns a heap-allocated NUL-terminated
// string that the caller frees with __vuma_free(ptr, 256).
//
// Wave 47: reads argv[1] via the __vuma_argc / __vuma_argv runtime
// intrinsics. If argc < 2 (no path argument was provided), or argv[1] is
// longer than 255 chars (leaving room for the NUL terminator), falls back
// to the hardcoded "womb/lang/hello.vuma".
//
// The fallback path is relative to the process CWD; the Wave 47 test runs
// the compiler from the repo root, so "womb/lang/hello.vuma" resolves
// correctly.
fn input_path() -> Address {
    buf_size: i64 = 256;
    buf = __vuma_alloc(buf_size);
    argc: i32 = __vuma_argc();
    if argc < 2 {
        write_fallback_path(buf);
        return buf;
    }
    // argv is a *const *const u8: argv[0] at offset 0, argv[1] at offset 8.
    argv: Address = __vuma_argv();
    argv1_ptr: Address = load_u64(argv, 8);
    // Measure the NUL-terminated string length.
    len: u32 = 0;
    while *(argv1_ptr + len) != 0 {
        len = len + 1;
    }
    // Defensive: if the path is too long for our buffer, fall back.
    if len >= 255 {
        write_fallback_path(buf);
        return buf;
    }
    // Copy argv[1] into the buffer and NUL-terminate.
    i: u32 = 0;
    while i < len {
        *(buf + i) = *(argv1_ptr + i);
        i = i + 1;
    }
    *(buf + len) = 0;
    return buf;
}

// Open `path` (NUL-terminated) with O_RDONLY (0) and read up to `cap` bytes
// into the caller-owned buffer `buf`. Closes the fd. Returns the byte count
// read, or -1 on open failure. (VUMA has no out-params, so the caller owns the
// buffer and we return only the length — same pattern as the W45 std/io
// raw-syscall helpers.) `path` is freed by the caller.
fn read_file_into(path: Address, buf: Address, cap: i64) -> i64 {
    fd: i32 = open(path, 0, 0);   // O_RDONLY = 0, mode = 0 (ignored)
    if fd < 0 { return -1; }
    n: i64 = read(fd, buf, cap);
    close(fd);
    return n;
}

// ============================================================================
// Wave 48 — string-literal helpers + full pipeline driver
// ============================================================================

// Build the NUL-terminated string "main" in a 5-byte heap buffer.
// Used to compute main_hash = name_hash("main") so irb_build_main can
// locate the entry function by hash. Caller frees with __vuma_free(ptr, 5).
fn main_str() -> Address {
    p = __vuma_alloc(5);
    *(p + 0) = 109;  // m
    *(p + 1) = 97;   // a
    *(p + 2) = 105;  // i
    *(p + 3) = 110;  // n
    *(p + 4) = 0;    // NUL
    return p;
}

// Build the NUL-terminated string "print_int" in a 10-byte heap buffer.
// Used to compute print_int_hash = name_hash("print_int") so codegen_emit
// can dispatch IR_CALL targets. Caller frees with __vuma_free(ptr, 10).
fn print_int_str() -> Address {
    p = __vuma_alloc(10);
    *(p + 0) = 112;   // p
    *(p + 1) = 114;   // r
    *(p + 2) = 105;   // i
    *(p + 3) = 110;   // n
    *(p + 4) = 116;   // t
    *(p + 5) = 95;    // _
    *(p + 6) = 105;   // i
    *(p + 7) = 110;   // n
    *(p + 8) = 116;   // t
    *(p + 9) = 0;     // NUL
    return p;
}

// Build the NUL-terminated string "a.out" in a 6-byte heap buffer.
// This is the output path for the emitted ELF executable. The caller frees
// with __vuma_free(ptr, 6). The file is created with mode 0o755 so it's
// executable after the ELF write completes.
fn output_path() -> Address {
    p = __vuma_alloc(6);
    *(p + 0) = 97;    // a
    *(p + 1) = 46;    // .
    *(p + 2) = 111;   // o
    *(p + 3) = 117;   // u
    *(p + 4) = 116;   // t
    *(p + 5) = 0;     // NUL
    return p;
}

// Wave 48 bootstrap entry point — full pipeline driver.
//
// Exit codes:
//   0  →  source compiled to a.out successfully (a.out is chmod +x and
//          runnable; running it should produce the hello.vuma output and
//          exit with the hello.vuma main()'s return value)
//   1  →  failure at any pipeline stage (I/O, lex, parse, IR build, codegen,
//          ELF write)
//
// The source file path comes from argv[1] (if provided) or the hardcoded
// fallback "womb/lang/hello.vuma" — see input_path() above. The output
// path "a.out" could similarly become argv[2] (or a -o flag) in a future
// wave; for now it remains fixed.
fn main() -> i32 {
    // ── Pipeline buffer sizes ──
    // These are conservative upper bounds for the hello.vuma subset. Larger
    // programs would need growing logic (the parser/IR builder currently
    // truncate at capacity — see ast_node's `if count >= cap { return count; }`
    // and irb_emit's `if count >= cap { return; }`).
    src_cap: i64 = 65536;          // 64 KiB source buffer
    token_cap: u32 = 512;          // 512 tokens max
    token_buf_size: i64 = 12288;   // 512 * 24 bytes/token
    ast_cap: u32 = 256;            // 256 AST nodes max
    ast_buf_size: i64 = 10248;     // 8 + 256 * 40
    ir_cap: u32 = 1024;            // 1024 IR instructions max
    ir_buf_size: i64 = 32776;      // 8 + 1024 * 32
    code_cap: u32 = 4096;          // 4 KiB code buffer
    // PRINT_INT_SIZE = 86 (matches codegen.vuma's constant; duplicated here
    // because VUMA cross-module const imports don't exist yet — the extern
    // block above covers functions only).
    print_int_size: u32 = 86;

    // Linux open(2) flags for write mode (O_WRONLY|O_CREAT|O_TRUNC = 577).
    o_wronly_creat_trunc: i32 = 577;
    // Mode 0o755 (rwxr-xr-x) so a.out is executable.
    mode_755: i32 = 493;

    // ── 1. Read source file ──
    path = input_path();
    src = __vuma_alloc(src_cap);
    src_len: i64 = read_file_into(path, src, src_cap);
    __vuma_free(path, 256);
    if src_len < 0 {
        __vuma_free(src, src_cap);
        return 1;
    }
    src_len_u32: u32 = src_len & 0xFFFFFFFF;

    // ── 2. Lex (source → token stream) ──
    tokens = __vuma_alloc(token_buf_size);
    token_count: u32 = full_lex(src, src_len_u32, tokens, token_cap);
    if token_count == 0 {
        __vuma_free(src, src_cap);
        __vuma_free(tokens, token_buf_size);
        return 1;
    }

    // ── 3. Parse (tokens → AST arena) ──
    //   AST arena layout: [count: u32][8 bytes header][node * count: 40 bytes]
    //   The parser reads count from offset 0 and writes nodes starting at 8.
    ast = __vuma_alloc(ast_buf_size);
    store_u32(ast, 0, 0);   // count = 0
    item_count: u32 = parse(tokens, token_count, src, ast, ast_cap);
    if item_count == 0 {
        __vuma_free(src, src_cap);
        __vuma_free(tokens, token_buf_size);
        __vuma_free(ast, ast_buf_size);
        return 1;
    }

    // ── 4. SCG construction (STUB — bootstrap goes AST→IR direct) ──
    //   scg_construct is a no-op stub (see ir_builder.vuma). The call is
    //   here so the pipeline shape is final — a future wave replaces the
    //   stub body with real SCG construction without touching main().
    scg_construct(ast);

    // ── 5. IR construction (find main by name hash, lower its body) ──
    //   main_hash = FNV-1a("main"). We build the literal "main" string,
    //   hash it via name_hash (defined in full_parser.vuma, declared as
    //   extern above), then free the string.
    mstr = main_str();
    main_hash: u32 = name_hash(mstr, 0, 4);
    __vuma_free(mstr, 5);

    //   IR buffer layout: [count: u32][cap: u32][instr * count: 32 bytes]
    ir_buf = __vuma_alloc(ir_buf_size);
    store_u32(ir_buf, 0, 0);       // count = 0
    store_u32(ir_buf, 4, ir_cap);  // capacity
    found: u32 = irb_build_main(ast, main_hash, ir_buf);
    if found == 0 {
        __vuma_free(src, src_cap);
        __vuma_free(tokens, token_buf_size);
        __vuma_free(ast, ast_buf_size);
        __vuma_free(ir_buf, ir_buf_size);
        return 1;
    }

    // ── 6. BD inference (STUB — all values are i64) ──
    //   bd_infer is a no-op stub (see ir_builder.vuma). Real BD would
    //   propagate bounded integer ranges forward from literals.
    bd_infer(ir_buf);

    // ── 7. IVE verification (STUB — no-op) ──
    //   ive_verify is a no-op stub (see ir_builder.vuma). Real IVE would
    //   check liveness and remove dead lets.
    ive_verify(ir_buf);

    // ── 8. x86_64 codegen (IR → machine code) ──
    //   print_int_hash = FNV-1a("print_int"). codegen_emit uses this to
    //   dispatch IR_CALL targets: a call whose callee_hash matches
    //   print_int_hash emits a relative CALL to the print_int routine at
    //   offset 0 of the code buffer; any other callee is skipped silently
    //   (real calls are a TODO).
    pistr = print_int_str();
    print_int_hash: u32 = name_hash(pistr, 0, 9);
    __vuma_free(pistr, 10);

    code = __vuma_alloc(code_cap);
    code_size: u32 = codegen_emit(ir_buf, code, code_cap, print_int_hash);

    // ── 9. ELF64 emission (machine code → a.out) ──
    //   The ELF entry point is at code offset PRINT_INT_SIZE (= 86), which
    //   skips the print_int routine and lands on main. See elf.vuma's
    //   write_elf64 for the entry_offset math.
    out_path = output_path();
    out_fd: i32 = open(out_path, o_wronly_creat_trunc, mode_755);
    __vuma_free(out_path, 6);
    if out_fd < 0 {
        __vuma_free(src, src_cap);
        __vuma_free(tokens, token_buf_size);
        __vuma_free(ast, ast_buf_size);
        __vuma_free(ir_buf, ir_buf_size);
        __vuma_free(code, code_cap);
        return 1;
    }
    success: u32 = write_elf64(code, code_size, out_fd, print_int_size);
    close(out_fd);

    // ── 10. Cleanup + exit ──
    __vuma_free(src, src_cap);
    __vuma_free(tokens, token_buf_size);
    __vuma_free(ast, ast_buf_size);
    __vuma_free(ir_buf, ir_buf_size);
    __vuma_free(code, code_cap);

    if success == 0 { return 1; }
    return 0;
}
