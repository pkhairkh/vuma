// womb/lang/elf.vuma — Minimal ELF64 writer for x86_64
// Generates a static ELF64 executable with a single executable segment.
//
// Wave 48: the entry point is now configurable via `entry_offset` (the byte
// offset within the code buffer where execution should start). Previously
// the entry was hardcoded to `0x401000 + header_size`, which was a bug —
// the segment is loaded at vaddr 0x400000 from file offset 0, so file
// offset X maps to vaddr 0x400000 + X. The correct entry vaddr is
// 0x400000 + header_size + entry_offset.
//
// The bootstrap codegen lays out:
//   file offset 0..120              = ELF header + program header
//   file offset 120..120+86         = print_int routine (entry_offset = 0
//                                     would run print_int first with garbage
//                                     in rdi — BAD)
//   file offset 120+86..            = main function (entry_offset = 86)
// So the driver calls write_elf64(code, code_size, fd, 86).

extern "C" {
    fn __vuma_alloc(size: i64) -> Address;
    fn __vuma_free(addr: Address, size: i64);
    fn write(fd: i64, buf: Address, count: i64) -> i64;
}

fn store_u64(ptr: Address, offset: u32, val: u64) {
    *(ptr + offset) = val & 255; *(ptr + offset + 1) = (val >> 8) & 255;
    *(ptr + offset + 2) = (val >> 16) & 255; *(ptr + offset + 3) = (val >> 24) & 255;
    *(ptr + offset + 4) = (val >> 32) & 255; *(ptr + offset + 5) = (val >> 40) & 255;
    *(ptr + offset + 6) = (val >> 48) & 255; *(ptr + offset + 7) = (val >> 56) & 255;
}
fn store_u32(ptr: Address, offset: u32, val: u32) {
    *(ptr + offset) = val & 255; *(ptr + offset + 1) = (val >> 8) & 255;
    *(ptr + offset + 2) = (val >> 16) & 255; *(ptr + offset + 3) = (val >> 24) & 255;
}
fn store_u16(ptr: Address, offset: u32, val: u32) {
    *(ptr + offset) = val & 255; *(ptr + offset + 1) = (val >> 8) & 255;
}

// ELF64 constants
const ELFMAG: u32 = 0x464C457F;  // \x7FELF

// Write a minimal ELF64 executable.
//   code         — pointer to machine code buffer
//   code_size    — size of code in bytes
//   out_fd       — open file descriptor to write to (caller opens "a.out"
//                  with O_WRONLY|O_CREAT|O_TRUNC, mode 0o755, then closes)
//   entry_offset — byte offset within `code` where execution should start
//                  (Wave 48: the bootstrap passes PRINT_INT_SIZE = 86 so
//                  the ELF entry skips the print_int routine and lands on
//                  main. Passing 0 would run print_int first with garbage
//                  in rdi.)
//
// Returns 1 on success, 0 on write failure.
fn write_elf64(code: Address, code_size: u32, out_fd: i64, entry_offset: u32) -> u32 {
    // ELF header: 64 bytes
    // Program header: 56 bytes
    // Total header: 120 bytes
    header_size: u32 = 120;
    // The segment is loaded at vaddr 0x400000 from file offset 0, so
    // file offset X maps to vaddr 0x400000 + X. The entry point is the
    // vaddr of `code[entry_offset]` = 0x400000 + header_size + entry_offset.
    vaddr: u64 = 0x400000;
    entry_point: u64 = vaddr + header_size + entry_offset;

    buf = __vuma_alloc(header_size + code_size);

    // ── ELF Header (64 bytes) ──
    // e_ident[0..3]: magic 0x7F 'E' 'L' 'F'
    *(buf + 0) = 0x7F; *(buf + 1) = 0x45; *(buf + 2) = 0x4C; *(buf + 3) = 0x46;
    // e_ident[4]: EI_CLASS = 2 (ELFCLASS64)
    *(buf + 4) = 2;
    // e_ident[5]: EI_DATA = 1 (ELFDATA2LSB, little-endian)
    *(buf + 5) = 1;
    // e_ident[6]: EI_VERSION = 1
    *(buf + 6) = 1;
    // e_ident[7..15]: padding (zeros)
    // e_type: ET_EXEC = 2
    store_u16(buf, 16, 2);
    // e_machine: EM_X86_64 = 62
    store_u16(buf, 18, 62);
    // e_version: 1
    store_u32(buf, 20, 1);
    // e_entry: entry point virtual address
    store_u64(buf, 24, entry_point);
    // e_phoff: program header offset = 64
    store_u64(buf, 32, 64);
    // e_shoff: section header offset = 0 (no sections)
    store_u64(buf, 40, 0);
    // e_flags: 0
    store_u32(buf, 48, 0);
    // e_ehsize: ELF header size = 64
    store_u16(buf, 52, 64);
    // e_phentsize: program header entry size = 56
    store_u16(buf, 54, 56);
    // e_phnum: number of program headers = 1
    store_u16(buf, 56, 1);
    // e_shentsize, e_shnum, e_shstrndx: 0 (no sections)

    // ── Program Header (56 bytes, at offset 64) ──
    ph: u32 = 64;
    // p_type: PT_LOAD = 1
    store_u32(buf, ph, 1);
    // p_flags: PF_X | PF_R = 5
    store_u32(buf, ph + 4, 5);
    // p_offset: file offset = 0 (load from start of file)
    store_u64(buf, ph + 8, 0);
    // p_vaddr: virtual address = 0x400000
    store_u64(buf, ph + 16, vaddr);
    // p_paddr: physical address = 0x400000
    store_u64(buf, ph + 24, vaddr);
    // p_filesz: file size = header_size + code_size
    store_u64(buf, ph + 32, header_size + code_size);
    // p_memsz: memory size = same as filesz
    store_u64(buf, ph + 40, header_size + code_size);
    // p_align: alignment = 0x1000 (page size)
    store_u64(buf, ph + 48, 0x1000);

    // ── Code (at offset 120) ──
    code_offset: u32 = header_size;
    i: u32 = 0;
    while i < code_size {
        *(buf + code_offset + i) = *(code + i) & 255;
        i = i + 1;
    }

    // Write the ELF file.
    total: i64 = header_size + code_size;
    n: i64 = write(out_fd, buf, total);
    __vuma_free(buf, total);
    if n == total { return 1; }
    return 0;
}
