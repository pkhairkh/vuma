// womb/lang/codegen.vuma — x86_64 code generator (subset)
// Generates x86_64 machine code from IR instructions.
// Each vreg gets a stack slot at [rbp - offset].
//
// Syscall stubs are linked by the existing backend.

extern "C" {
    fn __vuma_alloc(size: i64) -> Address;
    fn __vuma_free(addr: Address, size: i64);
    fn write(fd: i64, buf: Address, count: i64) -> i64;
}

fn store_u64(ptr: Address, offset: u32, val: u64) {
    *(ptr + offset) = val & 255; *(ptr + offset + 1) = (val >> 8) & 255;
    *(ptr + offset + 2) = (val >> 16) & 255; *(ptr + offset + 3) = (val >> 24) & 255;
    *(ptr + offset + 4) = (val >> 32) & 255; *(ptr + offset + 5) = (val >> 40) & 255;
    *(ptr + offset + 6) = (val >> 48) & 255; *(ptr + offset + 7) = (val >> 56) & 255;
}
fn load_u64(ptr: Address, offset: u32) -> u64 {
    b0: u64 = *(ptr + offset); b1: u64 = *(ptr + offset + 1);
    b2: u64 = *(ptr + offset + 2); b3: u64 = *(ptr + offset + 3);
    b4: u64 = *(ptr + offset + 4); b5: u64 = *(ptr + offset + 5);
    b6: u64 = *(ptr + offset + 6); b7: u64 = *(ptr + offset + 7);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56);
}
fn store_u32(ptr: Address, offset: u32, val: u32) {
    *(ptr + offset) = val & 255; *(ptr + offset + 1) = (val >> 8) & 255;
    *(ptr + offset + 2) = (val >> 16) & 255; *(ptr + offset + 3) = (val >> 24) & 255;
}
fn load_u32(ptr: Address, offset: u32) -> u32 {
    b0: u32 = *(ptr + offset); b1: u32 = *(ptr + offset + 1);
    b2: u32 = *(ptr + offset + 2); b3: u32 = *(ptr + offset + 3);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

// Append a byte to the code buffer
fn emit_byte(code: Address, pos: u32, b: u32) {
    *(code + pos) = b & 255;
}

// Append a 32-bit immediate (little-endian)
fn emit_u32(code: Address, pos: u32, val: u32) {
    *(code + pos) = val & 255;
    *(code + pos + 1) = (val >> 8) & 255;
    *(code + pos + 2) = (val >> 16) & 255;
    *(code + pos + 3) = (val >> 24) & 255;
}

// ── x86_64 instruction encoders ──

// PUSH rbp: 0x55
fn enc_push_rbp(code: Address, pos: u32) -> u32 {
    emit_byte(code, pos, 0x55);
    return pos + 1;
}

// MOV rbp, rsp: 0x48 0x89 0xE5
fn enc_mov_rbp_rsp(code: Address, pos: u32) -> u32 {
    emit_byte(code, pos, 0x48);
    emit_byte(code, pos + 1, 0x89);
    emit_byte(code, pos + 2, 0xE5);
    return pos + 3;
}

// SUB rsp, imm32: 0x48 0x81 0xEC <imm32>
fn enc_sub_rsp(code: Address, pos: u32, imm: u32) -> u32 {
    emit_byte(code, pos, 0x48);
    emit_byte(code, pos + 1, 0x81);
    emit_byte(code, pos + 2, 0xEC);
    emit_u32(code, pos + 3, imm);
    return pos + 7;
}

// POP rbp: 0x5D
fn enc_pop_rbp(code: Address, pos: u32) -> u32 {
    emit_byte(code, pos, 0x5D);
    return pos + 1;
}

// RET: 0xC3
fn enc_ret(code: Address, pos: u32) -> u32 {
    emit_byte(code, pos, 0xC3);
    return pos + 1;
}

// MOV rax, imm64: 0x48 0xB8 <imm64>
fn enc_mov_rax_imm64(code: Address, pos: u32, val: u64) -> u32 {
    emit_byte(code, pos, 0x48);
    emit_byte(code, pos + 1, 0xB8);
    store_u64(code, pos + 2, val);
    return pos + 10;
}

// MOV [rbp-offset], rax: 0x48 0x89 0x45 <disp8>
fn enc_store_rax(code: Address, pos: u32, offset: u32) -> u32 {
    emit_byte(code, pos, 0x48);
    emit_byte(code, pos + 1, 0x89);
    emit_byte(code, pos + 2, 0x45);
    emit_byte(code, pos + 3, offset & 255);  // disp8 (negative offset)
    return pos + 4;
}

// MOV rax, [rbp-offset]: 0x48 0x8B 0x45 <disp8>
fn enc_load_rax(code: Address, pos: u32, offset: u32) -> u32 {
    emit_byte(code, pos, 0x48);
    emit_byte(code, pos + 1, 0x8B);
    emit_byte(code, pos + 2, 0x45);
    emit_byte(code, pos + 3, offset & 255);
    return pos + 4;
}

// ADD rax, rcx: 0x48 0x01 0xC8
fn enc_add_rax_rcx(code: Address, pos: u32) -> u32 {
    emit_byte(code, pos, 0x48);
    emit_byte(code, pos + 1, 0x01);
    emit_byte(code, pos + 2, 0xC8);
    return pos + 3;
}

// SUB rax, rcx: 0x48 0x29 0xC8
fn enc_sub_rax_rcx(code: Address, pos: u32) -> u32 {
    emit_byte(code, pos, 0x48);
    emit_byte(code, pos + 1, 0x29);
    emit_byte(code, pos + 2, 0xC8);
    return pos + 3;
}

// XOR rax, rax: 0x48 0x31 0xC0
fn enc_xor_rax(code: Address, pos: u32) -> u32 {
    emit_byte(code, pos, 0x48);
    emit_byte(code, pos + 1, 0x31);
    emit_byte(code, pos + 2, 0xC0);
    return pos + 3;
}

// SYSCALL: 0x0F 0x05
fn enc_syscall(code: Address, pos: u32) -> u32 {
    emit_byte(code, pos, 0x0F);
    emit_byte(code, pos + 1, 0x05);
    return pos + 2;
}

// MOV edi, imm32: 0xBF <imm32>
fn enc_mov_edi_imm32(code: Address, pos: u32, val: u32) -> u32 {
    emit_byte(code, pos, 0xBF);
    emit_u32(code, pos + 1, val);
    return pos + 5;
}

// ── Wave 48: additional x86_64 encoders for the full pipeline ──

// MOV rcx, [rbp+disp8]: 48 8B 4D <disp8>
fn enc_load_rcx(code: Address, pos: u32, offset: u32) -> u32 {
    emit_byte(code, pos, 0x48);
    emit_byte(code, pos + 1, 0x8B);
    emit_byte(code, pos + 2, 0x4D);
    emit_byte(code, pos + 3, offset & 255);
    return pos + 4;
}

// MOV rdi, [rbp+disp8]: 48 8B 7D <disp8>
fn enc_load_rdi(code: Address, pos: u32, offset: u32) -> u32 {
    emit_byte(code, pos, 0x48);
    emit_byte(code, pos + 1, 0x8B);
    emit_byte(code, pos + 2, 0x7D);
    emit_byte(code, pos + 3, offset & 255);
    return pos + 4;
}

// MOV rsi, [rbp+disp8]: 48 8B 75 <disp8>  (Wave P1-c-8b: syscall arg1)
fn enc_load_rsi(code: Address, pos: u32, offset: u32) -> u32 {
    emit_byte(code, pos, 0x48);
    emit_byte(code, pos + 1, 0x8B);
    emit_byte(code, pos + 2, 0x75);
    emit_byte(code, pos + 3, offset & 255);
    return pos + 4;
}

// MOV rdx, [rbp+disp8]: 48 8B 55 <disp8>  (Wave P1-c-8b: syscall arg2)
fn enc_load_rdx(code: Address, pos: u32, offset: u32) -> u32 {
    emit_byte(code, pos, 0x48);
    emit_byte(code, pos + 1, 0x8B);
    emit_byte(code, pos + 2, 0x55);
    emit_byte(code, pos + 3, offset & 255);
    return pos + 4;
}

// MOV r10, [rbp+disp8]: 4C 8B 55 <disp8>  (Wave P1-c-8b: syscall arg3)
// (REX.WR for r10: W=1 64-bit operand, R=1 extends ModR/M reg field to r10.)
fn enc_load_r10(code: Address, pos: u32, offset: u32) -> u32 {
    emit_byte(code, pos, 0x4C);
    emit_byte(code, pos + 1, 0x8B);
    emit_byte(code, pos + 2, 0x55);
    emit_byte(code, pos + 3, offset & 255);
    return pos + 4;
}

// IMUL rax, rcx: 48 0F AF C1
fn enc_imul_rax_rcx(code: Address, pos: u32) -> u32 {
    emit_byte(code, pos, 0x48);
    emit_byte(code, pos + 1, 0x0F);
    emit_byte(code, pos + 2, 0xAF);
    emit_byte(code, pos + 3, 0xC1);
    return pos + 4;
}

// MOV rdi, rax: 48 89 C7  (used to move a vreg's value into rdi for sys_exit)
fn enc_mov_rdi_rax(code: Address, pos: u32) -> u32 {
    emit_byte(code, pos, 0x48);
    emit_byte(code, pos + 1, 0x89);
    emit_byte(code, pos + 2, 0xC7);
    return pos + 3;
}

// MOV eax, imm32: B8 <imm32>  (zero-extends to rax)
fn enc_mov_eax_imm32(code: Address, pos: u32, val: u32) -> u32 {
    emit_byte(code, pos, 0xB8);
    emit_u32(code, pos + 1, val);
    return pos + 5;
}

// XOR edi, edi: 31 FF  (zeroes rdi for sys_exit with code 0)
fn enc_xor_edi(code: Address, pos: u32) -> u32 {
    emit_byte(code, pos, 0x31);
    emit_byte(code, pos + 1, 0xFF);
    return pos + 2;
}

// CALL rel32: E8 <rel32 LE>
// rel32 = target_offset - (pos + 5), as a signed 32-bit two's complement value.
// u32 subtraction wraps modulo 2^32, yielding the correct bit pattern for
// both forward (positive rel) and backward (negative rel) calls. The
// print_int routine lives at offset 0 of the code buffer, so calls from
// main to print_int are backward (negative rel32).
fn enc_call_rel32(code: Address, pos: u32, target_offset: u32) -> u32 {
    emit_byte(code, pos, 0xE8);
    rel: u32 = target_offset - (pos + 5);
    emit_u32(code, pos + 1, rel);
    return pos + 5;
}

// ── Wave P6.1: memory-op encoders (IR_ALLOC / IR_LOAD / IR_STORE) ──
// These three encoders back the IR_ALLOC (15), IR_LOAD (11), and IR_STORE
// (12) handlers in codegen_emit. They use the same [rbp - disp] vreg-slot
// addressing convention as enc_load_rax / enc_store_rax, plus a [rcx + disp]
// form for the actual memory access (the address vreg is loaded into RCX).

// LEA rax, [rbp - offset]:
//   48 8D 45 <disp8>          (if offset <= 127 — 4 bytes)
//   48 8D 85 <disp32 LE>      (otherwise — 7 bytes)
// `offset` is the vreg's stack-slot displacement (a positive value that
// represents a NEGATIVE displacement from rbp; vreg_offset returns the
// two's-complement byte for the disp8 form, and we pass that same byte
// value here). For the disp32 form, the caller passes the raw u32
// two's-complement encoding of the negative displacement.
//
// Used by IR_ALLOC: the dst vreg's stack slot IS the allocation; we
// compute the slot's address with LEA and store it back into the slot.
fn enc_lea_rax_rbp_offset(code: Address, pos: u32, offset: u32) -> u32 {
    // offset is a two's-complement byte from vreg_offset (e.g. 240 = -16).
    // For disp8: use as-is (works for offsets -128..127, i.e. vregs 1-16).
    // For disp32: sign-extend the byte to 32 bits (0xFFFFFF00 | offset).
    if offset <= 127 {
        emit_byte(code, pos, 0x48);
        emit_byte(code, pos + 1, 0x8D);
        emit_byte(code, pos + 2, 0x45);
        emit_byte(code, pos + 3, offset & 255);  // disp8 (two's-complement negative)
        return pos + 4;
    }
    // Sign-extend the 8-bit two's-complement value to 32 bits.
    disp32: u32 = 0xFFFFFF00 | offset;
    emit_byte(code, pos, 0x48);
    emit_byte(code, pos + 1, 0x8D);
    emit_byte(code, pos + 2, 0x85);
    emit_u32(code, pos + 3, disp32);  // disp32 (sign-extended negative)
    return pos + 7;
}

// MOVZBL eax, [rax + offset] (zero-extend byte load):
//   0F B6 40 <disp8>          (if offset <= 127 — 4 bytes)
//   0F B6 80 <disp32 LE>      (otherwise — 7 bytes)
// Loads one byte from [rax + offset], zero-extends to 32 bits into EAX
// (which implicitly zero-extends to 64-bit RAX). Used by IR_LOAD.
fn enc_movzbl_eax_rax_offset(code: Address, pos: u32, offset: u32) -> u32 {
    if offset <= 127 {
        emit_byte(code, pos, 0x0F);
        emit_byte(code, pos + 1, 0xB6);
        emit_byte(code, pos + 2, 0x40);
        emit_byte(code, pos + 3, offset & 255);  // disp8 (positive offset)
        return pos + 4;
    }
    emit_byte(code, pos, 0x0F);
    emit_byte(code, pos + 1, 0xB6);
    emit_byte(code, pos + 2, 0x80);
    emit_u32(code, pos + 3, offset);  // disp32 (positive offset)
    return pos + 7;
}

// MOV [rcx + offset], al (byte store):
//   88 01                     (if offset == 0 — 2 bytes, no displacement)
//   88 41 <disp8>             (if 0 < offset <= 127 — 3 bytes)
//   88 81 <disp32 LE>         (otherwise — 6 bytes)
// Stores the low byte of RAX to [RCX + offset]. The address vreg is loaded
// into RCX by the caller (via enc_load_rcx). Used by IR_STORE.
fn enc_store_byte_rcx_rax(code: Address, pos: u32, offset: u32) -> u32 {
    if offset == 0 {
        emit_byte(code, pos, 0x88);
        emit_byte(code, pos + 1, 0x01);
        return pos + 2;
    }
    if offset <= 127 {
        emit_byte(code, pos, 0x88);
        emit_byte(code, pos + 1, 0x41);
        emit_byte(code, pos + 2, offset & 255);  // disp8 (positive offset)
        return pos + 3;
    }
    emit_byte(code, pos, 0x88);
    emit_byte(code, pos + 1, 0x81);
    emit_u32(code, pos + 2, offset);  // disp32 (positive offset)
    return pos + 6;
}

// Wave P1-c-8: translate a VUMA/asm-generic syscall number to the x86_64
// native syscall number. The bootstrap targets x86_64, so the generic nr
// coming out of the AST (c1 of NK_SYSCALL) must be remapped before being
// loaded into EAX. Unknown nrs fall through verbatim (same fallback as the
// Rust codegen's unwrap_or(nr)). The table mirrors the per-arch tables in
// src/codegen/*/syscall_*.rs (x86_64 column).
fn translate_syscall_nr_x86_64(vuma_nr: u32) -> u32 {
    // File I/O
    if vuma_nr == 64 { return 1; }    // write
    if vuma_nr == 63 { return 0; }    // read
    if vuma_nr == 57 { return 3; }    // close
    if vuma_nr == 56 { return 257; }  // openat
    if vuma_nr == 62 { return 8; }    // lseek
    if vuma_nr == 80 { return 5; }    // fstat
    if vuma_nr == 79 { return 262; }  // newfstatat
    if vuma_nr == 78 { return 267; }  // readlinkat
    if vuma_nr == 67 { return 17; }   // pread64
    if vuma_nr == 68 { return 18; }   // pwrite64
    if vuma_nr == 65 { return 19; }   // readv
    if vuma_nr == 66 { return 20; }   // writev
    if vuma_nr == 46 { return 46; }   // ftruncate
    if vuma_nr == 82 { return 74; }   // fsync
    if vuma_nr == 83 { return 75; }   // fdatasync
    if vuma_nr == 81 { return 162; }  // sync
    if vuma_nr == 306 { return 306; } // syncfs
    // Path I/O
    if vuma_nr == 35 { return 263; }  // unlinkat
    if vuma_nr == 38 { return 264; }  // renameat
    if vuma_nr == 37 { return 265; }  // linkat
    if vuma_nr == 36 { return 266; }  // symlinkat
    if vuma_nr == 48 { return 269; }  // faccessat
    if vuma_nr == 53 { return 268; }  // fchmodat
    if vuma_nr == 54 { return 260; }  // fchownat
    if vuma_nr == 52 { return 91; }   // fchmod
    if vuma_nr == 55 { return 93; }   // fchown
    if vuma_nr == 17 { return 79; }   // getcwd
    if vuma_nr == 49 { return 80; }   // chdir
    // Process / signals
    if vuma_nr == 93 { return 60; }   // exit
    if vuma_nr == 94 { return 231; }  // exit_group
    if vuma_nr == 172 { return 39; }  // getpid
    if vuma_nr == 129 { return 62; }  // kill
    if vuma_nr == 124 { return 24; }  // sched_yield
    if vuma_nr == 134 { return 13; }  // rt_sigaction
    if vuma_nr == 135 { return 14; }  // rt_sigprocmask
    if vuma_nr == 260 { return 61; }  // wait4
    if vuma_nr == 220 { return 56; }  // clone
    if vuma_nr == 221 { return 59; }  // execve
    // Memory
    if vuma_nr == 222 { return 9; }   // mmap
    if vuma_nr == 215 { return 11; }  // munmap
    if vuma_nr == 214 { return 12; }  // brk
    if vuma_nr == 226 { return 10; }  // mprotect
    if vuma_nr == 278 { return 318; } // getrandom
    // Time / sleep
    if vuma_nr == 113 { return 228; } // clock_gettime
    if vuma_nr == 101 { return 35; }  // nanosleep
    if vuma_nr == 153 { return 100; } // times
    // Futex / sync
    if vuma_nr == 98 { return 202; }  // futex
    // UID / GID
    if vuma_nr == 174 { return 102; } // getuid
    if vuma_nr == 175 { return 107; } // geteuid
    if vuma_nr == 176 { return 104; } // getgid
    if vuma_nr == 177 { return 108; } // getegid
    if vuma_nr == 146 { return 105; } // setuid
    if vuma_nr == 144 { return 106; } // setgid
    // Resource limits
    if vuma_nr == 261 { return 302; } // prlimit64
    if vuma_nr == 163 { return 97; }  // getrlimit
    if vuma_nr == 164 { return 160; } // setrlimit
    if vuma_nr == 165 { return 98; }  // getrusage
    // FD management
    if vuma_nr == 22 { return 22; }   // pipe
    if vuma_nr == 23 { return 32; }   // dup
    if vuma_nr == 24 { return 292; }  // dup3
    if vuma_nr == 25 { return 72; }   // fcntl
    if vuma_nr == 29 { return 16; }   // ioctl
    // Sockets
    if vuma_nr == 198 { return 41; }  // socket
    if vuma_nr == 203 { return 42; }  // connect
    if vuma_nr == 200 { return 49; }  // bind
    if vuma_nr == 201 { return 50; }  // listen
    if vuma_nr == 202 { return 43; }  // accept
    if vuma_nr == 206 { return 44; }  // sendto
    if vuma_nr == 207 { return 45; }  // recvfrom
    if vuma_nr == 210 { return 48; }  // shutdown
    if vuma_nr == 208 { return 54; }  // setsockopt
    // epoll / eventfd / timerfd / signalfd
    if vuma_nr == 20 { return 291; }  // epoll_create1
    if vuma_nr == 21 { return 233; }  // epoll_ctl
    if vuma_nr == 19 { return 290; }  // eventfd2
    if vuma_nr == 85 { return 283; }  // timerfd_create
    if vuma_nr == 74 { return 289; }  // signalfd4
    // Fallback: unknown nr → pass through verbatim (matches Rust codegen).
    return vuma_nr;
}

// Generate function prologue
fn gen_prologue(code: Address, pos: u32, frame_size: u32) -> u32 {
    pos = enc_push_rbp(code, pos);
    pos = enc_mov_rbp_rsp(code, pos);
    pos = enc_sub_rsp(code, pos, frame_size);
    return pos;
}

// Generate function epilogue
fn gen_epilogue(code: Address, pos: u32) -> u32 {
    pos = enc_pop_rbp(code, pos);
    pos = enc_ret(code, pos);
    return pos;
}

// ============================================================================
// Wave 48 — print_int routine + codegen_emit entry point
// ============================================================================
// The bootstrap compiler emits a self-contained ELF executable with this
// .text layout:
//
//   ┌── offset 0 ──────────────────────────────────────────────┐
//   │ print_int routine (86 bytes, hand-assembled)            │
//   │   input:  rdi = integer to print                        │
//   │   output: writes decimal digits + '\n' to stdout        │
//   │   clobbers: rax, rcx, rdx, rsi                          │
//   │   stack:   uses 32 bytes of red-zone-equivalent scratch │
//   ├─ offset 86 (= PRINT_INT_SIZE) ──────────────────────────┤
//   │ main function:                                          │
//   │   prologue (push rbp; mov rbp, rsp; sub rsp, frame)     │
//   │   per-IR-opcode x86_64 emission (see codegen_emit)      │
//   │   defensive exit(0) in case IR lacks a trailing RET     │
//   └──────────────────────────────────────────────────────────┘
//
// The ELF entry point is offset 86 (= PRINT_INT_SIZE), NOT offset 0 —
// otherwise print_int would run first with garbage in rdi. See elf.vuma's
// write_elf64, which takes an entry_offset parameter for exactly this.
//
// The print_int routine:
//   sub rsp, 32              ; 32-byte digit buffer
//   mov rsi, rsp
//   add rsi, 31              ; rsi -> last byte of buffer
//   mov byte [rsi], 10       ; trailing newline
//   dec rsi                  ; rsi -> next digit slot (grows leftward)
//   mov rax, rdi             ; rax = number to convert
//   mov ecx, 10              ; divisor
//   test rax, rax
//   jnz .loop                ; if non-zero, convert digits
//   mov byte [rsi], 48       ; zero special case: '0'
//   jmp .done
// .loop:
//   test rax, rax
//   jz .done
//   xor rdx, rdx
//   div rcx                  ; rax = rax/10, rdx = rax%10
//   add dl, 48               ; to ASCII
//   mov [rsi], dl
//   dec rsi
//   jmp .loop
// .done:
//   inc rsi                  ; rsi -> first digit
//   mov rdx, rsp
//   add rdx, 32              ; rdx = end of buffer
//   sub rdx, rsi             ; rdx = byte count
//   mov edi, 1               ; fd = stdout
//   mov eax, 1               ; sys_write
//   syscall
//   add rsp, 32
//   ret

const PRINT_INT_SIZE: u32 = 86;

// Wave P6.2: label / fixup side buffers for IR_BRANCH / IR_COND_BRANCH.
// Each label_id maps to a code offset (u64) in label_buf. Each branch
// fixup records {fixup_pos:u32, target_label:u32} so we can back-patch the
// rel32 once all labels have been resolved.
const MAX_LABELS: u32 = 256;
const MAX_FIXUPS: u32 = 256;

// Emit the 86-byte print_int routine at `pos` in the code buffer.
// Returns pos + 86.
fn emit_print_int_routine(code: Address, pos: u32) -> u32 {
    // 0: sub rsp, 32                  (48 83 EC 20)
    emit_byte(code, pos + 0, 0x48); emit_byte(code, pos + 1, 0x83);
    emit_byte(code, pos + 2, 0xEC); emit_byte(code, pos + 3, 0x20);
    // 4: mov rsi, rsp                 (48 89 E6)
    emit_byte(code, pos + 4, 0x48); emit_byte(code, pos + 5, 0x89);
    emit_byte(code, pos + 6, 0xE6);
    // 7: add rsi, 31                  (48 83 C6 1F)
    emit_byte(code, pos + 7, 0x48); emit_byte(code, pos + 8, 0x83);
    emit_byte(code, pos + 9, 0xC6); emit_byte(code, pos + 10, 0x1F);
    // 11: mov byte [rsi], 10          (C6 06 0A)
    emit_byte(code, pos + 11, 0xC6); emit_byte(code, pos + 12, 0x06);
    emit_byte(code, pos + 13, 0x0A);
    // 14: dec rsi                     (48 FF CE)
    emit_byte(code, pos + 14, 0x48); emit_byte(code, pos + 15, 0xFF);
    emit_byte(code, pos + 16, 0xCE);
    // 17: mov rax, rdi                (48 89 F8)
    emit_byte(code, pos + 17, 0x48); emit_byte(code, pos + 18, 0x89);
    emit_byte(code, pos + 19, 0xF8);
    // 20: mov ecx, 10                 (B9 0A 00 00 00)
    emit_byte(code, pos + 20, 0xB9); emit_byte(code, pos + 21, 0x0A);
    emit_byte(code, pos + 22, 0x00); emit_byte(code, pos + 23, 0x00);
    emit_byte(code, pos + 24, 0x00);
    // 25: test rax, rax               (48 85 C0)
    emit_byte(code, pos + 25, 0x48); emit_byte(code, pos + 26, 0x85);
    emit_byte(code, pos + 27, 0xC0);
    // 28: jnz .loop (rel8=+5)         (75 05)
    emit_byte(code, pos + 28, 0x75); emit_byte(code, pos + 29, 0x05);
    // 30: mov byte [rsi], 48          (C6 06 30)
    emit_byte(code, pos + 30, 0xC6); emit_byte(code, pos + 31, 0x06);
    emit_byte(code, pos + 32, 0x30);
    // 33: jmp .done (rel8=+21)        (EB 15)
    emit_byte(code, pos + 33, 0xEB); emit_byte(code, pos + 34, 0x15);
    // 35 (.loop): test rax, rax       (48 85 C0)
    emit_byte(code, pos + 35, 0x48); emit_byte(code, pos + 36, 0x85);
    emit_byte(code, pos + 37, 0xC0);
    // 38: jz .done (rel8=+16)         (74 10)
    emit_byte(code, pos + 38, 0x74); emit_byte(code, pos + 39, 0x10);
    // 40: xor rdx, rdx                (48 31 D2)
    emit_byte(code, pos + 40, 0x48); emit_byte(code, pos + 41, 0x31);
    emit_byte(code, pos + 42, 0xD2);
    // 43: div rcx                     (48 F7 F1)
    emit_byte(code, pos + 43, 0x48); emit_byte(code, pos + 44, 0xF7);
    emit_byte(code, pos + 45, 0xF1);
    // 46: add dl, 48                  (80 C2 30)
    emit_byte(code, pos + 46, 0x80); emit_byte(code, pos + 47, 0xC2);
    emit_byte(code, pos + 48, 0x30);
    // 49: mov [rsi], dl               (88 16)
    emit_byte(code, pos + 49, 0x88); emit_byte(code, pos + 50, 0x16);
    // 51: dec rsi                     (48 FF CE)
    emit_byte(code, pos + 51, 0x48); emit_byte(code, pos + 52, 0xFF);
    emit_byte(code, pos + 53, 0xCE);
    // 54: jmp .loop (rel8=-21)        (EB EB)
    emit_byte(code, pos + 54, 0xEB); emit_byte(code, pos + 55, 0xEB);
    // 56 (.done): inc rsi             (48 FF C6)
    emit_byte(code, pos + 56, 0x48); emit_byte(code, pos + 57, 0xFF);
    emit_byte(code, pos + 58, 0xC6);
    // 59: mov rdx, rsp                (48 89 E2)
    emit_byte(code, pos + 59, 0x48); emit_byte(code, pos + 60, 0x89);
    emit_byte(code, pos + 61, 0xE2);
    // 62: add rdx, 32                 (48 83 C2 20)
    emit_byte(code, pos + 62, 0x48); emit_byte(code, pos + 63, 0x83);
    emit_byte(code, pos + 64, 0xC2); emit_byte(code, pos + 65, 0x20);
    // 66: sub rdx, rsi                (48 29 F2)
    emit_byte(code, pos + 66, 0x48); emit_byte(code, pos + 67, 0x29);
    emit_byte(code, pos + 68, 0xF2);
    // 69: mov edi, 1                  (BF 01 00 00 00)
    emit_byte(code, pos + 69, 0xBF); emit_byte(code, pos + 70, 0x01);
    emit_byte(code, pos + 71, 0x00); emit_byte(code, pos + 72, 0x00);
    emit_byte(code, pos + 73, 0x00);
    // 74: mov eax, 1                  (B8 01 00 00 00)
    emit_byte(code, pos + 74, 0xB8); emit_byte(code, pos + 75, 0x01);
    emit_byte(code, pos + 76, 0x00); emit_byte(code, pos + 77, 0x00);
    emit_byte(code, pos + 78, 0x00);
    // 79: syscall                     (0F 05)
    emit_byte(code, pos + 79, 0x0F); emit_byte(code, pos + 80, 0x05);
    // 81: add rsp, 32                 (48 83 C4 20)
    emit_byte(code, pos + 81, 0x48); emit_byte(code, pos + 82, 0x83);
    emit_byte(code, pos + 83, 0xC4); emit_byte(code, pos + 84, 0x20);
    // 85: ret                         (C3)
    emit_byte(code, pos + 85, 0xC3);
    return pos + 86;
}

// vreg_offset(N): the signed disp8 byte for the stack slot of vreg N.
// Stack layout: [rbp - 8] is vreg 1, [rbp - 16] is vreg 2, etc.
// (vreg 0 is reserved — see ir_builder.vuma's irb_new — and never loaded.)
// LIMIT: only valid for vreg 1..15 (disp8 range -128..+127). For larger
// frames, use a disp32 encoding (TODO — not needed for hello.vuma which
// uses < 5 vregs). Returns the two's-complement byte value.
fn vreg_offset(vreg: u32) -> u32 {
    return (256 - 8 * vreg) & 0xFF;
}

// Scan the IR buffer to find the highest vreg id used. Used to size the
// stack frame. Returns 0 if no vregs are used.
//
// IMPORTANT: not every field of every IR opcode is a vreg. We must only
// count fields that are actually vreg indices for the given opcode:
//   IR_MOV (16): dst is a vreg; imm is a literal (NOT a vreg — must skip).
//   IR_ADD/SUB/MUL (1/2/3): dst, lhs, rhs are all vregs.
//   IR_RET (14): dst is the returned vreg (or 0 for void return).
//   IR_CALL (13): dst = result vreg; lhs = callee_hash (NOT a vreg!);
//                 rhs = arg_count (NOT a vreg!); imm (lower 32) = arg0_vreg.
//   IR_LOAD (11): dst = result vreg; lhs = addr vreg; rhs = byte offset
//                 (NOT a vreg — must skip). Wave P6.1.
//   IR_STORE (12): dst = value vreg; lhs = addr vreg; rhs = byte offset
//                  (NOT a vreg — must skip). Wave P6.1.
//   IR_ALLOC (15): dst = result vreg (the allocated pointer); imm = size
//                  (NOT a vreg — must skip). Wave P6.1.
//   IR_SYSCALL (20): dst = result vreg; imm.lo/hi, aux.lo/hi = arg vregs.
//   Other ops: not supported in the bootstrap codegen; skip.
fn codegen_max_vreg(ir_buf: Address) -> u32 {
    count: u32 = load_u32(ir_buf, 0);
    max: u32 = 0;
    i: u32 = 0;
    while i < count {
        op_off: u32 = 8 + i * 32;
        op: u32 = load_u32(ir_buf, op_off);
        dst: u32 = load_u32(ir_buf, op_off + 4);
        lhs: u32 = load_u32(ir_buf, op_off + 8);
        rhs: u32 = load_u32(ir_buf, op_off + 12);

        if op == 16 {  // IR_MOV: dst is a vreg; imm is a literal (skip).
            if dst > max { max = dst; }
        }
        else { if op == 1 || op == 2 || op == 3 {  // ADD/SUB/MUL: all vregs.
            if dst > max { max = dst; }
            if lhs > max { max = lhs; }
            if rhs > max { max = rhs; }
        }}
        else { if op == 14 {  // IR_RET: dst is the returned vreg.
            if dst > max { max = dst; }
        }}
        else { if op == 13 {  // IR_CALL: dst = result vreg; imm = arg0_vreg.
            if dst > max { max = dst; }
            imm: u64 = load_u64(ir_buf, op_off + 16);
            imm_lo: u32 = imm & 0xFFFFFFFF;
            if imm_lo > max { max = imm_lo; }
        }}
        else { if op == 11 {  // IR_LOAD: dst = result, lhs = addr (rhs = offset, skip).
            if dst > max { max = dst; }
            if lhs > max { max = lhs; }
        }}
        else { if op == 12 {  // IR_STORE: dst = value, lhs = addr (rhs = offset, skip).
            if dst > max { max = dst; }
            if lhs > max { max = lhs; }
        }}
        else { if op == 15 {  // IR_ALLOC: dst = result ptr (imm = size, skip).
            if dst > max { max = dst; }
        }}
        else { if op == 20 {  // IR_SYSCALL: dst, imm.lo/hi, aux.lo/hi are vregs.
            if dst > max { max = dst; }
            sc_imm: u64 = load_u64(ir_buf, op_off + 16);
            sc_aux: u64 = load_u64(ir_buf, op_off + 24);
            sc_a0: u32 = sc_imm & 0xFFFFFFFF;
            sc_a1: u32 = (sc_imm >> 32) & 0xFFFFFFFF;
            sc_a2: u32 = sc_aux & 0xFFFFFFFF;
            sc_a3: u32 = (sc_aux >> 32) & 0xFFFFFFFF;
            if sc_a0 > max { max = sc_a0; }
            if sc_a1 > max { max = sc_a1; }
            if sc_a2 > max { max = sc_a2; }
            if sc_a3 > max { max = sc_a3; }
        }}
        else { if op == 10 {  // IR_CMP (Wave P6.2): dst, lhs, rhs are all vregs.
            // (imm = cmp_type token, NOT a vreg — skip.)
            if dst > max { max = dst; }
            if lhs > max { max = lhs; }
            if rhs > max { max = rhs; }
        }}
        else { if op == 18 {  // IR_COND_BRANCH (Wave P6.2): dst = cond_vreg.
            // (lhs = 0, rhs = target_label — NOT vregs — skip both.)
            if dst > max { max = dst; }
        }}
        // Other ops (NOP, BRANCH, DIV/AND/OR/XOR/SHL/SHR):
        // not supported in the bootstrap codegen; skip.
        //   - IR_NOP (0): dst = label_id (NOT a vreg).
        //   - IR_BRANCH (17): dst = target_label (NOT a vreg).
        i = i + 1;
    }
    return max;
}

// ============================================================================
// Wave 52 — runtime stub emitters
// ============================================================================
// The bootstrap compiler emits its own runtime stubs (previously these were
// injected by the Rust-side x86_64 backend). The stubs are written at the
// START of the code buffer by emit_runtime_stubs(), called from
// full_lexer.vuma::main() BEFORE codegen_emit() (which emits the user's
// main function after the stubs).
//
// Layout (offsets in the full code buffer):
//   [0..15)     _start stub        (15 bytes — call main; exit(ret_val))
//   [15..101)   print_int routine  (86 bytes — existing emit_print_int_routine)
//   [101..141)  __vuma_alloc       (40 bytes — mmap wrapper)
//   [141..151)  __vuma_free        (10 bytes — munmap syscall 11)
//   [151..181)  print_newline      (30 bytes — write newline to stdout)
//   [181..268)  print_hex          (87 bytes — write bytes as hex)
//   [268..282)  __vuma_argc        (14 bytes — reads argc from BSS slot)
//   [282..297)  __vuma_argv        (15 bytes — reads argv from BSS slot)
//   [297..307)  write              (10 bytes — syscall 1)
//   [307..317)  read               (10 bytes — syscall 0)
//   [317..327)  open               (10 bytes — syscall 2)
//   [327..337)  close              (10 bytes — syscall 3)
//   [337..)     user code (main)   — emitted by codegen_emit
//
// The ELF entry point is offset 0 (_start), which calls main and exits with
// main's return value. print_int is at offset PRINT_INT_OFFSET = 15, so
// codegen_emit's IR_CALL handler passes print_int_offset = 15 to
// enc_call_rel32 when emitting a call to print_int.
//
// LIMITATIONS (documented TODOs for a future wave):
//   - __vuma_argc/__vuma_argv use a BSS placeholder (0xDEADBEEFCAFEBABE)
//     that is NOT patched by the bootstrap (elf.vuma's write_elf64 does not
//     allocate a BSS segment). Calls to these stubs will trap. hello.vuma
//     does not call them, so the Wave 48 self-host test passes. A future
//     wave should add BSS allocation to write_elf64 and patch the
//     placeholder (mirroring src/codegen/src/x86_64/mod.rs::encode_program).
//   - _start does not save argc/argv to a BSS slot (would trap without BSS).
//     The full _start stub (43 bytes, with BSS argv save) lives in the Rust
//     backend's encode_program; the bootstrap uses a 15-byte minimal _start.

const START_STUB_SIZE: u32 = 15;
const PRINT_INT_OFFSET: u32 = 15;  // = START_STUB_SIZE (print_int is right after _start)
const STUBS_SIZE: u32 = 337;       // total bytes emitted by emit_runtime_stubs

// ── _start stub (15 bytes) ──
// Minimal process entry: call main; mov rdi, rax (exit code = main's return);
// mov eax, 60 (sys_exit); syscall.
//
// The full _start stub in the Rust backend (43 bytes) also saves argc/argv
// to a BSS slot so __vuma_argc/__vuma_argv can retrieve them later. The
// bootstrap's elf.vuma does not allocate BSS, so we skip the argv save
// (calls to __vuma_argc/__vuma_argv will trap — documented limitation).
fn emit_start_stub(code: Address, pos: u32, main_offset: u32) -> u32 {
    // E8 <rel32> — call main. rel32 = main_offset - (pos + 5).
    emit_byte(code, pos, 0xE8);
    rel: u32 = main_offset - (pos + 5);
    emit_u32(code, pos + 1, rel);
    // 48 89 C7 — mov rdi, rax (exit code = main's return value)
    emit_byte(code, pos + 5, 0x48);
    emit_byte(code, pos + 6, 0x89);
    emit_byte(code, pos + 7, 0xC7);
    // B8 3C 00 00 00 — mov eax, 60 (sys_exit)
    emit_byte(code, pos + 8, 0xB8);
    emit_byte(code, pos + 9, 0x3C);
    emit_byte(code, pos + 10, 0x00);
    emit_byte(code, pos + 11, 0x00);
    emit_byte(code, pos + 12, 0x00);
    // 0F 05 — syscall
    emit_byte(code, pos + 13, 0x0F);
    emit_byte(code, pos + 14, 0x05);
    return pos + 15;
}

// ── __vuma_alloc (40 bytes) ──
// mmap(NULL, size, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0)
// args: RDI = size → RSI. Returns mapped address in RAX.
fn emit_vuma_alloc(code: Address, pos: u32) -> u32 {
    // 48 89 FE — mov rsi, rdi (size)
    emit_byte(code, pos + 0, 0x48); emit_byte(code, pos + 1, 0x89);
    emit_byte(code, pos + 2, 0xFE);
    // 48 31 FF — xor rdi, rdi (NULL addr)
    emit_byte(code, pos + 3, 0x48); emit_byte(code, pos + 4, 0x31);
    emit_byte(code, pos + 5, 0xFF);
    // 48 C7 C2 03 00 00 00 — mov rdx, 3 (PROT_READ|PROT_WRITE)
    emit_byte(code, pos + 6, 0x48); emit_byte(code, pos + 7, 0xC7);
    emit_byte(code, pos + 8, 0xC2); emit_byte(code, pos + 9, 0x03);
    emit_byte(code, pos + 10, 0x00); emit_byte(code, pos + 11, 0x00);
    emit_byte(code, pos + 12, 0x00);
    // 49 C7 C2 22 00 00 00 — mov r10, 0x22 (MAP_PRIVATE|MAP_ANONYMOUS)
    emit_byte(code, pos + 13, 0x49); emit_byte(code, pos + 14, 0xC7);
    emit_byte(code, pos + 15, 0xC2); emit_byte(code, pos + 16, 0x22);
    emit_byte(code, pos + 17, 0x00); emit_byte(code, pos + 18, 0x00);
    emit_byte(code, pos + 19, 0x00);
    // 49 C7 C0 FF FF FF FF — mov r8, -1 (fd)
    emit_byte(code, pos + 20, 0x49); emit_byte(code, pos + 21, 0xC7);
    emit_byte(code, pos + 22, 0xC0); emit_byte(code, pos + 23, 0xFF);
    emit_byte(code, pos + 24, 0xFF); emit_byte(code, pos + 25, 0xFF);
    emit_byte(code, pos + 26, 0xFF);
    // 4D 31 C9 — xor r9, r9 (offset 0)
    emit_byte(code, pos + 27, 0x4D); emit_byte(code, pos + 28, 0x31);
    emit_byte(code, pos + 29, 0xC9);
    // 48 C7 C0 09 00 00 00 — mov rax, 9 (sys_mmap)
    emit_byte(code, pos + 30, 0x48); emit_byte(code, pos + 31, 0xC7);
    emit_byte(code, pos + 32, 0xC0); emit_byte(code, pos + 33, 0x09);
    emit_byte(code, pos + 34, 0x00); emit_byte(code, pos + 35, 0x00);
    emit_byte(code, pos + 36, 0x00);
    // 0F 05 — syscall
    emit_byte(code, pos + 37, 0x0F); emit_byte(code, pos + 38, 0x05);
    // C3 — ret
    emit_byte(code, pos + 39, 0xC3);
    return pos + 40;
}

// ── __vuma_free (10 bytes) — simple "mov rax, 11; syscall; ret" stub ──
fn emit_vuma_free(code: Address, pos: u32) -> u32 {
    // 48 C7 C0 0B 00 00 00 — mov rax, 11 (sys_munmap)
    emit_byte(code, pos + 0, 0x48); emit_byte(code, pos + 1, 0xC7);
    emit_byte(code, pos + 2, 0xC0); emit_byte(code, pos + 3, 0x0B);
    emit_byte(code, pos + 4, 0x00); emit_byte(code, pos + 5, 0x00);
    emit_byte(code, pos + 6, 0x00);
    // 0F 05 — syscall
    emit_byte(code, pos + 7, 0x0F); emit_byte(code, pos + 8, 0x05);
    // C3 — ret
    emit_byte(code, pos + 9, 0xC3);
    return pos + 10;
}

// ── print_newline (30 bytes) ──
// Writes a single '\n' (0x0A) byte to stdout via write(1, &newline, 1).
fn emit_print_newline(code: Address, pos: u32) -> u32 {
    // 6A 0A — push 0x0A (newline char, sign-extended to 8 bytes on stack)
    emit_byte(code, pos + 0, 0x6A); emit_byte(code, pos + 1, 0x0A);
    // 48 C7 C7 01 00 00 00 — mov rdi, 1 (stdout)
    emit_byte(code, pos + 2, 0x48); emit_byte(code, pos + 3, 0xC7);
    emit_byte(code, pos + 4, 0xC7); emit_byte(code, pos + 5, 0x01);
    emit_byte(code, pos + 6, 0x00); emit_byte(code, pos + 7, 0x00);
    emit_byte(code, pos + 8, 0x00);
    // 48 89 E6 — mov rsi, rsp (buf = &newline on stack)
    emit_byte(code, pos + 9, 0x48); emit_byte(code, pos + 10, 0x89);
    emit_byte(code, pos + 11, 0xE6);
    // 48 C7 C2 01 00 00 00 — mov rdx, 1 (count)
    emit_byte(code, pos + 12, 0x48); emit_byte(code, pos + 13, 0xC7);
    emit_byte(code, pos + 14, 0xC2); emit_byte(code, pos + 15, 0x01);
    emit_byte(code, pos + 16, 0x00); emit_byte(code, pos + 17, 0x00);
    emit_byte(code, pos + 18, 0x00);
    // 48 C7 C0 01 00 00 00 — mov rax, 1 (sys_write)
    emit_byte(code, pos + 19, 0x48); emit_byte(code, pos + 20, 0xC7);
    emit_byte(code, pos + 21, 0xC0); emit_byte(code, pos + 22, 0x01);
    emit_byte(code, pos + 23, 0x00); emit_byte(code, pos + 24, 0x00);
    emit_byte(code, pos + 25, 0x00);
    // 0F 05 — syscall
    emit_byte(code, pos + 26, 0x0F); emit_byte(code, pos + 27, 0x05);
    // 58 — pop rax (restore stack)
    emit_byte(code, pos + 28, 0x58);
    // C3 — ret
    emit_byte(code, pos + 29, 0xC3);
    return pos + 30;
}

// ── print_hex (87 bytes) ──
// Prints `count` bytes from `buf` as hex to stdout.
// Args: RDI = buf pointer, RSI = count.
fn emit_print_hex(code: Address, pos: u32) -> u32 {
    // 55 — push rbp
    emit_byte(code, pos + 0, 0x55);
    // 48 89 E5 — mov rbp, rsp
    emit_byte(code, pos + 1, 0x48); emit_byte(code, pos + 2, 0x89);
    emit_byte(code, pos + 3, 0xE5);
    // 49 89 F8 — mov r8, rdi (buf)
    emit_byte(code, pos + 4, 0x49); emit_byte(code, pos + 5, 0x89);
    emit_byte(code, pos + 6, 0xF8);
    // 49 89 F1 — mov r9, rsi (count)
    emit_byte(code, pos + 7, 0x49); emit_byte(code, pos + 8, 0x89);
    emit_byte(code, pos + 9, 0xF1);
    // 4D 85 C9 — test r9, r9
    emit_byte(code, pos + 10, 0x4D); emit_byte(code, pos + 11, 0x85);
    emit_byte(code, pos + 12, 0xC9);
    // 74 3C — jz +60 (to pop rbp; ret)
    emit_byte(code, pos + 13, 0x74); emit_byte(code, pos + 14, 0x3C);
    // loop_start (offset 15):
    // 41 0F B6 00 — movzx eax, byte [r8]
    emit_byte(code, pos + 15, 0x41); emit_byte(code, pos + 16, 0x0F);
    emit_byte(code, pos + 17, 0xB6); emit_byte(code, pos + 18, 0x00);
    // C1 E8 04 — shr eax, 4
    emit_byte(code, pos + 19, 0xC1); emit_byte(code, pos + 20, 0xE8);
    emit_byte(code, pos + 21, 0x04);
    // 04 30 — add al, 0x30
    emit_byte(code, pos + 22, 0x04); emit_byte(code, pos + 23, 0x30);
    // 3C 3A — cmp al, 0x3A
    emit_byte(code, pos + 24, 0x3C); emit_byte(code, pos + 25, 0x3A);
    // 7C 02 — jl +2
    emit_byte(code, pos + 26, 0x7C); emit_byte(code, pos + 27, 0x02);
    // 04 07 — add al, 7
    emit_byte(code, pos + 28, 0x04); emit_byte(code, pos + 29, 0x07);
    // 88 44 24 F8 — mov [rsp-8], al
    emit_byte(code, pos + 30, 0x88); emit_byte(code, pos + 31, 0x44);
    emit_byte(code, pos + 32, 0x24); emit_byte(code, pos + 33, 0xF8);
    // 41 0F B6 00 — movzx eax, byte [r8]
    emit_byte(code, pos + 34, 0x41); emit_byte(code, pos + 35, 0x0F);
    emit_byte(code, pos + 36, 0xB6); emit_byte(code, pos + 37, 0x00);
    // 83 E0 0F — and eax, 0xF
    emit_byte(code, pos + 38, 0x83); emit_byte(code, pos + 39, 0xE0);
    emit_byte(code, pos + 40, 0x0F);
    // 04 30 — add al, 0x30
    emit_byte(code, pos + 41, 0x04); emit_byte(code, pos + 42, 0x30);
    // 3C 3A — cmp al, 0x3A
    emit_byte(code, pos + 43, 0x3C); emit_byte(code, pos + 44, 0x3A);
    // 7C 02 — jl +2
    emit_byte(code, pos + 45, 0x7C); emit_byte(code, pos + 46, 0x02);
    // 04 07 — add al, 7
    emit_byte(code, pos + 47, 0x04); emit_byte(code, pos + 48, 0x07);
    // 88 44 24 F9 — mov [rsp-7], al
    emit_byte(code, pos + 49, 0x88); emit_byte(code, pos + 50, 0x44);
    emit_byte(code, pos + 51, 0x24); emit_byte(code, pos + 52, 0xF9);
    // BF 01 00 00 00 — mov edi, 1
    emit_byte(code, pos + 53, 0xBF); emit_byte(code, pos + 54, 0x01);
    emit_byte(code, pos + 55, 0x00); emit_byte(code, pos + 56, 0x00);
    emit_byte(code, pos + 57, 0x00);
    // 48 8D 74 24 F8 — lea rsi, [rsp-8]
    emit_byte(code, pos + 58, 0x48); emit_byte(code, pos + 59, 0x8D);
    emit_byte(code, pos + 60, 0x74); emit_byte(code, pos + 61, 0x24);
    emit_byte(code, pos + 62, 0xF8);
    // BA 02 00 00 00 — mov edx, 2
    emit_byte(code, pos + 63, 0xBA); emit_byte(code, pos + 64, 0x02);
    emit_byte(code, pos + 65, 0x00); emit_byte(code, pos + 66, 0x00);
    emit_byte(code, pos + 67, 0x00);
    // 48 C7 C0 01 00 00 00 — mov rax, 1 (sys_write)
    emit_byte(code, pos + 68, 0x48); emit_byte(code, pos + 69, 0xC7);
    emit_byte(code, pos + 70, 0xC0); emit_byte(code, pos + 71, 0x01);
    emit_byte(code, pos + 72, 0x00); emit_byte(code, pos + 73, 0x00);
    emit_byte(code, pos + 74, 0x00);
    // 0F 05 — syscall
    emit_byte(code, pos + 75, 0x0F); emit_byte(code, pos + 76, 0x05);
    // 49 FF C0 — inc r8
    emit_byte(code, pos + 77, 0x49); emit_byte(code, pos + 78, 0xFF);
    emit_byte(code, pos + 79, 0xC0);
    // 49 FF C9 — dec r9
    emit_byte(code, pos + 80, 0x49); emit_byte(code, pos + 81, 0xFF);
    emit_byte(code, pos + 82, 0xC9);
    // 75 BA — jnz -70 (back to loop_start)
    emit_byte(code, pos + 83, 0x75); emit_byte(code, pos + 84, 0xBA);
    // 5D — pop rbp
    emit_byte(code, pos + 85, 0x5D);
    // C3 — ret
    emit_byte(code, pos + 86, 0xC3);
    return pos + 87;
}

// ── __vuma_argc (14 bytes) ──
// Reads argc from a 16-byte BSS slot (offset 0) populated by _start.
// NOTE: The bootstrap's elf.vuma does not allocate BSS, so the placeholder
// (0xDEADBEEFCAFEBABE) is NOT patched. Calls to this stub will trap.
fn emit_vuma_argc(code: Address, pos: u32) -> u32 {
    // 48 B8 <8-byte placeholder> — mov rax, 0xDEADBEEFCAFEBABE
    emit_byte(code, pos + 0, 0x48); emit_byte(code, pos + 1, 0xB8);
    emit_byte(code, pos + 2, 0xBE); emit_byte(code, pos + 3, 0xBA);
    emit_byte(code, pos + 4, 0xFE); emit_byte(code, pos + 5, 0xCA);
    emit_byte(code, pos + 6, 0xEF); emit_byte(code, pos + 7, 0xBE);
    emit_byte(code, pos + 8, 0xAD); emit_byte(code, pos + 9, 0xDE);
    // 48 8B 00 — mov rax, [rax]
    emit_byte(code, pos + 10, 0x48); emit_byte(code, pos + 11, 0x8B);
    emit_byte(code, pos + 12, 0x00);
    // C3 — ret
    emit_byte(code, pos + 13, 0xC3);
    return pos + 14;
}

// ── __vuma_argv (15 bytes) ──
// Reads argv from the BSS slot (offset 8). Same placeholder caveat as
// __vuma_argc — calls will trap without BSS patching.
fn emit_vuma_argv(code: Address, pos: u32) -> u32 {
    // 48 B8 <8-byte placeholder> — mov rax, 0xDEADBEEFCAFEBABE
    emit_byte(code, pos + 0, 0x48); emit_byte(code, pos + 1, 0xB8);
    emit_byte(code, pos + 2, 0xBE); emit_byte(code, pos + 3, 0xBA);
    emit_byte(code, pos + 4, 0xFE); emit_byte(code, pos + 5, 0xCA);
    emit_byte(code, pos + 6, 0xEF); emit_byte(code, pos + 7, 0xBE);
    emit_byte(code, pos + 8, 0xAD); emit_byte(code, pos + 9, 0xDE);
    // 48 8B 40 08 — mov rax, [rax+8]
    emit_byte(code, pos + 10, 0x48); emit_byte(code, pos + 11, 0x8B);
    emit_byte(code, pos + 12, 0x40); emit_byte(code, pos + 13, 0x08);
    // C3 — ret
    emit_byte(code, pos + 14, 0xC3);
    return pos + 15;
}

// ── write (10 bytes) — simple "mov rax, 1; syscall; ret" stub (sys_write) ──
fn emit_write(code: Address, pos: u32) -> u32 {
    // 48 C7 C0 01 00 00 00 — mov rax, 1 (sys_write)
    emit_byte(code, pos + 0, 0x48); emit_byte(code, pos + 1, 0xC7);
    emit_byte(code, pos + 2, 0xC0); emit_byte(code, pos + 3, 0x01);
    emit_byte(code, pos + 4, 0x00); emit_byte(code, pos + 5, 0x00);
    emit_byte(code, pos + 6, 0x00);
    // 0F 05 — syscall
    emit_byte(code, pos + 7, 0x0F); emit_byte(code, pos + 8, 0x05);
    // C3 — ret
    emit_byte(code, pos + 9, 0xC3);
    return pos + 10;
}

// ── read (10 bytes) — simple "mov rax, 0; syscall; ret" stub (sys_read) ──
fn emit_read(code: Address, pos: u32) -> u32 {
    // 48 C7 C0 00 00 00 00 — mov rax, 0 (sys_read)
    emit_byte(code, pos + 0, 0x48); emit_byte(code, pos + 1, 0xC7);
    emit_byte(code, pos + 2, 0xC0); emit_byte(code, pos + 3, 0x00);
    emit_byte(code, pos + 4, 0x00); emit_byte(code, pos + 5, 0x00);
    emit_byte(code, pos + 6, 0x00);
    // 0F 05 — syscall
    emit_byte(code, pos + 7, 0x0F); emit_byte(code, pos + 8, 0x05);
    // C3 — ret
    emit_byte(code, pos + 9, 0xC3);
    return pos + 10;
}

// ── open (10 bytes) — simple "mov rax, 2; syscall; ret" stub (sys_open) ──
fn emit_open(code: Address, pos: u32) -> u32 {
    // 48 C7 C0 02 00 00 00 — mov rax, 2 (sys_open)
    emit_byte(code, pos + 0, 0x48); emit_byte(code, pos + 1, 0xC7);
    emit_byte(code, pos + 2, 0xC0); emit_byte(code, pos + 3, 0x02);
    emit_byte(code, pos + 4, 0x00); emit_byte(code, pos + 5, 0x00);
    emit_byte(code, pos + 6, 0x00);
    // 0F 05 — syscall
    emit_byte(code, pos + 7, 0x0F); emit_byte(code, pos + 8, 0x05);
    // C3 — ret
    emit_byte(code, pos + 9, 0xC3);
    return pos + 10;
}

// ── close (10 bytes) — simple "mov rax, 3; syscall; ret" stub (sys_close) ──
fn emit_close(code: Address, pos: u32) -> u32 {
    // 48 C7 C0 03 00 00 00 — mov rax, 3 (sys_close)
    emit_byte(code, pos + 0, 0x48); emit_byte(code, pos + 1, 0xC7);
    emit_byte(code, pos + 2, 0xC0); emit_byte(code, pos + 3, 0x03);
    emit_byte(code, pos + 4, 0x00); emit_byte(code, pos + 5, 0x00);
    emit_byte(code, pos + 6, 0x00);
    // 0F 05 — syscall
    emit_byte(code, pos + 7, 0x0F); emit_byte(code, pos + 8, 0x05);
    // C3 — ret
    emit_byte(code, pos + 9, 0xC3);
    return pos + 10;
}

// emit_runtime_stubs: write all runtime stubs at the start of the code buffer.
// Returns the total bytes written (= STUBS_SIZE = 337).
//
// The stubs are emitted in a fixed order (see the layout comment above).
// The _start stub's `call main` rel32 points to offset STUBS_SIZE (where
// codegen_emit will emit the user's main function).
fn emit_runtime_stubs(code: Address, code_cap: u32) -> u32 {
    pos: u32 = 0;
    // 1. _start stub (15 bytes) — entry point, calls main at offset STUBS_SIZE
    pos = emit_start_stub(code, pos, STUBS_SIZE);
    // 2. print_int routine (86 bytes) — at offset PRINT_INT_OFFSET = 15
    pos = emit_print_int_routine(code, pos);
    // 3. __vuma_alloc (40 bytes) — mmap wrapper
    pos = emit_vuma_alloc(code, pos);
    // 4. __vuma_free (10 bytes) — munmap
    pos = emit_vuma_free(code, pos);
    // 5. print_newline (30 bytes)
    pos = emit_print_newline(code, pos);
    // 6. print_hex (87 bytes)
    pos = emit_print_hex(code, pos);
    // 7. __vuma_argc (14 bytes) — BSS placeholder, traps without patching
    pos = emit_vuma_argc(code, pos);
    // 8. __vuma_argv (15 bytes) — BSS placeholder, traps without patching
    pos = emit_vuma_argv(code, pos);
    // 9. write (10 bytes) — sys_write
    pos = emit_write(code, pos);
    // 10. read (10 bytes) — sys_read
    pos = emit_read(code, pos);
    // 11. open (10 bytes) — sys_open
    pos = emit_open(code, pos);
    // 12. close (10 bytes) — sys_close
    pos = emit_close(code, pos);
    // Total = STUBS_SIZE = 337. code_cap is a future safety check (TODO).
    return pos;
}

// codegen_emit: walk the IR buffer and emit x86_64 machine code.
//
// codegen_emit emits ONLY the user's main function; runtime stubs (_start,
// print_int, __vuma_alloc, etc.) are emitted separately by emit_runtime_stubs()
// at offset 0. codegen_emit starts at offset `start_offset` (= STUBS_SIZE).
//
// Inputs:
//   ir_buf            — heap pointer to the IR buffer (layout per ir.vuma:
//                       [count: u32][cap: u32][instr * count: 32 bytes each])
//   code              — heap pointer to the output code buffer (caller-owned;
//                       runtime stubs are already at code[0..start_offset])
//   code_cap          — capacity of `code` in bytes
//   start_offset      — byte offset where user code emission begins
//                       (= STUBS_SIZE, set by emit_runtime_stubs)
//   print_int_offset  — byte offset of the print_int routine within `code`
//                       (= PRINT_INT_OFFSET = 15; used as the IR_CALL target
//                       for calls to print_int)
//   print_int_hash    — FNV-1a 32-bit hash of "print_int" (computed by the
//                       driver via name_hash); used to dispatch IR_CALL targets
//
// Returns: total bytes emitted into `code` (== end offset; since emission
// starts at start_offset, the return value is start_offset + user_code_size,
// which is the total code size including runtime stubs).
//
// Supported IR opcodes (the hello.vuma subset + Wave P6.2 control flow):
//   IR_MOV (16)   — mov rax, imm64; mov [rbp-vreg_off], rax
//   IR_ADD (1)    — load lhs,load rhs,add,store dst
//   IR_SUB (2)    — same with sub
//   IR_MUL (3)    — same with imul
//   IR_RET (14)   — load dst into rdi (or xor edi if dst==0); mov eax, 60; syscall
//   IR_CALL (13)  — if callee_hash == print_int_hash and arg_count >= 1:
//                     load arg0 into rdi; call print_int (rel32 to
//                     print_int_offset = 15 in the stubs layout)
//                   else: skip silently (real calls are a TODO)
//   IR_LOAD (11)  — byte load from [addr_vreg + offset]            (Wave P6.1)
//   IR_STORE (12) — byte store to [addr_vreg + offset]             (Wave P6.1)
//   IR_ALLOC (15) — stack allocation (lea slot addr into the slot)  (Wave P6.1)
//   IR_SYSCALL(20)— x86_64 syscall with up to 4 args               (Wave P1-c-8b)
//   IR_NOP (0)    — label marker (dst=label_id): record code offset (Wave P6.2)
//                   true NOP (dst==0): emit nothing
//   IR_CMP (10)   — cmp lhs,rhs; setCC al; movzx eax,al; store dst  (Wave P6.2)
//                   (imm.lo = cmp_type token 46..51)
//   IR_COND_BRANCH(18) — test cond; jz <rel32 to rhs=label>         (Wave P6.2)
//                        (rel32 back-patched in a post-pass)
//   IR_BRANCH (17)— jmp <rel32 to dst=label>                        (Wave P6.2)
//                   (rel32 back-patched in a post-pass)
//
// Unsupported (silently skipped — documented TODO):
//   IR_DIV/AND/OR/XOR/SHL/SHR (4-9) — remaining ALU ops.
fn codegen_emit(ir_buf: Address, code: Address, code_cap: u32, start_offset: u32, print_int_offset: u32, print_int_hash: u32) -> u32 {
    pos: u32 = start_offset;

    // Wave P6.2: label / fixup side buffers for IR_BRANCH / IR_COND_BRANCH.
    // label_buf[label_id] (u64) = code offset of the label marker (set when
    //   IR_NOP with dst=label_id is seen).
    // fixup_buf[fixup_count] = {fixup_pos:u32, target_label:u32} (recorded
    //   when a branch is emitted; patched in a post-pass once all labels
    //   are known). __vuma_alloc returns zeroed memory (mmap MAP_ANONYMOUS),
    //   so unset label slots read as 0 (defensive: a branch to an undefined
    //   label would target offset 0 = _start stub — should not happen for
    //   well-formed IR).
    label_buf: Address = __vuma_alloc(2048);   // 8 * MAX_LABELS = 8 * 256
    fixup_buf: Address = __vuma_alloc(2048);   // 8 * MAX_FIXUPS = 8 * 256
    fixup_count: u32 = 0;

    // 1. Emit main prologue.
    //    (Runtime stubs — _start, print_int, __vuma_alloc, etc. — are emitted
    //    at offset 0 by emit_runtime_stubs(), called from full_lexer.vuma::main
    //    BEFORE codegen_emit. codegen_emit emits only the user's main function,
    //    starting at offset start_offset = STUBS_SIZE.)
    //    Frame size: 8 bytes per vreg, rounded up to 16-byte alignment
    //    (System V ABI requires rsp % 16 == 0 at call boundaries; the
    //    prologue's `push rbp` misaligns by 8, so we need `sub rsp, frame`
    //    to bring rsp back to 16-aligned).
    max_vreg: u32 = codegen_max_vreg(ir_buf);
    frame_size: u32 = (max_vreg + 1) * 8;
    if frame_size % 16 != 0 { frame_size = frame_size + 8; }
    if frame_size == 0 { frame_size = 16; }  // minimum: keep rsp aligned
    pos = gen_prologue(code, pos, frame_size);

    // 2. Walk IR and emit code per opcode.
    count: u32 = load_u32(ir_buf, 0);
    i: u32 = 0;
    while i < count {
        op_off: u32 = 8 + i * 32;
        op: u32 = load_u32(ir_buf, op_off);
        dst: u32 = load_u32(ir_buf, op_off + 4);
        lhs: u32 = load_u32(ir_buf, op_off + 8);
        rhs: u32 = load_u32(ir_buf, op_off + 12);
        imm: u64 = load_u64(ir_buf, op_off + 16);
        aux: u64 = load_u64(ir_buf, op_off + 24);  // P1-c-8b: needed for IR_SYSCALL multi-arg

        if op == 16 {  // IR_MOV: dst = imm
            pos = enc_mov_rax_imm64(code, pos, imm);
            pos = enc_store_rax(code, pos, vreg_offset(dst));
        }
        else { if op == 1 || op == 2 || op == 3 {  // ADD / SUB / MUL
            pos = enc_load_rax(code, pos, vreg_offset(lhs));
            pos = enc_load_rcx(code, pos, vreg_offset(rhs));
            if op == 1 { pos = enc_add_rax_rcx(code, pos); }
            else { if op == 2 { pos = enc_sub_rax_rcx(code, pos); }
            else { pos = enc_imul_rax_rcx(code, pos); } }
            pos = enc_store_rax(code, pos, vreg_offset(dst));
        }}
        else { if op == 14 {  // IR_RET: exit(dst)
            if dst == 0 {
                pos = enc_xor_edi(code, pos);  // exit code 0
            } else {
                pos = enc_load_rax(code, pos, vreg_offset(dst));
                pos = enc_mov_rdi_rax(code, pos);  // rdi = exit code
            }
            pos = enc_mov_eax_imm32(code, pos, 60);  // sys_exit_group
            pos = enc_syscall(code, pos);
        }}
        else { if op == 13 {  // IR_CALL
            if lhs == print_int_hash {
                if rhs >= 1 {
                    arg0: u32 = imm & 0xFFFFFFFF;
                    pos = enc_load_rdi(code, pos, vreg_offset(arg0));
                    // Backward call to print_int at offset print_int_offset
                    // (= PRINT_INT_OFFSET = 15 in the stubs layout). Since
                    // codegen_emit's `pos` starts at start_offset = STUBS_SIZE,
                    // this is a backward (negative) rel32.
                    pos = enc_call_rel32(code, pos, print_int_offset);
                }
            }
            // allocate/__vuma_alloc → call __vuma_alloc stub (mmap wrapper)
            if lhs == ALLOC_HASH {
                if rhs >= 1 {
                    arg0: u32 = imm & 0xFFFFFFFF;
                    pos = enc_load_rdi(code, pos, vreg_offset(arg0));
                }
                pos = enc_call_rel32(code, pos, VUMA_ALLOC_OFFSET);
                pos = enc_store_rax(code, pos, vreg_offset(dst));
            }
            // free/__vuma_free → call __vuma_free stub (munmap wrapper)
            if lhs == FREE_HASH {
                if rhs >= 1 {
                    pos = enc_load_rdi(code, pos, vreg_offset(imm & 0xFFFFFFFF));
                }
                pos = enc_call_rel32(code, pos, VUMA_FREE_OFFSET);
            }
        }}
        else { if op == 20 {  // IR_SYSCALL (Wave P1-c-8 / P1-c-8b)
            // x86_64 syscall ABI: nr in EAX, args in RDI/RSI/RDX/R10/R8/R9,
            // result in RAX. lhs = VUMA/asm-generic nr (translate first),
            // rhs = arg_count, imm.lo=arg0_vreg, imm.hi=arg1_vreg,
            // aux.lo=arg2_vreg, aux.hi=arg3_vreg. P1-c-8b multi-arg.
            // Load args in REVERSE order (arg3 → arg2 → arg1 → arg0) so
            // no later load clobbers an earlier-loaded register: every
            // load reads from a distinct stack slot, so order doesn't
            // strictly matter, but reverse order is the defensive choice.
            native_nr: u32 = translate_syscall_nr_x86_64(lhs);
            arg0_v: u32 = imm & 0xFFFFFFFF;
            arg1_v: u32 = (imm >> 32) & 0xFFFFFFFF;
            arg2_v: u32 = aux & 0xFFFFFFFF;
            arg3_v: u32 = (aux >> 32) & 0xFFFFFFFF;
            if rhs >= 4 {
                pos = enc_load_r10(code, pos, vreg_offset(arg3_v));
            }
            if rhs >= 3 {
                pos = enc_load_rdx(code, pos, vreg_offset(arg2_v));
            }
            if rhs >= 2 {
                pos = enc_load_rsi(code, pos, vreg_offset(arg1_v));
            }
            if rhs >= 1 {
                pos = enc_load_rdi(code, pos, vreg_offset(arg0_v));
            }
            pos = enc_mov_eax_imm32(code, pos, native_nr);
            pos = enc_syscall(code, pos);
            pos = enc_store_rax(code, pos, vreg_offset(dst));
        }}
        else { if op == 15 {  // IR_ALLOC (Wave P6.1) — stack allocation.
            // IR layout: op=15, dst=vreg, imm=size. The stack frame is
            // already allocated in the prologue (sub rsp, frame_size); each
            // vreg has an 8-byte slot at [rbp - vreg_offset(n)]. For
            // IR_ALLOC, the dst vreg's slot IS the allocation — we store
            // the slot's own address into the slot so subsequent loads of
            // dst yield a pointer to the allocated space. Emit:
            //   lea rax, [rbp - vreg_offset(dst)]   ; rax = &slot
            //   mov [rbp - vreg_offset(dst)], rax   ; slot = &slot
            pos = enc_lea_rax_rbp_offset(code, pos, vreg_offset(dst));
            pos = enc_store_rax(code, pos, vreg_offset(dst));
        }}
        else { if op == 12 {  // IR_STORE (Wave P6.1) — byte store to memory.
            // IR layout: op=12, dst=value_vreg, lhs=addr_vreg, rhs=byte_offset.
            // Emit: load value into RAX, load addr into RCX, store low byte
            // of RAX to [RCX + offset].
            //   mov rax, [rbp - vreg_offset(dst)]   ; rax = value
            //   mov rcx, [rbp - vreg_offset(lhs)]   ; rcx = addr
            //   mov [rcx + rhs], al                  ; *(addr + off) = value & 0xFF
            pos = enc_load_rax(code, pos, vreg_offset(dst));
            pos = enc_load_rcx(code, pos, vreg_offset(lhs));
            pos = enc_store_byte_rcx_rax(code, pos, rhs);
        }}
        else { if op == 11 {  // IR_LOAD (Wave P6.1) — byte load from memory.
            // IR layout: op=11, dst=result_vreg, lhs=addr_vreg, rhs=byte_offset.
            // Emit: load addr into RAX, zero-extend byte load from [RAX + offset]
            // into EAX (which zero-extends to RAX), store result to dst's slot.
            //   mov rax, [rbp - vreg_offset(lhs)]   ; rax = addr
            //   movzbl eax, [rax + rhs]              ; eax = *(addr + off) (zero-extended)
            //   mov [rbp - vreg_offset(dst)], rax   ; dst = result
            pos = enc_load_rax(code, pos, vreg_offset(lhs));
            pos = enc_movzbl_eax_rax_offset(code, pos, rhs);
            pos = enc_store_rax(code, pos, vreg_offset(dst));
        }}
        else { if op == 0 {  // IR_NOP (Wave P6.2) — label marker or true NOP.
            // IR layout: op=0, dst=label_id (0 for a true NOP). When dst != 0,
            // record the current code position as the label's target offset
            // so subsequent IR_BRANCH / IR_COND_BRANCH fixups can resolve.
            if dst != 0 {
                store_u64(label_buf, dst * 8, pos);
            }
            // dst == 0: true NOP — emit nothing.
        }}
        else { if op == 10 {  // IR_CMP (Wave P6.2) — comparison.
            // IR layout: op=10, dst=result_vreg, lhs=lhs_vreg, rhs=rhs_vreg,
            // imm (lower 32)=cmp_type token (46===, 47=!=, 48=<, 49=>,
            // 50=<=, 51=>=). Emit: load lhs→RAX, load rhs→RCX, cmp rax,rcx,
            // setCC al, movzx eax,al, store RAX→dst.
            cmp_type: u32 = imm & 0xFFFFFFFF;
            pos = enc_load_rax(code, pos, vreg_offset(lhs));
            pos = enc_load_rcx(code, pos, vreg_offset(rhs));
            // cmp rax, rcx: 48 39 C8
            emit_byte(code, pos, 0x48);
            emit_byte(code, pos + 1, 0x39);
            emit_byte(code, pos + 2, 0xC8);
            pos = pos + 3;
            // setCC al (3 bytes: 0F <cc> C0). Pick the condition byte by
            // standalone ifs (avoids a deeply-nested else-if chain that
            // vuma's parser rejects). Default to setge (>=) for unknown.
            cc: u32 = 0x9D;  // setge (default for 51/>= or unknown)
            if cmp_type == 46 { cc = 0x94; }  // ==  → sete
            if cmp_type == 47 { cc = 0x95; }  // !=  → setne
            if cmp_type == 48 { cc = 0x9C; }  // <   → setl
            if cmp_type == 49 { cc = 0x9F; }  // >   → setg
            if cmp_type == 50 { cc = 0x9E; }  // <=  → setle
            emit_byte(code, pos, 0x0F);
            emit_byte(code, pos + 1, cc);
            emit_byte(code, pos + 2, 0xC0);
            pos = pos + 3;
            // movzx eax, al: 0F B6 C0  (zero-extend the setCC result into EAX/RAX)
            emit_byte(code, pos, 0x0F);
            emit_byte(code, pos + 1, 0xB6);
            emit_byte(code, pos + 2, 0xC0);
            pos = pos + 3;
            pos = enc_store_rax(code, pos, vreg_offset(dst));
        }}
        else { if op == 18 {  // IR_COND_BRANCH (Wave P6.2) — conditional jump.
            // IR layout: op=18, dst=cond_vreg, lhs=0, rhs=target_label.
            // Emit: load cond→RAX, test rax,rax, jz <rel32 to target_label>.
            // The rel32 is back-patched in the fixup walk once all labels
            // are known. (Jump-if-zero semantics: skip the branch body when
            // the condition is false / zero.)
            pos = enc_load_rax(code, pos, vreg_offset(dst));
            // test rax, rax: 48 85 C0
            emit_byte(code, pos, 0x48);
            emit_byte(code, pos + 1, 0x85);
            emit_byte(code, pos + 2, 0xC0);
            pos = pos + 3;
            // jz rel32: 0F 84 <rel32>
            emit_byte(code, pos, 0x0F);
            emit_byte(code, pos + 1, 0x84);
            cb_fixup_pos: u32 = pos + 2;       // start of rel32 bytes
            cb_target_label: u32 = rhs;
            emit_u32(code, cb_fixup_pos, 0);   // placeholder (patched later)
            store_u32(fixup_buf, fixup_count * 8, cb_fixup_pos);
            store_u32(fixup_buf, fixup_count * 8 + 4, cb_target_label);
            fixup_count = fixup_count + 1;
            pos = pos + 6;                      // 2 opcode bytes + 4 rel32
        }}
        else { if op == 17 {  // IR_BRANCH (Wave P6.2) — unconditional jump.
            // IR layout: op=17, dst=target_label, lhs=0, rhs=0.
            // Emit: jmp <rel32 to target_label>. Patched in the fixup walk.
            // jmp rel32: E9 <rel32>
            emit_byte(code, pos, 0xE9);
            br_fixup_pos: u32 = pos + 1;        // start of rel32 bytes
            br_target_label: u32 = dst;
            emit_u32(code, br_fixup_pos, 0);    // placeholder (patched later)
            store_u32(fixup_buf, fixup_count * 8, br_fixup_pos);
            store_u32(fixup_buf, fixup_count * 8 + 4, br_target_label);
            fixup_count = fixup_count + 1;
            pos = pos + 5;                       // 1 opcode byte + 4 rel32
        }}
        // IR_DIV/AND/OR/XOR/SHL/SHR (4-9), etc.: not handled in the bootstrap
        // codegen. hello.vuma doesn't use them; remaining ALU ops are
        // documented TODO for a future wave.

        i = i + 1;
    }

    // 3. Walk the fixup buffer and back-patch each branch rel32 now that
    //    all label markers have been resolved. For each fixup entry:
    //      rel32 = target_offset - (fixup_pos + 4)
    //    (u32 subtraction wraps modulo 2^32, giving the correct two's-
    //    complement bit pattern for both forward (positive) and backward
    //    (negative) branches — same trick as enc_call_rel32). Written
    //    little-endian into code[fixup_pos..fixup_pos+4].
    j: u32 = 0;
    while j < fixup_count {
        fp: u32 = load_u32(fixup_buf, j * 8);
        tl: u32 = load_u32(fixup_buf, j * 8 + 4);
        target_off: u64 = load_u64(label_buf, tl * 8);
        target_off_u32: u32 = target_off & 0xFFFFFFFF;
        rel: u32 = target_off_u32 - (fp + 4);
        emit_u32(code, fp, rel);
        j = j + 1;
    }

    // 4. Defensive exit(0) — in case the IR didn't end with IR_RET.
    //    Unreachable for well-formed input (irb_lower_fn ensures a trailing
    //    RET), but guarantees the emitted binary never falls off .text.
    pos = enc_xor_edi(code, pos);
    pos = enc_mov_eax_imm32(code, pos, 60);
    pos = enc_syscall(code, pos);

    return pos;
}
