// womb/lang/ir_builder.vuma — IR builder: AST → IR
// Walks the AST arena and generates IR instructions.
// Handles: expressions, statements, control flow, function calls.
//
// The IR builder maintains a symbol table (BTreeMap) mapping variable
// names to vreg IDs. Each function gets its own IR buffer.

extern "C" {
    fn __vuma_alloc(size: i64) -> Address;
    fn __vuma_free(addr: Address, size: i64);
}

fn store_u64(ptr: Address, offset: u32, val: u64) {
    *(ptr + offset) = val & 255; *(ptr + offset + 1) = (val >> 8) & 255;
    *(ptr + offset + 2) = (val >> 16) & 255; *(ptr + offset + 3) = (val >> 24) & 255;
    *(ptr + offset + 4) = (val >> 32) & 255; *(ptr + offset + 5) = (val >> 40) & 255;
    *(ptr + offset + 6) = (val >> 48) & 255; *(ptr + offset + 7) = (val >> 56) & 255;
}
fn load_u64(ptr: Address, offset: u32) -> u64 {
    b0: u64 = *(ptr + offset); b1: u64 = *(ptr + offset + 1);
    b2: u64 = *(ptr + offset + 2); b3: u64 = *(ptr + offset + 3);
    b4: u64 = *(ptr + offset + 4); b5: u64 = *(ptr + offset + 5);
    b6: u64 = *(ptr + offset + 6); b7: u64 = *(ptr + offset + 7);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56);
}
fn store_u32(ptr: Address, offset: u32, val: u32) {
    *(ptr + offset) = val & 255; *(ptr + offset + 1) = (val >> 8) & 255;
    *(ptr + offset + 2) = (val >> 16) & 255; *(ptr + offset + 3) = (val >> 24) & 255;
}
fn load_u32(ptr: Address, offset: u32) -> u32 {
    b0: u32 = *(ptr + offset); b1: u32 = *(ptr + offset + 1);
    b2: u32 = *(ptr + offset + 2); b3: u32 = *(ptr + offset + 3);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

// IR opcodes (matches ir.vuma)
const IR_NOP: u32 = 0;
const IR_ADD: u32 = 1;
const IR_SUB: u32 = 2;
const IR_MUL: u32 = 3;
const IR_DIV: u32 = 4;
const IR_AND: u32 = 5;
const IR_OR: u32 = 6;
const IR_XOR: u32 = 7;
const IR_SHL: u32 = 8;
const IR_SHR: u32 = 9;
const IR_CMP: u32 = 10;
const IR_LOAD: u32 = 11;
const IR_STORE: u32 = 12;
const IR_CALL: u32 = 13;
const IR_RET: u32 = 14;
const IR_ALLOC: u32 = 15;
const IR_MOV: u32 = 16;
const IR_BRANCH: u32 = 17;
const IR_COND_BRANCH: u32 = 18;
// Wave P1-c-8: raw syscall intrinsic. dst = result vreg, lhs = syscall nr
// (VUMA/asm-generic — codegen translates to per-ISA native), rhs = arg_count,
// imm (lower 32) = arg0_vreg. Same single-arg limitation as IR_CALL.
const IR_SYSCALL: u32 = 20;

const IR_SIZE: u32 = 32;

// Builder state (48 bytes):
//   0-7:   ir_buf ptr
//   8-11:  next_vreg (u32)
//   12-15: next_label (u32)
//   16-23: symtab ptr (BTreeMap or simple array)
//   24-27: symtab_count
//   28-31: alloc_hash      (FNV-1a of "allocate"       — Wave P6.3)
//   32-35: free_hash       (FNV-1a of "free"            — Wave P6.3)
//   36-39: vuma_alloc_hash (FNV-1a of "__vuma_alloc"   — Wave P6.3)
//   40-43: vuma_free_hash  (FNV-1a of "__vuma_free"    — Wave P6.3)
//   44-47: _pad
//
// Wave P6.3: the 4 callee-name hashes are set by the driver (full_lexer.vuma
// via irb_set_alloc_hashes) before irb_lower_fn runs, so the NK_CALL handler
// can intercept allocate/free calls and lower them to IR_ALLOC / IR_SYSCALL
// instead of the generic IR_CALL (which the codegen skips for non-print_int
// callees). 0 means "not set" (no interception); the FNV-1a hash of any
// non-empty identifier is always non-zero (initial offset 0x811C9DC5).

fn irb_new(ir_buf: Address) -> Address {
    b = __vuma_alloc(48);
    store_u64(b, 0, ir_buf);
    store_u32(b, 8, 1);   // next_vreg starts at 1 (0 is reserved)
    store_u32(b, 12, 0);  // next_label
    // Simple symbol table: array of (name_hash: u32, vreg: u32) = 8 bytes each
    symtab = __vuma_alloc(4096);  // 512 symbols max
    store_u64(b, 16, symtab);
    store_u32(b, 24, 0);  // symtab count
    // Wave P6.3: hash slots default to 0 (no interception) until the driver
    // calls irb_set_alloc_hashes. __vuma_alloc returns zeroed mmap memory,
    // so this is belt-and-suspenders.
    store_u32(b, 28, 0);  // alloc_hash
    store_u32(b, 32, 0);  // free_hash
    store_u32(b, 36, 0);  // vuma_alloc_hash
    store_u32(b, 40, 0);  // vuma_free_hash
    return b;
}

// Wave P6.3: stash the 4 callee-name hashes computed by the driver
// (full_lexer.vuma::main via name_hash) into the builder state. Must be
// called after irb_new and before irb_lower_fn / irb_lower_expr.
fn irb_set_alloc_hashes(b: Address, alloc_h: u32, free_h: u32, valloc_h: u32, vfree_h: u32) {
    store_u32(b, 28, alloc_h);
    store_u32(b, 32, free_h);
    store_u32(b, 36, valloc_h);
    store_u32(b, 40, vfree_h);
}

fn irb_alloc_vreg(b: Address) -> u32 {
    v: u32 = load_u32(b, 8);
    store_u32(b, 8, v + 1);
    return v;
}

fn irb_alloc_label(b: Address) -> u32 {
    l: u32 = load_u32(b, 12);
    store_u32(b, 12, l + 1);
    return l;
}

// Emit IR instruction
fn irb_emit(b: Address, op: u32, dst: u32, lhs: u32, rhs: u32, imm: u64, aux: u64) {
    ir_buf: u64 = load_u64(b, 0);
    count: u32 = load_u32(ir_buf, 0);
    cap: u32 = load_u32(ir_buf, 4);
    if count >= cap { return; }  // TODO: grow
    offset: u32 = 8 + count * IR_SIZE;
    store_u32(ir_buf, offset, op);
    store_u32(ir_buf, offset + 4, dst);
    store_u32(ir_buf, offset + 8, lhs);
    store_u32(ir_buf, offset + 12, rhs);
    store_u64(ir_buf, offset + 16, imm);
    store_u64(ir_buf, offset + 24, aux);
    store_u32(ir_buf, 0, count + 1);
}

// ── Symbol table ──
// Simple linear scan for now (O(n), fine for small functions)
fn irb_sym_lookup(b: Address, name_hash: u32) -> u32 {
    symtab: u64 = load_u64(b, 16);
    count: u32 = load_u32(b, 24);
    i: u32 = 0;
    while i < count {
        h: u32 = load_u32(symtab, i * 8);
        if h == name_hash { return load_u32(symtab, i * 8 + 4); }
        i = i + 1;
    }
    return 0;  // not found
}

fn irb_sym_insert(b: Address, name_hash: u32, vreg: u32) {
    symtab: u64 = load_u64(b, 16);
    count: u32 = load_u32(b, 24);
    store_u32(symtab, count * 8, name_hash);
    store_u32(symtab, count * 8 + 4, vreg);
    store_u32(b, 24, count + 1);
}

// ── AST → IR lowering ──
// Lower an expression AST node. Returns the destination vreg.
fn irb_lower_expr(b: Address, ast: u64, node_idx: u32) -> u32 {
    // Read node
    node_offset: u32 = 8 + node_idx * 40;
    kind: u32 = load_u32(ast, node_offset);
    c1: u32 = load_u32(ast, node_offset + 4);
    c2: u32 = load_u32(ast, node_offset + 8);
    c3: u32 = load_u32(ast, node_offset + 12);
    val: u64 = load_u64(ast, node_offset + 16);
    
    // NK_INT (1): MOV dst, imm
    if kind == 1 {
        dst: u32 = irb_alloc_vreg(b);
        irb_emit(b, IR_MOV, dst, 0, 0, val, 0);
        return dst;
    }
    
    // NK_IDENT (2): look up in symbol table
    if kind == 2 {
        // c1 contains the token index, but we need the name hash.
        // For now, use val as the name hash (the parser should set this).
        return irb_sym_lookup(b, val & 0xFFFFFFFF);
    }
    
    // NK_BINOP (3): c1=op, c2=lhs_node, c3=rhs_node
    if kind == 3 {
        lhs_vreg: u32 = irb_lower_expr(b, ast, c2);
        rhs_vreg: u32 = irb_lower_expr(b, ast, c3);
        dst = irb_alloc_vreg(b);
        op: u32 = 0;
        // Map token types to IR opcodes
        if c1 == 40 { op = IR_ADD; }      // +
        else { if c1 == 41 { op = IR_SUB; } }  // -
        else { if c1 == 42 { op = IR_MUL; } }  // *
        else { if c1 == 43 { op = IR_DIV; } }  // /
        else { if c1 == 44 { op = 4; } }       // % (use DIV, TODO: separate REM)
        else { if c1 == 55 { op = IR_AND; } }  // &
        else { if c1 == 56 { op = IR_OR; } }   // |
        else { if c1 == 57 { op = IR_XOR; } }  // ^
        else { if c1 == 59 { op = IR_SHL; } }  // <<
        else { if c1 == 60 { op = IR_SHR; } }  // >>
        else { if c1 == 46 { op = IR_CMP; } }  // ==
        else { if c1 == 47 { op = IR_CMP; } }  // !=
        else { if c1 == 48 { op = IR_CMP; } }  // <
        else { if c1 == 49 { op = IR_CMP; } }  // >
        else { if c1 == 50 { op = IR_CMP; } }  // <=
        else { if c1 == 51 { op = IR_CMP; } }  // >=
        else { op = IR_ADD; }  // default
        // Wave P6.2: comparisons (==/!=/</>/>=/<=) carry the original token
        // type (c1) in the IR instruction's `imm` field so the bootstrap
        // codegen can emit the matching setCC opcode. Non-comparison ops
        // (arithmetic / bitwise / shifts) leave imm=0.
        imm_val: u64 = 0;
        if op == IR_CMP { imm_val = c1; }
        irb_emit(b, op, dst, lhs_vreg, rhs_vreg, imm_val, 0);
        return dst;
    }
    
    // NK_DEREF (6): LOAD dst, addr
    if kind == 6 {
        addr_vreg: u32 = irb_lower_expr(b, ast, c1);
        dst = irb_alloc_vreg(b);
        irb_emit(b, IR_LOAD, dst, addr_vreg, 0, 0, 0);
        return dst;
    }
    
    // NK_ASSIGN (7): evaluate rhs, store to lhs.
    // c1 = lhs node idx, c2 = rhs node idx.
    // Wave P6.1: if the lhs is a NK_DEREF (`*(addr) = val`), emit IR_STORE
    // so the bootstrap codegen can emit a byte store to memory. For simple
    // assignments (`x = val`), the rhs vreg is the result (no IR emitted —
    // the binding is handled by NK_LET's symtab insert).
    if kind == 7 {
        rhs_vreg = irb_lower_expr(b, ast, c2);
        lhs_off: u32 = 8 + c1 * 40;
        lhs_kind: u32 = load_u32(ast, lhs_off);
        if lhs_kind == 6 {  // NK_DEREF: *(addr) = val → IR_STORE
            // NK_DEREF layout: c1 = operand node idx (the address expression).
            deref_operand: u32 = load_u32(ast, lhs_off + 4);
            addr_vreg: u32 = irb_lower_expr(b, ast, deref_operand);
            // IR_STORE: dst = value vreg, lhs = addr vreg, rhs = byte offset
            // (0 — the current IR builder folds any `ptr + off` into a runtime
            // ADD that produces the address vreg, so the static offset is 0).
            irb_emit(b, IR_STORE, rhs_vreg, addr_vreg, 0, 0, 0);
        }
        // For simple assignment, rhs is the result
        return rhs_vreg;
    }
    
    // NK_CALL (5): c1=callee_name_hash, c3=arg_count, val (lower 32)=arg0_node_idx
    // Wave 48: lower arg0 (the only arg we support in the bootstrap) and
    // stash its vreg in the IR_CALL's `imm` field (lower 32 bits). The
    // codegen reads this when emitting the print_int syscall sequence.
    //
    // Wave P6.3: intercept allocate / __vuma_alloc / free / __vuma_free
    // before the generic IR_CALL emission. The codegen skips IR_CALL for
    // any callee whose hash != print_int_hash, so without this intercept,
    // heap-allocating programs would silently no-op. We lower:
    //   allocate(n) / __vuma_alloc(n) → IR_ALLOC (dst=fresh vreg, imm=n_vreg)
    //   free(addr) / __vuma_free(addr, size) → IR_SYSCALL(215, [addr, ...])
    // The 4 callee-name hashes are stashed in the builder state by the
    // driver via irb_set_alloc_hashes (0 = not set, no interception).
    if kind == 5 {
        arg0_vreg: u32 = 0;
        if c3 >= 1 {
            arg0_node: u32 = val & 0xFFFFFFFF;
            arg0_vreg = irb_lower_expr(b, ast, arg0_node);
        }
        alloc_h: u32 = load_u32(b, 28);
        free_h: u32 = load_u32(b, 32);
        valloc_h: u32 = load_u32(b, 36);
        vfree_h: u32 = load_u32(b, 40);
        // allocate(size) → IR_SYSCALL(222, mmap) with 4 args.
        // mmap(NULL, size, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0)
        // The bootstrap codegen loads 4 args into RDI/RSI/RDX/R10. On x86_64,
        // MAP_ANONYMOUS ignores fd (R8) and offset (R9), so 4 args suffice.
        if c1 == alloc_h {
            if alloc_h != 0 {
                addr_vreg: u32 = irb_alloc_vreg(b);
                irb_emit(b, IR_MOV, addr_vreg, 0, 0, 0, 0);
                prot_vreg: u32 = irb_alloc_vreg(b);
                irb_emit(b, IR_MOV, prot_vreg, 0, 0, 3, 0);
                flags_vreg: u32 = irb_alloc_vreg(b);
                irb_emit(b, IR_MOV, flags_vreg, 0, 0, 0x22, 0);
                dst = irb_alloc_vreg(b);
                packed_imm: u64 = (addr_vreg as u64) | ((arg0_vreg as u64) << 32);
                packed_aux: u64 = (prot_vreg as u64) | ((flags_vreg as u64) << 32);
                irb_emit(b, IR_SYSCALL, dst, 222, 4, packed_imm, packed_aux);
                return dst;
            }
        }
        // __vuma_alloc(size) → same as allocate.
        if c1 == valloc_h {
            if valloc_h != 0 {
                addr_vreg = irb_alloc_vreg(b);
                irb_emit(b, IR_MOV, addr_vreg, 0, 0, 0, 0);
                prot_vreg = irb_alloc_vreg(b);
                irb_emit(b, IR_MOV, prot_vreg, 0, 0, 3, 0);
                flags_vreg = irb_alloc_vreg(b);
                irb_emit(b, IR_MOV, flags_vreg, 0, 0, 0x22, 0);
                dst = irb_alloc_vreg(b);
                packed_imm = (addr_vreg as u64) | ((arg0_vreg as u64) << 32);
                packed_aux = (prot_vreg as u64) | ((flags_vreg as u64) << 32);
                irb_emit(b, IR_SYSCALL, dst, 222, 4, packed_imm, packed_aux);
                return dst;
            }
        }
        // free(addr) → IR_SYSCALL(215, munmap).
        if c1 == free_h {
            if free_h != 0 {
                irb_emit(b, IR_SYSCALL, 0, 215, 1, arg0_vreg, 0);
                return 0;
            }
        }
        // __vuma_free(addr, size) → same as free.
        if c1 == vfree_h {
            if vfree_h != 0 {
                irb_emit(b, IR_SYSCALL, 0, 215, 1, arg0_vreg, 0);
                return 0;
            }
        }
        dst = irb_alloc_vreg(b);
        // IR_CALL: dst=result vreg, lhs=callee_hash, rhs=arg_count,
        //          imm (lower 32)=arg0_vreg.
        irb_emit(b, IR_CALL, dst, c1, c3, arg0_vreg, 0);
        return dst;
    }
    
    // NK_SYSCALL (8): c1=syscall_nr, c2=arg2_node (for 3 args),
    // c3=arg_count, val.lo=arg0_node, val.hi=arg1_node.
    // Supports up to 3 args. 4-arg syscalls need the aux field which
    // triggers a Rust vumac x86_64 codegen bug when compiling the bootstrap.
    if kind == 8 {
        arg0_vreg = 0;
        arg1_vreg: u32 = 0;
        arg2_vreg: u32 = 0;
        if c3 >= 1 {
            sc_arg0_node: u32 = val & 0xFFFFFFFF;
            arg0_vreg = irb_lower_expr(b, ast, sc_arg0_node);
        }
        if c3 >= 2 {
            sc_arg1_node: u32 = (val >> 32) & 0xFFFFFFFF;
            arg1_vreg = irb_lower_expr(b, ast, sc_arg1_node);
        }
        if c3 >= 3 {
            arg2_vreg = irb_lower_expr(b, ast, c2);
        }
        dst = irb_alloc_vreg(b);
        packed_imm: u64 = (arg0_vreg as u64) | ((arg1_vreg as u64) << 32);
        packed_aux: u64 = arg2_vreg as u64;
        irb_emit(b, IR_SYSCALL, dst, c1, c3, packed_imm, packed_aux);
        return dst;
    }
    
    // Default: return vreg 0
    return 0;
}

// Lower a statement AST node.
fn irb_lower_stmt(b: Address, ast: u64, node_idx: u32) {
    node_offset: u32 = 8 + node_idx * 40;
    kind: u32 = load_u32(ast, node_offset);
    c1: u32 = load_u32(ast, node_offset + 4);
    c2: u32 = load_u32(ast, node_offset + 8);
    c3: u32 = load_u32(ast, node_offset + 12);
    val: u64 = load_u64(ast, node_offset + 16);
    aux: u64 = load_u64(ast, node_offset + 24);
    
    // NK_RETURN (10): RET expr
    if kind == 10 {
        if c1 == 0 {
            irb_emit(b, IR_RET, 0, 0, 0, 0, 0);
        } else {
            val_vreg: u32 = irb_lower_expr(b, ast, c1);
            irb_emit(b, IR_RET, val_vreg, 0, 0, 0, 0);
        }
        return;
    }
    
    // NK_LET (11): c1=init expr node, val (lower 32)=var name hash.
    // Wave 48: lower the init expression and insert (var_hash → vreg) into
    // the symbol table so subsequent NK_IDENT lookups resolve to the same vreg.
    if kind == 11 {
        init_vreg: u32 = irb_lower_expr(b, ast, c1);
        var_hash: u32 = val & 0xFFFFFFFF;
        irb_sym_insert(b, var_hash, init_vreg);
        return;
    }
    
    // NK_IF (12): c1=cond, c2=then_block, c3=else_block
    if kind == 12 {
        cond_vreg: u32 = irb_lower_expr(b, ast, c1);
        else_label: u32 = irb_alloc_label(b);
        end_label: u32 = irb_alloc_label(b);
        irb_emit(b, IR_COND_BRANCH, cond_vreg, 0, else_label, 0, 0);
        // Then block
        irb_lower_block(b, ast, c2);
        irb_emit(b, IR_BRANCH, end_label, 0, 0, 0, 0);
        // Else block
        irb_emit(b, IR_NOP, else_label, 0, 0, 0, 0);  // label marker
        if c3 != 0 { irb_lower_block(b, ast, c3); }
        irb_emit(b, IR_NOP, end_label, 0, 0, 0, 0);  // label marker
        return;
    }
    
    // NK_WHILE (13): c1=cond, c2=body
    if kind == 13 {
        start_label: u32 = irb_alloc_label(b);
        end_label = irb_alloc_label(b);
        irb_emit(b, IR_NOP, start_label, 0, 0, 0, 0);  // label marker
        cond_vreg = irb_lower_expr(b, ast, c1);
        irb_emit(b, IR_COND_BRANCH, cond_vreg, 0, end_label, 0, 0);
        irb_lower_block(b, ast, c2);
        irb_emit(b, IR_BRANCH, start_label, 0, 0, 0, 0);
        irb_emit(b, IR_NOP, end_label, 0, 0, 0, 0);  // label marker
        return;
    }
    
    // Expression statement
    irb_lower_expr(b, ast, node_idx);
}

// Lower a block.
// NK_BLOCK layout (Wave 48):
//   c1  = stmt_start (unused, kept for debugging)
//   c2  = stmt_count
//   val = side buffer ptr (heap array of u32 stmt node indices)
//
// Wave 48 fix: the old code iterated `stmt_start + i` assuming stmts were
// at consecutive arena indices. This was wrong (child expr nodes are
// interleaved), so it visited child nodes as statements and missed real
// stmts. The parser now records each stmt's actual node index in a side
// buffer; we read that buffer here.
fn irb_lower_block(b: Address, ast: u64, node_idx: u32) {
    node_offset: u32 = 8 + node_idx * 40;
    stmt_count: u32 = load_u32(ast, node_offset + 8);   // c2 = stmt_count
    stmt_indices: u64 = load_u64(ast, node_offset + 16); // val = side buffer ptr
    i: u32 = 0;
    while i < stmt_count {
        idx: u32 = load_u32(stmt_indices, i * 4);
        irb_lower_stmt(b, ast, idx);
        i = i + 1;
    }
}

// Lower a function definition (NK_FN_DEF: c1=body, c3=param_count)
fn irb_lower_fn(b: Address, ast: u64, node_idx: u32) {
    node_offset: u32 = 8 + node_idx * 40;
    body: u32 = load_u32(ast, node_offset + 4);
    param_count: u32 = load_u32(ast, node_offset + 12);
    
    // Reset symbol table for this function
    store_u32(b, 24, 0);
    
    // Allocate vregs for parameters
    i: u32 = 0;
    while i < param_count {
        irb_alloc_vreg(b);
        i = i + 1;
    }
    
    // Lower body
    irb_lower_block(b, ast, body);
    
    // Ensure function ends with RET
    ir_buf: u64 = load_u64(b, 0);
    count: u32 = load_u32(ir_buf, 0);
    if count > 0 {
        last_offset: u32 = 8 + (count - 1) * IR_SIZE;
        last_op: u32 = load_u32(ir_buf, last_offset);
        if last_op != IR_RET {
            irb_emit(b, IR_RET, 0, 0, 0, 0, 0);
        }
    }
}

fn irb_free(b: Address) {
    symtab: u64 = load_u64(b, 16);
    __vuma_free(symtab, 4096);
    __vuma_free(b, 48);  // Wave P6.3: builder state grew 32 → 48 bytes
}

// ============================================================================
// Wave 48 — pipeline entry points (SCG / IR build / BD / IVE)
// ============================================================================
// The bootstrap pipeline (full_lexer.vuma::main) calls these in order:
//   1. scg_construct(ast)        — REAL: walks the AST arena and builds a
//                                  minimal linear-chain SCG (Scheduled
//                                  Computation Graph): one FunctionEntry
//                                  node per NK_FN_DEF, then one node per
//                                  statement in the function body (classified
//                                  by AST kind: Compute/Access/Control/
//                                  Statement), connected by ControlFlow edges
//                                  in program order. Returns the total number
//                                  of SCG nodes created.
//   2. irb_build_main(ast, main_hash, ir_buf)
//                                — REAL: walks the AST arena, finds the
//                                  function whose name hashes to `main_hash`,
//                                  lowers its body to IR opcodes in `ir_buf`.
//                                  Returns 1 if main was found, 0 otherwise.
//                                  (Note: this still lowers AST→IR directly
//                                  rather than consuming the SCG from step 1;
//                                  the SCG is built for diagnostic purposes
//                                  and to make the pipeline shape match the
//                                  production compiler. See Wave 48 task
//                                  [BOOT] Implement IR construction from SCG
//                                  for the documented caveat.)
//   3. bd_infer(ir_buf)          — REAL: forward RepD propagation pass.
//                                  Walks the IR buffer forward, allocates a
//                                  per-vreg RepD tag array, and assigns each
//                                  dst vreg a RepD based on the opcode
//                                  (MOV→I64, ALU→propagate, CMP→BOOL, LOAD→
//                                  I64, ALLOC→PTR, CALL→I64). Returns the
//                                  number of vregs assigned a non-UNKNOWN
//                                  RepD.
//   4. ive_verify(ir_buf)        — REAL: forward-liveness + backward-use
//                                  check + dead-let detection. Pass 1
//                                  (forward) marks every defined vreg.
//                                  Pass 2 (backward) marks every used vreg.
//                                  Liveness check: every used vreg (except
//                                  vreg 0) must be defined. Cleanup pass
//                                  counts dead defs (dst vreg never used).
//                                  Returns 1 if liveness passes, 0 otherwise.
//
// The Wave 48 contract: a coherent, documented pipeline where every stage's
// signature is final and every stage does REAL work (not return-a-constant
// stubs). Subsequent waves can deepen each pass without touching the driver.

// ── SCG (Scheduled Computation Graph) construction ──
// Wave 48: minimal but REAL SCG builder. Walks the AST arena and emits a
// linear-chain SCG: one FunctionEntry node per NK_FN_DEF, then one node per
// statement in the function body (classified by AST kind), connected by
// ControlFlow edges in program order.
//
// SCG buffer layout (single allocation, ~12 KB):
//   [0..3]    node_count: u32
//   [4..7]    edge_count: u32
//   [8..]     nodes (SCG_NODE_SIZE=16 bytes each):
//               [kind: u32][ast_idx: u32][next: u32][prev: u32]
//   After nodes (offset SCG_EDGES_OFFSET):
//             edges (SCG_EDGE_SIZE=8 bytes each):
//               [src: u32][dst: u32]
//
// The `next`/`prev` fields on each node form a doubly-linked list mirroring
// the ControlFlow edges for O(1) forward/backward traversal.

const SCG_NK_FUNCTION_ENTRY: u32 = 1;
const SCG_NK_COMPUTE: u32 = 2;
const SCG_NK_ACCESS: u32 = 3;
const SCG_NK_CONTROL: u32 = 4;
const SCG_NK_STATEMENT: u32 = 5;
const SCG_EK_CONTROL_FLOW: u32 = 1;
const SCG_NODE_CAP: u32 = 512;
const SCG_EDGE_CAP: u32 = 512;
const SCG_NODE_SIZE: u32 = 16;
const SCG_EDGE_SIZE: u32 = 8;
const SCG_HEADER_SIZE: u32 = 8;
const SCG_EDGES_OFFSET: u32 = 8 + 512 * 16;   // = 8200

fn scg_new() -> Address {
    total: i64 = 8 + 512 * 16 + 512 * 8;   // = 12360 bytes
    buf: Address = __vuma_alloc(total);
    store_u32(buf, 0, 0);   // node_count
    store_u32(buf, 4, 0);   // edge_count
    return buf;
}

// Append a node to the SCG; returns the new node's index, or 0xFFFFFFFF if
// the node capacity has been exceeded.
fn scg_add_node(scg: Address, kind: u32, ast_idx: u32) -> u32 {
    n: u32 = load_u32(scg, 0);
    if n >= SCG_NODE_CAP { return 0xFFFFFFFF; }
    off: u32 = SCG_HEADER_SIZE + n * SCG_NODE_SIZE;
    store_u32(scg, off, kind);
    store_u32(scg, off + 4, ast_idx);
    store_u32(scg, off + 8, 0);   // next
    store_u32(scg, off + 12, 0);  // prev
    store_u32(scg, 0, n + 1);
    return n;
}

// Connect src → dst with an edge. For ControlFlow edges, also updates the
// `next`/`prev` linked-list pointers on the nodes for O(1) traversal.
fn scg_connect(scg: Address, src: u32, dst: u32, edge_kind: u32) {
    e: u32 = load_u32(scg, 4);
    if e >= SCG_EDGE_CAP { return; }
    off: u32 = SCG_EDGES_OFFSET + e * SCG_EDGE_SIZE;
    store_u32(scg, off, src);
    store_u32(scg, off + 4, dst);
    if edge_kind == SCG_EK_CONTROL_FLOW {
        src_off: u32 = SCG_HEADER_SIZE + src * SCG_NODE_SIZE;
        store_u32(scg, src_off + 8, dst);   // src.next = dst
        dst_off: u32 = SCG_HEADER_SIZE + dst * SCG_NODE_SIZE;
        store_u32(scg, dst_off + 12, src);  // dst.prev = src
    }
    store_u32(scg, 4, e + 1);
}

// Map an AST node kind to an SCG node kind.
fn scg_node_kind_for(ast_kind: u32) -> u32 {
    if ast_kind == 20 { return SCG_NK_FUNCTION_ENTRY; }  // NK_FN_DEF
    if ast_kind == 10 { return SCG_NK_CONTROL; }         // NK_RETURN
    if ast_kind == 11 { return SCG_NK_STATEMENT; }       // NK_LET
    if ast_kind == 12 { return SCG_NK_CONTROL; }         // NK_IF
    if ast_kind == 13 { return SCG_NK_CONTROL; }         // NK_WHILE
    if ast_kind == 15 { return SCG_NK_CONTROL; }         // NK_BLOCK
    if ast_kind == 1  { return SCG_NK_COMPUTE; }         // NK_INT
    if ast_kind == 2  { return SCG_NK_ACCESS; }          // NK_IDENT
    if ast_kind == 3  { return SCG_NK_COMPUTE; }         // NK_BINOP
    if ast_kind == 5  { return SCG_NK_COMPUTE; }         // NK_CALL
    if ast_kind == 6  { return SCG_NK_ACCESS; }          // NK_DEREF
    if ast_kind == 7  { return SCG_NK_ACCESS; }          // NK_ASSIGN
    return SCG_NK_STATEMENT;
}

// Walk an NK_BLOCK's statement list (side-buffer of u32 AST indices, per
// the Wave 48 fix in irb_lower_block) and append one SCG node + ControlFlow
// edge per statement, in program order. Returns the index of the last node
// appended (or `entry_node` if the block was empty).
fn scg_walk_block(scg: Address, ast: u64, block_idx: u32, entry_node: u32) -> u32 {
    node_offset: u32 = 8 + block_idx * 40;
    stmt_count: u32 = load_u32(ast, node_offset + 8);
    stmt_indices: u64 = load_u64(ast, node_offset + 16);
    prev: u32 = entry_node;
    i: u32 = 0;
    while i < stmt_count {
        idx: u32 = load_u32(stmt_indices, i * 4);
        s_off: u32 = 8 + idx * 40;
        s_kind: u32 = load_u32(ast, s_off);
        nk: u32 = scg_node_kind_for(s_kind);
        n: u32 = scg_add_node(scg, nk, idx);
        if n != 0xFFFFFFFF {
            scg_connect(scg, prev, n, SCG_EK_CONTROL_FLOW);
            prev = n;
        }
        i = i + 1;
    }
    return prev;
}

// scg_construct(ast): REAL Wave 48 implementation. Builds a minimal
// linear-chain SCG from the AST arena. For each NK_FN_DEF at top level, a
// FunctionEntry node is created and the function body (NK_BLOCK) is walked
// to produce one node per statement, classified by AST kind, connected by
// ControlFlow edges in program order. Returns the total number of SCG
// nodes created (0 if the AST is empty or has no function definitions).
//
// The SCG buffer is heap-allocated and intentionally NOT freed — the
// bootstrap exits after pipeline completion and the OS reclaims the heap.
// A future wave can store the SCG handle in the AST arena header and have
// irb_build_main consume + free it.
fn scg_construct(ast: Address) -> u32 {
    scg: Address = scg_new();
    count: u32 = load_u32(ast, 0);
    i: u32 = 0;
    while i < count {
        node_off: u32 = 8 + i * 40;
        kind: u32 = load_u32(ast, node_off);
        if kind == 20 {  // NK_FN_DEF
            body: u32 = load_u32(ast, node_off + 4);
            entry: u32 = scg_add_node(scg, SCG_NK_FUNCTION_ENTRY, i);
            if entry != 0xFFFFFFFF {
                scg_walk_block(scg, ast, body, entry);
            }
        }
        i = i + 1;
    }
    total: u32 = load_u32(scg, 0);
    return total;
}

// irb_build_main: REAL entry point. Finds `main` in the AST by name hash
// and lowers its body to IR. The caller pre-allocates `ir_buf` via ir_new()
// and passes the FNV-1a hash of "main" (computed by name_hash in
// full_parser.vuma, or by an equivalent helper in the driver).
//
// Wave P6.3: the driver also passes the FNV-1a hashes of "allocate",
// "free", "__vuma_alloc", and "__vuma_free" so the NK_CALL handler can
// intercept those callees and lower them to IR_ALLOC / IR_SYSCALL(215)
// instead of the generic IR_CALL (which the codegen skips for non-print_int
// callees). The hashes are stashed in the builder state via
// irb_set_alloc_hashes before lowering begins.
//
// Returns 1 if `main` was found and lowered, 0 otherwise.
fn irb_build_main(ast: Address, main_hash: u32, ir_buf: Address, alloc_h: u32, free_h: u32, valloc_h: u32, vfree_h: u32) -> u32 {
    b: Address = irb_new(ir_buf);
    irb_set_alloc_hashes(b, alloc_h, free_h, valloc_h, vfree_h);
    count: u32 = load_u32(ast, 0);
    i: u32 = 0;
    found: u32 = 0;
    while i < count {
        node_off: u32 = 8 + i * 40;
        kind: u32 = load_u32(ast, node_off);
        if kind == 20 {  // NK_FN_DEF
            fn_hash: u32 = load_u64(ast, node_off + 16) & 0xFFFFFFFF;
            if fn_hash == main_hash {
                irb_lower_fn(b, ast, i);
                found = 1;
            }
        }
        i = i + 1;
    }
    irb_free(b);
    return found;
}

// ── BD (Bounded-Domain) inference — Phase 1 ──
// Wave 48: minimal but REAL forward-propagation pass. Walks the IR buffer
// forward, allocates a per-vreg RepD tag array, and assigns each dst vreg a
// RepD based on the opcode and (where relevant) the operands' already-inferred
// RepDs. Literal MOVs seed I64; ALU ops propagate the operand RepD (with
// conservative promotion to I64 when operands disagree or are unknown); CMP
// yields BOOL; LOAD yields I64; ALLOC yields PTR; CALL yields I64.
//
// Returns the number of vregs assigned a non-UNKNOWN RepD (0 if the IR is
// empty or no dst vregs could be classified).

const REPD_UNKNOWN: u32 = 0;
const REPD_I64: u32 = 1;
const REPD_BOOL: u32 = 2;
const REPD_PTR: u32 = 3;
const REPD_I32: u32 = 4;
const BD_VREG_CAP: u32 = 4096;

// Classify the dst RepD for a given IR opcode given the (already-inferred)
// RepDs of the lhs and rhs operands. Returns REPD_UNKNOWN if the opcode has
// no dst vreg (NOP/STORE/RET/BRANCH/COND_BRANCH).
fn bd_classify(op: u32, lhs_repd: u32, rhs_repd: u32) -> u32 {
    if op == 16 { return REPD_I64; }   // IR_MOV: literal i64.
    if op >= 1 && op <= 9 {            // ADD/SUB/MUL/DIV/AND/OR/XOR/SHL/SHR.
        if lhs_repd == REPD_I32 && rhs_repd == REPD_I32 { return REPD_I32; }
        return REPD_I64;               // promote conservatively.
    }
    if op == 10 { return REPD_BOOL; }  // IR_CMP.
    if op == 11 { return REPD_I64; }   // IR_LOAD.
    if op == 15 { return REPD_PTR; }   // IR_ALLOC.
    if op == 13 { return REPD_I64; }   // IR_CALL (callee return type unknown).
    return REPD_UNKNOWN;
}

// bd_infer(ir_buf): REAL Wave 48 implementation. Forward RepD propagation.
fn bd_infer(ir_buf: Address) -> u32 {
    count: u32 = load_u32(ir_buf, 0);
    repd: Address = __vuma_alloc(BD_VREG_CAP);
    // Zero-init (REPD_UNKNOWN = 0).
    i: u32 = 0;
    while i < BD_VREG_CAP {
        *(repd + i) = 0;
        i = i + 1;
    }
    assigned: u32 = 0;
    i = 0;
    while i < count {
        op_off: u32 = 8 + i * IR_SIZE;
        op: u32 = load_u32(ir_buf, op_off);
        dst: u32 = load_u32(ir_buf, op_off + 4);
        lhs: u32 = load_u32(ir_buf, op_off + 8);
        rhs: u32 = load_u32(ir_buf, op_off + 12);
        // Read operand RepDs (REPD_UNKNOWN if out of range or uninitialized).
        lhs_r: u32 = REPD_UNKNOWN;
        rhs_r: u32 = REPD_UNKNOWN;
        if lhs > 0 && lhs < BD_VREG_CAP { lhs_r = *(repd + lhs); }
        if rhs > 0 && rhs < BD_VREG_CAP { rhs_r = *(repd + rhs); }
        r: u32 = bd_classify(op, lhs_r, rhs_r);
        if r != REPD_UNKNOWN && dst > 0 && dst < BD_VREG_CAP {
            prev: u32 = *(repd + dst);
            if prev == REPD_UNKNOWN { assigned = assigned + 1; }
            *(repd + dst) = r;
        }
        i = i + 1;
    }
    __vuma_free(repd, BD_VREG_CAP);
    return assigned;
}

// ── IVE (Integer Verification Engine) — liveness + cleanup ──
// Wave 48: minimal but REAL IVE pass. Performs two checks:
//
//   (a) Liveness — every vreg used by some instruction must be defined by
//       a prior def-instruction (MOV/ALU/CMP/LOAD/CALL/ALLOC). A vreg that
//       is used but never defined is a use-before-def error → return 0.
//       (vreg 0 is reserved for "no vreg" and is exempt.)
//
//   (b) Cleanup — count def-instructions whose dst vreg is never used by
//       any subsequent instruction. These are dead "lets" that a real IVE
//       pass would rewrite out of the IR buffer; the bootstrap counts them
//       for diagnostic purposes but does not mutate the IR (the codegen
//       silently skips unused defs).
//
// Returns 1 if the liveness check passes, 0 otherwise.

const IVE_VREG_CAP: u32 = 4096;
const IVE_BITMAP_BYTES: u32 = 512;       // 4096 / 8
const IVE_BITMAP_U64S: u32 = 64;         // 512 / 8

// Set bit `vreg` in the bitmap.
fn ive_bm_set(bm: Address, vreg: u32) {
    if vreg == 0 || vreg >= IVE_VREG_CAP { return; }
    word: u32 = vreg >> 6;       // vreg / 64
    bit: u32 = vreg & 63;        // vreg % 64
    cur: u64 = load_u64(bm, word * 8);
    cur = cur | (1 << bit);
    store_u64(bm, word * 8, cur);
}

// Get bit `vreg` from the bitmap. Returns 1 or 0.
fn ive_bm_get(bm: Address, vreg: u32) -> u32 {
    if vreg == 0 || vreg >= IVE_VREG_CAP { return 0; }
    word: u32 = vreg >> 6;
    bit: u32 = vreg & 63;
    cur: u64 = load_u64(bm, word * 8);
    if (cur >> bit) & 1 == 1 { return 1; }
    return 0;
}

// Zero out the bitmap.
fn ive_bm_clear(bm: Address) {
    i: u32 = 0;
    while i < IVE_BITMAP_U64S {
        store_u64(bm, i * 8, 0);
        i = i + 1;
    }
}

// True (1) if the opcode writes a dst vreg (i.e., is a def-instruction).
fn ive_op_is_def(op: u32) -> u32 {
    if op == 1  { return 1; }   // IR_ADD
    if op == 2  { return 1; }   // IR_SUB
    if op == 3  { return 1; }   // IR_MUL
    if op == 4  { return 1; }   // IR_DIV
    if op == 5  { return 1; }   // IR_AND
    if op == 6  { return 1; }   // IR_OR
    if op == 7  { return 1; }   // IR_XOR
    if op == 8  { return 1; }   // IR_SHL
    if op == 9  { return 1; }   // IR_SHR
    if op == 10 { return 1; }   // IR_CMP
    if op == 11 { return 1; }   // IR_LOAD
    if op == 13 { return 1; }   // IR_CALL
    if op == 15 { return 1; }   // IR_ALLOC
    if op == 16 { return 1; }   // IR_MOV
    return 0;
}

// ive_verify(ir_buf): REAL Wave 48 implementation. Liveness + cleanup pass.
fn ive_verify(ir_buf: Address) -> u32 {
    count: u32 = load_u32(ir_buf, 0);
    // defined: bitmap of vregs defined by some instruction (forward pass).
    // used:     bitmap of vregs used by some instruction (backward pass).
    defined: Address = __vuma_alloc(IVE_BITMAP_BYTES);
    used: Address = __vuma_alloc(IVE_BITMAP_BYTES);
    ive_bm_clear(defined);
    ive_bm_clear(used);

    // Pass 1 (forward): mark every defined vreg.
    i: u32 = 0;
    while i < count {
        op_off: u32 = 8 + i * IR_SIZE;
        op: u32 = load_u32(ir_buf, op_off);
        dst: u32 = load_u32(ir_buf, op_off + 4);
        if ive_op_is_def(op) == 1 { ive_bm_set(defined, dst); }
        i = i + 1;
    }

    // Pass 2 (backward): mark every used vreg.
    if count > 0 {
        i = count;
        while i > 0 {
            i = i - 1;
            op_off: u32 = 8 + i * IR_SIZE;
            op: u32 = load_u32(ir_buf, op_off);
            dst: u32 = load_u32(ir_buf, op_off + 4);
            lhs: u32 = load_u32(ir_buf, op_off + 8);
            rhs: u32 = load_u32(ir_buf, op_off + 12);
            imm: u64 = load_u64(ir_buf, op_off + 16);
            imm_lo: u32 = imm & 0xFFFFFFFF;
            // ALU/CMP (1..10): lhs, rhs are uses.
            if op >= 1 && op <= 10 {
                ive_bm_set(used, lhs);
                ive_bm_set(used, rhs);
            }
            if op == 11 { ive_bm_set(used, lhs); }               // LOAD: addr.
            if op == 12 { ive_bm_set(used, dst); ive_bm_set(used, lhs); }  // STORE: val, addr.
            if op == 13 { ive_bm_set(used, imm_lo); }            // CALL: arg0.
            if op == 14 { ive_bm_set(used, dst); }               // RET: returned vreg.
            if op == 18 { ive_bm_set(used, dst); }               // COND_BRANCH: cond.
        }
    }

    // Liveness check: every used vreg (except vreg 0) must be defined.
    liveness_ok: u32 = 1;
    vreg: u32 = 1;
    while vreg < IVE_VREG_CAP {
        if ive_bm_get(used, vreg) == 1 && ive_bm_get(defined, vreg) == 0 {
            liveness_ok = 0;
        }
        vreg = vreg + 1;
    }

    // Cleanup pass (forward): count dead defs (dst vreg never used).
    dead_count: u32 = 0;
    i = 0;
    while i < count {
        op_off: u32 = 8 + i * IR_SIZE;
        op: u32 = load_u32(ir_buf, op_off);
        dst: u32 = load_u32(ir_buf, op_off + 4);
        if ive_op_is_def(op) == 1 && dst != 0 && ive_bm_get(used, dst) == 0 {
            dead_count = dead_count + 1;
        }
        i = i + 1;
    }

    __vuma_free(defined, IVE_BITMAP_BYTES);
    __vuma_free(used, IVE_BITMAP_BYTES);
    // dead_count is computed but not used to mutate the IR — a real IVE pass
    // would rewrite the buffer; the bootstrap leaves it to the codegen to
    // silently skip dead instructions.
    return liveness_ok;
}
