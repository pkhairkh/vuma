// womb/lang/lexer.vuma — VUMA lexer using heap-allocated token buffer
// Tokenizes VUMA source code into a token stream stored on the heap.
//
// Token layout: [type: u32][start: u32][len: u32][value: u64] = 24 bytes
// See tokens.vuma for token type constants.

extern "C" {
    fn __vuma_alloc(size: i64) -> Address;
    fn __vuma_free(addr: Address, size: i64);
}

// ── LE helpers ──
fn store_u64(ptr: Address, offset: u32, val: u64) {
    *(ptr + offset) = val & 255; *(ptr + offset + 1) = (val >> 8) & 255;
    *(ptr + offset + 2) = (val >> 16) & 255; *(ptr + offset + 3) = (val >> 24) & 255;
    *(ptr + offset + 4) = (val >> 32) & 255; *(ptr + offset + 5) = (val >> 40) & 255;
    *(ptr + offset + 6) = (val >> 48) & 255; *(ptr + offset + 7) = (val >> 56) & 255;
}
fn load_u64(ptr: Address, offset: u32) -> u64 {
    b0: u64 = *(ptr + offset); b1: u64 = *(ptr + offset + 1);
    b2: u64 = *(ptr + offset + 2); b3: u64 = *(ptr + offset + 3);
    b4: u64 = *(ptr + offset + 4); b5: u64 = *(ptr + offset + 5);
    b6: u64 = *(ptr + offset + 6); b7: u64 = *(ptr + offset + 7);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56);
}
fn store_u32(ptr: Address, offset: u32, val: u32) {
    *(ptr + offset) = val & 255; *(ptr + offset + 1) = (val >> 8) & 255;
    *(ptr + offset + 2) = (val >> 16) & 255; *(ptr + offset + 3) = (val >> 24) & 255;
}
fn load_u32(ptr: Address, offset: u32) -> u32 {
    b0: u32 = *(ptr + offset); b1: u32 = *(ptr + offset + 1);
    b2: u32 = *(ptr + offset + 2); b3: u32 = *(ptr + offset + 3);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

// ── Character classifiers ──
fn is_alpha(c: u32) -> u32 {
    if c >= 97 { if c <= 122 { return 1; } }
    if c >= 65 { if c <= 90 { return 1; } }
    if c == 95 { return 1; }
    return 0;
}
fn is_digit(c: u32) -> u32 {
    if c >= 48 { if c <= 57 { return 1; } }
    return 0;
}
fn is_alnum(c: u32) -> u32 {
    if is_alpha(c) == 1 { return 1; }
    if is_digit(c) == 1 { return 1; }
    return 0;
}
fn is_space(c: u32) -> u32 {
    if c == 32 { return 1; }
    if c == 9 { return 1; }
    if c == 10 { return 1; }
    if c == 13 { return 1; }
    return 0;
}

// ── Store token ──
fn store_token(tokens: Address, idx: u32, ttype: u32, start: u32, len: u32, val: u64) {
    offset: u32 = idx * 24;
    store_u32(tokens, offset, ttype);
    store_u32(tokens, offset + 4, start);
    store_u32(tokens, offset + 8, len);
    store_u64(tokens, offset + 12, val);
}

fn token_type(tokens: Address, idx: u32) -> u32 {
    return load_u32(tokens, idx * 24);
}
fn token_start(tokens: Address, idx: u32) -> u32 {
    return load_u32(tokens, idx * 24 + 4);
}
fn token_len(tokens: Address, idx: u32) -> u32 {
    return load_u32(tokens, idx * 24 + 8);
}
fn token_val(tokens: Address, idx: u32) -> u64 {
    return load_u64(tokens, idx * 24 + 12);
}

// ── Lex entire source ──
// Returns number of tokens. tokens buffer must be pre-allocated.
fn lex(src: Address, src_len: u32, tokens: Address, max_tokens: u32) -> u32 {
    pos: u32 = 0;
    count: u32 = 0;
    
    while pos < src_len {
        if count >= max_tokens { return count; }
        c: u32 = *(src + pos);
        
        // Skip whitespace
        if is_space(c) == 1 {
            pos = pos + 1;
            continue;
        }
        
        // Skip line comments (//)
        if c == 47 {
            if pos + 1 < src_len {
                next: u32 = *(src + pos + 1);
                if next == 47 {
                    while pos < src_len {
                        if *(src + pos) == 10 { break; }
                        pos = pos + 1;
                    }
                    continue;
                }
            }
        }
        
        // Identifier or keyword
        if is_alpha(c) == 1 {
            start: u32 = pos;
            while pos < src_len {
                c = *(src + pos);
                if is_alnum(c) == 0 { break; }
                pos = pos + 1;
            }
            len: u32 = pos - start;
            // Check keywords: "fn"=2 chars, "if"=2, "else"=4, "while"=5, "return"=6, "let"=3
            ttype: u32 = 1; // default: Ident
            if len == 2 {
                first: u32 = *(src + start);
                if first == 102 {  // 'f'
                    second: u32 = *(src + start + 1);
                    if second == 110 { ttype = 10; }  // "fn"
                }
                if first == 105 {  // 'i'
                    second: u32 = *(src + start + 1);
                    if second == 102 { ttype = 12; }  // "if"
                }
            }
            if len == 3 {
                first: u32 = *(src + start);
                if first == 108 {  // 'l'
                    s2: u32 = *(src + start + 1);
                    s3: u32 = *(src + start + 2);
                    if s2 == 101 { if s3 == 116 { ttype = 11; } }  // "let"
                }
            }
            if len == 4 {
                first: u32 = *(src + start);
                if first == 101 {  // 'e' → "else"
                    s2: u32 = *(src + start + 1);
                    s3: u32 = *(src + start + 2);
                    s4: u32 = *(src + start + 3);
                    if s2 == 108 { if s3 == 115 { if s4 == 101 { ttype = 13; } } }
                }
            }
            if len == 5 {
                first: u32 = *(src + start);
                if first == 119 {  // 'w' → "while"
                    s2: u32 = *(src + start + 1);
                    s3: u32 = *(src + start + 2);
                    s4: u32 = *(src + start + 3);
                    s5: u32 = *(src + start + 4);
                    if s2 == 104 { if s3 == 105 { if s4 == 108 { if s5 == 101 { ttype = 14; } } } }
                }
            }
            if len == 6 {
                first: u32 = *(src + start);
                if first == 114 {  // 'r' → "return"
                    s2: u32 = *(src + start + 1);
                    s3: u32 = *(src + start + 2);
                    s4: u32 = *(src + start + 3);
                    s5: u32 = *(src + start + 4);
                    s6: u32 = *(src + start + 5);
                    if s2 == 101 { if s3 == 116 { if s4 == 117 { if s5 == 114 { if s6 == 110 { ttype = 16; } } } } }
                }
            }
            store_token(tokens, count, ttype, start, len, 0);
            count = count + 1;
            continue;
        }
        
        // Integer literal
        if is_digit(c) == 1 {
            start = pos;
            val: u64 = 0;
            while pos < src_len {
                c = *(src + pos);
                if is_digit(c) == 0 { break; }
                val = val * 10 + (c - 48);
                pos = pos + 1;
            }
            len = pos - start;
            store_token(tokens, count, 2, start, len, val);
            count = count + 1;
            continue;
        }
        
        // Single-char tokens
        start = pos;
        len: u32 = 1;
        ttype: u32 = 1; // default to Ident (unknown)
        if c == 40 { ttype = 61; }      // (
        else { if c == 41 { ttype = 62; } }  // )
        else { if c == 123 { ttype = 63; } }  // {
        else { if c == 125 { ttype = 64; } }  // }
        else { if c == 59 { ttype = 67; } }   // ;
        else { if c == 44 { ttype = 68; } }   // ,
        else { if c == 43 { ttype = 40; } }   // +
        else { if c == 45 { ttype = 41; } }   // -
        else { if c == 42 { ttype = 42; } }   // *
        else { if c == 60 { ttype = 48; } }   // <
        else { if c == 62 { ttype = 49; } }   // >
        
        if c == 61 {  // = or ==
            if pos + 1 < src_len {
                if *(src + pos + 1) == 61 {
                    ttype = 46; len = 2; pos = pos + 1;
                } else { ttype = 45; }
            } else { ttype = 45; }
        }
        
        if c == 33 {  // ! or !=
            if pos + 1 < src_len {
                if *(src + pos + 1) == 61 {
                    ttype = 47; len = 2; pos = pos + 1;
                }
            }
        }
        
        if ttype != 1 {
            store_token(tokens, count, ttype, start, len, 0);
            count = count + 1;
        }
        pos = pos + 1;
    }
    
    // EOF token
    if count < max_tokens {
        store_token(tokens, count, 0, pos, 0, 0);
        count = count + 1;
    }
    return count;
}
