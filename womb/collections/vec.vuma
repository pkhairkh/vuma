import "../lib/mem_helpers.vuma"::{store_u64, load_u64, store_u32, load_u32};
// womb/collections/vec.vuma — Dynamic array using heap-allocated memory
// Layout: { data_ptr: u64, len: u32, cap: u32 } = 16 bytes
//
// Uses allocate() (mmap) for persistent heap memory.
// Unlike the stack-local `let` slots, heap buffers survive function returns.
// This enables cross-function dynamic data structures.

// (No extern "C" declarations — write syscall is invoked via syscall() intrinsic where needed.)

// ── Store/load helpers (little-endian) ──

// ── Vector operations (heap-backed) ──

// Create a new vector with initial capacity (in bytes).
// The vector header and data buffer are both heap-allocated.
transform vec_new(cap: u32) -> Address {
    v = allocate(16);
    if cap == 0 { cap = 16; }
    data = allocate(cap);
    store_u64(v, 0, data);
    store_u32(v, 8, 0);     // len = 0
    store_u32(v, 12, cap);  // cap
    return v;
}

transform vec_len(v: Address) -> u32 {
    return load_u32(v, 8);
}

transform vec_cap(v: Address) -> u32 {
    return load_u32(v, 12);
}

transform vec_data(v: Address) -> u64 {
    return load_u64(v, 0);
}

transform vec_set_len(v: Address, len: u32) {
    store_u32(v, 8, len);
}

// Ensure capacity >= needed. Allocates new buffer on heap, copies data,
// frees old buffer. Works across function calls because allocate()
// uses mmap (persistent heap memory).
transform vec_reserve(v: Address, needed: u32) {
    cap: u32 = vec_cap(v);
    if needed <= cap { return; }
    new_cap: u32 = cap;
    if new_cap == 0 { new_cap = 16; }
    while new_cap < needed {
        new_cap = new_cap * 2;
    }
    new_data = allocate(new_cap);
    old_data: u64 = vec_data(v);
    old_len: u32 = vec_len(v);
    // Copy old data
    i: u32 = 0;
    while i < old_len {
        b: u32 = *(old_data + i);
        *(new_data + i) = b & 255;
        i = i + 1;
    }
    // Free old buffer (munmap)
    free(old_data);
    // Update vector header
    store_u64(v, 0, new_data);
    store_u32(v, 12, new_cap);
}

// Push a byte onto the vector
transform vec_push_byte(v: Address, byte: u32) {
    len: u32 = vec_len(v);
    cap: u32 = vec_cap(v);
    if len >= cap {
        vec_reserve(v, len + 1);
    }
    data: u64 = vec_data(v);
    *(data + len) = byte & 255;
    store_u32(v, 8, len + 1);
}

// Push a u64 value (8 bytes, little-endian)
transform vec_push_u64(v: Address, val: u64) {
    len: u32 = vec_len(v);
    vec_reserve(v, len + 8);
    data: u64 = vec_data(v);
    store_u64(data, len, val);
    store_u32(v, 8, len + 8);
}

// Push a u32 value (4 bytes, little-endian)
transform vec_push_u32(v: Address, val: u32) {
    len: u32 = vec_len(v);
    vec_reserve(v, len + 4);
    data: u64 = vec_data(v);
    store_u32(data, len, val);
    store_u32(v, 8, len + 4);
}

// Pop a byte. Returns the byte, or -1 if empty.
transform vec_pop_byte(v: Address) -> i32 {
    len: u32 = vec_len(v);
    if len == 0 { return -1; }
    len = len - 1;
    data: u64 = vec_data(v);
    b: u32 = *(data + len);
    store_u32(v, 8, len);
    return b;
}

// Get byte at index
transform vec_get(v: Address, idx: u32) -> u32 {
    len: u32 = vec_len(v);
    if idx >= len { return 0; }
    data: u64 = vec_data(v);
    return *(data + idx);
}

// Set byte at index
transform vec_set(v: Address, idx: u32, val: u32) {
    len: u32 = vec_len(v);
    if idx >= len { return; }
    data: u64 = vec_data(v);
    *(data + idx) = val & 255;
}

// Get u64 at byte offset
transform vec_get_u64(v: Address, offset: u32) -> u64 {
    len: u32 = vec_len(v);
    if offset + 8 > len { return 0; }
    data: u64 = vec_data(v);
    return load_u64(data, offset);
}

// Set u64 at byte offset
transform vec_set_u64(v: Address, offset: u32, val: u64) {
    len: u32 = vec_len(v);
    if offset + 8 > len { return; }
    data: u64 = vec_data(v);
    store_u64(data, offset, val);
}

// Get u32 at byte offset
transform vec_get_u32(v: Address, offset: u32) -> u32 {
    len: u32 = vec_len(v);
    if offset + 4 > len { return 0; }
    data: u64 = vec_data(v);
    return load_u32(data, offset);
}

// Clear (set len=0, keep cap)
transform vec_clear(v: Address) {
    store_u32(v, 8, 0);
}

transform vec_is_empty(v: Address) -> u32 {
    len: u32 = vec_len(v);
    if len == 0 { return 1; }
    return 0;
}

// Free the vector and its data buffer
transform vec_free(v: Address) {
    data: u64 = vec_data(v);
    cap: u32 = vec_cap(v);
    free(data);
    free(v);
}
