import "../lib/mem_helpers.vuma"::{store_u64, load_u64, store_u32, load_u32};
// womb/fs/file.vuma — File I/O via raw Linux syscalls
// Provides: open, read, write, close, read_to_string, write_file
// Uses the vuma-native syscall() intrinsic for read/write/open/close
// (asm-generic nrs 63/64/56/57). `open` is reshaped to `openat(AT_FDCWD, ...)`
// because asm-generic has no `open` syscall.
// allocate()/free() are vuma-native builtins (P2 work).

const AT_FDCWD: i64 = -100;

// Read entire file into a heap-allocated buffer.
// Returns a 16-byte result struct: { data_ptr: u64, len: u32, _pad: u32 }
// On error, len = 0 and data_ptr = 0.
transform file_read_to_buffer(path: Address, path_len: u32) -> Address {
    // Open file (need null-terminated path — assume caller provides one)
    fd: i64 = syscall(56, AT_FDCWD, path, 0, 0);  // openat(AT_FDCWD, path, O_RDONLY, 0)
    if fd < 0 { return 0; }
    
    // Allocate initial buffer (will grow as needed)
    buf_size: u32 = 4096;
    buf = allocate(buf_size);
    total: u32 = 0;
    done: u32 = 0;
    
    while done == 0 {
        remaining: u32 = buf_size - total;
        if remaining == 0 {
            // Need to grow — allocate new, copy, free old
            new_size: u32 = buf_size * 2;
            new_buf = allocate(new_size);
            i: u32 = 0;
            while i < total {
                *(new_buf + i) = *(buf + i) & 255;
                i = i + 1;
            }
            free(buf);
            buf = new_buf;
            buf_size = new_size;
            remaining = buf_size - total;
        }
        n: i64 = syscall(63, fd, buf + total, remaining as i64);
        if n <= 0 { done = 1; }
        else { total = total + (n & 0xFFFFFFFF); }
    }
    syscall(57, fd);
    
    // Return result struct
    result = allocate(16);
    store_u64(result, 0, buf);
    store_u32(result, 8, total);
    store_u32(result, 12, buf_size);
    return result;
}

// Get data pointer from file_read_to_buffer result
transform file_result_data(result: Address) -> u64 {
    return load_u64(result, 0);
}

// Get length from file_read_to_buffer result
transform file_result_len(result: Address) -> u32 {
    return load_u32(result, 8);
}

// Write data to a file path. Returns bytes written, or -1 on error.
transform file_write(path: Address, data: Address, data_len: u32) -> i32 {
    fd: i64 = syscall(56, AT_FDCWD, path, 577, 420);  // openat(AT_FDCWD, path, O_WRONLY|O_CREAT|O_TRUNC, 0644)
    if fd < 0 { return -1; }
    n: i64 = syscall(64, fd, data, data_len as i64);
    syscall(57, fd);
    if n < 0 { return -1; }
    return n & 0xFFFFFFFF;
}

// Write to stdout (fd=1)
transform stdout_write(buf: Address, len: u32) -> i32 {
    n: i64 = syscall(64, 1, buf, len as i64);
    if n < 0 { return -1; }
    return n & 0xFFFFFFFF;
}

// Write to stderr (fd=2)
transform stderr_write(buf: Address, len: u32) -> i32 {
    n: i64 = syscall(64, 2, buf, len as i64);
    if n < 0 { return -1; }
    return n & 0xFFFFFFFF;
}
