import "../lib/mem_helpers.vuma"::{store_u64, load_u64, store_u32, load_u32};
// womb/fs/high_level.vuma — High-level file system operations
// Provides: read_to_string, write_all, path_join, path_basename
// Built on top of womb/fs/file.vuma raw syscall wrappers.
// Uses the vuma-native syscall() intrinsic for read/write/open/close
// (asm-generic nrs 63/64/56/57). `open` is reshaped to `openat(AT_FDCWD, ...)`
// because asm-generic has no `open` syscall.
// allocate()/free() are vuma-native builtins (P2 work).

const AT_FDCWD: i64 = -100;

// Read entire file into a heap-allocated buffer.
// Returns result struct (16 bytes): { data_ptr: u64, len: u32, _pad: u32 }
// On error returns 0 (null).
transform read_file(path: Address) -> Address {
    fd: i64 = syscall(56, AT_FDCWD, path, 0, 0);  // openat(AT_FDCWD, path, O_RDONLY, 0)
    if fd < 0 { return 0; }
    
    buf_size: u32 = 4096;
    buf = allocate(buf_size);
    total: u32 = 0;
    done: u32 = 0;
    
    while done == 0 {
        remaining: u32 = buf_size - total;
        if remaining == 0 {
            // Grow
            new_size: u32 = buf_size * 2;
            new_buf = allocate(new_size);
            i: u32 = 0;
            while i < total { *(new_buf + i) = *(buf + i) & 255; i = i + 1; }
            free(buf);
            buf = new_buf; buf_size = new_size;
            remaining = buf_size - total;
        }
        n: i64 = syscall(63, fd, buf + total, remaining as i64);
        if n <= 0 { done = 1; }
        else { total = total + (n & 0xFFFFFFFF); }
    }
    syscall(57, fd);
    
    result = allocate(16);
    store_u64(result, 0, buf);
    store_u32(result, 8, total);
    store_u32(result, 12, buf_size);
    return result;
}

transform read_result_data(result: Address) -> u64 { return load_u64(result, 0); }
transform read_result_len(result: Address) -> u32 { return load_u32(result, 8); }

// Write entire buffer to file. Returns 1 on success, 0 on error.
transform write_file(path: Address, data: Address, data_len: u32) -> u32 {
    fd: i64 = syscall(56, AT_FDCWD, path, 577, 420);  // openat(AT_FDCWD, path, O_WRONLY|O_CREAT|O_TRUNC, 0644)
    if fd < 0 { return 0; }
    written: u32 = 0;
    while written < data_len {
        n: i64 = syscall(64, fd, data + written, (data_len - written) as i64);
        if n <= 0 { syscall(57, fd); return 0; }
        written = written + (n & 0xFFFFFFFF);
    }
    syscall(57, fd);
    return 1;
}

// Write to stdout
transform write_stdout(data: Address, len: u32) -> i64 {
    return syscall(64, 1, data, len as i64);
}

// Write to stderr
transform write_stderr(data: Address, len: u32) -> i64 {
    return syscall(64, 2, data, len as i64);
}

// ── Path manipulation ──

// Find the last '/' in a path. Returns index or 0xFFFFFFFF if none.
transform path_last_slash(path: Address, len: u32) -> u32 {
    i: u32 = len;
    while i > 0 {
        i = i - 1;
        if *(path + i) == 47 { return i; }  // '/'
    }
    return 0xFFFFFFFF;
}

// Get basename: returns (ptr, len) pointing into the original path.
// Returns { ptr: u64 (low 32), len: u32 (high 32) }
transform path_basename(path: Address, path_len: u32) -> u64 {
    slash: u32 = path_last_slash(path, path_len);
    if slash == 0xFFFFFFFF { return path | ((path_len as u64) << 32); }
    base_ptr: u64 = path + slash + 1;
    base_len: u32 = path_len - slash - 1;
    return base_ptr | ((base_len as u64) << 32);
}

// Get directory: copies the directory portion to dst.
// Returns the length of the directory path.
transform path_dirname(path: Address, path_len: u32, dst: Address, dst_cap: u32) -> u32 {
    slash: u32 = path_last_slash(path, path_len);
    if slash == 0xFFFFFFFF {
        // No slash — copy "."
        if dst_cap > 0 { *(dst + 0) = 46; }
        return 1;
    }
    if slash == 0 {
        // Root "/"
        if dst_cap > 0 { *(dst + 0) = 47; }
        return 1;
    }
    n: u32 = slash;
    if n >= dst_cap { n = dst_cap - 1; }
    i: u32 = 0;
    while i < n { *(dst + i) = *(path + i) & 255; i = i + 1; }
    if n < dst_cap { *(dst + n) = 0; }
    return n;
}

// Join two paths: dst = base + "/" + child
// Returns total length.
transform path_join(dst: Address, dst_cap: u32, base: Address, base_len: u32, child: Address, child_len: u32) -> u32 {
    pos: u32 = 0;
    // Copy base
    while pos < base_len && pos + 1 < dst_cap {
        *(dst + pos) = *(base + pos) & 255;
        pos = pos + 1;
    }
    // Add '/' if base doesn't end with one
    if pos > 0 && pos + 1 < dst_cap {
        if *(dst + pos - 1) != 47 {
            *(dst + pos) = 47;
            pos = pos + 1;
        }
    }
    // Copy child
    i: u32 = 0;
    while i < child_len && pos + 1 < dst_cap {
        *(dst + pos) = *(child + i) & 255;
        pos = pos + 1;
        i = i + 1;
    }
    if pos < dst_cap { *(dst + pos) = 0; }
    return pos;
}

// Check if file extension matches. path ends with "." + ext
transform path_has_extension(path: Address, path_len: u32, ext: Address, ext_len: u32) -> u32 {
    if path_len < ext_len + 1 { return 0; }
    dot_pos: u32 = path_len - ext_len - 1;
    if *(path + dot_pos) != 46 { return 0; }  // '.'
    i: u32 = 0;
    while i < ext_len {
        if *(path + dot_pos + 1 + i) != *(ext + i) { return 0; }
        i = i + 1;
    }
    return 1;
}

// Free a read_file result
transform read_result_free(result: Address) {
    data: u64 = load_u64(result, 0);
    buf_size: u32 = load_u32(result, 12);
    free(data);
    free(result);
}
