// womb/net/tcp.vuma — TCP/IP Socket Layer
// Expected exit code: 0
//
// This is a COMPILABLE VUMA implementation of TCP/IP networking using
// Linux socket syscalls. It provides a simple client/server API.
//
// Supported on: x86_64, aarch64, riscv64, arm32, mips64, ppc64, loongarch64, x86_32
// Not supported on: wasm32 (WASI has no socket API), riscv32 (no socket stubs)
//
// All socket syscalls are invoked directly via the vuma-native
// `syscall(nr, args...) -> i64` intrinsic against asm-generic syscall
// numbers:
//   socket(domain, sock_type, protocol)               -> syscall(198, ...)
//   connect(sockfd, addr, addrlen)                    -> syscall(203, ...)
//   bind(sockfd, addr, addrlen)                       -> syscall(200, ...)
//   listen(sockfd, backlog)                           -> syscall(201, ...)
//   accept(sockfd, addr, addrlen)                     -> syscall(202, ...)
//   send(sockfd, buf, len, flags)                     -> syscall(206, sockfd, buf, len, flags, 0, 0)
//        (RESHAPE: sendto with NULL dest_addr/addrlen — same semantics)
//   recv(sockfd, buf, len, flags)                     -> syscall(207, sockfd, buf, len, flags, 0, 0)
//        (RESHAPE: recvfrom with NULL src_addr/addrlen — same semantics)
//   close(fd)                                         -> syscall(57, fd)
//   setsockopt(sockfd, level, optname, optval, optlen) -> syscall(208, ...)
//
// PMT migration (Wave 8c): the local `allocate(N)` scratch buffers
// (`addr` for sockaddr_in, `optval`/`addrlen` for socklen_t) are replaced
// by typed `State<SockaddrIn>` and `State<SockLen>` with `data: [u8; N]`
// array fields. The `make_sockaddr_in` helper takes `State<SockaddrIn>`.
// The states are passed to syscall(203)/syscall(200)/syscall(202)/
// syscall(208) where the codegen lowers `State<T>` to its underlying
// buffer address. All `allocate`/`free` sites in this file are eliminated.

layout SockaddrIn = { data: [u8; 16] }
layout SockLen    = { data: [u8; 4]  }

// Constants
const AF_INET: i64 = 2;
const SOCK_STREAM: i64 = 1;
const SOL_SOCKET: i64 = 1;
const SO_REUSEADDR: i64 = 2;
const INET_ADDRSTRLEN: u32 = 16;

// ===========================================================================
// sockaddr_in structure (16 bytes):
//   [0..1]   sin_family (u16, AF_INET=2)
//   [2..3]   sin_port (u16, network byte order)
//   [4..7]   sin_addr (u32, network byte order)
//   [8..15]  sin_zero (8 bytes padding)
// ===========================================================================

fn make_sockaddr_in(addr: State<SockaddrIn>, port: u32, ip: u32) {
    // sin_family = AF_INET (2), little-endian on most archs
    addr.data[0] = 2;
    addr.data[1] = 0;

    // sin_port = htons(port)
    p0: u32 = (port >> 8) & 255;
    p1: u32 = port & 255;
    addr.data[2] = p0;
    addr.data[3] = p1;

    // sin_addr = htonl(ip)
    b0: u32 = (ip >> 24) & 255;
    b1: u32 = (ip >> 16) & 255;
    b2: u32 = (ip >> 8) & 255;
    b3: u32 = ip & 255;
    addr.data[4] = b3;
    addr.data[5] = b2;
    addr.data[6] = b1;
    addr.data[7] = b0;

    // sin_zero = 0 (8 bytes)
    i: u32 = 0;
    while i < 8 {
        addr.data[8 + i] = 0;
        i = i + 1;
    }
}

// ===========================================================================
// TCP Client: connect to IPv4:port, return socket fd (-1 on error)
// ip is a u32 in host byte order (e.g. 0x7F000001 = 127.0.0.1)
// ===========================================================================

fn tcp_connect(ip: u32, port: u32) -> i64 {
    sockfd: i64 = syscall(198, AF_INET, SOCK_STREAM, 0);
    if sockfd < 0 {
        return -1;
    }

    let addr = state_new(SockaddrIn);
    make_sockaddr_in(addr, port, ip);

    ret: i64 = syscall(203, sockfd, addr, 16);

    if ret < 0 {
        syscall(57, sockfd);
        return -1;
    }

    return sockfd;
}

// ===========================================================================
// TCP Server: bind to port, listen, return socket fd (-1 on error)
// ===========================================================================

fn tcp_listen(port: u32) -> i64 {
    sockfd: i64 = syscall(198, AF_INET, SOCK_STREAM, 0);
    if sockfd < 0 {
        return -1;
    }

    // SO_REUSEADDR
    let optval = state_new(SockLen);
    optval.data[0] = 1;
    optval.data[1] = 0;
    optval.data[2] = 0;
    optval.data[3] = 0;
    syscall(208, sockfd, SOL_SOCKET, SO_REUSEADDR, optval, 4);

    // Bind to 0.0.0.0:port
    let addr = state_new(SockaddrIn);
    make_sockaddr_in(addr, port, 0);
    ret: i64 = syscall(200, sockfd, addr, 16);

    if ret < 0 {
        syscall(57, sockfd);
        return -1;
    }

    ret = syscall(201, sockfd, 128);
    if ret < 0 {
        syscall(57, sockfd);
        return -1;
    }

    return sockfd;
}

// ===========================================================================
// TCP Accept: accept a connection, return client fd (-1 on error)
// ===========================================================================

fn tcp_accept(listen_fd: i64) -> i64 {
    let client_addr = state_new(SockaddrIn);
    let addrlen = state_new(SockLen);
    addrlen.data[0] = 16;
    addrlen.data[1] = 0;
    addrlen.data[2] = 0;
    addrlen.data[3] = 0;

    client_fd: i64 = syscall(202, listen_fd, client_addr, addrlen);

    return client_fd;
}

// ===========================================================================
// TCP Send: send data, return bytes sent (-1 on error)
// ===========================================================================

fn tcp_send(sockfd: i64, data: Address, len: u32) -> i64 {
    // RESHAPE: send(sockfd, buf, len, flags) -> sendto(sockfd, buf, len, flags, NULL, 0)
    // = syscall(206, sockfd, buf, len, flags, 0, 0). `len` is u32 -> i64 widening cast.
    return syscall(206, sockfd, data, len as i64, 0, 0, 0);
}

// ===========================================================================
// TCP Recv: receive data, return bytes received (-1 on error, 0 on EOF)
// ===========================================================================

fn tcp_recv(sockfd: i64, buf: Address, len: u32) -> i64 {
    // RESHAPE: recv(sockfd, buf, len, flags) -> recvfrom(sockfd, buf, len, flags, NULL, NULL)
    // = syscall(207, sockfd, buf, len, flags, 0, 0). `len` is u32 -> i64 widening cast.
    return syscall(207, sockfd, buf, len as i64, 0, 0, 0);
}

// ===========================================================================
// TCP Close: close socket
// ===========================================================================

fn tcp_close(sockfd: i64) {
    syscall(57, sockfd);
}

// ===========================================================================
// Self-test: create a socket, check fd >= 0, close it
// On architectures without socket support, returns 0 (skip)
// ===========================================================================

fn main() -> i32 {
    // Try to create a TCP socket
    sockfd: i64 = syscall(198, AF_INET, SOCK_STREAM, 0);

    if sockfd < 0 {
        // Socket creation failed — likely wasm32 or riscv32 without stubs
        // This is expected on unsupported platforms, return 0
        return 0;
    }

    // Close the socket
    syscall(57, sockfd);

    return 0;
}
