// womb/env/cli.vuma — CLI argument parsing
// Accesses argc/argv via the stack (passed by the runtime).
// Provides: cli_args_count, cli_arg_get, cli_parse_flags
// Uses the vuma-native syscall() intrinsic for write (asm-generic nr 64).
// allocate()/free() are vuma-native builtins (P2 work).
// cli_read_cmdline reads /proc/self/cmdline via openat(56)/read(63)/close(57)
// syscalls (P5.2 work).

// On x86_64 Linux, the kernel places argc at [rsp] and argv at [rsp+8]
// at program start. Since VUMA's main() takes no args, we access them
// via a syscall-free approach: read from /proc/self/cmdline.
// This is more portable than stack scraping.

// Constants for the openat/read/close syscalls (asm-generic numbers).
//   openat = 56, close = 57, read = 63, write = 64
const AT_FDCWD: i64 = -100;
const O_RDONLY: i32 = 0;
const CMDLINE_BUF_SIZE: u32 = 4096;

fn store_u64(ptr: Address, offset: u32, val: u64) {
    *(ptr + offset) = val & 255; *(ptr + offset + 1) = (val >> 8) & 255;
    *(ptr + offset + 2) = (val >> 16) & 255; *(ptr + offset + 3) = (val >> 24) & 255;
    *(ptr + offset + 4) = (val >> 32) & 255; *(ptr + offset + 5) = (val >> 40) & 255;
    *(ptr + offset + 6) = (val >> 48) & 255; *(ptr + offset + 7) = (val >> 56) & 255;
}
fn load_u64(ptr: Address, offset: u32) -> u64 {
    b0: u64 = *(ptr + offset); b1: u64 = *(ptr + offset + 1);
    b2: u64 = *(ptr + offset + 2); b3: u64 = *(ptr + offset + 3);
    b4: u64 = *(ptr + offset + 4); b5: u64 = *(ptr + offset + 5);
    b6: u64 = *(ptr + offset + 6); b7: u64 = *(ptr + offset + 7);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56);
}
fn store_u32(ptr: Address, offset: u32, val: u32) {
    *(ptr + offset) = val & 255; *(ptr + offset + 1) = (val >> 8) & 255;
    *(ptr + offset + 2) = (val >> 16) & 255; *(ptr + offset + 3) = (val >> 24) & 255;
}
fn load_u32(ptr: Address, offset: u32) -> u32 {
    b0: u32 = *(ptr + offset); b1: u32 = *(ptr + offset + 1);
    b2: u32 = *(ptr + offset + 2); b3: u32 = *(ptr + offset + 3);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

// Read /proc/self/cmdline into a heap buffer.
// Returns a result struct (16 bytes): { data_ptr: u64, total_len: u32, arg_count: u32 }
// The cmdline format is: arg0\0arg1\0arg2\0...argN\0\0
fn cli_read_cmdline() -> Address {
    // Open /proc/self/cmdline (need null-terminated path)
    path = allocate(32);
    *(path + 0) = 47;  // /
    *(path + 1) = 112; // p
    *(path + 2) = 114; // r
    *(path + 3) = 111; // o
    *(path + 4) = 99;  // c
    *(path + 5) = 47;  // /
    *(path + 6) = 115; // s
    *(path + 7) = 101; // e
    *(path + 8) = 108; // l
    *(path + 9) = 102; // f
    *(path + 10) = 47; // /
    *(path + 11) = 99; // c
    *(path + 12) = 109; // m
    *(path + 13) = 100; // d
    *(path + 14) = 108; // l
    *(path + 15) = 105; // i
    *(path + 16) = 110; // n
    *(path + 17) = 101; // e
    *(path + 18) = 0;   // null terminator
    
    // Open /proc/self/cmdline via openat(AT_FDCWD, path, O_RDONLY, 0).
    // asm-generic syscall nr 56 = openat. Returns fd (i64); fd<0 on error.
    fd: i64 = syscall(56, AT_FDCWD, path, O_RDONLY as i64, 0);
    if fd < 0 {
        // Open failed — return empty result. Free path, no data buffer yet.
        result = allocate(16);
        store_u64(result, 0, 0);      // data_ptr = 0
        store_u32(result, 8, 0);      // total_len = 0
        store_u32(result, 12, 0);     // arg_count = 0
        free(path);
        return result;
    }
    
    // Read the entire cmdline into a 4096-byte heap buffer.
    // asm-generic syscall nr 63 = read. Returns bytes read (i64); <=0 on EOF/error.
    buf = allocate(CMDLINE_BUF_SIZE);
    n: i64 = syscall(63, fd, buf, CMDLINE_BUF_SIZE as i64);
    // Close the fd regardless of read outcome (asm-generic nr 57 = close).
    syscall(57, fd);
    // Path buffer is no longer needed — free it (data buffer is kept for caller).
    free(path);
    
    if n < 0 {
        // Read failed — return empty result, free the unused data buffer.
        free(buf);
        result = allocate(16);
        store_u64(result, 0, 0);
        store_u32(result, 8, 0);
        store_u32(result, 12, 0);
        return result;
    }
    
    total_len: u32 = n & 0xFFFFFFFF;
    
    // Count args. The cmdline format is `arg0\0arg1\0...argN\0` (args separated
    // by null bytes). The kernel terminates the buffer with the last arg's null;
    // some kernels/emitters add an extra trailing null (double-null), in which
    // case the final null is a terminator, not a separator, and we subtract one.
    null_count: u32 = 0;
    pos: u32 = 0;
    while pos < total_len {
        if *(buf + pos) == 0 {
            null_count = null_count + 1;
        }
        pos = pos + 1;
    }
    
    arg_count: u32 = null_count;
    if total_len >= 2 {
        last_byte: u32 = *(buf + total_len - 1) & 255;
        prev_byte: u32 = *(buf + total_len - 2) & 255;
        if last_byte == 0 && prev_byte == 0 {
            // Trailing double-null: the final null is a terminator, not a
            // separator. Drop it from the arg count.
            arg_count = null_count - 1;
        }
    }
    // Guard against the (impossible) underflow when null_count == 0.
    if arg_count > null_count { arg_count = 0; }
    
    // Build result struct (16 bytes): { data_ptr: u64, total_len: u32, arg_count: u32 }
    // The data buffer (buf) is kept allocated — the caller accesses args via it.
    result = allocate(16);
    store_u64(result, 0, buf);          // data_ptr
    store_u32(result, 8, total_len);    // total_len
    store_u32(result, 12, arg_count);   // arg_count
    return result;
}

// Get argument count from cmdline result
fn cli_arg_count(result: Address) -> u32 {
    return load_u32(result, 12);
}

// Get argument N from cmdline result.
// Returns (ptr, len) as u64: ptr in low 32 bits, len in high 32 bits.
fn cli_arg_get(result: Address, idx: u32) -> u64 {
    data: u64 = load_u64(result, 0);
    total_len: u32 = load_u32(result, 8);
    if data == 0 { return 0; }
    
    // Walk through null-separated args
    pos: u32 = 0;
    current: u32 = 0;
    while pos < total_len {
        // Find end of current arg
        arg_start: u32 = pos;
        while pos < total_len {
            if *(data + pos) == 0 { break; }
            pos = pos + 1;
        }
        if current == idx {
            arg_len: u32 = pos - arg_start;
            return (data + arg_start) | ((arg_len as u64) << 32);
        }
        current = current + 1;
        pos = pos + 1;  // skip the null
    }
    return 0;  // not found
}

// Parse a --flag=value argument.
// Returns value (ptr, len) as u64, or 0 if flag not found.
fn cli_parse_flag(result: Address, flag_name: Address, flag_len: u32) -> u64 {
    count: u32 = cli_arg_count(result);
    i: u32 = 0;
    while i < count {
        arg: u64 = cli_arg_get(result, i);
        arg_ptr: u64 = arg & 0xFFFFFFFF;
        len: u32 = (arg >> 32) & 0xFFFFFFFF;
        
        // Check if arg starts with "--" + flag_name + "="
        if len > flag_len + 3 {
            // Check "--" prefix
            if *(arg_ptr + 0) == 45 && *(arg_ptr + 1) == 45 {
                // Compare flag name
                flag_match: u32 = 1;
                j: u32 = 0;
                while j < flag_len {
                    if *(arg_ptr + 2 + j) != *(flag_name + j) { flag_match = 0; }
                    j = j + 1;
                }
                if flag_match == 1 {
                    // Check "=" after flag name
                    if *(arg_ptr + 2 + flag_len) == 61 {  // '='
                        val_ptr: u64 = arg_ptr + 3 + flag_len;
                        val_len: u32 = len - 3 - flag_len;
                        return val_ptr | ((val_len as u64) << 32);
                    }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

// Check if a boolean flag --flag is present
fn cli_has_flag(result: Address, flag_name: Address, flag_len: u32) -> u32 {
    count: u32 = cli_arg_count(result);
    i: u32 = 0;
    while i < count {
        arg: u64 = cli_arg_get(result, i);
        arg_ptr: u64 = arg & 0xFFFFFFFF;
        len: u32 = (arg >> 32) & 0xFFFFFFFF;
        
        if len == flag_len + 2 {
            if *(arg_ptr + 0) == 45 && *(arg_ptr + 1) == 45 {
                flag_match: u32 = 1;
                j: u32 = 0;
                while j < flag_len {
                    if *(arg_ptr + 2 + j) != *(flag_name + j) { flag_match = 0; }
                    j = j + 1;
                }
                if flag_match == 1 { return 1; }
            }
        }
        i = i + 1;
    }
    return 0;
}

fn cli_free(result: Address) {
    data: u64 = load_u64(result, 0);
    total: u32 = load_u32(result, 8);
    if data != 0 { free(data); }
    free(result);
}
