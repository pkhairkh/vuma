// ────────────────────────────────────────────────────────────────────────────
// Lifecycle primitives.
// ────────────────────────────────────────────────────────────────────────────

// inode_init: zero all 64 inos (mark every slot FREE — ino == 0 is the
// free marker) and set count = 0. Idempotent. Called by kmain at boot
// before the first inode_alloc (K5d's tmpfs_fill_super will call this
// on the tmpfs InodeTable). Does NOT zero the other Inode fields
// (modes, sizes, etc.) — those are populated by inode_alloc's caller
// (K5d's tmpfs_create sets mode + uid + gid; K5c's file_write bumps
// size + mtime), so zeroing them here would be wasted work (and VUMA
// has no memset).
fn inode_init(tbl: State<InodeTable>) {
    let i = 0;
    while i < 64 {
        inode_set_ino(tbl, i, 0);
        i = i + 1;
    }
    tbl.count = 0;
}

// inode_alloc: find the first FREE slot (ino == 0), set ino = idx + 1
// (so ino 0 is never handed out — matches Linux's "inode 0 is
// invalid" convention; this also serves as the "slot is in use" marker
// for subsequent allocs), bump count, return the slot index. Returns 64
// if the table is full (the caller MUST check — K5d's tmpfs_create
// returns -ENOSPC in that case).
//
// Does NOT touch mode / uid / gid / size / etc. — those are populated
// by the caller. The caller MUST set at least mode before the inode is
// linked into the directory tree (K5b's dentry_link checks mode != 0
// as a "real inode" sanity check before linking).
//
// The lowest-free-slot-wins policy matches Linux's find_first_zero_bit
// (verified by the self-test: free slot 0, alloc → returns 0, not 2).
fn inode_alloc(tbl: State<InodeTable>) -> u32 {
    let i = 0;
    while i < 64 {
        if inode_get_ino(tbl, i) == 0 {
            inode_set_ino(tbl, i, i + 1);  // ino = idx + 1
            tbl.count = tbl.count + 1;
            return i;
        }
        i = i + 1;
    }
    return 64;  // table full
}

// inode_free: mark slot `idx` as FREE (ino = 0), decrement count. Does
// NOT zero the other Inode fields (mode, size, etc. stay stale until
// inode_alloc reuses the slot — inode_alloc only writes ino, leaving
// the other fields for the caller to repopulate). K5c's file_close
// calls this when the last reference to an inode is dropped; K5d's
// tmpfs_unlink calls this when a file is removed from the directory
// tree AND the link count reaches 0.
fn inode_free(tbl: State<InodeTable>, idx: u32) {
    inode_set_ino(tbl, idx, 0);
    tbl.count = tbl.count - 1;
}

// ────────────────────────────────────────────────────────────────────────────
// Self-test (the K5a DoD).
// ────────────────────────────────────────────────────────────────────────────
// Allocate an InodeTable via state_new, init it via inode_init, then:
//   (1) inode_alloc → returns 0 (first slot).
//   (2) inode_get_ino(0) == 1 (ino = idx + 1).
//   (3) tbl.count == 1.
//   (4) inode_set_mode(0, 33188); inode_get_mode(0) == 33188 (mode
//       set/get round-trip — catches any pack/unpack or field-offset
//       bug in the u32 4-byte pack/unpack path. 33188 = S_IFREG |
//       0o644 = 32768 + 420 — the standard "regular file, rw-r--r--"
//       mode).
//   (5) inode_set_size(0, 1024); inode_get_size(0) == 1024 (size
//       set/get round-trip — catches any pack/unpack or field-offset
//       bug in the u64 8-byte pack/unpack path).
//   (6) inode_set_uid(0, 1000); inode_get_uid(0) == 1000 (uid
//       round-trip).
//   (7) inode_set_gid(0, 1000); inode_get_gid(0) == 1000 (gid
//       round-trip — exercises a DIFFERENT u32 array than check 4 to
//       catch any field-array mix-up where uid and gid would alias).
//   (8) inode_alloc → returns 1 (second slot); tbl.count == 2.
//   (9) inode_free(0); tbl.count == 1; inode_get_ino(0) == 0 (freed).
//   (10) inode_alloc → returns 0 (reuses the freed slot — lowest-free-
//        slot-wins policy).
// Returns 0 on success, 1..10 on the corresponding check failure (so a
// future CI failure pinpoints the broken check).
//
// Per the K5a contract's "Use decimal constants" rule: all non-zero
// constants in the self-test use DECIMAL (33188, 1024, 1000, 1, 2, 10)
// — decimal avoids the parser's hex-literal path (parse_int_radix
// width-extension subtleties — see womb/kernel/arch/x86_64/pt.vuma
// header for the same rationale, and K4a's task.vuma for the same rule
// applied to slot count 256 and state values 1/2).

fn main() -> i32 {
    let tbl = state_new(InodeTable);
    inode_init(tbl);

    // Check 1: inode_alloc → returns 0 (first slot).
    let i0 = inode_alloc(tbl);
    if i0 != 0 { return 1; }

    // Check 2: the new slot's ino should be 1 (idx + 1).
    if inode_get_ino(tbl, 0) != 1 { return 2; }

    // Check 3: count should be 1.
    if tbl.count != 1 { return 3; }

    // Check 4: mode set/get round-trip (u32 4-byte pack/unpack).
    // 33188 = S_IFREG | 0o644 = 32768 + 420.
    inode_set_mode(tbl, 0, 33188);
    if inode_get_mode(tbl, 0) != 33188 { return 4; }

    // Check 5: size set/get round-trip (u64 8-byte pack/unpack).
    inode_set_size(tbl, 0, 1024);
    if inode_get_size(tbl, 0) != 1024 { return 5; }

    // Check 6: uid set/get round-trip (u32 pack/unpack on a different
    // array than mode — catches any field-array mix-up).
    inode_set_uid(tbl, 0, 1000);
    if inode_get_uid(tbl, 0) != 1000 { return 6; }

    // Check 7: gid set/get round-trip (u32 pack/unpack on yet another
    // array — catches uid/gid aliasing).
    inode_set_gid(tbl, 0, 1000);
    if inode_get_gid(tbl, 0) != 1000 { return 7; }

    // Check 8: alloc a second inode → returns 1; count == 2.
    let i1 = inode_alloc(tbl);
    if i1 != 1 { return 8; }
    if tbl.count != 2 { return 8; }

    // Check 9: free slot 0 → ino == 0 (FREE), count == 1.
    inode_free(tbl, i0);
    if inode_get_ino(tbl, 0) != 0 { return 9; }
    if tbl.count != 1 { return 9; }

    // Check 10: alloc should reuse slot 0 (lowest-free-slot-wins).
    let i2 = inode_alloc(tbl);
    if i2 != 0 { return 10; }

    return 0;
}
