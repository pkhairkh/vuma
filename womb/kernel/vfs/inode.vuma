// ────────────────────────────────────────────────────────────────────────────
// u32 pack/unpack helpers (modes, uids, gids).
// ────────────────────────────────────────────────────────────────────────────
// 4-byte little-endian pack/unpack. Same pattern as K4a's pt_get_pid /
// pt_set_pid / pt_get_ppid / pt_set_ppid (task.vuma) and K3e's
// syscall_table_get / syscall_table_set with a 4-byte loop bound (u32,
// not u64). The 4-byte loop is correct because u32 fits in 4 bytes —
// bytes 4..7 would be zero-shifted out anyway.

// Read the u32 `mode` field of Inode slot `idx` from InodeTable.modes.
fn inode_get_mode(tbl: State<InodeTable>, idx: u32) -> u32 {
    let off = idx * 4;
    let v: u32 = 0;
    let i = 0;
    while i < 4 {
        let sh = i * 8;
        let b = tbl.modes[off + i] as u32;
        v = v + (b << sh);
        i = i + 1;
    }
    return v;
}

// Write the u32 `mode` field of Inode slot `idx` into InodeTable.modes.
fn inode_set_mode(tbl: State<InodeTable>, idx: u32, val: u32) {
    let off = idx * 4;
    let i = 0;
    while i < 4 {
        let sh = i * 8;
        let b = (val >> sh) & 255;
        tbl.modes[off + i] = b as u8;
        i = i + 1;
    }
}

