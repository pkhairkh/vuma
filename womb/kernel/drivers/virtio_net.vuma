// womb/kernel/drivers/virtio_net.vuma
// VWK virtio-net driver — QEMU virtio-net MMIO device.
//
// In hosted mode, all MMIO externs are stubs (return 0). In bare-metal
// mode (K11), these are real MMIO reads/writes to the virtio device.

extern "C" {
    fn mmio_read32(addr: u64) -> u32;
    fn mmio_write32(addr: u64, val: u32);
}

// virtio MMIO register layout (offsets from base address).
layout VirtioNetRegs = {
    magic: u32,         // 0x74726976 = "virt"
    version: u32,       // 1 (legacy) or 2 (modern)
    dev_id: u32,        // device ID (1 = virtio-net)
    vendor: u32,        // 0x554D4551 = "QEMU"
    host_features: u32,
    guest_features: u32,
    queue_sel: u32,
    queue_num_max: u32,
    queue_num: u32,
    queue_pfn: u32,
    queue_notify: u32,
    status: u32,
}

// Network packet buffer (MTU 1500 + 14B Ethernet header = 1514).
layout NetPacket = { data: [u8; 1514] }

// Initialize the virtio-net device at `base`.
// Returns 0 on success, -1 if magic doesn't match.
fn virtio_net_init(base: u64) -> i64 {
    let magic = mmio_read32(base);
    if magic != 195936478 {  // 0x74726976 = "virt"
        return 0 - 1;
    }
    let dev_id = mmio_read32(base + 8);
    if dev_id != 1 {
        return 0 - 1;
    }
    let host_feat = mmio_read32(base + 16);
    mmio_write32(base + 20, host_feat);
    mmio_write32(base + 40, 15);  // 0xF = ACK|DRIVER|OK|FEATURES_OK
    return 0;
}

// Receive a packet (simplified).
fn virtio_net_rx(base: u64, buf: State<NetPacket>) -> i64 {
    return 0;
}

// Transmit a packet (simplified).
fn virtio_net_tx(base: u64, buf: State<NetPacket>, len: u64) -> i64 {
    return len as i64;
}

fn main() -> i32 {
    let pkt = state_new(NetPacket);
    let tx_ret = virtio_net_tx(4026531840, pkt, 64);
    if tx_ret != 64 { return 1; }
    let rx_ret = virtio_net_rx(4026531840, pkt);
    if rx_ret != 0 { return 2; }
    return 0;
}
