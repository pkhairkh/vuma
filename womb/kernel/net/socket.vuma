// ────────────────────────────────────────────────────────────────────────────
// u16 pack/unpack helpers (local_ports, remote_ports).
// ────────────────────────────────────────────────────────────────────────────
// 2-byte little-endian pack/unpack. Same pattern as the u32 helpers above
// but with a 2-byte loop bound (u16, not u32). The 2-byte loop is correct
// because u16 fits in 2 bytes — bytes 2..3 would be zero-shifted out.

// Read the u16 `local_port` field of socket slot `idx` from SocketTable.local_ports.
fn sock_get_local_port(tbl: State<SocketTable>, idx: u32) -> u16 {
    let off = idx * 2;
    let v: u16 = 0;
    let i = 0;
    while i < 2 {
        let sh = i * 8;
        let b = tbl.local_ports[off + i] as u16;
        v = v + (b << sh);
        i = i + 1;
    }
    return v;
}

// Write the u16 `local_port` field of socket slot `idx` into SocketTable.local_ports.
fn sock_set_local_port(tbl: State<SocketTable>, idx: u32, val: u16) {
    let off = idx * 2;
    let i = 0;
    while i < 2 {
        let sh = i * 8;
        let b = ((val >> sh) & 255) as u8;
        tbl.local_ports[off + i] = b;
        i = i + 1;
    }
}

// Read the u16 `remote_port` field of socket slot `idx` from SocketTable.remote_ports.
fn sock_get_remote_port(tbl: State<SocketTable>, idx: u32) -> u16 {
    let off = idx * 2;
    let v: u16 = 0;
    let i = 0;
    while i < 2 {
        let sh = i * 8;
        let b = tbl.remote_ports[off + i] as u16;
        v = v + (b << sh);
        i = i + 1;
    }
    return v;
}

// Write the u16 `remote_port` field of socket slot `idx` into SocketTable.remote_ports.
fn sock_set_remote_port(tbl: State<SocketTable>, idx: u32, val: u16) {
    let off = idx * 2;
    let i = 0;
    while i < 2 {
        let sh = i * 8;
        let b = ((val >> sh) & 255) as u8;
        tbl.remote_ports[off + i] = b;
        i = i + 1;
    }
}

// ────────────────────────────────────────────────────────────────────────────
// Socket operations.
// ────────────────────────────────────────────────────────────────────────────

// sock_init: zero all 64 slots' state + used flags, set count = 0.
// Idempotent. Called once at boot before any sys_socket. Does NOT zero
// the other Socket fields (families, types, protos, local_addrs, etc.)
// — those are populated by sys_socket / sys_bind on first use, so
// zeroing them here would be wasted work (and VUMA has no memset).
// Same choice as K4a's pt_init (womb/kernel/proc/task.vuma:502-509).
//
// State<T> params: 1 (tbl). Pure write — no reads, no helper calls.
// The byte-by-byte loop is the PMT-pure way to zero two 64-byte arrays
// (states + used); same idiom as K8e's ipi_init (womb/kernel/smp/ipi.vuma
// :315-322) zeroing handlers[0..128] — just two arrays instead of one.
fn sock_init(tbl: State<SocketTable>) {
    let i = 0;
    while i < 64 {
        tbl.states[i] = 0;
        tbl.used[i] = 0;
        i = i + 1;
    }
    tbl.count = 0;
}

// sys_socket: create a socket. Find the first free slot (used[i] == 0),
// set family/type/proto via the pack/unpack helpers, mark state=closed(0),
// mark used=1, bump count, return the slot index (0..63). Returns -1 if
// the table is full (all 64 slots in use).
//
//   tbl:       the SocketTable.
//   family:    AF_INET=2, AF_UNIX=1 (full enum in K9b).
//   sock_type: SOCK_STREAM=1, SOCK_DGRAM=2 (full enum in K9b).
//   proto:     0 = default (IPPROTO_IP — kernel picks based on `type`).
//
// Returns the slot index (0..63) on success, or -1 on table-full.
//
// The lowest-free-slot-wins policy matches Linux's find_next_zero_bit
// and K4a's task_alloc (womb/kernel/proc/task.vuma:518-530). The self-
// test verifies this indirectly: sys_accept calls sys_socket after fd 0
// is already in use, and the new socket lands at fd 1 (the next free
// slot).
//
// State<T> params: 1 (tbl). Writes 4 fields: families[i*4..i*4+4],
// types[i*4..i*4+4], protos[i*4..i*4+4] (via the pack helpers), states[i]
// (direct), used[i] (direct), count. No reads (the `used[i] == 0` check
// is a direct array read, not a helper call).
fn sys_socket(tbl: State<SocketTable>, family: u32, sock_type: u32, proto: u32) -> i64 {
    let i = 0;
    while i < 64 {
        if tbl.used[i] == 0 {
            sock_set_family(tbl, i, family);
            sock_set_type(tbl, i, sock_type);
            sock_set_proto(tbl, i, proto);
            tbl.states[i] = 0;  // closed
            tbl.used[i] = 1;
            tbl.count = tbl.count + 1;
            return i as i64;
        }
        i = i + 1;
    }
    return 0 - 1;  // -1 (table full)
}

// sys_bind: bind a socket to a local address + port. Sets local_addr +
// local_port on the socket, flips state to bound(1). Returns 0 on
// success, 22 (-EINVAL) on fd >= 64, 9 (-EBADF) on unused slot.
//
//   tbl:  the SocketTable.
//   fd:   socket file descriptor (slot index, 0..63).
//   addr: IPv4 address as u32 (host order — see "127.0.0.1
//         representation" in the file header).
//   port: port number (host order, fits in u16).
//
// In a real kernel, sys_bind would also: (1) check that the port isn't
// already in use by another socket (unless SO_REUSEADDR — K9b), (2)
// route the address through the network interface table (K9c), (3)
// acquire a lock on the socket table (K8a's spinlock or K8b's mutex —
// K9b will wire this up). K9a is PMT-pure: no locks, no port-conflict
// check, no routing — just the field writes + state flip.
//
// State<T> params: 1 (tbl). Writes 3 fields: local_addrs[fd*4..fd*4+4]
// (via sock_set_local_addr), local_ports[fd*2..fd*2+2] (via
// sock_set_local_port), states[fd] (direct). Reads used[fd] (direct).
fn sys_bind(tbl: State<SocketTable>, fd: u32, addr: u32, port: u16) -> i64 {
    if fd >= 64 { return 22; }       // -EINVAL
    if tbl.used[fd] == 0 { return 9; }  // -EBADF
    sock_set_local_addr(tbl, fd, addr);
    sock_set_local_port(tbl, fd, port);
    tbl.states[fd] = 1;  // bound
    return 0;
}

// sys_listen: mark a socket as a passive accept target. Flips state to
// listening(2), records the backlog (max pending connections the kernel
// will queue before dropping new ones). Returns 0 on success, 22
// (-EINVAL) on fd >= 64, 9 (-EBADF) on unused slot.
//
//   tbl:     the SocketTable.
//   fd:      socket file descriptor (must be bound — K9b will enforce
//            state == 1; K9a doesn't check, matching the contract).
//   backlog: max pending connections (Linux default SOMAXCONN=4096;
//            K9a's u32 can hold any reasonable value).
//
// In a real kernel, sys_listen would also initialize the listen queue
// (a per-socket array of pending connection requests — K9b's
// TCPCtrl.accept_queue). K9a just records the backlog field; the
// actual queue is deferred to K9b.
//
// State<T> params: 1 (tbl). Writes 2 fields: backlogs[fd*4..fd*4+4]
// (via sock_set_backlog), states[fd] (direct). Reads used[fd] (direct).
fn sys_listen(tbl: State<SocketTable>, fd: u32, backlog: u32) -> i64 {
    if fd >= 64 { return 22; }
    if tbl.used[fd] == 0 { return 9; }
    sock_set_backlog(tbl, fd, backlog);
    tbl.states[fd] = 2;  // listening
    return 0;
}

// sys_accept: accept an incoming connection on a listening socket.
// Allocates a new socket (via sys_socket with AF_INET/SOCK_STREAM/
// IPPROTO_IP — the canonical TCP tuple) and flips its state to
// connected(3). Returns the new fd on success, 22 (-EINVAL) on fd >=
// 64 or fd not in listening state, 9 (-EBADF) on unused slot, -1 if
// the table is full (sys_socket failed).
//
//   tbl: the SocketTable.
//   fd:  the LISTENING socket's file descriptor (must be state == 2).
//
// In a real kernel, sys_accept would also: (1) dequeue a pending
// connection from the listen queue (K9b — the queue is populated by
// the TCP state machine when a SYN arrives), (2) copy the peer's
// remote_addr + remote_port into the new socket, (3) block (return
// -EAGAIN or yield to the scheduler) if the queue is empty. K9a's
// stub just allocates a new socket and flips it to connected — no
// queue, no peer info, no blocking. The K9a self-test verifies the
// allocation + state flip; the queue/peer/blocking path is K9b.
//
// State<T> params: 1 (tbl). Reads states[fd] + used[fd] (direct),
// calls sys_socket (which writes 5 fields on the new slot — see
// sys_socket's State<T> note), then writes states[new_fd] = 3
// (direct). The new_fd is a local i64 (sys_socket's return value,
// not a State<T> field read) — no state-typedness concern.
fn sys_accept(tbl: State<SocketTable>, fd: u32) -> i64 {
    if fd >= 64 { return 22; }
    if tbl.used[fd] == 0 { return 9; }
    if tbl.states[fd] != 2 { return 22; }  // not listening
    // Create a new socket for the connection (AF_INET=2, SOCK_STREAM=1,
    // IPPROTO_IP=0 — the canonical TCP tuple).
    let new_fd = sys_socket(tbl, 2, 1, 0);
    if new_fd < 0 { return new_fd; }
    // Flip the new socket to connected.
    tbl.states[new_fd as u32] = 3;  // connected
    return new_fd;
}

// sys_send: send up to `len` bytes from buf.data on a connected socket.
// Returns the number of bytes sent (n), 22 (-EINVAL) on fd >= 64, 9
// (-EBADF) on unused slot.
//
// K9a STUB: returns `len` (pretend all bytes were sent). The real TCP
// send path is K9b (segment the payload, push to the TCP send buffer,
// hand off to the IP layer). K9a's stub just verifies the fd validation
// logic + the syscall signature (State<SocketTable> + State<NetBuf> +
// u64 len → i64). The K9a self-test does NOT exercise sys_send (the
// contract says "the self-test only checks socket/bind/listen/accept
// states") — but the function must verify (the DoD's "all syscalls
// verify" requirement).
//
//   tbl: the SocketTable.
//   fd:  the socket's file descriptor.
//   buf: the source NetBuf (buf.data[0..len] is the payload — K9b will
//        actually read it; K9a's stub doesn't).
//   len: number of bytes to send (u64 so callers can pass large sizes
//        without overflow — same as K7a's pipe_read/pipe_write `count`
//        param).
//
// State<T> params: 2 (tbl + buf). K9a's stub reads nothing from either
// (just returns len). K9b will read buf.data[0..len] + write to the
// TCP send buffer; K9c will hand the segment to the NIC driver.
fn sys_send(tbl: State<SocketTable>, fd: u32, buf: State<NetBuf>, len: u64) -> i64 {
    if fd >= 64 { return 22; }
    if tbl.used[fd] == 0 { return 9; }
    // K9a stub: pretend all bytes were sent.
    return len as i64;
}

// sys_recv: receive up to `len` bytes from a connected socket into
// buf.data. Returns the number of bytes received (n), 0 on EOF (peer
// closed), 22 (-EINVAL) on fd >= 64, 9 (-EBADF) on unused slot.
//
// K9a STUB: returns 0 (EOF — no data). The real TCP recv path is K9b
// (drain the TCP receive buffer into buf.data, return n bytes read,
// block or return -EAGAIN if the buffer is empty). K9a's stub just
// verifies the fd validation logic + the syscall signature. See
// sys_send's header for the State<T> rationale.
fn sys_recv(tbl: State<SocketTable>, fd: u32, buf: State<NetBuf>, len: u64) -> i64 {
    if fd >= 64 { return 22; }
    if tbl.used[fd] == 0 { return 9; }
    // K9a stub: no data available (EOF — peer closed).
    return 0;
}

// ────────────────────────────────────────────────────────────────────────────
// Self-test (the K9a DoD).
// ────────────────────────────────────────────────────────────────────────────
// Allocate a SocketTable via state_new, init it via sock_init, then:
//   (1) sys_socket(AF_INET=2, SOCK_STREAM=1, 0) → returns 0 (first slot).
//   (2) tbl.count == 1.
//   (3) sys_bind(0, 127.0.0.1=16777343, 8080) → returns 0.
//   (4) tbl.states[0] == 1 (bound).
//   (5) sys_listen(0, 5) → returns 0.
//   (6) tbl.states[0] == 2 (listening).
//   (7) sys_accept(0) → returns a non-negative new_fd (slot 1).
//   (8) tbl.count == 2 (one listening socket + one connected socket).
//   (9) Return 0 (success).
//
// Returns 0 on success, 1..8 on the corresponding check failure (so a
// future CI failure pinpoints the broken check).
//
// ── State-typedness note ────────────────────────────────────────────────────
// Every function call (sys_socket, sys_bind, sys_listen, sys_accept)
// takes tbl as a parameter — so the state-typedness is preserved across
// the calls, and the direct field reads `tbl.count` / `tbl.states[0]`
// work correctly after each call. The `let fd = sys_socket(...);` /
// `let ret = sys_bind(...);` / `let ret2 = sys_listen(...);` /
// `let new_fd = sys_accept(...);` locals are plain i64 values (function
// return values, not State<T> field reads) — no state-typedness concern.
//
// ── Decimal constants ───────────────────────────────────────────────────────
// Per the K9a contract's "Use decimal constants" rule, all non-zero
// constants in the self-test use DECIMAL: 2 = AF_INET, 1 = SOCK_STREAM,
// 0 = IPPROTO_IP, 16777343 = 127.0.0.1 in host-order u32 (see "127.0.0.1
// representation" in the file header), 8080 = bind port, 5 = listen
// backlog, 1/2 = bound/listening states. Decimal avoids the parser's
// hex-literal path (parse_int_radix width-extension subtleties — see
// womb/kernel/arch/x86_64/pt.vuma header for the same rationale).
fn main() -> i32 {
    let tbl = state_new(SocketTable);
    sock_init(tbl);

    // (1-2) Create a socket — sys_socket(AF_INET=2, SOCK_STREAM=1, 0)
    // should return 0 (first slot). tbl.count should be 1.
    let fd = sys_socket(tbl, 2, 1, 0);
    if fd != 0 { return 1; }
    if tbl.count != 1 { return 2; }

    // (3-4) Bind the socket to 127.0.0.1:8080. 127.0.0.1 in host-order
    // u32 = 16777343 (see "127.0.0.1 representation" in the file header).
    // sys_bind should return 0 and flip tbl.states[0] to 1 (bound).
    let ret = sys_bind(tbl, 0, 16777343, 8080);
    if ret != 0 { return 3; }
    if tbl.states[0] != 1 { return 4; }  // bound

    // (5-6) Listen with backlog=5. sys_listen should return 0 and flip
    // tbl.states[0] to 2 (listening).
    let ret2 = sys_listen(tbl, 0, 5);
    if ret2 != 0 { return 5; }
    if tbl.states[0] != 2 { return 6; }  // listening

    // (7-8) Accept a connection (K9a stub — creates a new socket at
    // slot 1). sys_accept should return a non-negative new_fd (1) and
    // tbl.count should be 2 (one listening + one connected).
    let new_fd = sys_accept(tbl, 0);
    if new_fd < 0 { return 7; }
    if tbl.count != 2 { return 8; }

    // (9) Return 0 (success).
    return 0;
}
