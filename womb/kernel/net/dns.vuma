// ═══════════════════════════════════════════════════════════════════════════
// womb/kernel/net/dns.vuma
// VWK Network Subsystem — DNS resolver (PMT-pure, simplified).
// ═══════════════════════════════════════════════════════════════════════════
//
// This file is the K9e layer of the VWK kernel: a simplified PMT-native DNS
// resolver. K9 (Network) built socket (K9a — BSD API surface), sk_buff +
// virtio-net (K9b+c — packet buffer pool + NIC driver), and TCP state
// machine (K9d — handshake + send/recv + close). K9e sits ABOVE the UDP
// transport (which rides on K9b's sk_buff pool + K9c's NIC driver): it
// builds DNS query packets and (in hosted mode) stubs the actual UDP
// send/recv — there is no real DNS server reachable from the hosted
// compile_dump runtime. The K9e contract scope is "build a DNS query
// correctly + parse the response (stub: returns 0)"; the real UDP + DNS
// network path is K9g+ (when the IP layer lands and routes UDP port 53
// to a configured resolver).
//
// ── Scope of K9e ───────────────────────────────────────────────────────────
//   dns_build_query(query, name, id)              — encode a DNS A-record
//                                                   query packet into
//                                                   DnsQuery.data[0..len].
//                                                   Header (12 bytes:
//                                                   id/flags/qdcount=1/
//                                                   ancount/nscount/
//                                                   arcount=0) + encoded
//                                                   domain name
//                                                   ("\x07example\x03com\x00")
//                                                   + type A (1) + class IN
//                                                   (1) trailer.
//   dns_parse_response(buf) -> u32                — parse a DNS response,
//                                                   extract the first A
//                                                   record's IPv4 address
//                                                   (host-order u32). K9e
//                                                   STUB: returns 0 (the
//                                                   hosted runtime has no
//                                                   DNS server, so the
//                                                   response buffer is
//                                                   always empty).
//   dns_resolve(name) -> u32                      — top-level resolver:
//                                                   build a query, send it,
//                                                   parse the response.
//                                                   K9e STUB: returns 0
//                                                   (lookup failed).
//
// ── DNS packet format (RFC 1035, §4.1) ──────────────────────────────────────
//   Header (12 bytes, big-endian / network order):
//     id       u16  — transaction ID (caller-supplied — 1234 in the
//                    self-test).
//     flags    u16  — bit 15 = QR (0=query, 1=response), bit 11 = RD
//                    (recursion desired). K9e sets flags = 0x0100
//                    (standard query, RD=1).
//     qdcount  u16  — number of questions (1).
//     ancount  u16  — number of answers (0 in the query).
//     nscount  u16  — number of authority records (0).
//     arcount  u16  — number of additional records (0).
//   Question section:
//     QNAME    var  — domain name encoded as a sequence of "length-prefixed
//                    labels": "example.com" →
//                    "\x07example\x03com\x00" (7+'example', 3+'com', 0
//                    terminator).
//     QTYPE    u16  — query type (1 = A, host-to-network byte order, but
//                    K9e stores the high byte first: data[pos]=0,
//                    data[pos+1]=1).
//     QCLASS   u16  — query class (1 = IN).
//
// ── Decimal-constants discipline ────────────────────────────────────────────
// All non-zero constants use DECIMAL per the K9e contract's "Use decimal
// ASCII values throughout. VUMA doesn't support string literals in code"
// rule. The byte values used (decimal):
//     46  = '.' (label separator)
//     0   = null (name terminator + arcount/nscount/ancount high bytes)
//     1   = qdcount low byte + type-A low byte + class-IN low byte
//     2   = flags high byte 0x0100 high half (NOT — K9e uses 1 here, the
//           low byte of "0x0100 recursion desired" is 0, the high byte is
//           1). See dns_build_query header bytes 2/3 below.
//     3   = flags low byte? No — flags=0x0100 means high byte=1, low byte=0.
//     7   = "example" label length
//     101 = 'e', 120='x', 97='a', 109='m', 112='p', 108='l', 101='e'
//     99  = 'c', 111='o', 109='m'
//     1234 = self-test transaction ID (id=1234: 1234>>8=4,
//            1234&255=210 — verified by the self-test).
//     64  = DnsName/DnsQuery buffer size.
//
// ── Why no string literals? ─────────────────────────────────────────────────
// VUMA's parser does not accept string literals in expression position
// (only as comments + layout-name identifiers). The K9e contract's
// "use decimal byte values" rule replaces `let s = "example";` with
// `name.data[0] = 101; name.data[1] = 120; ...`. Same convention as
// K6f's shell.vuma (which uses an extern `write` + a `ShellOut` layout
// filled byte-by-byte) + K5d's initramfs.vuma (byte-wise cpio header
// field writes).
//
// ── Why is DnsHeader a layout but never used? ───────────────────────────────
// The DnsHeader layout (6 × u16 = 12 bytes) is the canonical reference
// for the DNS wire format. K9e does NOT instantiate it: the query
// builder writes the 12 header bytes directly into DnsQuery.data[0..12]
// (byte-wise, because VUMA's codegen does not support struct-array
// overlays + the byte-wise path is simpler than a 6-field struct-of-u16
// pack). The layout exists for IVE verification + as the canonical
// field-name/field-type reference for K9g+ (when the IP layer lands +
// the resolver parses real responses, DnsHeader will be the
// documentation structure for the response-parsing path, mirroring
// K9a's Socket layout vs SocketTable operational split).
//
// ── PMT discipline ─────────────────────────────────────────────────────────
// NO `*ptr`, `&x`, `allocate`, or `free` anywhere in this file. The
// DnsQuery + DnsName buffers are flat-byte-array structs held in
// `___pmt_buffer`-backed State<T> values; the CALLER allocates them
// via `state_new(DnsQuery)` / `state_new(DnsName)` and passes them by
// reference to dns_build_query / dns_parse_response / dns_resolve
// (init-style API — see "Why init-style?" in K4e's wait.vuma header for
// the codegen rationale: the current codegen does NOT propagate State-
// typedness through function return values, so `fn dns_new() ->
// State<DnsQuery>` would produce broken field-access code in callers).
//
// State<T> params: 1-2 per function (query/name or just name or just buf),
// per the K4b contract's "1-2 per function" rule. The single-state-param
// pattern is the same as K9a's sys_socket / K8e's ipi_send.
//
// Externs (write, read): declared per the K9e contract for parity with
// K6f's shell.vuma + K6a's uart.vuma. In hosted mode they are
// __ffi_fallback_stubs (no-op — the compile_dump runtime has no real
// fd/socket layer). The real UDP-socket send/recv path (replacing these
// externs with K9a's sys_send / sys_recv on a UDP socket bound to port
// 53) is K9g+.
//
// ── VUMA has no `import` ────────────────────────────────────────────────────
// This file is self-contained. It declares DnsHeader + DnsQuery + DnsName
// + the 3 resolver functions + main. K9g+ (IP layer + UDP transport)
// will re-declare DnsQuery byte-identically when it needs to read/write
// the packet bytes for real DNS round-trips. The byte-identical-
// redeclaration invariant (K2c "extern signatures MUST stay byte-
// identical" — extended to layouts in K3d, re-applied in K4a/K7a/K8a/
// K8e/K8f/K9a/K9d) extends to K9e's DnsHeader + DnsQuery + DnsName.
//
// ── Build & verify (hosted x86_64) ──────────────────────────────────────────
//     . "$HOME/.cargo/env" && CARGO_BUILD_JOBS=4 \
//         cargo build --profile release-fast --bin compile_dump
//     ./target/release-fast/compile_dump \
//         womb/kernel/net/dns.vuma \
//         /tmp/dns.bin x86_64 --verify
//     /tmp/dns.bin ; echo "exit=$?"
// Expected: IVE Pass, exit=0 (all 7 self-test checks pass — header bytes
// id/flags/qdcount correct + label lengths + label bytes correct).

// ────────────────────────────────────────────────────────────────────────────
// Extern declarations.
// ────────────────────────────────────────────────────────────────────────────
// W47: the UDP transport externs (socket / sendto / recv / close) are now
// declared + called by dns_resolve. In hosted mode these resolve to real
// Linux x86_64 syscalls (sys_socket=41, sys_sendto=44, sys_recv=45,
// sys_close=3 — see src/codegen/src/x86_64/mod.rs::build_runtime_syscall_stubs).
// The legacy write + read externs are retained for parity with K6f's
// shell.vuma + K6a's uart.vuma (K9e's self-test does not call them, but
// the declaration documents the K9e→K6 I/O surface for K9g+ callers).
//
// `buf: Address` / `addr: Address` (NOT State<T>) means the marshal pass
// does NOT invalidate any state on the call — the Address is a raw u64
// pointer handed to the syscall. This is the documented PMT "Borrowed
// read" pattern (same as K6f's `out as Address` in shell_putc). For recv
// (which WRITES through the Address), the writes land directly in
// ___pmt_buffer and are visible to subsequent `resp.data[i]` reads —
// same pattern as shell.vuma's `read(fd, in_buf as Address, 256)`
// followed by `in_buf.data[j]`.
extern "C" {
    fn write(fd: i64, buf: Address, count: i64) -> i64;
    fn read(fd: i64, buf: Address, count: i64) -> i64;
    fn socket(domain: i32, sock_type: i32, protocol: i32) -> i32;
    fn sendto(fd: i32, buf: Address, len: i64, flags: i32, addr: Address, addrlen: u32) -> i64;
    fn recv(fd: i32, buf: Address, len: i64, flags: i32) -> i64;
    fn close(fd: i32) -> i32;
}

// ────────────────────────────────────────────────────────────────────────────
// Layouts.
// ────────────────────────────────────────────────────────────────────────────

// DnsHeader: 12-byte DNS header (RFC 1035 §4.1.1). All fields big-endian
// on the wire. Stored as a layout for IVE verification + documentation
// (the operational query builder writes the header byte-wise into
// DnsQuery.data[0..12] — see "Why is DnsHeader a layout but never used?"
// in the file header). 6 fields × u16 = 12 bytes total.
layout DnsHeader = {
    id: u16,        // transaction ID
    flags: u16,     // query/response flags
    qdcount: u16,   // number of questions
    ancount: u16,   // number of answers
    nscount: u16,   // number of authority records
    arcount: u16,   // number of additional records
}

// DnsName: a 64-byte buffer holding a null-terminated ASCII domain name
// (e.g. "example.com\0"). 64 bytes is enough for the DNS 253-octet max
// name length's common-case single-label + TLD (the K9e self-test uses
// "example.com" = 11 chars + 1 null). The K9e contract caps at 64 for
// the simplified PMT-native scope; K9g+ may bump to 256 (DNS max) when
// real resolvers land.
layout DnsName = {
    data: [u8; 64],  // null-terminated ASCII domain name
}

// DnsQuery: a 64-byte buffer holding the raw DNS query packet (header +
// encoded name + type/class trailer). 64 bytes is enough for the
// self-test's "example.com" query (12-byte header + 13-byte encoded
// name "\x07example\x03com\x00" + 4-byte type/class trailer = 29 bytes).
// K9g+ may bump to 512 (DNS UDP max packet size) when real resolvers
// land. `len` records the actual packet size (0..64).
layout DnsQuery = {
    data: [u8; 64],  // raw DNS query packet
    len: u32,        // packet length in bytes (0..64)
}

// SockAddrIn: 16-byte IPv4 socket address (struct sockaddr_in, RFC 3493).
// Used by dns_resolve (W47) to pass the DNS server address (8.8.8.8:53)
// to the sendto syscall. The `data` byte array is at offset 0 so
// `addr as Address` yields the address of the sockaddr_in struct (same
// "data at offset 0" convention as DnsQuery / DnsName).
// Byte layout (Linux sockaddr_in, AF_INET=2):
//   [0..2]   sin_family  (u16, host byte order — AF_INET=2, LE bytes [2,0])
//   [2..4]   sin_port    (u16, network byte order — htons(53)=[0,53])
//   [4..8]   sin_addr    (u32, network byte order — 8.8.8.8=[8,8,8,8])
//   [8..16]  sin_zero    (8 bytes padding, zeroed)
// The byte-array representation avoids any u16/u32 endianness ambiguity
// (fields are written byte-by-byte, same convention as DnsHeader's
// wire-format bytes in dns_build_query).
layout SockAddrIn = {
    data: [u8; 16],  // raw sockaddr_in (16 bytes)
}

// ────────────────────────────────────────────────────────────────────────────
// Resolver functions.
// ────────────────────────────────────────────────────────────────────────────

// dns_build_query: encode a DNS A-record query for `name` into `query`.
//
//   query: caller-allocated State<DnsQuery> (output buffer).
//   name:  caller-allocated State<DnsName> holding the null-terminated
//          ASCII domain name (e.g. "example.com\0").
//   id:    transaction ID (caller-supplied — typically a u16 counter or
//          a random value; 1234 in the self-test).
//
// Wire format produced (29 bytes for "example.com"):
//   [0..12]  Header: id (big-endian), flags=0x0100 (RD=1), qdcount=1,
//            ancount=0, nscount=0, arcount=0.
//   [12..]   QNAME: "\x07example\x03com\x00" (length-prefixed labels).
//   [tail]   QTYPE=1 (A), QCLASS=1 (IN), each as 2 big-endian bytes.
//
// Sets query.len to the total packet length. No return value (the
// caller checks query.len + query.data[] after the call).
fn dns_build_query(query: State<DnsQuery>, name: State<DnsName>, id: u16) {
    // Header: ID, flags=0x0100 (standard query, recursion desired),
    // qdcount=1, ancount=0, nscount=0, arcount=0.
    query.data[0] = (id >> 8) as u8;
    query.data[1] = (id & 255) as u8;
    query.data[2] = 1;  // flags high: standard query (RD=1)
    query.data[3] = 0;  // flags low
    query.data[4] = 0; query.data[5] = 1;  // qdcount=1
    query.data[6] = 0; query.data[7] = 0;  // ancount=0
    query.data[8] = 0; query.data[9] = 0;  // nscount=0
    query.data[10] = 0; query.data[11] = 0;  // arcount=0
    // Encode domain name: "example.com" → "\x07example\x03com\x00".
    // Each label is prefixed by its 1-byte length; the name ends with a
    // single 0 byte. The '.' separator in the input is NOT emitted —
    // it just signals "end of label, emit length prefix for next label".
    let pos = 12;
    let label_start = 0;
    let i = 0;
    while i < 64 {
        let c = name.data[i];
        if c == 0 || c == 46 {  // null or '.'
            let label_len = i - label_start;
            if label_len > 0 {
                query.data[pos] = label_len as u8;
                pos = pos + 1;
                let j = label_start;
                while j < i {
                    query.data[pos] = name.data[j];
                    pos = pos + 1;
                    j = j + 1;
                }
            }
            label_start = i + 1;
            if c == 0 { break; }
        }
        i = i + 1;
    }
    // Terminator (the trailing 0 byte after the last label).
    query.data[pos] = 0;
    pos = pos + 1;
    // Type A (1) + Class IN (1), each as 2 big-endian bytes.
    query.data[pos] = 0; query.data[pos + 1] = 1;  // type A
    query.data[pos + 2] = 0; query.data[pos + 3] = 1;  // class IN
    pos = pos + 4;
    query.len = pos;
}

// dns_parse_response: parse a DNS response and extract the first A
// record's IPv4 address.
//
//   buf: caller-allocated State<DnsQuery> holding the raw response
//        packet (re-uses the DnsQuery layout — same byte-array shape).
//        buf.len must be set to the actual response byte count by the
//        caller (dns_resolve sets it from the recv return value).
//
// Returns the IPv4 address as a host-order u32, or 0 on failure.
//
// W47: real parser (replaces the K9e stub). Walks the DNS wire format:
//   1. Validate buf.len >= 12 (header size).
//   2. Check the QR bit (buf.data[2] >= 128 — high bit of flags high byte).
//   3. Read ANCOUNT (bytes 6-7, big-endian); must be > 0.
//   4. Skip the question section: scan QNAME labels (each length-prefixed)
//      until a 0 terminator, then skip QTYPE (2) + QCLASS (2) + the 0
//      terminator = 5 bytes past the last label.
//   5. Skip the answer NAME (either a 2-byte compression pointer
//      [first byte >= 192] or a full label sequence ending with 0).
//   6. Read TYPE (2 bytes), skip CLASS (2) + TTL (4), read RDLENGTH (2).
//   7. If TYPE==1 (A) and RDLENGTH==4, extract the 4-byte RDATA as a
//      host-order u32 (big-endian → host: byte0*16777216 + byte1*65536 +
//      byte2*256 + byte3).
//
// All multi-byte fields are big-endian (network byte order) per RFC 1035.
// Decimal multipliers (no hex literals) per the K9e decimal-constants rule.
fn dns_parse_response(buf: State<DnsQuery>) -> u32 {
    // (1) Need at least 12 bytes for the DNS header.
    if buf.len < 12 { return 0; }

    // (2) Check QR bit: high bit of flags high byte (buf.data[2]).
    // QR=1 means response. buf.data[2] >= 128 (0x80) checks the high bit.
    if buf.data[2] < 128 { return 0; }

    // (3) Read ANCOUNT (bytes 6-7, big-endian). Must be > 0.
    let ancount = (buf.data[6] as u32) * 256 + (buf.data[7] as u32);
    if ancount == 0 { return 0; }

    // (4) Skip the question section: scan QNAME labels until 0 terminator.
    let pos = 12;
    while (pos as u32) < buf.len {
        let lab = buf.data[pos];
        if lab == 0 { break; }
        // Compression pointers (>= 192) should not appear in the question,
        // but guard against malformed responses.
        if (lab as u32) >= 192 { break; }
        pos = pos + (lab as i32) + 1;
    }
    // Skip the 0 terminator + QTYPE (2) + QCLASS (2) = 5 bytes.
    let pos = pos + 5;

    // (5) Skip the answer NAME.
    if (pos as u32) >= buf.len { return 0; }
    let first = buf.data[pos];
    if (first as u32) >= 192 {
        // Compression pointer: 2 bytes (0xC0 + offset).
        pos = pos + 2;
    } else {
        // Full name: scan labels until 0 terminator.
        let p = pos;
        while (p as u32) < buf.len {
            let lab = buf.data[p];
            if lab == 0 { p = p + 1; break; }
            p = p + (lab as i32) + 1;
        }
        pos = p;
    }

    // (6) Read TYPE (2 bytes big-endian), skip CLASS (2) + TTL (4),
    //     read RDLENGTH (2 bytes big-endian).
    if (pos as u32) + 2 > buf.len { return 0; }
    let rtype = (buf.data[pos] as u32) * 256 + (buf.data[pos + 1] as u32);
    let pos = pos + 2;   // past TYPE
    let pos = pos + 2;   // past CLASS
    let pos = pos + 4;   // past TTL
    if (pos as u32) + 2 > buf.len { return 0; }
    let rdlen = (buf.data[pos] as u32) * 256 + (buf.data[pos + 1] as u32);
    let pos = pos + 2;   // past RDLENGTH

    // (7) If TYPE=1 (A record) and RDLENGTH=4, extract the IPv4 address.
    if rtype == 1 && rdlen == 4 {
        if (pos as u32) + 4 > buf.len { return 0; }
        let addr = (buf.data[pos] as u32) * 16777216
                 + (buf.data[pos + 1] as u32) * 65536
                 + (buf.data[pos + 2] as u32) * 256
                 + (buf.data[pos + 3] as u32);
        return addr;
    }

    return 0;
}

// dns_resolve: resolve a domain name to an IPv4 address.
//
//   name: caller-allocated State<DnsName> holding the null-terminated
//         ASCII domain name to resolve.
//
// Returns the IPv4 address as a host-order u32, or 0 on failure.
//
// W47: real UDP round-trip (replaces the K9e stub). Steps:
//   1. Build the DNS A-record query via dns_build_query (id=1234).
//   2. Guard: if name is empty (name.data[0]==0), return 0 immediately
//      (no query to send — avoids a malformed packet + a wasted syscall).
//   3. Build a sockaddr_in for 8.8.8.8:53 (Google Public DNS).
//   4. Create a UDP socket: socket(AF_INET=2, SOCK_DGRAM=2, 0).
//   5. Send the query: sendto(fd, query, query.len, 0, &dst, 16).
//   6. Receive the response: recv(fd, resp, 64, 0).
//   7. Close the socket.
//   8. Parse the response via dns_parse_response + return the IPv4 addr.
//
// In hosted mode (compile_dump on Linux x86_64), the socket/sendto/recv/
// close externs resolve to real syscalls — so dns_resolve actually sends
// a UDP packet to 8.8.8.8:53 and parses the real response. If the network
// is unreachable, sendto/recv return negative errno and dns_resolve
// returns 0 (lookup failed). The K9e self-test does NOT call dns_resolve
// (it only tests dns_build_query), so the self-test is unaffected by
// network availability.
fn dns_resolve(name: State<DnsName>) -> u32 {
    let query = state_new(DnsQuery);
    dns_build_query(query, name, 1234);

    // Guard: empty name → skip the network call, return 0.
    if name.data[0] == 0 { return 0; }

    // Build sockaddr_in for 8.8.8.8:53 (Google Public DNS).
    // sin_family = AF_INET (2), host byte order on LE: [2, 0].
    // sin_port = htons(53) = 0x0035, network byte order: [0, 53].
    // sin_addr = 8.8.8.8 = 0x08080808, network byte order: [8, 8, 8, 8].
    // sin_zero = 8 zero bytes (mmap-backed state_new zeroes the buffer,
    // but we zero explicitly for documentation + defensive correctness).
    let dst = state_new(SockAddrIn);
    dst.data[0] = 2;    // AF_INET (host byte order, low byte)
    dst.data[1] = 0;    // AF_INET (host byte order, high byte)
    dst.data[2] = 0;    // sin_port high byte (network order: 53 = 0x0035)
    dst.data[3] = 53;   // sin_port low byte
    dst.data[4] = 8;    // sin_addr byte 0 (8.8.8.8, network order)
    dst.data[5] = 8;    // sin_addr byte 1
    dst.data[6] = 8;    // sin_addr byte 2
    dst.data[7] = 8;    // sin_addr byte 3
    dst.data[8] = 0; dst.data[9] = 0; dst.data[10] = 0; dst.data[11] = 0;
    dst.data[12] = 0; dst.data[13] = 0; dst.data[14] = 0; dst.data[15] = 0;

    // Create a UDP socket: socket(AF_INET=2, SOCK_DGRAM=2, 0).
    // Protocol 0 = default (UDP for SOCK_DGRAM). Returns fd >= 0 on
    // success, negative errno on failure.
    let fd = socket(2, 2, 0);
    if fd < 0 { return 0; }

    // Send the DNS query via UDP. sendto(fd, query, query.len, flags=0,
    // &dst, addrlen=16). Returns bytes sent (>= 0) or negative errno.
    let sent = sendto(fd, query as Address, query.len as i64, 0, dst as Address, 16);
    if sent < 0 { close(fd); return 0; }

    // Receive the DNS response. recv(fd, resp, 64, flags=0). Returns bytes
    // received (>= 0) or negative errno. 64 = DnsQuery.data buffer size.
    let resp = state_new(DnsQuery);
    let n = recv(fd, resp as Address, 64, 0);
    close(fd);
    if n <= 0 { return 0; }

    // Parse the response + return the first A record's IPv4 address.
    resp.len = n as u32;
    return dns_parse_response(resp);
}

// ────────────────────────────────────────────────────────────────────────────
// Self-test (main).
// ────────────────────────────────────────────────────────────────────────────
// Exercises the query-builder path: build a DNS A-record query for
// "example.com" with id=1234, then verify the header (id bytes, qdcount)
// + the encoded domain name (label lengths + label bytes). Returns 0 on
// success, 1..7 on the 7 individual check failures.
fn main() -> i32 {
    // Self-test: build a DNS query for "example.com".
    let name = state_new(DnsName);
    name.data[0] = 101;  // 'e'
    name.data[1] = 120;  // 'x'
    name.data[2] = 97;   // 'a'
    name.data[3] = 109;  // 'm'
    name.data[4] = 112;  // 'p'
    name.data[5] = 108;  // 'l'
    name.data[6] = 101;  // 'e'
    name.data[7] = 46;   // '.'
    name.data[8] = 99;   // 'c'
    name.data[9] = 111;  // 'o'
    name.data[10] = 109; // 'm'
    name.data[11] = 0;   // null
    let query = state_new(DnsQuery);
    dns_build_query(query, name, 1234);
    // Verify the header.
    if query.data[0] != 4 { return 1; }  // 1234 >> 8 = 4
    if query.data[1] != 210 { return 2; }  // 1234 & 255 = 210
    if query.data[5] != 1 { return 3; }  // qdcount=1
    // Verify the domain name encoding.
    // "example.com" → \x07example\x03com\x00
    if query.data[12] != 7 { return 4; }  // label length 7
    if query.data[13] != 101 { return 5; }  // 'e'
    if query.data[20] != 3 { return 6; }  // label length 3
    if query.data[21] != 99 { return 7; }  // 'c'
    return 0;
}
