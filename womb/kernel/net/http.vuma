// ═══════════════════════════════════════════════════════════════════════════
// womb/kernel/net/http.vuma
// VWK Network Subsystem — HTTP client (PMT-pure, simplified).
// ═══════════════════════════════════════════════════════════════════════════
//
// This file is the K9f layer of the VWK kernel: a simplified PMT-native
// HTTP/1.0 client. K9 (Network) built socket (K9a — BSD API surface),
// sk_buff + virtio-net (K9b+c — packet buffer pool + NIC driver), TCP
// state machine (K9d — handshake + send/recv + close), and DNS resolver
// (K9e — query builder + response parser stub). K9f sits ABOVE the TCP
// transport (which rides on K9d's state machine + K9b's sk_buff pool +
// K9c's NIC driver): it builds HTTP/1.0 GET requests and (in hosted
// mode) stubs the actual TCP send/recv — there is no real TCP
// connection reachable from the hosted compile_dump runtime. The K9f
// contract scope is "build a GET request correctly + return a stub
// response"; the real HTTP round-trip path is K9g+ (when the IP layer
// lands + DNS resolves + TCP connects to a real HTTP server).
//
// ── Scope of K9f ───────────────────────────────────────────────────────────
//   http_build_get(req, path, host)               — encode an HTTP/1.0
//                                                   GET request into
//                                                   HttpRequest.data
//                                                   [0..len]. Format:
//                                                   "GET <path>
//                                                   HTTP/1.0\r\n
//                                                   Host: <host>\r\n\r\n".
//   http_get(host, port, path, resp) -> i64       — top-level client:
//                                                   build a GET request,
//                                                   open a TCP connection,
//                                                   send the request,
//                                                   receive the response.
//                                                   K9f STUB: returns 0
//                                                   (no real TCP
//                                                   connection — resp.len
//                                                   is set to 0).
//
// ── HTTP/1.0 request format (RFC 1945, §5) ──────────────────────────────────
//   Request-line:    "GET <request-uri> HTTP/1.0\r\n"
//   Headers:         "Host: <host>\r\n"
//   Blank line:      "\r\n"
//
//   For path="/" + host="10.0.2.2" the wire bytes are (decimal):
//     71 69 84 32     // "GET "  (G=71, E=69, T=84, space=32)
//     47              // "/"     (path)
//     32 72 84 84 80 47 49 46 48 13 10   // " HTTP/1.0\r\n"
//     72 111 115 116 58 32               // "Host: "
//     49 48 46 48 46 50 46 50            // "10.0.2.2"
//     13 10 13 10                          // "\r\n\r\n"
//   Total: 31 bytes. The K9f self-test verifies the GET prefix + the
//   trailing \r\n\r\n.
//
// ── Decimal-constants discipline ────────────────────────────────────────────
// All non-zero constants use DECIMAL per the K9f contract's "Use decimal
// ASCII values throughout. VUMA doesn't support string literals in code"
// rule. The byte values used (decimal):
//     71  = 'G'  (GET method)
//     69  = 'E'
//     84  = 'T'
//     32  = ' ' (space — between GET + path, after path, after "Host:")
//     47  = '/' (path)
//     72  = 'H'  (HTTP + Host header name)
//     111 = 'o'
//     115 = 's'
//     116 = 't'
//     58  = ':' (after Host)
//     80  = 'P'  (HTTP protocol)
//     49  = '1'  (HTTP/1.0)
//     46  = '.'  (HTTP/1.0)
//     48  = '0'  (HTTP/1.0)
//     13  = '\r' (CR)
//     10  = '\n' (LF)
//     256 = HttpRequest buffer size (path + headers + body line)
//     512 = HttpResponse buffer size (response-line + headers + body)
//     64  = HttpPath + HttpHost buffer size
//     80  = self-test HTTP port
//
// ── Why no string literals? ─────────────────────────────────────────────────
// VUMA's parser does not accept string literals in expression position
// (only as comments + layout-name identifiers). The K9f contract's
// "use decimal byte values" rule replaces `let s = "GET ";` with
// `req.data[0] = 71; req.data[1] = 69; req.data[2] = 84; req.data[3] =
// 32;`. Same convention as K6f's shell.vuma (which uses an extern
// `write` + a `ShellOut` layout filled byte-by-byte) + K9e's dns.vuma
// (byte-wise DNS header + name encoding).
//
// ── Why is the request-line built byte-by-byte rather than via a helper? ────
// HTTP requests are short (a few hundred bytes) + the wire format is
// rigid (exact byte sequence, no length-prefixing). A byte-by-byte emit
// loop is the simplest correct implementation — same approach as K6f's
// shell_prompt (5-byte "vwk: " prefix written byte-by-byte into
// ShellOut.data) + K6e's console subsystem. K9g+ may add a
// http_emit_string helper (a (req, str_addr, len) → () function that
// memcpy's a fixed byte buffer) when more headers land (User-Agent,
// Accept, Connection: close). For K9f's GET-only scope, the explicit
// byte emits are clearer than a helper.
//
// ── PMT discipline ─────────────────────────────────────────────────────────
// NO `*ptr`, `&x`, `allocate`, or `free` anywhere in this file. The
// HttpRequest + HttpResponse + HttpPath + HttpHost buffers are
// flat-byte-array structs held in `___pmt_buffer`-backed State<T>
// values; the CALLER allocates them via `state_new(HttpRequest)` etc.
// and passes them by reference to http_build_get / http_get (init-style
// API — see "Why init-style?" in K4e's wait.vuma header for the codegen
// rationale: the current codegen does NOT propagate State-typedness
// through function return values).
//
// State<T> params: 2-4 per function (req+path+host or
// host+path+resp), per the K4b contract's "1-2 per function" rule
// (relaxed to "1-4" for net-stack functions that necessarily take both
// request + response buffers — same convention as K9a's sys_send
// (tbl+fd+buf+len)). The caller owns all buffers.
//
// Extern (write): declared per the K9f contract for parity with K6f's
// shell.vuma + K9e's dns.vuma. In hosted mode it is a
// __ffi_fallback_stub (no-op). The real TCP-socket send path (replacing
// this extern with K9a's sys_send on a TCP socket that went through
// K9d's tcp_connect → tcp_ack handshake) is K9g+.
//
// ── VUMA has no `import` ────────────────────────────────────────────────────
// This file is self-contained. It declares HttpRequest + HttpResponse +
// HttpPath + HttpHost + the 2 client functions + main. K9g+ (IP layer +
// TCP transport) will re-declare HttpRequest byte-identically when it
// needs to read the request bytes for real HTTP round-trips. The
// byte-identical-redeclaration invariant (K2c "extern signatures MUST
// stay byte-identical" — extended to layouts in K3d, re-applied in
// K4a/K7a/K8a/K8e/K8f/K9a/K9d/K9e) extends to K9f's HttpRequest +
// HttpResponse + HttpPath + HttpHost.
//
// ── Build & verify (hosted x86_64) ──────────────────────────────────────────
//     . "$HOME/.cargo/env" && CARGO_BUILD_JOBS=4 \
//         cargo build --profile release-fast --bin compile_dump
//     ./target/release-fast/compile_dump \
//         womb/kernel/net/http.vuma \
//         /tmp/http.bin x86_64 --verify
//     /tmp/http.bin ; echo "exit=$?"
// Expected: IVE Pass, exit=0 (all 10 self-test checks pass — GET prefix
// correct + path '/' present + trailing \r\n\r\n correct + http_get
// stub returns 0).

// ────────────────────────────────────────────────────────────────────────────
// Extern declarations.
// ────────────────────────────────────────────────────────────────────────────
// W47: the TCP transport externs (socket / connect / send / recv / close)
// are now declared + called by http_get. In hosted mode these resolve to
// real Linux x86_64 syscalls (sys_socket=41, sys_connect=42, sys_send=44,
// sys_recv=45, sys_close=3 — see
// src/codegen/src/x86_64/mod.rs::build_runtime_syscall_stubs). The legacy
// write extern is retained for parity with K6f's shell.vuma + K9e's
// dns.vuma (K9f's self-test does not call it, but the declaration
// documents the K9f→K6 I/O surface for K9g+ callers).
//
// `buf: Address` / `addr: Address` (NOT State<T>) means the marshal pass
// does NOT invalidate any state on the call — the Address is a raw u64
// pointer handed to the syscall. This is the documented PMT "Borrowed
// read" pattern. For recv (which WRITES through the Address), the writes
// land directly in ___pmt_buffer and are visible to subsequent
// `resp.data[i]` reads — same pattern as shell.vuma's
// `read(fd, in_buf as Address, 256)` followed by `in_buf.data[j]`.
extern "C" {
    fn write(fd: i64, buf: Address, count: i64) -> i64;
    fn socket(domain: i32, sock_type: i32, protocol: i32) -> i32;
    fn connect(fd: i32, addr: Address, len: u32) -> i32;
    fn send(fd: i32, buf: Address, len: i64, flags: i32) -> i64;
    fn recv(fd: i32, buf: Address, len: i64, flags: i32) -> i64;
    fn close(fd: i32) -> i32;
}

// ────────────────────────────────────────────────────────────────────────────
// Layouts.
// ────────────────────────────────────────────────────────────────────────────

// HttpRequest: a 256-byte buffer holding the raw HTTP/1.0 GET request
// (request-line + Host header + blank line). 256 bytes is enough for
// the typical GET request (path up to ~200 chars + short host + the
// ~25-byte request-line/header overhead). `len` records the actual
// request size (0..256).
layout HttpRequest = {
    data: [u8; 256],  // raw HTTP request
    len: u32,         // request length in bytes (0..256)
}

// HttpResponse: a 512-byte buffer holding the raw HTTP/1.0 response
// (status-line + headers + body). 512 bytes is the simplified PMT-native
// scope cap; K9g+ may bump to 4096 (a typical Linux page) when real
// responses land. `len` records the actual response size (0..512).
layout HttpResponse = {
    data: [u8; 512],  // raw HTTP response
    len: u32,         // response length in bytes (0..512)
}

// HttpPath: a 64-byte buffer holding the null-terminated ASCII request
// URI (e.g. "/\0" for the root, "/index.html\0" for a sub-path). 64
// bytes is the simplified scope cap; K9g+ may bump to 256 (typical URL
// length limit) when real requests land.
layout HttpPath = {
    data: [u8; 64],
}

// HttpHost: a 64-byte buffer holding the null-terminated ASCII Host
// header value (e.g. "10.0.2.2\0" or "example.com\0"). 64 bytes is
// enough for any hostname or IPv4 dotted-quad.
layout HttpHost = {
    data: [u8; 64],
}

// SockAddrIn: 16-byte IPv4 socket address (struct sockaddr_in, RFC 3493).
// Used by http_get (W47) to pass the server address to connect. The
// `data` byte array is at offset 0 so `addr as Address` yields the
// address of the sockaddr_in struct (same "data at offset 0" convention
// as HttpRequest / HttpResponse / HttpPath / HttpHost).
// Byte layout (Linux sockaddr_in, AF_INET=2):
//   [0..2]   sin_family  (u16, host byte order — AF_INET=2, LE bytes [2,0])
//   [2..4]   sin_port    (u16, network byte order — htons(80)=[0,80])
//   [4..8]   sin_addr    (u32, network byte order — parsed from host str)
//   [8..16]  sin_zero    (8 bytes padding, zeroed)
// The byte-array representation avoids any u16/u32 endianness ambiguity
// (fields are written byte-by-byte, same convention as K9e's DnsHeader
// wire-format bytes).
layout SockAddrIn = {
    data: [u8; 16],  // raw sockaddr_in (16 bytes)
}

// ────────────────────────────────────────────────────────────────────────────
// HTTP client functions.
// ────────────────────────────────────────────────────────────────────────────

// http_build_get: encode an HTTP/1.0 GET request into `req`.
//
//   req:  caller-allocated State<HttpRequest> (output buffer).
//   path: caller-allocated State<HttpPath> holding the null-terminated
//         request URI (e.g. "/\0").
//   host: caller-allocated State<HttpHost> holding the null-terminated
//         Host header value (e.g. "10.0.2.2\0").
//
// Wire format produced:
//   "GET <path> HTTP/1.0\r\nHost: <host>\r\n\r\n"
//
// All bytes are emitted decimal-ASCII-byte-by-byte (VUMA has no string
// literals — see "Why no string literals?" in the file header). Sets
// req.len to the total request length.
fn http_build_get(req: State<HttpRequest>, path: State<HttpPath>, host: State<HttpHost>) {
    let pos = 0;
    // "GET " — G=71, E=69, T=84, space=32.
    req.data[0] = 71; req.data[1] = 69; req.data[2] = 84; req.data[3] = 32;
    pos = 4;
    // Path (null-terminated ASCII, copied verbatim).
    let i = 0;
    while i < 64 {
        let c = path.data[i];
        if c == 0 { break; }
        req.data[pos] = c;
        pos = pos + 1;
        i = i + 1;
    }
    // " HTTP/1.0\r\nHost: " — emit byte-by-byte (no string literals in
    // VUMA). The leading space (32) terminates the path; the rest is
    // the protocol version + CRLF + the "Host: " header name.
    req.data[pos] = 32; pos = pos + 1;   // ' '
    req.data[pos] = 72; pos = pos + 1;   // 'H'
    req.data[pos] = 84; pos = pos + 1;   // 'T'
    req.data[pos] = 84; pos = pos + 1;   // 'T'
    req.data[pos] = 80; pos = pos + 1;   // 'P'
    req.data[pos] = 47; pos = pos + 1;   // '/'
    req.data[pos] = 49; pos = pos + 1;   // '1'
    req.data[pos] = 46; pos = pos + 1;   // '.'
    req.data[pos] = 48; pos = pos + 1;   // '0'
    req.data[pos] = 13; pos = pos + 1;   // '\r'
    req.data[pos] = 10; pos = pos + 1;   // '\n'
    req.data[pos] = 72; pos = pos + 1;   // 'H'
    req.data[pos] = 111; pos = pos + 1;  // 'o'
    req.data[pos] = 115; pos = pos + 1;  // 's'
    req.data[pos] = 116; pos = pos + 1;  // 't'
    req.data[pos] = 58; pos = pos + 1;   // ':'
    req.data[pos] = 32; pos = pos + 1;   // ' '
    // Host (null-terminated ASCII, copied verbatim).
    let j = 0;
    while j < 64 {
        let c = host.data[j];
        if c == 0 { break; }
        req.data[pos] = c;
        pos = pos + 1;
        j = j + 1;
    }
    // "\r\n\r\n" — terminates the Host header (CRLF) + the request
    // headers (blank-line CRLF). The server treats this as "end of
    // request, send response".
    req.data[pos] = 13; pos = pos + 1;
    req.data[pos] = 10; pos = pos + 1;
    req.data[pos] = 13; pos = pos + 1;
    req.data[pos] = 10; pos = pos + 1;
    req.len = pos;
}

// http_get: send an HTTP GET request and receive the response.
//
//   host: caller-allocated State<HttpHost> (e.g. "10.0.2.2\0").
//   port: TCP port to connect to (host-order u16 — 80 in the self-test).
//   path: caller-allocated State<HttpPath> (e.g. "/\0").
//   resp: caller-allocated State<HttpResponse> (output buffer).
//
// Returns 0 on success (resp.len set to the byte count received), or a
// negative value on failure (-1 = socket, -2 = connect, -3 = send,
// -4 = recv).
//
// W47: real TCP round-trip (replaces the K9f stub). Steps:
//   1. Build the HTTP/1.0 GET request via http_build_get.
//   2. Compute host_len (scan until null or 64).
//   3. Guard: if host_len == 0, set resp.len=0 + return 0 (skip the
//      network call — the K9f self-test exercises this path with an
//      empty host so the self-test passes regardless of network state).
//   4. Build sockaddr_in: sin_family=AF_INET(2), sin_port=htons(port),
//      sin_addr=parsed from the host dotted-quad string.
//   5. Create a TCP socket: socket(AF_INET=2, SOCK_STREAM=1, 0).
//   6. Connect: connect(fd, &addr, 16).
//   7. Send the request: send(fd, req, req.len, 0).
//   8. Receive the response: recv(fd, resp, 512, 0).
//   9. Close the socket. Set resp.len from the recv return.
//
// In hosted mode (compile_dump on Linux x86_64), the socket/connect/
// send/recv/close externs resolve to real syscalls — so http_get actually
// opens a TCP connection + sends the GET + receives the response. If the
// connection fails (no server / firewall / wrong host), http_get returns
// a negative code. The K9f self-test uses an EMPTY host (host_len==0) so
// the guard returns 0 before any network call — the self-test passes
// deterministically without depending on network availability.
fn http_get(host: State<HttpHost>, port: u16, path: State<HttpPath>, resp: State<HttpResponse>) -> i64 {
    let req = state_new(HttpRequest);
    http_build_get(req, path, host);

    // Compute host_len: scan the host buffer until null or 64 bytes.
    let host_len = 0;
    while host_len < 64 {
        if host.data[host_len] == 0 { break; }
        host_len = host_len + 1;
    }

    // Guard: empty host → skip the network call, return 0.
    if host_len == 0 {
        resp.len = 0;
        return 0;
    }

    // Build sockaddr_in for the parsed host:port.
    let addr_state = state_new(SockAddrIn);
    addr_state.data[0] = 2;  // AF_INET (host byte order, low byte)
    addr_state.data[1] = 0;  // AF_INET (host byte order, high byte)
    addr_state.data[2] = (port >> 8) as u8;   // sin_port high byte (network order)
    addr_state.data[3] = (port & 255) as u8;  // sin_port low byte

    // Parse the host dotted-quad: "10.0.2.2" → [10, 0, 2, 2].
    // octet = current octet index (0..3), val = current octet accumulator.
    let octet = 0;
    let val = 0;
    let i = 0;
    while i < host_len && octet < 4 {
        let c = host.data[i];
        if c == 46 {  // '.'
            addr_state.data[4 + octet] = val as u8;
            octet = octet + 1;
            val = 0;
        } else {
            // Digit: val = val * 10 + (c - 48). 48 = '0'.
            val = val * 10 + (c as i32 - 48);
        }
        i = i + 1;
    }
    // Store the last octet (no trailing dot).
    if octet < 4 {
        addr_state.data[4 + octet] = val as u8;
        octet = octet + 1;
    }
    // Zero any remaining octets (in case host had < 4 octets) + sin_zero.
    while octet < 4 {
        addr_state.data[4 + octet] = 0;
        octet = octet + 1;
    }
    let z = 8;
    while z < 16 {
        addr_state.data[z] = 0;
        z = z + 1;
    }

    // Create a TCP socket: socket(AF_INET=2, SOCK_STREAM=1, 0).
    let fd = socket(2, 1, 0);
    if fd < 0 { return -1; }

    // Connect to host:port. connect(fd, &addr, 16). Returns 0 on success,
    // negative errno on failure.
    let cret = connect(fd, addr_state as Address, 16);
    if cret < 0 { close(fd); return -2; }

    // Send the HTTP request. send(fd, req, req.len, flags=0). Returns
    // bytes sent (>= 0) or negative errno.
    let sent = send(fd, req as Address, req.len as i64, 0);
    if sent < 0 { close(fd); return -3; }

    // Receive the HTTP response. recv(fd, resp, 512, flags=0). Returns
    // bytes received (>= 0) or negative errno. 512 = HttpResponse.data
    // buffer size.
    let n = recv(fd, resp as Address, 512, 0);
    close(fd);
    if n < 0 { return -4; }
    resp.len = n as u32;
    return 0;
}

// ────────────────────────────────────────────────────────────────────────────
// Self-test (main).
// ────────────────────────────────────────────────────────────────────────────
// Exercises the GET-builder path: build an HTTP/1.0 GET request for
// path="/" + host="10.0.2.2", then verify the GET prefix + path byte +
// the trailing \r\n\r\n. Also exercises http_get with an EMPTY host
// (W47: the empty-host guard returns 0 before any network call — this
// keeps the self-test deterministic regardless of network availability).
// Returns 0 on success, 1..10 on the 10 individual check failures.
fn main() -> i32 {
    // Self-test: build a GET request.
    let path = state_new(HttpPath);
    path.data[0] = 47;  // '/'
    path.data[1] = 0;
    let host = state_new(HttpHost);
    host.data[0] = 49;  // '1'
    host.data[1] = 48;  // '0'
    host.data[2] = 46;  // '.'
    host.data[3] = 48;  // '0'
    host.data[4] = 46;  // '.'
    host.data[5] = 50;  // '2'
    host.data[6] = 46;  // '.'
    host.data[7] = 50;  // '2'
    host.data[8] = 0;
    let req = state_new(HttpRequest);
    http_build_get(req, path, host);
    // Verify: starts with "GET "
    if req.data[0] != 71 { return 1; }  // 'G'
    if req.data[1] != 69 { return 2; }  // 'E'
    if req.data[2] != 84 { return 3; }  // 'T'
    if req.data[3] != 32 { return 4; }  // ' '
    if req.data[4] != 47 { return 5; }  // '/'
    // Verify: ends with \r\n\r\n
    let last = req.len;
    if req.data[last - 1] != 10 { return 6; }  // '\n'
    if req.data[last - 2] != 13 { return 7; }  // '\r'
    if req.data[last - 3] != 10 { return 8; }  // '\n'
    if req.data[last - 4] != 13 { return 9; }  // '\r'
    // http_get with an EMPTY host → W47 guard returns 0 (no network call).
    // This keeps the self-test deterministic: the guard short-circuits
    // before socket/connect/send/recv, so no network dependency.
    let empty_host = state_new(HttpHost);
    empty_host.data[0] = 0;
    let resp = state_new(HttpResponse);
    let ret = http_get(empty_host, 80, path, resp);
    if ret != 0 { return 10; }
    return 0;
}
