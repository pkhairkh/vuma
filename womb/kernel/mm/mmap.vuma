// ═══════════════════════════════════════════════════════════════════════════
// womb/kernel/mm/mmap.vuma
// VWK mmap syscall handler — region-table bookkeeping + PMM/VMM glue (PMT-pure).
// ═══════════════════════════════════════════════════════════════════════════
//
// The kernel's mmap syscall handler. Maintains a region table mapping
// (vaddr → (paddr, len, flags)) for up to 64 active regions. sys_mmap finds
// a free region slot, allocates a physical page via the PMM (re-declared
// here as an extern — see "VUMA has no import" below), maps it via the VMM
// (also re-declared as an extern), and records the result. sys_munmap finds
// the region by vaddr, unmaps it via the VMM, frees the physical page via
// the PMM, and clears the slot.
//
// Build & run self-test (hosted x86_64):
//     ./target/release-fast/compile_dump womb/kernel/mm/mmap.vuma \
//         /tmp/mmap.bin x86_64 --verify
//     /tmp/mmap.bin ; echo "exit=$?"
// Expected exit: 0
//
// ── Arch-independence (R3c audit, updated W35) ──────────────────────────────
// mmap is 100% arch-independent.
//
// Verified R3c: zero `if arch == ...`, zero arch-conditional code, zero
// arch-specific constants. The sys_mmap / sys_munmap region-table
// bookkeeping is a pure PMT transform over State<RegionTable> — it records
// (vaddr, paddr, len, flags) tuples as opaque u64 values and delegates
// physical-page allocation + page-table mapping to the PMM/VMM via the
// forward-declared VUMA fns (pmm_alloc / vmm_map_page / etc.). Compiles
// identically for all 19 backends.
//
// W35: the pre-W35 local no-op stub fns (pmm_alloc / pmm_free / vmm_map /
// vmm_unmap) have been REMOVED. They are now forward-declared VUMA `fn`
// signatures (NOT extern "C") matching pmm.vuma / vmm.vuma's real
// signatures. The `PageTable` layout is replaced by `VmmSpace` (R3b
// root + levels + arch + _pad), and the call sites use vmm_map_page /
// vmm_unmap_page (matching vmm.vuma's real function names) instead of
// vmm_map / vmm_unmap. In hosted mode the forward declarations resolve
// to empty-body functions (pmm_alloc returns 0; vmm_map_page /
// vmm_unmap_page are no-ops). In K11 bare-metal mode the linker
// resolves them against the real pmm.vuma / vmm.vuma compiled objects.
//
// The R3b VMM (womb/kernel/mm/vmm.vuma) is the ONLY mm/ file that
// branches on arch (via VmmSpace.arch → x86/arm/riscv walker dispatch —
// the HAL boundary); pmm/kmalloc/mmap have ZERO arch-dispatch.
//
// ── PMT discipline ─────────────────────────────────────────────────────────
// NO `*ptr`, `&x`, `allocate`, or `free` anywhere in this file. All storage
// lives in ___pmt_buffer-backed State<T> buffers:
//   - State<RegionTable> — the region table (64 slots, flat byte arrays)
//   - State<FlatPool>    — re-declared PMM free-list pool (pmm.vuma)
//   - State<PmmState>    — re-declared PMM state (pmm.vuma)
//   - State<VmmSpace>    — re-declared VMM address space (vmm.vuma, W35)
// All are allocated via `state_new(...)` by the CALLER (init-style API —
// see "Why init-style?" in womb/kernel/mm/pmm.vuma for the codegen
// rationale). sys_mmap / sys_munmap take all four states by reference.
//
// ── Why re-declare PMM/VMM as forward declarations? (W35) ───────────────────
// VUMA has no `import` (Open Work §7). pmm_alloc / pmm_free live in
// womb/kernel/mm/pmm.vuma and vmm_map_page / vmm_unmap_page live in
// womb/kernel/mm/vmm.vuma. To call them from this file, we re-declare
// their signatures here as VUMA `fn` forward declarations (NOT extern
// "C" — per the W35 task spec, pmm_alloc/vmm_map are VUMA functions).
// In hosted mode (compile_dump on x86_64) the forward declarations
// have empty bodies, so:
//   - pmm_alloc returns 0  (no physical page available — paddr = 0)
//   - pmm_free is a no-op
//   - vmm_map_page is a no-op   (no PTE write — but the walk doesn't crash)
//   - vmm_unmap_page is a no-op
// In K11 bare-metal mode, the linker resolves these against the real
// pmm.vuma / vmm.vuma compiled object files, and sys_mmap / sys_munmap
// work end-to-end with no source changes (same pattern as
// womb/kernel/tty/console.vuma re-declaring its extern `write`).
//
// The FlatPool / PmmState / VmmSpace layouts are re-declared here
// byte-identically to pmm.vuma / vmm.vuma so the State<T> marshaling on
// the forward-declared calls uses the correct field offsets. (A mismatch
// would silently produce different offsets in different translation
// units.)
//
// ── Why a flat byte-array RegionTable? ──────────────────────────────────────
// Same codegen limitation as K2a's FlatPool and K2f's SlabState: VUMA's
// flatten_expr lowers `state.array[i]` to `*(base_addr + i)` with a U8
// Load/Store (no element-size scaling for non-u8 arrays). So a `[Region; 64]`
// array (where Region is a 33-byte struct) would alias all 64 slots at
// offset 0. Workaround: store each Region field in a separate flat byte
// array, with pack/unpack helpers (same pattern as K2a's pool_get_base /
// pool_set_base).
//
// ── sys_mmap as a transform (Fix 6) ─────────────────────────────────────────
// sys_mmap is declared `transform` (not `fn`). Fix 1 (commit b183ecac) lifted
// the parser's old 1-State-param restriction on `transform`, so multi-param
// transforms now lower to real codegen (same path as `fn`). The transform
// keyword enables:
//   - StateTransform verifier on the body
//   - state_transform_elision if the transform is identity
//   - Linear ownership semantics (the State<T> params are "consumed" by the
//     transform — use-after-exit becomes a compile-time concept)
// sys_mmap's signature is unchanged from the K2f `fn` form (same params, same
// return type u64); only the leading `fn` keyword became `transform`. The
// caller (self-test) calls it the same way — transforms are callable like
// regular functions from the caller's perspective.
//
// ── VUMA has no `import` ────────────────────────────────────────────────────
// This file is self-contained. If a future kmain.vuma wants to call
// sys_mmap / sys_munmap, it must re-declare the RegionTable layout and the
// PMM/VMM externs byte-identically (same pattern as console.vuma
// re-declaring its extern `write`).

// ────────────────────────────────────────────────────────────────────────────
// Re-declared layouts (byte-identical to pmm.vuma's FlatPool/PmmState and
// vmm.vuma's VmmSpace). The PMM/VMM forward declarations take State<T>
// params whose field offsets are determined by these layouts — a mismatch
// would silently produce different offsets in different translation units.
// ────────────────────────────────────────────────────────────────────────────

// PMM free-list node pool (pmm.vuma). Re-declared for the pmm_alloc /
// pmm_free forward declarations' State<FlatPool> param. Byte-identical
// to womb/kernel/mm/pmm.vuma::FlatPool (W35: previously mmap.vuma
// re-declared a 256-slot K2a-era FlatPool without the free_head field;
// updated to the real 4096-slot layout so the State<T> marshaling uses
// the correct field offsets when calling the real pmm.vuma pmm_alloc).
layout FlatPool = {
    bases: [u8; 32768],  // 4096 * 8 bytes — u64 base address per node, LE-packed
    orders: [u8; 4096],  // 4096 bytes     — u8 buddy order per node
    nexts: [u8; 32768],  // 4096 * 8 bytes — u64 next-node index per node, LE-packed
    count: u32,          // bump-alloc high-water mark (0..4096), never decreases
    free_head: u32,      // head of recycle list, or 4096 if empty
}

// PMM state (pmm.vuma). Re-declared for the pmm_alloc / pmm_free forward
// declarations' State<PmmState> param. Byte-identical to
// womb/kernel/mm/pmm.vuma::PmmState.
layout PmmState = {
    pool: u64,
    free_lists: [u8; 88], // 11 * 8 bytes — head FreeNode index per order, 4096 = empty
    total_pages: u64,
    free_pages: u64,
}

// VMM address space (vmm.vuma). Re-declared for the vmm_map_page /
// vmm_unmap_page forward declarations' State<VmmSpace> param.
// Byte-identical to womb/kernel/mm/vmm.vuma::VmmSpace. W35: replaces
// the pre-R3b `PageTable` layout (root_phys + levels, 9 bytes). The
// real vmm.vuma::vmm_map_page takes State<VmmSpace> and dispatches on
// `space.arch` to the per-arch walker (x86/arm/riscv) — this is the
// R3b HAL boundary.
layout VmmSpace = {
    root: u64,            // top-level page-table physical address (PML4/PGD/SATP)
    levels: u8,           // paging levels (4 for x86_64/aarch64, 3 for riscv64 Sv39)
    arch: u8,             // arch discriminant (0=x86_64, 1=aarch64, 2=riscv64)
    _pad: [u8; 6],        // pad to 16 bytes for clean alignment
}

// ────────────────────────────────────────────────────────────────────────────
// PMM/VMM forward declarations (W35).
// ────────────────────────────────────────────────────────────────────────────
// VUMA has no `import` (Open Work §7). pmm_alloc / pmm_free live in
// womb/kernel/mm/pmm.vuma and vmm_map_page / vmm_unmap_page live in
// womb/kernel/mm/vmm.vuma. To call them from this file we re-declare
// their signatures here as VUMA `fn` forward declarations (NOT extern
// "C" — per the W35 task spec, pmm_alloc/vmm_map are VUMA functions).
//
// In hosted mode these resolve to empty-body functions (pmm_alloc
// returns 0; pmm_free / vmm_map_page / vmm_unmap_page are no-ops) —
// sys_mmap records paddr=0 and returns the vaddr; the region is still
// usable as a bookkeeping entry. In K11 bare-metal mode the linker
// resolves these against the real pmm.vuma / vmm.vuma compiled object
// files, and sys_mmap / sys_munmap work end-to-end with no source
// changes (same pattern as womb/kernel/tty/console.vuma re-declaring
// its extern `write`).

fn pmm_alloc(pool: State<FlatPool>, pmm: State<PmmState>, order: u8) -> u64;
fn pmm_free(pool: State<FlatPool>, pmm: State<PmmState>, addr: u64, order: u8);
fn vmm_map_page(space: State<VmmSpace>, vaddr: u64, paddr: u64, flags: u64);
fn vmm_unmap_page(space: State<VmmSpace>, vaddr: u64);

// ────────────────────────────────────────────────────────────────────────────
// RegionTable layout (flat byte arrays — see "Why a flat byte-array
// RegionTable?" above).
// ────────────────────────────────────────────────────────────────────────────
// Holds up to 64 Region records. Each Region has 4 u64 fields (vaddr, paddr,
// len, flags) and 1 u8 field (used: 1 = in use, 0 = free). The fields are
// stored in 5 separate flat byte arrays so each can be accessed via
// `state.array[byte_off]` (which the codegen only lowers correctly for
// [u8; N] arrays). `count` is the number of currently-used slots (0..64).

layout RegionTable = {
    vaddrs: [u8; 512],   // 64 * 8 bytes — u64 vaddr per region, LE-packed
    paddrs: [u8; 512],   // 64 * 8 bytes — u64 paddr per region, LE-packed
    lens: [u8; 512],     // 64 * 8 bytes — u64 length per region, LE-packed
    flags: [u8; 512],    // 64 * 8 bytes — u64 flags per region, LE-packed
    used: [u8; 64],      // 64 bytes    — u8 used flag per region (0/1)
    count: u32,          // number of currently-used slots (0..64)
}

// ────────────────────────────────────────────────────────────────────────────
// Constants (documented inline).
// ────────────────────────────────────────────────────────────────────────────
// MAX_REGIONS = 64
// PAGE_SIZE   = 4096
// PROT_READ   = 1
// PROT_WRITE  = 2
// PROT_EXEC   = 4

// ────────────────────────────────────────────────────────────────────────────
// Byte-array pack/unpack helpers for RegionTable (u64 fields).
// ────────────────────────────────────────────────────────────────────────────

fn rt_get_vaddr(regions: State<RegionTable>, idx: u32) -> u64 {
    let off = idx * 8;
    let v: u64 = 0;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let byte_off = off + i;
        let b = regions.vaddrs[byte_off] as u64;
        v = v + (b << sh);
        i = i + 1;
    }
    return v;
}

fn rt_set_vaddr(regions: State<RegionTable>, idx: u32, val: u64) {
    let off = idx * 8;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let b = (val >> sh) & 255;
        let byte_off = off + i;
        regions.vaddrs[byte_off] = b as u8;
        i = i + 1;
    }
}

fn rt_get_paddr(regions: State<RegionTable>, idx: u32) -> u64 {
    let off = idx * 8;
    let v: u64 = 0;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let byte_off = off + i;
        let b = regions.paddrs[byte_off] as u64;
        v = v + (b << sh);
        i = i + 1;
    }
    return v;
}

fn rt_set_paddr(regions: State<RegionTable>, idx: u32, val: u64) {
    let off = idx * 8;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let b = (val >> sh) & 255;
        let byte_off = off + i;
        regions.paddrs[byte_off] = b as u8;
        i = i + 1;
    }
}

fn rt_get_len(regions: State<RegionTable>, idx: u32) -> u64 {
    let off = idx * 8;
    let v: u64 = 0;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let byte_off = off + i;
        let b = regions.lens[byte_off] as u64;
        v = v + (b << sh);
        i = i + 1;
    }
    return v;
}

fn rt_set_len(regions: State<RegionTable>, idx: u32, val: u64) {
    let off = idx * 8;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let b = (val >> sh) & 255;
        let byte_off = off + i;
        regions.lens[byte_off] = b as u8;
        i = i + 1;
    }
}

fn rt_get_flags(regions: State<RegionTable>, idx: u32) -> u64 {
    let off = idx * 8;
    let v: u64 = 0;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let byte_off = off + i;
        let b = regions.flags[byte_off] as u64;
        v = v + (b << sh);
        i = i + 1;
    }
    return v;
}

fn rt_set_flags(regions: State<RegionTable>, idx: u32, val: u64) {
    let off = idx * 8;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let b = (val >> sh) & 255;
        let byte_off = off + i;
        regions.flags[byte_off] = b as u8;
        i = i + 1;
    }
}

// ────────────────────────────────────────────────────────────────────────────
// Byte-array pack/unpack helpers for RegionTable (u8 used flag).
// ────────────────────────────────────────────────────────────────────────────

fn rt_get_used(regions: State<RegionTable>, idx: u32) -> u8 {
    return regions.used[idx];
}

fn rt_set_used(regions: State<RegionTable>, idx: u32, val: u8) {
    regions.used[idx] = val;
}

// ────────────────────────────────────────────────────────────────────────────
// Region-table search helpers.
// ────────────────────────────────────────────────────────────────────────────

// Initialize a freshly-allocated RegionTable: zero all 64 `used` flags
// and set count = 0. state_new(RegionTable) does NOT zero-initialize
// (the stack slot's bytes are whatever was on the stack — see K2a's
// pmm_init for the same pattern), so the caller MUST call rt_init before
// the first sys_mmap / rt_find_free_slot / rt_find_by_vaddr.
//
// Init-style API: caller allocates `regions` via state_new(RegionTable),
// passes by reference.
fn rt_init(regions: State<RegionTable>) {
    let i = 0;
    while i < 64 {
        rt_set_used(regions, i, 0);
        i = i + 1;
    }
    regions.count = 0;
}

// Find the first free region slot (used == 0). Returns the slot index
// (0..63), or 64 if the table is full.
fn rt_find_free_slot(regions: State<RegionTable>) -> u32 {
    let i = 0;
    while i < 64 {
        if rt_get_used(regions, i) == 0 {
            return i;
        }
        i = i + 1;
    }
    return 64;
}

// Find the region slot whose vaddr matches `addr` and is in use. Returns
// the slot index (0..63), or 64 if not found.
fn rt_find_by_vaddr(regions: State<RegionTable>, addr: u64) -> u32 {
    let i = 0;
    while i < 64 {
        if rt_get_used(regions, i) == 1 {
            if rt_get_vaddr(regions, i) == addr {
                return i;
            }
        }
        i = i + 1;
    }
    return 64;
}

// ────────────────────────────────────────────────────────────────────────────
// sys_mmap — mmap syscall handler.
// ────────────────────────────────────────────────────────────────────────────
// Adds a region to the table: finds a free slot, allocates a physical page
// via pmm_alloc (one page per 4096 bytes of `len`, rounded up — for the
// K2f self-test, len is one page so we allocate exactly one order-0 page),
// maps it via vmm_map_page, and records (vaddr, paddr, len, flags) in the
// slot.
//
// If `addr` is non-zero, it is used as the requested virtual address. If
// `addr` is zero, the kernel should pick a free virtual address (the K2f
// self-test always passes a non-zero addr, so the "pick a free vaddr" path
// is not exercised — it's a placeholder for K4+ when the kernel has a
// brk/mmap-area allocator).
//
// Returns the recorded vaddr on success, or 0 on failure (table full, or
// pmm_alloc returned 0 — in hosted mode pmm_alloc is a forward-declared
// empty-body stub returning 0, so sys_mmap records paddr=0 and returns
// the vaddr; the region is still usable as a bookkeeping entry even
// without a real physical page).
//
// W35: the `pt: State<PageTable>` param is replaced by `space: State<VmmSpace>`
// to match the real vmm.vuma::vmm_map_page signature (R3b VmmSpace + arch
// dispatcher, not the pre-R3b PageTable). vmm_map is renamed vmm_map_page.
//
// Init-style API (caller allocates all four states via state_new, passes
// by reference — see "Why init-style?" in womb/kernel/mm/pmm.vuma).

transform sys_mmap(
    regions: State<RegionTable>,
    pmm_pool: State<FlatPool>,
    pmm: State<PmmState>,
    space: State<VmmSpace>,
    addr: u64,
    len: u64,
    prot: u64,
    flags: u64,
) -> u64 {
    // Pick the vaddr.
    let vaddr = addr;

    // Find a free slot.
    let slot = rt_find_free_slot(regions);
    if slot == 64 {
        // Table full.
        return 0;
    }

    // Allocate one physical page per 4096 bytes of `len` (rounded up).
    // For the K2f self-test, len <= 4096 so we allocate exactly one page.
    // The kernel would normally iterate over (len + 4095) / 4096 pages,
    // but the region table only records the FIRST paddr (the rest are
    // implicit at paddr+4096, paddr+8192, ...). A future wave may extend
    // the region to record a page-array base + count.
    let paddr = pmm_alloc(pmm_pool, pmm, 0);

    // Map the virtual page to the physical page. In hosted mode
    // vmm_map_page is a forward-declared no-op (the per-arch walker
    // resolves to __ffi_fallback_stub). The vmm_map_page call is still
    // made so K11 bare-metal mode works without source changes.
    vmm_map_page(space, vaddr, paddr, prot);

    // Record the region.
    rt_set_vaddr(regions, slot, vaddr);
    rt_set_paddr(regions, slot, paddr);
    rt_set_len(regions, slot, len);
    rt_set_flags(regions, slot, flags);
    rt_set_used(regions, slot, 1);
    regions.count = regions.count + 1;

    return vaddr;
}

// ────────────────────────────────────────────────────────────────────────────
// sys_munmap — munmap syscall handler.
// ────────────────────────────────────────────────────────────────────────────
// Finds the region with matching vaddr, unmaps it via vmm_unmap_page,
// frees the physical page via pmm_free (if paddr != 0 — in hosted mode
// paddr is 0, so pmm_free is skipped to avoid freeing an invalid
// address), and clears the slot.
//
// Returns 0 on success, or -1 if the vaddr was not found in any region.
//
// W35: the `pt: State<PageTable>` param is replaced by `space: State<VmmSpace>`
// to match the real vmm.vuma::vmm_unmap_page signature. vmm_unmap is
// renamed vmm_unmap_page.

fn sys_munmap(
    regions: State<RegionTable>,
    pmm_pool: State<FlatPool>,
    pmm: State<PmmState>,
    space: State<VmmSpace>,
    addr: u64,
) -> i64 {
    let slot = rt_find_by_vaddr(regions, addr);
    if slot == 64 {
        // Not found.
        return 0xFFFFFFFFFFFFFFFF;
    }

    // Unmap the virtual page. In hosted mode vmm_unmap_page is a
    // forward-declared no-op.
    vmm_unmap_page(space, addr);

    // Free the physical page (skip if paddr == 0 — hosted mode has no
    // real physical page to free, and pmm_free(0) would be a no-op
    // anyway since pmm_free is a forward-declared empty-body stub).
    let paddr = rt_get_paddr(regions, slot);
    if paddr != 0 {
        pmm_free(pmm_pool, pmm, paddr, 0);
    }

    // Clear the slot.
    rt_set_vaddr(regions, slot, 0);
    rt_set_paddr(regions, slot, 0);
    rt_set_len(regions, slot, 0);
    rt_set_flags(regions, slot, 0);
    rt_set_used(regions, slot, 0);
    if regions.count > 0 {
        regions.count = regions.count - 1;
    }

    return 0;
}

// ────────────────────────────────────────────────────────────────────────────
// Self-test (the K2f DoD).
// ────────────────────────────────────────────────────────────────────────────
// Two parts:
//   1. Region-table bookkeeping (the contract's specified self-test): add a
//      region manually via rt_set_*, verify it's read back correctly, clear
//      it, verify it's cleared.
//   2. sys_mmap / sys_munmap end-to-end: set up PMM/VMM states (via
//      state_new — in hosted mode the forward-declared pmm_alloc returns 0
//      and vmm_map_page / vmm_unmap_page are no-ops, but the region-table
//      updates are real). Verify:
//        - sys_mmap adds a region (count goes 0 → 1, slot 0 is used, vaddr
//          matches).
//        - A second sys_mmap at a different vaddr goes into slot 1.
//        - sys_munmap of the first vaddr clears slot 0 (count 2 → 1).
//        - sys_munmap of a non-existent vaddr returns -1.
//
// (Part 2 is documented but not exercised by the current main() body —
// the K2f DoD only requires part 1. A future wave may add the end-to-end
// sys_mmap / sys_munmap calls.)
//
// Returns 0 on pass.

fn main() -> i32 {
    let regions = state_new(RegionTable);
    rt_init(regions);

    // Self-test: region-table bookkeeping.
    // Add a region manually, verify it's read back, clear it.
    rt_set_vaddr(regions, 0, 65536);
    rt_set_paddr(regions, 0, 131072);
    rt_set_len(regions, 0, 4096);
    rt_set_flags(regions, 0, 3);
    rt_set_used(regions, 0, 1);
    regions.count = 1;

    if rt_get_vaddr(regions, 0) != 65536 { return 1; }
    if rt_get_paddr(regions, 0) != 131072 { return 2; }
    if rt_get_len(regions, 0) != 4096 { return 3; }
    if rt_get_flags(regions, 0) != 3 { return 4; }
    if rt_get_used(regions, 0) != 1 { return 5; }

    // Verify rt_find_free_slot skips used slots.
    let slot1 = rt_find_free_slot(regions);
    if slot1 != 1 { return 6; }

    // Clear the region.
    rt_set_used(regions, 0, 0);
    regions.count = 0;
    if rt_get_used(regions, 0) != 0 { return 7; }
    let slot0 = rt_find_free_slot(regions);
    if slot0 != 0 { return 8; }

    return 0;
}
