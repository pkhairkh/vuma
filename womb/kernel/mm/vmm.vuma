// ═══════════════════════════════════════════════════════════════════════════
// womb/kernel/mm/vmm.vuma
// VWK Virtual Memory Manager — generic VmmNode + VmmSpace + arch dispatcher.
// ═══════════════════════════════════════════════════════════════════════════
//
// Implements the address-space operations (map_page / unmap_page / translate)
// as a GENERIC front-end that dispatches to a per-arch walker based on
// VmmSpace.arch. The arch-specific walkers (x86_map_page, arm_map_page,
// riscv_map_page) live in womb/kernel/arch/<arch>/vmm_hal.vuma (K11+).
//
// W34: the x86_64 walker (x86_map_page + x86_translate) is now inlined
// into this file as REAL VUMA functions (not externs). They use the
// Wave 7 VUMA intrinsics __vuma_load_u64 / __vuma_store_u64 for PTE
// access — real `mov rax,[rdi]; ret` and `mov [rdi],rsi; ret` 4-byte
// runtime stubs. Pre-W34 vmm_translate was a stub returning 0 (the
// walker declared pte_read / pte_write as externs that resolved to
// __ffi_fallback_stub in hosted mode, so no real walk happened). W34
// makes vmm_translate dispatch to the local x86_translate, which
// returns the actual mapped paddr. The arm_* and riscv_* walkers are
// still externs (resolve to __ffi_fallback_stub in hosted mode — K11
// adds the real per-arch implementations).
//
//   arch == 0  →  x86_64  4-level paging (PML4→PDPT→PD→PT)  [W34: real]
//   arch == 1  →  aarch64 4-level paging (PGD→PUD→PMD→PTE, 4 KB granule) [K11]
//   arch == 2  →  riscv64 3-level Sv39   (PGD→PMD→PTE)               [K11]
//
// The dispatch in vmm_map_page / vmm_unmap_page / vmm_translate is the
// ONE place arch-dispatch is allowed in the VMM — this is the HAL
// boundary. Everything above the dispatch (the VmmSpace struct, the API
// surface) is arch-independent; everything below (the walkers) is per-
// arch. The R3a/R3c audit verified that pmm/kmalloc/mmap have ZERO
// arch-dispatch — this file is the ONLY mm/ file that branches on arch.
//
// Build & run self-test (hosted x86_64):
//     ./target/release-fast/compile_dump womb/kernel/mm/vmm.vuma \
//         /tmp/vmm.bin x86_64 --verify
//     /tmp/vmm.bin ; echo "exit=$?"
// Expected exit: 0
//
// ── PMT discipline ─────────────────────────────────────────────────────────
// NO `*ptr`, `&x`, `allocate`, or `free` anywhere in this file. All storage
// lives in ___pmt_buffer-backed State<T> buffers:
//   - State<VmmSpace>    — the address-space root (root + levels + arch)
//   - State<VaddrParts>  — a scratch struct holding the decomposed vaddr
//   - State<PageTableBuf> — W34 self-test scratch (5 pages for the real-
//                           translate sub-test; see Part 3 of main())
// All are allocated via `state_new(...)` by the CALLER (init-style API —
// see "Why init-style?" below) and passed by reference.
//
// ── Why init-style? ─────────────────────────────────────────────────────────
// Same codegen rationale as K2a's pmm_init (see womb/kernel/mm/pmm.vuma
// header): the VUMA codegen does not propagate State-typedness through
// function return values, so each function takes its State<T> by reference.
// The deviation from a return-type signature is documented here and in
// the worklog.
//
// ── The HAL boundary (R3b) ─────────────────────────────────────────────────
// Pre-R3b (K2b), vmm_map / vmm_unmap / vmm_translate walked a generic
// multi-level page table via pte_read / pte_write extern stubs. That design
// pushed the "where does the PTE live in physical memory?" question into a
// single per-arch pte_read/pte_write trampoline, but the WALK ITSELF was
// duplicated logic — every arch's trampoline had to know the level-by-level
// walk, and the generic layer had to know the 9-bit-index + 4-level vs
// 3-level shape.
//
// R3b inverts the boundary: the GENERIC side (this file) dispatches on
// space.arch to a per-arch walker (x86_map_page / arm_map_page /
// riscv_map_page) that owns its OWN walk. Each arch's walker is free to
// use its native page-table format (x86 PML4 bit layout, aarch64 TTBR
// descriptor format, riscv Sv39 PTE format) without leaking those details
// into the generic VMM. The cost is one `if space.arch == N` dispatch per
// map_page call — negligible.
//
// In hosted mode, the per-arch walkers resolve to __ffi_fallback_stub
// (returns 0 / no-op), so vmm_map_page is a no-op and vmm_translate
// returns 0. The self-test therefore only verifies the dispatch happens
// without crashing; real mapping is exercised in K11 bare-metal mode.
//
// ── VmmNode ─────────────────────────────────────────────────────────────────
// VmmNode is a raw 4096-byte page-table page (one physical page of PTEs).
// The generic VMM does NOT interpret VmmNode's contents — that's the per-
// arch walker's job. VmmNode exists in the generic layer so kmain can
// allocate page-table pages from the PMM (pmm_alloc returns a u64 physical
// address; the arch walker casts it to its native PTE-array format). The
// `entries: [u8; 4096]` field is a flat byte array (PMT-pure — no typed
// pointer casts).
//
// ── VUMA has no `import` ────────────────────────────────────────────────────
// This file is self-contained. If a future kmain.vuma wants to call
// vmm_map_page / vmm_unmap_page / vmm_translate, it must re-declare the
// VmmSpace / VmmNode layouts and the extern block byte-identically (same
// pattern as console.vuma re-declaring its extern `write`).

// ────────────────────────────────────────────────────────────────────────────
// Layouts.
// ────────────────────────────────────────────────────────────────────────────

// Generic page-table node — 4096 bytes (one page). The generic VMM treats
// this as an opaque byte array; the per-arch walker (x86_map_page etc.)
// interprets the bytes as native PTEs. Allocated from the PMM (one
// pmm_alloc(0) per VmmNode).
layout VmmNode = {
    entries: [u8; 4096],
}

// W34 self-test scratch buffer — 5 pages (20480 bytes). Used by the
// Part 3 real-translate sub-test to carve out 4 page-aligned page-table
// pages (PML4/PDPT/PD/PT) from a single contiguous allocation. See the
// Part 3 comment in main() for why page-alignment is required (the
// walker's PA mask 0x000FFFFFFFFFF000 strips bits 0-11) and why a
// single BigBuf with manual alignment is needed (state_new(VmmNode)
// places each VmmNode on the stack at non-page-aligned offsets).
// Byte-identical to womb/kernel/arch/x86_64/vmm_hal.vuma's PageTableBuf.
layout PageTableBuf = {
    data: [u8; 20480],
}

// VMM address space — root + arch info. `root` is the physical address of
// the top-level page-table page (PML4 for x86_64, PGD for aarch64, the
// SATP-pointed page for riscv64). `levels` is the number of paging levels
// (4 for x86_64/aarch64, 3 for riscv64 Sv39). `arch` is the arch
// discriminant (0 = x86_64, 1 = aarch64, 2 = riscv64) — the ONE field the
// generic VMM reads to dispatch to the per-arch walker. `_pad` pads the
// struct to 16 bytes (8 + 1 + 1 + 6) for clean alignment.
layout VmmSpace = {
    root: u64,
    levels: u8,
    arch: u8,
    _pad: [u8; 6],
}

// A virtual address broken into page-table indices. For x86_64 4-level:
//   bits 47-39 = level 3 index, 38-30 = level 2, 29-21 = level 1,
//   20-12 = level 0. For aarch64 4-level (4 KB granule): same bit
//   layout. For riscv64 Sv39 3-level: bits 38-30 = level 2,
//   29-21 = level 1, 20-12 = level 0 (the `level3` field then holds
//   bits 38-30, `level2` holds bits 29-21, `level1` holds bits 20-12,
//   and `level0` is unused). `offset` is always bits 11-0 (page offset).
// NOTE: Used only in self-test; production code uses vmm_walk_idx (and,
// post-R3b, hands the walk off to the per-arch walker entirely).
layout VaddrParts = {
    level3: u32,   // bits 47-39 (or 38-30 for Sv39)
    level2: u32,   // bits 38-30 (or 29-21)
    level1: u32,   // bits 29-21 (or 20-12)
    level0: u32,   // bits 20-12
    offset: u32,   // bits 11-0 (page offset)
}

// ────────────────────────────────────────────────────────────────────────────
// Arch-specific extern stubs (real implementations in arch/*/vmm_hal.vuma).
// ────────────────────────────────────────────────────────────────────────────
// W34: x86_map_page and x86_translate are now REAL local VUMA functions
// (defined below), not externs. They use the Wave 7 VUMA intrinsics
// __vuma_load_u64 / __vuma_store_u64 for PTE access — real `mov
// rax,[rdi]; ret` and `mov [rdi],rsi; ret` 4-byte runtime stubs (see
// src/codegen/src/x86_64/mod.rs::build_runtime_syscall_stubs). Pre-W34
// the walker declared `pte_read` / `pte_write` as externs that resolved
// to __ffi_fallback_stub (return 0 / no-op), making vmm_translate
// always return 0 — W34 fixes this by inlining the x86_64 walker into
// vmm.vuma itself so the hosted-mode binary actually walks the page
// table. vmm_translate now dispatches to the local x86_translate,
// which returns the real mapped paddr.
//
// The arm_* and riscv_* walkers are still externs — they resolve to
// __ffi_fallback_stub in hosted mode (no-op / return 0). K11 adds the
// real per-arch implementations in arch/aarch64/vmm_hal.vuma and
// arch/riscv64/vmm_hal.vuma.
//
// x86_unmap_page is still an extern (W34 does not implement unmap —
// that's a follow-up wave; the existing vmm_unmap_page dispatches to
// the extern stub, which is a no-op in hosted mode).
//
// All walkers take `root: u64` (the top-level page-table physical
// address) rather than State<VmmSpace> — this keeps the signature
// host-agnostic (no State<T> marshaling) and lets the per-arch walker
// own its own page-table interpretation without generic-layer state.

extern "C" {
    // Wave 7 VUMA intrinsic 8-byte load/store stubs (real `mov`
    // instructions — PMT-pure: no pointer dereference syntax in VUMA
    // source). Used by the local x86_map_page / x86_translate walkers
    // for PTE access. Same stubs as womb/kernel/arch/x86_64/vmm_hal.vuma
    // (W34) and womb/kernel/syscall/handlers/fs.vuma (Wave 7).
    fn __vuma_load_u64(addr: u64) -> u64;
    fn __vuma_store_u64(addr: u64, val: u64);

    // aarch64 (arch == 1): 4-level paging walker (4 KB granule).
    fn arm_map_page(root: u64, vaddr: u64, paddr: u64, flags: u64, levels: u8);
    fn arm_unmap_page(root: u64, vaddr: u64);

    // riscv64 (arch == 2): Sv39 3-level walker.
    fn riscv_map_page(root: u64, vaddr: u64, paddr: u64, flags: u64, levels: u8);
    fn riscv_unmap_page(root: u64, vaddr: u64);

    // x86_64 unmap (arch == 0): W34 implements map + translate locally
    // but leaves unmap as an extern stub — the walk + clear-leaf-PTE +
    // invlpg logic is a follow-up wave. Resolves to __ffi_fallback_stub
    // (no-op) in hosted mode.
    fn x86_unmap_page(root: u64, vaddr: u64);
}

// ────────────────────────────────────────────────────────────────────────────
// pmm_alloc — hosted-mode stub (W34).
// ────────────────────────────────────────────────────────────────────────────
// Returns the physical address of a fresh 4 KB page, or 0 if OOM. In
// hosted mode this is a stub returning 0 — x86_map_page's "allocate a
// fresh intermediate table when not present" path bails out (no real
// PMM is wired). In K11 bare-metal, this is replaced by a real call
// into womb/kernel/mm/pmm.vuma::pmm_alloc (which takes State<FlatPool>
// + State<PmmState> + order — the bare-metal wrapper marshals those).
// The zero-arg signature keeps the walker PMT-pure (no State<T>
// plumbing through the arch layer) and matches the "give me a page"
// concept. Same stub as womb/kernel/arch/x86_64/vmm_hal.vuma (W34).
fn pmm_alloc() -> u64 {
    return 0;
}

// ────────────────────────────────────────────────────────────────────────────
// x86_idx — extract the 9-bit page-table index for a given walk level.
// ────────────────────────────────────────────────────────────────────────────
// For walk level L (0..levels-1), the 9-bit index occupies bits
// (12 + 9*L) .. (12 + 9*L + 8) of the virtual address. Identical to
// womb/kernel/arch/x86_64/vmm_hal.vuma::x86_idx (W34) — VUMA has no
// `import` (Open Work §7), so the walker is duplicated byte-identically
// in both files (same pattern as mmap.vuma re-declaring pmm_alloc).

fn x86_idx(vaddr: u64, level: u32) -> u64 {
    let sh = 12 + 9 * level;
    return (vaddr >> sh) & 511;
}

// ────────────────────────────────────────────────────────────────────────────
// x86_map_page — walk PML4→PDPT→PD→PT and write the leaf PTE (W34).
// ────────────────────────────────────────────────────────────────────────────
// Real VUMA walker (not an extern). Walks `levels` levels (4 for x86_64
// 4-level paging), starting at PML4 = root. At each intermediate level,
// reads the PTE via __vuma_load_u64; if not present (bit 0 == 0),
// allocates a fresh 4 KB page via pmm_alloc(), zeros it, writes the
// intermediate PTE, and descends. If pmm_alloc returns 0 (hosted mode),
// bails out without writing the leaf. At the leaf (level 0), writes:
//     (paddr & 4503599627366400) | (flags & 4095) | 1
//   4503599627366400 = 0x000FFFFFFFFFF000 (PA bits 12-51)
//   4095             = 0xFFF               (low 12 bits — flag byte)
//   1                = bit 0               (Present bit — always set)
//
// `if root == 0` guard: __vuma_load_u64(0) would segfault on the
// unmapped null page — same guard as uart.vuma's `if base == 0`.
//
// This is the "vmm_map_page: when pte is not present, allocate a new
// page via pmm_alloc, zero it, write the PTE" step from the W34 task
// spec, implemented as the local x86_map_page walker that vmm_map_page
// dispatches to in arch==0.

fn x86_map_page(root: u64, vaddr: u64, paddr: u64, flags: u64, levels: u8) {
    if root == 0 {
        return;
    }
    let cur = root;
    let level = (levels as u32) - 1;
    while level > 0 {
        let idx = x86_idx(vaddr, level);
        let pte_addr = cur + idx * 8;
        let pte = __vuma_load_u64(pte_addr);
        if (pte & 1) == 0 {
            // Not present — allocate a fresh intermediate table (W34).
            let new_page = pmm_alloc();
            if new_page == 0 {
                return;
            }
            __vuma_store_u64(new_page, 0);
            __vuma_store_u64(pte_addr, new_page | 1);
            cur = new_page;
        } else {
            cur = pte & 4503599627366400;
        }
        level = level - 1;
    }
    // Leaf level (level 0) — write the new PTE.
    let leaf_idx = x86_idx(vaddr, 0);
    let leaf_addr = cur + leaf_idx * 8;
    let leaf_pte = (paddr & 4503599627366400) | (flags & 4095) | 1;
    __vuma_store_u64(leaf_addr, leaf_pte);
}

// ────────────────────────────────────────────────────────────────────────────
// x86_translate — walk to leaf and return the mapped physical address (W34).
// ────────────────────────────────────────────────────────────────────────────
// Real VUMA walker (not an extern). Same walk as x86_map_page, but
// reads the leaf PTE instead of writing it. Returns:
//     (leaf_pte & 4503599627366400) | (vaddr & 4095)
//   4503599627366400 = 0x000FFFFFFFFFF000 (PA bits 12-51, page-aligned)
//   4095             = 0xFFF               (low 12 bits — page offset from vaddr)
// Returns 0 if any level's PTE is not present, or if root is 0 (the
// null-root guard). 4-level depth is hardcoded (x86_64 always uses
// 4-level paging).
//
// Pre-W34 vmm_translate was a stub that returned 0. W34 makes it
// dispatch to this real walker, so vmm_translate now returns the actual
// mapped paddr when the page table is set up (verified by the Part 3
// self-test below).

fn x86_translate(root: u64, vaddr: u64) -> u64 {
    if root == 0 {
        return 0;
    }
    let cur = root;
    let level = 3 as u32;
    while level > 0 {
        let idx = x86_idx(vaddr, level);
        let pte_addr = cur + idx * 8;
        let pte = __vuma_load_u64(pte_addr);
        if (pte & 1) == 0 {
            return 0;
        }
        cur = pte & 4503599627366400;
        level = level - 1;
    }
    // Leaf level (level 0) — read the leaf PTE and return its PA.
    let leaf_idx = x86_idx(vaddr, 0);
    let leaf_addr = cur + leaf_idx * 8;
    let leaf_pte = __vuma_load_u64(leaf_addr);
    if (leaf_pte & 1) == 0 {
        return 0;
    }
    return (leaf_pte & 4503599627366400) | (vaddr & 4095);
}

// ────────────────────────────────────────────────────────────────────────────
// vaddr_parts — decompose a virtual address into page-table indices.
// ────────────────────────────────────────────────────────────────────────────
// Init-style: caller allocates `out` via state_new(VaddrParts), passes by
// reference. Populates out.level3/level2/level1/level0/offset from vaddr.
// The bit extraction is the same for all arches that use 9-bit indices
// (x86_64 4-level, aarch64 4-level, riscv64 Sv39 3-level — all use 9-bit
// indices into 4 KB-page tables holding 512 8-byte PTEs each). For Sv39
// (3-level), the level3 field holds bits 38-30 (which Sv39 calls "level
// 2"); the walk_idx helper below re-derives the index from the level
// number directly, so the field-name-vs-level-number mismatch does not
// affect vmm_map_page / vmm_unmap_page / vmm_translate.
// NOTE: Used only in self-test; production dispatch (vmm_map_page) hands
// the walk off to the per-arch walker (x86_map_page etc.) which uses its
// own native bit extraction.

fn vaddr_parts(out: State<VaddrParts>, vaddr: u64) {
    out.level3 = ((vaddr >> 39) as u32) & 511;
    out.level2 = ((vaddr >> 30) as u32) & 511;
    out.level1 = ((vaddr >> 21) as u32) & 511;
    out.level0 = ((vaddr >> 12) as u32) & 511;
    out.offset = (vaddr & 4095) as u32;
}

// ────────────────────────────────────────────────────────────────────────────
// vmm_walk_idx — extract the 9-bit page-table index for a given level.
// ────────────────────────────────────────────────────────────────────────────
// For walk level L (0..levels-1), the index occupies 9 bits starting at
// bit (12 + 9*L) of the virtual address:
//   L=0 → bits 20-12   (offset is bits 11-0, so the L=0 index is just above)
//   L=1 → bits 29-21
//   L=2 → bits 38-30
//   L=3 → bits 47-39
// This works for both 4-level (x86_64/aarch64, L=3..0) and 3-level Sv39
// (riscv64, L=2..0) — the only difference is the starting level, which
// the caller picks from space.levels.
// NOTE: Used only in self-test; production dispatch (vmm_map_page) hands
// the walk off to the per-arch walker (x86_map_page etc.) which uses its
// own native bit extraction. Kept for self-test compatibility (K2b → R3b).

fn vmm_walk_idx(vaddr: u64, level: u8) -> u32 {
    let sh = (level as u32) * 9 + 12;
    let shifted = vaddr >> sh;
    return (shifted as u32) & 511;
}

// ────────────────────────────────────────────────────────────────────────────
// vmm_map_page — generic map_page; dispatches to the per-arch walker.
// ────────────────────────────────────────────────────────────────────────────
// This is the ONE place arch-dispatch is allowed in the VMM (the HAL
// boundary). Everything above (the VmmSpace struct, this function's
// signature) is arch-independent; everything below (x86_map_page /
// arm_map_page / riscv_map_page) is per-arch.
//
// The dispatch reads space.arch and calls the matching walker with
// (root, vaddr, paddr, flags, levels). The walker owns its own page-table
// walk, intermediate-table allocation (via pmm_alloc in K11), leaf-PTE
// write, and TLB flush. In hosted mode, all walkers are no-op stubs
// (__ffi_fallback_stub), so vmm_map_page is a no-op — the self-test only
// verifies the dispatch happens without crashing.
//
// Init-style: caller allocates `space` via state_new(VmmSpace), sets
// space.root / space.levels / space.arch, passes by reference.

fn vmm_map_page(space: State<VmmSpace>, vaddr: u64, paddr: u64, flags: u64) {
    if space.arch == 0 {
        // x86_64: 4-level paging — call x86_map_page (extern stub in hosted mode).
        x86_map_page(space.root, vaddr, paddr, flags, space.levels);
    } else {
        if space.arch == 1 {
            // aarch64: 4-level paging — call arm_map_page (extern stub).
            arm_map_page(space.root, vaddr, paddr, flags, space.levels);
        } else {
            if space.arch == 2 {
                // riscv64: Sv39 3-level — call riscv_map_page (extern stub).
                riscv_map_page(space.root, vaddr, paddr, flags, space.levels);
            }
        }
    }
}

// ────────────────────────────────────────────────────────────────────────────
// vmm_unmap_page — generic unmap_page; dispatches to the per-arch walker.
// ────────────────────────────────────────────────────────────────────────────
// Same dispatch pattern as vmm_map_page. The per-arch walker clears the
// leaf PTE and flushes the TLB. Does NOT free the physical page (that's
// the caller's responsibility — call pmm_free with the physical address
// returned by vmm_translate BEFORE unmapping, once vmm_translate is real).

fn vmm_unmap_page(space: State<VmmSpace>, vaddr: u64) {
    if space.arch == 0 {
        // x86_64: walk + clear leaf PTE + invlpg.
        x86_unmap_page(space.root, vaddr);
    } else {
        if space.arch == 1 {
            // aarch64: walk + clear leaf PTE + tlbi.
            arm_unmap_page(space.root, vaddr);
        } else {
            if space.arch == 2 {
                // riscv64: walk + clear leaf PTE + sfence_vma.
                riscv_unmap_page(space.root, vaddr);
            }
        }
    }
}

// ────────────────────────────────────────────────────────────────────────────
// vmm_translate — walk page tables to translate a virtual address (W34).
// ────────────────────────────────────────────────────────────────────────────
// W34: real dispatch (no longer a stub returning 0). Reads space.arch
// and calls the matching per-arch translate walker. For arch == 0
// (x86_64), calls the LOCAL x86_translate walker (defined above) which
// walks PML4→PDPT→PD→PT via __vuma_load_u64 and returns the mapped
// paddr. For arch == 1 (aarch64) and arch == 2 (riscv64), the
// arm_translate / riscv_translate walkers are not yet implemented —
// vmm_translate returns 0 for those arches (K11 adds the real walkers
// in arch/aarch64/vmm_hal.vuma and arch/riscv64/vmm_hal.vuma).
//
// Pre-W34 this was a stub that always returned 0. W34 makes it dispatch
// to the real x86_translate, so vmm_translate now returns the actual
// mapped paddr when the page table is set up (verified by the Part 3
// self-test below).
//
// Returns u64 (not State<T>) — no state-typedness propagation issue.

fn vmm_translate(space: State<VmmSpace>, vaddr: u64) -> u64 {
    if space.arch == 0 {
        // x86_64: real walker (W34) — walks PML4→PDPT→PD→PT, returns paddr.
        return x86_translate(space.root, vaddr);
    } else {
        if space.arch == 1 {
            // aarch64: not yet implemented (K11). Return 0.
            return 0;
        } else {
            if space.arch == 2 {
                // riscv64: not yet implemented (K11). Return 0.
                return 0;
            }
        }
    }
    return 0;
}

// ────────────────────────────────────────────────────────────────────────────
// Self-test (the R3b DoD + W34 real-translate DoD).
// ────────────────────────────────────────────────────────────────────────────
// Three parts:
//   1. vaddr_parts + vmm_walk_idx correctness (kept from K2b for self-test
//      compatibility — the bit-extraction math is arch-independent and
//      worth pinning down).
//   2. VmmSpace + vmm_map_page / vmm_unmap_page / vmm_translate dispatch
//      with root=0 (R3b): create a VmmSpace with arch=0 (x86_64),
//      levels=4, root=0, call vmm_map_page / vmm_unmap_page /
//      vmm_translate. W34's real walkers hit the `if root == 0` guard
//      and return 0 / no-op, so this part verifies "didn't crash +
//      returned 0" for the null-root path.
//   3. W34 real-translate: set up a real 4-level page table in
//      ___pmt_buffer (via state_new(PageTableBuf) + alignment + 4
//      __vuma_store_u64 calls to link PML4→PDPT→PD→PT and write the
//      leaf PTE), then call vmm_translate and verify it returns the
//      actual mapped paddr (524288 = 0x80000 for vaddr 0x1000,
//      527036 = 0x80ABC for vaddr 0x1ABC). This proves vmm_translate
//      actually walks the page table (vs. the pre-W34 stub that always
//      returned 0).
//
// vaddr_parts(0x123456789ABC) should yield:
//   level3 = (0x123456789ABC >> 39) & 511 = 36
//   level2 = (0x123456789ABC >> 30) & 511 = 209
//   level1 = (0x123456789ABC >> 21) & 511 = 179
//   level0 = (0x123456789ABC >> 12) & 511 = 393
//   offset = 0x123456789ABC & 4095        = 2748
// (computed via Python: int('0x123456789abc', 16) decomposed as above.)
//
// Returns 0 on pass, 1..9 on the corresponding index-extraction failure,
// 10 on the null-root check, 11/12 on the real-translate check.

fn main() -> i32 {
    // ── Part 1: vaddr_parts + vmm_walk_idx (K2b compatibility) ──────────────
    let parts = state_new(VaddrParts);
    vaddr_parts(parts, 0x123456789ABC);

    if parts.level3 != 36 {
        return 1;
    }
    if parts.level2 != 209 {
        return 2;
    }
    if parts.level1 != 179 {
        return 3;
    }
    if parts.level0 != 393 {
        return 4;
    }
    if parts.offset != 2748 {
        return 5;
    }

    if vmm_walk_idx(0x123456789ABC, 3) != 36 {
        return 6;
    }
    if vmm_walk_idx(0x123456789ABC, 2) != 209 {
        return 7;
    }
    if vmm_walk_idx(0x123456789ABC, 1) != 179 {
        return 8;
    }
    if vmm_walk_idx(0x123456789ABC, 0) != 393 {
        return 9;
    }

    // ── Part 2: VmmSpace + dispatcher (R3b) ─────────────────────────────────
    // x86_64 address space: arch=0, levels=4, root=0.
    // W34: with the real x86_map_page / x86_translate walkers, root=0
    // triggers the null-root guard (if root == 0 { return; } / return 0;)
    // — same pattern as uart.vuma's `if base == 0` guard. The walkers
    // skip the walk entirely and return 0 / no-op, so this part verifies
    // "didn't crash + returned 0" for the null-root path.
    let space = state_new(VmmSpace);
    space.root = 0;
    space.levels = 4;
    space.arch = 0;

    // vmm_map_page dispatches on space.arch → calls local x86_map_page
    // (W34), which hits the root==0 guard and returns (no-op).
    vmm_map_page(space, 0x1000, 0x80000, 0);

    // vmm_unmap_page dispatches on space.arch → calls x86_unmap_page
    // (extern stub, no-op).
    vmm_unmap_page(space, 0x1000);

    // vmm_translate dispatches on space.arch → calls local x86_translate
    // (W34), which hits the root==0 guard and returns 0.
    let pa = vmm_translate(space, 0x1000);
    if pa != 0 {
        return 10;
    }

    // ── Part 3: W34 real-translate (the actual DoD for this wave) ────────
    // Set up a real 4-level page table in ___pmt_buffer and verify
    // vmm_translate walks it correctly via the local x86_translate
    // walker. Same PageTableBuf + alignment approach as vmm_hal.vuma's
    // Part 3 — see that file's comment for why page-alignment is
    // required (the walker's PA mask 0x000FFFFFFFFFF000 strips bits
    // 0-11) and why a single BigBuf with manual alignment is needed
    // (state_new(VmmNode) places each VmmNode on the stack at non-page-
    // aligned offsets).
    let buf = state_new(PageTableBuf);
    let buf_a: u64 = (buf as Address) as u64;
    let rem: u64 = buf_a & 4095;
    let pml4_a: u64 = buf_a - rem + 4096;
    let pdpt_a: u64 = pml4_a + 4096;
    let pd_a: u64 = pml4_a + 8192;
    let pt_a: u64 = pml4_a + 12288;

    // Link the 4 levels for vaddr 0x1000 (idx3=0, idx2=0, idx1=0, idx0=1).
    __vuma_store_u64(pml4_a + 0, pdpt_a | 1);  // PML4[0] → PDPT
    __vuma_store_u64(pdpt_a + 0, pd_a | 1);    // PDPT[0] → PD
    __vuma_store_u64(pd_a + 0, pt_a | 1);      // PD[0]   → PT
    __vuma_store_u64(pt_a + 8, 524288 | 1);    // PT[1] = 0x80000 | Present

    // Point the VmmSpace at the real PML4.
    space.root = pml4_a;
    space.levels = 4;
    space.arch = 0;

    // vmm_translate(space, 0x1000) → x86_translate(pml4_a, 0x1000)
    // Walk: PML4[0]→PDPT, PDPT[0]→PD, PD[0]→PT, PT[1]=0x80001 (present),
    // leaf PA = 0x80001 & 0x000FFFFFFFFFF000 = 0x80000, offset = 0,
    // result = 0x80000 | 0 = 524288.
    let pa2 = vmm_translate(space, 4096);
    if pa2 != 524288 {
        return 11;
    }

    // vmm_translate(space, 0x1ABC) → same leaf, different offset.
    // offset = 0x1ABC & 0xFFF = 0xABC = 2748.
    // result = 0x80000 | 0xABC = 0x80ABC = 527036.
    let pa3 = vmm_translate(space, 6844);
    if pa3 != 527036 {
        return 12;
    }

    return 0;
}
