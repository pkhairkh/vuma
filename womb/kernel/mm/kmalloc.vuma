fn slab_get_free_top(slabs: State<SlabState>, idx: u32) -> u32 {
    let off = idx * 4;
    let v: u32 = 0;
    let i = 0;
    while i < 4 {
        let sh = i * 8;
        let byte_off = off + i;
        let b = slabs.free_tops[byte_off] as u32;
        v = v + (b << sh);
        i = i + 1;
    }
    return v;
}

fn slab_set_free_top(slabs: State<SlabState>, idx: u32, val: u32) {
    let off = idx * 4;
    let i = 0;
    while i < 4 {
        let sh = i * 8;
        let b = (val >> sh) & 255;
        let byte_off = off + i;
        slabs.free_tops[byte_off] = b as u8;
        i = i + 1;
    }
}

// ────────────────────────────────────────────────────────────────────────────
// Byte-array pack/unpack helpers — u8 fields (inited).
// ────────────────────────────────────────────────────────────────────────────

fn slab_get_inited(slabs: State<SlabState>, idx: u32) -> u8 {
    return slabs.inited[idx];
}

fn slab_set_inited(slabs: State<SlabState>, idx: u32, val: u8) {
    slabs.inited[idx] = val;
}

// ────────────────────────────────────────────────────────────────────────────
// Byte-array pack/unpack helpers — u64 pages array (W35).
// ────────────────────────────────────────────────────────────────────────────
// pages layout: 9 slabs × 64 pages × 8 bytes = 4608 bytes total. Slab
// `slab_idx`'s page array starts at byte offset `slab_idx * 512`; page
// `page_idx`'s base is at byte offset `slab_idx * 512 + page_idx * 8`.

fn slab_get_page(slabs: State<SlabState>, slab_idx: u32, page_idx: u32) -> u64 {
    let off = slab_idx * 512 + page_idx * 8;
    let v: u64 = 0;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let byte_off = off + i;
        let b = slabs.pages[byte_off] as u64;
        v = v + (b << sh);
        i = i + 1;
    }
    return v;
}

fn slab_set_page(slabs: State<SlabState>, slab_idx: u32, page_idx: u32, val: u64) {
    let off = slab_idx * 512 + page_idx * 8;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let b = (val >> sh) & 255;
        let byte_off = off + i;
        slabs.pages[byte_off] = b as u8;
        i = i + 1;
    }
}

// ────────────────────────────────────────────────────────────────────────────
// Byte-array pack/unpack helpers — u32 page_counts (W35).
// ────────────────────────────────────────────────────────────────────────────

fn slab_get_page_count(slabs: State<SlabState>, idx: u32) -> u32 {
    let off = idx * 4;
    let v: u32 = 0;
    let i = 0;
    while i < 4 {
        let sh = i * 8;
        let byte_off = off + i;
        let b = slabs.page_counts[byte_off] as u32;
        v = v + (b << sh);
        i = i + 1;
    }
    return v;
}

fn slab_set_page_count(slabs: State<SlabState>, idx: u32, val: u32) {
    let off = idx * 4;
    let i = 0;
    while i < 4 {
        let sh = i * 8;
        let b = (val >> sh) & 255;
        let byte_off = off + i;
        slabs.page_counts[byte_off] = b as u8;
        i = i + 1;
    }
}

// ────────────────────────────────────────────────────────────────────────────
// Byte-array pack/unpack helpers — u16 free-stack entries.
// ────────────────────────────────────────────────────────────────────────────
// free_stacks layout: 9 slabs × 1024 bytes/slab = 9216 bytes total. Each
// slab owns a contiguous 1024-byte slice holding up to 512 u16 slot indices
// (2 bytes each, little-endian). Slab `slab_idx`'s free-stack starts at
// byte offset `slab_idx * 1024`; stack slot `stack_idx` is at byte offset
// `slab_idx * 1024 + stack_idx * 2`.

fn slab_free_stack_get(slabs: State<SlabState>, slab_idx: u32, stack_idx: u32) -> u32 {
    let off = slab_idx * 1024 + stack_idx * 2;
    let lo = slabs.free_stacks[off] as u32;
    let hi = slabs.free_stacks[off + 1] as u32;
    return lo + (hi << 8);
}

fn slab_free_stack_set(slabs: State<SlabState>, slab_idx: u32, stack_idx: u32, val: u32) {
    let off = slab_idx * 1024 + stack_idx * 2;
    let lo = val & 255;
    let hi = (val >> 8) & 255;
    slabs.free_stacks[off] = lo as u8;
    slabs.free_stacks[off + 1] = hi as u8;
}

// ────────────────────────────────────────────────────────────────────────────
// Size-class helpers.
// ────────────────────────────────────────────────────────────────────────────

// Round up to the next power of 2 (minimum 8). Sizes > 2048 round up to 4096.
fn kmalloc_roundup(size: u64) -> u32 {
    let s = size;
    if s <= 8 { return 8; }
    if s <= 16 { return 16; }
    if s <= 32 { return 32; }
    if s <= 64 { return 64; }
    if s <= 128 { return 128; }
    if s <= 256 { return 256; }
    if s <= 512 { return 512; }
    if s <= 1024 { return 1024; }
    return 4096;
}

// Get the slab index for a given size (0=8B, 1=16B, ..., 8=4096B).
fn kmalloc_slab_idx(size: u64) -> u32 {
    let s = kmalloc_roundup(size);
    let idx = 0;
    if s == 8 { idx = 0; }
    if s == 16 { idx = 1; }
    if s == 32 { idx = 2; }
    if s == 64 { idx = 3; }
    if s == 128 { idx = 4; }
    if s == 256 { idx = 5; }
    if s == 512 { idx = 6; }
    if s == 1024 { idx = 7; }
    if s == 4096 { idx = 8; }
    return idx;
}

// Get the slot size (in bytes) for a given slab index.
fn slab_slot_size_for_idx(idx: u32) -> u32 {
    if idx == 0 { return 8; }
    if idx == 1 { return 16; }
    if idx == 2 { return 32; }
    if idx == 3 { return 64; }
    if idx == 4 { return 128; }
    if idx == 5 { return 256; }
    if idx == 6 { return 512; }
    if idx == 7 { return 1024; }
    return 4096;
}

// ────────────────────────────────────────────────────────────────────────────
// slab_init — initialize a slab for size class `idx`.
// ────────────────────────────────────────────────────────────────────────────
// Allocate the first 4096-byte page via pmm_alloc(pool, pmm, 0) (W35).
// Set up the bookkeeping (base, slot_size, n_slots = slots-per-page,
// free_heads=0, n_used=0, free_tops=0, pages[0]=base, page_count=1,
// inited=1). On pmm_alloc failure (returns 0), fall back to mmap (hosted
// mode); on mmap failure too (base == MAP_FAILED = 0xFFFFFFFFFFFFFFFF),
// leave inited=0 so kmalloc treats the slab as uninitialized and returns
// 0 (OOM).
//
// Init-style API (caller allocates `slabs`, `pool`, `pmm` via state_new,
// passes by reference). The slab is initialized lazily — kmalloc calls
// slab_init on the first allocation to each size class.

fn slab_init(slabs: State<SlabState>, pool: State<FlatPool>, pmm: State<PmmState>, idx: u32) {
    let slot_size = slab_slot_size_for_idx(idx);
    // W35: obtain the first page via pmm_alloc (real buddy allocator in
    // K11 bare-metal mode; forward-declared empty-body stub returning 0
    // in hosted mode — fall back to mmap below). VUMA variables are
    // mutable by default (no `mut` keyword — assignment just works).
    let base: u64 = pmm_alloc(pool, pmm, 0);
    if base == 0 {
        // Hosted-mode fallback: ask the host OS for a 4096-byte anonymous
        // private page via mmap. This keeps the self-test working when
        // pmm_alloc is not wired (hosted mode has no real PMM).
        let base_addr: Address = mmap(0 as Address, 4096, 3, 34, -1, 0);
        base = base_addr as u64;
        // Check for MAP_FAILED (mmap returns -1 on error).
        if base == 0xFFFFFFFFFFFFFFFF {
            // mmap failed — leave inited=0.
            return;
        }
    }
    slab_set_base(slabs, idx, base);
    slab_set_page(slabs, idx, 0, base);   // W35: pages[idx][0] = first page
    slab_set_page_count(slabs, idx, 1);   // W35: page_count = 1
    slab_set_slot_size(slabs, idx, slot_size);
    slab_set_n_slots(slabs, idx, 4096 / slot_size);  // slots per page
    slab_set_free_head(slabs, idx, 0);   // next bump-counter = 0 (global)
    slab_set_n_used(slabs, idx, 0);
    slab_set_free_top(slabs, idx, 0);    // free-stack empty
    slab_set_inited(slabs, idx, 1);
}

// ────────────────────────────────────────────────────────────────────────────
// kmalloc — allocate `size` bytes. Returns the slot's address, or 0 on OOM.
// ────────────────────────────────────────────────────────────────────────────
// Rounds `size` up to the next power of 2, finds the corresponding slab,
// lazily initializes it if needed, then pops a slot from the free-stack if
// non-empty or bumps the next-slot counter. When the bump counter reaches
// `page_count * n_slots` (W35: slab full across ALL pages), calls
// pmm_alloc to grow the slab by one page (falls back to mmap in hosted
// mode). Returns 0 if growth fails (pmm_alloc + mmap both return 0 /
// MAP_FAILED, or page_count already at the 64-page cap).
//
// Init-style API: caller allocates `slabs`, `pool`, `pmm` via state_new,
// passes by reference.

fn kmalloc(slabs: State<SlabState>, pool: State<FlatPool>, pmm: State<PmmState>, size: u64) -> u64 {
    let idx = kmalloc_slab_idx(size);
    // Lazy init.
    if slab_get_inited(slabs, idx) == 0 {
        slab_init(slabs, pool, pmm, idx);
    }
    if slab_get_inited(slabs, idx) == 0 {
        // slab_init failed (pmm_alloc + mmap both failed).
        return 0;
    }

    let slot_idx = 0;
    let top = slab_get_free_top(slabs, idx);
    if top > 0 {
        // Pop from free-stack.
        let new_top = top - 1;
        slot_idx = slab_free_stack_get(slabs, idx, new_top);
        slab_set_free_top(slabs, idx, new_top);
    } else {
        // Bump the next-slot counter.
        let next = slab_get_free_head(slabs, idx);
        let n_slots_per_page = slab_get_n_slots(slabs, idx);
        let page_count = slab_get_page_count(slabs, idx);
        let total_slots = page_count * n_slots_per_page;
        if next >= total_slots {
            // W35: slab full across all current pages — try to grow.
            if page_count >= 64 {
                // Page-array cap reached — truly OOM.
                return 0;
            }
            let new_page: u64 = pmm_alloc(pool, pmm, 0);
            if new_page == 0 {
                // Hosted-mode fallback: mmap a new page.
                let base_addr: Address = mmap(0 as Address, 4096, 3, 34, -1, 0);
                new_page = base_addr as u64;
                if new_page == 0xFFFFFFFFFFFFFFFF {
                    // pmm_alloc + mmap both failed — OOM.
                    return 0;
                }
            }
            slab_set_page(slabs, idx, page_count, new_page);
            slab_set_page_count(slabs, idx, page_count + 1);
            // total_slots is now (page_count + 1) * n_slots_per_page;
            // `next` is still valid (it was == old total_slots, which is
            // the first slot of the new page).
        }
        slot_idx = next;
        slab_set_free_head(slabs, idx, next + 1);
    }

    // Compute the slot's address. The slot_idx is a GLOBAL index across
    // all of the slab's pages: page_idx = slot_idx / n_slots_per_page;
    // slot_in_page = slot_idx % n_slots_per_page.
    let n_slots_per_page = slab_get_n_slots(slabs, idx);
    let page_idx = slot_idx / n_slots_per_page;
    let slot_in_page = slot_idx % n_slots_per_page;
    let base = slab_get_page(slabs, idx, page_idx);
    let slot_size = slab_get_slot_size(slabs, idx);
    let addr = base + (slot_in_page as u64) * (slot_size as u64);
    slab_set_n_used(slabs, idx, slab_get_n_used(slabs, idx) + 1);
    return addr;
}

// ────────────────────────────────────────────────────────────────────────────
// kfree — return the slot at `addr` to its slab's free-stack.
// ────────────────────────────────────────────────────────────────────────────
// Walks the 9 slabs; for each initialized slab, walks ALL of its allocated
// pages (W35: a slab may own up to 64 pages) to find the one whose range
// contains `addr` (i.e. base <= addr < base + 4096 AND (addr - base) is a
// multiple of slot_size). Computes the GLOBAL slot index
// `page_idx * n_slots_per_page + slot_in_page`, pushes it onto the slab's
// free-stack, and decrements n_used. If `addr` does not match any
// initialized slab's page, the function is a no-op (silent ignore — the
// kernel has no good way to recover from a double-free or stray free in
// hosted mode).
//
// Init-style API: caller allocates `slabs` via state_new(SlabState), passes
// by reference.

fn kfree(slabs: State<SlabState>, addr: u64) {
    let i = 0;
    while i < 9 {
        if slab_get_inited(slabs, i) == 1 {
            let slot_size = slab_get_slot_size(slabs, i);
            let n_slots_per_page = slab_get_n_slots(slabs, i);
            let page_count = slab_get_page_count(slabs, i);
            // W35: scan every page the slab owns, not just the first.
            let p = 0;
            while p < page_count {
                let base = slab_get_page(slabs, i, p);
                // Range check: base <= addr < base + 4096.
                if addr >= base {
                    let span = (n_slots_per_page as u64) * (slot_size as u64);
                    let end = base + span;
                    if addr < end {
                        // Alignment check: (addr - base) must be a multiple
                        // of slot_size (the caller passed a slot-aligned addr).
                        let offset = addr - base;
                        if (offset % (slot_size as u64)) == 0 {
                            let slot_in_page = (offset / (slot_size as u64)) as u32;
                            // Global slot index across all pages.
                            let global_slot_idx = p * n_slots_per_page + slot_in_page;
                            // Push onto the free-stack (if there's room).
                            let top = slab_get_free_top(slabs, i);
                            if top < 512 {
                                slab_free_stack_set(slabs, i, top, global_slot_idx);
                                slab_set_free_top(slabs, i, top + 1);
                                let used = slab_get_n_used(slabs, i);
                                if used > 0 {
                                    slab_set_n_used(slabs, i, used - 1);
                                }
                            }
                            return;
                        }
                    }
                }
                p = p + 1;
            }
        }
        i = i + 1;
    }
    // Not found in any slab — silent ignore (see function header).
}

// ────────────────────────────────────────────────────────────────────────────
// Self-test (the K2f DoD, extended for W35 dynamic growth).
// ────────────────────────────────────────────────────────────────────────────
// Allocate from a few size classes, free, and re-allocate to confirm the
// free-stack reuse path. Verifies:
//   1. kmalloc(10) returns a non-zero address (the 16 B slab — 10 rounds
//      up to 16, slab_idx=1).
//   2. The address lies within the 16 B slab's first page (base <= addr <
//      base + n_slots_per_page * slot_size, and addr is slot-aligned).
//   3. n_used is 1 after the first alloc; page_count is 1.
//   4. kfree brings n_used back to 0 and pushes the slot onto the
//      free-stack (free_top == 1).
//   5. The next kmalloc of the same size reuses the freed slot (returns
//      the same address, free_top goes back to 0, n_used goes back to 1).
//   6. A second slab (kmalloc(4096) → 4096 B slab, slab_idx=8) is also
//      initialized and returns a distinct address.
//   7. W35: draining the 16 B slab's first page (256 slots) triggers a
//      pmm_alloc/mmap growth — page_count goes 1 → 2 and the next alloc
//      lands in the second page (addr >= pages[1], addr < pages[1]+4096).
//
// All paths exercise the lazy-init + bump + free-stack-reuse + dynamic-
// growth code paths without crashes or PMT violations. Returns 0 on pass.

fn main() -> i32 {
    let slabs = state_new(SlabState);
    // W35: kmalloc now takes (slabs, pool, pmm) — pmm_alloc is a forward-
    // declared VUMA fn (empty body in hosted mode, returns 0); slab_init
    // falls back to mmap so the self-test still works. state_new gives
    // uninitialised bytes; we don't call pmm_init because pmm_alloc is a
    // no-op stub in hosted mode and the pool/pmm state is never read by
    // the stub. In K11 bare-metal mode the caller would call pmm_init
    // here to populate the buddy allocator.
    let pool = state_new(FlatPool);
    let pmm = state_new(PmmState);

    // 1. First alloc: 10 rounds up to 16, slab_idx=1.
    let p1 = kmalloc(slabs, pool, pmm, 10);
    if p1 == 0 { return 1; }

    // 2. p1 must lie in the 16 B slab's first page.
    if slab_get_inited(slabs, 1) == 0 { return 2; }
    let base1 = slab_get_base(slabs, 1);
    let slot_size1 = slab_get_slot_size(slabs, 1);
    let n_slots1 = slab_get_n_slots(slabs, 1);
    if slot_size1 != 16 { return 3; }
    if n_slots1 != 256 { return 4; }       // 4096 / 16
    if p1 < base1 { return 5; }
    let end1 = base1 + (n_slots1 as u64) * (slot_size1 as u64);
    if p1 >= end1 { return 6; }
    let off1 = p1 - base1;
    if (off1 % (slot_size1 as u64)) != 0 { return 7; }

    // 3. n_used should be 1; page_count should be 1 (W35).
    if slab_get_n_used(slabs, 1) != 1 { return 8; }
    // free-stack should be empty.
    if slab_get_free_top(slabs, 1) != 0 { return 9; }
    if slab_get_page_count(slabs, 1) != 1 { return 23; }

    // 4. Free p1 — pushes onto free-stack, decrements n_used.
    kfree(slabs, p1);
    if slab_get_n_used(slabs, 1) != 0 { return 10; }
    if slab_get_free_top(slabs, 1) != 1 { return 11; }

    // 5. Next kmalloc(10) should reuse the freed slot (LIFO).
    let p2 = kmalloc(slabs, pool, pmm, 10);
    if p2 == 0 { return 12; }
    if p2 != p1 { return 13; }              // reused
    if slab_get_n_used(slabs, 1) != 1 { return 14; }
    if slab_get_free_top(slabs, 1) != 0 { return 15; }

    // 6. Different size class (4096 B, slab_idx=8).
    let p3 = kmalloc(slabs, pool, pmm, 4096);
    if p3 == 0 { return 16; }
    if slab_get_inited(slabs, 8) == 0 { return 17; }
    if slab_get_slot_size(slabs, 8) != 4096 { return 18; }
    if slab_get_n_slots(slabs, 8) != 1 { return 19; }   // 4096 / 4096
    if p3 == p2 { return 20; }              // distinct from p2 (different slab)

    // 7. W35: drain the 16 B slab's first page (256 slots) and verify
    //    dynamic growth. p2 already occupies slot 0; allocate 255 more
    //    16 B slots to fill page 0 (free_head goes 1..256). The 257th
    //    alloc must trigger pmm_alloc/mmap growth — page_count 1 → 2 —
    //    and return an address in the new page.
    let k = 0;
    while k < 255 {
        let pa = kmalloc(slabs, pool, pmm, 16);
        if pa == 0 { return 24; }
        k = k + 1;
    }
    // Now page 0 is full (256 slots used: p2 + 255 more). page_count
    // should still be 1.
    if slab_get_page_count(slabs, 1) != 1 { return 25; }
    if slab_get_free_head(slabs, 1) != 256 { return 26; }
    // The next alloc must grow the slab.
    let pg2 = kmalloc(slabs, pool, pmm, 16);
    if pg2 == 0 { return 27; }
    if slab_get_page_count(slabs, 1) != 2 { return 28; }  // grew
    // pg2 must lie in page 1, not page 0.
    let page1_base = slab_get_page(slabs, 1, 1);
    if page1_base == 0 { return 29; }
    if pg2 < page1_base { return 30; }
    let page1_end = page1_base + 4096;
    if pg2 >= page1_end { return 31; }
    // free_head must be 257 (slot 0 of page 1 = global slot 256).
    if slab_get_free_head(slabs, 1) != 257 { return 32; }

    // Cleanup (not strictly required — the host reclaims mmap'd pages on
    // process exit, same as arena_alloc'd buffers in womb/alloc/arena.vuma).
    kfree(slabs, p2);
    kfree(slabs, p3);
    kfree(slabs, pg2);
    if slab_get_n_used(slabs, 1) != 255 { return 21; }  // 256 - 1 (p2 freed)
    if slab_get_n_used(slabs, 8) != 0 { return 22; }

    return 0;
}
