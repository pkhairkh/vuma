// ═══════════════════════════════════════════════════════════════════════════
// womb/kernel/mm/kmalloc.vuma
// VWK Kernel Slab Allocator — power-of-2 free-list allocator over mmap (PMT-pure).
// ═══════════════════════════════════════════════════════════════════════════
//
// A slab allocator for small kernel allocations. Rounds the requested size up
// to the next power of 2 in {8, 16, 32, 64, 128, 256, 512, 1024, 4096}
// (9 size classes), then allocates from the corresponding slab. Each slab
// owns exactly one 4096-byte page obtained from mmap and splits it into
// N = (4096 / slot_size) equal-sized slots.
//
// Per-class slot counts:
//     8 B  → 512 slots      16 B → 256 slots      32 B → 128 slots
//     64 B →  64 slots     128 B →  32 slots     256 B →  16 slots
//    512 B →   8 slots    1024 B →   4 slots    4096 B →   1 slot
//
// Allocation policy: pop from the slab's free-stack if non-empty, else bump
// the next-slot counter. Freeing pushes the slot index back onto the slab's
// free-stack. When both the free-stack is empty AND the next-slot counter
// has reached n_slots, the slab is full and kmalloc returns 0 (OOM).
//
// Build & run self-test (hosted x86_64):
//     ./target/release-fast/compile_dump womb/kernel/mm/kmalloc.vuma \
//         /tmp/kmalloc.bin x86_64 --verify
//     /tmp/kmalloc.bin ; echo "exit=$?"
// Expected exit: 0
//
// ── Arch-independence (R3c audit) ───────────────────────────────────────────
// kmalloc is 100% arch-independent.
//
// Verified R3c: zero `if arch == ...`, zero arch-conditional code, zero
// arch-specific constants. The slab allocator (9 power-of-2 size classes,
// per-class free-stack, lazy slab_init) is a pure PMT transform over
// State<SlabState> — it tracks slot indices and base addresses as opaque
// u64 values and never inspects arch-specific page-table or PTE format.
// Compiles identically for all 19 backends.
//
// NOTE on the mmap/munmap extern block below: those are HOST-OS syscalls
// (Linux mmap=9 / munmap=11), NOT CPU-arch-specific calls. The same extern
// signature works on every backend's hosted mode (the linker resolves
// unresolved externs to __ffi_fallback_stub on backends that don't
// pre-register mmap/munmap). In K11 bare-metal mode, mmap/munmap are
// replaced by pmm_alloc/pmm_free (also arch-independent — see
// womb/kernel/mm/pmm.vuma's R3a audit). The slab allocator never branches
// on arch; the R3b VMM (womb/kernel/mm/vmm.vuma) is the ONLY mm/ file
// that branches on arch (via VmmSpace.arch → x86/arm/riscv walker
// dispatch — the HAL boundary).
//
// ── PMT discipline ─────────────────────────────────────────────────────────
// NO `*ptr`, `&x`, `allocate`, or `free` anywhere in this file. All storage
// lives in ___pmt_buffer-backed State<T> buffers:
//   - State<SlabState> — per-class bookkeeping (base, slot_size, n_slots,
//     n_used, free-stack, free-top, init flag — one slot per size class).
// The CALLER allocates SlabState via state_new(SlabState) and passes it by
// reference to kmalloc / kfree / slab_init (init-style API — see "Why
// init-style?" in womb/kernel/mm/pmm.vuma for the codegen rationale).
//
// The slab pages themselves are obtained from the host via the mmap extern
// (pre-registered on x86_64 as syscall 9 — see
// src/codegen/src/x86_64/mod.rs::build_runtime_syscall_stubs). The slab
// allocator never dereferences these addresses; it only hands them back to
// the caller (kmalloc's return value) or to munmap (on slab destruction,
// which is not yet implemented — the slabs are leaked at process exit, the
// same as arena_alloc'd buffers in womb/alloc/arena.vuma). The free-list
// is tracked in the SlabState's flat byte arrays, NOT in the slab pages'
// memory (which would require pointer derefs — a PMT violation).
//
// ── Why a flat byte-array layout? ───────────────────────────────────────────
// The K2f contract specified a `Slab` struct held in a `[Slab; 9]` array,
// but VUMA's current codegen (src/pipeline.rs::flatten_expr, Expr::Index
// arm) does NOT scale the index by the element size for non-u8 array
// element types — every `state.array[i]` is lowered to `*(base_addr + i)`
// with a U8 Load/Store, and the same arm hardcodes `ty: None` on the
// AccessNode, which the IR-lowering path defaults to U8. (Verified during
// K2a via /home/z/probes/probe_u32_index3.vuma.) So a `[Slab; 9]` array
// would have all 9 slabs aliasing the same 1-byte slot at offset 0.
//
// Workaround (per the K2f contract's "REVISED SlabState"): store each
// per-class field in a separate flat byte array, with pack/unpack helpers
// that read/write the multi-byte little-endian values byte-by-byte. This
// is byte-identical to the K2a pmm.vuma `FlatPool` pattern (bases / orders
// / nexts) — same codegen limitation, same workaround.
//
// ── Deviation: extra free_stacks / free_tops / inited fields ────────────────
// The K2f contract's REVISED SlabState has 5 fields (bases / slot_sizes /
// free_heads / n_slots / n_used). The contract's prose describes the free
// list as "each free slot's first 8 bytes hold the index of the next free
// slot (or 256 = end)" — i.e. the canonical in-place linked-list slab.
// That design REQUIRES dereferencing the slab page (writing the next-free
// index into the freed slot's first 8 bytes), which is a PMT violation
// (no `*ptr` / no Address→State<T> cast exists in VUMA today — see "Why
// init-style?" note about no `as State<T>` casts).
//
// Workaround: store the free list OUTSIDE the slab page, in a per-class
// free-stack array (free_stacks: 9 slabs × 512 u16 slots = 9216 bytes;
// free_tops: 9 u32 stack-top counters = 36 bytes). Allocation pops from
// the free-stack; freeing pushes back. The semantic is identical to the
// in-place linked-list (LIFO reuse), just stored in the bookkeeping
// buffer instead of the slab page. The `free_heads` field is repurposed
// from "first free slot index" to "next-bump-counter" — i.e. the next
// slot index that has never been allocated (the bump allocator's cursor).
// Once `free_heads == n_slots`, all slots have been bumped at least once
// and subsequent allocations must come from the free-stack. An `inited`
// field supports lazy initialization (slab_init is called on the first
// kmalloc to each size class, not by the caller up-front — see slab_init
// below). When the codegen gains Address→State<T> casts and the slab
// pages can hold their own free-lists, this file can collapse back to
// the contract's 5-field layout.
//
// ── VUMA has no `import` ────────────────────────────────────────────────────
// This file is self-contained. If a future kmain.vuma wants to call
// kmalloc / kfree, it must re-declare the SlabState layout and the
// mmap / munmap externs byte-identically (same pattern as console.vuma
// re-declaring its extern `write`). The mmap / munmap extern signatures
// here are byte-identical to womb/kernel/arch/x86_64/trampoline.vuma and
// womb/kernel/hosted/host.vuma.

// ────────────────────────────────────────────────────────────────────────────
// Externs — pre-registered on x86_64 as real syscalls (mmap=9, munmap=11).
// On other backends they resolve to __ffi_fallback_stub (returns 0) — the
// slab allocator's self-test only runs on x86_64 hosted mode.
//
// mmap/munmap are kept as a HOSTED-MODE FALLBACK for slab_init / kmalloc
// growth: when pmm_alloc (re-declared below as a VUMA fn) returns 0 —
// which it does in hosted mode because the PMM is not wired — slab_init
// falls back to mmap to obtain a real page from the host OS so the
// self-test still passes. In K11 bare-metal mode pmm_alloc resolves to
// womb/kernel/mm/pmm.vuma::pmm_alloc (real buddy allocator) and the
// mmap fallback is never taken (pmm_alloc returns a real paddr).
// ────────────────────────────────────────────────────────────────────────────
extern "C" {
    // mmap(addr, length, prot, flags, fd, offset) — anonymous private mapping.
    //   prot  = 3 (PROT_READ | PROT_WRITE)
    //   flags = 34 (MAP_PRIVATE | MAP_ANONYMOUS)
    //   fd    = -1, offset = 0  (anonymous)
    // Returns the base address of the mapped region, or MAP_FAILED (-1
    // cast to Address) on error.
    fn mmap(addr: Address, length: u64, prot: i32, flags: i32, fd: i32, offset: i64) -> Address;
    // munmap(addr, length) — release the mapping. Returns 0 on success.
    fn munmap(addr: Address, length: u64) -> i64;
}

// ────────────────────────────────────────────────────────────────────────────
// W35: dynamic slab growth.
// ────────────────────────────────────────────────────────────────────────────
// Pre-W35 each slab owned exactly ONE 4096-byte page; when the bump
// counter reached n_slots the slab was full and kmalloc returned 0 (OOM).
// W35 adds a `pages: [u64; 64]` array + `page_count: u32` per slab so a
// slab can grow dynamically: when the bump counter reaches
// `page_count * (4096 / slot_size)`, kmalloc calls pmm_alloc to obtain a
// fresh 4 KB page and appends it to the pages array (page_count++). Up to
// 64 pages per slab = 256 KB per size class (for the 8 B class: 64 pages
// × 512 slots = 32768 slots; for the 4096 B class: 64 pages × 1 slot =
// 64 slots). The bump counter `free_heads` is now a GLOBAL slot index
// across all of the slab's pages; the per-page slot index is
// `slot_idx % slots_per_page` and the page index is `slot_idx / slots_per_page`.
//
// slab_init now calls pmm_alloc(pool, pmm, 0) for the FIRST page (per the
// W35 task spec). In hosted mode pmm_alloc is a forward-declared VUMA fn
// with an empty body (returns 0); slab_init then falls back to mmap so
// the self-test still works. In K11 bare-metal mode pmm_alloc is the
// real buddy allocator and the fallback is never taken.
//
// kfree now scans ALL of the slab's pages (not just the first) to find
// which page contains `addr`, since the slab may span multiple pages.

// ────────────────────────────────────────────────────────────────────────────
// Re-declared PMM layouts (byte-identical to womb/kernel/mm/pmm.vuma).
// ────────────────────────────────────────────────────────────────────────────
// VUMA has no `import`. To call pmm_alloc from this file we re-declare
// its State<T> param layouts byte-identically to pmm.vuma (a mismatch
// would silently produce different field offsets in different
// translation units). pmm_alloc itself is re-declared below as a VUMA
// `fn` (NOT extern "C" — per the W35 task spec, pmm_alloc/vmm_map are
// VUMA functions). In hosted mode the forward declaration has an empty
// body (returns 0); in K11 bare-metal mode the linker resolves it
// against womb/kernel/mm/pmm.vuma's real implementation.

layout FlatPool = {
    bases: [u8; 32768],  // 4096 * 8 bytes — u64 base address per node, LE-packed
    orders: [u8; 4096],  // 4096 bytes     — u8 buddy order per node
    nexts: [u8; 32768],  // 4096 * 8 bytes — u64 next-node index per node, LE-packed
    count: u32,
    free_head: u32,
}

layout PmmState = {
    pool: u64,
    free_lists: [u8; 88], // 11 * 8 bytes — head FreeNode index per order, 4096 = empty
    total_pages: u64,
    free_pages: u64,
}

// pmm_alloc — forward-declared VUMA fn matching pmm.vuma's signature.
// Returns the physical address of a fresh 4 KB page (order 0), or 0 on
// OOM. In hosted mode this is an empty body (returns 0); slab_init /
// kmalloc growth fall back to mmap. In K11 bare-metal mode this resolves
// to womb/kernel/mm/pmm.vuma::pmm_alloc (real buddy allocator).
fn pmm_alloc(pool: State<FlatPool>, pmm: State<PmmState>, order: u8) -> u64;

// ────────────────────────────────────────────────────────────────────────────
// Layouts (flat byte arrays per the K2f contract's REVISED SlabState).
// ────────────────────────────────────────────────────────────────────────────

// Slab bookkeeping for 9 size classes (8 B, 16 B, ..., 4096 B). Each
// per-class field is a flat byte array indexed by `slab_idx * width + byte`,
// packed little-endian. The free_stacks field holds 9 per-class free-stacks
// of 512 u16 slot indices each (1024 bytes per slab × 9 slabs = 9216 bytes).
//
// Field semantics (per the contract's REVISED layout, with the documented
// free_stacks / free_tops / inited additions — see "Deviation" above):
//   - bases[i]       = u64 base address of slab i's mmap'd page (or 0 if
//                      the slab is uninitialized).
//   - slot_sizes[i]  = u32 slot size for slab i (8, 16, ..., 4096).
//   - free_heads[i]  = u32 next-bump-counter: the next slot index that has
//                      never been allocated. Starts at 0, increments to
//                      n_slots. Once equal to n_slots, all slots have been
//                      bumped and allocations come from the free-stack.
//                      (Repurposed from the contract's "first free slot"
//                      meaning — see "Deviation" above.)
//   - n_slots[i]     = u32 total slot count for slab i (4096 / slot_size).
//   - n_used[i]      = u32 currently allocated slot count for slab i.
//   - free_stacks[i] = u16[512] LIFO stack of freed-but-not-reallocated
//                      slot indices for slab i. Empty when free_tops[i]=0.
//   - free_tops[i]   = u32 stack-top for slab i's free-stack (count of
//                      entries currently on the stack, 0..512).
//   - inited[i]      = u8 init flag: 0 = slab_init not yet called, 1 = slab
//                      is initialized and ready to serve allocations.
//   - pages[i]       = u64[64] page-base array: the physical/mmap'd base
//                      addresses of the slab's allocated pages.
//                      pages[i][0] mirrors bases[i] (the first page);
//                      pages[i][1..page_count-1] are the dynamically-grown
//                      pages added by kmalloc when the slab fills up.
//                      Up to 64 pages per slab (W35 dynamic growth).
//   - page_counts[i] = u32 count of pages currently allocated for slab i
//                      (1 after slab_init, up to 64). When the bump
//                      counter reaches page_counts[i] * n_slots[i], the
//                      slab is full and kmalloc calls pmm_alloc to grow.
layout SlabState = {
    bases: [u8; 72],         // 9 * 8 bytes  — u64 base per slab, LE-packed
    slot_sizes: [u8; 36],    // 9 * 4 bytes  — u32 slot_size per slab, LE
    free_heads: [u8; 36],    // 9 * 4 bytes  — u32 next-bump-counter per slab, LE
    n_slots: [u8; 36],       // 9 * 4 bytes  — u32 slots-per-page per slab, LE
    n_used: [u8; 36],        // 9 * 4 bytes  — u32 used slots per slab, LE
    free_stacks: [u8; 9216], // 9 * 512 * 2  — u16[512] free-stack per slab, LE
    free_tops: [u8; 36],     // 9 * 4 bytes  — u32 free-stack top per slab, LE
    inited: [u8; 9],         // 9 bytes      — u8 init flag per slab
    pages: [u8; 4608],       // 9 * 64 * 8   — u64[64] page-base array per slab, LE
    page_counts: [u8; 36],   // 9 * 4 bytes  — u32 page_count per slab, LE
}

// ────────────────────────────────────────────────────────────────────────────
// Constants (documented inline; VUMA has no top-level `const` for non-extern
// use in this code path).
// ────────────────────────────────────────────────────────────────────────────
// PAGE_SIZE       = 4096                 (one page per slab)
// NUM_SLABS       = 9                    (size classes 8 B .. 4096 B)
// MAX_SLOTS       = 512                  (max slots per slab — for 8 B class)
// PROT_READ|WRITE = 3
// MAP_PRIVATE|ANON= 34
// MAP_FAILED      = 0xFFFFFFFFFFFFFFFF   (mmap's error sentinel)

// ────────────────────────────────────────────────────────────────────────────
// Byte-array pack/unpack helpers — u64 fields (bases).
// ────────────────────────────────────────────────────────────────────────────

// Read the u64 base address for slab `idx` from SlabState.bases.
fn slab_get_base(slabs: State<SlabState>, idx: u32) -> u64 {
    let off = idx * 8;
    let v: u64 = 0;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let byte_off = off + i;
        let b = slabs.bases[byte_off] as u64;
        v = v + (b << sh);
        i = i + 1;
    }
    return v;
}

// Write the u64 base address for slab `idx` into SlabState.bases.
fn slab_set_base(slabs: State<SlabState>, idx: u32, val: u64) {
    let off = idx * 8;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let b = (val >> sh) & 255;
        let byte_off = off + i;
        slabs.bases[byte_off] = b as u8;
        i = i + 1;
    }
}

// ────────────────────────────────────────────────────────────────────────────
// Byte-array pack/unpack helpers — u32 fields (slot_sizes, free_heads,
// n_slots, n_used, free_tops).
// ────────────────────────────────────────────────────────────────────────────

fn slab_get_slot_size(slabs: State<SlabState>, idx: u32) -> u32 {
    let off = idx * 4;
    let v: u32 = 0;
    let i = 0;
    while i < 4 {
        let sh = i * 8;
        let byte_off = off + i;
        let b = slabs.slot_sizes[byte_off] as u32;
        v = v + (b << sh);
        i = i + 1;
    }
    return v;
}

fn slab_set_slot_size(slabs: State<SlabState>, idx: u32, val: u32) {
    let off = idx * 4;
    let i = 0;
    while i < 4 {
        let sh = i * 8;
        let b = (val >> sh) & 255;
        let byte_off = off + i;
        slabs.slot_sizes[byte_off] = b as u8;
        i = i + 1;
    }
}

fn slab_get_free_head(slabs: State<SlabState>, idx: u32) -> u32 {
    let off = idx * 4;
    let v: u32 = 0;
    let i = 0;
    while i < 4 {
        let sh = i * 8;
        let byte_off = off + i;
        let b = slabs.free_heads[byte_off] as u32;
        v = v + (b << sh);
        i = i + 1;
    }
    return v;
}

fn slab_set_free_head(slabs: State<SlabState>, idx: u32, val: u32) {
    let off = idx * 4;
    let i = 0;
    while i < 4 {
        let sh = i * 8;
        let b = (val >> sh) & 255;
        let byte_off = off + i;
        slabs.free_heads[byte_off] = b as u8;
        i = i + 1;
    }
}

fn slab_get_n_slots(slabs: State<SlabState>, idx: u32) -> u32 {
    let off = idx * 4;
    let v: u32 = 0;
    let i = 0;
    while i < 4 {
        let sh = i * 8;
        let byte_off = off + i;
        let b = slabs.n_slots[byte_off] as u32;
