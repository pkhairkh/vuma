// ═══════════════════════════════════════════════════════════════════════════
// womb/kernel/kmain.vuma
// VWK kernel main orchestrator — PMT-pure boot sequence.
// ═══════════════════════════════════════════════════════════════════════════
//
// kmain() is the kernel's "main" in the conventional sense — the first
// kernel-level function to run after the (hosted) _start stub has set up
// argc/argv and the (future) trap/context machinery. Today the boot
// sequence is intentionally minimal:
//
//     kmain():
//         c ← console_init()
//         kmain_print_banner(c)        // "vuma kernel: hello\n"
//         return 0                     // exit 0 via kernel.vuma::main
//
// Later waves extend kmain() in this exact file:
//     K2  pmm_init(c)            — physical memory manager
//     K3  vmm_init(c)            — virtual memory / page tables
//     K4  trap_init(c)           — IDT / exception handlers
//     K5  sched_init(c)          — scheduler + first task
//     K6  vfs_init(c)            — rootfs + init binary
// Each addition is a single line in kmain()'s body and a new
// `<subsys>_init(c: State<Console>)` function declared below.
//
// PMT discipline: NO `*ptr`, `&x`, `allocate`, `free` syntax. The Console
// state is passed through console_init/console_putc/console_flush by
// reference (State<T> is a pointer-to-buffer under the hood); its address
// is handed to `write` via the documented `c as Address` cast.
//
// VUMA has NO `import` statement yet (Open Work §7). This file is the
// CANONICAL source for kmain() and its helpers — womb/kernel/kernel.vuma
// inlines the full text below verbatim so the kernel compiles as a single
// translation unit. When VUMA gains `import`, kernel.vuma will collapse to
// `import kmain;` + a thin main() wrapper, and this file becomes the only
// source.

// ── Trampoline externs (mirror of trampoline.vuma) ─────────────────────────
// Hosted mode: write(1, base, n) → sys_write; exit(code) → sys_exit.
// Both are pre-registered stubs on the x86_64 backend (see
// src/codegen/src/x86_64/mod.rs::build_runtime_syscall_stubs). `write` is
// the simple 3-arg stub (RDI/RSI/RDX already match syscall ABI); `exit`
// is a no-return stub that ends with an INT3 guard. kmain returns 0
// normally — the kernel.vuma main() returns that as the process exit
// code, so we don't actually call exit() here. The declaration is kept
// for symmetry with the canonical trampoline.vuma and for use by future
// `kmain_panic` helpers.
extern "C" {
    fn write(fd: i64, buf: Address, count: i64) -> i64;
    fn exit(code: i64);
}

// ── Console layout (mirror of console.vuma — keep byte-identical) ──────────
// Field order matters: `buf` MUST be at offset 0 so that `c as Address`
// yields the address of `c.buf[0]` for the `write(1, base, c.len)` call
// in console_flush. A mismatch with console.vuma would silently produce
// wrong offsets in different translation units.

layout Console = {
    buf: [u8; 256],
    len: u32,
}

// ── console_init ───────────────────────────────────────────────────────────
// Allocate a fresh Console state and zero its length. Mirror of
// womb/kernel/console.vuma::console_init — same body, same semantics.

fn console_init() -> State<Console> {
    let c = state_new(Console);
    c.len = 0;
    return c;
}

// ── console_putc ───────────────────────────────────────────────────────────
// Append one byte to the console buffer; drop on overflow. Mirror of
// console.vuma::console_putc.

fn console_putc(c: State<Console>, ch: u8) {
    let idx = c.len;
    if idx < 256 {
        c.buf[idx] = ch;
        c.len = idx + 1;
    }
}

// ── console_flush ──────────────────────────────────────────────────────────
// Drain the buffer to host fd 1 via `write(1, base, c.len)`. `c as Address`
// is the documented PMT pattern (docs §14.5) for handing a State<T> to an
// FFI callee that takes a raw buffer pointer. Mirror of console.vuma.

fn console_flush(c: State<Console>) {
    if c.len > 0 {
        let base = c as Address;
        let _n = write(1, base, c.len as i64);
        c.len = 0;
    }
}

// ── kmain_print_banner ─────────────────────────────────────────────────────
// Emit the canonical boot banner "vuma kernel: hello\n" to the console
// buffer, then flush. VUMA has no string literals — each byte is pushed
// via console_putc with its decimal ASCII value. The 19 bytes spell:
//
//     v  u  m  a     k  e  r  n  e  l  :     h  e  l  l  o  \n
//   118 117 109 97 32 107 101 114 110 101 108 58 32 104 101 108 108 111 10
//
// (Verified by `printf '%s\n' "vuma kernel: hello" | od -An -tu1`.)
//
// Why a separate function? It keeps kmain()'s body a flat sequence of
// subsystem-init calls (console_init → kmain_print_banner → future
// pmm_init / vmm_init / ...) instead of a 19-line byte soup, and it
// gives later waves a clear place to add a richer banner (build hash,
// CPU features, memory size, ...) without touching kmain itself.

fn kmain_print_banner(c: State<Console>) {
    console_putc(c, 118);  // 'v'
    console_putc(c, 117);  // 'u'
    console_putc(c, 109);  // 'm'
    console_putc(c, 97);   // 'a'
    console_putc(c, 32);   // ' '
    console_putc(c, 107);  // 'k'
    console_putc(c, 101);  // 'e'
    console_putc(c, 114);  // 'r'
    console_putc(c, 110);  // 'n'
    console_putc(c, 101);  // 'e'
    console_putc(c, 108);  // 'l'
    console_putc(c, 58);   // ':'
    console_putc(c, 32);   // ' '
    console_putc(c, 104);  // 'h'
    console_putc(c, 101);  // 'e'
    console_putc(c, 108);  // 'l'
    console_putc(c, 108);  // 'l'
    console_putc(c, 111);  // 'o'
    console_putc(c, 10);   // '\n'
    console_flush(c);
}

// ── kmain ──────────────────────────────────────────────────────────────────
// The kernel main routine. Orchestrates the boot sequence:
//   1. Bring up the console (so subsequent init steps can log).
//   2. Print the boot banner.
//   3. (Future waves) pmm_init / vmm_init / trap_init / sched_init /
//      vfs_init — each takes the console state for logging.
//   4. Return 0 — kernel.vuma::main() returns this as the process exit
//      code. (In bare-metal K11, kmain will not return; it will idle the
//      CPU. For hosted mode, return-then-exit is the natural shape.)

fn kmain() -> i32 {
    let c = console_init();
    kmain_print_banner(c);
    return 0;
}

// ── main entry stub ──────────────────────────────────────────────────────────
// Library module — the real main() lives in womb/kernel/kernel.vuma (which
// inlines this file's text). This stub lets kmain.vuma be compiled
// standalone for verification.

fn main() -> i32 {
    return 0;
}
