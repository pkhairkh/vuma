    sbox.data[168] = 194; sbox.data[169] = 211; sbox.data[170] = 172; sbox.data[171] = 98;
    sbox.data[172] = 145; sbox.data[173] = 149; sbox.data[174] = 228; sbox.data[175] = 121;
