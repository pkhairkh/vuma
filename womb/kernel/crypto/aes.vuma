    sbox.data[96] = 208; sbox.data[97] = 239; sbox.data[98] = 170; sbox.data[99] = 251;
    sbox.data[100] = 67; sbox.data[101] = 77; sbox.data[102] = 51; sbox.data[103] = 133;
    sbox.data[104] = 69; sbox.data[105] = 249; sbox.data[106] = 2; sbox.data[107] = 127;
