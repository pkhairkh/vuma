// ═══════════════════════════════════════════════════════════════════════════
// womb/kernel/crypto/aes.vuma
// AES — simplified PMT-native implementation.
// ═══════════════════════════════════════════════════════════════════════════
//
// NOT a full KAT-verified AES. This is a structural skeleton with the
// real FIPS-197 S-box (W29S1), a stubbed key schedule, and a 10-round
// cipher (W49: SubBytes + ShiftRows + AddRoundKey per round; MixColumns
// deferred). K11+ adds the real Rijndael key schedule + MixColumns.
//
// ── What W29S1 provides ─────────────────────────────────────────────────────
//   aes_init_sbox(sbox)        — fill the 256-byte S-box with the real
//                                 FIPS-197 AES S-box (non-linear, non-
//                                 identity permutation — FIPS-197 §5.1.1
//                                 Fig. 7). All 256 entries written as
//                                 decimal literals per VUMA convention.
//   aes_key_expansion(ctx,key) — copy the 16-byte AES-128 key into all 11
//                                 round keys (placeholder — K11 will run
//                                 the real Rijndael key schedule with
//                                 SubWord + RotWord + Rcon).
//   aes_sub_bytes(state, sbox)  — W49: apply the FIPS-197 S-box to each
//                                 of the 16 state bytes (§5.1.1 SubBytes).
//   aes_shift_rows(state)       — W49: cyclically left-shift each state
//                                 row by its row index (§5.1.2 ShiftRows).
//   aes_encrypt_block(ctx,in,out) — W49: 10-round cipher — AddRoundKey(0),
//                                 then 9× (SubBytes + ShiftRows + AddRoundKey),
//                                 then final SubBytes + ShiftRows + AddRoundKey(10).
//                                 MixColumns deferred (§5.1.3 — K11+).
//   aes_decrypt_block(ctx,in,out) — delegates to encrypt_block (placeholder
//                                 — K11 will invert the round-key schedule
//                                 and use InvSubBytes + InvShiftRows +
//                                 InvMixColumns + AddRoundKey).
//
// ── VUMA Key Concepts ──────────────────────────────────────────────────────
//   - PMT layouts with [u8; N] fixed-size array fields
//   - `state_new(Layout)` arena allocation of crypto contexts
//   - `State<Layout>` pass-by-reference parameters (no pointer syntax)
//   - Byte-granular array indexing (sbox.data[i] reads byte i)
//   - `as u8` truncating cast from the default integer type to u8
//
// ── Decimal constants ──────────────────────────────────────────────────────
//   All literals are decimal. The AES-128 self-test uses:
//     key.data[0]      = 42
//     input.data[0]    = 99
//     round_keys[0]    = 42   (copied from key)
//     output.data[0]   = 233  (W49 10-round cipher final byte 0 — traced
//                              through 10× SubBytes+ShiftRows+AddRoundKey;
//                              was 73 in W29S1's round-0-only stub)
//     output.data[1]   = 54   (W49 10-round cipher final byte 1 —
//                              data[1..15] start at 0 and cycle through
//                              sbox[0]=99 → sbox[99]=251 → ... → 54)
//   The real S-box spot-checks (W29S1):
//     sbox.data[0]     = 99    (0x63 — canonical first S-box entry)
//     sbox.data[255]   = 22    (0x16 — canonical last S-box entry)

// AES S-box — the real 256-entry FIPS-197 table (W29S1 replaced the K10b
// identity permutation with the canonical non-linear S-box from FIPS-197
// §5.1.1 Fig. 7).
layout AesSbox = { data: [u8; 256] }

// AES round key (expanded key schedule). 11 * 16 = 176 bytes for AES-128.
layout AesRoundKey = { data: [u8; 176] }

// AES context: the expanded key schedule + the round count (10 for
// AES-128, 14 for AES-256, 12 for AES-192 — K11 will dispatch on ctx.nr).
layout AesCtx = {
    round_keys: [u8; 176],  // expanded key schedule
    nr: u32,                // number of rounds (10 for AES-128)
}

// AES-128 key wrapper (16 bytes — K11 will add AesKey256 with 32 bytes).
layout AesKey = { data: [u8; 16] }

// AES block (always 16 bytes for AES-128/192/256 — the Rijndael block size).
layout AesBlock = { data: [u8; 16] }

// AES working state — the 16-byte column-major byte matrix that the round
// function (SubBytes + ShiftRows + MixColumns + AddRoundKey) transforms in
// place. W49 introduces this as a distinct layout from AesBlock so the
// round-transform helpers (aes_sub_bytes, aes_shift_rows) can take a
// State<AesState> parameter that documents "this is the cipher's working
// state, not a plaintext/ciphertext block" — same 16-byte shape as AesBlock
// but a different role. Byte at (row, col) = data[col*4 + row] (column-major
// per FIPS-197 §3.4 — the state matrix is filled column-by-column from the
// input sequence).
layout AesState = { data: [u8; 16] }

// ────────────────────────────────────────────────────────────────────────────
// AES API functions.
// ────────────────────────────────────────────────────────────────────────────

// aes_init_sbox: fill the S-box with the real FIPS-197 AES S-box.
//
//   sbox: caller-allocated State<AesSbox> (output — modified in place).
//
// W29S1: writes the canonical 256-entry FIPS-197 S-box (FIPS-197 §5.1.1
// Fig. 7) — a non-linear, non-identity permutation chosen for its
// resistance to differential + linear cryptanalysis. All literals are
// decimal per the VUMA convention (hex literals have width-extension
// issues). The previous K10b stub wrote the identity permutation
// (`sbox.data[i] = i as u8`) — a no-op for SubBytes that W29S1 replaces.
// The full table is written as 256 explicit `sbox.data[N] = <decimal>;`
// assignments rather than a runtime loop so the constants are visible
// to static analysis and IVE.
fn aes_init_sbox(sbox: State<AesSbox>) {
    sbox.data[0] = 99; sbox.data[1] = 124; sbox.data[2] = 119; sbox.data[3] = 123;
    sbox.data[4] = 242; sbox.data[5] = 107; sbox.data[6] = 111; sbox.data[7] = 197;
    sbox.data[8] = 48; sbox.data[9] = 1; sbox.data[10] = 103; sbox.data[11] = 43;
    sbox.data[12] = 254; sbox.data[13] = 215; sbox.data[14] = 171; sbox.data[15] = 118;
    sbox.data[16] = 202; sbox.data[17] = 130; sbox.data[18] = 201; sbox.data[19] = 125;
    sbox.data[20] = 250; sbox.data[21] = 89; sbox.data[22] = 71; sbox.data[23] = 240;
    sbox.data[24] = 173; sbox.data[25] = 212; sbox.data[26] = 162; sbox.data[27] = 175;
    sbox.data[28] = 156; sbox.data[29] = 164; sbox.data[30] = 114; sbox.data[31] = 192;
    sbox.data[32] = 183; sbox.data[33] = 253; sbox.data[34] = 147; sbox.data[35] = 38;
    sbox.data[36] = 54; sbox.data[37] = 63; sbox.data[38] = 247; sbox.data[39] = 204;
    sbox.data[40] = 52; sbox.data[41] = 165; sbox.data[42] = 229; sbox.data[43] = 241;
    sbox.data[44] = 113; sbox.data[45] = 216; sbox.data[46] = 49; sbox.data[47] = 21;
    sbox.data[48] = 4; sbox.data[49] = 199; sbox.data[50] = 35; sbox.data[51] = 195;
    sbox.data[52] = 24; sbox.data[53] = 150; sbox.data[54] = 5; sbox.data[55] = 154;
    sbox.data[56] = 7; sbox.data[57] = 18; sbox.data[58] = 128; sbox.data[59] = 226;
    sbox.data[60] = 235; sbox.data[61] = 39; sbox.data[62] = 178; sbox.data[63] = 117;
    sbox.data[64] = 9; sbox.data[65] = 131; sbox.data[66] = 44; sbox.data[67] = 26;
    sbox.data[68] = 27; sbox.data[69] = 110; sbox.data[70] = 90; sbox.data[71] = 160;
    sbox.data[72] = 82; sbox.data[73] = 59; sbox.data[74] = 214; sbox.data[75] = 179;
    sbox.data[76] = 41; sbox.data[77] = 227; sbox.data[78] = 47; sbox.data[79] = 132;
    sbox.data[80] = 83; sbox.data[81] = 209; sbox.data[82] = 0; sbox.data[83] = 237;
    sbox.data[84] = 32; sbox.data[85] = 252; sbox.data[86] = 177; sbox.data[87] = 91;
    sbox.data[88] = 106; sbox.data[89] = 203; sbox.data[90] = 190; sbox.data[91] = 57;
    sbox.data[92] = 74; sbox.data[93] = 76; sbox.data[94] = 88; sbox.data[95] = 207;
    sbox.data[96] = 208; sbox.data[97] = 239; sbox.data[98] = 170; sbox.data[99] = 251;
    sbox.data[100] = 67; sbox.data[101] = 77; sbox.data[102] = 51; sbox.data[103] = 133;
    sbox.data[104] = 69; sbox.data[105] = 249; sbox.data[106] = 2; sbox.data[107] = 127;
    sbox.data[108] = 80; sbox.data[109] = 60; sbox.data[110] = 159; sbox.data[111] = 168;
