// ═══════════════════════════════════════════════════════════════════════════
// womb/kernel/crypto/sha.vuma
// SHA-256 — full FIPS-180-4 PMT-native implementation (W48).
// ═══════════════════════════════════════════════════════════════════════════
//
// W48: real 64-round SHA-256 compression + FIPS-180-4 §5.1.1 padding +
// §5.1.2 big-endian digest serialization. The digest now matches the
// canonical SHA-256 test vectors (verified in main):
//   SHA-256("")    = e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
//   SHA-256("a")   = ca978112ca1bbdcafac231b39a23dc4da786eff8147c4e72b9807785afee48bb
//   SHA-256("abc") = ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
//
// ── What W48 provides ───────────────────────────────────────────────────────
//   sha256_init(ctx)         — seed ALL 8 SHA-256 IV words (byte-by-byte,
//                              little-endian) into ctx.state, zero ctx.buf
//                              + ctx.len + ctx.total (unchanged from W29S2).
//   sha256_update(ctx,data,n) — copy input bytes into ctx.buf. When the
//                              64-byte buffer fills, invoke the real
//                              64-round compression (sha256_compress) and
//                              reset ctx.len = 0. Multi-block streaming
//                              via repeated update calls is supported
//                              (each call may carry up to 64 bytes — the
//                              ShaData layout's block size).
//   sha256_compress(ctx)     — W48 NEW. Read ctx.buf as one 512-bit block,
//                              build the 64-word message schedule W[0..63]
//                              (BE load of W[0..15] from ctx.buf, expand
//                              W[16..63] via the σ0/σ1 message-schedule
//                              recurrence), run the 64 SHA-256 rounds
//                              (T1 = h + Σ1(e) + Ch(e,f,g) + K[i] + W[i];
//                              T2 = Σ0(a) + Maj(a,b,c); h=g; g=f; f=e;
//                              e=d+T1; d=c; c=b; b=a; a=T1+T2), and fold
//                              the working variables a..h back into
//                              ctx.state (H[i] += working[i] mod 2^32).
//   sha256_final(ctx,out)    — W48 REWRITE. Append 0x80 + zero-pad to 56
//                              mod 64 + 64-bit big-endian bit-count, run
//                              the final compression (or two compressions
//                              when the padding overflows into a second
//                              block — the len >= 56 case), and serialize
//                              ctx.state as 8 big-endian u32 words into
//                              out (FIPS-180-4 §5.1.2).
//
// ── VUMA Key Concepts ──────────────────────────────────────────────────────
//   - PMT layouts with [u8; N] / [u32; N] fixed-size array fields
//   - `state_new(Layout)` arena allocation of crypto contexts + scratch
//     buffers (message schedule W, round constants K) — usable inside
//     any function, not just main
//   - `State<Layout>` pass-by-reference parameters (no pointer syntax)
//   - Byte-granular indexing on [u8; N] (ctx.state[i] reads byte i)
//   - Typed-array scaling on [u32; N] (W.w[i] reads/writes the u32 word
//     at slot i — VUMA's "Fix 2" typed-array index scaling, see
//     api.vuma's HashCtx comment)
//   - `as u32` widening cast on u8 operands before `<<` / `+` (avoids
//     u8+u8 overflow at the IVE layer — same idiom as K10d's asym.vuma)
//   - u64 streaming-length counter (ctx.total) for the FIPS-180-4 §5.1.1
//     message-length padding suffix (64-bit big-endian bit count)
//
// ── Decimal SHA-256 IV bytes (little-endian — unchanged from W29S2) ────────
//   Word 0: 0x6a09e667 = 1779033703 → LE bytes 67 e6 09 6a → 103 230 9 106
//   Word 1: 0xbb67ae85 = 3144134277 → LE bytes 85 ae 67 bb → 133 174 103 187
//   Word 2: 0x3c6ef372 = 1013904242 → LE bytes 72 f3 6e 3c → 114 243 110 60
//   Word 3: 0xa54ff53a = 2773480762 → LE bytes 3a f5 4f a5 → 58 245 79 165
//   Word 4: 0x510e527f = 1359893119 → LE bytes 7f 52 0e 51 → 127 82 14 81
//   Word 5: 0x9b05688c = 2600822924 → LE bytes 8c 68 05 9b → 140 104 5 155
//   Word 6: 0x1f83d9ab =  528734635 → LE bytes ab d9 83 1f → 171 217 131 31
//   Word 7: 0x5be0cd19 = 1541459225 → LE bytes 19 cd e0 5b → 25 205 224 91
//
//   The state is stored LE because that's what W29S2 established — W48
//   preserves the on-disk state layout for compatibility (init's IV
//   bytes, the self-test's state[0]==103 check) and adapts the
//   compression + digest-serialization layers to load/store u32 words
//   with explicit LE/BE byte ordering. The digest output is BE per
//   FIPS-180-4 §5.1.2 (out.data[0] = high byte of H0), so the empty-
//   input digest starts with 0xe3 (high byte of 0xe3b0c442) — not 0x42
//   (low byte).

// SHA-256 context: 32-byte hash state (8 × 4-byte IV words, stored as
// little-endian bytes), 64-byte input buffer (SHA-256's block size),
// in-buffer byte count, and total-bytes-processed counter (used by
// sha256_final for the FIPS-180-4 §5.1.1 message-length padding suffix).
layout Sha256Ctx = {
    state: [u8; 32],   // 8 * 4 bytes (hash state, stored as LE bytes)
    buf: [u8; 64],     // input buffer (one SHA-256 block)
    len: u32,          // bytes in buffer
    total: u64,        // total bytes processed
}

// SHA-256 input data wrapper (64 bytes — one full SHA-256 block).
layout ShaData = { data: [u8; 64] }

// SHA-256 digest output (32 bytes — eight 32-bit hash words serialized
// big-endian per FIPS-180-4 §5.1.2). W48 writes the real digest (no
// longer the IV verbatim — the digest now reflects the actual
// compression of the input message).
layout ShaDigest = { data: [u8; 32] }

// SHA-256 message schedule (64 × u32 words = 256 bytes). Allocated via
// state_new(Sha256W) inside sha256_compress. W[0..15] are big-endian
// loads of the 64-byte input block; W[16..63] are expanded via the
// σ0/σ1 recurrence (FIPS-180-4 §6.2.2). Held as [u32; 64] for typed-
// array indexing — W.w[i] returns the u32 word at slot i (VUMA's
// typed-array scaling per "Fix 2" in api.vuma's HashCtx comment).
layout Sha256W = { w: [u32; 64] }

// SHA-256 round-constants table (64 × u32 = 256 bytes). The 64 K[i]
// values are the first 32 bits of the fractional parts of the cube
// roots of the first 64 primes (FIPS-180-4 §4.2.2). Loaded once per
// compression call via sha256_load_k. Held as [u32; 64] for typed-
// array indexing — K.k[i] returns the u32 constant at slot i.
layout Sha256K = { k: [u32; 64] }

// 32-bit mask. VUMA's default integer literal type widens u32
// arithmetic to u64; the explicit & MASK32 keeps each round's
// additions within 32-bit range, matching FIPS-180-4's mod-2^32
// arithmetic. (Same idiom as womb/crypto/hash/sha256_sha224.vuma.)
const MASK32: u32 = 4294967295;

// ────────────────────────────────────────────────────────────────────────────
// SHA-256 helper functions (FIPS-180-4 §4.1.2).
// ────────────────────────────────────────────────────────────────────────────

// Right-rotate a 32-bit word by n positions (1 <= n <= 31).
fn rotr32(x: u32, n: u32) -> u32 {
    return ((x >> n) | (x << (32 - n))) & MASK32;
}

// Ch(x, y, z) = (x AND y) XOR ((NOT x) AND z)  [FIPS-180-4 §4.1.2]
// (NOT x is computed as x XOR MASK32 — VUMA has no unary NOT on u32;
// same idiom as womb/crypto/hash/sha256_sha224.vuma's ch32.)
fn ch32(x: u32, y: u32, z: u32) -> u32 {
    return (x & y) ^ ((x ^ MASK32) & z);
}

// Maj(x, y, z) = (x AND y) XOR (x AND z) XOR (y AND z)  [§4.1.2]
fn maj32(x: u32, y: u32, z: u32) -> u32 {
    return (x & y) ^ (x & z) ^ (y & z);
}

// Big Sigma0(x) = ROTR^2(x) XOR ROTR^13(x) XOR ROTR^22(x)  [§4.1.2]
fn bsig0_32(x: u32) -> u32 {
    return rotr32(x, 2) ^ rotr32(x, 13) ^ rotr32(x, 22);
}

// Big Sigma1(x) = ROTR^6(x) XOR ROTR^11(x) XOR ROTR^25(x)  [§4.1.2]
fn bsig1_32(x: u32) -> u32 {
    return rotr32(x, 6) ^ rotr32(x, 11) ^ rotr32(x, 25);
}

// Small sigma0(x) = ROTR^7(x) XOR ROTR^18(x) XOR SHR^3(x)  [§4.1.2]
fn ssig0_32(x: u32) -> u32 {
    return rotr32(x, 7) ^ rotr32(x, 18) ^ (x >> 3);
}

// Small sigma1(x) = ROTR^17(x) XOR ROTR^19(x) XOR SHR^10(x)  [§4.1.2]
fn ssig1_32(x: u32) -> u32 {
    return rotr32(x, 17) ^ rotr32(x, 19) ^ (x >> 10);
}

// ────────────────────────────────────────────────────────────────────────────
// Round-constants loader.
// ────────────────────────────────────────────────────────────────────────────

// sha256_load_k: fill K.k[0..63] with the 64 FIPS-180-4 §4.2.2 round
// constants (the first 32 bits of the fractional parts of the cube
// roots of the first 64 primes). All literals are decimal per the
// VUMA convention (hex literals have width-extension issues — see
// aes.vuma's header note). K.k[i] is written as a u32 store (typed-
// array scaling) so the 64 words land at byte offsets 0, 4, 8, ...,
// 252 — ready for u32 load via K.k[i] in the round loop.
fn sha256_load_k(K: State<Sha256K>) {
    K.k[0] = 1116352408;
    K.k[1] = 1899447441;
    K.k[2] = 3049323471;
    K.k[3] = 3921009573;
    K.k[4] = 961987163;
    K.k[5] = 1508970993;
    K.k[6] = 2453635748;
    K.k[7] = 2870763221;
    K.k[8] = 3624381080;
    K.k[9] = 310598401;
    K.k[10] = 607225278;
    K.k[11] = 1426881987;
    K.k[12] = 1925078388;
    K.k[13] = 2162078206;
    K.k[14] = 2614888103;
    K.k[15] = 3248222580;
    K.k[16] = 3835390401;
    K.k[17] = 4022224774;
    K.k[18] = 264347078;
    K.k[19] = 604807628;
    K.k[20] = 770255983;
    K.k[21] = 1249150122;
    K.k[22] = 1555081692;
    K.k[23] = 1996064986;
    K.k[24] = 2554220882;
    K.k[25] = 2821834349;
    K.k[26] = 2952996808;
    K.k[27] = 3210313671;
    K.k[28] = 3336571891;
    K.k[29] = 3584528711;
    K.k[30] = 113926993;
    K.k[31] = 338241895;
    K.k[32] = 666307205;
    K.k[33] = 773529912;
    K.k[34] = 1294757372;
    K.k[35] = 1396182291;
    K.k[36] = 1695183700;
    K.k[37] = 1986661051;
    K.k[38] = 2177026350;
    K.k[39] = 2456956037;
    K.k[40] = 2730485921;
    K.k[41] = 2820302411;
    K.k[42] = 3259730800;
    K.k[43] = 3345764771;
    K.k[44] = 3516065817;
    K.k[45] = 3600352804;
    K.k[46] = 4094571909;
    K.k[47] = 275423344;
    K.k[48] = 430227734;
    K.k[49] = 506948616;
    K.k[50] = 659060556;
    K.k[51] = 883997877;
    K.k[52] = 958139571;
    K.k[53] = 1322822218;
    K.k[54] = 1537002063;
    K.k[55] = 1747873779;
    K.k[56] = 1955562222;
    K.k[57] = 2024104815;
    K.k[58] = 2227730452;
    K.k[59] = 2361852424;
    K.k[60] = 2428436474;
    K.k[61] = 2756734187;
    K.k[62] = 3204031479;
