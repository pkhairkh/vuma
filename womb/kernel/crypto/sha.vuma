}

// ────────────────────────────────────────────────────────────────────────────
// State load/store helpers (LE byte <-> u32 word).
// ────────────────────────────────────────────────────────────────────────────

// load_state_le: read 4 LE bytes from ctx.state[base..base+3] as a u32.
// The state is stored little-endian (per sha256_init's IV seeding), so
// byte 0 is the low byte and byte 3 is the high byte of each u32 word.
fn load_state_le(ctx: State<Sha256Ctx>, base: u64) -> u32 {
    let b0 = ctx.state[base] as u32;
    let b1 = ctx.state[base + 1] as u32;
    let b2 = ctx.state[base + 2] as u32;
    let b3 = ctx.state[base + 3] as u32;
    return (b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)) & MASK32;
}

// add_state_word: fold a working-variable value into the running state.
// new_state[base..base+3] (LE) = old_state[base..base+3] (LE) + val
// (mod 2^32). Used by sha256_compress's step 4 to add the post-round
// working variables a..h back into ctx.state (FIPS-180-4 §6.2.2 step f:
// H0 = a + H0, H1 = b + H1, ..., H7 = h + H7).
fn add_state_word(ctx: State<Sha256Ctx>, base: u64, val: u32) {
    let old = load_state_le(ctx, base);
    let acc = (val + old) & MASK32;
    ctx.state[base] = (acc & 255) as u8;
    ctx.state[base + 1] = ((acc >> 8) & 255) as u8;
    ctx.state[base + 2] = ((acc >> 16) & 255) as u8;
    ctx.state[base + 3] = ((acc >> 24) & 255) as u8;
}

// ────────────────────────────────────────────────────────────────────────────
// SHA-256 API functions.
// ────────────────────────────────────────────────────────────────────────────

// sha256_init: seed the SHA-256 initial hash state into ctx.
//
//   ctx: caller-allocated State<Sha256Ctx> (output — modified in place).
//
// Writes ALL 8 SHA-256 IV words (byte-by-byte, little-endian) into
// ctx.state[0..31] (unchanged from W29S2), zeroes ctx.buf (implicit —
// the caller's state_new zeroes fresh allocations, and update/final
// only read buf[0..ctx.len]), and sets ctx.len = ctx.total = 0.
fn sha256_init(ctx: State<Sha256Ctx>) {
    // H0 = 0x6a09e667 = 1779033703 → LE bytes: 67 e6 09 6a.
    ctx.state[0] = 103; ctx.state[1] = 230; ctx.state[2] = 9; ctx.state[3] = 106;
    // H1 = 0xbb67ae85 = 3144134277 → LE: 85 ae 67 bb.
    ctx.state[4] = 133; ctx.state[5] = 174; ctx.state[6] = 103; ctx.state[7] = 187;
    // H2 = 0x3c6ef372 = 1013904242 → LE: 72 f3 6e 3c.
    ctx.state[8] = 114; ctx.state[9] = 243; ctx.state[10] = 110; ctx.state[11] = 60;
    // H3 = 0xa54ff53a = 2773480762 → LE: 3a f5 4f a5.
    ctx.state[12] = 58; ctx.state[13] = 245; ctx.state[14] = 79; ctx.state[15] = 165;
    // H4 = 0x510e527f = 1359893119 → LE: 7f 52 0e 51.
    ctx.state[16] = 127; ctx.state[17] = 82; ctx.state[18] = 14; ctx.state[19] = 81;
    // H5 = 0x9b05688c = 2600822924 → LE: 8c 68 05 9b.
    ctx.state[20] = 140; ctx.state[21] = 104; ctx.state[22] = 5; ctx.state[23] = 155;
    // H6 = 0x1f83d9ab = 528734635 → LE: ab d9 83 1f.
    ctx.state[24] = 171; ctx.state[25] = 217; ctx.state[26] = 131; ctx.state[27] = 31;
    // H7 = 0x5be0cd19 = 1541459225 → LE: 19 cd e0 5b.
    ctx.state[28] = 25; ctx.state[29] = 205; ctx.state[30] = 224; ctx.state[31] = 91;
    ctx.len = 0;
    ctx.total = 0;
}

// sha256_compress: fold one 64-byte block (ctx.buf) into ctx.state via
// the FIPS-180-4 §6.2.2 64-round SHA-256 compression.
//
//   ctx: caller-allocated State<Sha256Ctx> with ctx.buf populated (read)
//        and ctx.state updated in place (write). ctx.len is not modified
//        by compress (the caller — update or final — manages len).
//
// W48: full real compression. Steps:
//   1. Build the 64-word message schedule W[0..63]:
//        W[0..15] = big-endian load of ctx.buf[i*4..i*4+3]
//        W[i] (16 <= i < 64) = W[i-16] + σ0(W[i-15]) + W[i-7] + σ1(W[i-2])
//      (all additions mod 2^32).
//   2. Initialize working variables a..h from ctx.state[0..31] (LE):
//        a = H0, b = H1, c = H2, d = H3, e = H4, f = H5, g = H6, h = H7.
//   3. Run 64 rounds (i = 0..63):
//        T1 = h + Σ1(e) + Ch(e,f,g) + K[i] + W[i]   (mod 2^32)
//        T2 = Σ0(a) + Maj(a,b,c)                     (mod 2^32)
//        h = g; g = f; f = e; e = (d + T1) mod 2^32;
//        d = c; c = b; b = a; a = (T1 + T2) mod 2^32.
//   4. Fold a..h back into ctx.state (mod 2^32):
//        H0 += a; H1 += b; ...; H7 += h.
fn sha256_compress(ctx: State<Sha256Ctx>) {
    // Scratch buffers: 64-word message schedule + 64-word round-constants.
    let W = state_new(Sha256W);
    let K = state_new(Sha256K);
    sha256_load_k(K);

    // Step 1: build the message schedule.
    // W[0..15] = big-endian load of ctx.buf[i*4..i*4+3] (FIPS-180-4 §5.1.2:
    // the input message is interpreted as 16 big-endian 32-bit words).
    let i = 0;
    while i < 16 {
        let off = i * 4;
        let b0 = ctx.buf[off] as u32;
        let b1 = ctx.buf[off + 1] as u32;
        let b2 = ctx.buf[off + 2] as u32;
        let b3 = ctx.buf[off + 3] as u32;
        W.w[i] = ((b0 << 24) | (b1 << 16) | (b2 << 8) | b3) & MASK32;
        i = i + 1;
    }
    // W[16..63] = W[i-16] + ssig0(W[i-15]) + W[i-7] + ssig1(W[i-2])  (§6.2.2).
    i = 16;
    while i < 64 {
        let w15 = W.w[i - 15];
        let w2 = W.w[i - 2];
        let w7 = W.w[i - 7];
        let w16 = W.w[i - 16];
        W.w[i] = (w16 + ssig0_32(w15) + w7 + ssig1_32(w2)) & MASK32;
        i = i + 1;
    }

    // Step 2: initialize working variables a..h from ctx.state (LE load).
    let a = load_state_le(ctx, 0);
    let b = load_state_le(ctx, 4);
    let c = load_state_le(ctx, 8);
    let d = load_state_le(ctx, 12);
    let e = load_state_le(ctx, 16);
    let f = load_state_le(ctx, 20);
    let g = load_state_le(ctx, 24);
    let h = load_state_le(ctx, 28);

    // Step 3: 64 SHA-256 rounds (FIPS-180-4 §6.2.2).
    // T1 captures the OLD e/f/g/h (used to update e = d + T1); T2 captures
    // the OLD a/b/c (used to update a = T1 + T2). The 8 variable rotations
    // (h=g, g=f, ..., b=a) happen AFTER T1/T2 are computed, so the round
    // function is correct.
    let r = 0;
    while r < 64 {
        let ki = K.k[r];
        let wi = W.w[r];
        let t1 = (h + bsig1_32(e) + ch32(e, f, g) + ki + wi) & MASK32;
        let t2 = (bsig0_32(a) + maj32(a, b, c)) & MASK32;
        h = g;
        g = f;
        f = e;
        e = (d + t1) & MASK32;
        d = c;
        c = b;
        b = a;
        a = (t1 + t2) & MASK32;
        r = r + 1;
    }

    // Step 4: fold a..h back into ctx.state (H[i] += working[i] mod 2^32).
    add_state_word(ctx, 0, a);
    add_state_word(ctx, 4, b);
    add_state_word(ctx, 8, c);
    add_state_word(ctx, 12, d);
    add_state_word(ctx, 16, e);
    add_state_word(ctx, 20, f);
    add_state_word(ctx, 24, g);
    add_state_word(ctx, 28, h);
}

// sha256_update: absorb `len` bytes of data into the hash state.
//
//   ctx:  caller-allocated State<Sha256Ctx> (modified in place).
//   data: caller-allocated State<ShaData> holding the input bytes.
//   len:  number of bytes to absorb (0..64 per call — multiple update
//         calls chain into a multi-block hash via repeated compress).
//
// W48: buffers input bytes into ctx.buf. When ctx.len reaches 64, calls
// sha256_compress to fold the block into ctx.state and resets ctx.len
// to 0 (ready for the next chunk). Multi-block streaming via repeated
// update calls is supported: if the buffer is partially full from a
// prior call, the new bytes top it up and trigger a compression as
// soon as 64 bytes accumulate. (The ShaData layout caps a single call
// at 64 bytes — callers hashing more than 64 bytes must split into
// multiple update calls, the standard streaming-API shape.)
fn sha256_update(ctx: State<Sha256Ctx>, data: State<ShaData>, len: u64) {
    let i = 0;
    while i < len {
        if ctx.len < 64 {
            ctx.buf[ctx.len] = data.data[i];
            ctx.len = ctx.len + 1;
            // W48: when the buffer fills, run the real 64-round
            // compression (FIPS-180-4 §6.2.2) and reset ctx.len for
            // the next chunk. This is the streaming compression point
            // that W29S2 marked as a K11 TODO.
            if ctx.len == 64 {
                sha256_compress(ctx);
                ctx.len = 0;
            }
        }
        i = i + 1;
    }
    ctx.total = ctx.total + len;
}

// sha256_final: emit the 32-byte SHA-256 digest into `out`.
//
//   ctx: caller-allocated State<Sha256Ctx> (modified in place during
//        the final compression(s) — ctx.state holds the final hash
//        value after this call).
//   out: caller-allocated State<ShaDigest> (digest output — 32 bytes).
//
// W48: real FIPS-180-4 §5.1.1 padding + §6.2.2 final compression +
// §5.1.2 big-endian digest serialization:
//   1. Append 0x80 at ctx.buf[ctx.len] (the SHA-256 "1-bit" marker).
//   2. Zero-pad to offset 56 (mod 64). If ctx.len + 1 > 56, the padding
//      overflows into a second block — compress the first (containing
//      the message tail + 0x80 + zero-pad), then start a fresh zero
//      block for the bit-count suffix. (This is the len >= 56 case —
//      the 64-bit bit count needs 8 bytes at the end of a block, so
//      any message tail with < 8 bytes of headroom in the current
//      block spills into a second padding block.)
//   3. Write the 64-bit big-endian bit count (ctx.total * 8) at
//      ctx.buf[56..63] (FIPS-180-4 §5.1.1 length suffix).
//   4. Run the final compression (or the second of two compressions
//      in the overflow case).
//   5. Serialize ctx.state as 8 big-endian u32 words into out.data
//      (FIPS-180-4 §5.1.2: H0 high byte first, H0 low byte last, then
//      H1, ..., H7).
fn sha256_final(ctx: State<Sha256Ctx>, out: State<ShaDigest>) {
    // Total message length in bits (FIPS-180-4 §5.1.1 length suffix).
    // ctx.total is u64 (bytes); * 8 yields the bit count. For the
    // self-test's max input (3 bytes), total_bits = 24 — fits in u64
    // with no overflow. (For real-world inputs up to 2^61 bytes, the
    // * 8 would still fit in u64; beyond that is the spec's 2^64-bit
    // message-length cap, which we don't enforce.)
    let total_bits = ctx.total * 8;

    // Step 1: append the 0x80 padding bit at ctx.buf[ctx.len].
    ctx.buf[ctx.len] = 128;
    let pos = ctx.len + 1;

    // Step 2: zero-pad to offset 56 (mod 64).
    if pos < 56 {
        // Single-block padding: zero bytes pos..55, then bit count at
        // 56..63 — all in the current block.
        let p = pos;
        while p < 56 {
            ctx.buf[p] = 0;
            p = p + 1;
        }
    } else {
        // Two-block padding: zero bytes pos..63, compress this block
        // (message tail + 0x80 + zero-pad), then start a fresh block
        // zero-filled up to offset 56 (the bit count goes at 56..63).
        let p = pos;
        while p < 64 {
            ctx.buf[p] = 0;
            p = p + 1;
        }
        ctx.len = 64;
        sha256_compress(ctx);
        ctx.len = 0;
        let q = 0;
        while q < 56 {
            ctx.buf[q] = 0;
            q = q + 1;
        }
    }

    // Step 3: 64-bit big-endian bit count at ctx.buf[56..63].
    // (Byte 56 = most-significant, byte 63 = least-significant.)
    ctx.buf[56] = ((total_bits >> 56) & 255) as u8;
    ctx.buf[57] = ((total_bits >> 48) & 255) as u8;
    ctx.buf[58] = ((total_bits >> 40) & 255) as u8;
    ctx.buf[59] = ((total_bits >> 32) & 255) as u8;
    ctx.buf[60] = ((total_bits >> 24) & 255) as u8;
    ctx.buf[61] = ((total_bits >> 16) & 255) as u8;
    ctx.buf[62] = ((total_bits >> 8) & 255) as u8;
    ctx.buf[63] = (total_bits & 255) as u8;

    // Step 4: final compression (the second compression in the overflow
    // case — the first was done in step 2's else branch).
    ctx.len = 64;
    sha256_compress(ctx);

    // Step 5: serialize ctx.state as 8 big-endian u32 words (§5.1.2).
    // State is stored LE (per sha256_init); load each word LE, then
    // write it back to out.data as 4 BE bytes (high byte first).
    let i = 0;
    while i < 8 {
        let base = i * 4;
        let word = load_state_le(ctx, base);
        out.data[base] = ((word >> 24) & 255) as u8;
        out.data[base + 1] = ((word >> 16) & 255) as u8;
        out.data[base + 2] = ((word >> 8) & 255) as u8;
        out.data[base + 3] = (word & 255) as u8;
        i = i + 1;
    }
}

// ────────────────────────────────────────────────────────────────────────────
// Self-test (main).
// ────────────────────────────────────────────────────────────────────────────
// W48 verifies the real SHA-256 compression against three canonical
// FIPS-180-4 test vectors (the same vectors NIST publishes in §B.1 + the
// empty-input case):
//
//   1. SHA-256("")    = e3b0c442 98fc1c14 9afbf4c8 996fb924
//                        27ae41e4 649b934c a495991b 7852b855
//      (padding-only block: 0x80 + 55 zeros + 8 zero bytes bit count)
//
//   2. SHA-256("a")   = ca978112 ca1bbdca fac231b3 9a23dc4d
//                        a786eff8 147c4e72 b9807785 afee48bb
//      (1-byte message: 'a'(0x61) + 0x80 + 54 zeros + 8-byte bit count = 8)
//
//   3. SHA-256("abc") = ba7816bf 8f01cfea 414140de 5dae2223
//                        b00361a3 96177a9c b410ff61 f20015ad
//      (3-byte message: 'abc' + 0x80 + 52 zeros + 8-byte bit count = 24)
//      (This is the canonical FIPS-180-4 §B.1 single-block test vector.)
//
// The self-test ALSO verifies the unchanged-from-W29S2 IV byte checks
// (state[0]==103, state[3]==106, state[16]==127, state[31]==91) after
// sha256_init, plus the update-path accounting (ctx.len + ctx.total +
// ctx.buf[0]) for the "a" input.
//
// Returns 0 on success, 1..19 on the 19 individual check failures.
fn main() -> i32 {
    // ── Init + IV byte check (unchanged from W29S2) ──
    let ctx = state_new(Sha256Ctx);
    sha256_init(ctx);
    // H0 first byte = 103 (0x67, low byte of 0x6a09e667).
    if ctx.state[0] != 103 { return 1; }
    // H0 fourth byte = 106 (0x6a, high byte of 0x6a09e667).
    if ctx.state[3] != 106 { return 2; }
    // H4 first byte = 127 (0x7f, low byte of 0x510e527f).
    if ctx.state[16] != 127 { return 3; }
    // H7 fourth byte = 91 (0x5b, high byte of 0x5be0cd19).
    if ctx.state[31] != 91 { return 4; }
    // Buffer is empty.
    if ctx.len != 0 { return 5; }

    // ── Test vector 1: SHA-256("") ──
    // Empty input → padding-only block. Expected digest:
    //   e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
    // (spot-check bytes 0, 1, 31 — 0xe3, 0xb0, 0x55.)
    let d_empty = state_new(ShaDigest);
    sha256_final(ctx, d_empty);
    if d_empty.data[0] != 227 { return 6; }   // 0xe3
    if d_empty.data[1] != 176 { return 7; }   // 0xb0
    if d_empty.data[31] != 85 { return 8; }   // 0x55

    // ── Test vector 2: SHA-256("a") ──
    // 1-byte input → single-block padding. Expected digest:
    //   ca978112ca1bbdcafac231b39a23dc4da786eff8147c4e72b9807785afee48bb
    sha256_init(ctx);
    let data = state_new(ShaData);
    data.data[0] = 97;  // 'a'
    sha256_update(ctx, data, 1);
    // Update-path accounting (unchanged from W29S2's self-test).
    if ctx.len != 1 { return 9; }
    if ctx.total != 1 { return 10; }
    if ctx.buf[0] != 97 { return 11; }
    let d_a = state_new(ShaDigest);
    sha256_final(ctx, d_a);
    // Spot-check bytes 0, 1, 31 — 0xca, 0x97, 0xbb.
    if d_a.data[0] != 202 { return 12; }   // 0xca
    if d_a.data[1] != 151 { return 13; }   // 0x97
    if d_a.data[31] != 187 { return 14; }  // 0xbb

    // ── Test vector 3: SHA-256("abc") (FIPS-180-4 §B.1) ──
    // 3-byte input → single-block padding. Expected digest:
    //   ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
    sha256_init(ctx);
    data.data[0] = 97;   // 'a'
    data.data[1] = 98;   // 'b'
    data.data[2] = 99;   // 'c'
    sha256_update(ctx, data, 3);
    if ctx.len != 3 { return 15; }
    if ctx.total != 3 { return 16; }
    let d_abc = state_new(ShaDigest);
    sha256_final(ctx, d_abc);
    // Spot-check bytes 0, 1, 31 — 0xba, 0x78, 0xad.
    if d_abc.data[0] != 186 { return 17; }  // 0xba
    if d_abc.data[1] != 120 { return 18; }  // 0x78
    if d_abc.data[31] != 173 { return 19; } // 0xad

    return 0;
}
