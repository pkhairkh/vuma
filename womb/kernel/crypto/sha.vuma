// ═══════════════════════════════════════════════════════════════════════════
// womb/kernel/crypto/sha.vuma
// SHA-256 — simplified PMT-native implementation.
// ═══════════════════════════════════════════════════════════════════════════
//
// NOT a full KAT-verified SHA-256. This is a structural skeleton with
// the round function as a stub. K11+ adds real SHA-256.
//
// ── What K10c provides ──────────────────────────────────────────────────────
//   sha256_init(ctx)         — seed the first 4 of 8 SHA-256 IV words
//                              (byte-by-byte, little-endian) into ctx.state,
//                              zero ctx.buf + ctx.len + ctx.total.
//   sha256_update(ctx,data,n) — copy up to 64 bytes of input into ctx.buf,
//                              bump ctx.total by n (no compression).
//   sha256_final(ctx,out)    — copy ctx.state's 32 bytes verbatim into out
//                              (no padding, no final compression).
//
// ── VUMA Key Concepts ──────────────────────────────────────────────────────
//   - PMT layouts with [u8; N] fixed-size array fields
//   - `state_new(Layout)` arena allocation of crypto contexts
//   - `State<Layout>` pass-by-reference parameters (no pointer syntax)
//   - Byte-granular array indexing (ctx.state[i] reads byte i)
//   - u64 streaming-length counter (ctx.total)
//
// ── Decimal SHA-256 IV bytes (little-endian) ───────────────────────────────
//   Word 0: 0x6a09e667 = 1779033703 → LE bytes 67 e6 09 6a → 103 230 9 106
//   Word 1: 0xbb67ae85 = 3144134277 → LE bytes 85 ae 67 bb → 133 174 103 187
//   Word 2: 0x3c6ef372 = 1013904242 → LE bytes 72 f3 6e 3c → 114 243 110 60
//   Word 3: 0xa54ff53a = 2773480762 → LE bytes 3a f5 4f a5 → 58 245 79 165
//   Words 4..7 are zeroed in this K10c stub; K11 will seed all 8 IV words.

// SHA-256 context: 32-byte hash state (8 × 4-byte IV words, stored as
// bytes), 64-byte input buffer (SHA-256's block size), in-buffer byte
// count, and total-bytes-processed counter (used by the real
// sha256_final for the FIPS-180-4 §5.1.1 message-length padding suffix).
layout Sha256Ctx = {
    state: [u8; 32],   // 8 * 4 bytes (hash state, stored as bytes)
    buf: [u8; 64],     // input buffer
    len: u32,          // bytes in buffer
    total: u64,        // total bytes processed
}

// SHA-256 input data wrapper (64 bytes — one full SHA-256 block).
layout ShaData = { data: [u8; 64] }

// SHA-256 digest output (32 bytes — eight 32-bit hash words serialized
// big-endian per FIPS-180-4 §5.1.2, but K10c's stub writes the
// little-endian IV bytes verbatim — K11 will serialize the words in
// the correct big-endian digest order).
layout ShaDigest = { data: [u8; 32] }

// ────────────────────────────────────────────────────────────────────────────
// SHA-256 API functions.
// ────────────────────────────────────────────────────────────────────────────

// sha256_init: seed the SHA-256 initial hash state into ctx.
//
//   ctx: caller-allocated State<Sha256Ctx> (output — modified in place).
//
// Writes the first 4 of 8 SHA-256 IV words (byte-by-byte, little-endian)
// into ctx.state[0..15], zeroes ctx.state[16..31] (K10c stub — K11 will
// seed all 8 IV words), zeroes ctx.buf, and sets ctx.len = ctx.total = 0.
fn sha256_init(ctx: State<Sha256Ctx>) {
    // H0 = 0x6a09e667 = 1779033703 → LE bytes: 67 e6 09 6a.
    ctx.state[0] = 103; ctx.state[1] = 230; ctx.state[2] = 9; ctx.state[3] = 106;
    // H1 = 0xbb67ae85 = 3144134277 → LE: 85 ae 67 bb.
    ctx.state[4] = 133; ctx.state[5] = 174; ctx.state[6] = 103; ctx.state[7] = 187;
    // H2 = 0x3c6ef372 = 1013904242 → LE: 72 f3 6e 3c.
    ctx.state[8] = 114; ctx.state[9] = 243; ctx.state[10] = 110; ctx.state[11] = 60;
    // H3 = 0xa54ff53a = 2773480762 → LE: 3a f5 4f a5.
    ctx.state[12] = 58; ctx.state[13] = 245; ctx.state[14] = 79; ctx.state[15] = 165;
    // H4-H7 (simplified: just set to 0). K11 will seed all 8 IV words.
    let i = 16;
    while i < 32 {
        ctx.state[i] = 0;
        i = i + 1;
    }
    ctx.len = 0;
    ctx.total = 0;
}

// sha256_update: absorb `len` bytes of data into the hash state.
//
//   ctx:  caller-allocated State<Sha256Ctx> (modified in place).
//   data: caller-allocated State<ShaData> holding the input bytes.
//   len:  number of bytes to absorb (0..64).
//
// K10c STUB: copies up to 64 bytes of data into ctx.buf (capped at the
// 64-byte buffer — once full, subsequent bytes are silently dropped),
// then bumps ctx.total by len. K11 will replace this with the real
// SHA-256 streaming path (buffer partial blocks, run the 64-round
// compression function — FIPS-180-4 §6.2.2 — when a 64-byte block
// accumulates, fold the block into ctx.state).
fn sha256_update(ctx: State<Sha256Ctx>, data: State<ShaData>, len: u64) {
    let i = 0;
    while i < len {
        if ctx.len < 64 {
            ctx.buf[ctx.len] = data.data[i];
            ctx.len = ctx.len + 1;
        }
        i = i + 1;
    }
    ctx.total = ctx.total + len;
}

// sha256_final: emit the 32-byte digest into `out`.
//
//   ctx: caller-allocated State<Sha256Ctx> (read by K11+; not modified
//        by K10c's stub).
//   out: caller-allocated State<ShaDigest> (digest output).
//
// K10c STUB: copies ctx.state[0..31] verbatim into out.data[0..31] —
// i.e. the digest is just the IV (or whatever the last compression
// pass left behind — which for K10c is the IV, since the stub
// sha256_update never compresses). K11 will replace this with the real
// SHA-256 padding (0x80 + zero-pad + 64-bit big-endian bit-count) +
// final compression pass + big-endian digest serialization (FIPS-180-4
// §5.1.1 + §6.2.2).
fn sha256_final(ctx: State<Sha256Ctx>, out: State<ShaDigest>) {
    let i = 0;
    while i < 32 {
        out.data[i] = ctx.state[i];
        i = i + 1;
    }
}

// ────────────────────────────────────────────────────────────────────────────
// Self-test (main).
// ────────────────────────────────────────────────────────────────────────────
// Exercises the K10c SHA-256 API surface end-to-end:
//   1. sha256_init(ctx)           → IV bytes seeded (state[0]=103, state[3]=106).
//   2. sha256_update(ctx,data,1)  → 1 byte buffered (len=1, total=1, buf[0]=97).
//   3. sha256_final(ctx,digest)   → digest is IV verbatim (digest[0]=103).
//
// Returns 0 on success, 1..7 on the 7 individual check failures.
//
// ── Why state[0] == 103 instead of 1779033703? ──────────────────────────────
//   VUMA's byte-granular array indexing means `ctx.state[0]` reads back
//   the byte at offset 0 of the 32-byte state buffer — the low byte of
//   the SHA-256 IV word 0 (0x6a09e667 = 1779033703) — which is 0x67 =
//   103 decimal. K11's real SHA-256 will store the IV as 8 × u32 words
//   and access them as words, but K10c's byte-by-byte IV storage is
//   consistent with VUMA's byte-granular indexing discipline (see
//   "Why byte-by-byte IV storage?" in womb/kernel/crypto/api.vuma).
fn main() -> i32 {
    // ── Init + IV check ──
    let ctx = state_new(Sha256Ctx);
    sha256_init(ctx);
    // Verify H0 first byte = 103 (0x67, low byte of 0x6a09e667).
    if ctx.state[0] != 103 { return 1; }
    // Verify H0 fourth byte = 106 (0x6a, high byte of 0x6a09e667).
    if ctx.state[3] != 106 { return 2; }
    // Verify buffer is empty.
    if ctx.len != 0 { return 3; }

    // ── Update with data ──
    let data = state_new(ShaData);
    data.data[0] = 97;  // 'a'
    sha256_update(ctx, data, 1);
    if ctx.len != 1 { return 4; }
    if ctx.total != 1 { return 5; }
    if ctx.buf[0] != 97 { return 6; }

    // ── Finalize ──
    let digest = state_new(ShaDigest);
    sha256_final(ctx, digest);
    // Stub: digest = state verbatim. state[0] = 103 (H0 low byte).
    if digest.data[0] != 103 { return 7; }

    return 0;
}
