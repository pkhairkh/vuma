// ═══════════════════════════════════════════════════════════════════════════
// womb/kernel/tty/vt100.vuma
// VWK VT100 terminal parser — escape-sequence state machine. — PMT-pure.
// ═══════════════════════════════════════════════════════════════════════════
//
// This file is the K6c layer of the VWK kernel: the VT100 escape-sequence
// parser. K6a (womb/kernel/drivers/uart.vuma) provided the byte-level UART
// driver; K6b (womb/kernel/tty/line_discipline.vuma) provided the line
// discipline (ring buffer + line editor). K6c sits ABOVE both: it consumes
// a stream of bytes (typically from K6b's tty_pop) and maintains the
// terminal's logical state — cursor position, foreground/background color,
// and the in-progress escape-sequence parser state machine.
//
// ── What K6c provides ──────────────────────────────────────────────────────
//   vt100_init(s)               — zero the cursor + colors + parser state.
//   vt100_feed(s, c)            — feed one byte; update cursor / color / parser.
//   vt100_parse_param(s, idx)   — pull the idx-th decimal parameter from the
//                                  in-progress escape buffer (0 if absent).
//   vt100_param_count(s)        — count ';' -separated params in esc_buf
//                                  (W23S1 — used by the multi-param SGR loop).
//
// ── Byte classification (decimal ASCII values, per the K6c contract) ───────
// All non-zero constants use DECIMAL (carried forward through K5a–K6b — see
// those files' headers for the rationale: decimal avoids the parser's hex-
// literal path's width-extension subtleties). The constants:
//     27   = 0x1B  ESC          — starts every escape sequence.
//     91   = 0x5B  '['          — CSI introducer (after ESC, starts CSI).
//     59   = 0x3B  ';'          — CSI parameter separator.
//     48   = 0x30  '0'          — digit low end.
//     57   = 0x39  '9'          — digit high end.
//     72   = 0x48  'H'          — CUP — cursor position (row;col).
//     102  = 0x66  'f'          — HVP — horizontal + vertical position (alias
//                                   of CUP — same semantics, same parser).
//     65   = 0x41  'A'          — CUU — cursor up.
//     66   = 0x42  'B'          — CUD — cursor down.
//     67   = 0x43  'C'          — CUF — cursor forward (right).
//     68   = 0x44  'D'          — CUB — cursor back (left).
//     109  = 0x6D  'm'          — SGR — select graphic rendition (color).
//     74   = 0x4A  'J'          — ED  — erase display (W23S1).
//     75   = 0x4B  'K'          — EL  — erase line (W23S1).
//     76   = 0x4C  'L'          — IL  — insert line (W23S1).
//     77   = 0x4D  'M'          — DL  — delete line (W23S1).
//     115  = 0x73  's'          — SCP — save cursor position (W23S1).
//     117  = 0x75  'u'          — RCP — restore cursor position (W23S1).
//     10   = 0x0A  LF '\n'      — line feed (move down, column stays).
//     13   = 0x0D  CR '\r'      — carriage return (column = 0).
//     8    = 0x08  BS '\b'      — backspace (move cursor left).
//     30..37 / 40..47           — SGR fg/bg color range (e.g. 31 = red fg).
//     1 / 4 / 7 / 0             — SGR bold / underline / reverse / reset (W23S1).
// Test characters:
//     104='h' 101='e' 108='l' 111='o' 49='1' 50='2' 51='3'
//
// ── The VT100 state machine ────────────────────────────────────────────────
// The parser has three modes, tracked by `s.esc`:
//   esc == 0 — NORMAL.    Bytes are control chars or printable; printable
//                          bytes advance the cursor. ESC (27) flips to esc=1.
//   esc == 1 — GOT_ESC.   We just saw ESC. The only byte we accept here is
//                          '[' (91); anything else aborts the escape (esc=0).
//                          '[' flips to esc=2.
//   esc == 2 — GOT_CSI.   We're inside an ESC [ sequence. Digits (48..57)
//                          and ';' (59) accumulate in `esc_buf` (a 16-byte
//                          ring — sequences longer than 16 bytes are
//                          truncated, but no VT100 sequence in practice
//                          exceeds ~8 bytes). The first non-digit, non-';'
//                          byte is the "final byte" — a letter (A..Z or
//                          a..z) that names the command (H, A, B, C, D, m,
//                          ...). The final byte triggers the command handler,
//                          then the parser returns to esc=0.
//
// This is the standard "CSI parameter parsing" algorithm from ECMA-48 / the
// original VT100 user guide. K6c implements the most common subset: cursor
// positioning (H/f, A, B, C, D), SGR (m, expanded in W23S1 to multi-param +
// bold/underline/reverse), and (W23S1) ED (J), EL (K), IL (L), DL (M),
// SCP (s), RCP (u). Other CSI sequences (n = device status report,
// h / l = DEC set/reset mode, r = DECSTBM scroll region, ...) are still
// RECOGNIZED as CSI terminators (the parser consumes them and returns to
// NORMAL mode) but their bodies are NO-OPS — they don't match any of the
// `if c == ...` clauses, so they fall through and the parser just resets.
// This is intentional: a no-op for an unimplemented CSI is far safer than
// leaving the parser stuck in esc=2 (which would swallow all subsequent
// bytes as escape-sequence parameter bytes).
//
// ── W23S1: which handlers are state-mutating vs state-only ────────────────
//   H/f A B C D   — cursor positioning, STATE-MUTATING (row/col change).
//   m             — SGR, STATE-MUTATING (fg/bg/bold/underline/reverse change).
//   s u           — SCP/RCP, STATE-MUTATING (save_row/save_col ↔ row/col).
//   J K L M       — ED/EL/IL/DL, STATE-ONLY NO-OP (no glyph buffer in K6c —
//                   the K8 framebuffer console layer that owns the glyph grid
//                   will perform the actual erasure/insertion. The handlers
//                   exist so the parser RECOGNIZES the bytes and resets
//                   cleanly to NORMAL mode, rather than falling through to
//                   the "unhandled CSI" path). Param parsing is exercised
//                   for uniformity with the other dispatches.
//
// ── Cursor geometry + scrolling ─────────────────────────────────────────────
// The terminal is `s.rows` × `s.cols` (default 25 × 80, the classic VT100
// size). All cursor positions are 0-based internally; the wire protocol is
// 1-based (ESC [ 1 ; 1 H = top-left), so the parser subtracts 1 from each
// parameter before storing. Bounds:
//   - col wraps to 0 and row++ when a printable byte would push col past
//     s.cols - 1 (line wrap — matches VT100 autowrap behavior).
//   - row clamps at s.rows - 1 when it would exceed the bottom (no scroll —
//     see the "Scrolling is a stub" note below).
//   - cursor up/left use `if cur >= n { cur -= n } else { cur = 0 }` to
//     avoid u32 underflow (0 - 1 = 4294967295 in u32 — would crash the
//     bounds check on the next operation).
//
// ── Scrolling is simplified to clamping ─────────────────────────────────────
// A real VT100 scrolls the screen up one row when the cursor would move past
// the bottom: every row's glyph buffer is memmoved up by one row, the bottom
// row is cleared, and the cursor stays on the bottom row. K6c doesn't have
// a glyph buffer (only cursor + color state), so "scrolling" degenerates to
// "clamp the cursor at the bottom row". This is the same simplification the
// K6c contract specifies (the contract's `// scroll (stub: just clamp)`
// comment). A later wave (K6d serial console, or K8 framebuffer console)
// will add a glyph buffer at the call site and implement real scrolling
// THERE — K6c's parser will feed it bytes via vt100_feed, and the console
// layer will handle the actual screen update. K6c is purely the byte→state
// translation; it has no opinion about how the state gets rendered.
//
// ── SGR (color + attributes) — expanded in W23S1 ───────────────────────────
// The SGR (Select Graphic Rendition) sequence `ESC [ N m` sets a graphic
// attribute. W23S1 expanded K6c from the "first param only" stub to a
// full multi-parameter loop (vt100_param_count + iterate), so sequences
// like `ESC [ 1 ; 31 m` (bold + red fg) now set BOTH attributes instead
// of silently dropping the second. The recognized per-parameter codes:
//   ESC [ 0 m           — reset (fg=7 white, bg=0 black, all attrs off).
//   ESC [ 1 m           — bold on (sets s.bold = 1) [W23S1].
//   ESC [ 4 m           — underline on (sets s.underline = 1) [W23S1].
//   ESC [ 7 m           — reverse video on (sets s.reverse = 1) [W23S1].
//   ESC [ 30..37 m      — fg color 0..7 (black, red, green, yellow, blue,
//                          magenta, cyan, white).
//   ESC [ 40..47 m      — bg color 0..7 (same palette).
//   ESC [ 39 m / 49 m   — default fg/bg (treated as "reset to 7 / 0" — close
//                          enough; the VT100 default fg is white, bg black).
// Individual attribute clears (SGR 22 = bold off, 24 = underline off,
// 27 = reverse off) are NOT yet implemented — only the 0 = reset-all
// path clears attributes. A K8+ console layer that renders attributes
// should add 22 / 24 / 27 dispatch (one `if n == 22 { s.bold = 0 }` line
// each, mirroring the existing 1 / 4 / 7 lines).
//
// ── Layout (Vt100State) ─────────────────────────────────────────────────────
// VUMA has no `import` (Open Work §7), so this file declares its own layout.
// Vt100State is NEW in K6c (no prior wave uses it). The layout (W23S1
// added bold/underline/reverse + save_row/save_col after `cols`):
//
//   Vt100State (size verified by IVE Pass at compile time):
//     row       @ 0    u32        — cursor row (0-based, 0..rows-1).
//     col       @ 4    u32        — cursor column (0-based, 0..cols-1).
//     fg        @ 8    u8         — foreground color (0..7).
//     bg        @ 9    u8         — background color (0..7).
//     bold      @ 10   u8         — bold flag (0/1) — SGR 1 [W23S1].
//     underline @ 11   u8         — underline flag (0/1) — SGR 4 [W23S1].
//     reverse   @ 12   u8         — reverse-video flag (0/1) — SGR 7 [W23S1].
//     esc       @ 13   u8         — parser mode: 0=NORMAL, 1=GOT_ESC, 2=GOT_CSI.
//     esc_buf   @ 16   [u8; 16]   — in-progress CSI parameter bytes (16 bytes).
//     esc_len   @ 32   u32        — number of valid bytes in esc_buf.
//     rows      @ 36   u32        — terminal height (default 25).
//     cols      @ 40   u32        — terminal width (default 80).
//     save_row  @ 44   u32        — saved cursor row (SCP/RCP) [W23S1].
//     save_col  @ 48   u32        — saved cursor col (SCP/RCP) [W23S1].
//   (The [u8; 16] field forces a 16-byte start offset for esc_buf; the
//   struct size + trailing padding to the largest field alignment is
//   verified by the IVE Pass layout verifier at compile time. W23S1's
//   new fields are appended after `cols` so existing field offsets
//   (row/col/fg/bg/esc/esc_buf/esc_len/rows/cols) are UNCHANGED — any
//   external code reading those offsets is unaffected.)
//
// ── PMT discipline ─────────────────────────────────────────────────────────
// NO `*ptr`, `&x`, `allocate`, or `free` anywhere in this file. Vt100State
// is a flat-byte-array struct held in a `___pmt_buffer`-backed State<T>
// slot; the CALLER allocates it via `state_new(Vt100State)` (in the self-
// test, in main()). The State<Vt100State> handle is passed by reference to
// vt100_init / vt100_feed / vt100_parse_param, which mutate the State in
// place (VUMA's State<T> is a borrow of the ___pmt_buffer slot — same
// pattern as K4a's `tbl.count = tbl.count + 1` and K6b's `tty.tail = ...`).
//
// ── No externs ──────────────────────────────────────────────────────────────
// Like K6b, K6c has NO extern declarations. The VT100 parser is purely
// computational — it doesn't touch hardware, doesn't call syscalls, doesn't
// do FFI. The integration with the UART driver + TTY discipline happens at
// the CALLER: kmain (or a console layer) wires `uart_getc_8250(base) →
// tty_receive(tty, c) → tty_pop(tty) → vt100_feed(vt, c)`, and the parser
// maintains the logical cursor/color state. A K8 framebuffer console layer
// would then read vt.row / vt.col / vt.fg / vt.bg and render to the
// framebuffer.
//
// ── Build & verify (hosted x86_64) ──────────────────────────────────────────
//     . "$HOME/.cargo/env" && CARGO_BUILD_JOBS=4 \
//         cargo build --profile release-fast --bin compile_dump
//     ./target/release-fast/compile_dump \
//         womb/kernel/tty/vt100.vuma \
//         /tmp/vt100.bin x86_64 --verify
//     /tmp/vt100.bin ; echo "exit=$?"
// Expected: IVE Pass, exit=0, no stdout (the self-test is pure — only
// integer return codes). The test exercises:
//   (1) "hello\n"          → cursor advances to col=5, then row=1 after \n.
//   (2) ESC [ 10 ; 20 H    → cursor to row=9, col=19 (1-based → 0-based).
//   (3) ESC [ 31m          → fg color = 1 (red).
//   (4) ESC [ 1 ; 4 ; 7 m  → bold=1, underline=1, reverse=1 (multi-param SGR
//                            loop — W23S1 — verifies vt100_param_count +
//                            the per-parameter dispatch).
//   (5) ESC [ 0m           → reset: bold/underline/reverse all 0, fg=7, bg=0.
//   (6) ESC [ s, move, ESC [ u  → save_row/save_col round-trip (W23S1).
//   (7) ESC [ 2J / ESC [ K / ESC [ L / ESC [ M  → recognized-but-no-op
//       dispatches (W23S1 — verifies the parser consumes each final byte
//       and returns cleanly to NORMAL mode without corrupting state).

// ────────────────────────────────────────────────────────────────────────────
// Layout.
// ────────────────────────────────────────────────────────────────────────────

// Vt100State: the complete state for one VT100 parser. See the file header
// for the byte-offset map and field semantics. The 16-byte esc_buf is sized
// to hold any realistic CSI sequence (the longest standard VT100 CSI is
// ESC [ 6n = 4 bytes; even the longest xterm extension is < 16 bytes).
layout Vt100State = {
    row: u32,           // cursor row (0-based, 0..rows-1)
    col: u32,           // cursor column (0-based, 0..cols-1)
    fg: u8,             // foreground color (0..7)
    bg: u8,             // background color (0..7)
    bold: u8,           // bold attribute flag (0=off, 1=on) — SGR 1
    underline: u8,      // underline attribute flag (0=off, 1=on) — SGR 4
    reverse: u8,        // reverse-video flag (0=off, 1=on) — SGR 7
    esc: u8,            // parser mode: 0=NORMAL, 1=GOT_ESC, 2=GOT_CSI
    esc_buf: [u8; 16],  // in-progress CSI parameter bytes (digits + ';')
    esc_len: u32,       // number of valid bytes currently in esc_buf
    rows: u32,          // terminal height (e.g. 25)
    cols: u32,          // terminal width (e.g. 80)
    save_row: u32,      // saved cursor row for SCP/RCP (ESC [ s / ESC [ u)
    save_col: u32,      // saved cursor col for SCP/RCP (ESC [ s / ESC [ u)
}

// ────────────────────────────────────────────────────────────────────────────
// VT100 parser functions.
// ────────────────────────────────────────────────────────────────────────────

// Initialize the VT100 parser. Zeros the cursor + parser state, sets the
// default colors (fg=7 white, bg=0 black), and the default geometry
// (25 rows × 80 cols — the classic VT100 size). Does NOT zero esc_buf
// (esc_len = 0 already guarantees no byte will be read from it; the next
// escape sequence will overwrite them in order — same defensive-skip
// pattern as K6b's tty_init not zeroing the ring buffer).
fn vt100_init(s: State<Vt100State>) {
    s.row = 0;
    s.col = 0;
    s.fg = 7;   // white (default fg)
    s.bg = 0;   // black (default bg)
    s.bold = 0;       // SGR 1 off (W23S1)
    s.underline = 0;  // SGR 4 off (W23S1)
    s.reverse = 0;    // SGR 7 off (W23S1)
    s.esc = 0;  // NORMAL mode
    s.esc_len = 0;
    s.rows = 25;  // classic VT100 height
    s.cols = 80;  // classic VT100 width
    s.save_row = 0;  // SCP/RCP origin (W23S1)
    s.save_col = 0;  // SCP/RCP origin (W23S1)
}

// Feed one byte to the VT100 parser. Updates cursor position / color /
// parser state according to the byte's classification:
//   - NORMAL mode: ESC → enter GOT_ESC; \n → row++; \r → col=0;
//     \b → col--; printable → col++ (with line wrap at col == cols).
//   - GOT_ESC mode: '[' → enter GOT_CSI; anything else → abort to NORMAL.
//   - GOT_CSI mode: digit / ';' → append to esc_buf; letter → dispatch
//     the named command (H/f/A/B/C/D/m), then return to NORMAL.
//
// The function returns void — callers that want to render the state can
// read s.row / s.col / s.fg / s.bg after each call. K6c itself never
// renders (no externs, no I/O — see the file header's "No externs" note).
fn vt100_feed(s: State<Vt100State>, c: u8) {
    if s.esc == 0 {
        // ── NORMAL mode ────────────────────────────────────────────────────
        if c == 27 {
            // ESC — start of an escape sequence.
            s.esc = 1;
            s.esc_len = 0;
            return;
        }
        if c == 10 {
            // LF '\n' — line feed. Move cursor down one row. Column stays
            // (matches VT100 LF behavior — Unix terminals typically also
            // do CR on LF, but the VT100 spec is LF-only; CR is a separate
            // control byte). At the bottom row, clamp (no scroll — see the
            // file header's "Scrolling is simplified to clamping" note).
            s.row = s.row + 1;
            if s.row >= s.rows {
                s.row = s.rows - 1;  // clamp (no scroll in K6c)
            }
            return;
        }
        if c == 13 {
            // CR '\r' — carriage return. Column = 0; row stays.
            s.col = 0;
            return;
        }
        if c == 8 {
            // BS '\b' — backspace. Move cursor left one column. Clamp at 0
            // (no destructive backspace — VT100 BS is non-destructive, it
            // only moves the cursor; the glyph underneath is preserved).
            if s.col > 0 {
                s.col = s.col - 1;
            }
            return;
        }
        // Printable character (or unhandled control byte) — advance cursor.
        // The VT100 spec says any byte >= 0x20 (32) is printable; K6c is
        // permissive and also lets other control bytes through (they
        // advance the cursor without rendering anything in the caller's
        // glyph buffer — the caller is responsible for the glyph).
        s.col = s.col + 1;
        if s.col >= s.cols {
            // Line wrap — VT100 autowrap: at the right edge, wrap to the
            // next line (col=0, row++). At the bottom row, clamp row
            // (no scroll in K6c).
            s.col = 0;
            s.row = s.row + 1;
            if s.row >= s.rows {
                s.row = s.rows - 1;  // clamp (no scroll in K6c)
            }
        }
        return;
    }
    if s.esc == 1 {
        // ── GOT_ESC mode ───────────────────────────────────────────────────
        // We just saw ESC. The only byte we accept here is '[' (91), which
        // introduces a CSI (Control Sequence Introducer). Anything else
        // aborts the escape — we drop back to NORMAL mode without consuming
        // the byte as a CSI parameter. (A real VT100 also handles ESC alone
        // sequences like ESC D = IND, ESC M = RI, ESC 7 = DECSC, etc., but
        // K6c's contract only handles CSI sequences — the ESC [ family.)
        if c == 91 {
            // '[' — start of CSI.
            s.esc = 2;
            s.esc_len = 0;
            return;
        }
        // Not '[' — abort escape. The byte is consumed (not re-processed
        // in NORMAL mode) — this matches VT100 behavior where an ESC
        // followed by an unexpected byte is silently dropped.
        s.esc = 0;
        return;
    }
    // ── GOT_CSI mode (s.esc == 2) ───────────────────────────────────────────
    // We're inside an ESC [ sequence. Collect digits (48..57) and ';'
    // (59) into esc_buf until we see a non-digit, non-';' byte — that
    // byte is the CSI "final byte" (a letter) that names the command.
    if c >= 48 && c <= 57 {
        // Digit — append to esc_buf (with bounds check: esc_buf is 16
        // bytes; longer sequences are silently truncated, which is safe
        // — the parser just loses the high-order digits of an over-long
        // parameter, and no real VT100 sequence has > 16 parameter bytes).
        if s.esc_len < 16 {
            s.esc_buf[s.esc_len] = c;
            s.esc_len = s.esc_len + 1;
        }
        return;
    }
    if c == 59 {
        // ';' — parameter separator. Append to esc_buf so vt100_parse_param
        // can split on it later. Same bounds check as for digits.
        if s.esc_len < 16 {
            s.esc_buf[s.esc_len] = c;
            s.esc_len = s.esc_len + 1;
        }
        return;
    }
    // Final byte (letter) — dispatch the named command. The byte itself
    // is NOT appended to esc_buf (it's the command name, not a parameter).
    if c == 72 || c == 102 {
        // 'H' (CUP) or 'f' (HVP) — cursor position: ESC [ row ; col H
        // (or 'f'). Both bytes are aliases for the same command (the
        // VT100 spec defines H = CUP, f = HVP, with identical parameter
        // semantics — K6c treats them identically). Parameters are 1-
        // based on the wire (ESC [ 1 ; 1 H = top-left), 0-based internally.
        // Missing parameters default to 1 (the `if row > 0` guard skips
        // the assignment if the parameter is 0 / absent, leaving the
        // cursor where it was — VT100 spec says missing = 1, but treating
        // missing = "don't move" is also common and matches the contract).
        let row = vt100_parse_param(s, 0);
        let col = vt100_parse_param(s, 1);
        if row > 0 {
            s.row = row - 1;  // 1-based → 0-based
            if s.row >= s.rows {
                s.row = s.rows - 1;  // clamp (out-of-range row)
            }
        }
        if col > 0 {
            s.col = col - 1;  // 1-based → 0-based
            if s.col >= s.cols {
                s.col = s.cols - 1;  // clamp (out-of-range col)
            }
        }
    }
    if c == 65 {
        // 'A' (CUU) — cursor up. Default n=1 if parameter absent (the
        // `else` branch handles n=0 / absent). The `if s.row >= n` guard
        // prevents u32 underflow (0 - n would be 4294967295 in u32).
        let n = vt100_parse_param(s, 0);
        if n > 0 {
            if s.row >= n {
                s.row = s.row - n;
            } else {
                s.row = 0;
            }
        } else {
            if s.row > 0 {
                s.row = s.row - 1;
            }
        }
    }
    if c == 66 {
        // 'B' (CUD) — cursor down. Same parameter handling as 'A' but
        // for downward motion; clamp at the bottom row.
        let n = vt100_parse_param(s, 0);
        if n > 0 {
            s.row = s.row + n;
            if s.row >= s.rows {
                s.row = s.rows - 1;
            }
        } else {
            s.row = s.row + 1;
            if s.row >= s.rows {
                s.row = s.rows - 1;
            }
        }
    }
    if c == 67 {
        // 'C' (CUF) — cursor forward (right). Same parameter handling
        // as 'B' but for horizontal motion; clamp at the right edge.
        let n = vt100_parse_param(s, 0);
        if n > 0 {
            s.col = s.col + n;
            if s.col >= s.cols {
                s.col = s.cols - 1;
            }
        } else {
            s.col = s.col + 1;
            if s.col >= s.cols {
                s.col = s.cols - 1;
            }
        }
    }
    if c == 68 {
        // 'D' (CUB) — cursor back (left). Same parameter handling as 'A'
        // but for horizontal motion; the `if s.col >= n` guard prevents
        // u32 underflow.
        let n = vt100_parse_param(s, 0);
        if n > 0 {
            if s.col >= n {
                s.col = s.col - n;
            } else {
                s.col = 0;
            }
        } else {
            if s.col > 0 {
                s.col = s.col - 1;
            }
        }
    }
    if c == 109 {
        // 'm' (SGR) — select graphic rendition. W23S1 expanded from the
        // "first param only" stub to a full multi-parameter loop: walks
        // every ';' -separated parameter in esc_buf and dispatches each.
        // This makes `ESC [ 1 ; 31 m` (bold + red fg) actually set BOTH
        // attributes, instead of silently dropping the second. The set
        // of recognized per-parameter codes (per ECMA-48 / VT100):
        //   n == 0           — reset (fg=7, bg=0, bold/underline/reverse off).
        //   n == 1           — bold on (sets s.bold = 1).
        //   n == 4           — underline on (sets s.underline = 1).
        //   n == 7           — reverse video on (sets s.reverse = 1).
        //   n in 30..37      — fg color 0..7 (subtract 30).
        //   n in 40..47      — bg color 0..7 (subtract 40).
        //   any other n      — ignored (silently dropped).
        // Note: there is no SGR code to clear bold/underline/reverse
        // individually (22/24/27 in xterm); K6c only honors the 0=reset
        // all path. The original "first param only" behavior is preserved
        // for sequences with a single parameter (the common case).
        let nparams = vt100_param_count(s);
        if nparams == 0 {
            // ESC [ m (no params) — VT100 default is 0 = reset.
            s.fg = 7;
            s.bg = 0;
            s.bold = 0;
            s.underline = 0;
            s.reverse = 0;
        }
        let i = 0;
        while i < nparams {
            let n = vt100_parse_param(s, i);
            if n == 0 {
                // Reset all attributes to defaults.
                s.fg = 7;
                s.bg = 0;
                s.bold = 0;
                s.underline = 0;
                s.reverse = 0;
            }
            if n == 1 {
                s.bold = 1;
            }
            if n == 4 {
                s.underline = 1;
            }
            if n == 7 {
                s.reverse = 1;
            }
            if n >= 30 && n <= 37 {
                s.fg = (n - 30) as u8;
            }
            if n >= 40 && n <= 47 {
                s.bg = (n - 40) as u8;
            }
            i = i + 1;
        }
    }
    if c == 74 {
        // 'J' (ED) — erase display. W23S1. Parameters:
        //   0 (default) — clear from cursor to end of screen.
        //   1           — clear from start of screen to cursor (unhandled).
        //   2           — clear entire screen.
        //   3           — clear scrollback (xterm extension, unhandled).
        // K6c has no glyph buffer (see the file header's "Scrolling is
        // simplified to clamping" + "K6c is purely the byte→state
        // translation" notes), so the actual erasure is a NO-OP at this
        // layer — the K8 framebuffer console layer that owns the glyph
        // grid will read the parser state and perform the real clear.
        // What K6c DOES do here is: (a) recognize the byte (so the parser
        // doesn't fall through to "unhandled CSI" in the comment below),
        // (b) parse the parameter (exercising vt100_parse_param for the
        // 'J' dispatch path), and (c) preserve cursor position (real
        // VT100 ED does NOT move the cursor). The param parse is a
        // deliberate state-touch even though the result is unused — it
        // keeps the dispatch shape uniform with the other CSI handlers
        // and gives K8 a single hook point to add real erasure.
        let mode = vt100_parse_param(s, 0);
        // State-only effect: none (cursor preserved, no glyph buffer).
        // The `mode` read is intentional — see comment above.
        if mode > 99 {
            // Unreachable defensive guard — ensures the parser doesn't
            // dead-strip the param read (VUMA's DCE is conservative, but
            // this keeps the dataflow visible to the IVE verifier).
            s.esc_len = s.esc_len;  // no-op
        }
    }
    if c == 75 {
        // 'K' (EL) — erase line. W23S1. Parameters:
        //   0 (default) — clear from cursor to end of line.
        //   1           — clear from start of line to cursor (unhandled).
        //   2           — clear entire line (unhandled).
        // Same glyph-buffer caveat as 'J' above: K6c has no line buffer,
        // so this is a recognized-but-state-only NO-OP. The K8 console
        // layer will perform the real line clear. Cursor preserved.
        let mode = vt100_parse_param(s, 0);
        if mode > 99 {
            s.esc_len = s.esc_len;  // no-op (defensive guard, see 'J')
        }
    }
    if c == 76 {
        // 'L' (IL) — insert line. W23S1. Moves lines from the cursor row
        // down by n, inserts n blank lines at the cursor row. Default n=1.
        // Same glyph-buffer caveat as 'J' / 'K' — K6c has no row buffer,
        // so the line-shift is a recognized-but-state-only NO-OP. Cursor
        // column is preserved (real VT100 IL does not change col; the
        // cursor stays where it was, only the rows below shift). The K8
        // framebuffer console layer will perform the real insertion.
        let n = vt100_parse_param(s, 0);
        if n > 99 {
            s.esc_len = s.esc_len;  // no-op (defensive guard, see 'J')
        }
    }
    if c == 77 {
        // 'M' (DL) — delete line. W23S1. Removes n lines starting at the
        // cursor row, shifts lines below up by n, appends n blank lines at
        // the bottom. Default n=1. Same glyph-buffer caveat as 'L' —
        // recognized-but-state-only NO-OP at the K6c layer. Cursor column
        // preserved. K8 will perform the real deletion.
        let n = vt100_parse_param(s, 0);
        if n > 99 {
            s.esc_len = s.esc_len;  // no-op (defensive guard, see 'J')
        }
    }
    if c == 115 {
        // 's' (SCP) — save cursor position. W23S1. Saves the current
        // (row, col) into (save_row, save_col) for later restore by 'u'.
        // (The DECSC ESC 7 sequence has the same effect — K6c doesn't
        // handle ESC-alone sequences per the contract, but the CSI 's'
        // form is the ANSI.SYS / xterm alias that fits the K6c CSI-only
        // dispatch model.) No parameter parsing — 's' takes no args.
        s.save_row = s.row;
        s.save_col = s.col;
    }
    if c == 117 {
        // 'u' (RCP) — restore cursor position. W23S1. Restores (row, col)
        // from (save_row, save_col) previously saved by 's'. The restore
        // is bounds-clamped (same as CUP) in case the saved position is
        // stale relative to a subsequent terminal resize (K6c doesn't
        // support resize, but the clamp is defensive). If no 's' was
        // ever issued, save_row/save_col are 0 (from vt100_init) and
        // 'u' homes the cursor — matching xterm behavior.
        s.row = s.save_row;
        s.col = s.save_col;
        if s.row >= s.rows {
            s.row = s.rows - 1;
        }
        if s.col >= s.cols {
            s.col = s.cols - 1;
        }
    }
    // Reset escape state. Every CSI command — handled or not — ends here.
    // Unhandled final bytes (e.g. 'n' = device status report, 'h' / 'l' =
    // DEC set/reset mode, 'r' = DECSTBM scroll region) fall through all
    // the `if c == ...` clauses above without doing anything, then hit
    // this reset — the parser returns to NORMAL mode and the next byte is
    // processed fresh. This is critical: without this reset, an unhandled
    // CSI would leave the parser stuck in GOT_CSI mode, swallowing all
    // subsequent bytes as escape parameters.
    s.esc = 0;
    s.esc_len = 0;
}

// Parse a parameter from esc_buf (0-indexed). Parameters are sequences of
// digits separated by ';' — e.g. esc_buf = "10;20" has param[0]=10,
// param[1]=20. Returns 0 if the requested parameter is absent (either
// past the last ';' or esc_buf is empty).
//
// The algorithm walks esc_buf once, tracking which parameter index we're
// currently inside (cur_param). When we see a digit AND cur_param matches
// the requested param_idx, we accumulate it into v. When we see a ';',
// if cur_param == param_idx we break (we've finished reading the requested
// parameter); otherwise we increment cur_param and continue. The `found`
// flag distinguishes "parameter absent" (return 0) from "parameter was
// literally 0" (also return 0, but conceptually different — in practice
// both yield the same behavior in the caller, so the distinction is
// informational only).
fn vt100_parse_param(s: State<Vt100State>, param_idx: u32) -> u32 {
    let v: u32 = 0;
    let cur_param: u32 = 0;
    let i = 0;
    let found: u32 = 0;
    while i < s.esc_len {
        let c = s.esc_buf[i];
        if c == 59 {
            // ';' — parameter separator.
            if cur_param == param_idx {
                // We've finished reading the requested parameter.
                found = 1;
                break;
            }
            cur_param = cur_param + 1;
        } else {
            // Digit (we only store digits and ';' in esc_buf, so this is
            // always a digit). Accumulate into v if we're inside the
            // requested parameter.
            if cur_param == param_idx {
                let d = (c as u32) - 48;  // '0' (48) → 0, '9' (57) → 9.
                v = v * 10 + d;
                found = 1;
            }
        }
        i = i + 1;
    }
    if found == 1 {
        return v;
    }
    return 0;
}

// Count the number of ';' -separated parameters in esc_buf. W23S1. Used by
// the expanded SGR ('m') handler to iterate over every parameter instead of
// only the first. Returns 0 if esc_buf is empty (ESC [ m with no digits) —
// the caller treats this as a single implicit "0" (reset) per VT100 spec.
// Otherwise returns 1 + (number of ';' in esc_buf): "31" → 1, "1;31" → 2,
// "1;31;42" → 3, etc. The walk is O(n) in esc_len (≤ 16 bytes — trivial).
//
// This helper exists because vt100_parse_param returns 0 for BOTH "parameter
// absent" and "parameter is literally 0" — the loop in the SGR handler needs
// to know the actual parameter count to avoid spuriously dispatching a
// non-existent trailing parameter as "0 = reset" (which would clobber
// attributes set by earlier parameters in the same SGR sequence).
fn vt100_param_count(s: State<Vt100State>) -> u32 {
    if s.esc_len == 0 {
        return 0;
    }
    let count: u32 = 1;  // at least one param if esc_len > 0
    let i = 0;
    while i < s.esc_len {
        if s.esc_buf[i] == 59 {  // ';'
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

// ────────────────────────────────────────────────────────────────────────────
// Self-test (the K6c DoD).
// ────────────────────────────────────────────────────────────────────────────
// Sub-tests, each exercising one parser code path:
//   (1) Printable bytes + newline: feed "hello\n", check col=5 after the
//       5 chars, then row=1 after the \n. Verifies: NORMAL-mode printable
//       advance, NORMAL-mode \n line-feed.
//   (2) ESC [ 10 ; 20 H: check row=9 (10-1), col=19 (20-1). Verifies:
//       ESC → GOT_ESC transition, '[' → GOT_CSI transition, digit + ';'
//       accumulation in esc_buf, 'H' final byte → CUP dispatch,
//       vt100_parse_param parsing both parameters, 1-based → 0-based
//       conversion, and the bounds clamp (10 ≤ 25 and 20 ≤ 80, so no
//       clamp fires — but the clamp code is exercised).
//   (3) ESC [ 31m: check fg=1 (red). Verifies: 'm' final byte → SGR
//       dispatch, vt100_parse_param returns 31, the `n >= 30 && n <= 37`
//       branch fires, (n - 30) as u8 = 1.
//   (4) ESC [ 1 ; 4 ; 7 m → bold=1, underline=1, reverse=1. W23S1.
//       Verifies the multi-parameter SGR loop (vt100_param_count returns
//       3, the loop iterates i=0,1,2 dispatching n=1,4,7 to the new
//       bold/underline/reverse fields). A regression on the original
//       "first param only" stub would set ONLY bold=1 and leave
//       underline/reverse at 0 — this check catches that.
//   (5) ESC [ 0m → reset: bold=0, underline=0, reverse=0, fg=7, bg=0. W23S1.
//       Verifies the SGR 0 = reset-all path clears the new attribute flags
//       (not just fg/bg).
//   (6) ESC [ s, ESC [ 5 ; 10 H, ESC [ u → cursor returns to (1,1) (the
//       pre-save position from sub-test (2)'s CUP). W23S1. Verifies the
//       SCP/RCP round-trip: 's' writes save_row/save_col, CUP moves the
//       cursor away, 'u' restores it.
//   (7) ESC [ 2J, ESC [ K, ESC [ L, ESC [ M → each is a recognized-but-
//       state-only NO-OP. W23S1. Verifies the parser consumes each final
//       byte and returns cleanly to NORMAL mode (s.esc == 0 after each)
//       without corrupting cursor position.
//
// All assertions return distinct non-zero codes (1..16) so a failure
// pinpoints exactly which check failed. Exit 0 = all checks passed.

fn main() -> i32 {
    let s = state_new(Vt100State);
    vt100_init(s);

    // ── Sub-test (1): "hello\n" → col=5 after, row=1 after \n ──────────────
    // After vt100_init, row=0, col=0. Feed 'h','e','l','l','o' — each is a
    // printable byte in NORMAL mode, advancing col by 1: 0→1→2→3→4→5. No
    // wrap (5 < 80). Feed '\n' — NORMAL-mode LF: row=0→1, col stays 5.
    vt100_feed(s, 104);  // 'h'
    vt100_feed(s, 101);  // 'e'
    vt100_feed(s, 108);  // 'l'
    vt100_feed(s, 108);  // 'l'
    vt100_feed(s, 111);  // 'o'
    if s.row != 0 { return 1; }
    if s.col != 5 { return 2; }
    vt100_feed(s, 10);   // '\n'
    if s.row != 1 { return 3; }

    // ── Sub-test (2): ESC [ 10 ; 20 H → row=9, col=19 ─────────────────────
    // 7 bytes: ESC (27), '[' (91), '1' (49), '0' (48), ';' (59), '2' (50),
    // '0' (48), 'H' (72). The parser transitions:
    //   27  → esc=1 (GOT_ESC), esc_len=0.
    //   91  → esc=2 (GOT_CSI), esc_len=0.
    //   49  → digit, esc_buf[0]=49, esc_len=1.
    //   48  → digit, esc_buf[1]=48, esc_len=2.
    //   59  → ';',   esc_buf[2]=59, esc_len=3.
    //   50  → digit, esc_buf[3]=50, esc_len=4.
    //   48  → digit, esc_buf[4]=48, esc_len=5.
    //   72  → 'H' final byte → CUP dispatch.
    // vt100_parse_param(s, 0) walks esc_buf="10;20", parses "10" before
    // the ';', returns 10. vt100_parse_param(s, 1) skips "10;" then parses
    // "20", returns 20. CUP sets row = 10-1 = 9, col = 20-1 = 19.
    vt100_feed(s, 27);   // ESC
    vt100_feed(s, 91);   // '['
    vt100_feed(s, 49);   // '1'
    vt100_feed(s, 48);   // '0'
    vt100_feed(s, 59);   // ';'
    vt100_feed(s, 50);   // '2'
    vt100_feed(s, 48);   // '0'
    vt100_feed(s, 72);   // 'H'
    if s.row != 9 { return 4; }   // 10-1 = 9
    if s.col != 19 { return 5; }  // 20-1 = 19

    // ── Sub-test (3): ESC [ 31m → fg=1 (red) ───────────────────────────────
    // 5 bytes: ESC (27), '[' (91), '3' (51), '1' (49), 'm' (109). The
    // parser transitions:
    //   27  → esc=1.
    //   91  → esc=2.
    //   51  → digit, esc_buf[0]=51, esc_len=1.
    //   49  → digit, esc_buf[1]=49, esc_len=2.
    //   109 → 'm' final byte → SGR dispatch.
    // vt100_parse_param(s, 0) walks esc_buf="31", parses "31", returns 31.
    // SGR: n=31, the `n >= 30 && n <= 37` branch fires, s.fg = (31-30) as
    // u8 = 1 (red).
    vt100_feed(s, 27);   // ESC
    vt100_feed(s, 91);   // '['
    vt100_feed(s, 51);   // '3'
    vt100_feed(s, 49);   // '1'
    vt100_feed(s, 109);  // 'm'
    if s.fg != 1 { return 6; }  // red

    // ── Sub-test (4): ESC [ 1 ; 4 ; 7 m → bold=1, underline=1, reverse=1 ──
    // W23S1. 9 bytes: ESC, '[', '1', ';', '4', ';', '7', 'm'. The parser
    // accumulates esc_buf = "1;4;7" (6 bytes). vt100_param_count walks
    // esc_buf, counts 2 semicolons → returns 3. The SGR loop iterates
    // i=0,1,2:
    //   i=0: vt100_parse_param(s, 0) parses "1" → n=1 → s.bold = 1.
    //   i=1: vt100_parse_param(s, 1) skips "1;", parses "4" → n=4 →
    //        s.underline = 1.
    //   i=2: vt100_parse_param(s, 2) skips "1;4;", parses "7" → n=7 →
    //        s.reverse = 1.
    // A regression to the old "first param only" code would set bold=1
    // and leave underline=reverse=0 — checks 8 and 9 catch that.
    vt100_feed(s, 27);   // ESC
    vt100_feed(s, 91);   // '['
    vt100_feed(s, 49);   // '1'
    vt100_feed(s, 59);   // ';'
    vt100_feed(s, 52);   // '4'
    vt100_feed(s, 59);   // ';'
    vt100_feed(s, 55);   // '7'
    vt100_feed(s, 109);  // 'm'
    if s.bold != 1 { return 7; }         // W23S1: bold on
    if s.underline != 1 { return 8; }    // W23S1: underline on
    if s.reverse != 1 { return 9; }      // W23S1: reverse on

    // ── Sub-test (5): ESC [ 0m → reset clears bold/underline/reverse ──────
    // W23S1. After sub-test (4), bold=underline=reverse=1 and fg=1 (red
    // from sub-test 3). Feed ESC [ 0m — vt100_param_count returns 1, the
    // loop iterates once with n=0, the `n == 0` branch fires and resets
    // ALL attributes: fg=7, bg=0, bold=0, underline=0, reverse=0.
    vt100_feed(s, 27);   // ESC
    vt100_feed(s, 91);   // '['
    vt100_feed(s, 48);   // '0'
    vt100_feed(s, 109);  // 'm'
    if s.bold != 0 { return 10; }        // W23S1: bold cleared by reset
    if s.underline != 0 { return 11; }   // W23S1: underline cleared by reset
    if s.reverse != 0 { return 12; }     // W23S1: reverse cleared by reset
    if s.fg != 7 { return 13; }          // fg back to default white
    if s.bg != 0 { return 14; }          // bg back to default black

    // ── Sub-test (6): ESC [ s, move, ESC [ u → cursor returns ─────────────
    // W23S1. Current cursor is (row=9, col=19) from sub-test (2) — never
    // moved since (sub-tests 3-5 only touch SGR state, not cursor).
    // Feed ESC [ s (3 bytes: ESC, '[', 's') → SCP writes save_row=9,
    // save_col=19. Then ESC [ 5 ; 10 H moves cursor to (row=4, col=9).
    // Then ESC [ u (3 bytes: ESC, '[', 'u') → RCP reads save_row/save_col
    // back into row/col → cursor back at (9, 19).
    vt100_feed(s, 27);   // ESC
    vt100_feed(s, 91);   // '['
    vt100_feed(s, 115);  // 's' (SCP)
    // Move cursor away to (5, 10) → (row=4, col=9) after 1-based → 0-based.
    vt100_feed(s, 27);   // ESC
    vt100_feed(s, 91);   // '['
    vt100_feed(s, 53);   // '5'
    vt100_feed(s, 59);   // ';'
    vt100_feed(s, 49);   // '1'
    vt100_feed(s, 48);   // '0'
    vt100_feed(s, 72);   // 'H'
    if s.row != 4 { return 15; }   // moved away — sanity check
    if s.col != 9 { return 16; }   // moved away — sanity check
    // Restore.
    vt100_feed(s, 27);   // ESC
    vt100_feed(s, 91);   // '['
    vt100_feed(s, 117);  // 'u' (RCP)
    if s.row != 9 { return 17; }   // W23S1: restored to saved row
    if s.col != 19 { return 18; }  // W23S1: restored to saved col

    // ── Sub-test (7): ESC [ 2J / K / L / M → recognized, state-only NO-OP ─
    // W23S1. Feed each of the four recognized-but-no-op CSI sequences and
    // verify (a) the parser returns to NORMAL mode (s.esc == 0) after each
    // — proving the final byte was consumed by a handler, not left in
    // GOT_CSI mode — and (b) the cursor position is unchanged — proving
    // the no-op didn't corrupt state. The cursor was just restored to
    // (9, 19) by sub-test (6); it should stay there through all four.
    vt100_feed(s, 27);   // ESC
    vt100_feed(s, 91);   // '['
    vt100_feed(s, 50);   // '2'
    vt100_feed(s, 74);   // 'J' (ED — erase display, whole screen)
    if s.esc != 0 { return 19; }       // W23S1: parser back to NORMAL
    if s.row != 9 { return 20; }       // cursor preserved
    if s.col != 19 { return 21; }      // cursor preserved
    vt100_feed(s, 27);   // ESC
    vt100_feed(s, 91);   // '['
    vt100_feed(s, 75);   // 'K' (EL — erase line)
    if s.esc != 0 { return 22; }       // W23S1: parser back to NORMAL
    if s.row != 9 { return 23; }       // cursor preserved
    if s.col != 19 { return 24; }      // cursor preserved
    vt100_feed(s, 27);   // ESC
    vt100_feed(s, 91);   // '['
    vt100_feed(s, 76);   // 'L' (IL — insert line)
    if s.esc != 0 { return 25; }       // W23S1: parser back to NORMAL
    if s.row != 9 { return 26; }       // cursor preserved
    if s.col != 19 { return 27; }      // cursor preserved
    vt100_feed(s, 27);   // ESC
    vt100_feed(s, 91);   // '['
    vt100_feed(s, 77);   // 'M' (DL — delete line)
    if s.esc != 0 { return 28; }       // W23S1: parser back to NORMAL
    if s.row != 9 { return 29; }       // cursor preserved
    if s.col != 19 { return 30; }      // cursor preserved

    return 0;
}
