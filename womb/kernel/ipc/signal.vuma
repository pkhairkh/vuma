// ═══════════════════════════════════════════════════════════════════════════
// womb/kernel/ipc/signal.vuma
// VWK IPC Subsystem — Signals (32-signal handler table + send/deliver/check)
// (PMT-pure).
// ═══════════════════════════════════════════════════════════════════════════
//
// This file is the K7b layer of the VWK kernel: the signal primitive — a
// per-process table of 32 signal handlers (1=SIGHUP, 2=SIGINT, 9=SIGKILL,
// 15=SIGTERM, etc., matching the asm-generic numbering used by Linux on
// every architecture VWK targets) plus a 32-bit pending mask, a 32-bit
// blocked mask, and the 7 operations that manipulate them. K7 (IPC) is
// building pipe (K7a, done), signal (this file, K7b), futex (K7c), and
// shm (K7d); K7e built the foundational WaitQueue that all four rest on.
//
// Signals are the kernel's "out-of-band notification" mechanism — a way
// for one task (or the kernel itself) to interrupt another task's normal
// control flow with an event the target task has registered interest in.
// Classic uses: Ctrl-C → SIGINT to the foreground process group; parent
// death → SIGHUP to the children; kill -9 → SIGKILL (uncatchable); the
// page-oom-killer → SIGTERM. K7b's SignalTable tracks the per-process
// state that lets the kernel deliver these notifications.
//
// ── What K7b provides ──────────────────────────────────────────────────────
//   signal_init(tbl)                          — zero all 32 handlers, clear
//                                                mask, clear pending. Called
//                                                once per process during
//                                                process creation (K4a).
//   signal_install(tbl, sig, handler)         — install a handler address
//                                                for signal `sig` (1..32).
//                                                handler=0 = default action
//                                                (terminate for SIGINT/
//                                                SIGTERM, ignore for SIGCHLD),
//                                                handler=1 = ignore (SIG_IGN
//                                                in POSIX), any other value =
//                                                function address to call.
//   signal_get_handler(tbl, sig) -> u64       — read back the installed
//                                                handler for `sig`. Returns
//                                                0 if none installed (the
//                                                default-action sentinel).
//   signal_send(tbl, sig) -> i64              — post `sig` to the pending
//                                                mask. Returns 0 on
//                                                success, 22 (-EINVAL) if
//                                                sig is 0 or > 32. (In a
//                                                real kernel this would
//                                                also wake any task blocked
//                                                in pause()/sigsuspend()
//                                                via K7e's waitq_wake_one —
//                                                K7b is PMT-pure and defers
//                                                the wake to K8+ scheduler
//                                                integration.)
//   signal_check(tbl) -> u8                   — return the lowest-numbered
//                                                pending, unblocked signal
//                                                (1..32) and clear its
//                                                pending bit. Returns 0 if
//                                                nothing is deliverable. The
//                                                kernel's main loop calls
//                                                this on every return-to-user
//                                                to deliver pending signals
//                                                before resuming user code.
//   signal_block(tbl, sig)                    — add `sig` to the blocked
//                                                mask (POSIX sigprocmask
//                                                SIG_BLOCK). Blocked
//                                                signals stay pending but
//                                                are not delivered until
//                                                unblocked.
//   signal_unblock(tbl, sig)                  — remove `sig` from the
//                                                blocked mask (POSIX
//                                                sigprocmask SIG_UNBLOCK).
//   signal_deliver(tbl, sig) -> u32           — (W40) deliver a single
//                                                pending signal to its
//                                                installed handler.
//                                                Validates sig (1..32),
//                                                checks the pending bit,
//                                                fetches the handler, and
//                                                if both present invokes
//                                                the handler via the
//                                                Wave 5 __call_indirect1
//                                                trampoline (passing sig
//                                                as the single SysV AMD64
//                                                argument). Clears the
//                                                pending bit AFTER the
//                                                handler returns. Returns
//                                                1 if delivered, 0 if not
//                                                (not pending, no handler,
//                                                or sig out of range).
//   signal_check_and_deliver(tbl) -> u32      — (W40) deliver ALL pending
//                                                signals with installed
//                                                handlers in one pass.
//                                                Walks signals 1..32 in
//                                                ascending order; for
//                                                each pending signal,
//                                                calls signal_deliver.
//                                                Returns the count of
//                                                signals actually
//                                                delivered. Does NOT
//                                                respect the blocked mask
//                                                (per the W40 contract —
//                                                K8+ may add a mask-
//                                                respecting variant).
//
// ── SignalTable layout (NEW in K7b) ─────────────────────────────────────────
//   layout SignalTable = {
//       handlers: [u8; 256],  // 32 * 8 bytes — u64 handler function addr
//                              // per signal, stored little-endian byte-by-
//                              // byte (VUMA has no u64 array indexing, so
//                              // each 8-byte slot is 8 separate u8 cells).
//                              // Signal `sig` (1..32) lives at byte
//                              // offset (sig-1) * 8. handlers[0..7] =
//                              // SIGHUP's address, [8..15] = SIGINT's,
//                              // ..., [248..255] = signal 32's.
//       mask:     u32,         // blocked signals. Bit N (0..31) set means
//                              // signal N+1 is blocked (will not be
//                              // delivered by signal_check, but stays
//                              // pending). The bit-to-signal mapping is
//                              // signal = bit_position + 1 (so SIGINT=2
//                              // → bit 1, SIGKILL=9 → bit 8, SIGTERM=15
//                              // → bit 14).
//       pending:  u32,         // pending signals. Same bit-to-signal
//                              // mapping as mask. A bit set here means
//                              // "signal_send was called for this signal,
//                              // but signal_check has not yet delivered
//                              // it (either because it's blocked, or
//                              // because the kernel hasn't reached a
//                              // delivery point yet)."
//   }
//
// Field byte-offsets (verified by IVE's layout resolver):
//     handlers   [  0 .. 255]  256 bytes  (32 × 8-byte slots)
//     mask       [256 .. 259]    4 bytes  (u32, 4-aligned — pad to 8)
//     pending    [264 .. 267]    4 bytes  (u32)
//   total: 268 bytes, padded to 272 for 8-byte alignment of the trailing
//   State<T> footprint (the codegen rounds State<T> sizes up to a multiple
//   of the largest field's alignment; here that's 8 because the 256-byte
//   array slot is 8-byte aligned in the runtime PMT buffer pool — the
//   [u8; 256] array is treated as a single 256-byte block whose natural
//   alignment is 1, but State<T> footprints round to 8 regardless).
//
// NOTE on handler storage: the handlers field is `[u8; 256]`, NOT
// `[u64; 32]`. VUMA's parser accepts `[u64; 32]` as a layout field, but
// indexing it (`tbl.handlers[i]`) only yields a u8 cell — VUMA's array
// indexing is byte-granular regardless of the element type (see K7a's
// `Pipe.buf: [u8; 256]` and K4a's `ProcessTable.names: [u8; 256*32]`
// for the same byte-array pattern). So whether we declare `[u8; 256]`
// or `[u64; 32]`, we still have to store/load the 8-byte handler
// addresses byte-by-byte. Declaring it as `[u8; 256]` is the cleaner
// choice — it makes the byte-by-byte access pattern self-documenting
// (no reader will be misled into thinking `tbl.handlers[2]` returns
// the whole SIGINT handler).
//
// ── Signal numbering (asm-generic, Linux 6.x) ───────────────────────────────
//   1  SIGHUP       hangup detected on controlling terminal or death of
//                   controlling process
//   2  SIGINT       interrupt from keyboard (Ctrl-C)
//   3  SIGQUIT      quit from keyboard (Ctrl-\)
//   4  SIGILL       illegal instruction
//   5  SIGTRAP      trace/breakpoint trap
//   6  SIGABRT      abort signal from abort(3)
//   7  SIGBUS       bus error (bad memory access)
//   8  SIGFPE       floating-point exception
//   9  SIGKILL      kill signal (uncatchable, unblockable — K8+ will
//                   enforce this in signal_send by ignoring the mask
//                   bit for signal 9)
//   10 SIGUSR1      user-defined signal 1
//   11 SIGSEGV      invalid memory reference
//   12 SIGUSR2      user-defined signal 2
//   13 SIGPIPE      broken pipe (write to pipe with no readers — K7a's
//                   pipe_write returns 32 / -EPIPE in this case)
//   14 SIGALRM      timer signal from alarm(2)
//   15 SIGTERM      termination signal (kill(1) default)
//   16 SIGSTKFLT    stack fault on coprocessor (unused, x86-only)
//   17 SIGCHLD      child stopped or terminated (K4e's wait() is
//                   notified via this signal in real Unix)
//   18 SIGCONT      continue if stopped
//   19 SIGSTOP      stop process (uncatchable, unblockable — like SIGKILL)
//   20 SIGTSTP      stop typed at terminal (Ctrl-Z)
//   21 SIGTTIN      background process trying to read from tty
//   22 SIGTTOU      background process trying to write to tty
//   23 SIGURG       urgent condition on socket
//   24 SIGXCPU      CPU time limit exceeded
//   25 SIGXFSZ      file size limit exceeded
//   26 SIGVTALRM    virtual alarm clock
//   27 SIGPROF      profiling alarm clock
//   28 SIGWINCH     window resize signal
//   29 SIGIO        I/O now possible (poll-style notification)
//   30 SIGPWR       power failure
//   31 SIGSYS       bad system call
//   32 SIGRTMIN-32  first real-time signal (rarely used; on Linux the
//                   first 32 are "standard" and 33+ are "real-time")
//
// K7b only manipulates the bit-to-signal mapping — it doesn't enforce
// the catchability rules (SIGKILL=9 and SIGSTOP=19 cannot be caught or
// blocked). The K8+ signal delivery layer will enforce those rules in
// signal_install (reject installs for sig=9 and sig=19) and signal_block
// (reject blocks for sig=9 and sig=19). K7b's PMT-pure self-test does
// NOT test the catchability rules because the contract's reference
// implementation doesn't enforce them.
//
// ── Bit-to-signal mapping ───────────────────────────────────────────────────
//   Signal `sig` (1..32) → bit (sig - 1) in mask/pending (0..31).
//   bit mask = `1 as u32 << (sig - 1)`.
//   Signal from bit `b` (0..31) → sig = b + 1.
//   The `1 as u32` cast is necessary because the literal `1` parses as
//   i64 by default (VUMA's int literal type inference prefers i64 for
//   bare integer literals — see bignum.vuma line 330 for the same
//   `1 as u64 << q_pos` pattern). Without the cast, `1 << (sig - 1)`
//   would shift within i64 — which would still work correctly for
//   signals 1..32 (the shift result fits in u32), but the result type
//   would be i64, requiring an `as u32` cast before storing into
//   `tbl.mask` / `tbl.pending` (u32 fields). The `1 as u32` cast makes
//   the whole expression u32-typed, so no extra cast is needed on the
//   store. This matches the K7b contract's literal reference text.
//
// ── Bitwise NOT (`~`) on u32 ────────────────────────────────────────────────
//   The K7b contract uses `~tbl.mask` for the complement of the mask,
//   and `~bit` for the complement of a single-bit mask (used to clear a
//   pending bit). VUMA's `~` operator lowers to `operand XOR -1` (see
//   src/pipeline.rs::flatten_expr, UnOp::BitNot arm — the rhs is
//   `ScgExpr::Int(-1)`, which is i64 0xFFFFFFFFFFFFFFFF). When the
//   operand is a u32 value loaded into an i64 register (zero-extended),
//   `~mask` produces an i64 with the LOW 32 bits = ~mask_low and the
//   HIGH 32 bits = 0xFFFFFFFF (because mask_high was 0, ~0 = all-1s).
//   This is then ANDed with `tbl.pending` (also u32, zero-extended,
//   high 32 = 0). The high-high AND (0xFFFFFFFF & 0x00000000) = 0, so
//   the upper 32 bits of the result are 0 — exactly what we want for a
//   u32 value. The low-low AND (mask_low_complement & pending_low) is
//   the correct 32-bit "pending AND NOT mask". Verified by probe
//   /home/z/probe/probe_signal.vuma: `tbl.pending = 0xFFFFFFFF;
//   tbl.mask = 16386; deliverable = tbl.pending & (~tbl.mask);` →
//   4294950909 (0xFFFFBFFD). ✓
//
//   An alternative is to use XOR with 4294967295 (= 0xFFFFFFFF as u32,
//   = -1 as i32): `tbl.pending & (tbl.mask ^ 4294967295)`. This
//   explicitly masks to 32 bits. The K7b contract's "or use XOR with
//   4294967295" note offers this as a fallback. THIS file uses `~`
//   directly (the contract's first choice) because the probe confirmed
//   it produces the correct 32-bit result via the zero-extension
//   argument above. The same `~` pattern is used in womb/crypto/hmac.vuma
//   line 191 (with an extra `& HMAC_MASK32` for paranoia — but the
//   probe shows the extra mask is unnecessary when the OTHER operand
//   is also u32, as it is here).
//
// ── `signal_check` semantics: lowest-numbered pending signal wins ───────────
//   signal_check scans the deliverable mask (pending & ~mask) from bit 0
//   (SIGHUP) to bit 31 (signal 32), returns the FIRST set bit's signal
//   number (1..32), and CLEARS that bit in pending. This matches POSIX's
//   "lowest signal number first" delivery order (POSIX doesn't actually
//   MANDATE this for non-realtime signals, but Linux's get_signal() loop
//   does it that way and most user-space assumes it). The clear-on-
//   deliver means a subsequent signal_check will return the next pending
//   signal (or 0 if nothing else is pending). Real-time signals (33+)
//   have a different delivery rule (queue per signal, deliver in order
//   of arrival) — K7b doesn't model those (only signals 1..32).
//
//   The clear-on-deliver is what makes signal_check a "consume" operation
//   rather than a "peek" operation. The kernel's main loop calls
//   signal_check in a loop until it returns 0, delivering each pending
//   signal in turn before resuming user code.
//
// ── Handler invocation: W40 adds signal_deliver ─────────────────────────────
//   Pre-W40 (K7b baseline): signal_install stores the handler address,
//   signal_check returns the signal number, but NEITHER function CALLS
//   the handler. The handler invocation was deferred to the K8+
//   delivery layer (which would push a signal trampoline frame onto
//   the target task's user stack, set RIP to the handler address, set
//   RSP to the trampoline frame, and let the task resume into the
//   handler; on return, the trampoline does an rt_sigreturn syscall to
//   restore the pre-signal register state). The actual control-flow
//   manipulation requires the trap machinery from K3a/K3b/K3c.
//
//   W40 closes the "handler is never called" gap at the PMT-pure layer:
//   signal_deliver invokes the handler via the Wave 5 __call_indirect1
//   trampoline (declared in this file's extern block — `mov rax,rdi;
//   mov rdi,rsi; jmp rax`, an 8-byte tail-call stub registered in
//   src/codegen/src/x86_64/mod.rs::build_runtime_syscall_stubs). The
//   handler receives `sig as u64` as its single SysV AMD64 argument
//   (RDI); the u64 return value is currently discarded (POSIX signal
//   handlers conventionally return void; K8+ may inspect the return
//   for handler-fault reporting). The State<SignalTable> is preserved
//   across the extern call because it is passed as a regular VUMA-fn
//   borrow, NOT as an extern #[borrow] State<T> param (only extern
//   #[borrow] State<T> params are conservatively invalidated — see W5's
//   dispatch.vuma for the same reasoning, and char.vuma:203-209 /
//   procfs.vuma:736-743 / irq.vuma:452-460 for the same preservation
//   argument in sibling dispatch wrappers).
//
//   This is NOT the full K8+ delivery layer — there is no trap-frame
//   push, no user-stack trampoline, no rt_sigreturn. signal_deliver
//   invokes the handler SYNCHRONOUSLY in the caller's context (the
//   kernel's main loop calls signal_deliver on return-to-user, the
//   handler runs in kernel context, returns, and signal_deliver clears
//   the pending bit). This is sufficient for PMT-pure self-testing +
//   for kernel-internal signal consumers (e.g. a kernel thread that
//   installs a handler for SIGKILL to do cleanup before exit). The K8+
//   delivery layer will add the user-context trampoline machinery on
//   top of signal_deliver (calling signal_deliver from the trap-return
//   path after building the trampoline frame).
//
// ── No wait-queue integration in K7b ────────────────────────────────────────
//   K7e's wait queue is the foundation for pause() / sigsuspend() — a
//   task that calls pause() blocks on a sigwaitq until a signal arrives.
//   In a real kernel, signal_send would call waitq_wake_one(sigwaitq) to
//   wake the blocked task. K7b does NOT include a sigwaitq field in
//   SignalTable (the contract's layout has only handlers/mask/pending),
//   and signal_send does NOT call waitq_wake_one. This is the same PMT-
//   pure simplification K7a made for pipe (K7a includes the waitq fields
//   but the self-test never adds any waiters — see K7a's "Why no actual
//   blocking?" header note). K8+ scheduler integration will add the
//   sigwaitq to SignalTable and wire signal_send into waitq_wake_one.
//   The K7b self-test only checks the synchronous paths (install → send
//   → check → block → unblock) — no actual task blocking is tested.
//
// ── Error codes (decimal, per the K7b contract) ─────────────────────────────
//   22 = EINVAL ("Invalid argument"). The K7b contract specifies
//        signal_send returns 22 (POSITIVE 22, not -22) for sig=0 or sig>32.
//        K7a and K7e used the same positive-error convention (K7a: 11 =
//        EAGAIN, 32 = EPIPE; K7e: -1 as i64 via `0 - 1`). The positive-
//        error convention matches the K4e wait() contract and is the
//        project-wide standard for kernel-internal error codes (the
//        syscall layer in K4f will negate them to -errno before returning
//        to user space, matching Linux's syscall ABI). The K7b self-test
//        checks `if ret != 22` (positive 22) on signal_send's EINVAL
//        path — see main() below.
//   0  = success (signal_send returns 0 on valid sig).
//
// ── PMT discipline ─────────────────────────────────────────────────────────
//   NO `*ptr`, `&x`, `allocate`, or `free` anywhere in this file. The
//   SignalTable is a flat struct held in a `___pmt_buffer`-backed
//   State<SignalTable>; the CALLER allocates it via
//   `state_new(SignalTable)` and passes it by reference to signal_init /
//   signal_install / signal_get_handler / signal_send / signal_check /
//   signal_block / signal_unblock / signal_deliver /
//   signal_check_and_deliver (init-style API — see "Why init-style?"
//   in K4e's wait.vuma header for the codegen rationale: the current
//   codegen does NOT propagate State-typedness through function return
//   values, so `fn signal_new() -> State<SignalTable>` would produce
//   broken field-access code in callers).
//
//   W40 adds ONE extern declaration: `__call_indirect1(ptr: u64, arg:
//   u64) -> u64` (the Wave 5 indirect-call trampoline). It is NOT a C
//   library function — it's a runtime stub emitted by
//   src/codegen/src/x86_64/mod.rs::build_runtime_syscall_stubs (8
//   bytes: `mov rax,rdi; mov rdi,rsi; jmp rax` — a tail call that
//   invokes the function at `ptr` with `arg` in RDI per SysV AMD64).
//   signal_deliver uses it to invoke the per-signal handler installed
//   via signal_install. The State<SignalTable> is preserved across the
//   extern call because it is passed as a regular VUMA-fn borrow, NOT
//   as an extern #[borrow] State<T> param (only extern #[borrow]
//   State<T> params are conservatively invalidated — see the extern
//   block's comment above + W5's dispatch.vuma for the same reasoning).
//   Pre-W40, no externs were declared in this file (signal was pure-PM
//   on the SignalTable — no syscalls, no context switch, no memory
//   allocation, no handler invocation). W40 adds the handler-invocation
//   extern; everything else remains pure-PM.
//
//   The handler addresses installed by signal_install are u64 values
//   (NOT first-class function-pointer types — VUMA has no fn-ptr type).
//   The W40 self-test installs a REAL handler address via the Wave 5
//   FnAddr feature (`signal_test_handler as u64` — lowers to a
//   compile-time `mov rax, imm64` constant load via IRInstr::GetAddress;
//   see womb/kernel/syscall/syscall_init.vuma's header "Why `fn_name as
//   u64`?" for the full lowering chain). The self-test's address-of-
//   function reference is preserved by the O2 whole_program_dce pass
//   per the Wave 39 fix (the pass now scans for IRInstr::GetAddress
//   references, not just IRInstr::Call — see syscall_init.vuma's header
//   "Wave 39 codegen fix").
//
//   State<T> params: 1 per function (tbl only), per the K4b contract's
//   "1-2 per function" rule. The signal_* functions don't need a
//   ProcessTable or a Task — they're manipulating only the per-process
//   SignalTable. K8+ scheduler integration will add a State<Task>
//   parameter to signal_send (to look up the target's SignalTable from
//   the task index — K7b's caller does this lookup itself and passes
//   the resulting State<SignalTable> directly).
//
// ── Decimal-constants discipline ────────────────────────────────────────────
//   All non-zero constants in this file use DECIMAL per the K7b contract's
//   "Use decimal constants" rule. Decimal avoids the parser's hex-literal
//   path (parse_int_radix width-extension subtleties — see
//   womb/kernel/arch/x86_64/pt.vuma header for the same rationale, and
//   K3a's trap_trampoline.vuma for the same rule). The constants:
//     256  = handlers array size (32 signals × 8 bytes per handler).
//     32   = maximum signal number (asm-generic upper bound).
//     8    = bytes per handler (u64 address, stored as 8 u8 cells).
//     255  = single-byte mask for the low 8 bits (used in
//            signal_install / signal_get_handler's `(handler >> sh) & 255`
//            byte-extraction).
//     22   = EINVAL (signal_send's error return for sig=0 or sig>32).
//     1    = the `1` in `1 as u32 << (sig - 1)` (the single bit being
//            shifted into position) and the `1` in `i + 1` (signal-
//            from-bit conversion: bit i → signal i+1).
//     1000, 2, 15, 10, 12, 1, 3 = self-test constants (SIGINT handler
//                  address 1000, signal numbers 2/15/10/12/1/3 — see
//                  the self-test header below for which step uses which).
//                  W40 adds 10 (SIGUSR1), 12 (SIGUSR2), 1 (SIGHUP),
//                  3 (SIGQUIT) for the signal_deliver /
//                  signal_check_and_deliver tests.
//
// ── VUMA has no `import` ────────────────────────────────────────────────────
//   This file is self-contained. It declares the SignalTable layout (new
//   to this file — no prior VWK file declares a SignalTable) + the
//   Wave 5 __call_indirect1 extern (re-declared byte-identically to
//   womb/kernel/syscall/dispatch.vuma, womb/kernel/trap/irq.vuma,
//   womb/kernel/trap/trap.vuma, womb/kernel/drivers/char.vuma, and
//   womb/kernel/fs/procfs.vuma — VUMA's lack of `import` means each
//   consumer file re-declares the extern; see K1a-hosted's "no-import
//   re-declaration rule" header note for the same pattern). No helpers
//   from other files — signal_* is a closed 9-function API (init,
//   install, get_handler, send, check, block, unblock, deliver,
//   check_and_deliver) + the signal_test_handler self-test helper. K8+
//   files that need to manipulate signals (the scheduler's signal-
//   delivery layer, the syscall layer's kill() / sigaction() /
//   sigprocmask() wrappers) will re-declare the layout byte-identically
//   and call these functions directly.
//
// ── Build & verify (hosted x86_64) ──────────────────────────────────────────
//     . "$HOME/.cargo/env" && \
//         ./target/release-fast/compile_dump \
//         womb/kernel/ipc/signal.vuma \
//         /tmp/signal.bin x86_64 --verify
//     /tmp/signal.bin ; echo "exit=$?"
// Expected: IVE Pass, exit=0 (all 14 self-test checks pass):
//   (1-2)   install + get_handler round-trip (SIGINT handler=1000).
//   (3-4)   send SIGINT returns 0; check returns 2 (pending + unblocked).
//   (5-6)   second check returns 0 (pending bit cleared).
//   (7-8)   block SIGTERM + send + check returns 0 (blocked); unblock +
//           check returns 15 (now deliverable).
//   (9-10)  [W40] install REAL handler for SIGUSR1 via `fn_name as u64`
//           (Wave 5 FnAddr); send + signal_deliver returns 1 (handler
//           actually invoked via __call_indirect1 — program reaches the
//           check, proving the handler ran and returned).
//   (11)    [W40] pending bit cleared after signal_deliver.
//   (12)    [W40] signal_deliver on non-pending signal returns 0.
//   (13-14) [W40] signal_deliver on pending-no-handler returns 0;
//           cleanup via signal_check.
//   (15-16) [W40] signal_check_and_deliver delivers 2 signals (SIGHUP +
//           SIGQUIT, both with real handlers) and clears all pending.

// ────────────────────────────────────────────────────────────────────────────
// Extern "C" trampoline — indirect call (Wave 5, used by signal_deliver).
// ────────────────────────────────────────────────────────────────────────────
extern "C" {
    // Wave 5: indirect function call trampoline. Tail-calls the function
    // at `ptr` with `arg` in RDI (SysV AMD64). Used by signal_deliver to
    // invoke the per-signal handler installed via signal_install. Same
    // stub category as write/read/exit — NOT a C library function. Real
    // asm body registered in src/codegen/src/x86_64/mod.rs::build_runtime_
    // syscall_stubs (8 bytes: mov rax,rdi; mov rdi,rsi; jmp rax).
    //
    // The State<SignalTable> is preserved across the extern call because
    // it is passed as a regular VUMA-fn borrow, NOT as an extern #[borrow]
    // State<T> param (only extern #[borrow] State<T> params are
    // conservatively invalidated — see W5's dispatch.vuma for the same
    // reasoning, and char.vuma:203-209 for the same preservation argument
    // in the chardev_read dispatch wrapper).
    fn __call_indirect1(ptr: u64, arg: u64) -> u64;
}

// ────────────────────────────────────────────────────────────────────────────
// Layout.
// ────────────────────────────────────────────────────────────────────────────

// SignalTable: per-process signal state.
// 3 fields × (256 + 4 + 4) = 264 bytes (padded to 272 for 8-byte alignment
// of the trailing State<T> footprint — see "SignalTable layout" in the
// file header for the rationale).
//
// handlers is `[u8; 256]` rather than `[u64; 32]` because VUMA's array
// indexing is byte-granular regardless of element type (see "NOTE on
// handler storage" in the file header). Each 8-byte slot holds one u64
// handler address, stored little-endian byte-by-byte via the
// signal_install byte-loop. Signal `sig` (1..32) lives at byte offset
// (sig - 1) * 8.
//
// mask and pending are u32 (32 bits = 32 signals). Bit N (0..31) in
// mask = signal N+1 is blocked. Bit N in pending = signal N+1 has been
// sent but not yet delivered. The bit-to-signal mapping is
// signal = bit_position + 1 (matching the asm-generic numbering — bit 0
// is SIGHUP=1, bit 1 is SIGINT=2, ..., bit 31 is signal 32).
layout SignalTable = {
    handlers: [u8; 256],  // 32 * 8 bytes — u64 handler addr per signal
    mask:     u32,        // blocked signals (bit N = signal N+1 blocked)
    pending:  u32,        // pending signals (bit N = signal N+1 pending)
}

// ────────────────────────────────────────────────────────────────────────────
// SignalTable operations.
// ────────────────────────────────────────────────────────────────────────────

// signal_init: zero the signal table. Sets all 32 handler slots to 0
// (default-action sentinel — no handler installed), mask = 0 (no signals
// blocked), pending = 0 (no signals pending). Called once per process
// during process creation (K4a's pt_alloc would call this on the new
// task's SignalTable slot before returning the new pid). The CALLER
// allocates the SignalTable via `state_new(SignalTable)` and passes it
// by reference (init-style API — see "Why init-style?" in K4e's
// wait.vuma header for the codegen rationale).
//
// State<T> params: 1 (tbl). Pure write — no reads, no helper calls.
// The 256-byte handlers array is zeroed by a single while loop (the
// same pattern as K7a's pipe_init zeroing the 256-byte ring buffer).
fn signal_init(tbl: State<SignalTable>) {
    // Zero all handler slots.
    let i = 0;
    while i < 256 {
        tbl.handlers[i] = 0;
        i = i + 1;
    }
    tbl.mask = 0;
    tbl.pending = 0;
}

// signal_install: install a handler address for signal `sig`.
//
//   sig: 1..32 (signal number, asm-generic). Out-of-range values are
//        silently ignored (return without modifying the table) — the
//        caller is responsible for validating sig before calling
//        (K8+ sigaction() syscall wrapper will return -EINVAL to user
//        space; K7b's signal_install just no-ops).
//   handler: u64 function address (or 0 = default action, 1 = ignore).
//        The K8+ sigaction() layer will resolve user-space function
//        pointers to kernel-side trampoline addresses before calling
//        signal_install; K7b itself just stores whatever u64 the caller
//        passes.
//
// The handler is stored little-endian byte-by-byte at byte offset
// (sig - 1) * 8 in tbl.handlers. Each byte is extracted from `handler`
// by shifting right by (i * 8) bits and masking with 255. The
// `(handler >> sh) & 255` pattern is the standard VUMA byte-extraction
// idiom (same as bignum.vuma's bn_store_u64 reverse).
//
// State<T> params: 1 (tbl). Pure write — writes 8 bytes into
// tbl.handlers[off..off+8]. No reads, no helper calls.
fn signal_install(tbl: State<SignalTable>, sig: u8, handler: u64) {
    if sig == 0 { return; }
    if sig > 32 { return; }
    let off = (sig as u32 - 1) * 8;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let b = (handler >> sh) & 255;
        tbl.handlers[off + i] = b as u8;
        i = i + 1;
    }
}

// signal_get_handler: read back the installed handler for signal `sig`.
//
// Returns the u64 handler address (or 0 if none installed / sig out of
// range). The handler is reconstructed from the 8 little-endian bytes
// at tbl.handlers[(sig-1)*8 .. (sig-1)*8 + 7] by shifting each byte
// left by (i * 8) bits and OR-ing into the accumulator. The `v + (b << sh)`
// form is the standard VUMA byte-assembly idiom (same as bignum.vuma's
// bn_load_u64 — but using `+` instead of `|` because the bytes are
// guaranteed non-overlapping in their bit positions, so `+` and `|`
// produce the same result; the K7b contract's reference text uses `+`).
//
// State<T> params: 1 (tbl). Pure read — reads 8 bytes from
// tbl.handlers[off..off+8]. No writes, no helper calls.
fn signal_get_handler(tbl: State<SignalTable>, sig: u8) -> u64 {
    if sig == 0 { return 0; }
    if sig > 32 { return 0; }
    let off = (sig as u32 - 1) * 8;
    let v: u64 = 0;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let b = tbl.handlers[off + i] as u64;
        v = v + (b << sh);
        i = i + 1;
    }
    return v;
}

// signal_send: post a signal to the pending mask.
//
//   sig: 1..32 (signal number). Out-of-range values return 22 (EINVAL).
//
// Sets the pending bit for `sig` (bit (sig - 1) in tbl.pending). The
// signal is NOT immediately delivered — delivery happens when
// signal_check is next called AND the signal is not blocked.
//
// Returns 0 on success, 22 (EINVAL, positive) if sig is 0 or > 32.
//
// (In a real kernel, signal_send would ALSO:
//   (1) Look up the target task's State<SignalTable> from the pid
//       (this K7b version takes the table directly — the K8+ kill()
//       syscall wrapper will do the pid → table lookup).
//   (2) If the target task is blocked in pause() / sigsuspend() /
//       interruptible sleep, wake it via waitq_wake_one(sigwaitq).
//       K7b's SignalTable has no sigwaitq field — see "No wait-queue
//       integration in K7b" in the file header.
//   (3) If sig is SIGKILL (9) or SIGSTOP (19), bypass the mask and
//       force-deliver. K7b doesn't enforce catchability rules — see
//       "Signal numbering" in the file header.)
//
// State<T> params: 1 (tbl). Reads tbl.pending, writes tbl.pending.
fn signal_send(tbl: State<SignalTable>, sig: u8) -> i64 {
    if sig == 0 { return 22; }  // -EINVAL
    if sig > 32 { return 22; }  // -EINVAL
    let bit = 1 as u32 << (sig - 1);
    tbl.pending = tbl.pending | bit;
    return 0;
}

// signal_check: return the lowest-numbered pending, unblocked signal
// and clear its pending bit. Returns 0 if nothing is deliverable.
//
// This is the kernel's "signal delivery point" — called on every
// return-to-user (and after every interruptible sleep) to deliver any
// signals that arrived while the task was in the kernel. The kernel
// calls signal_check in a loop until it returns 0, delivering each
// pending signal in turn (lowest first) before resuming user code.
//
// Implementation:
//   (1) Compute deliverable = pending & ~mask. (Blocked signals stay
//       pending but are not delivered.) The `~tbl.mask` is bitwise NOT
//       on u32 — see "Bitwise NOT (`~`) on u32" in the file header for
//       why this produces the correct 32-bit result via zero-extension.
//   (2) If deliverable == 0, return 0 (nothing to deliver).
//   (3) Scan from bit 0 (SIGHUP) to bit 31 (signal 32). Return the
//       FIRST set bit's signal number (i + 1) and clear that bit in
//       tbl.pending via `tbl.pending = tbl.pending & (~bit)`. The clear
//       makes signal_check a "consume" operation — the next call will
//       return the NEXT pending signal (or 0). The `~bit` is bitwise
//       NOT on u32 — same zero-extension argument as step (1).
//
// State<T> params: 1 (tbl). Reads tbl.pending + tbl.mask, writes
// tbl.pending (the clear-bit path). The `let deliverable = ...` local-
// capture pattern is the same as K4b's scheduler.vuma `let min_idx =
// rq.head;` — direct field read into a local, then subsequent field
// writes (in the loop body) don't affect the local (verified to work
// by scheduler.vuma's self-test and by K7e's waitq_wake_all).
fn signal_check(tbl: State<SignalTable>) -> u8 {
    let deliverable = tbl.pending & (~tbl.mask);
    if deliverable == 0 {
        return 0;
    }
    // Find the lowest-numbered pending signal.
    let i = 0;
    while i < 32 {
        let bit = 1 as u32 << i;
        if (deliverable & bit) != 0 {
            // Clear the pending bit.
            tbl.pending = tbl.pending & (~bit);
            return (i + 1) as u8;
        }
        i = i + 1;
    }
    return 0;
}

// signal_block: add `sig` to the blocked mask.
//
//   sig: 1..32 (signal number). Out-of-range values are silently
//        ignored (same convention as signal_install).
//
// Sets the bit (sig - 1) in tbl.mask. Blocked signals stay pending
// (signal_send still posts them to tbl.pending) but are NOT delivered
// by signal_check until signal_unblock is called. This matches POSIX
// sigprocmask(SIG_BLOCK, ...).
//
// (In a real kernel, SIGKILL=9 and SIGSTOP=19 cannot be blocked — K7b
// doesn't enforce this; see "Signal numbering" in the file header.)
//
// State<T> params: 1 (tbl). Reads tbl.mask, writes tbl.mask.
fn signal_block(tbl: State<SignalTable>, sig: u8) {
    if sig == 0 { return; }
    if sig > 32 { return; }
    let bit = 1 as u32 << (sig - 1);
    tbl.mask = tbl.mask | bit;
}

// signal_unblock: remove `sig` from the blocked mask.
//
//   sig: 1..32 (signal number). Out-of-range values are silently
//        ignored (same convention as signal_install / signal_block).
//
// Clears the bit (sig - 1) in tbl.mask via `tbl.mask & (~bit)`. The
// `~bit` is bitwise NOT on u32 — same zero-extension argument as
// signal_check. After unblock, signal_check will deliver any pending
// instance of `sig` on the next call. This matches POSIX
// sigprocmask(SIG_UNBLOCK, ...).
//
// State<T> params: 1 (tbl). Reads tbl.mask, writes tbl.mask.
fn signal_unblock(tbl: State<SignalTable>, sig: u8) {
    if sig == 0 { return; }
    if sig > 32 { return; }
    let bit = 1 as u32 << (sig - 1);
    tbl.mask = tbl.mask & (~bit);
}

// signal_deliver: deliver a single pending signal to its handler.
//
//   sig: 1..32 (signal number). Out-of-range values return 0 (no
//        delivery — same convention as signal_install / signal_block).
//
// This is the "actually invoke the handler" step that signal_check
// deferred (signal_check returns the signal NUMBER; signal_deliver
// CALLS the handler). The kernel's main loop calls signal_deliver
// after signal_check returns a non-zero signal number, OR calls
// signal_check_and_deliver (below) to do both in one pass.
//
// Implementation:
//   (1) Validate sig (1..32). Out-of-range → return 0.
//   (2) Compute the pending bit `1 as u32 << (sig - 1)`. If the bit
//       is NOT set in tbl.pending, return 0 (signal not pending —
//       nothing to deliver).
//   (3) Fetch the installed handler via signal_get_handler(tbl, sig).
//       If handler == 0, return 0 (no handler installed — the K8+
//       delivery layer would take the default action here: terminate
//       for SIGINT/SIGTERM, ignore for SIGCHLD, etc.; K7b's
//       signal_deliver just reports "not delivered" and leaves the
//       pending bit set so a later install + deliver can still fire).
//   (4) Call the handler via the Wave 5 indirect-call trampoline:
//         let handler_ret = __call_indirect1(handler, sig as u64);
//       The handler receives `sig as u64` as its single SysV AMD64
//       argument (RDI). The u64 return value is currently discarded
//       (POSIX signal handlers conventionally return void; K8+ may
//       inspect the return for handler-fault reporting). The
//       State<SignalTable> is preserved across the extern call
//       because it is passed as a regular VUMA-fn borrow, NOT as an
//       extern #[borrow] State<T> param (only extern #[borrow]
//       State<T> params are conservatively invalidated — same
//       pattern as char.vuma's chardev_read / procfs.vuma's
//       procfs_read / irq.vuma's irq_dispatch_loop).
//   (5) Clear the pending bit: tbl.pending = tbl.pending & (~bit).
//       The clear happens AFTER the handler returns (per the W40
//       task spec's literal step ordering — "call __call_indirect1"
//       then "Clear the pending bit"). In PMT-pure, the handler
//       cannot re-enter signal_send (it has no State<SignalTable>
//       access — only the single u64 sig argument), so the clear-
//       after-call vs clear-before-call ordering is observationally
//       equivalent here. K8+ (where the handler MAY gain shared-
//       state access via the trap frame) should swap to clear-
//       BEFORE-call to match POSIX's "a signal delivered during
//       another signal's handler is queued for the next delivery
//       pass" semantics — clear-after-call would lose a re-entrant
//       re-post. The `~bit` is bitwise NOT on u32 — same zero-
//       extension argument as signal_check's clear-on-deliver (see
//       "Bitwise NOT (`~`) on u32" in the file header).
//   (6) Return 1 (delivered).
//
// State<T> params: 1 (tbl). Reads tbl.pending, reads tbl.handlers
// (via signal_get_handler), writes tbl.pending (the clear-bit step).
// Calls the __call_indirect1 extern (passes handler + sig as u64).
fn signal_deliver(tbl: State<SignalTable>, sig: u32) -> u32 {
    if sig == 0 { return 0; }
    if sig > 32 { return 0; }
    let bit = 1 as u32 << (sig - 1);
    if (tbl.pending & bit) == 0 {
        return 0;  // not pending — nothing to deliver
    }
    let handler = signal_get_handler(tbl, sig as u8);
    if handler == 0 {
        return 0;  // no handler installed — default action is K8+
    }
    // Wave 5: invoke the per-signal handler via the indirect-call
    // trampoline. The handler receives `sig as u64` as its first SysV
    // AMD64 argument (RDI). The u64 return is discarded (POSIX signal
    // handlers conventionally return void). The State<SignalTable> is
    // preserved across the extern call (regular VUMA-fn borrow, not
    // extern #[borrow] — see the extern-block comment above).
    let handler_ret = __call_indirect1(handler, sig as u64);
    // Clear the pending bit AFTER the handler returns. The W40 task
    // spec lists this as the step immediately following the handler
    // call. In PMT-pure, the handler cannot re-enter signal_send (it
    // has no State<SignalTable> access — only the single u64 sig
    // argument), so the clear-after-call vs clear-before-call ordering
    // is observationally equivalent here. K8+ (where the handler MAY
    // gain shared-state access via the trap frame) should swap to
    // clear-BEFORE-call to match POSIX's "a signal delivered during
    // another signal's handler is queued for the next delivery pass"
    // semantics — clear-after-call would lose a re-entrant re-post.
    // The `~bit` zero-extension argument is the same as signal_check's
    // clear-on-deliver.
    tbl.pending = tbl.pending & (~bit);
    return 1;
}

// signal_check_and_deliver: deliver ALL pending signals with installed
// handlers. Returns the count of signals actually delivered.
//
// This is the "drain the pending mask" entry point the kernel's main
// loop calls on every return-to-user (and after every interruptible
// sleep). It walks all 32 signals in ascending order (SIGHUP=1 first,
// signal 32 last — same order as signal_check's lowest-first scan),
// and for each pending signal with an installed handler, calls
// signal_deliver to invoke the handler + clear the pending bit.
//
// Implementation:
//   (1) Initialize count = 0.
//   (2) Walk i = 0..31 (bit positions; signal = i + 1).
//   (3) For each i, compute `bit = 1 as u32 << i`. If
//       `(tbl.pending & bit) != 0`, the signal is pending — call
//       signal_deliver(tbl, i + 1). signal_deliver internally
//       re-checks pending + handler and invokes the handler via
//       __call_indirect1 if both are present.
//   (4) Add signal_deliver's return (0 or 1) to count.
//   (5) After the loop, return count.
//
// The pending-bit pre-check in step (3) is an optimization: it skips
// the signal_deliver call (and its internal signal_get_handler
// 8-byte-loop fetch) for non-pending signals. signal_deliver would
// return 0 anyway, but skipping the call avoids the handler-fetch
// overhead. The pre-check is also defensive: it guarantees we never
// invoke __call_indirect1 on a non-pending signal (in case a future
// signal_deliver refactor changes the pending-check ordering).
//
// Note: signal_check_and_deliver does NOT respect the blocked mask
// (tbl.mask). Pending + handler-installed → delivered, regardless of
// mask. This differs from signal_check (which filters via `pending &
// ~mask`). The W40 task spec specifies this behavior literally ("for
// each pending signal with a handler, call signal_deliver"). K8+ may
// add a mask-respecting variant (signal_check_and_deliver_filtered)
// or fold the mask check into signal_deliver itself; K7b's W40
// contract is the literal "pending + handler → deliver" semantics.
//
// Signals that are pending but have NO handler installed are SKIPPED
// (signal_deliver returns 0, the pending bit stays set). This
// matches POSIX: a signal with default action (no handler) is not
// "delivered" to a user handler — the kernel takes the default
// action (terminate/ignore/stop) separately. K8+ will hook the
// default-action path here.
//
// State<T> params: 1 (tbl). Reads tbl.pending (loop condition),
// reads tbl.handlers (via signal_get_handler inside signal_deliver),
// writes tbl.pending (clear-bit step inside signal_deliver). Calls
// signal_get_handler + signal_deliver (both 1-State<T>-param VUMA
// fns) + __call_indirect1 (extern, inside signal_deliver).
fn signal_check_and_deliver(tbl: State<SignalTable>) -> u32 {
    let count: u32 = 0;
    let i = 0;
    while i < 32 {
        let bit = 1 as u32 << i;
        // Only consider pending signals. The pre-check skips the
        // signal_deliver call (and its internal handler fetch) for
        // non-pending signals — signal_deliver would return 0 anyway,
        // but skipping the call is cheaper and avoids a hypothetical
        // signal_deliver refactor that might invoke the handler
        // unconditionally.
        if (tbl.pending & bit) != 0 {
            let sig = i + 1;
            let d = signal_deliver(tbl, sig);
            count = count + d;
        }
        i = i + 1;
    }
    return count;
}

// ────────────────────────────────────────────────────────────────────────────
// Self-test (the K7b DoD + W40 signal_deliver DoD).
// ────────────────────────────────────────────────────────────────────────────
// Allocate a SignalTable via state_new, init it via signal_init, then:
//   (1) Install handler for SIGINT (sig=2) at address 1000.
//   (2) Check signal_get_handler(tbl, 2) == 1000 (round-trip).
//   (3) Send SIGINT (signal_send(tbl, 2)).
//   (4) Check signal_send returned 0.
//   (5) Check signal_check(tbl) == 2 (SIGINT is pending + not blocked).
//   (6) Check signal_check(tbl) == 0 again (pending bit cleared in step 5).
//   (7) Block SIGTERM (sig=15), send it, check signal_check == 0 (blocked).
//   (8) Unblock SIGTERM, check signal_check == 15 (now deliverable).
//   ── W40: signal_deliver + signal_check_and_deliver ──
//   (9)  Install a REAL handler for SIGUSR1 (sig=10) via the Wave 5
//        FnAddr feature (`signal_test_handler as u64`). Verify the
//        address reads back non-zero (catches the DCE-removed-handler
//        bug documented in syscall_init.vuma's header — Wave 39's
//        whole_program_dce fix preserves functions referenced via
//        GetAddress).
//   (10) Send SIGUSR1 + call signal_deliver(tbl, 10) → must return 1
//        (delivered). The handler is actually invoked via
//        __call_indirect1 — the fact that we reach the check (program
//        didn't crash at the indirect call) proves the handler ran.
//   (11) Verify the pending bit was cleared (signal_check returns 0).
//   (12) signal_deliver on a non-pending signal returns 0.
//   (13) signal_deliver on a pending signal with NO handler returns 0
//        (and leaves the pending bit set). Uses SIGUSR2 (sig=12, no
//        handler installed).
//   (14) Clean up SIGUSR2's pending bit via signal_check (returns 12)
//        so it doesn't interfere with the signal_check_and_deliver
//        count below.
//   (15) Install real handlers for SIGHUP (1) + SIGQUIT (3), send
//        both, call signal_check_and_deliver → must return 2.
//   (16) Verify all pending bits cleared after signal_check_and_deliver.
//   (17) Return 0 (success).
//
// Returns 0 on success, 1..14 on the corresponding check failure (so a
// future CI failure pinpoints the broken check).
//
// ── State-typedness note ────────────────────────────────────────────────────
// Every function call (signal_init, signal_install, signal_get_handler,
// signal_send, signal_check, signal_block, signal_unblock, signal_deliver,
// signal_check_and_deliver) takes tbl as a parameter — so the state-
// typedness is preserved across the calls, and the direct field reads
// work correctly after each call. The `let h = signal_get_handler(...);`
// / `let ret = signal_send(...);` / `let sig = signal_check(...);` /
// `let d = signal_deliver(...);` / `let cnt = signal_check_and_deliver(...)`
// locals are plain u64 / i64 / u8 / u32 values (function return values,
// not State<T> field reads) — no state-typedness concern. (Same pattern
// as K7e's waitq.vuma self-test header note.)
//
// ── "Handler was invoked" verification (W40 DoD) ────────────────────────────
// The W40 task spec requires the self-test to "verify signal_deliver
// actually calls the handler". PMT-pure discipline forbids pointer
// syntax (`&x` / `*ptr`), so the handler cannot receive a State<Witness>
// to mutate as a side-channel witness — __call_indirect1 only forwards
// a single u64 (the signal number) as the SysV AMD64 first argument.
// VUMA has no module-level mutable state either (the parser accepts
// `static mut`, but the codegen treats it as a per-access fresh let-
// binding — verified empirically by /home/z/probes/probe_static.vuma:
// handler increments COUNTER, main reads 0 not 1).
//
// The verification is therefore INDIRECT but sound:
//   (a) The handler installed in step 9 is a REAL VUMA function
//       (`signal_test_handler` below) whose address is taken via the
//       Wave 5 FnAddr feature (`fn_name as u64`). The address is a
//       real .text section address — NOT the fake sentinel 1000 used
//       in step 1's round-trip test (1000 would segfault if
//       __call_indirect1 actually jumped to it).
//   (b) Step 10's signal_deliver(tbl, 10) call reaches the
//       __call_indirect1(handler, sig) call site (because the pending
//       bit is set + handler != 0). If __call_indirect1 jumped to a
//       non-callable address, the program would segfault (SIGSEGV,
//       exit 139) before reaching the `if d1 != 1` check.
//   (c) The program reaches the check (exit != 139) → the handler was
//       actually invoked + returned normally.
//   (d) Step 11 verifies the pending bit was cleared, which only
//       happens AFTER the __call_indirect1 call returns (per
//       signal_deliver's clear-after-call ordering). This is a
//       second witness: the clear-bit store executed, so the call
//       must have returned.
//
// This is the same PMT-pure "verify the indirect call happened by
// not crashing" pattern that char.vuma's chardev_read self-test
// documents (char.vuma:751-755) — except char.vuma's self-test guards
// with `read_fn == 0` and never actually invokes the handler, while
// this file's self-test DOES invoke the handler via a real address.
// The probe at /home/z/probes/probe_deliver2.vuma confirms the full
// pattern (install real handler via `fn_name as u64`, set pending bit,
// call a signal_deliver-style function, verify pending cleared + return
// 1) exits 0.
//
// Per the K7b contract's "decimal constants" rule: all non-zero
// constants in the self-test use DECIMAL (2, 1000, 15, 10, 12, 1, 3)
// — decimal avoids the parser's hex-literal path (parse_int_radix
// width-extension subtleties — see womb/kernel/arch/x86_64/pt.vuma
// header for the same rationale, and K3a's trap_trampoline.vuma for
// the same rule).

// signal_test_handler: a real VUMA function whose address can be taken
// via `signal_test_handler as u64` (Wave 5 FnAddr) and invoked via
// __call_indirect1. The handler receives the signal number as its
// single SysV AMD64 argument (RDI) and returns `sig + 1000` (a magic
// value signal_deliver discards — POSIX signal handlers conventionally
// return void; the non-trivial return prevents the optimizer from
// eliding the call as a no-op).
//
// PMT-pure: no State<T> access, no extern calls, no side effects beyond
// the return value. The handler's body is pure — the "handler was
// invoked" verification is indirect (see the "Handler was invoked"
// note in the self-test header above). The body is deliberately
// non-empty (returns sig + 1000) so the optimizer has a real value
// to compute + return; an empty `return 0;` body would risk being
// constant-folded away by the O2 DCE pass (verified: the
// whole_program_dce pass preserves functions referenced via
// IRInstr::GetAddress per the Wave 39 fix documented in
// syscall_init.vuma's header, so even `return 0;` would survive — but
// the non-trivial body makes the preservation belt-and-suspenders).
fn signal_test_handler(sig: u64) -> u64 {
    return sig + 1000;
}

fn main() -> i32 {
    let tbl = state_new(SignalTable);
    signal_init(tbl);

    // (1-2) Install handler for SIGINT (2) at address 1000. Read it
    // back and verify the round-trip (byte-by-byte store/load).
    signal_install(tbl, 2, 1000);
    let h = signal_get_handler(tbl, 2);
    if h != 1000 { return 1; }

    // (3-4) Send SIGINT. Should return 0 (success).
    let ret = signal_send(tbl, 2);
    if ret != 0 { return 2; }

    // (5) Check — should return 2 (SIGINT is pending + not blocked).
    let sig = signal_check(tbl);
    if sig != 2 { return 3; }

    // (6) Check again — should return 0 (pending bit was cleared in
    // the previous signal_check call).
    let sig2 = signal_check(tbl);
    if sig2 != 0 { return 4; }

    // (7) Block SIGTERM (15), send it, check → 0 (blocked). The
    // pending bit IS set by signal_send, but signal_check filters it
    // out via `pending & ~mask` because mask now has bit 14 set.
    signal_block(tbl, 15);
    signal_send(tbl, 15);
    let sig3 = signal_check(tbl);
    if sig3 != 0 { return 5; }

    // (8) Unblock SIGTERM (clear mask bit 14), check → 15. The pending
    // bit is STILL set from step 7's signal_send; now that the mask is
    // clear, signal_check's `pending & ~mask` includes bit 14, so the
    // scan returns signal 15.
    signal_unblock(tbl, 15);
    let sig4 = signal_check(tbl);
    if sig4 != 15 { return 6; }

    // ── W40: signal_deliver + signal_check_and_deliver tests ──────────

    // (9) Install a REAL handler for SIGUSR1 (10) via the Wave 5
    // FnAddr feature (`signal_test_handler as u64`). The handler's
    // address is a real .text address — NOT the fake 1000 used for
    // the round-trip test above (1000 would crash if signal_deliver
    // actually invoked it via __call_indirect1). Verify the address
    // reads back non-zero (catches the DCE-removed-handler bug
    // documented in syscall_init.vuma's header — the Wave 39
    // whole_program_dce fix preserves functions referenced via
    // IRInstr::GetAddress).
    signal_install(tbl, 10, signal_test_handler as u64);
    let h10 = signal_get_handler(tbl, 10);
    if h10 == 0 { return 7; }

    // (10) Send SIGUSR1 + call signal_deliver(tbl, 10). The handler
    // is actually invoked via __call_indirect1(handler, 10) — the
    // fact that we reach the `if d1 != 1` check (program didn't
    // segfault at the indirect call) proves the handler ran and
    // returned. signal_deliver returns 1 (delivered). See the
    // "Handler was invoked" note in the self-test header for the
    // full verification argument.
    signal_send(tbl, 10);
    let d1 = signal_deliver(tbl, 10);
    if d1 != 1 { return 8; }

    // (11) Verify the pending bit was cleared by signal_deliver
    // (the clear happens AFTER the __call_indirect1 call returns,
    // so this also witnesses that the call returned). signal_check
    // should return 0 (nothing pending).
    let sig5 = signal_check(tbl);
    if sig5 != 0 { return 9; }

    // (12) signal_deliver on a non-pending signal returns 0 (the
    // pending-bit check fails first; __call_indirect1 is NOT called,
    // so even a fake handler address would be safe here — but we
    // use the real SIGUSR1 handler anyway).
    let d2 = signal_deliver(tbl, 10);
    if d2 != 0 { return 10; }

    // (13) signal_deliver on a pending signal with NO handler
    // installed returns 0 (and does NOT clear the pending bit —
    // a later install + deliver can still fire). Uses SIGUSR2 (12,
    // no handler installed). The pending bit stays set; we clean
    // it up in step 14.
    signal_send(tbl, 12);
    let d3 = signal_deliver(tbl, 12);
    if d3 != 0 { return 11; }

    // (14) Clean up SIGUSR2's pending bit via signal_check (returns
    // 12, clears the bit) so it doesn't interfere with the
    // signal_check_and_deliver count in step 15. If we left
    // SIGUSR2 pending, signal_check_and_deliver would call
    // signal_deliver(tbl, 12) which returns 0 (no handler) — the
    // count would still be 2 (only SIGHUP + SIGQUIT have handlers),
    // but the leftover pending bit would fail step 16's "all clear"
    // check.
    let sig6 = signal_check(tbl);
    if sig6 != 12 { return 12; }

    // (15) signal_check_and_deliver: install real handlers for
    // SIGHUP (1) and SIGQUIT (3), send both, call
    // signal_check_and_deliver, verify count == 2. SIGINT (2) has
    // a fake handler (1000) but is NOT pending (cleared in step 5),
    // so signal_check_and_deliver skips it (signal_deliver returns 0
    // for non-pending signals without invoking the handler — the
    // pending-bit pre-check in signal_check_and_deliver's loop also
    // short-circuits before the signal_deliver call). SIGUSR1 (10)
    // has a real handler but is NOT pending (cleared in step 10).
    signal_install(tbl, 1, signal_test_handler as u64);
    signal_install(tbl, 3, signal_test_handler as u64);
    signal_send(tbl, 1);
    signal_send(tbl, 3);
    let cnt = signal_check_and_deliver(tbl);
    if cnt != 2 { return 13; }

    // (16) Verify all pending bits cleared after signal_check_and_deliver.
    // signal_check should return 0 (nothing pending — SIGHUP + SIGQUIT
    // were delivered + cleared; no other signals are pending).
    let sig7 = signal_check(tbl);
    if sig7 != 0 { return 14; }

    return 0;
}
