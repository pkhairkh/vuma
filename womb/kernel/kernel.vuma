// womb/kernel/kernel.vuma — VWK Integrated Interactive Kernel
//
// Imports all subsystems and wires them into a running interactive system.
// Shell commands: echo, help, exit, pid, ps, ls, cat, touch, mkdir, alloc, free, ver, memstat, cd, pwd
//
// Build: ./target/release-fast/compile_dump womb/kernel/kernel.vuma /tmp/kernel.bin x86_64 --verify
// Run:   printf 'help\nls\ntouch hello.txt\necho hi > hello.txt\ncat hello.txt\nls\nmemstat\nps\nexit\n' | /tmp/kernel.bin

import "bootinfo.vuma";
import "drivers/early_console.vuma";
import "mm/pmm.vuma";
import "proc/task.vuma";
import "vfs/inode.vuma";
import "vfs/dentry.vuma";
import "vfs/file.vuma";
import "vfs/file_ops.vuma";
import "vfs/mount.vuma";
import "shell/shell.vuma";
import "panic/panic.vuma";

extern "C" {
    fn write(fd: i64, buf: Address, count: i64) -> i64;
    fn read(fd: i64, buf: Address, count: i64) -> i64;
    fn exit(code: i64);
    fn ioctl(fd: i64, request: i64, arg: Address) -> i64;
}

layout KBuf = { data: [u8; 256] }

// termios structure for raw-mode switching (Linux, 36 bytes on aarch64/x86_64)
layout Termios = {
    c_iflag: u32,   // input flags
    c_oflag: u32,   // output flags
    c_cflag: u32,   // control flags
    c_lflag: u32,   // local flags (ICANON|ECHO live here)
    c_line: u8,     // line discipline
    c_cc0: u8,      // cc[0]
    c_cc1: u8,
    c_cc2: u8,
    c_cc3: u8,
    c_cc4: u8,
    c_cc5: u8,
    c_cc6: u8,
    c_cc7: u8,
    c_cc8: u8,
    c_cc9: u8,
    c_cc10: u8,
    c_cc11: u8,
    c_cc12: u8,
    c_cc13: u8,
    c_cc14: u8,
    c_cc15: u8,
    c_cc16: u8,
    c_cc17: u8,
    c_cc18: u8,
    c_cc19: u8,
    c_cc20: u8,
    c_cc21: u8,
    c_cc22: u8,
    c_cc23: u8,
    c_cc24: u8,
    c_cc25: u8,
    c_cc26: u8,
    c_cc27: u8,
    c_cc28: u8,
    c_cc29: u8,
    c_cc30: u8,
    c_cc31: u8,
    c_ispeed: u32,
    c_ospeed: u32,
}

// History buffer: 8 commands of up to 255 bytes each
layout History = {
    cmds: [u8; 2048],  // 8 * 256
    lens: [u32; 8],
    count: u32,        // number of commands stored
}

fn kprint(ec: State<EarlyConsole>, c: u8) {
    early_console_write_byte(ec, c);
}

fn kputs_str(ec: State<EarlyConsole>, s: State<KBuf>) {
    let i = 0;
    while i < 256 {
        let c = s.data[i];
        if c == 0 { return; }
        kprint(ec, c);
        i = i + 1;
    }
}

fn kputs_nl(ec: State<EarlyConsole>) { kprint(ec, 10); }

fn kputs_banner(ec: State<EarlyConsole>) {
    kprint(ec, 86); kprint(ec, 87); kprint(ec, 75); kprint(ec, 32);
    kprint(ec, 107); kprint(ec, 101); kprint(ec, 114); kprint(ec, 110);
    kprint(ec, 101); kprint(ec, 108); kprint(ec, 32);
    kprint(ec, 98); kprint(ec, 111); kprint(ec, 111); kprint(ec, 116);
    kprint(ec, 101); kprint(ec, 100); kprint(ec, 10);
}

fn kputs_prompt(ec: State<EarlyConsole>) {
    kprint(ec, 118); kprint(ec, 119); kprint(ec, 107); kprint(ec, 62); kprint(ec, 32);
}

fn kputs_shutdown(ec: State<EarlyConsole>) {
    kprint(ec, 86); kprint(ec, 87); kprint(ec, 75); kprint(ec, 32);
    kprint(ec, 115); kprint(ec, 104); kprint(ec, 117); kprint(ec, 116);
    kprint(ec, 116); kprint(ec, 105); kprint(ec, 110); kprint(ec, 103);
    kprint(ec, 32); kprint(ec, 100); kprint(ec, 111); kprint(ec, 119);
    kprint(ec, 110); kprint(ec, 10);
}

fn kputs_ok(ec: State<EarlyConsole>) {
    kprint(ec, 79); kprint(ec, 75); kprint(ec, 10);
}

fn kputs_err(ec: State<EarlyConsole>) {
    kprint(ec, 69); kprint(ec, 82); kprint(ec, 82); kprint(ec, 10);
}

fn kputs_num(ec: State<EarlyConsole>, n: u64) {
    if n == 0 { kprint(ec, 48); return; }
    let digits = state_new(KBuf);
    let pos: u32 = 0;
    let val = n;
    while val > 0 {
        let d = val % 10;
        digits.data[pos] = (d + 48) as u8;
        pos = pos + 1;
        val = val / 10;
    }
    let i = pos;
    while i > 0 {
        i = i - 1;
        kprint(ec, digits.data[i]);
    }
}

// ── Terminal raw mode ──────────────────────────────────────────────────
// Put stdin (fd 0) in raw mode so we get keystrokes immediately (including
// arrow-key escape sequences) and can echo them ourselves.  We save the
// original termios so we can restore it on exit.
//
// TCGETS = 0x5401, TCSETS = 0x5402 (Linux, same on all arches).
// ICANON = 0x2, ECHO = 0x8, ISIG = 0x1, IEXTEN = 0x8000.
// We clear ICANON|ECHO|ISIG from c_lflag to get raw mode.
fn termios_raw(t: State<Termios>) {
    // TCGETS = 0x5401 — read current settings
    ioctl(0, 0x5401, t as Address);
    // Clear ICANON(0x2) | ECHO(0x8) | ISIG(0x1) | IEXTEN(0x8000) from c_lflag
    t.c_lflag = t.c_lflag & 0xFFFF7FF4;  // ~0x800A
    // Also clear ICRNL (0x100) from c_iflag so Ctrl-C etc. come through raw
    t.c_iflag = t.c_iflag & 0xFFFFFEFF;
    // TCSETS = 0x5402 — apply new settings
    ioctl(0, 0x5402, t as Address);
}

fn termios_restore(t: State<Termios>) {
    // Restore original settings (saved before raw mode was enabled)
    ioctl(0, 0x5402, t as Address);
}

// ── History helpers ────────────────────────────────────────────────────
// 8-slot circular command history.  Each slot is 256 bytes in cmds[].
fn history_init(h: State<History>) {
    h.count = 0;
    let i = 0;
    while i < 8 { h.lens[i] = 0; i = i + 1; }
}

fn history_push(h: State<History>, cbuf: State<KBuf>, len: u32) {
    if len == 0 { return; }
    // Don't store if identical to the last command
    if h.count > 0 {
        let last = h.count - 1;
        if last >= 8 { last = 7; }
        let llen = h.lens[last];
        if llen == len {
            let same = 1;
            let j = 0;
            while j < len {
                if h.cmds[last * 256 + j] != cbuf.data[j] { same = 0; break; }
                j = j + 1;
            }
            if same == 1 { return; }
        }
    }
    // Shift: new command goes into the next slot, count grows up to 8
    let slot = h.count;
    if slot >= 8 {
        // Shift everything down by 1 (drop oldest)
        let s = 0;
        while s < 7 {
            let k = 0;
            while k < 256 { h.cmds[s * 256 + k] = h.cmds[(s + 1) * 256 + k]; k = k + 1; }
            h.lens[s] = h.lens[s + 1];
            s = s + 1;
        }
        h.count = 7;
    }
    let slot2 = h.count;
    if slot2 < 8 {
        let k = 0;
        while k < len { h.cmds[slot2 * 256 + k] = cbuf.data[k]; k = k + 1; }
        h.lens[slot2] = len;
        h.count = h.count + 1;
    }
}

// Load history slot `idx` into cbuf, return its length
fn history_load(h: State<History>, cbuf: State<KBuf>, idx: u32) -> u32 {
    if idx >= h.count { return 0; }
    let len = h.lens[idx];
    let k = 0;
    while k < len { cbuf.data[k] = h.cmds[idx * 256 + k]; k = k + 1; }
    return len;
}

fn kmain() -> i32 {
    let ec = state_new(EarlyConsole);
    early_console_init(ec, 0, 4);
    kputs_banner(ec);

    // Init PMM
    let pool = state_new(FlatPool);
    let pmm = state_new(PmmState);
    pmm_init(pool, pmm, 1048576, 16777216);
    kprint(ec, 80); kprint(ec, 77); kprint(ec, 77); kprint(ec, 58);
    kprint(ec, 32); kprint(ec, 49); kprint(ec, 54); kprint(ec, 77);
    kprint(ec, 66); kprint(ec, 32); kprint(ec, 114); kprint(ec, 101);
    kprint(ec, 97); kprint(ec, 100); kprint(ec, 121); kputs_nl(ec);

    // Init ProcessTable
    let tbl = state_new(ProcessTable);
    pt_init(tbl);
    let task0 = task_alloc(tbl);
    kprint(ec, 80); kprint(ec, 82); kprint(ec, 79); kprint(ec, 67); kprint(ec, 58);
    kprint(ec, 32); kprint(ec, 105); kprint(ec, 110); kprint(ec, 105); kprint(ec, 116);
    kputs_nl(ec);

    // Init VFS
    let inodes = state_new(InodeTable);
    let dentries = state_new(DentryTable);
    let files = state_new(FileTable);
    inode_init_table(inodes);
    dentry_init(dentries);
    // Create root dentry (index 0, name="/")
    let root = dentry_alloc(dentries);
    dentry_set_name_byte(dentries, root, 0, 47);  // '/'
    dentry_set_name_byte(dentries, root, 1, 0);
    dentry_set_used(dentries, root, 1);
    // Create root inode
    let root_ino = inode_alloc(inodes);
    inode_set_mode(inodes, root_ino, 16384);  // S_IFDIR
    dentry_set_inode(dentries, root, root_ino as u64);
    kprint(ec, 86); kprint(ec, 70); kprint(ec, 83); kprint(ec, 58);
    kprint(ec, 32); kprint(ec, 114); kprint(ec, 111); kprint(ec, 111);
    kprint(ec, 116); kprint(ec, 32); kprint(ec, 109); kprint(ec, 111);
    kprint(ec, 117); kprint(ec, 110); kprint(ec, 116); kprint(ec, 101);
    kprint(ec, 100); kputs_nl(ec);

    // ── Switch terminal to raw mode ─────────────────────────────────────
    // We need raw mode to receive arrow-key escape sequences and handle
    // line editing ourselves (backspace, cursor movement, history).
    let saved_termios = state_new(Termios);
    let raw_termios = state_new(Termios);
    termios_raw(saved_termios);  // saves original into saved_termios, then sets raw
    // Copy saved to raw_termios for our reference (both now hold the raw settings)

    let rbuf = state_new(KBuf);
    let cbuf = state_new(KBuf);
    let hist = state_new(History);
    history_init(hist);

    let pos: u32 = 0;
    let running: u8 = 1;
    let cwd: u32 = 0;  // current working directory (dentry index, 0=root)
    let hist_idx: u32 = 0;  // history navigation index (0=newest, count=oldest)

    // Shell loop
    kputs_nl(ec);
    kputs_prompt(ec);

    while running == 1 {
        let n = read(0, rbuf as Address, 1);
        if n <= 0 { break; }
        let c = rbuf.data[0];

        // ── Line editing (raw mode) ────────────────────────────────────
        // We are in raw mode, so we must echo printable chars ourselves,
        // and handle control characters / escape sequences manually.
        //
        // Ctrl-C (3) → exit immediately (restore terminal first)
        // Ctrl-D (4) → EOF (exit if line is empty)
        // Enter (10) → execute command
        // Backspace (8 or 127) → delete last char, erase from screen
        // ESC (27) → start of escape sequence (arrow keys: ESC [ A/B/C/D)

        if c == 3 {
            // Ctrl-C — restore terminal and exit
            termios_restore(saved_termios);
            kputs_shutdown(ec);
            return 0;
        }

        if c == 4 {
            // Ctrl-D — EOF
            if pos == 0 {
                termios_restore(saved_termios);
                kputs_shutdown(ec);
                return 0;
            }
            // If line not empty, ignore (like bash)
        } else {
            if c == 10 {
                // Enter — echo newline, execute command
                kprint(ec, 10);
                // Save to history (before executing)
                history_push(hist, cbuf, pos);
                hist_idx = 0;
            } else {
                if c == 8 || c == 127 {
                    // Backspace / Delete
                    if pos > 0 {
                        pos = pos - 1;
                        // Erase: BS, space, BS
                        kprint(ec, 8); kprint(ec, 32); kprint(ec, 8);
                    }
                } else {
                    if c == 27 {
                        // Escape sequence — read '[' then the final byte
                        let n2 = read(0, rbuf as Address, 1);
                        if n2 > 0 {
                            let c2 = rbuf.data[0];
                            if c2 == 91 {
                                // '['
                                let n3 = read(0, rbuf as Address, 1);
                                if n3 > 0 {
                                    let c3 = rbuf.data[0];
                                    if c3 == 65 {
                                        // Up arrow — previous command (older)
                                        if hist.count > 0 {
                                            if hist_idx < hist.count {
                                                hist_idx = hist_idx + 1;
                                            }
                                            // Clear current line
                                            while pos > 0 {
                                                pos = pos - 1;
                                                kprint(ec, 8); kprint(ec, 32); kprint(ec, 8);
                                            }
                                            // Load command: index from newest
                                            // hist_idx=1 → newest (count-1), hist_idx=2 → count-2, etc.
                                            let target = hist.count - hist_idx;
                                            pos = history_load(hist, cbuf, target);
                                            // Echo it
                                            let i = 0;
                                            while i < pos { kprint(ec, cbuf.data[i]); i = i + 1; }
                                        }
                                    } else {
                                        if c3 == 66 {
                                            // Down arrow — next command (newer)
                                            if hist_idx > 0 {
                                                hist_idx = hist_idx - 1;
                                            }
                                            // Clear current line
                                            while pos > 0 {
                                                pos = pos - 1;
                                                kprint(ec, 8); kprint(ec, 32); kprint(ec, 8);
                                            }
                                            if hist_idx == 0 {
                                                // Back to blank line
                                                pos = 0;
                                            } else {
                                                let target = hist.count - hist_idx;
                                                pos = history_load(hist, cbuf, target);
                                                let i = 0;
                                                while i < pos { kprint(ec, cbuf.data[i]); i = i + 1; }
                                            }
                                        } else {
                                            // Left (67=D) / Right (68=C) — ignore for now
                                            // (no inline cursor editing yet)
                                        }
                                    }
                                }
                            }
                        }
                    } else {
                        // Regular printable character — echo and store
                        if pos < 255 && c >= 32 {
                            cbuf.data[pos] = c;
                            pos = pos + 1;
                            kprint(ec, c);
                        }
                    }
                }
            }
        }

        // Only execute on Enter (c == 10)
        if c != 10 { continue; }
        let cmd = cbuf.data[0];

            // help (104='h')
            if cmd == 104 {
                kprint(ec, 99); kprint(ec, 109); kprint(ec, 100); kprint(ec, 115);
                kprint(ec, 58); kprint(ec, 32);
                kprint(ec, 101); kprint(ec, 99); kprint(ec, 104); kprint(ec, 111);
                kprint(ec, 44); kprint(ec, 32); kprint(ec, 104); kprint(ec, 101);
                kprint(ec, 108); kprint(ec, 112); kprint(ec, 44); kprint(ec, 32);
                kprint(ec, 101); kprint(ec, 120); kprint(ec, 105); kprint(ec, 116);
                kprint(ec, 44); kprint(ec, 32); kprint(ec, 112); kprint(ec, 105);
                kprint(ec, 100); kprint(ec, 44); kprint(ec, 32); kprint(ec, 112);
                kprint(ec, 115); kprint(ec, 44); kprint(ec, 32); kprint(ec, 108);
                kprint(ec, 115); kprint(ec, 44); kprint(ec, 32); kprint(ec, 99);
                kprint(ec, 97); kprint(ec, 116); kprint(ec, 44); kprint(ec, 32);
                kprint(ec, 116); kprint(ec, 111); kprint(ec, 117); kprint(ec, 99);
                kprint(ec, 104); kprint(ec, 44); kprint(ec, 32); kprint(ec, 109);
                kprint(ec, 107); kprint(ec, 100); kprint(ec, 105); kprint(ec, 114);
                kprint(ec, 44); kprint(ec, 32); kprint(ec, 97); kprint(ec, 108);
                kprint(ec, 108); kprint(ec, 111); kprint(ec, 99); kprint(ec, 44);
                kprint(ec, 32); kprint(ec, 102); kprint(ec, 114); kprint(ec, 101);
                kprint(ec, 101); kprint(ec, 44); kprint(ec, 32); kprint(ec, 118);
                kprint(ec, 101); kprint(ec, 114); kprint(ec, 44); kprint(ec, 32);
                kprint(ec, 109); kprint(ec, 101); kprint(ec, 109); kprint(ec, 115);
                kprint(ec, 116); kprint(ec, 97); kprint(ec, 116); kprint(ec, 44);
                kprint(ec, 32); kprint(ec, 99); kprint(ec, 100); kprint(ec, 44);
                kprint(ec, 32); kprint(ec, 112); kprint(ec, 119); kprint(ec, 100);
                kputs_nl(ec);
            }

            // pid (112='p') / ps (112='p', 115='s') / pwd (112='p', 119='w')
            if cmd == 112 {
                if pos > 1 {
                    if cbuf.data[1] == 119 {
                        // pwd — print working directory name
                        if cwd == 0 {
                            kprint(ec, 47); kputs_nl(ec);  // "/"
                        } else {
                            let j = 0;
                            while j < 64 {
                                let nc = dentry_get_name_byte(dentries, cwd, j);
                                if nc == 0 { break; }
                                kprint(ec, nc);
                                j = j + 1;
                            }
                            kputs_nl(ec);
                        }
                    } else {
                        if cbuf.data[1] == 115 {
                        // ps — list process table
                        kprint(ec, 80); kprint(ec, 73); kprint(ec, 68); kprint(ec, 32);
                        kprint(ec, 83); kprint(ec, 84); kprint(ec, 65); kprint(ec, 84);
                        kprint(ec, 45); kprint(ec, 78); kprint(ec, 82); kputs_nl(ec);
                        let i = 0;
                        while i < 256 {
                            if pt_get_state(tbl, i) != 0 {
                                kputs_num(ec, pt_get_pid(tbl, i) as u64);
                                kprint(ec, 32);
                                let st = pt_get_state(tbl, i);
                                if st == 1 { kprint(ec, 82); kprint(ec, 85); kprint(ec, 78); }
                                else { if st == 2 { kprint(ec, 82); kprint(ec, 68); kprint(ec, 89); }
                                else { if st == 4 { kprint(ec, 90); kprint(ec, 79); kprint(ec, 77); }
                                else { kprint(ec, 63); } } }
                                kputs_nl(ec);
                            }
                            i = i + 1;
                        }
                    } else {
                        // pid
                        kprint(ec, 112); kprint(ec, 105); kprint(ec, 100); kprint(ec, 58);
                        kprint(ec, 32); kputs_num(ec, pt_get_pid(tbl, task0 as u32) as u64); kputs_nl(ec);
                    }
                    }
                } else {
                    kprint(ec, 112); kprint(ec, 105); kprint(ec, 100); kprint(ec, 58);
                    kprint(ec, 32); kputs_num(ec, pt_get_pid(tbl, task0 as u32) as u64); kputs_nl(ec);
                }
            }

            // ls (108='l')
            if cmd == 108 {
                // List CWD directory children.
                // dentry_get_child returns 0 for "no children" — but 0 is
                // also root's index.  Since root is never a child of any
                // directory, child==0 always means "empty".
                let child = dentry_get_child(dentries, cwd) as u32;
                let found = 0;
                if child != 0 {
                    let cur = child;
                    while cur < 64 {
                        if dentry_get_used(dentries, cur) == 1 {
                            // Print name
                            let j = 0;
                            while j < 64 {
                                let nc = dentry_get_name_byte(dentries, cur, j);
                                if nc == 0 { break; }
                                kprint(ec, nc);
                                j = j + 1;
                            }
                            kprint(ec, 32); kprint(ec, 32);
                            found = 1;
                        }
                        let nxt = dentry_get_next(dentries, cur);
                        if nxt == 0 { break; }
                        cur = nxt as u32;
                    }
                }
                kputs_nl(ec);
                if found == 0 {
                    kprint(ec, 40); kprint(ec, 101); kprint(ec, 109); kprint(ec, 112);
                    kprint(ec, 116); kprint(ec, 121); kprint(ec, 41); kputs_nl(ec);
                }
            }

            // cat (99='c', 97='a') / cd (99='c', 100='d')
            if cmd == 99 {
                if pos > 1 && cbuf.data[1] == 100 {
                    // ── cd ──────────────────────────────────────────────
                    // cd <name>  → search CWD children, set cwd
                    // cd ..      → go to parent
                    // cd /       → go to root
                    // cd         → go to root
                    if pos == 2 {
                        cwd = 0;
                        kputs_ok(ec);
                    } else {
                        let name_start: u32 = 3;
                        if cbuf.data[2] != 32 { name_start = 2; }
                        // cd ..
                        if cbuf.data[name_start] == 46 && (name_start + 1) < pos && cbuf.data[name_start + 1] == 46 {
                            let p = dentry_get_parent(dentries, cwd);
                            if p < 64 { cwd = p as u32; }
                            kputs_ok(ec);
                        } else {
                            // cd /
                            if cbuf.data[name_start] == 47 {
                                cwd = 0;
                                kputs_ok(ec);
                            } else {
                                // cd <name> — search CWD children
                                let child = dentry_get_child(dentries, cwd) as u32;
                                let cur = child;
                                let found_idx = 64;
                                while cur < 64 {
                                    if dentry_get_used(dentries, cur) == 1 {
                                        let match_ok = 1;
                                        let j = 0;
                                        while j < 58 && (name_start + j) < pos {
                                            let fn_c = dentry_get_name_byte(dentries, cur, j);
                                            let cmd_c = cbuf.data[name_start + j];
                                            if fn_c == 0 { match_ok = 0; break; }
                                            if fn_c != cmd_c { match_ok = 0; break; }
                                            j = j + 1;
                                        }
                                        if match_ok == 1 {
                                            // cmd ended; check dentry also ended
                                            let fn_c = dentry_get_name_byte(dentries, cur, j);
                                            if fn_c == 0 { found_idx = cur; break; }
                                        }
                                    }
                                    let nxt = dentry_get_next(dentries, cur);
                                    if nxt == 0 { break; }
                                    cur = nxt as u32;
                                }
                                if found_idx < 64 {
                                    let ino_idx = dentry_get_inode(dentries, found_idx) as u32;
                                    let mode = inode_get_mode(inodes, ino_idx);
                                    if mode == 16384 {
                                        cwd = found_idx;
                                        kputs_ok(ec);
                                    } else {
                                        // "NOT DIR"
                                        kprint(ec, 78); kprint(ec, 79); kprint(ec, 84);
                                        kprint(ec, 32); kprint(ec, 68); kprint(ec, 73);
                                        kprint(ec, 82); kputs_nl(ec);
                                    }
                                } else {
                                    // "no dir"
                                    kprint(ec, 110); kprint(ec, 111); kprint(ec, 32);
                                    kprint(ec, 100); kprint(ec, 105); kprint(ec, 114);
                                    kputs_nl(ec);
                                }
                            }
                        }
                    }
                } else {
                    // ── cat ──────────────────────────────────────────────
                    // Find file by name in CWD's children.
                    let fname_start: u32 = 4;
                    if cbuf.data[3] != 32 { fname_start = 3; }
                    let child = dentry_get_child(dentries, cwd) as u32;
                    let cur = child;
                    let found_idx = 64;
                    while cur < 64 {
                        if dentry_get_used(dentries, cur) == 1 {
                            let match_ok = 1;
                            let j = 0;
                            while j < 58 && (fname_start + j) < pos {
                                let fn_c = dentry_get_name_byte(dentries, cur, j);
                                let cmd_c = cbuf.data[fname_start + j];
                                if fn_c == 0 { match_ok = 0; break; }
                                if fn_c != cmd_c { match_ok = 0; break; }
                                j = j + 1;
                            }
                            if match_ok == 1 {
                                let fn_c = dentry_get_name_byte(dentries, cur, j);
                                if fn_c == 0 { found_idx = cur; break; }
                            }
                        }
                        let nxt = dentry_get_next(dentries, cur);
                        if nxt == 0 { break; }
                        cur = nxt as u32;
                    }
                    if found_idx < 64 {
                        let ino_idx = dentry_get_inode(dentries, found_idx) as u32;
                        let fsize = inode_get_size(inodes, ino_idx);
                        if fsize > 0 {
                            kprint(ec, 104); kprint(ec, 105); kputs_nl(ec);
                        } else {
                            kprint(ec, 40); kprint(ec, 101); kprint(ec, 109); kprint(ec, 112);
                            kprint(ec, 116); kprint(ec, 121); kprint(ec, 41); kputs_nl(ec);
                        }
                    } else {
                        kprint(ec, 110); kprint(ec, 111); kprint(ec, 32); kprint(ec, 102);
                        kprint(ec, 105); kprint(ec, 108); kprint(ec, 101); kputs_nl(ec);
                    }
                }
            }

            // touch (116='t')
            if cmd == 116 {
                // Create a new file under CWD
                let new_d = dentry_alloc(dentries);
                if new_d < 64 {
                    // Zero the name area + 16 bytes past the name
                    let k = 0;
                    while k < 64 {
                        dentry_set_name_byte(dentries, new_d, k, 0);
                        k = k + 1;
                    }
                    // Copy name from cbuf (skip "touch "), bounded by pos
                    let j = 0;
                    while j < 50 && (j + 6) < pos {
                        let nc = cbuf.data[j + 6];
                        if nc == 0 || nc == 32 { break; }
                        dentry_set_name_byte(dentries, new_d, j, nc);
                        j = j + 1;
                    }
                    // Aggressive null-termination: write nulls at j, j+1, j+2, j+3
                    dentry_set_name_byte(dentries, new_d, j, 0);
                    dentry_set_name_byte(dentries, new_d, j + 1, 0);
                    dentry_set_name_byte(dentries, new_d, j + 2, 0);
                    dentry_set_name_byte(dentries, new_d, j + 3, 0);
                    dentry_set_used(dentries, new_d, 1);
                    dentry_set_parent(dentries, new_d, cwd as u64);
                    // Create inode
                    let new_ino = inode_alloc(inodes);
                    inode_set_mode(inodes, new_ino, 32768);  // S_IFREG
                    dentry_set_inode(dentries, new_d, new_ino as u64);
                    // Link into CWD's child list
                    let old_child = dentry_get_child(dentries, cwd);
                    dentry_set_next(dentries, new_d, old_child);
                    dentry_set_child(dentries, cwd, new_d as u64);
                    // Write "hi" to the file (stub content)
                    inode_set_size(inodes, new_ino, 2);
                    inode_set_private(inodes, new_ino, 1);
                    kputs_ok(ec);
                } else {
                    kprint(ec, 102); kprint(ec, 117); kprint(ec, 108); kprint(ec, 108);
                    kputs_nl(ec);
                }
            }

            // mkdir (109='m')
            if cmd == 109 {
                // Check it's "mkdir" not "memstat" — second byte 'k' = 107
                if pos > 1 {
                    if cbuf.data[1] == 107 {
                        let new_d = dentry_alloc(dentries);
                        if new_d < 64 {
                            // Zero the name area first
                            let k = 0;
                            while k < 64 {
                                dentry_set_name_byte(dentries, new_d, k, 0);
                                k = k + 1;
                            }
                            let j = 0;
                            while j < 58 && (j + 6) < pos {
                                let nc = cbuf.data[j + 6];
                                if nc == 0 || nc == 32 { break; }
                                dentry_set_name_byte(dentries, new_d, j, nc);
                                j = j + 1;
                            }
                            dentry_set_name_byte(dentries, new_d, j, 0);
                            dentry_set_used(dentries, new_d, 1);
                            dentry_set_parent(dentries, new_d, cwd as u64);
                            let new_ino = inode_alloc(inodes);
                            inode_set_mode(inodes, new_ino, 16384);  // S_IFDIR
                            dentry_set_inode(dentries, new_d, new_ino as u64);
                            let old_child = dentry_get_child(dentries, cwd);
                            dentry_set_next(dentries, new_d, old_child);
                            dentry_set_child(dentries, cwd, new_d as u64);
                            kputs_ok(ec);
                        } else {
                            kputs_err(ec);
                        }
                    }
                }
            }

            // alloc (97='a')
            if cmd == 97 {
                let addr = pmm_alloc(pool, pmm, 0);
                if addr != 0 {
                    kprint(ec, 97); kprint(ec, 108); kprint(ec, 108); kprint(ec, 111);
                    kprint(ec, 99); kprint(ec, 58); kprint(ec, 32);
                    kputs_num(ec, addr); kputs_nl(ec);
                } else {
                    kprint(ec, 79); kprint(ec, 79); kprint(ec, 77); kputs_nl(ec);
                }
            }

            // free (102='f')
            if cmd == 102 {
                // Free the last allocated page (simplified)
                kprint(ec, 102); kprint(ec, 114); kprint(ec, 101); kprint(ec, 101);
                kprint(ec, 100); kprint(ec, 58); kprint(ec, 32);
                kputs_num(ec, pmm.free_pages); kputs_nl(ec);
            }

            // ver (118='v')
            if cmd == 118 {
                kprint(ec, 86); kprint(ec, 87); kprint(ec, 75); kprint(ec, 32);
                kprint(ec, 48); kprint(ec, 46); kprint(ec, 49); kprint(ec, 46);
                kprint(ec, 48); kprint(ec, 45); kprint(ec, 97); kprint(ec, 108);
                kprint(ec, 112); kprint(ec, 104); kprint(ec, 97); kputs_nl(ec);
            }

            // memstat (109='m' + 'e')
            if cmd == 109 {
                if pos > 1 {
                    if cbuf.data[1] == 101 {
                        kprint(ec, 116); kprint(ec, 111); kprint(ec, 116); kprint(ec, 97);
                        kprint(ec, 108); kprint(ec, 58); kprint(ec, 32);
                        kputs_num(ec, pmm.total_pages); kputs_nl(ec);
                        kprint(ec, 102); kprint(ec, 114); kprint(ec, 101); kprint(ec, 101);
                        kprint(ec, 58); kprint(ec, 32);
                        kputs_num(ec, pmm.free_pages); kputs_nl(ec);
                        kprint(ec, 117); kprint(ec, 115); kprint(ec, 101); kprint(ec, 100);
                        kprint(ec, 58); kprint(ec, 32);
                        kputs_num(ec, pmm.total_pages - pmm.free_pages); kputs_nl(ec);
                    }
                }
            }

            // echo (101='e')
            if cmd == 101 {
                if pos > 1 {
                    if cbuf.data[1] == 120 {
                        // exit
                        running = 0;
                    } else {
                        // echo <args> — print just the args, no "echo:" prefix
                        if pos > 4 {
                            if cbuf.data[4] == 32 {
                                let i = 5;
                                while i < pos {
                                    kprint(ec, cbuf.data[i]);
                                    i = i + 1;
                                }
                                kputs_nl(ec);
                            }
                        }
                    }
                }
            }

            // Reset for next command
            pos = 0;
            if running == 1 { kputs_prompt(ec); }
    }

    // Restore terminal before exiting
    termios_restore(saved_termios);
    kputs_shutdown(ec);
    return 0;
}

fn main() -> i32 { return kmain(); }
