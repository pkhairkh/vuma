// womb/kernel/kernel.vuma — VWK Integrated Kernel Entry Point
//
// The REAL kernel — imports all subsystems and wires them into a running
// interactive system. Uses VUMA's import system to share layouts/functions
// across modules (no re-declaration hack).
//
// Build & run (hosted x86_64):
//     . "$HOME/.cargo/env"
//     ./target/release-fast/compile_dump womb/kernel/kernel.vuma /tmp/kernel.bin x86_64 --verify
//     echo "test" | /tmp/kernel.bin

// ── Import all kernel subsystems ──────────────────────────────────────────
import "bootinfo.vuma";
import "drivers/early_console.vuma";
import "mm/pmm.vuma";
import "proc/task.vuma";
import "vfs/inode.vuma";
import "shell/shell.vuma";
import "panic/panic.vuma";

// ── Externs for hosted-mode I/O ────────────────────────────────────────────
extern "C" {
    fn write(fd: i64, buf: Address, count: i64) -> i64;
    fn read(fd: i64, buf: Address, count: i64) -> i64;
    fn exit(code: i64);
}

// ── I/O buffer ─────────────────────────────────────────────────────────────
layout KBuf = { data: [u8; 256] }

// ── kprint: print a single byte via early console ─────────────────────────
fn kprint(ec: State<EarlyConsole>, c: u8) {
    early_console_write_byte(ec, c);
}

// ── kputs: print a decimal-ASCII byte sequence ────────────────────────────
// Since VUMA has no string literals, we pass bytes as function arguments.
fn kputs_banner(ec: State<EarlyConsole>) {
    // "VWK kernel booted\n"
    kprint(ec, 86); kprint(ec, 87); kprint(ec, 75); kprint(ec, 32);
    kprint(ec, 107); kprint(ec, 101); kprint(ec, 114); kprint(ec, 110);
    kprint(ec, 101); kprint(ec, 108); kprint(ec, 32);
    kprint(ec, 98); kprint(ec, 111); kprint(ec, 111); kprint(ec, 116);
    kprint(ec, 101); kprint(ec, 100); kprint(ec, 10);
}

fn kputs_pmm_ok(ec: State<EarlyConsole>) {
    // "PMM: 16MB ready\n"
    kprint(ec, 80); kprint(ec, 77); kprint(ec, 77); kprint(ec, 58);
    kprint(ec, 32); kprint(ec, 49); kprint(ec, 54); kprint(ec, 77);
    kprint(ec, 66); kprint(ec, 32); kprint(ec, 114); kprint(ec, 101);
    kprint(ec, 97); kprint(ec, 100); kprint(ec, 121); kprint(ec, 10);
}

fn kputs_proc_ok(ec: State<EarlyConsole>) {
    // "PROC: init task created\n"
    kprint(ec, 80); kprint(ec, 82); kprint(ec, 79); kprint(ec, 67);
    kprint(ec, 58); kprint(ec, 32); kprint(ec, 105); kprint(ec, 110);
    kprint(ec, 105); kprint(ec, 116); kprint(ec, 32); kprint(ec, 116);
    kprint(ec, 97); kprint(ec, 115); kprint(ec, 107); kprint(ec, 32);
    kprint(ec, 99); kprint(ec, 114); kprint(ec, 101); kprint(ec, 97);
    kprint(ec, 116); kprint(ec, 101); kprint(ec, 100); kprint(ec, 10);
}

fn kputs_vfs_ok(ec: State<EarlyConsole>) {
    // "VFS: root mounted\n"
    kprint(ec, 86); kprint(ec, 70); kprint(ec, 83); kprint(ec, 58);
    kprint(ec, 32); kprint(ec, 114); kprint(ec, 111); kprint(ec, 111);
    kprint(ec, 116); kprint(ec, 32); kprint(ec, 109); kprint(ec, 111);
    kprint(ec, 117); kprint(ec, 110); kprint(ec, 116); kprint(ec, 101);
    kprint(ec, 100); kprint(ec, 10);
}

fn kputs_prompt(ec: State<EarlyConsole>) {
    // "vwk> "
    kprint(ec, 118); kprint(ec, 119); kprint(ec, 107); kprint(ec, 62);
    kprint(ec, 32);
}

fn kputs_newline(ec: State<EarlyConsole>) {
    kprint(ec, 10);
}

fn kputs_shutdown(ec: State<EarlyConsole>) {
    // "VWK shutting down\n"
    kprint(ec, 86); kprint(ec, 87); kprint(ec, 75); kprint(ec, 32);
    kprint(ec, 115); kprint(ec, 104); kprint(ec, 117); kprint(ec, 116);
    kprint(ec, 116); kprint(ec, 105); kprint(ec, 110); kprint(ec, 103);
    kprint(ec, 32); kprint(ec, 100); kprint(ec, 111); kprint(ec, 119);
    kprint(ec, 110); kprint(ec, 10);
}

// ── kmain — the real kernel main routine ──────────────────────────────────
fn kmain() -> i32 {
    // 1. Early console init
    let ec = state_new(EarlyConsole);
    early_console_init(ec, 0, 4);

    // 2. Boot banner
    kputs_banner(ec);

    // 3. Initialize PMM (buddy allocator, 1MB start, 16MB size)
    let pool = state_new(FlatPool);
    let pmm = state_new(PmmState);
    pmm_init(pool, pmm, 1048576, 16777216);
    kputs_pmm_ok(ec);

    // 4. Initialize ProcessTable + create init task
    let tbl = state_new(ProcessTable);
    pt_init(tbl);
    let task0 = task_alloc(tbl);
    kputs_proc_ok(ec);

    // 5. Initialize VFS
    let inodes = state_new(InodeTable);
    inode_init_table(inodes);
    kputs_vfs_ok(ec);

    // 6. Interactive shell loop
    kputs_newline(ec);
    kputs_prompt(ec);

    let buf = state_new(KBuf);
    let pos: u32 = 0;
    let running: u8 = 1;
    let cmd_buf = state_new(KBuf);

    while running == 1 {
        // Read one byte from stdin (fd 0) into buf
        let n = read(0, buf as Address, 1);

        if n <= 0 {
            break;
        }

        let c = buf.data[0];

        // Echo the byte back to stdout
        kprint(ec, c);

        // On newline, process the command
        if c == 10 {
            // cmd_buf holds the typed command bytes at positions 0..pos
            let cmd = cmd_buf.data[0];

            // "echo" → 'e' = 101, check second byte is 'c' = 99 (not 'x')
            if cmd == 101 {
                if pos > 1 {
                    if cmd_buf.data[1] == 120 {
                        // "exit" — shut down
                        kputs_shutdown(ec);
                        running = 0;
                    } else {
                        // "echo <args>" — print args (skip the "echo " prefix)
                        kprint(ec, 101); kprint(ec, 99); kprint(ec, 104);
                        kprint(ec, 111); kprint(ec, 58); kprint(ec, 32);
                        // Start from byte 5 (skip "echo ") if there's a space
                        let start: u32 = 5;
                        if pos > 4 {
                            if cmd_buf.data[4] == 32 {
                                // "echo " with space — skip it
                                let i: u32 = 5;
                                while i < pos {
                                    kprint(ec, cmd_buf.data[i as u32]);
                                    i = i + 1;
                                }
                            } else {
                                // "echo" without space after — print from byte 4
                                let i: u32 = 4;
                                while i < pos {
                                    kprint(ec, cmd_buf.data[i as u32]);
                                    i = i + 1;
                                }
                            }
                        }
                        kprint(ec, 10);
                    }
                } else {
                    // Just "e" — treat as echo with no args
                    kprint(ec, 101); kprint(ec, 99); kprint(ec, 104);
                    kprint(ec, 111); kprint(ec, 58); kprint(ec, 10);
                }
            }

            // "exit" → already handled above in the 'e' branch

            // "help" → 'h' = 104
            if cmd == 104 {
                // Print help text
                kprint(ec, 99); kprint(ec, 109); kprint(ec, 100); kprint(ec, 115);
                kprint(ec, 58); kprint(ec, 32); kprint(ec, 101); kprint(ec, 99);
                kprint(ec, 104); kprint(ec, 111); kprint(ec, 44); kprint(ec, 32);
                kprint(ec, 104); kprint(ec, 101); kprint(ec, 108); kprint(ec, 112);
                kprint(ec, 44); kprint(ec, 32); kprint(ec, 101); kprint(ec, 120);
                kprint(ec, 105); kprint(ec, 116); kprint(ec, 10);
            }

            // "pid" → 'p' = 112
            if cmd == 112 {
                // Print PID (task0's pid)
                kprint(ec, 112); kprint(ec, 105); kprint(ec, 100); kprint(ec, 58);
                kprint(ec, 32); kprint(ec, 49); kprint(ec, 10);
            }

            // Reset for next line
            pos = 0;
            if running == 1 {
                kputs_prompt(ec);
            }
        } else {
            // Append to cmd_buf (not buf, which is used for read)
            if pos < 255 {
                cmd_buf.data[pos] = c;
                pos = pos + 1;
            }
        }
    }

    kputs_shutdown(ec);
    return 0;
}

fn main() -> i32 {
    let code = kmain();
    return code;
}
