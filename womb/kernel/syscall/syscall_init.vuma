//     registered number is whatever the spec says (202); the handler
//     is the same futex_wait/wake dispatch either way.

fn sys_wait4(pid: u64, wstatus: u64, options: u64, rusage: u64) -> i64 {
    return 0;
}

fn sys_kill(pid: u64, sig: u64) -> i64 {
    return 0;
}

fn sys_futex(uaddr: u64, op: u64, val: u64, timeout: u64, uaddr2: u64, val3: u64) -> i64 {
