//     wraps it in a tf-style handler.
//   - sys_execve: K4d's exec.vuma has sys_exec(tbl, task_idx, entry,
//     stack) — K11 wraps it in a tf-style handler.

fn sys_exit_group(code: i64) {
    return;
}

fn sys_clone(flags: u64, stack: u64, ptid: u64, ctid: u64, tls: u64) -> i64 {
