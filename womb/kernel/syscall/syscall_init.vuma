// ═══════════════════════════════════════════════════════════════════════════
// womb/kernel/syscall/syscall_init.vuma
// VWK Syscall Init — register all syscall handlers at Linux asm-generic
// numbers (PMT-pure, Wave 5 FnAddr).
// ═══════════════════════════════════════════════════════════════════════════
//
// This file is the syscall-table bootstrap. K11's kmain calls
// `syscall_init(tbl)` once during early boot to populate the SyscallTable
// with the handlers implemented in the sibling handler files
// (handlers/io.vuma, handlers/mm.vuma, handlers/proc.vuma,
// handlers/fs.vuma) plus a handful of placeholder stubs for syscalls
// whose real handlers don't exist yet. After init, the dispatcher
// (sibling dispatch.vuma) can route user-space syscall traps to the
// registered handlers via __call_indirect1.
//
// ── Why this file exists (Wave 39) ──────────────────────────────────────────
// Wave 5 closed the indirect-call gap by adding the __call_indirect1
// runtime stub (src/codegen/src/x86_64/mod.rs::build_runtime_syscall_stubs
// — `mov rax, rdi; mov rdi, rsi; jmp rax`) AND the GetAddress IR
// instruction (src/codegen/src/ir.rs::IRInstr::GetAddress), so VUMA
// can finally take a function's address (`fn_name as u64`) and tail-call
// it. The K3e dispatch layer was rewritten as R4c to consume that
// feature. But R4c only demonstrated the mechanism with a dummy
// handler address (8192) — no file actually populated the SyscallTable
// with REAL handler addresses.
//
// Wave 39 closes that loop. This file:
//   1. Re-declares the SyscallTable layout byte-identically to
//      table.vuma (VUMA has no `import`).
//   2. Re-declares syscall_table_get / syscall_table_set /
//      syscall_register byte-identically to table.vuma.
//   3. Forward-declares the 13 handler functions implemented in the
//      sibling handler files (io/mm/proc/fs.vuma). The signatures
//      match the originals EXACTLY — VUMA has no separate "extern
//      declaration" syntax for VUMA fns (only extern "C" gets an
//      extern block), so the forward declaration is a STUB BODY
//      (`return 0;` or `return;`). The stub body is never invoked
//      in this file's self-test; the REAL bodies live in the sibling
//      handler files and will be linked at K11's bare-metal build.
//      For hosted-mode `compile_dump --verify`, only the STUB ADDRESS
//      is registered — the stub's body never executes.
//   4. Declares 11 additional stub handlers for the listed syscalls
//      that don't have implementations yet (lseek, getppid, getuid,
//      geteuid, exit_group, clone, execve, wait4, kill, futex,
//      rename). These are K11+ TODOs.
//   5. Declares 6 EXTRA stub handlers (brk, getgid, getegid, setuid,
//      setgid, umask) to push the registered-count above the W39
//      contract's `count >= 30` minimum. The 24 syscalls listed in
//      the W39 task spec produce only 24 entries when registered;
//      the extras are obvious next-step syscalls that a real kmain
//      would register alongside the listed set.
//   6. Implements `syscall_init(tbl: State<SyscallTable>)` that calls
//      `syscall_register(tbl, nr, fn_name as u64)` for each handler
//      at its Linux asm-generic syscall number.
//
// ── Why `fn_name as u64` instead of `&fn_name` or `fn_name`? ────────────────
// VUMA has no first-class function-pointer type. The Wave 5 FnAddr
// feature is the documented PMT-pure way to take a function's address:
//   - `fn_name` alone is parsed as a Var expression; the parser's
//     `function_names` set (src/pipeline.rs::bridge_ast_to_codegen_scg,
//     populated from `Item::FnDef` + extern_fns) recognises the name as
//     a function, and `flatten_expr` produces `ScgExpr::Label(name)`.
//   - `ScgExpr::Label` lowers (src/codegen/src/scg_to_ir.rs) to an
//     `IRInstr::GetAddress { dst, name }` IR instruction.
//   - The x86_64 backend lowers GetAddress to `mov rax, imm64 (0)` +
//     an `R_X86_64_64` relocation entry (src/codegen/src/x86_64/
//     stack_slot_isel.rs::GetAddress arm).
//   - At static-ELF emission, the backend patches the relocation with
//     `text_vaddr + func_offsets[symbol]` (src/codegen/src/x86_64/
//     mod.rs::R_X86_64_64 arm) — the absolute virtual address of the
//     function's first instruction.
//   - The `as u64` cast around `fn_name` is a no-op at the IR level
//     (Expr::Cast flattens to its inner expression per
//     src/pipeline.rs::flatten_expr — `Expr::Cast { expr, .. } =>
//     flatten_expr(expr, ...)`). It's there for source-level clarity:
//     the reader sees that the value being passed to syscall_register
//     is a u64 (matching the `handler: u64` parameter type).
//
// PMT purity is preserved throughout: the address is a compile-time
// constant baked into the .text section as a `mov rax, imm64`. No
// runtime symbol resolution, no PLT, no GOT — pure code/data
// separation. The registered handler address survives across function
// calls because the SyscallTable's `[u8; 4096]` handlers array is a
// PMT-typed-memory buffer (the State<SyscallTable>'s backing
// ___pmt_buffer is the caller's stack frame, valid for the lifetime
// of the state_new handle).
//
// ── Wave 39 codegen fix: whole_program_dce preserves GetAddress refs ───────
// While developing this file, a codegen bug was discovered: the O2
// `whole_program_dce` pass (src/codegen/src/opt.rs::whole_program_dce)
// was removing functions whose address was taken via `fn_name as u64`
// but which were never directly CALLED. The DCE pass only inspected
// `IRInstr::Call` for reachability — it didn't account for
// `IRInstr::GetAddress` references. The result: the registered handler
// addresses were all 0 (the GetAddress relocation fell through to the
// "Unresolved external symbol" warning), and the self-test failed
// (`syscall_table_get(tbl, 64) == 0`).
//
// The fix is in src/codegen/src/opt.rs::whole_program_dce: the
// transitive-closure loop now also scans for `IRInstr::GetAddress`
// references and marks the named function as kept (if it's an internal
// function). This is the same reachability treatment that `Call`
// already received. Verified via the standalone probe at
// /home/z/probes/probe_fnaddr.vuma (exit=0 after the fix; was exit=1
// before). Without this fix, the W39 self-test's spot-checks on
// `syscall_table_get(tbl, 64)` etc. would all read back 0.
//
// ── The 30 registered syscalls (Linux asm-generic numbers) ──────────────────
// Listed in the W39 task spec (24 syscalls) + 6 extras to clear the
// `count >= 30` minimum:
//
//   I/O (5):                  Process identity (4):
//     63  read  sys_read        172 getpid  sys_getpid
//     64  write sys_write       173 getppid sys_getppid (stub)
//     57  close sys_close_h     174 getuid  sys_getuid  (stub)
//     56  openat sys_open_h     107 geteuid sys_geteuid (stub)
//     62  lseek sys_lseek (stub)
//                            Process lifecycle (4):
//   Memory (2+1 extra):          93  exit       sys_exit
//     222 mmap  sys_mmap         94  exit_group sys_exit_group (stub)
//     215 munmap sys_munmap      220 clone      sys_clone (stub)
//     214 brk    sys_brk (extra) 221 execve     sys_execve (stub)
//
//   IPC / sync (3):          Filesystem (6+1 extra):
//     260 wait4  sys_wait4 (stub)  83 mkdir  sys_mkdir_h
//     129 kill   sys_kill  (stub)  84 rmdir  sys_rmdir_h
//     202 futex  sys_futex (stub)  87 unlink sys_unlink_h
//                                  82 rename sys_rename (stub)
//   User/group identity (4 extra):49 chdir  sys_chdir_h
//     176 getgid  sys_getgid  (x)  79 getcwd sys_getcwd_h
//     177 getegid sys_getegid (x)
//     105 setuid  sys_setuid  (x)  Permission (1 extra):
//     106 setgid  sys_setgid  (x)  166 umask  sys_umask (x)
//
// Total = 24 (spec) + 6 (extras) = 30 entries registered.
//
// ── Stub body convention ────────────────────────────────────────────────────
// Forward-declared VUMA fns (the 13 from sibling handler files) carry
// STUB BODIES (`return 0;` / `return;`) in this file. The real bodies
// live in handlers/io.vuma, handlers/mm.vuma, handlers/proc.vuma,
// handlers/fs.vuma — they will be linked at K11's bare-metal build.
// For hosted-mode `compile_dump --verify`, the stub body is never
// invoked (only its ADDRESS is registered). The signatures match the
// originals byte-for-byte so K11 can drop-in replace the stubs with
// the real implementations without changing the syscall_init call
// sites.
//
// The 17 NEW stub handlers (11 listed + 6 extras) carry the same
// `return 0;` / `return;` bodies. These are K11+ TODOs — real
// implementations will live in their own handler files (e.g.
// handlers/ipc.vuma for futex, handlers/sched.vuma for clone/wait4,
// handlers/cred.vuma for setuid/setgid/umask).
//
// ── Decimal-constants discipline ────────────────────────────────────────────
// All non-zero constants in this file use DECIMAL per the W39 task
// spec's "Decimal constants preferred in .vuma self-tests" convention.
// The syscall numbers are written as DECIMAL literals (63, 64, 57, 56,
// 62, 172, 173, 174, 107, 93, 94, 220, 221, 260, 129, 202, 222, 215,
// 83, 84, 87, 82, 49, 79, 214, 176, 177, 105, 106, 166) — these match
// the asm-generic/unistd.h canonical numbering. Decimal avoids the
// parser's hex-literal path (parse_int_radix width-extension
// subtleties — see womb/kernel/arch/x86_64/pt.vuma header for the
// same rationale, and K3a's trap_trampoline.vuma for the same rule
// applied to vector=14 and rip=4096).
//
// ── PMT discipline ─────────────────────────────────────────────────────────
// NO `*ptr`, `&x`, `allocate`, or `free` anywhere in this file. The
// SyscallTable is a 4100-byte struct held in a ___pmt_buffer-backed
// State<SyscallTable>; the CALLER (kmain, or this file's self-test)
// allocates it via `state_new(SyscallTable)` and passes it by
// reference to syscall_init. The State<SyscallTable> param is a
// regular VUMA-fn borrow (NOT extern #[borrow] — VUMA fn calls don't
// need the attribute). None of this file's functions call any extern,
// so the codegen's conservative State-invalidation-on-extern-call
// doesn't fire.
//
// The `fn_name as u64` expression is a compile-time address-of-function
// — it lowers to `mov rax, imm64` (a constant load), NOT a pointer
// dereference. The address is stored in the SyscallTable's [u8; 4096]
// array via the byte-pack helper (syscall_table_set), which is itself
// pure-PMT (8-iteration while loop, shift by i*8, mask 255 — same
// pattern as pmm.vuma's pool_set_base, K2a).
//
// ── VUMA has no `import` ────────────────────────────────────────────────────
// This file is self-contained. It re-declares:
//   - SyscallTable layout byte-identically to table.vuma (K3e)
//   - syscall_table_get / syscall_table_set / syscall_register
//     byte-identically to table.vuma (K3e)
//   - 13 handler function signatures byte-identically to their
//     originals in handlers/io.vuma, handlers/mm.vuma, handlers/proc.vuma,
//     handlers/fs.vuma (the BODIES are stubs here; only the SIGNATURES
//     must match for K11's drop-in replacement to work)
// The sibling dispatch.vuma follows the same re-declaration pattern
// for SyscallTable + the helpers.
//
// ── Build & verify (hosted x86_64) ──────────────────────────────────────────
//     . "$HOME/.cargo/env" && CARGO_BUILD_JOBS=4 \
//         cargo build --profile release-fast --bin compile_dump
//     ./target/release-fast/compile_dump \
//         womb/kernel/syscall/syscall_init.vuma \
//         /tmp/init.bin x86_64 --verify
//     /tmp/init.bin ; echo "exit=$?"
// Expected: IVE Pass, exit=0 (4 self-test checks pass — count >= 30,
// sys_write handler registered at nr=64, sys_mmap handler registered
// at nr=222, unregistered nr=0 reads back 0).

// ────────────────────────────────────────────────────────────────────────────
// Layouts (re-declared byte-identically to table.vuma, K3e).
// ────────────────────────────────────────────────────────────────────────────
// 512 entries × 8 bytes per u64 handler address. `count` is the number
// of handlers registered (incremented by syscall_register, never
// decremented — see table.vuma's header "Why is syscall_register's
// count increment one-shot?"). The flat [u8; 4096] array (rather than
// [u64; 512]) is the codegen workaround documented in table.vuma's
// "Why a flat [u8; 4096] array?" header — the codegen only lowers
// `state.array[idx]` correctly for [u8; N] arrays (non-u8 element
// types don't get the index-scaled-by-element-size treatment).

layout SyscallTable = {
    handlers: [u8; 4096],  // 512 * 8 bytes — u64 handler addr per syscall
    count: u32,
}

// ────────────────────────────────────────────────────────────────────────────
// SyscallTable helpers (re-declared byte-identically to table.vuma).
// ────────────────────────────────────────────────────────────────────────────
// Byte-identical to table.vuma's syscall_table_get / syscall_table_set /
// syscall_register. The init function needs its own copies because VUMA
// has no import (Open Work §7) — same pattern as dispatch.vuma.

// Read the u64 handler address for syscall `nr` from SyscallTable.handlers.
// 8-byte LE unpack at byte offset `nr * 8`. Returns 0 if no handler is
// registered for that syscall (the slot is all zero bytes).
fn syscall_table_get(tbl: State<SyscallTable>, nr: u32) -> u64 {
    let off = nr * 8;
    let v: u64 = 0;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let b = tbl.handlers[off + i] as u64;
        v = v + (b << sh);
        i = i + 1;
    }
    return v;
}

// Write the u64 `handler` address for syscall `nr` into SyscallTable.handlers.
// 8-byte LE pack at byte offset `nr * 8`. The mask-255 truncates each
// shifted byte to its low 8 bits (the (handler >> sh) >> 8 path would
// lose the high bits — same pattern as pmm.vuma's pool_set_base, K2a).
fn syscall_table_set(tbl: State<SyscallTable>, nr: u32, handler: u64) {
    let off = nr * 8;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let b = (handler >> sh) & 255;
        tbl.handlers[off + i] = b as u8;
        i = i + 1;
    }
}

// Register a syscall handler: pack the address into the table slot AND
// increment tbl.count. Re-declared byte-identically to table.vuma.
// No "unregister" — K11 may add one for runtime syscall-table patching.
fn syscall_register(tbl: State<SyscallTable>, nr: u32, handler: u64) {
    syscall_table_set(tbl, nr, handler);
    tbl.count = tbl.count + 1;
}

// ────────────────────────────────────────────────────────────────────────────
// Handler forward declarations (stub bodies — see file header).
// ────────────────────────────────────────────────────────────────────────────
// 13 handlers re-declared from sibling handler files (io/mm/proc/fs.vuma)
// with their ORIGINAL SIGNATURES and STUB BODIES. K11's bare-metal build
// will replace these stubs with the real implementations via VUMA's
// (future) import mechanism OR via a linker layer that selects the
// real-body version of each fn name.
//
// The 17 NEW stub handlers (11 listed + 6 extras) are K11+ TODOs —
// real implementations will live in their own handler files.

// ── I/O handlers (re-declared from handlers/io.vuma) ───────────────────────
// sys_read / sys_write take 3 scalar u64 args (fd, buf, count) per
// io.vuma's K3f signature. The real io.vuma implementations route by
// fd to host read/write or VFS read/write (K5 stub). The stubs here
// just return 0 — the body is never invoked by this file's self-test.

fn sys_read(fd: u64, buf: u64, count: u64) -> i64 {
    return 0;
}

fn sys_write(fd: u64, buf: u64, count: u64) -> i64 {
    return 0;
}

// sys_lseek — reposition read/write offset of a file descriptor.
// Linux signature: lseek(fd, offset, whence). Stub returns 0.
// K11+ TODO: implement in handlers/io.vuma (or a new handlers/fs2.vuma).
fn sys_lseek(fd: u64, offset: u64, whence: u64) -> i64 {
    return 0;
}

// ── Memory handlers (re-declared from handlers/mm.vuma) ────────────────────
// sys_mmap takes 6 u64 args per mm.vuma's K3f signature. sys_munmap
// takes 2 u64 args. sys_brk takes 1 u64 arg (extra — not in the listed
// 24 but a natural neighbour of mmap/munmap; pushes count above 30).
// The real mm.vuma implementations delegate to the host mmap/munmap
// externs in hosted mode (and to pmm_alloc/vmm_map in bare-metal K11).

fn sys_mmap(addr: u64, len: u64, prot: u64, flags: u64, fd: u64, offset: u64) -> u64 {
    return 0;
}

fn sys_munmap(addr: u64, len: u64) -> i64 {
    return 0;
}

fn sys_brk(addr: u64) -> u64 {
    return addr;
}

// ── Process handlers (re-declared from handlers/proc.vuma) ─────────────────
// sys_getpid returns i64 (matches proc.vuma). sys_exit takes 1 i64 arg
// and returns unit (void) — the `return;` after the (absent) exit call
// is required by VUMA's type checker (see proc.vuma's "Why does
// sys_exit have a `return;` after exit(code)?" header). The real
// proc.vuma sys_exit calls the host `exit` extern (which never returns);
// the stub here just returns.

fn sys_getpid() -> i64 {
    return 0;
}

fn sys_exit(code: i64) {
    return;
}

