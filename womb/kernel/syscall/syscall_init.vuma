// ────────────────────────────────────────────────────────────────────────────
// syscall_init — register all 30 handlers at their asm-generic numbers.
// ────────────────────────────────────────────────────────────────────────────
// Walks the 30 (nr, handler) pairs and calls syscall_register for each.
// After init, tbl.count == 30 (assuming the caller zero-init'd count
// before calling — see the self-test below). The handler addresses are
// compile-time constants baked into the .text section via the Wave 5
// GetAddress lowering (see file header "Why `fn_name as u64`?").
//
// The nr literals are DECIMAL per the W39 task spec — they match the
// asm-generic/unistd.h canonical numbering (NOT the x86_64 native
// numbering, except where the two happen to coincide — e.g. __NR_getcwd
// is 17 asm-generic vs 79 x86_64; the spec says 79, so we use 79).
//
// K11 will call this from kmain:
//     let tbl = state_new(SyscallTable);
//     tbl.count = 0;
//     syscall_init(tbl);
//     // ... trap_entry routes syscalls via syscall_dispatch_from_trap(tbl, tf)

fn syscall_init(tbl: State<SyscallTable>) {
    // ── I/O (5) ──────────────────────────────────────────────────────────
    syscall_register(tbl, 63, sys_read as u64);       // __NR_read
    syscall_register(tbl, 64, sys_write as u64);      // __NR_write
    syscall_register(tbl, 57, sys_close_handler as u64);  // __NR_close
    syscall_register(tbl, 56, sys_open_handler as u64);   // __NR_openat
    syscall_register(tbl, 62, sys_lseek as u64);      // __NR_lseek

    // ── Process identity (4) ─────────────────────────────────────────────
    syscall_register(tbl, 172, sys_getpid as u64);    // __NR_getpid
    syscall_register(tbl, 173, sys_getppid as u64);   // __NR_getppid
    syscall_register(tbl, 174, sys_getuid as u64);    // __NR_getuid
    syscall_register(tbl, 107, sys_geteuid as u64);   // __NR_geteuid

    // ── Process lifecycle (4) ────────────────────────────────────────────
    syscall_register(tbl, 93, sys_exit as u64);       // __NR_exit
    syscall_register(tbl, 94, sys_exit_group as u64); // __NR_exit_group
    syscall_register(tbl, 220, sys_clone as u64);     // __NR_clone
    syscall_register(tbl, 221, sys_execve as u64);    // __NR_execve

    // ── IPC / sync (3) ──────────────────────────────────────────────────
    syscall_register(tbl, 260, sys_wait4 as u64);     // __NR_wait4
    syscall_register(tbl, 129, sys_kill as u64);      // __NR_kill
    syscall_register(tbl, 202, sys_futex as u64);     // __NR_futex (x86_64 native)

    // ── Memory management (2 + 1 extra) ─────────────────────────────────
    syscall_register(tbl, 222, sys_mmap as u64);      // __NR_mmap
    syscall_register(tbl, 215, sys_munmap as u64);    // __NR_munmap
    syscall_register(tbl, 214, sys_brk as u64);       // __NR_brk (EXTRA)

    // ── Filesystem (6 + 1 stub) ─────────────────────────────────────────
    syscall_register(tbl, 83, sys_mkdir_handler as u64);  // __NR_mkdir
    syscall_register(tbl, 84, sys_rmdir_handler as u64);  // __NR_rmdir
    syscall_register(tbl, 87, sys_unlink_handler as u64); // __NR_unlink
    syscall_register(tbl, 82, sys_rename as u64);     // __NR_rename (stub)
    syscall_register(tbl, 49, sys_chdir_handler as u64);  // __NR_chdir
    syscall_register(tbl, 79, sys_getcwd_handler as u64); // __NR_getcwd (x86_64 nr)

    // ── User/group identity (4 EXTRA — K11+ TODO) ───────────────────────
    syscall_register(tbl, 176, sys_getgid as u64);    // __NR_getgid (EXTRA)
    syscall_register(tbl, 177, sys_getegid as u64);   // __NR_getegid (EXTRA)
    syscall_register(tbl, 105, sys_setuid as u64);    // __NR_setuid (EXTRA)
    syscall_register(tbl, 106, sys_setgid as u64);    // __NR_setgid (EXTRA)

    // ── Permission (1 EXTRA — K11+ TODO) ────────────────────────────────
    syscall_register(tbl, 166, sys_umask as u64);     // __NR_umask (EXTRA)
}

// ────────────────────────────────────────────────────────────────────────────
// Self-test (the W39 DoD).
// ────────────────────────────────────────────────────────────────────────────
// Allocate a SyscallTable via state_new, zero-init count, call
// syscall_init, then verify:
//   (1) tbl.count >= 30  — the W39 contract's minimum. Returns 1 on
//       failure (would mean a syscall_register call was missed or
//       tbl.count was not zero before init).
//   (2) syscall_table_get(tbl, 64) != 0  — sys_write registered at
//       nr=64. The handler address is a real .text address (not 0).
//       Returns 2 on failure. Catches the "DCE removed the handler
//       function" bug documented in the file header (Wave 39 codegen
//       fix to whole_program_dce).
//   (3) syscall_table_get(tbl, 222) != 0  — sys_mmap registered at
//       nr=222. Independent spot-check on a different handler. Returns
//       3 on failure.
//   (4) syscall_table_get(tbl, 0) == 0  — nr=0 (__NR_io_setup on
//       asm-generic) was NOT registered by syscall_init, so its slot
//       should still be 0. Returns 4 on failure. Catches a hypothetical
//       "wrong nr registered" bug (e.g. if sys_read were registered at
//       nr=0 instead of nr=63).
// Returns 0 on success.
//
// The self-test does NOT actually INVOKE any handler via
// __call_indirect1 (that's dispatch.vuma's job, and dispatch.vuma's
// self-test deliberately crashes at runtime because the dummy handler
// address 8192 isn't callable — see dispatch.vuma's header). This
// file's self-test only verifies REGISTRATION — that the table was
// populated with the right (nr, handler) pairs. K11's kmain will run
// this same registration, then wire up dispatch.vuma's
// syscall_dispatch_from_trap to invoke the handlers.

fn main() -> i32 {
    let tbl = state_new(SyscallTable);
    tbl.count = 0;

    // Register all 30 handlers.
    syscall_init(tbl);

    // Check 1: count >= 30 (W39 contract minimum).
    if tbl.count < 30 { return 1; }

    // Check 2: sys_write registered at nr=64 (handler address != 0).
    if syscall_table_get(tbl, 64) == 0 { return 2; }

    // Check 3: sys_mmap registered at nr=222 (independent spot-check).
    if syscall_table_get(tbl, 222) == 0 { return 3; }

    // Check 4: nr=0 was NOT registered (slot still 0).
    if syscall_table_get(tbl, 0) != 0 { return 4; }

    return 0;
}
