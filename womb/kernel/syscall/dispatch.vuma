// ═══════════════════════════════════════════════════════════════════════════
// womb/kernel/syscall/dispatch.vuma
// VWK Syscall Dispatch — nr → handler lookup via the superset TrapFrame.
// Wave R4c (PMT-pure).
// ═══════════════════════════════════════════════════════════════════════════
//
// This file is the R4c rewrite of K3e's syscall dispatch layer. K3e's
// version took a SyscallArgs struct (a separate 7-word view that K3d's
// trap.vuma marshaled out of the TrapFrame via sibling abi.vuma). R4c
// collapses that indirection: the dispatcher now reads the syscall
// number and arguments directly from the superset TrapFrame's canonical
// GPR slots, and writes the return value back to canonical slot 7. No
// SyscallArgs intermediate, no abi.vuma marshaling layer needed at the
// dispatch call site.
//
// ── Canonical GPR slot mapping (R2a) ────────────────────────────────────────
// The superset TrapFrame packs 32 × u64 GPRs little-endian into a flat
// 256-byte `gpr` array. The R4c syscall contract assigns canonical slots:
//     slot 0  = syscall number (nr)
//     slot 1  = arg0
//     slot 2  = arg1
//     slot 3  = arg2
//     slot 4  = arg3
//     slot 5  = arg4
//     slot 6  = arg5
//     slot 7  = return value
//     slots 8..31 = unused by the syscall path (scratch / callee-saved)
//
// Per-arch, the trap_entry stub (R2b/R2c/R2d) is responsible for placing
// the user's syscall-ABI registers into these canonical slots:
//     x86_64 (Linux int 0x80 / syscall ABI):
//         nr  ← rax  → slot 0
//         a0  ← rdi  → slot 1
//         a1  ← rsi  → slot 2
//         a2  ← rdx  → slot 3
//         a3  ← r10  → slot 4
//         a4  ← r8   → slot 5
//         a5  ← r9   → slot 6
//         ret → rax  ← slot 7
//     aarch64 (AArch64 Linux SVC):
//         nr  ← x8   → slot 0
//         a0..a5 ← x0..x5 → slots 1..6
//         ret → x0   ← slot 7
//     riscv64 (RISC-V Linux ecall):
//         nr  ← a7   → slot 0
//         a0..a5 ← a0..a5 → slots 1..6
//         ret → a0   ← slot 7
// The dispatcher does NOT know about these mappings — it reads/writes
// the canonical slots via tf_get_gpr / tf_set_gpr. This is the R2 Golden
// Rule: "Do not write arch-conditional logic inside kernel transforms."
//
// ── How is the handler-call wired? (Wave 5) ─────────────────────────────────
// VUMA has no first-class function-pointer type: `handler()` where
// `handler` is a u64 won't compile (the parser only accepts direct fn-
// identifier calls, not indirect calls through a u64). The K3e contract
// documented this limitation; R4c left the handler-call as a stub
// (`let result = 0;`) because no indirect-call mechanism existed yet.
//
// Wave 5 closed that gap by adding the `__call_indirect1(ptr: u64, arg:
// u64) -> u64` runtime stub to the x86_64 backend (src/codegen/src/
// x86_64/mod.rs::build_runtime_syscall_stubs). It lowers to `mov rax,
// rdi; mov rdi, rsi; jmp rax` — a tail call that invokes the function
// at `ptr` with `arg` in RDI (SysV AMD64 first-argument register). The
// stub is in the same category as write/read/exit (runtime stubs), NOT
// a C library function.
//
// So the dispatch now:
//   - bounds-checks nr (exercises the u64-vs-512 comparison)
//   - looks up the handler via syscall_table_get (exercises the pack/
//     unpack helper)
//   - branches on handler != 0
//   - on the registered path: `__call_indirect1(handler, tf as Address)`
//     — hands the trap-frame buffer's base address to the handler so it
//     can read args from the canonical GPR slots via tf_get_gpr and
//     write its return value via tf_set_gpr.
//   - writes the handler's u64 result to canonical slot 7
//
// In hosted mode the compile_dump --verify step runs the IVE state
// verifiers (which check the dispatch's PMT purity) but does NOT execute
// the binary — the self-test's handler address (8192) is not a callable
// function in hosted mode, so running /tmp/dispatch.bin would crash.
// Bare-metal (K11) wires real function pointers via syscall_register;
// the indirect call then lands at the handler's first instruction.
//
// ── Why -ENOSYS = 38 (not the negative value)? ──────────────────────────────
// Linux errno values are positive integers in the kernel's internal
// representation (the kernel returns -errno as a negative i64, and the
// libc wrapper translates -errno → errno = -retval at the user-space
// boundary). The VUMA convention in this file is to return the POSITIVE
// errno value (38 = ENOSYS) and let the caller (K11's trap_syscall)
// negate it before writing it back to canonical slot 7. This avoids
// signed-arithmetic subtleties in VUMA's u64-dominated codegen (the
// alternative `return -38` would require an i64 return type, and VUMA's
// u64/i64 implicit-conversion rules are sometimes surprising — see K2c's
// pt.vuma header for the same "use unsigned, document the sign
// convention" rationale). K11 will pick the final sign convention.
//
// ── Why 512 as the bounds check? ────────────────────────────────────────────
// 512 is the SyscallTable size (see sibling table.vuma's "Why 512
// entries?" header — Linux asm-generic/unistd.h numbers syscalls 0..449+
// as of kernel 6.x; 512 gives headroom to ~512 without a resize). The
// dispatch's bounds check `nr >= 512` returns -ENOSYS for any syscall
// number outside the table. This catches:
//   - User-space passing an invalid syscall number (e.g. nr = 999 in
//     the self-test).
//   - The host kernel (in some hosted-test scenarios) passing through a
//     syscall number that doesn't exist in asm-generic.
//   - Future syscall numbers above 511 (when Linux eventually exceeds
//     512 syscalls — K11 will bump the table size at that point).
//
// ── Layouts re-declared (no import in VUMA) ─────────────────────────────────
// VUMA has no `import` (Open Work §7), so this file re-declares:
//   - TrapFrame byte-identically to R2a's womb/kernel/trap/trap_frame.vuma
//   - SyscallTable byte-identically to sibling table.vuma (K3e)
// The byte-identical-redeclaration invariant (K2c "extern signatures
// MUST stay byte-identical" — extended to layouts in K3d) extends to
// layouts: this file's `syscall_dispatch_from_trap(tbl, tf)` MUST see
// the same field offsets, field names, and field types as R2a's
// trap_frame.vuma and table.vuma.
//
// R4c dropped the SyscallArgs layout (K3e's intermediate view) — the
// dispatcher now operates on the TrapFrame directly. K11 may keep
// abi.vuma around for the per-arch trap_entry stubs (which still need
// to translate hardware registers into canonical slots), but the
// dispatch layer no longer consumes SyscallArgs.
//
// ── Helper re-declarations ─────────────────────────────────────────────────
// This file re-declares:
//   - tf_get_gpr / tf_set_gpr / tf_init byte-identically to R2a's
//     trap_frame.vuma (so the dispatcher can read/write canonical slots
//     without depending on a sibling file at compile time).
//   - syscall_table_get / syscall_table_set / syscall_register byte-
//     identically to sibling table.vuma (K3e).
// VUMA has no import, so the dispatcher needs its own copies. K11 may
// consolidate these into a shared "syscall/table.vuma" that everyone
// imports once VUMA gains an import mechanism.
//
// ── Forward function references ─────────────────────────────────────────────
// This file's main() calls syscall_dispatch_from_trap BEFORE
// syscall_dispatch_from_trap is declared (the helper appears after
// main in the source). VUMA's parser supports forward function
// references (it does a two-pass scan: pass 1 collects all fn
// signatures into the symbol table, pass 2 resolves call sites).
// Verified in this file's self-test (exit=0). Same forward-reference
// pattern is used by K3d's irq.vuma and K3e's original dispatch.vuma.
//
// ── PMT discipline ─────────────────────────────────────────────────────────
// NO `*ptr`, `&x`, `allocate`, or `free` anywhere in this file. Both
// TrapFrame and SyscallTable are ___pmt_buffer-backed State<T>'s
// allocated by the CALLER via `state_new(...)`. The State<T> params are
// regular VUMA-fn borrows (NOT extern #[borrow] — VUMA fn calls don't
// need the attribute, only extern "C" calls do). None of this file's
// functions call any extern, so the codegen's conservative State-
// invalidation-on-extern-call doesn't fire.
//
// ── Decimal-constants discipline ────────────────────────────────────────────
// All non-zero constants in this file use DECIMAL per the contract's
// "Use decimal constants (512=max syscalls, 38=ENOSYS, 64=write
// syscall)" rule:
//     512  = max syscalls (bounds-check threshold + handler-table size)
//     38   = ENOSYS (the errno for "no such syscall" — returned for
//            out-of-range nr AND unregistered nr)
//     64   = asm-generic __NR_write (the syscall number used in the
//            self-test — write is the canonical "hello world" syscall)
//     4096 = 0x1000 = handler-table array size (512 entries × 8 bytes)
//     8192 = 0x2000 = the dummy handler address used in the self-test
//     8    = bytes per u64 (loop bound for pack/unpack)
//     255  = 0xFF (byte mask for the unpack-shift-and-truncate path)
//     256  = gpr/fpu array size in TrapFrame (byte-loop bound)
//     24   = _pad array size in TrapFrame (byte-loop bound)
//     7    = canonical return-value slot (tf_set_gpr(tf, 7, ret))
//     1    = fd arg in self-test (stdout)
//     3    = count arg in self-test (3 bytes)
// Decimal avoids the parser's hex-literal path (parse_int_radix width-
// extension subtleties — see womb/kernel/arch/x86_64/pt.vuma header for
// the same rationale).
//
// ── Why does syscall_dispatch_from_trap return u64, not i64? ────────────────
// The contract specifies `fn syscall_dispatch_from_trap(...) -> u64`.
// The kernel's syscall ABI conventionally returns -errno as a negative
// i64 (in the range [-4095, -1]) for errors and a non-negative value
// for success. VUMA's u64/i64 implicit-conversion rules are sometimes
// surprising, so this file returns u64 throughout (38 for -ENOSYS, 0
// for the stub's success path). K11 will pick the final sign convention
// — likely the file stays u64 internally and the trap_syscall wrapper
// negates errno values before writing them to canonical slot 7.
//
// ── Build & verify (hosted x86_64) ──────────────────────────────────────────
//     . "$HOME/.cargo/env" && CARGO_BUILD_JOBS=4 \
//         cargo build --profile release-fast --bin compile_dump
//     ./target/release-fast/compile_dump \
//         womb/kernel/syscall/dispatch.vuma \
//         /tmp/dispatch.bin x86_64 --verify
//     /tmp/dispatch.bin ; echo "exit=$?"
// Expected: IVE Pass, exit=0 (3 self-test checks pass — out-of-range
// nr returns 38, unregistered nr returns 38, registered-nr dispatch
// returns 0 via the stub and writes the return value to slot 7).

// ────────────────────────────────────────────────────────────────────────────
// Extern "C" trampoline — indirect call (Wave 5).
// ────────────────────────────────────────────────────────────────────────────
// Wave 5 added the runtime stub `__call_indirect1(ptr: u64, arg: u64) -> u64`
// to the x86_64 backend (src/codegen/src/x86_64/mod.rs::build_runtime_syscall_
// stubs). It lowers to `mov rax, rdi; mov rdi, rsi; jmp rax` — a tail call
// that invokes the function at `ptr` with `arg` in RDI (SysV AMD64 first-
// argument register). This is the VUMA-pure way to perform an indirect
// function-pointer call: the language has no first-class fn-ptr type, so
// indirect dispatch is delegated to a runtime stub (same category as
// write/read/exit — NOT a C library function).
//
// syscall_dispatch_from_trap uses this stub to invoke the per-syscall
// handler, passing `tf as Address` (the State<TrapFrame> → Address cast
// yields the base address of the trap-frame buffer) so the handler can
// read its arguments from the canonical GPR slots via tf_get_gpr and
// write its return value via tf_set_gpr.
//
// Hosted: real asm stub (jmp rax) — but the handler addresses used in the
//         self-test (8192) are not callable in hosted mode, so the IVE-
//         verified binary compiles cleanly but is not executed by the
//         compile_dump --verify step (which only runs the IVE state
//         verifiers, not the binary itself).
// Bare-metal (K11): the handler addresses come from syscall_register,
//         which packs real function pointers — the indirect call lands
//         at the handler's first instruction.
extern "C" {
    fn __call_indirect1(ptr: u64, arg: u64) -> u64;
}

// ────────────────────────────────────────────────────────────────────────────
// Layouts (re-declared — no import in VUMA).
// ────────────────────────────────────────────────────────────────────────────

// Canonical superset TrapFrame (576 bytes total) — re-declared byte-
// identically to R2a's womb/kernel/trap/trap_frame.vuma. See R2a's header
// for the field semantics (gpr 32×u64 LE-packed in 256 bytes; pc/status/
// vector/error_code/sp are 5 scalar u64 fields; fpu is 32×u64 LE-packed
// in 256 bytes; _pad is 24 alignment bytes).
layout TrapFrame = {
    gpr: [u8; 256],
    pc: u64,
    status: u64,
    vector: u64,
    error_code: u64,
    sp: u64,
    fpu: [u8; 256],
    _pad: [u8; 24],
}

// Re-declared from table.vuma (K3e). 512 entries × 8 bytes per entry.
// count is the number of handlers registered (incremented by
// syscall_register, never decremented — see table.vuma's header).
layout SyscallTable = {
    handlers: [u8; 4096],  // 512 * 8 bytes — u64 handler addr per syscall
    count: u32,
}

// ────────────────────────────────────────────────────────────────────────────
// TrapFrame helpers (re-declared from R2a's trap_frame.vuma, byte-identical).
// ────────────────────────────────────────────────────────────────────────────
// tf_init + tf_get_gpr + tf_set_gpr, byte-identical to R2a. The
// dispatcher uses tf_get_gpr to read the canonical syscall slots
// (nr=slot 0, args=slots 1..6) and tf_set_gpr to write the return
// value to canonical slot 7. tf_init is included so the self-test can
// get a clean TrapFrame without relying on state_new's zero-fill.

// Read the u64 GPR at canonical slot `idx` from tf.gpr. 8-byte LE unpack
// at byte offset `idx * 8`. Byte-identical to R2a's tf_get_gpr.
fn tf_get_gpr(tf: State<TrapFrame>, idx: u32) -> u64 {
    let off = idx * 8;
    let v: u64 = 0;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let b = tf.gpr[off + i] as u64;
        v = v + (b << sh);
        i = i + 1;
    }
    return v;
}

// Write the u64 `val` to canonical slot `idx` in tf.gpr. 8-byte LE pack
// at byte offset `idx * 8`. Byte-identical to R2a's tf_set_gpr.
fn tf_set_gpr(tf: State<TrapFrame>, idx: u32, val: u64) {
    let off = idx * 8;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let b = (val >> sh) & 255;
        tf.gpr[off + i] = b as u8;
        i = i + 1;
    }
}

// Zero every field of a caller-allocated TrapFrame. Called once per
// TrapFrame before the arch-specific trap-to-superset adapter (R2b/R2c/
// R2d) populates the arch-specific fields, OR before the self-test uses
// it as a fresh save area. Byte-identical to R2a's tf_init.
fn tf_init(tf: State<TrapFrame>) {
    let i = 0;
    while i < 256 { tf.gpr[i] = 0; i = i + 1; }
    tf.pc = 0;
    tf.status = 0;
    tf.vector = 0;
    tf.error_code = 0;
    tf.sp = 0;
    let j = 0;
    while j < 256 { tf.fpu[j] = 0; j = j + 1; }
    let k = 0;
    while k < 24 { tf._pad[k] = 0; k = k + 1; }
}

// ────────────────────────────────────────────────────────────────────────────
// SyscallTable helpers (re-declared from K3e's table.vuma, byte-identical).
// ────────────────────────────────────────────────────────────────────────────
// Byte-identical to table.vuma's syscall_table_get / syscall_table_set /
// syscall_register. The dispatcher needs its own copies because VUMA
// has no import (Open Work §7).

// Read the u64 handler address for syscall `nr` from SyscallTable.handlers.
// Re-declared byte-identically to table.vuma.
fn syscall_table_get(tbl: State<SyscallTable>, nr: u32) -> u64 {
    let off = nr * 8;
    let v: u64 = 0;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let b = tbl.handlers[off + i] as u64;
        v = v + (b << sh);
        i = i + 1;
    }
    return v;
}

// Write the u64 handler address for syscall `nr` into SyscallTable.handlers.
// Re-declared byte-identically to table.vuma.
fn syscall_table_set(tbl: State<SyscallTable>, nr: u32, handler: u64) {
    let off = nr * 8;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let b = (handler >> sh) & 255;
        tbl.handlers[off + i] = b as u8;
        i = i + 1;
    }
}

// Register a syscall handler: pack the address into the table slot AND
// increment tbl.count. Re-declared byte-identically to table.vuma.
// No "unregister" in this wave; K11 may add one if needed for runtime
// syscall-table patching / seccomp-style filtering.
fn syscall_register(tbl: State<SyscallTable>, nr: u32, handler: u64) {
    syscall_table_set(tbl, nr, handler);
    tbl.count = tbl.count + 1;
}

// ────────────────────────────────────────────────────────────────────────────
// Dispatch (the R4c surface).
// ────────────────────────────────────────────────────────────────────────────
// syscall_dispatch_from_trap reads the syscall number from canonical
// slot 0, looks up the handler, and writes the return value to canonical
// slot 7. The handler-call is wired through the Wave 5 __call_indirect1
// runtime stub (see the extern block above) — VUMA has no first-class
// fn-ptr type, so indirect dispatch is delegated to the asm trampoline.
//
// The two helpers syscall_set_ret / syscall_get_arg expose the canonical
// slot-7 (return) and slot-(1+idx) (arg) accesses so K11's per-syscall
// handlers can read args / write ret without hardcoding the slot
// numbers everywhere. K11's handler signature will likely be:
//     fn sys_write(tf: State<TrapFrame>) -> u64 {
//         let fd = syscall_get_arg(tf, 0);  // slot 1
//         let buf = syscall_get_arg(tf, 1); // slot 2
//         let count = syscall_get_arg(tf, 2); // slot 3
//         ...
//         syscall_set_ret(tf, bytes_written);
//         return 0;
//     }

// Syscall dispatch from the superset TrapFrame.
//   - nr (slot 0) >= 512    → return 38 (-ENOSYS, out of range)
//   - handler == 0          → return 38 (-ENOSYS, unregistered)
//   - otherwise             → __call_indirect1(handler, tf as Address),
//                             write result to slot 7, return result
// Always writes `result` to canonical slot 7 (tf_set_gpr(tf, 7, result))
// before returning, so the trap_entry stub can blindly reload slot 7
// into the architecture's return register (rax / x0 / a0) on iretq/eret/
// mret — no arch-conditional logic at the trap return path.
fn syscall_dispatch_from_trap(tbl: State<SyscallTable>, tf: State<TrapFrame>) -> u64 {
    let nr = tf_get_gpr(tf, 0);
    if nr >= 512 {
        // Out-of-range: still write the -ENOSYS to slot 7 so the trap
        // return path picks it up uniformly. K11's trap_entry will
        // reload slot 7 into rax/x0/a0 unconditionally.
        tf_set_gpr(tf, 7, 38);
        return 38;
    }
    let handler = syscall_table_get(tbl, nr as u32);
    if handler == 0 {
        tf_set_gpr(tf, 7, 38);
        return 38;
    }
    // Wave 5: invoke the handler via __call_indirect1(handler, tf). The
    // stub tail-calls the function at `handler` with `tf as Address` as
    // its first argument (SysV AMD64 RDI). The handler reads its args
    // from the canonical GPR slots via tf_get_gpr and writes its return
    // value via tf_set_gpr before returning a u64 result code.
    //
    // `tf as Address` is the documented PMT "State-as-address cast for
    // FFI hand-off" pattern (see womb/kernel/README.md §"State-as-address
    // cast") — the State<TrapFrame> is borrowed for the duration of the
    // extern call. The post-call tf_set_gpr(tf, 7, result) is a fresh
    // write that does not depend on the pre-call tf state, so the
    // codegen's conservative State-invalidation-on-extern-call is safe.
    let result = __call_indirect1(handler, tf as Address) as u64;
    tf_set_gpr(tf, 7, result);
    return result;
}

// Write the syscall return value to canonical slot 7. Called by K11's
// per-syscall handlers (sys_write, sys_read, ...) so they don't hardcode
// the slot number. Pure PMT field-write.
fn syscall_set_ret(tf: State<TrapFrame>, ret: u64) {
    tf_set_gpr(tf, 7, ret);
}

// Read syscall argument `arg_idx` (0..5) from canonical slots 1..6.
// K11's per-syscall handlers call this to fetch their arguments:
//   arg_idx=0 → slot 1 (a0)
//   arg_idx=1 → slot 2 (a1)
//   ...
//   arg_idx=5 → slot 6 (a5)
// Pure PMT field-read.
fn syscall_get_arg(tf: State<TrapFrame>, arg_idx: u32) -> u64 {
    return tf_get_gpr(tf, arg_idx + 1);
}

// ────────────────────────────────────────────────────────────────────────────
// Self-test (the R4c DoD).
// ────────────────────────────────────────────────────────────────────────────
// Allocate a SyscallTable and a TrapFrame via state_new, then:
//   (1) Init the TrapFrame (tf_init zeros all fields, including slot 7).
//       Set up a write(1, 4096, 3) syscall:
//         slot 0 (nr)   = 64 (__NR_write)
//         slot 1 (a0/fd) = 1 (stdout)
//         slot 2 (a1/buf) = 4096 (the buffer address — arbitrary)
//         slot 3 (a2/count) = 3 (write 3 bytes)
//       Register a handler for syscall 64 at address 8192.
//       Dispatch: the stub returns 0, AND writes 0 to canonical slot 7.
//       Verify tf_get_gpr(tf, 7) == 0 (the stub wrote the return value
//       to the canonical slot, NOT just returned it from the function).
//   (2) Unregistered syscall (nr=65, no handler registered) → returns
//       38 AND writes 38 to slot 7.
//   (3) Out-of-range nr (nr=999 >= 512) → returns 38 AND writes 38 to
//       slot 7.
// Returns 0 on success, 1..6 on the corresponding check failure (so a
// future CI failure pinpoints the broken check).
//
// Per the contract's "Use decimal constants" rule: all non-zero constants
// in the self-test use DECIMAL (64, 1, 4096, 3, 8192, 65, 999, 38, 0).

fn main() -> i32 {
    let tbl = state_new(SyscallTable);
    let tf = state_new(TrapFrame);
    tf_init(tf);
    // tbl.count starts at 0 (state_new zero-fill).

    // ── Test 1: registered syscall (handler != 0) ─────────────────────────
    // Set up a write(1, 4096, 3) syscall frame.
    tf_set_gpr(tf, 0, 64);   // slot 0 = nr = __NR_write
    tf_set_gpr(tf, 1, 1);    // slot 1 = a0 = fd (stdout)
    tf_set_gpr(tf, 2, 4096); // slot 2 = a1 = buf (arbitrary)
    tf_set_gpr(tf, 3, 3);    // slot 3 = a2 = count (3 bytes)
    // Clear slot 7 to a sentinel so we can prove the dispatcher wrote it.
    tf_set_gpr(tf, 7, 256);
    // Register a handler for syscall 64 at address 8192.
    syscall_register(tbl, 64, 8192);
    let ret = syscall_dispatch_from_trap(tbl, tf);
    if ret != 0 { return 1; }              // stub returned 0
    if tf_get_gpr(tf, 7) != 0 { return 2; } // stub wrote 0 to slot 7

    // ── Test 2: unregistered syscall (nr=65, handler == 0) ───────────────
    tf_set_gpr(tf, 0, 65);
    tf_set_gpr(tf, 7, 256);  // sentinel
    let ret2 = syscall_dispatch_from_trap(tbl, tf);
    if ret2 != 38 { return 3; }              // -ENOSYS returned
    if tf_get_gpr(tf, 7) != 38 { return 4; } // -ENOSYS written to slot 7

    // ── Test 3: out-of-range nr (999 >= 512) ─────────────────────────────
    tf_set_gpr(tf, 0, 999);
    tf_set_gpr(tf, 7, 256);  // sentinel
    let ret3 = syscall_dispatch_from_trap(tbl, tf);
    if ret3 != 38 { return 5; }              // -ENOSYS returned
    if tf_get_gpr(tf, 7) != 38 { return 6; } // -ENOSYS written to slot 7

    return 0;
}
