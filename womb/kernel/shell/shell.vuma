// ═══════════════════════════════════════════════════════════════════════════
// womb/kernel/shell/shell.vuma
// VWK kernel interactive shell — reads commands from the console, parses
// them, executes built-in commands, and prints output. — PMT-pure.
// ═══════════════════════════════════════════════════════════════════════════
//
// This file is the K6f layer of the VWK kernel: the interactive shell. K6a
// (womb/kernel/drivers/uart.vuma) provided the byte-level UART driver
// (uart_putc_8250 / uart_getc_8250 / uart_putc_pl011). K6b (womb/kernel/
// tty/line_discipline.vuma) provided the TTY line discipline (tty_init /
// tty_receive / tty_readline — the cooked-mode line editor). K6c (womb/kernel/
// tty/vt100.vuma) provided the VT100 escape-sequence parser. K6d (womb/kernel/
// drivers/char.vuma) provided the char device registry. K6e (womb/kernel/
// tty/console.vuma) aggregated UART + TTY + VT100 into a single Console
// interface (console_init / console_putc / console_puts / console_flush /
// console_read — a 256-byte line buffer that flushes to UART/hosted-write
// on newline or near-overflow, with a matching read path).
//
// K6f sits ABOVE the console: it's the interactive shell — a tiny read-eval
// loop that accepts commands one byte at a time from the console, parses
// the line on newline, dispatches to a built-in command, and emits output
// back through the console. This file implements the two foundational
// built-ins from the K6f contract:
//   `echo <args>` — print everything after "echo " or "echo" to stdout.
//   `exit`        — terminate the shell (set running=0, exit_code=0).
// The contract's header also names `cat`, `ls`, `pwd`, `cd` as future
// built-ins; K6f implements echo + exit (the self-test DoD); the remaining
// built-ins arrive in K7+ when the K6fs layer (filesystem) is wired in
// (cat / ls need open / read / readdir; pwd / cd need a cwd slot in the
// Shell layout and a chdir syscall).
//
// ── What K6f provides ──────────────────────────────────────────────────────
//   shell_init(s)                 — zero the line buffer length, mark the
//                                   shell as running, exit_code 0.
//   shell_prompt(s)               — write "vwk: " (5 bytes) to stdout.
//   shell_receive(s, c)           — push one byte through the shell: buffer
//                                   it, on newline call shell_execute and
//                                   reset the buffer, on Tab (byte 9)
//                                   call shell_tab_complete (W26S1).
//   shell_execute(s)              — parse the buffered line and dispatch to
//                                   the matching built-in (or print "?\n").
//   shell_match_cmd(s,name,n)     — W25S1 tokenizer: return 1 iff
//                                   buf[0..n] equals the bytes of the
//                                   string-literal `name` AND buf[n] is
//                                   a word boundary (space / newline /
//                                   end-of-buffer). Subsumes the pre-
//                                   W25S1 shell_buf_starts_with helper.
//   shell_do_echo(s)              — implement `echo`: print everything after
//                                   "echo " (or "echo") + a trailing newline.
//   shell_tab_complete(s)         — W26S1: complete the partial command in
//                                   buf[0..buf_len]. Walks the 12 known
//                                   command names; if exactly 1 starts with
//                                   the partial, appends the rest + a space;
//                                   if >1, prints all candidates on a new
//                                   line; if 0, does nothing. Helpers:
//                                   shell_name_has_prefix (prefix check) +
//                                   shell_complete_name (append rest + space).
//
// ── Shell line-buffer geometry ─────────────────────────────────────────────
// The shell's line buffer is a flat [u8; 256] array with one cursor:
//   buf_len (u32) — bytes currently in the buffer (0..256).
// The K6e console's 256-byte line buffer and the K6b TTY's 256-byte ring
// buffer both use 256 as the canonical line size; K6f's shell matches that
// (a 256-byte line is the canonical Unix TTY line length — POSIX LINE_MAX
// is 2048, but the kernel-side line buffer is typically much smaller; 256
// matches the K6e/K6b/K1 buffers).
//
// Bytes are appended at buf[buf_len], then buf_len is bumped. On newline,
// shell_execute parses the buf[0..buf_len] range and resets buf_len to 0.
// The bounds check `buf_len < 255` guards the store: if buf_len is already
// 255, the byte is silently dropped (a 256th byte would overflow the array
// index range [0, 255]). The 255 threshold (not 256) leaves headroom for
// the next append — defensive against off-by-one in the bounds check
// (same pattern as K6e's console_putc, which flushes at len >= 255).
//
// ── Command dispatch (W25S1 — real command tokenizer) ──────────────────────
// shell_execute dispatches via shell_match_cmd — a real tokenizer that
// matches the FULL command name (not just the first byte) AND verifies a
// word boundary at buf[name_len] (space, newline, or end-of-buffer). The
// pre-W25S1 dispatch keyed off the first ASCII byte ('e' matched both
// "echo" and "exit"), causing collisions once more built-ins were added.
// The new dispatch order is:
//   (1) "echo"   (4 bytes) → call shell_do_echo, return.
//   (2) "exit"   (4 bytes) → set running=0, exit_code=0, return.
//   (3) "help"   (4 bytes) → print help text via string literal, return.
//   (4) "ls"     (2 bytes) → list files (K7+ stub: prints "(no files)\n").
//   (5) "cat"    (3 bytes) → show file (K7+ stub: prints "cat: needs K7 fs\n").
//   (6) "pwd"    (3 bytes) → print working directory (stub: prints "/\n").
//   (7) "ver"    (3 bytes) → print version (stub: prints "vuma 0.1\n").
//   (8) "ps"     (2 bytes) → list processes (W25S2 stub: prints a fake
//                              PID/PPID/STATE table — would call task_dump).
//   (9) "memstat" (7 bytes) → print memory stats (W25S2 stub: prints fake
//                              MemTotal/MemFree — would read pmm counters).
//  (10) "clear"   (5 bytes) → emit ESC[2J ESC[H (clear screen + cursor home).
//  (11) "true"    (4 bytes) → set exit_code=0, return (no output).
//  (12) "false"   (5 bytes) → set exit_code=1, return (no output).
//  (13) otherwise          → print "?\n" (unknown command marker).
//
// shell_match_cmd takes the State<Shell> buffer, a `name: Address` (the
// .rodata address of a string literal like "echo"), and a `name_len: u32`.
// It returns 1 iff (a) buf[0..name_len] equals the named command's bytes
// AND (b) buf[name_len] is a space (32), newline (10), or end-of-buffer
// (buf_len == name_len). PMT-pure: we cannot dereference `name` (no
// `*ptr` syntax), so the function compares `name` to the .rodata addresses
// of the known command-name literals — each string literal "echo" / "exit"
// / ... lowers to a compile-time i64 address (Wave 1 .rodata feature), and
// string-literal deduplication guarantees that the same literal text
// produces the same address program-wide (see src/pipeline.rs:8733 — the
// string_table dedups by byte content). When `name` matches a known
// literal, the function compares buf's bytes against the known ASCII
// bytes for that command. The pre-W25S1 shell_buf_starts_with helper is
// removed — shell_match_cmd subsumes both the bounds check and the
// byte-by-byte comparison.
//
// ── shell_do_echo semantics ────────────────────────────────────────────────
// `echo <args>` prints everything after "echo " (5 bytes) or "echo" (4 bytes
// if no space follows) followed by a trailing newline. The argument scan:
//   start at i = 4 (just past "echo")
//   if buf[4] == ' ' (32), advance i to 5 (skip the space)
//   while i < buf_len && out_len < 255: copy buf[i] → out.data[out_len]
//   append '\n' (10) at out.data[out_len], write out_len+1 bytes to stdout.
// The out_len < 255 bound is the same overflow-protection pattern as K6e's
// console_putc — leaves headroom for the trailing newline. If the user
// passes more than 255 bytes of args, the extra bytes are dropped (and the
// newline overwrites out.data[255] — defensive truncation).
//
// `echo` with no args (buf_len == 4, just "echo") produces just "\n" — the
// while loop exits immediately (i=4 not < 4), the newline is stored at
// out.data[0], and write(1, addr, 1) emits "\n". This matches POSIX echo
// semantics (echo with no args prints a blank line).
//
// ── Layouts (Shell + ShellOut) ──────────────────────────────────────────────
// VUMA has no `import` (Open Work §7), so this file re-declares every
// layout it uses. The two layouts are NEW (K6f introduces them — no prior
// wave declares Shell or ShellOut):
//
//   Shell (264 bytes total, padded to 272 for u32 alignment of buf_len):
//     buf       @ 0    [u8; 256]  — the input line buffer (256 bytes).
//                                    Indexed [0..buf_len) during parsing;
//                                    bytes beyond buf_len are stale
//                                    (uninitialized — see "PMT discipline"
//                                    below). `s as Address` yields the
//                                    address of buf[0] (offset 0) — but
//                                    K6f doesn't use that cast on Shell
//                                    (the line buffer is read byte-by-byte,
//                                    not handed to write as a whole).
//     buf_len   @ 256  u32        — bytes currently in buf (0..256).
//     running   @ 260  u8         — 1 = shell is running, 0 = exit requested.
//     exit_code @ 261  i32        — exit code (set by `exit N` — K6f only
//                                    sets 0 from `exit`, K7+ will parse
//                                    the optional numeric argument).
//   (Plus 7 bytes of trailing padding to align the struct to 4 bytes — the
//   VUMA layout pads to the largest field's alignment, which is 4 bytes
//   for the u32 buf_len field. The u8 running field and the i32 exit_code
//   field pack tight at offsets 260 / 261 — wait, i32 needs 4-byte
//   alignment, so exit_code goes at offset 264 with 3 bytes of pad after
//   running. Total: 256 + 4 + 1 + 3 (pad) + 4 = 268, then padded to 4-byte
//   alignment = 268. The exact layout padding doesn't matter for K6f
//   because we access fields by name, never by hand-computed offset.)
//
//   ShellOut (256 bytes total):
//     data      @ 0    [u8; 256]  — output buffer for the shell's write
//                                    calls. Used by shell_prompt (5-byte
//                                    "vwk: " prefix), shell_execute (1-byte
//                                    newline + 2-byte "?\n" error marker),
//                                    and shell_do_echo (up to 256 bytes of
//                                    "echo" output + trailing newline). The
//                                    triple-use is intentional: all three
//                                    need a 256-byte buffer with `data` at
//                                    offset 0 (so the `as Address` cast
//                                    yields the address of data[0] for the
//                                    FFI call), and VUMA layouts are
//                                    byte-size contracts — same layout,
//                                    same size, same alignment, so one
//                                    layout name covers all three uses.
//                                    (Same pattern as K6e's ConsoleStr.)
//
// ── PMT discipline ─────────────────────────────────────────────────────────
// NO `*ptr`, `&x`, `allocate`, or `free` anywhere in this file. Shell +
// ShellOut are flat-byte-array structs held in `___pmt_buffer`-backed
// State<T> slots; the CALLER allocates them via `state_new(Shell)` /
// `state_new(ShellOut)` (in the self-test, in main(); in the real kernel,
// in kmain). The State<T> handles are passed by reference to shell_init /
// shell_receive / shell_execute / etc., which mutate the State in place
// (no copy-out, no move semantics — VUMA's State<T> is a borrow of the
// ___pmt_buffer slot). The `s.buf[s.buf_len] = c; s.buf_len = s.buf_len
// + 1;` syntax is State-field self-update (lowered to a load-modify-store
// through the State pointer — the K4a task.vuma `tbl.count = tbl.count +
// 1` pattern, also seen in K6b's tty_push, K6e's console_putc).
//
// The `out as Address` cast on State<ShellOut> is the documented PMT
// "Borrowed read (zero-copy I/O)" pattern (see docs/language-reference.md
// §14.5) — same as K6a's `buf as Address` in uart_putc_8250, K6e's
// `out as Address` in console_flush, K1's `c as Address` in console_flush.
// The Address is borrowed (the State<T> stays live in ___pmt_buffer for
// the duration of the call), handed to `write` (a syscall that completes
// synchronously), then the ShellOut is freed by the drop-frame hook when
// the function returns.
//
// ── Decimal-constants discipline ────────────────────────────────────────────
// All non-zero constants in this file use DECIMAL per the K5a contract's
// "Use decimal constants" rule (carried forward through K5b/K5c/K5d/K5e/
// K5f/K6a/K6b/K6c/K6d/K6e). Decimal avoids the parser's hex-literal path
// (parse_int_radix width-extension subtleties — see K5a's file.vuma header
// for the same rationale). The constants:
//   256   = Shell.buf / ShellOut.data size (array bound).
//   255   = overflow-protection threshold (buf_len < 255 → append; out_len
//           < 255 → copy — leaves headroom for the trailing newline).
//   5     = "vwk: " prompt length (5 bytes: 'v','w','k',':',' ').
//   4     = "echo" / "exit" command-name length (4 bytes).
//   1     = stdout fd (write) / byte count for the newline + "?\n" writes.
//   2     = "?\n" unknown-command marker length (2 bytes: '?','\n').
//   0     = buf_len / running / exit_code reset value / first array index.
// ASCII test characters (K6f contract's IMPORTANT note — decimal values,
// NOT char literals — VUMA has no 'e' / 'c' / 'h' / 'o' / 'x' / 'i' /
// 't' / '?' / ' ' / '\n' char literals; use the decimal ASCII values):
//   101   = 'e'    99    = 'c'    104   = 'h'    111   = 'o'
//   120   = 'x'    105   = 'i'    116   = 't'
//   118   = 'v'    119   = 'w'    107   = 'k'    58    = ':'
//   32    = ' '    10    = '\n'   63    = '?'
//
// ── VUMA has no `import` ────────────────────────────────────────────────────
// This file is self-contained. It declares Shell + ShellOut (both new).
// K6f's only I/O is via State<Shell> / State<ShellOut> + the `write`
// extern (declared here, resolves to sys_write on x86_64 / aarch64 hosted
// backends — same as K6a/K6e's `write`). The `exit` extern is declared
// for parity with womb/kernel/kernel.vuma's extern block (which also
// declares both `write` and `exit`), but K6f doesn't call `exit` from
// VUMA source — the shell's `exit` command just sets `s.running = 0` and
// lets the host's main() return naturally. (A future K7+ wave that
// implements the shell's main loop in VUMA — instead of in main() — will
// call the `exit` extern when running transitions to 0.)
//
// ── Externs (write + exit) ──────────────────────────────────────────────────
// Two extern declarations, both in one `extern "C"` block. Same declaration
// as womb/kernel/kernel.vuma (for `write` + `exit`) and K6a/K6e's uart.vuma
// / console.vuma (for `write`). The `buf: Address` (NOT State<T>) on write
// means the FFI marshal does NOT invalidate any state on the call — the
// Address is just a raw u64 pointer handed to the syscall. This is the
// documented PMT "Borrowed read" pattern.
//
// Hosted mode: `write` resolves to sys_write (nr 1 on x86_64, nr 64 on
// aarch64); `exit` resolves to sys_exit (nr 60 on x86_64, nr 93 on
// aarch64). SysV AMD64: RDI=fd, RSI=buf, RDX=count for write; RDI=code
// for exit.
//
// Bare-metal mode (K11): the externs stay byte-identical (same signature,
// same arg types, same order) but the linker resolves them to MMIO
// trampolines that call uart_putc_8250 (or the PL011 equivalent) under
// the hood. K6f's source doesn't change between hosted and bare-metal —
// only the linker resolution does.
//
// ── Build & verify (hosted x86_64) ──────────────────────────────────────────
//     . "$HOME/.cargo/env" && CARGO_BUILD_JOBS=4 \
//         cargo build --profile release-fast --bin compile_dump
//     ./target/release-fast/compile_dump \
//         womb/kernel/shell/shell.vuma \
//         /tmp/shell.bin x86_64 --verify
//     /tmp/shell.bin ; echo "exit=$?"
// Expected: IVE Pass, exit=0. The self-test runs 4 sub-tests (echo,
// tab-single, tab-multi, exit) and asserts:
//   (1) After "echo hello\n", s.running == 1 (shell still running).
//   (1.5) After "ec"+Tab, s.buf_len == 5 and buf == "echo " (W26S1).
//   (1.6) After "e"+Tab, s.buf_len == 1 and buf == "e" (W26S1 multi).
//   (2) After "exit\n", s.running == 0 (shell exited).

// ────────────────────────────────────────────────────────────────────────────
// Extern "C" trampolines.
// ────────────────────────────────────────────────────────────────────────────
// Hosted-mode I/O (uses the pre-registered `write` extern — resolves to
// sys_write on x86_64 / aarch64 hosted backends). Same declaration as
// womb/kernel/kernel.vuma (K1, for `write` + `exit`), K6a's uart.vuma
// (for `write`), K6e's console.vuma (for `write`). `buf: Address` (NOT
// State<T>) means the marshal does NOT invalidate any state on the call —
// the Address is just a raw u64 pointer handed to the syscall. This is
// the documented PMT "Borrowed read" pattern.
//
// `exit` is declared for parity with kernel.vuma but K6f's VUMA source
// never calls it — the shell's `exit` command just sets s.running = 0
// and the host's main() returns naturally. K7+ may call exit() when the
// shell loop moves into VUMA.
extern "C" {
    fn write(fd: i64, buf: Address, count: i64) -> i64;
    fn exit(code: i64);
}

// ────────────────────────────────────────────────────────────────────────────
// Layouts.
// ────────────────────────────────────────────────────────────────────────────

// Shell: the per-shell state. buf at offset 0 + buf_len at offset 256 +
// running at offset 260 + exit_code at offset 261 (with padding to 264
// for i32 alignment). See the file header for the byte-offset map and
// the rationale for the field order (buf first — the natural array layout,
// matches K6e's Console and K1's stub Console; buf_len / running /
// exit_code are scalar metadata trailing the array).
layout Shell = {
    buf: [u8; 256],     // offset 0:   input line buffer (256 bytes)
    buf_len: u32,       // offset 256: bytes currently in buf (0..256)
    running: u8,        // offset 260: 1 = running, 0 = exit requested
    exit_code: i32,     // offset 264: exit code (from `exit N`)
}

// ShellOut: a 256-byte buffer used by shell_prompt (5-byte "vwk: " prefix),
// shell_execute (1-byte newline + 2-byte "?\n" error marker), and
// shell_do_echo (up to 256 bytes of "echo" output + trailing newline).
// The triple-use is intentional: all three need a 256-byte buffer with
// `data` at offset 0 (so the `as Address` cast yields the address of
// data[0] for the FFI call). VUMA layouts are byte-size contracts —
// same layout, same size, same alignment, so one layout name covers
// all three uses. (Same pattern as K6e's ConsoleStr.)
layout ShellOut = { data: [u8; 256] }

// ────────────────────────────────────────────────────────────────────────────
// Shell subsystem functions.
// ────────────────────────────────────────────────────────────────────────────

// Initialize the Shell state. Zeros the line-buffer length, marks the
// shell as running, and sets exit_code to 0. Does NOT zero the buffer
// itself — `s.buf_len == 0` already guarantees no byte will be read from
// it, so the stale contents are unreachable (the next shell_receive will
// overwrite them in order). A defensive zeroing pass would be 256 byte-
// stores for no observable benefit; skipped (same rationale as K6e's
// console_init, K6b's tty_init, K5a's file_init, K4a's pt_init).
fn shell_init(s: State<Shell>) {
    s.buf_len = 0;
    s.running = 1;
    s.exit_code = 0;
}

// Print a prompt to stdout. Writes the 5-byte "vwk: " prefix (decimal
// ASCII: v=118, w=119, k=107, :=58, space=32) to a fresh ShellOut and
// hands its address to write(1, addr, 5). The prompt is intentionally
// short (5 bytes vs. the typical "$ " or "user@host:cwd$ " — 2 to 30+
// bytes) because K6f doesn't yet track a CWD (K7+ will add `cwd: [u8; 64]`
// to the Shell layout and render it into the prompt between "vwk:" and
// the trailing space — K6f's prompt format is the prefix that future
// waves will extend).
//
// The `out as Address` cast gives the address of out.data (at offset 0
// of ShellOut) — the natural argument for write(1, addr, 5). Same PMT
// "Borrowed read" pattern as K6e's console_flush, K6a's uart_putc_8250.
fn shell_prompt(s: State<Shell>) {
    // W25S1: use a Wave 1 string literal ("vwk: ") instead of assembling
    // the 5 bytes byte-by-byte into a fresh ShellOut. The literal lowers
    // to a .rodata address (see src/pipeline.rs:8733 — Lit::String →
    // ScgExpr::Int(rodata_vaddr + offset)), and `write` takes the Address
    // directly (same PMT "Borrowed read" pattern as the old `out as
    // Address` cast, but zero-copy from .rodata instead of from
    // ___pmt_buffer). The `s` parameter is kept for API symmetry with
    // shell_receive / shell_execute (callers always pass the Shell state).
    write(1, "vwk: ", 5);
}

// Receive a byte from the console. Buffer it; on newline, parse and
// execute the command, then reset the buffer. On Tab (byte 9, W26S1),
// attempt tab completion instead of buffering the Tab byte.
//
// The newline (LF, byte 10) is the line terminator: it does NOT get
// stored in the buffer (the `if c == 10` check fires BEFORE the store).
// This matches POSIX cooked-mode TTY semantics — the newline is the
// "commit" signal, not part of the line content. (Same pattern as K6b's
// tty_readline, which pops the LF but doesn't copy it to the output
// buffer.)
//
// The Tab (HT, byte 9) is the completion trigger (W26S1): it does NOT
// get stored in the buffer (the `if c == 9` check fires BEFORE the
// store). Instead, shell_tab_complete is called, which either appends
// the remainder of the unique matching command name + a space (1 match),
// or prints all candidates on a new line (>1 matches), or does nothing
// (0 matches). The Tab byte itself never enters the line buffer — same
// "control byte is a signal, not content" philosophy as the newline.
//
// The bounds check `s.buf_len < 255` guards the store: if buf_len is
// already 255, the byte is silently dropped (a 256th byte would overflow
// the array index range [0, 255]). The 255 threshold (not 256) leaves
// headroom for the next append — defensive against off-by-one (same
// pattern as K6e's console_putc, which flushes at len >= 255).
//
// After shell_execute returns, buf_len is reset to 0 so the next byte
// starts a fresh line. (The reset happens here, not inside
// shell_execute, so shell_execute can read buf[0..buf_len] without
// worrying about the buffer being clobbered mid-execution.)
fn shell_receive(s: State<Shell>, c: u8) {
    if c == 10 {
        // Newline — execute the command.
        shell_execute(s);
        s.buf_len = 0;
        return;
    }
    if c == 9 {
        // Tab (W26S1) — attempt tab completion instead of buffering.
        shell_tab_complete(s);
        return;
    }
    if s.buf_len < 255 {
        s.buf[s.buf_len] = c;
        s.buf_len = s.buf_len + 1;
    }
}

// Parse and execute the command in the buffer. Emits a leading newline
// (to terminate the prompt line on the terminal — the user's input was
// echoed by the TTY layer, so this newline ends the input line and
// starts the output line), then dispatches to the matching built-in via
// shell_match_cmd.
//
// W25S1 dispatch order (see the file header's "Command dispatch" note):
//   (1) "echo"   (4 bytes) → call shell_do_echo, return.
//   (2) "exit"   (4 bytes) → set running=0, exit_code=0, return.
//   (3) "help"   (4 bytes) → call shell_do_help, return.
//   (4) "ls"     (2 bytes) → call shell_do_ls, return.
//   (5) "cat"    (3 bytes) → call shell_do_cat, return.
//   (6) "pwd"    (3 bytes) → call shell_do_pwd, return.
//   (7) "ver"    (3 bytes) → call shell_do_ver, return.
//   (8) "ps"     (2 bytes) → call shell_do_ps, return.
//   (9) "memstat" (7 bytes) → call shell_do_memstat, return.
//  (10) "clear"   (5 bytes) → call shell_do_clear, return.
//  (11) "true"    (4 bytes) → call shell_do_true, return.
//  (12) "false"   (5 bytes) → call shell_do_false, return.
//  (13) otherwise          → print "?\n" (unknown command marker).
//
// Each shell_match_cmd call passes a Wave 1 string literal ("echo",
// "exit", ...) which the compiler lowers to a .rodata address. The
// tokenizer compares buf's bytes against the named command's bytes AND
// verifies a word boundary at buf[name_len] — so "echofoo" no longer
// matches "echo" (the pre-W25S1 first-byte dispatch would have wrongly
// dispatched it to shell_do_echo). The leading newline is emitted
// unconditionally (matches typical shell UX — pressing Enter after
// `exit` moves the cursor to the next line before the shell terminates).
fn shell_execute(s: State<Shell>) {
    // Echo a newline first — terminates the user's input line on the
    // terminal. W25S1: uses a Wave 1 string literal ("\n") instead of
    // a fresh ShellOut + byte store. The literal is a single-byte
    // .rodata entry; `write` takes its Address directly.
    write(1, "\n", 1);

    // Full command-name dispatch via shell_match_cmd. Each branch passes
    // the command-name string literal + its byte length; the tokenizer
    // returns 1 only if buf[0..name_len] matches the named command AND
    // buf[name_len] is a word boundary (space / newline / end-of-buffer).
    if shell_match_cmd(s, "echo", 4) == 1 {
        shell_do_echo(s);
        return;
    }
    if shell_match_cmd(s, "exit", 4) == 1 {
        s.running = 0;
        s.exit_code = 0;
        return;
    }
    if shell_match_cmd(s, "help", 4) == 1 {
        shell_do_help(s);
        return;
    }
    if shell_match_cmd(s, "ls", 2) == 1 {
        shell_do_ls(s);
        return;
    }
    if shell_match_cmd(s, "cat", 3) == 1 {
        shell_do_cat(s);
        return;
    }
    if shell_match_cmd(s, "pwd", 3) == 1 {
        shell_do_pwd(s);
        return;
    }
    if shell_match_cmd(s, "ver", 3) == 1 {
        shell_do_ver(s);
        return;
    }
    // W25S2: five new built-ins (ps / memstat / clear / true / false).
    if shell_match_cmd(s, "ps", 2) == 1 {
        shell_do_ps(s);
        return;
    }
    if shell_match_cmd(s, "memstat", 7) == 1 {
        shell_do_memstat(s);
        return;
    }
    if shell_match_cmd(s, "clear", 5) == 1 {
        shell_do_clear(s);
        return;
    }
    if shell_match_cmd(s, "true", 4) == 1 {
        shell_do_true(s);
        return;
    }
    if shell_match_cmd(s, "false", 5) == 1 {
        shell_do_false(s);
        return;
    }

    // Unknown command — print "?\n" (the Unix-shell "command not found"
    // marker, simplified to just "?" for K6f's minimal UX; K7+ may add
    // "command not found: <name>" with the actual command name). W25S1:
    // uses a Wave 1 string literal instead of a fresh ShellOut.
    write(1, "?\n", 2);
}

// ────────────────────────────────────────────────────────────────────────────
// W25S1: Real command tokenizer.
// ────────────────────────────────────────────────────────────────────────────
// shell_match_cmd(buf, name, name_len) → u8:
//   Returns 1 iff (a) buf[0..name_len] equals the bytes of the named
//   command AND (b) buf[name_len] is a word boundary (space=32,
//   newline=10, or end-of-buffer when buf_len == name_len).
//
// PMT-pure implementation: we cannot dereference `name` (no `*ptr`
// syntax). Instead, we compare `name` to the .rodata addresses of the
// known command-name literals — each string literal "echo" / "exit" /
// "help" / "ls" / "cat" / "pwd" / "ver" / "ps" / "memstat" / "clear" /
// "true" / "false" lowers to a compile-time i64
// address (Wave 1 .rodata feature, see src/pipeline.rs:8733), and
// string-literal deduplication guarantees that two occurrences of the
// same literal text produce the SAME address program-wide. So `name ==
// "echo"` is a compile-time-resolvable equality between two i64
// constants when `name` was passed as the literal "echo".
//
// Once we've identified which command `name` refers to, we compare
// buf's bytes against the known ASCII bytes for that command. The
// ASCII bytes are inlined as decimal constants (per the file's
// "Decimal-constants discipline" rule — VUMA has no char literals).
//
// Word-boundary check (the SECOND half of the tokenizer): after
// matching buf[0..name_len], we verify buf[name_len] is a word
// boundary. This is what disambiguates "echo" from "echofoo" — the
// pre-W25S1 first-byte dispatch would have routed both to shell_do_echo
// (and shell_do_echo would have printed "foo" as args for "echofoo",
// since it starts copying at i=4 unconditionally). With the new
// tokenizer, "echofoo" fails the word-boundary check (buf[4]='f' is
// neither 32 nor 10), shell_match_cmd returns 0, and shell_execute
// falls through to the "?\n" unknown-command marker.
//
// Returns u8 (not bool — VUMA has no bool type; K6d/K6e use u8 for
// boolean flags throughout — K6e's `running` field is u8, K6d's
// chardev-registry slot-validity flag is u8).
//
// The pre-W25S1 shell_buf_starts_with helper is removed — shell_match_cmd
// subsumes both the bounds check and the byte-by-byte comparison.
fn shell_match_cmd(buf: State<Shell>, name: Address, name_len: u32) -> u8 {
    // (a) Word-boundary check at buf[name_len].
    // If buf_len < name_len, the input is shorter than the command name —
    // no match (e.g. "ec" against "echo").
    if buf.buf_len < name_len {
        return 0;
    }
    // If buf_len > name_len, the byte at buf[name_len] must be a space
    // (32) or a newline (10). The newline case is defensive — the TTY
    // line discipline pops the LF before shell_receive sees it, so the
    // buffer never actually contains a newline; but if a future caller
    // hands shell_execute a buffer with an embedded newline (e.g. a
    // pasted multi-line paste), the word-boundary check still works.
    if buf.buf_len > name_len {
        let b = buf.buf[name_len];
        if b != 32 && b != 10 {
            return 0;
        }
    }
    // If buf_len == name_len, there's no byte at buf[name_len] to check
    // — the end-of-buffer IS the word boundary. Fall through to the
    // byte comparison.

    // (b) Compare buf[0..name_len] against the bytes of `name`.
    // PMT-pure: dispatch on the .rodata address of `name` (a string
    // literal lowered to a compile-time i64). When `name` matches a
    // known literal, compare buf's bytes against the known ASCII bytes
    // for that command. The ASCII bytes are inlined as decimal constants.
    if name == "echo" {
        // "echo" — e=101, c=99, h=104, o=111.
        if name_len != 4 { return 0; }
        if buf.buf[0] != 101 { return 0; }  // 'e'
        if buf.buf[1] != 99  { return 0; }  // 'c'
        if buf.buf[2] != 104 { return 0; }  // 'h'
        if buf.buf[3] != 111 { return 0; }  // 'o'
        return 1;
    }
    if name == "exit" {
        // "exit" — e=101, x=120, i=105, t=116.
        if name_len != 4 { return 0; }
        if buf.buf[0] != 101 { return 0; }  // 'e'
        if buf.buf[1] != 120 { return 0; }  // 'x'
        if buf.buf[2] != 105 { return 0; }  // 'i'
        if buf.buf[3] != 116 { return 0; }  // 't'
        return 1;
    }
    if name == "help" {
        // "help" — h=104, e=101, l=108, p=112.
        if name_len != 4 { return 0; }
        if buf.buf[0] != 104 { return 0; }  // 'h'
        if buf.buf[1] != 101 { return 0; }  // 'e'
        if buf.buf[2] != 108 { return 0; }  // 'l'
        if buf.buf[3] != 112 { return 0; }  // 'p'
        return 1;
    }
    if name == "ls" {
        // "ls" — l=108, s=115.
        if name_len != 2 { return 0; }
        if buf.buf[0] != 108 { return 0; }  // 'l'
        if buf.buf[1] != 115 { return 0; }  // 's'
        return 1;
    }
    if name == "cat" {
        // "cat" — c=99, a=97, t=116.
        if name_len != 3 { return 0; }
        if buf.buf[0] != 99  { return 0; }  // 'c'
        if buf.buf[1] != 97  { return 0; }  // 'a'
        if buf.buf[2] != 116 { return 0; }  // 't'
        return 1;
    }
    if name == "pwd" {
        // "pwd" — p=112, w=119, d=100.
        if name_len != 3 { return 0; }
        if buf.buf[0] != 112 { return 0; }  // 'p'
        if buf.buf[1] != 119 { return 0; }  // 'w'
        if buf.buf[2] != 100 { return 0; }  // 'd'
        return 1;
    }
    if name == "ver" {
        // "ver" — v=118, e=101, r=114.
        if name_len != 3 { return 0; }
        if buf.buf[0] != 118 { return 0; }  // 'v'
        if buf.buf[1] != 101 { return 0; }  // 'e'
        if buf.buf[2] != 114 { return 0; }  // 'r'
        return 1;
    }
    // W25S2: five new command-name matchers (ps / memstat / clear /
    // true / false). Each follows the same pattern: verify name_len,
    // then compare buf[0..name_len] byte-by-byte against the decimal
    // ASCII values for that command.
    if name == "ps" {
        // "ps" — p=112, s=115.
        if name_len != 2 { return 0; }
        if buf.buf[0] != 112 { return 0; }  // 'p'
        if buf.buf[1] != 115 { return 0; }  // 's'
        return 1;
    }
    if name == "memstat" {
        // "memstat" — m=109, e=101, m=109, s=115, t=116, a=97, t=116.
        if name_len != 7 { return 0; }
        if buf.buf[0] != 109 { return 0; }  // 'm'
        if buf.buf[1] != 101 { return 0; }  // 'e'
        if buf.buf[2] != 109 { return 0; }  // 'm'
        if buf.buf[3] != 115 { return 0; }  // 's'
        if buf.buf[4] != 116 { return 0; }  // 't'
        if buf.buf[5] != 97  { return 0; }  // 'a'
        if buf.buf[6] != 116 { return 0; }  // 't'
        return 1;
    }
    if name == "clear" {
        // "clear" — c=99, l=108, e=101, a=97, r=114.
        if name_len != 5 { return 0; }
        if buf.buf[0] != 99  { return 0; }  // 'c'
        if buf.buf[1] != 108 { return 0; }  // 'l'
        if buf.buf[2] != 101 { return 0; }  // 'e'
        if buf.buf[3] != 97  { return 0; }  // 'a'
        if buf.buf[4] != 114 { return 0; }  // 'r'
        return 1;
    }
    if name == "true" {
        // "true" — t=116, r=114, u=117, e=101.
        if name_len != 4 { return 0; }
        if buf.buf[0] != 116 { return 0; }  // 't'
        if buf.buf[1] != 114 { return 0; }  // 'r'
        if buf.buf[2] != 117 { return 0; }  // 'u'
        if buf.buf[3] != 101 { return 0; }  // 'e'
        return 1;
    }
    if name == "false" {
        // "false" — f=102, a=97, l=108, s=115, e=101.
        if name_len != 5 { return 0; }
        if buf.buf[0] != 102 { return 0; }  // 'f'
        if buf.buf[1] != 97  { return 0; }  // 'a'
        if buf.buf[2] != 108 { return 0; }  // 'l'
        if buf.buf[3] != 115 { return 0; }  // 's'
        if buf.buf[4] != 101 { return 0; }  // 'e'
        return 1;
    }
    // `name` doesn't match any known command literal — no match.
    return 0;
}

// Execute the "echo" command — print everything after "echo " (5 bytes)
// or "echo" (4 bytes), followed by a trailing newline.
//
// Argument scan:
//   start at i = 4 (just past "echo")
//   if buf[4] == ' ' (32), advance i to 5 (skip the space)
//   while i < buf_len && out_len < 255: copy buf[i] → out.data[out_len]
//   append '\n' (10) at out.data[out_len]
//   write(1, addr, out_len + 1) — emit args + trailing newline.
//
// The `out_len < 255` bound is overflow protection: leaves headroom for
// the trailing newline at out.data[out_len] (out_len can reach 255 in
// the loop, then the newline overwrites out.data[255] — the 256th byte
// of the 256-byte buffer, which is the last valid index). Same K6e
// console_putc pattern (flush at len >= 255).
//
// `echo` with no args (buf_len == 4): i=4, buf[4] is stale (buf_len ==
// 4 means buf[4] is past the end — but reading it is safe in VUMA
// because the buffer is a fixed 256-byte array; the value is just
// garbage). If the stale byte happens to be 32 (' '), i would advance
// to 5 and the while loop wouldn't fire (5 < 4 is false); otherwise i
// stays at 4 and the while loop wouldn't fire (4 < 4 is false). Either
// way, no args are copied, the newline goes at out.data[0], and write
// emits "\n". Matches POSIX echo (echo with no args prints a blank
// line).
//
// The `out as Address` cast gives the address of out.data (at offset 0
// of ShellOut) — same PMT "Borrowed read" pattern as shell_prompt,
// shell_execute, K6e's console_flush, K6a's uart_putc_8250.
fn shell_do_echo(s: State<Shell>) {
    // Skip "echo " (5 bytes) or "echo" (4 bytes). Start at i = 4 (just
    // past "echo"); if buf[4] is a space, advance to 5 (skip the space).
    // W25S1 note: shell_match_cmd has already verified buf[4] is a word
    // boundary (space / newline / end-of-buffer) before calling
    // shell_do_echo, so the `s.buf[4] == 32` check is well-defined:
    //   - buf_len == 4 (bare "echo"): s.buf[4] is stale but unreachable
    //     in the while loop (i=4 not < 4) → prints just "\n".
    //   - buf_len > 4 and s.buf[4] == 32: skip the space, copy from i=5.
    //   - buf_len > 4 and s.buf[4] == 10 (embedded newline, defensive):
    //     i stays at 4, the while loop reads from buf[4] onward.
    let out = state_new(ShellOut);
    let out_len = 0;
    let i = 4;
    if s.buf[4] == 32 {  // ' '
        i = 5;
    }
    while i < s.buf_len && out_len < 255 {
        out.data[out_len] = s.buf[i];
        out_len = out_len + 1;
        i = i + 1;
    }
    out.data[out_len] = 10;  // '\n'
    write(1, out as Address, (out_len + 1) as i64);
}

// ────────────────────────────────────────────────────────────────────────────
// W25S1: New built-in command stubs (help / ls / cat / pwd / ver).
// ────────────────────────────────────────────────────────────────────────────
// Each stub prints a fixed string via a Wave 1 string literal. The
// string-literal .rodata address is passed directly to `write` as the
// `buf: Address` argument — same PMT "Borrowed read" pattern as the
// pre-W25S1 `out as Address` cast, but zero-copy from .rodata instead
// of from ___pmt_buffer.
//
// K7+ will replace these stubs with real implementations once the K6fs
// filesystem layer is wired in (cat / ls need open / read / readdir;
// pwd / cd need a cwd slot in the Shell layout and a chdir syscall —
// see the file header's "What K6f provides" note). For now the stubs
// exist so that shell_match_cmd's full-name dispatch has somewhere to
// route the new commands (otherwise "help" / "ls" / "cat" / "pwd" /
// "ver" would all fall through to the "?\n" unknown-command marker).

// `help` — print a one-line summary of available commands.
// K7+ will extend this to a per-command help (`help echo` → echo docs).
fn shell_do_help(s: State<Shell>) {
    write(1, "cmds: echo exit help ls cat pwd ver ps memstat clear true false\n", 64);
}

// `ls` — list files in the current directory.
// K7+ stub: no filesystem yet, so print "(no files)\n". K7+ will
// replace this with a readdir loop over the cwd once K6fs is wired in.
fn shell_do_ls(s: State<Shell>) {
    write(1, "(no files)\n", 11);
}

// `cat <file>` — show the contents of a file.
// K7+ stub: no filesystem yet, so print a "needs K7 fs" notice. K7+
// will parse the filename argument (everything after "cat ") and call
// sys_open / sys_read / sys_write to dump the file's contents.
fn shell_do_cat(s: State<Shell>) {
    write(1, "cat: needs K7 fs\n", 17);
}

// `pwd` — print the working directory.
// K7+ stub: print "/\n" (the root). K7+ will replace this with a read
// of the Shell.cwd field once that field is added to the Shell layout
// (currently Shell has no cwd slot — see the file header's "Layouts"
// note).
fn shell_do_pwd(s: State<Shell>) {
    write(1, "/\n", 2);
}

// `ver` — print the shell / kernel version.
// K7+ stub: print "vuma 0.1\n". K7+ will replace this with a read of
// the build-time VERSION constant once the build system exports one.
fn shell_do_ver(s: State<Shell>) {
    write(1, "vuma 0.1\n", 9);
}

// ────────────────────────────────────────────────────────────────────────────
// W25S2: Five more built-in command stubs (ps / memstat / clear / true /
// false).
// ────────────────────────────────────────────────────────────────────────────
// Each new built-in follows the same PMT discipline as the W25S1 stubs:
// output text is a Wave 1 string literal lowered to a .rodata address,
// passed directly to `write` as the `buf: Address` argument (zero-copy
// from .rodata — same "Borrowed read" pattern as shell_do_help /
// shell_do_ls / shell_do_cat / shell_do_pwd / shell_do_ver). The `true`
// and `false` built-ins produce NO output — they only mutate s.exit_code
// (the shell's exit-status slot), mirroring the POSIX `true` / `false`
// builtins used for shell conditionals and loop guards.
//
// `ps` and `memstat` are K7+ stubs (they print fixed fake data; K7+ will
// replace them with real scheduler / pmm reads once those subsystems are
// wired into the shell's view). `clear`, `true`, and `false` are NOT
// stubs — their implementations are complete (the VT100 escape sequence
// IS the entire side-effect for `clear`; setting exit_code IS the entire
// side-effect for `true` / `false`).

// `ps` — list processes.
// Prints a fixed fake process table: a "PID  PPID  STATE" header followed
// by one "1   0     READY" row (the kernel's init task, PID 1, PPID 0,
// state READY). K7+ will replace this with a call to task_dump (K4a)
// once the scheduler exposes a process-list iterator. Two write calls —
// one per line — so each line is a distinct semantic unit (header vs.
// data row), matching how the task spec frames the output ("header" +
// "row"). Both strings are Wave 1 literals.
fn shell_do_ps(s: State<Shell>) {
    write(1, "PID  PPID  STATE\n", 17);
    write(1, "1   0     READY\n", 16);
}

// `memstat` — print memory usage.
// Prints a fixed fake /proc/meminfo-style two-line summary: MemTotal
// 16384 kB + MemFree 8192 kB (50% free). K7+ will replace this with a
// read of the pmm's free_pages / total_pages counters once K3p (the PMM
// stats API) is wired in. One write call with the combined 36-byte
// string (both lines in a single literal) — matches the task spec, which
// frames the output as one string with an embedded newline.
fn shell_do_memstat(s: State<Shell>) {
    write(1, "MemTotal: 16384 kB\nMemFree: 8192 kB\n", 36);
}

// `clear` — clear the screen and home the cursor.
// Emits the VT100 "erase entire display" (ESC[2J) + "cursor home" (ESC[H)
// sequence — 7 bytes total: ESC(27) [(91) 2(50) J(74) ESC(27) [(91) H(72).
// The 7-byte sequence is a single Wave 1 string literal; the lexer's
// `\x1b` hex escape produces ESC (byte 27), and the rest is literal
// ASCII. Same `write(1, "\x1b...", n)` pattern as console.vuma's
// console_set_bold / console_reset_color (W23S5). This is the REAL
// implementation — the escape sequence is the entire side-effect (no
// K7+ replacement needed). On a terminal that doesn't understand VT100
// escapes, the bytes are emitted as-is (no fallback — K6f assumes a
// VT100-class terminal, same as K6c's vt100.vuma parser).
fn shell_do_clear(s: State<Shell>) {
    write(1, "\x1b[2J\x1b[H", 7);
}

// `true` — exit-status success.
// Sets s.exit_code=0 and returns without output. Mirrors the POSIX
// `true` / `:` builtin — useful for `while true; do ...; done` loops
// once the shell gains a loop construct (K8+). Does NOT set running=0
// (the shell keeps running; only `exit` terminates the loop). This is
// the REAL implementation — setting exit_code IS the entire side-effect.
fn shell_do_true(s: State<Shell>) {
    s.exit_code = 0;
}

// `false` — exit-status failure.
// Sets s.exit_code=1 and returns without output. Mirrors the POSIX
// `false` builtin. Pairs with `true` for shell conditionals (e.g.
// `if false; then ...; fi` once the shell gains an `if` construct).
// Does NOT set running=0. This is the REAL implementation.
fn shell_do_false(s: State<Shell>) {
    s.exit_code = 1;
}

// ────────────────────────────────────────────────────────────────────────────
// W26S1: Tab completion.
// ────────────────────────────────────────────────────────────────────────────
// When the user presses Tab (byte 9), shell_receive calls shell_tab_complete
// instead of buffering the byte. The completer walks the 12 known command
// names ("echo", "exit", "help", "ls", "cat", "pwd", "ver", "ps", "memstat",
// "clear", "true", "false") and checks, for each, whether the command name
// STARTS WITH the current partial input (buf[0..buf_len]).
//
//   • Exactly 1 match  → append the rest of the name + a space to the buffer.
//     E.g. buf="ec" + Tab → buf="echo " (appends "ho "). The trailing space
//     positions the cursor for the first argument, matching bash/readline UX.
//   • 0 matches         → do nothing (the buffer is left unchanged; the user
//     can keep typing).
//   • >1 matches        → print a newline, then all candidate names each
//     followed by a space, then a trailing newline. E.g. buf="e" + Tab →
//     prints "\necho exit \n". The buffer is left unchanged so the user can
//     type another character to disambiguate.
//
// PMT-pure implementation: the command-name bytes are inlined as decimal
// ASCII constants (per the file's "Decimal-constants discipline" rule).
// We cannot dereference a string literal's .rodata address (no `*ptr`
// syntax), so — exactly like shell_match_cmd — we dispatch on the .rodata
// ADDRESS of the `name` parameter (each `name == "echo"` / `name == "exit"`
// / ... comparison is a compile-time-resolvable equality between two i64
// constants, thanks to Wave 1 .rodata + string-literal deduplication). Once
// we've identified which command `name` refers to, we compare / append the
// known ASCII bytes for that command.
//
// Three functions:
//   shell_name_has_prefix(buf, name, name_len) → u8
//     Returns 1 iff buf[0..buf_len] is a PREFIX of the named command
//     (buf_len <= name_len AND buf[0..buf_len] == name[0..buf_len]).
//     This is the "does this command start with what the user typed?"
//     check. Note: this is the OPPOSITE direction from shell_match_cmd,
//     which checks whether the buffer STARTS WITH the command name (and
//     verifies a word boundary). shell_name_has_prefix checks whether the
//     command name starts with the buffer — i.e. the buffer is a prefix
//     of the command. An empty buffer (buf_len == 0) matches ALL commands
//     (the empty string is a prefix of every string).
//   shell_complete_name(s, name, name_len)
//     Appends the remaining bytes of the named command (positions
//     buf_len..name_len-1) + a trailing space (byte 32) to the buffer.
//     Called only when exactly one command matches. Uses a snapshot of
//     buf_len (`start`) to skip bytes the user already typed.
//   shell_tab_complete(s)
//     Counts matches across all 12 commands, then dispatches to the
//     0 / 1 / >1 branch as described above.

// shell_name_has_prefix: is buf[0..buf_len] a prefix of the named command?
//
// Returns 1 iff (a) buf_len <= name_len (the buffer is no longer than the
// command name — if the user typed MORE than the command name, the name
// can't be a completion) AND (b) buf[0..buf_len] equals name[0..buf_len]
// (every typed byte matches the corresponding byte of the command name).
//
// PMT-pure: dispatch on the .rodata address of `name` (same pattern as
// shell_match_cmd). When `name` matches a known literal, compare buf's
// bytes against the known ASCII bytes for that command. Each byte
// comparison is guarded by `buf.buf_len >= N` so we never read a byte
// the user hasn't typed (though reading past buf_len is safe in VUMA
// — the buffer is a fixed 256-byte array — the value would be stale
// garbage; the guard ensures correctness, not safety).
//
// Edge case: buf_len == 0 (empty buffer) → every `buf.buf_len >= N`
// guard is false, so no byte comparison fires, and the function returns
// 1. The empty string is a prefix of every command name. This means
// pressing Tab on an empty line matches all 12 commands → the >1 branch
// prints all 12. (Matches bash behavior: Tab on empty input lists all
// completions or does nothing depending on configuration; K6f lists all.)
fn shell_name_has_prefix(buf: State<Shell>, name: Address, name_len: u32) -> u8 {
    // (a) If the buffer is longer than the command name, the command name
    // can't be a completion of the buffer — no match.
    if buf.buf_len > name_len {
        return 0;
    }
    // (b) Compare buf[0..buf_len] against the bytes of `name`.
    if name == "echo" {
        // "echo" — e=101, c=99, h=104, o=111.
        if buf.buf_len >= 1 && buf.buf[0] != 101 { return 0; }  // 'e'
        if buf.buf_len >= 2 && buf.buf[1] != 99  { return 0; }  // 'c'
        if buf.buf_len >= 3 && buf.buf[2] != 104 { return 0; }  // 'h'
        if buf.buf_len >= 4 && buf.buf[3] != 111 { return 0; }  // 'o'
        return 1;
    }
    if name == "exit" {
        // "exit" — e=101, x=120, i=105, t=116.
        if buf.buf_len >= 1 && buf.buf[0] != 101 { return 0; }  // 'e'
        if buf.buf_len >= 2 && buf.buf[1] != 120 { return 0; }  // 'x'
        if buf.buf_len >= 3 && buf.buf[2] != 105 { return 0; }  // 'i'
        if buf.buf_len >= 4 && buf.buf[3] != 116 { return 0; }  // 't'
        return 1;
    }
    if name == "help" {
        // "help" — h=104, e=101, l=108, p=112.
        if buf.buf_len >= 1 && buf.buf[0] != 104 { return 0; }  // 'h'
        if buf.buf_len >= 2 && buf.buf[1] != 101 { return 0; }  // 'e'
        if buf.buf_len >= 3 && buf.buf[2] != 108 { return 0; }  // 'l'
        if buf.buf_len >= 4 && buf.buf[3] != 112 { return 0; }  // 'p'
        return 1;
    }
    if name == "ls" {
        // "ls" — l=108, s=115.
        if buf.buf_len >= 1 && buf.buf[0] != 108 { return 0; }  // 'l'
        if buf.buf_len >= 2 && buf.buf[1] != 115 { return 0; }  // 's'
        return 1;
    }
    if name == "cat" {
        // "cat" — c=99, a=97, t=116.
        if buf.buf_len >= 1 && buf.buf[0] != 99  { return 0; }  // 'c'
        if buf.buf_len >= 2 && buf.buf[1] != 97  { return 0; }  // 'a'
        if buf.buf_len >= 3 && buf.buf[2] != 116 { return 0; }  // 't'
        return 1;
    }
    if name == "pwd" {
        // "pwd" — p=112, w=119, d=100.
        if buf.buf_len >= 1 && buf.buf[0] != 112 { return 0; }  // 'p'
        if buf.buf_len >= 2 && buf.buf[1] != 119 { return 0; }  // 'w'
        if buf.buf_len >= 3 && buf.buf[2] != 100 { return 0; }  // 'd'
        return 1;
    }
    if name == "ver" {
        // "ver" — v=118, e=101, r=114.
        if buf.buf_len >= 1 && buf.buf[0] != 118 { return 0; }  // 'v'
        if buf.buf_len >= 2 && buf.buf[1] != 101 { return 0; }  // 'e'
        if buf.buf_len >= 3 && buf.buf[2] != 114 { return 0; }  // 'r'
        return 1;
    }
    if name == "ps" {
        // "ps" — p=112, s=115.
        if buf.buf_len >= 1 && buf.buf[0] != 112 { return 0; }  // 'p'
        if buf.buf_len >= 2 && buf.buf[1] != 115 { return 0; }  // 's'
        return 1;
    }
    if name == "memstat" {
        // "memstat" — m=109, e=101, m=109, s=115, t=116, a=97, t=116.
        if buf.buf_len >= 1 && buf.buf[0] != 109 { return 0; }  // 'm'
        if buf.buf_len >= 2 && buf.buf[1] != 101 { return 0; }  // 'e'
        if buf.buf_len >= 3 && buf.buf[2] != 109 { return 0; }  // 'm'
        if buf.buf_len >= 4 && buf.buf[3] != 115 { return 0; }  // 's'
        if buf.buf_len >= 5 && buf.buf[4] != 116 { return 0; }  // 't'
        if buf.buf_len >= 6 && buf.buf[5] != 97  { return 0; }  // 'a'
        if buf.buf_len >= 7 && buf.buf[6] != 116 { return 0; }  // 't'
        return 1;
    }
    if name == "clear" {
        // "clear" — c=99, l=108, e=101, a=97, r=114.
        if buf.buf_len >= 1 && buf.buf[0] != 99  { return 0; }  // 'c'
        if buf.buf_len >= 2 && buf.buf[1] != 108 { return 0; }  // 'l'
        if buf.buf_len >= 3 && buf.buf[2] != 101 { return 0; }  // 'e'
        if buf.buf_len >= 4 && buf.buf[3] != 97  { return 0; }  // 'a'
        if buf.buf_len >= 5 && buf.buf[4] != 114 { return 0; }  // 'r'
        return 1;
    }
    if name == "true" {
        // "true" — t=116, r=114, u=117, e=101.
        if buf.buf_len >= 1 && buf.buf[0] != 116 { return 0; }  // 't'
        if buf.buf_len >= 2 && buf.buf[1] != 114 { return 0; }  // 'r'
        if buf.buf_len >= 3 && buf.buf[2] != 117 { return 0; }  // 'u'
        if buf.buf_len >= 4 && buf.buf[3] != 101 { return 0; }  // 'e'
        return 1;
    }
    if name == "false" {
        // "false" — f=102, a=97, l=108, s=115, e=101.
        if buf.buf_len >= 1 && buf.buf[0] != 102 { return 0; }  // 'f'
        if buf.buf_len >= 2 && buf.buf[1] != 97  { return 0; }  // 'a'
        if buf.buf_len >= 3 && buf.buf[2] != 108 { return 0; }  // 'l'
        if buf.buf_len >= 4 && buf.buf[3] != 115 { return 0; }  // 's'
        if buf.buf_len >= 5 && buf.buf[4] != 101 { return 0; }  // 'e'
        return 1;
    }
    // `name` doesn't match any known command literal — no match.
    return 0;
}

// shell_complete_name: append the remaining bytes of the named command + a
// trailing space to the buffer.
//
// Called by shell_tab_complete when exactly one command matches the partial
// input. The buffer currently holds buf[0..buf_len] which is a prefix of the
// named command; this function appends bytes buf_len..name_len-1 of the
// command name (the "rest of the name") followed by a space (byte 32).
//
// Implementation: snapshot buf_len into `start` BEFORE any appends (because
// each append increments s.buf_len, and we need the original value to decide
// which bytes to skip). For each byte position i in 0..name_len-1, append
// the byte iff `start <= i` (meaning byte i was NOT already in the buffer
// when we started). The `s.buf_len < 255` guard on each append is the same
// overflow-protection pattern as shell_receive / K6e's console_putc.
//
// After appending the name bytes, append a single trailing space (byte 32)
// — also guarded by `s.buf_len < 255`. The space positions the cursor for
// the first argument (e.g. "echo" + Tab → "echo " ready for the user to
// type the argument), matching bash/readline single-completion UX.
//
// PMT-pure: dispatch on the .rodata address of `name` to get the bytes
// (same pattern as shell_match_cmd / shell_name_has_prefix).
fn shell_complete_name(s: State<Shell>, name: Address, name_len: u32) {
    let start = s.buf_len;
    if name == "echo" {
        // "echo" — e=101, c=99, h=104, o=111.
        if start <= 0 && s.buf_len < 255 { s.buf[s.buf_len] = 101; s.buf_len = s.buf_len + 1; }  // 'e'
        if start <= 1 && s.buf_len < 255 { s.buf[s.buf_len] = 99;  s.buf_len = s.buf_len + 1; }  // 'c'
        if start <= 2 && s.buf_len < 255 { s.buf[s.buf_len] = 104; s.buf_len = s.buf_len + 1; }  // 'h'
        if start <= 3 && s.buf_len < 255 { s.buf[s.buf_len] = 111; s.buf_len = s.buf_len + 1; }  // 'o'
    }
    if name == "exit" {
        // "exit" — e=101, x=120, i=105, t=116.
        if start <= 0 && s.buf_len < 255 { s.buf[s.buf_len] = 101; s.buf_len = s.buf_len + 1; }  // 'e'
        if start <= 1 && s.buf_len < 255 { s.buf[s.buf_len] = 120; s.buf_len = s.buf_len + 1; }  // 'x'
        if start <= 2 && s.buf_len < 255 { s.buf[s.buf_len] = 105; s.buf_len = s.buf_len + 1; }  // 'i'
        if start <= 3 && s.buf_len < 255 { s.buf[s.buf_len] = 116; s.buf_len = s.buf_len + 1; }  // 't'
    }
    if name == "help" {
        // "help" — h=104, e=101, l=108, p=112.
        if start <= 0 && s.buf_len < 255 { s.buf[s.buf_len] = 104; s.buf_len = s.buf_len + 1; }  // 'h'
        if start <= 1 && s.buf_len < 255 { s.buf[s.buf_len] = 101; s.buf_len = s.buf_len + 1; }  // 'e'
        if start <= 2 && s.buf_len < 255 { s.buf[s.buf_len] = 108; s.buf_len = s.buf_len + 1; }  // 'l'
        if start <= 3 && s.buf_len < 255 { s.buf[s.buf_len] = 112; s.buf_len = s.buf_len + 1; }  // 'p'
    }
    if name == "ls" {
        // "ls" — l=108, s=115.
        if start <= 0 && s.buf_len < 255 { s.buf[s.buf_len] = 108; s.buf_len = s.buf_len + 1; }  // 'l'
        if start <= 1 && s.buf_len < 255 { s.buf[s.buf_len] = 115; s.buf_len = s.buf_len + 1; }  // 's'
    }
    if name == "cat" {
        // "cat" — c=99, a=97, t=116.
        if start <= 0 && s.buf_len < 255 { s.buf[s.buf_len] = 99;  s.buf_len = s.buf_len + 1; }  // 'c'
        if start <= 1 && s.buf_len < 255 { s.buf[s.buf_len] = 97;  s.buf_len = s.buf_len + 1; }  // 'a'
        if start <= 2 && s.buf_len < 255 { s.buf[s.buf_len] = 116; s.buf_len = s.buf_len + 1; }  // 't'
    }
    if name == "pwd" {
        // "pwd" — p=112, w=119, d=100.
        if start <= 0 && s.buf_len < 255 { s.buf[s.buf_len] = 112; s.buf_len = s.buf_len + 1; }  // 'p'
        if start <= 1 && s.buf_len < 255 { s.buf[s.buf_len] = 119; s.buf_len = s.buf_len + 1; }  // 'w'
        if start <= 2 && s.buf_len < 255 { s.buf[s.buf_len] = 100; s.buf_len = s.buf_len + 1; }  // 'd'
    }
    if name == "ver" {
        // "ver" — v=118, e=101, r=114.
        if start <= 0 && s.buf_len < 255 { s.buf[s.buf_len] = 118; s.buf_len = s.buf_len + 1; }  // 'v'
        if start <= 1 && s.buf_len < 255 { s.buf[s.buf_len] = 101; s.buf_len = s.buf_len + 1; }  // 'e'
        if start <= 2 && s.buf_len < 255 { s.buf[s.buf_len] = 114; s.buf_len = s.buf_len + 1; }  // 'r'
    }
    if name == "ps" {
        // "ps" — p=112, s=115.
        if start <= 0 && s.buf_len < 255 { s.buf[s.buf_len] = 112; s.buf_len = s.buf_len + 1; }  // 'p'
        if start <= 1 && s.buf_len < 255 { s.buf[s.buf_len] = 115; s.buf_len = s.buf_len + 1; }  // 's'
    }
    if name == "memstat" {
        // "memstat" — m=109, e=101, m=109, s=115, t=116, a=97, t=116.
        if start <= 0 && s.buf_len < 255 { s.buf[s.buf_len] = 109; s.buf_len = s.buf_len + 1; }  // 'm'
        if start <= 1 && s.buf_len < 255 { s.buf[s.buf_len] = 101; s.buf_len = s.buf_len + 1; }  // 'e'
        if start <= 2 && s.buf_len < 255 { s.buf[s.buf_len] = 109; s.buf_len = s.buf_len + 1; }  // 'm'
        if start <= 3 && s.buf_len < 255 { s.buf[s.buf_len] = 115; s.buf_len = s.buf_len + 1; }  // 's'
        if start <= 4 && s.buf_len < 255 { s.buf[s.buf_len] = 116; s.buf_len = s.buf_len + 1; }  // 't'
        if start <= 5 && s.buf_len < 255 { s.buf[s.buf_len] = 97;  s.buf_len = s.buf_len + 1; }  // 'a'
        if start <= 6 && s.buf_len < 255 { s.buf[s.buf_len] = 116; s.buf_len = s.buf_len + 1; }  // 't'
    }
    if name == "clear" {
        // "clear" — c=99, l=108, e=101, a=97, r=114.
        if start <= 0 && s.buf_len < 255 { s.buf[s.buf_len] = 99;  s.buf_len = s.buf_len + 1; }  // 'c'
        if start <= 1 && s.buf_len < 255 { s.buf[s.buf_len] = 108; s.buf_len = s.buf_len + 1; }  // 'l'
        if start <= 2 && s.buf_len < 255 { s.buf[s.buf_len] = 101; s.buf_len = s.buf_len + 1; }  // 'e'
        if start <= 3 && s.buf_len < 255 { s.buf[s.buf_len] = 97;  s.buf_len = s.buf_len + 1; }  // 'a'
        if start <= 4 && s.buf_len < 255 { s.buf[s.buf_len] = 114; s.buf_len = s.buf_len + 1; }  // 'r'
    }
    if name == "true" {
        // "true" — t=116, r=114, u=117, e=101.
        if start <= 0 && s.buf_len < 255 { s.buf[s.buf_len] = 116; s.buf_len = s.buf_len + 1; }  // 't'
        if start <= 1 && s.buf_len < 255 { s.buf[s.buf_len] = 114; s.buf_len = s.buf_len + 1; }  // 'r'
        if start <= 2 && s.buf_len < 255 { s.buf[s.buf_len] = 117; s.buf_len = s.buf_len + 1; }  // 'u'
        if start <= 3 && s.buf_len < 255 { s.buf[s.buf_len] = 101; s.buf_len = s.buf_len + 1; }  // 'e'
    }
    if name == "false" {
        // "false" — f=102, a=97, l=108, s=115, e=101.
        if start <= 0 && s.buf_len < 255 { s.buf[s.buf_len] = 102; s.buf_len = s.buf_len + 1; }  // 'f'
        if start <= 1 && s.buf_len < 255 { s.buf[s.buf_len] = 97;  s.buf_len = s.buf_len + 1; }  // 'a'
        if start <= 2 && s.buf_len < 255 { s.buf[s.buf_len] = 108; s.buf_len = s.buf_len + 1; }  // 'l'
        if start <= 3 && s.buf_len < 255 { s.buf[s.buf_len] = 115; s.buf_len = s.buf_len + 1; }  // 's'
        if start <= 4 && s.buf_len < 255 { s.buf[s.buf_len] = 101; s.buf_len = s.buf_len + 1; }  // 'e'
    }
    // Append the trailing space — positions the cursor for the first
    // argument. Always appended (regardless of which command matched).
    if s.buf_len < 255 {
        s.buf[s.buf_len] = 32;  // ' '
        s.buf_len = s.buf_len + 1;
    }
}

// shell_tab_complete: the entry point called by shell_receive on Tab (byte 9).
//
// Walks all 12 known command names, counts how many have buf[0..buf_len] as
// a prefix, then dispatches:
//   count == 0 → return (do nothing; the buffer is unchanged).
//   count == 1 → find the single match, call shell_complete_name to append
//                the rest of its name + a space.
//   count  > 1 → print "\n", then for each matching command print its name
//                + a space, then print "\n". The buffer is left unchanged.
//
// The count == 1 branch re-checks each command with shell_name_has_prefix
// (only one will return 1, since count == 1) and calls shell_complete_name
// for the first match — the `return` after each shell_complete_name call
// ensures we don't fall through to the next check.
//
// The count > 1 branch uses separate write() calls per match (one for the
// name + space). Each write uses a Wave 1 string literal lowered to a
// .rodata address — same PMT "Borrowed read" pattern as shell_do_help /
// shell_do_ls / etc. The matches are printed in the same canonical order
// as the dispatch in shell_execute (echo, exit, help, ls, cat, pwd, ver,
// ps, memstat, clear, true, false) so the listing is stable.
fn shell_tab_complete(s: State<Shell>) {
    // Count how many known commands have buf[0..buf_len] as a prefix.
    let count = 0;
    if shell_name_has_prefix(s, "echo", 4) == 1 { count = count + 1; }
    if shell_name_has_prefix(s, "exit", 4) == 1 { count = count + 1; }
    if shell_name_has_prefix(s, "help", 4) == 1 { count = count + 1; }
    if shell_name_has_prefix(s, "ls", 2) == 1 { count = count + 1; }
    if shell_name_has_prefix(s, "cat", 3) == 1 { count = count + 1; }
    if shell_name_has_prefix(s, "pwd", 3) == 1 { count = count + 1; }
    if shell_name_has_prefix(s, "ver", 3) == 1 { count = count + 1; }
    if shell_name_has_prefix(s, "ps", 2) == 1 { count = count + 1; }
    if shell_name_has_prefix(s, "memstat", 7) == 1 { count = count + 1; }
    if shell_name_has_prefix(s, "clear", 5) == 1 { count = count + 1; }
    if shell_name_has_prefix(s, "true", 4) == 1 { count = count + 1; }
    if shell_name_has_prefix(s, "false", 5) == 1 { count = count + 1; }

    // 0 matches — do nothing.
    if count == 0 {
        return;
    }

    // 1 match — append the rest of the name + a space.
    if count == 1 {
        if shell_name_has_prefix(s, "echo", 4) == 1 { shell_complete_name(s, "echo", 4); return; }
        if shell_name_has_prefix(s, "exit", 4) == 1 { shell_complete_name(s, "exit", 4); return; }
        if shell_name_has_prefix(s, "help", 4) == 1 { shell_complete_name(s, "help", 4); return; }
        if shell_name_has_prefix(s, "ls", 2) == 1 { shell_complete_name(s, "ls", 2); return; }
        if shell_name_has_prefix(s, "cat", 3) == 1 { shell_complete_name(s, "cat", 3); return; }
        if shell_name_has_prefix(s, "pwd", 3) == 1 { shell_complete_name(s, "pwd", 3); return; }
        if shell_name_has_prefix(s, "ver", 3) == 1 { shell_complete_name(s, "ver", 3); return; }
        if shell_name_has_prefix(s, "ps", 2) == 1 { shell_complete_name(s, "ps", 2); return; }
        if shell_name_has_prefix(s, "memstat", 7) == 1 { shell_complete_name(s, "memstat", 7); return; }
        if shell_name_has_prefix(s, "clear", 5) == 1 { shell_complete_name(s, "clear", 5); return; }
        if shell_name_has_prefix(s, "true", 4) == 1 { shell_complete_name(s, "true", 4); return; }
        if shell_name_has_prefix(s, "false", 5) == 1 { shell_complete_name(s, "false", 5); return; }
        return;
    }

    // >1 matches — print a newline + all matches (each followed by a space)
    // + a trailing newline. The buffer is left unchanged so the user can
    // type another character to disambiguate.
    write(1, "\n", 1);
    if shell_name_has_prefix(s, "echo", 4) == 1 { write(1, "echo ", 5); }
    if shell_name_has_prefix(s, "exit", 4) == 1 { write(1, "exit ", 5); }
    if shell_name_has_prefix(s, "help", 4) == 1 { write(1, "help ", 5); }
    if shell_name_has_prefix(s, "ls", 2) == 1 { write(1, "ls ", 3); }
    if shell_name_has_prefix(s, "cat", 3) == 1 { write(1, "cat ", 4); }
    if shell_name_has_prefix(s, "pwd", 3) == 1 { write(1, "pwd ", 4); }
    if shell_name_has_prefix(s, "ver", 3) == 1 { write(1, "ver ", 4); }
    if shell_name_has_prefix(s, "ps", 2) == 1 { write(1, "ps ", 3); }
    if shell_name_has_prefix(s, "memstat", 7) == 1 { write(1, "memstat ", 8); }
    if shell_name_has_prefix(s, "clear", 5) == 1 { write(1, "clear ", 6); }
    if shell_name_has_prefix(s, "true", 4) == 1 { write(1, "true ", 5); }
    if shell_name_has_prefix(s, "false", 5) == 1 { write(1, "false ", 6); }
    write(1, "\n", 1);
}

// ────────────────────────────────────────────────────────────────────────────
// Self-test (the K6f DoD).
// ────────────────────────────────────────────────────────────────────────────
// Four sub-tests, each exercising one shell code path:
//   (1) "echo hello\n" — verify the echo built-in runs and the shell
//       stays running. Feeds the bytes 'e','c','h','o',' ','h','e','l',
//       'l','o','\n' (11 bytes) one at a time through shell_receive.
//       The newline triggers shell_execute, which prints "\n" (the
//       leading newline) then "hello\n" (the echo output). After
//       shell_execute returns, buf_len resets to 0. The shell should
//       still be running (s.running == 1) — echo doesn't exit.
//       Verifies: shell_receive buffering + newline-triggered execute
//       + "echo" prefix match + shell_do_echo arg scan + write path.
//   (1.5) "ec" + Tab (W26S1) — verify single-match tab completion.
//       Feeds 'e','c',Tab (byte 9). The Tab triggers shell_tab_complete,
//       which finds exactly one match ("echo"), appends "ho " (the rest
//       of "echo" + a space), and leaves buf = "echo " (5 bytes).
//       Asserts buf_len == 5, buf[0]='e', buf[2]='h', buf[4]=' '.
//       Then feeds '\n' to execute "echo" (no args) and clear the buffer.
//       Verifies: byte-9 dispatch + shell_name_has_prefix prefix check +
//       count==1 branch + shell_complete_name append-rest + space.
//   (1.6) "e" + Tab (W26S1) — verify multi-match tab completion.
//       Feeds 'e',Tab. The Tab triggers shell_tab_complete, which finds
//       two matches ("echo" + "exit"), prints "\necho exit \n", and
//       leaves buf unchanged ("e", 1 byte). Asserts buf_len == 1,
//       buf[0]='e'. Then feeds '\n' to execute "e" (unknown command)
//       and clear the buffer.
//       Verifies: byte-9 dispatch + multi-match count + count>1 branch
//       (prints candidates, leaves buf unchanged).
//   (2) "exit\n" — verify the exit built-in terminates the shell. Feeds
//       'e','x','i','t','\n' (5 bytes). The newline triggers
//       shell_execute, which prints "\n" (leading newline) then matches
//       "exit" and sets running=0, exit_code=0. The shell should now be
//       exited (s.running == 0).
//       Verifies: shell_receive buffering + newline-triggered execute
//       + "exit" prefix match + running/exit_code state mutation.
//
// All assertions return distinct non-zero codes (1-10) so a failure
// pinpoints exactly which check failed. Exit 0 = all checks passed.
//
// Visible stdout side-effect: the test emits "\nhello\n" (sub-test 1:
// leading "\n" + "hello\n"), then "\n\n" (sub-test 1.5: leading "\n"
// from shell_execute + "\n" from echo-of-empty-args), then "\necho exit
// \n\n?\n" (sub-test 1.6: "\necho exit \n" from multi-match tab +
// "\n?\n" from executing unknown "e"), then "\n" (sub-test 2: leading
// "\n" from shell_execute before exit sets running=0). Total visible
// output doesn't affect the exit code.

fn main() -> i32 {
    let s = state_new(Shell);
    shell_init(s);

    // ── Sub-test (1): "echo hello\n" — echo built-in ──────────────────────
    // After init: buf_len=0, running=1, exit_code=0. Feed "echo hello"
    // (10 bytes) + '\n' (1 byte) = 11 bytes total.
    // Each shell_receive (non-newline): buf_len < 255 → store at
    // buf[buf_len], buf_len++. After 10 receives: buf[0..10] =
    // "echo hello", buf_len=10.
    // 11th receive (newline '\n' = 10): c == 10 → shell_execute(s),
    // then buf_len = 0.
    //   shell_execute: writes "\n" (1 byte via fresh ShellOut).
    //   Checks "exit" prefix: buf[0]='e'(101) match, buf[1]='c'(99) !=
    //   'x'(120) → no match.
    //   Checks "echo" prefix: buf[0]='e'(101) match, buf[1]='c'(99)
    //   match, buf[2]='h'(104) match, buf[3]='o'(111) match → call
    //   shell_do_echo(s).
    //     shell_do_echo: out = fresh ShellOut, out_len=0, i=4. buf[4]=
    //     ' '(32) → i=5. Loop: i=5 < 10 && 0 < 255 → out.data[0]=buf[5]
    //     ='h'(104), out_len=1, i=6. ... (continues for 'e','l','l','o')
    //     → out.data[0..5]="hello", out_len=5, i=10. Loop exits (10 <
    //     10 is false). out.data[5]='\n'(10). write(1, addr, 6) →
    //     stdout gets "hello\n".
    //   return from shell_do_echo, return from shell_execute.
    // buf_len = 0.
    // After sub-test (1): s.running should still be 1 (echo doesn't
    // exit). If not, return 1.
    shell_receive(s, 101);  // 'e'
    shell_receive(s, 99);   // 'c'
    shell_receive(s, 104);  // 'h'
    shell_receive(s, 111);  // 'o'
    shell_receive(s, 32);   // ' '
    shell_receive(s, 104);  // 'h'
    shell_receive(s, 101);  // 'e'
    shell_receive(s, 108);  // 'l'
    shell_receive(s, 108);  // 'l'
    shell_receive(s, 111);  // 'o'
    shell_receive(s, 10);   // '\n'
    // Shell should still be running.
    if s.running != 1 { return 1; }

    // ── Sub-test (1.5): Tab completion — single match (W26S1) ────────────
    // After sub-test (1): buf_len=0, running=1. Feed "ec" (2 bytes) +
    // Tab (byte 9) = 3 bytes total.
    // Each shell_receive (non-newline, non-Tab): buf_len < 255 → store
    // at buf[buf_len], buf_len++. After 2 receives: buf[0..2]="ec",
    // buf_len=2.
    // 3rd receive (Tab = 9): c == 9 → shell_tab_complete(s).
    //   shell_name_has_prefix(s, "echo", 4): buf_len=2 <= 4.
    //     buf[0]='e'(101)==101 ✓, buf[1]='c'(99)==99 ✓ → returns 1.
    //   shell_name_has_prefix(s, "exit", 4): buf_len=2 <= 4.
    //     buf[0]='e'(101)==101 ✓, buf[1]='c'(99)!=120('x') → returns 0.
    //   (all other commands: buf[0] != first byte → returns 0.)
    //   count = 1 (only "echo").
    //   count == 1 → shell_complete_name(s, "echo", 4):
    //     start = 2 (snapshot of buf_len).
    //     start <= 0? No → skip byte 0 ('e', already in buf).
    //     start <= 1? No → skip byte 1 ('c', already in buf).
    //     start <= 2? Yes → buf[2]=104('h'), buf_len=3.
    //     start <= 3? Yes → buf[3]=111('o'), buf_len=4.
    //     Append space: buf[4]=32(' '), buf_len=5.
    //   buf is now "echo " (5 bytes), buf_len=5.
    // The Tab byte itself was NOT buffered (shell_receive returned after
    // calling shell_tab_complete). Verifies: byte-9 dispatch in
    // shell_receive + shell_name_has_prefix prefix check + count==1
    // branch + shell_complete_name append-rest + trailing space.
    shell_receive(s, 101);  // 'e'
    shell_receive(s, 99);   // 'c'
    shell_receive(s, 9);    // Tab → shell_tab_complete
    // buf should now be "echo " (5 bytes).
    if s.buf_len != 5 { return 3; }
    if s.buf[0] != 101 { return 4; }  // 'e' (original)
    if s.buf[2] != 104 { return 5; }  // 'h' (appended by completion)
    if s.buf[4] != 32  { return 6; }  // ' ' (trailing space)
    // Clear the buffer by sending a newline — executes "echo" with no
    // args. shell_execute prints "\n" (leading newline) then
    // shell_do_echo prints "\n" (echo of empty args). running stays 1.
    shell_receive(s, 10);   // '\n'
    if s.running != 1 { return 7; }

    // ── Sub-test (1.6): Tab completion — multiple matches (W26S1) ────────
    // After sub-test (1.5): buf_len=0, running=1. Feed "e" (1 byte) +
    // Tab (byte 9) = 2 bytes total.
    // 1st receive ('e' = 101): buf[0]='e', buf_len=1.
    // 2nd receive (Tab = 9): c == 9 → shell_tab_complete(s).
    //   shell_name_has_prefix(s, "echo", 4): buf_len=1 <= 4.
    //     buf[0]='e'(101)==101 ✓ → returns 1.
    //   shell_name_has_prefix(s, "exit", 4): buf_len=1 <= 4.
    //     buf[0]='e'(101)==101 ✓ → returns 1.
    //   (all other commands: buf[0] != first byte → returns 0.)
    //   count = 2 (echo + exit).
    //   count > 1 → write "\n", write "echo ", write "exit ", write "\n".
    //     stdout gets "\necho exit \n".
    //   buf is UNCHANGED: buf[0]='e', buf_len=1.
    // Verifies: byte-9 dispatch + shell_name_has_prefix multi-match +
    // count>1 branch (prints candidates, leaves buf unchanged).
    shell_receive(s, 101);  // 'e'
    shell_receive(s, 9);    // Tab → shell_tab_complete (multi-match)
    // buf should still be "e" (1 byte, unchanged).
    if s.buf_len != 1 { return 8; }
    if s.buf[0] != 101 { return 9; }  // 'e' (unchanged)
    // Clear the buffer by sending a newline — executes "e" (unknown
    // command). shell_execute prints "\n" then "?\n". running stays 1.
    shell_receive(s, 10);   // '\n'
    if s.running != 1 { return 10; }

    // ── Sub-test (2): "exit\n" — exit built-in ────────────────────────────
    // Feed "exit" (4 bytes) + '\n' (1 byte) = 5 bytes total.
    // Each shell_receive (non-newline): buf_len < 255 → store at
    // buf[buf_len], buf_len++. After 4 receives: buf[0..4] = "exit",
    // buf_len=4.
    // 5th receive (newline '\n' = 10): c == 10 → shell_execute(s),
    // then buf_len = 0.
    //   shell_execute: writes "\n" (1 byte via fresh ShellOut).
    //   Checks "exit" prefix: buf[0]='e'(101) match, buf[1]='x'(120)
    //   match, buf[2]='i'(105) match, buf[3]='t'(116) match → set
    //   s.running=0, s.exit_code=0, return.
    //   (shell_do_echo is NOT called — the exit branch returns first.)
    // buf_len = 0.
    // After sub-test (2): s.running should be 0 (exit terminated the
    // shell). If not, return 2.
    shell_receive(s, 101);  // 'e'
    shell_receive(s, 120);  // 'x'
    shell_receive(s, 105);  // 'i'
    shell_receive(s, 116);  // 't'
    shell_receive(s, 10);   // '\n'
    // Shell should have exited.
    if s.running != 0 { return 2; }
    return 0;
}
