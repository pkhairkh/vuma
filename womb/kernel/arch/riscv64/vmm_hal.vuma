// ═══════════════════════════════════════════════════════════════════════════
// womb/kernel/arch/riscv64/vmm_hal.vuma
// riscv64 VMM HAL — page-table walker (PGD→PMD→PTE, Sv39) for the R3b
// dispatcher's riscv_map_page / riscv_translate entry points.
// ═══════════════════════════════════════════════════════════════════════════
//
// Wave R3f. Implements the riscv64 half of the R3b HAL boundary:
//   - riscv_map_page(root, vaddr, paddr, flags, levels) — walk PGD→PMD→PTE
//     (Sv39 3-level), write the leaf PTE.
//   - riscv_translate(root, vaddr) — walk to leaf, return the mapped paddr.
//
// These are REAL VUMA functions (PMT transforms), NOT externs. The walker
// owns its own page-table interpretation (RISC-V Privileged ISA Vol. II
// §4.3.2 Sv39). The only externs declared here are pte_read / pte_write —
// the raw 8-byte MMIO load/store at a physical address (real asm stub in
// K11 bare-metal, __ffi_fallback_stub returns 0 / no-op in hosted mode).
//
// RISC-V Sv39 paging geometry (RISC-V Privileged ISA Vol. II §4.3.2):
//     PGD (level 2) — bits 38-30 of vaddr → next-level PMD
//     PMD (level 1) — bits 29-21          → next-level PTE
//     PTE (level 0) — bits 20-12          → leaf, points at a 4 KB page
// Each level's index is 9 bits wide; 512 8-byte PTEs fit in one 4 KB page.
// The 9-bit index for level L is at vaddr bits (12 + 9*L) .. (12 + 9*L + 8)
// — identical bit-math to x86_64 / aarch64 4-level paging; only the
// NUMBER of levels differs (3 for Sv39, 4 for x86_64/aarch64).
//
// Sv39 VA breakdown (39 bits total = 9 + 9 + 9 + 12):
//     bits 38-30  VPN[2]  (PGD index — 9 bits)
//     bits 29-21  VPN[1]  (PMD index — 9 bits)
//     bits 20-12  VPN[0]  (PTE index — 9 bits, leaf)
//     bits 11-0   offset  (12 bits — 4 KB page offset)
//
// Leaf PTE format (RISC-V Privileged ISA Vol. II §4.3.2, Fig. 4.17):
//     bit 0      V — Valid (always set by riscv_map_page)
//     bit 1      R — Readable
//     bit 2      W — Writable
//     bit 3      X — Executable
//     bit 4      U — User (U-mode accessible)
//     bit 5      G — Global
//     bit 6      A — Accessed
//     bit 7      D — Dirty
//     bits 8-9   RSW — Reserved for Software
//     bits 10-53 PPN — Physical Page Number (44 bits, PA = PPN << 12)
//     bits 54-63 Reserved (must be 0)
// The leaf PTE written by riscv_map_page is:
//     ((paddr >> 12) << 10) | (flags & 1023) | 1
// where:
//     (paddr >> 12) << 10   — place the PPN at bits 10-53
//     1023           = 0x3FF (low 10 bits — V/R/W/X/U/G/A/D + RSW)
//     1              = bit 0 (V — Valid bit, always set)
//
// Intermediate-PTE "present" check: V bit (bit 0). If the walker hits a
// not-present PTE at any intermediate level, it returns without mapping —
// allocating a fresh intermediate page requires the PMM, which the R3f
// walker does NOT pull in (it stays a pure PMT transform over `pte_read`
// / `pte_write`). K11 wires the PMM and adds the allocation step.
//
// Intermediate-PTE "follow to next level" extraction: the next table's PA
// is the PPN field shifted left by 12:
//     next_pa = ((pte >> 10) & 17592186044415) << 12
//   17592186044415 = 0xFFFFFFFFFF (44-bit PPN mask, bits 0-43 of the
//                   shifted value — i.e. PTE bits 10-53 of the original)
// This is the SAME extraction that womb/kernel/arch/riscv64/pt.vuma's
// pte_addr helper does — duplicated inline here so the walker is a pure
// PMT transform without cross-file helper calls (VUMA has no import).
//
// ── PMT discipline ─────────────────────────────────────────────────────────
// NO `*ptr`, `&x`, `allocate`, or `free` anywhere in this file. The walker
// manipulates plain u64 scalars (root, vaddr, paddr, flags, level, idx,
// pte_addr, pte, ppn) — no State<T> buffer is needed because the page-
// table pages live in physical memory reached via `pte_read` / `pte_write`
// (extern MMIO), not in the ___pmt_buffer arena. VmmNode + VmmSpace are
// re-declared here only so a future kmain.vuma that re-typing them
// byte-identically can refer to them; the walker itself takes `root: u64`
// (matching the R3b extern signature).
//
// ── Why re-declare VmmNode + VmmSpace? ──────────────────────────────────────
// VUMA has no `import` (Open Work §7). Every kernel module re-declares the
// layouts it uses byte-identically (same pattern as
// womb/kernel/arch/riscv64/mm_trampoline.vuma re-declaring PageTable). The
// layouts below MUST match womb/kernel/mm/vmm.vuma (R3b):
//     layout VmmNode  = { entries: [u8; 4096] }
//     layout VmmSpace = { root: u64, levels: u8, arch: u8, _pad: [u8; 6] }
//
// ── Why re-declare PageTableEntry? ──────────────────────────────────────────
// Same reason — byte-identical to womb/kernel/arch/riscv64/pt.vuma (K2e):
//     layout PageTableEntry = { raw: u64 }
// The walker doesn't actually USE State<PageTableEntry> (PTEs are passed
// around as raw u64s — they fit in a register), but the layout is declared
// so a future caller that wants to pack/unpack a PTE structurally can.
//
// ── Decimal-constants table (VUMA accepts 0x.. too, but decimal is safer) ──
//   511                = 0x1FF                  (9-bit index mask)
//   1023               = 0x3FF                  (low 10 bits — V/R/W/X/U/
//                                                G/A/D + RSW flags)
//   17592186044415     = 0xFFFFFFFFFF           (44-bit PPN mask)
//   20015998343868     = 0x123456789ABC         (self-test vaddr)
//   524288             = 0x80000                (self-test paddr — 512 KB)
//   4096               = 0x1000                 (self-test vaddr #2 — 4 KB)
//   512                = 512                    (PTEs per 4 KB table)
//   8                  = 8                      (bytes per PTE)
//   1                  = 1                      (Valid bit, bit 0)
//   2                  = 2                      (top level for 3-level Sv39)
//   3                  = 3                      (Sv39 level count)
//
// ── Build & verify (hosted x86_64 — real bare-metal testing is K11's job
//    on riscv64) ────────────────────────────────────────────────────────────
//     ./target/release-fast/compile_dump \
//         womb/kernel/arch/riscv64/vmm_hal.vuma \
//         /tmp/vmm_hal.bin x86_64 --verify
//     /tmp/vmm_hal.bin ; echo "exit=$?"
// Expected: IVE Pass, exit=0
//
// In hosted mode, pte_read returns 0 (__ffi_fallback_stub), so the walk
// early-exits at the first intermediate level (V bit not set) and
// riscv_translate returns 0. The self-test therefore verifies INDEX
// EXTRACTION (the arch-independent bit math, which the walker uses inline)
// plus a no-crash call through riscv_map_page / riscv_translate.

// ────────────────────────────────────────────────────────────────────────────
// Layouts (re-declared byte-identically to womb/kernel/mm/vmm.vuma R3b
// and womb/kernel/arch/riscv64/pt.vuma K2e).
// ────────────────────────────────────────────────────────────────────────────

// Generic page-table node — 4096 bytes (one page). The walker treats this
// as an opaque byte array (it never instantiates State<VmmNode> — the
// page-table pages are reached via `pte_read` / `pte_write` at physical
// addresses, not via the arena). Declared here for callers that want to
// allocate page-table pages from the PMM as VmmNodes.
layout VmmNode = {
    entries: [u8; 4096],
}

// VMM address space — root + arch info. `root` is the physical address of
// the PGD table (SATP points here). `levels` is 3 for riscv64 Sv39.
// `arch` is 2 (riscv64). `_pad` pads to 16 bytes. The walker takes
// `root: u64` (not State<VmmSpace>) to match the R3b extern signature;
// VmmSpace is declared here for callers.
layout VmmSpace = {
    root: u64,
    levels: u8,
    arch: u8,
    _pad: [u8; 6],
}

// RISC-V Sv39 Page Table Entry — 8 bytes, stored as a u64. See
// womb/kernel/arch/riscv64/pt.vuma for the field-access helpers
// (pte_valid / pte_readable / pte_make / etc.). This walker uses raw
// u64 arithmetic inline rather than calling those helpers — the walker
// only needs the V bit (bit 0), the PPN mask (44 bits at bits 10-53),
// and the leaf-PTE assembly formula, so the inline form is shorter and
// easier to audit.
layout PageTableEntry = { raw: u64 }

// ────────────────────────────────────────────────────────────────────────────
// Extern "C" — raw PTE access (real MMIO in bare-metal, stubs in hosted).
// ────────────────────────────────────────────────────────────────────────────
// Hosted: __ffi_fallback_stub — pte_read returns 0, pte_write is a no-op.
// K11 bare-metal: direct 8-byte load/store at the PTE's physical address
// (RISC-V page tables live in regular memory, reached via the kernel's
// identity-mapped physmem window OR with SATP-aware translation — K11's
// job to register the stub). The walker does the address arithmetic
// (root + idx * 8) itself; the externs are pure load/store at a u64.
extern "C" {
    // Read an 8-byte PTE at physical address `addr`. Returns the raw u64.
    fn pte_read(addr: u64) -> u64;
    // Write an 8-byte PTE value `val` at physical address `addr`.
    fn pte_write(addr: u64, val: u64);
}

// ────────────────────────────────────────────────────────────────────────────
// riscv_idx — extract the 9-bit page-table index for a given walk level.
// ────────────────────────────────────────────────────────────────────────────
// For walk level L (0..levels-1), the 9-bit index occupies bits
// (12 + 9*L) .. (12 + 9*L + 8) of the virtual address:
//   L=0 → bits 20-12   (PTE table index — leaf, VPN[0])
//   L=1 → bits 29-21   (PMD table index — VPN[1])
//   L=2 → bits 38-30   (PGD table index — VPN[2], root)
// The formula is identical for x86_64 4-level, aarch64 4-level, and
// riscv64 Sv39 3-level — only the number of levels walked differs. The
// walker calls this helper inline (DRY); the self-test calls it to verify
// the bit-extraction math for a known vaddr.

fn riscv_idx(vaddr: u64, level: u32) -> u64 {
    let sh = 12 + 9 * level;
    return (vaddr >> sh) & 511;
}

// ────────────────────────────────────────────────────────────────────────────
// riscv_map_page — walk PGD→PMD→PTE (Sv39) and write the leaf PTE.
// ────────────────────────────────────────────────────────────────────────────
// Walks `levels` levels (3 for riscv64 Sv39), starting at the top (PGD =
// root) and descending to the leaf (PTE). At each intermediate level,
// reads the PTE; if the V bit (bit 0) is not set, returns WITHOUT
// mapping — the R3f walker does not allocate fresh intermediate tables
// (that needs the PMM, which is K11's job). At the leaf (level 0),
// writes the new PTE:
//     ((paddr >> 12) << 10) | (flags & 1023) | 1
//   (paddr >> 12) << 10   — place the PPN at bits 10-53
//   1023                  = 0x3FF (low 10 bits — V/R/W/X/U/G/A/D + RSW)
//   1                     = bit 0 (V — Valid bit, always set)
//
// To follow an intermediate PTE to the next-level table, the walker
// extracts the PPN field and shifts it to a PA:
//     next_pa = ((pte >> 10) & 17592186044415) << 12
//   17592186044415 = 0xFFFFFFFFFF (44-bit PPN mask, PTE bits 10-53)
// This is the same extraction that womb/kernel/arch/riscv64/pt.vuma's
// pte_addr helper does — duplicated inline here so the walker is a pure
// PMT transform without cross-file helper calls (VUMA has no import).
//
// In hosted mode, pte_read returns 0, so the walk early-exits at the first
// intermediate level. The self-test therefore only verifies index
// extraction + a no-crash call.

fn riscv_map_page(root: u64, vaddr: u64, paddr: u64, flags: u64, levels: u8) {
    let cur = root;
    let level = (levels as u32) - 1;
    while level > 0 {
        let idx = riscv_idx(vaddr, level);
        let pte_addr = cur + idx * 8;
        let pte = pte_read(pte_addr);
        if (pte & 1) == 0 {
            // V bit not set — can't allocate a fresh intermediate table
            // without the PMM (K11). Bail out without writing the leaf.
            return;
        }
        // Follow to next level: extract PPN from bits 10-53, shift to PA.
        let ppn = (pte >> 10) & 17592186044415;
        cur = ppn << 12;
        level = level - 1;
    }
    // Leaf level (level 0) — write the new PTE.
    let leaf_idx = riscv_idx(vaddr, 0);
    let leaf_addr = cur + leaf_idx * 8;
    let leaf_pte = ((paddr >> 12) << 10) | (flags & 1023) | 1;
    pte_write(leaf_addr, leaf_pte);
}

// ────────────────────────────────────────────────────────────────────────────
// riscv_translate — walk to leaf and return the mapped physical address.
// ────────────────────────────────────────────────────────────────────────────
// Same walk as riscv_map_page, but reads the leaf PTE instead of writing
// it. Returns the physical address (PPN << 12 of the leaf PTE) on
// success, or 0 if any level's PTE has V=0. The 3-level depth is
// hardcoded (riscv64 always uses Sv39; Sv48 4-level is K11+ if the
// platform advertises Sv48 in misa / isa-string CSR).
//
// Returns u64 (not State<T>) — no state-typedness propagation issue.

fn riscv_translate(root: u64, vaddr: u64) -> u64 {
    let cur = root;
    let level = 2 as u32;  // 3-level paging
    while level > 0 {
        let idx = riscv_idx(vaddr, level);
        let pte_addr = cur + idx * 8;
        let pte = pte_read(pte_addr);
        if (pte & 1) == 0 {
            return 0;
        }
        let ppn = (pte >> 10) & 17592186044415;
        cur = ppn << 12;
        level = level - 1;
    }
    // Leaf level (level 0) — read the leaf PTE and return its PA.
    let leaf_idx = riscv_idx(vaddr, 0);
    let leaf_addr = cur + leaf_idx * 8;
    let leaf_pte = pte_read(leaf_addr);
    if (leaf_pte & 1) == 0 {
        return 0;
    }
    let ppn = (leaf_pte >> 10) & 17592186044415;
    return ppn << 12;
}

// ────────────────────────────────────────────────────────────────────────────
// Self-test (the R3f DoD).
// ────────────────────────────────────────────────────────────────────────────
// Verifies:
//   (1) riscv_idx extracts the correct 9-bit index at each of the 3
//       Sv39 levels for vaddr 20015998343868 (= 0x123456789ABC). Expected
//       indices:
//         level 2 (PGD) → 209
//         level 1 (PMD) → 179
//         level 0 (PTE) → 393
//       (computed via Python: (0x123456789ABC >> (12 + 9*L)) & 511.
//        Note: the level-3 (PML4) index = 36 used by x86_64/aarch64 is
//        NOT a valid Sv39 level — Sv39 has only 3 levels — so we skip
//        that check here.)
//   (2) riscv_map_page + riscv_translate don't crash in hosted mode
//       (where pte_read returns 0, so the walk early-exits and translate
//       returns 0).
// Returns 0 on pass, 1..3 on the corresponding index-extraction failure,
// 4 on the no-crash check.

fn main() -> i32 {
    // ── Part 1: index extraction (the contract's required self-test) ───────
    let v = 20015998343868;  // 0x123456789ABC
    if riscv_idx(v, 2) != 209 { return 1; }
    if riscv_idx(v, 1) != 179 { return 2; }
    if riscv_idx(v, 0) != 393 { return 3; }

    // ── Part 2: no-crash call through the walker ───────────────────────────
    // Hosted mode: pte_read returns 0, walk early-exits at level 2 (PGD)
    // because (0 & 1) == 0. riscv_map_page returns without writing;
    // riscv_translate returns 0. The check is "did not crash + returned 0".
    riscv_map_page(0, 4096, 524288, 0, 3);
    let pa = riscv_translate(0, 4096);
    if pa != 0 { return 4; }

    return 0;
}
