// ═══════════════════════════════════════════════════════════════════════════
// womb/kernel/arch/riscv64/trap_trampoline.vuma
// riscv64 trap entry/exit trampolines — old RiscVTrapFrame + superset adapter.
// ═══════════════════════════════════════════════════════════════════════════
//
// This file is the riscv64-specific swap point for trap/IRQ handling, evolved
// through three waves:
//   K3c (initial):  declared the 35-field riscv64 TrapFrame (ra, sp, gp, tp,
//                   t0..t2, s0, s1, a0..a7, s2..s11, t3..t6, mepc, mstatus,
//                   scause, stval) + the STVEC/PLIC externs + trap_is_syscall
//                   + trap_is_page_fault helpers + a self-test that round-
//                   tripped the layout + both helpers.
//   R2a (superset): created the canonical 576-byte superset TrapFrame in
//                   womb/kernel/trap/trap_frame.vuma — a single layout that
//                   every arch's trap_entry stub populates and every arch-
//                   independent consumer reads from. The R2a Golden Rule:
//                     "Do not write arch-conditional logic inside kernel
//                      transforms."
//   R2d (this file): re-declares the superset TrapFrame + tf_get_gpr +
//                    tf_set_gpr + tf_init byte-identically from R2a, RENAMES
//                    the old 35-field riscv64 TrapFrame to RiscVTrapFrame
//                    (so the existing trap-entry stubs and K3d's trap.vuma
//                    dispatcher keep working unchanged), updates
//                    trap_is_syscall + trap_is_page_fault to read from
//                    RiscVTrapFrame, and adds the
//                    riscv_trap_to_superset(old, sup) adapter that copies
//                    fields from RiscVTrapFrame into the superset.
//
// In hosted mode every extern resolves to `__ffi_fallback_stub` (returns 0,
// void calls no-op). In bare-metal mode (Wave K11) the same names link
// against REAL asm stubs in womb/kernel/arch/riscv64/trap.S.
//
// ── RiscVTrapFrame register-save order ──────────────────────────────────────
// Unlike x86_64 (which auto-pushes SS/RSP/RFLAGS/CS/RIP) and unlike
// aarch64 (which auto-saves ELR_EL1/SPSR_EL1 to banked registers), RISC-V
// does NOT push ANY register state to memory on a trap. Instead the CPU
// writes a small fixed set of CSRs and jumps to STVEC:
//     SEPC / MEPC   ← the PC of the trapping instruction (or the next
//                     one for interrupts — RISC-V Privileged ISA §4.1.10
//                     "Supervisor Exception Program Counter" / §3.1.14
//                     "Machine Exception Program Counter")
//     SSTATUS / MSTATUS ← the prior privilege mode is captured in the
//                     SPP / MPP field, plus other status bits (§4.1.6 /
//                     §3.1.7).
//     SCAUSE / MCAUSE ← the trap cause (§4.1.11 / §3.1.12) — high bit set
//                     for interrupts, low bits hold the cause code.
//     STVAL / MTVAL ← auxiliary info (e.g. faulting vaddr for page faults,
//                     faulting instruction for illegalinsn — §4.1.13 /
//                     §3.1.13).
// The trap_entry stub then saves the GP register file by ABI name:
//     ra, sp, gp, tp, t0, t1, t2, s0, s1, a0..a7, s2..s11, t3, t4, t5, t6
//                                                 (31 words, trap_entry)
// — i.e. x1..x31 (x0 is hardwired to 0 in RISC-V and is NEVER saved).
// Total: 31 (GP) + 4 (CSR) = 35 words × 8 bytes = 280 bytes.
// (See the RiscVTrapFrame layout below for the 35 named fields.)
//
// ── Canonical GPR slot mapping for riscv64 (R2d contract) ──────────────────
// The R2d contract pins the riscv64→superset GPR mapping to the natural
// ABI-order save order (matching the existing trap_entry stub's push order
// and matching the R2a file header's documented RISC-V slot mapping):
//     slot  0 = ra     slot 11 = a2     slot 22 = s7
//     slot  1 = sp     slot 12 = a3     slot 23 = s8
//     slot  2 = gp     slot 13 = a4     slot 24 = s9
//     slot  3 = tp     slot 14 = a5     slot 25 = s10
//     slot  4 = t0     slot 15 = a6     slot 26 = s11
//     slot  5 = t1     slot 16 = a7     slot 27 = t3
//     slot  6 = t2     slot 17 = s2     slot 28 = t4
//     slot  7 = s0     slot 18 = s3     slot 29 = t5
//     slot  8 = s1     slot 19 = s4     slot 30 = t6
//     slot  9 = a0     slot 20 = s5
//     slot 10 = a1     slot 21 = s6
//   (31 registers at slots 0..30; slot 31 stays 0 from tf_init.)
//   Scalar fields:
//     sup.pc         ← old.mepc        (Machine Exception Program Counter)
//     sup.status     ← old.mstatus     (Machine Status Register)
//     sup.vector     ← old.scause      (Supervisor Cause — high bit set for
//                                       interrupts, low bits hold cause code)
//     sup.error_code ← old.stval       (Supervisor Trap Value — faulting
//                                       vaddr for page faults, etc.)
//     sup.sp         ← old.sp          (the GPR at index 2 is also "sp" per
//                                       the RISC-V ABI — this field
//                                       DUPLICATES gpr slot 1 for fast
//                                       dispatcher access without an
//                                       unpack round-trip; see R2a's
//                                       "duplicate-sp question" note)
//   NOT migrated (left 0 by tf_init):
//     sup.fpu[0..255]   — riscv64 saves F0..F31 state separately (not in
//                         the RiscVTrapFrame); a future wave may extend
//                         the save area and copy f0..f31 here.
//
// ── SCAUSE codes the dispatcher switches on ─────────────────────────────────
//   8  = Environment call from U-mode (syscall — trap_is_syscall returns 1)
//   12 = Instruction page fault
//   13 = Load page fault
//   14 = Store/AMO page fault
//   15 = (reserved in Privileged ISA 1.12, but the K3c contract maps it to
//        "Instruction page fault" — trap_is_page_fault accepts 12..15)
//
// ── Extern "C" trampolines (STVEC + PLIC + STVAL) ───────────────────────────
// Hosted: __ffi_fallback_stub (returns 0, void calls no-op). The self-
// test's main() never calls any of these. K11 swaps them for real asm
// stubs registered in src/codegen/src/riscv64.rs::build_runtime_syscall_stubs.
//     stvec_load(stvec_ptr)      — `csrw stvec, a0; ret`
//     plic_eoi(irq)              — `sw a0, PLIC_CLAIM_OFFSET(base); ret`
//     plic_mask(irq) / plic_unmask(irq)
//                                 — PLIC ENABLE register bit write
//     plic_get_irq() -> u32      — `lw a0, PLIC_CLAIM_OFFSET(base); ret`
//     stval_read() -> u64        — `csrr a0, stval; ret`
// The `irq` parameters are u32 (not u8 as on x86_64) because the PLIC
// supports up to 1024 IRQ sources.
//
// ── Why re-declare the superset here? ────────────────────────────────────────
// VUMA has no `import` (Open Work §7), so every kernel module re-declares
// the layouts it uses byte-identically. THIS file re-declares the canonical
// superset TrapFrame + tf_get_gpr + tf_set_gpr + tf_init byte-identically
// from womb/kernel/trap/trap_frame.vuma (R2a) so that the
// riscv_trap_to_superset adapter can call tf_set_gpr / write to sup.pc etc.
// against the same field offsets R2a defined.
//
// ── PMT discipline ─────────────────────────────────────────────────────────
// NO `*ptr`, `&x`, `allocate`, or `free` anywhere in this file. The
// TrapFrame and RiscVTrapFrame are flat typed-memory records held in
// `___pmt_buffer`-backed State<T> values; the caller allocates them via
// `state_new(T)` and passes them by reference to tf_init / trap_frame_init
// / riscv_trap_to_superset (init-style API — same convention as R1a's
// bootinfo_init, R2a's tf_init, R2b's x86_trap_to_superset, R2c's
// arm64_trap_to_superset). The externs' `stvec_ptr: Address` parameter is
// a plain Address (RISC-V a0), NOT a State<T> — no #[borrow] needed.
// None of the externs take a State<T> argument, so there is no
// use-after-invalidate risk from any of them.
//
// ── Decimal constants ──────────────────────────────────────────────────────
// All numeric literals in CODE are decimal (per the project-wide convention
// — see kernel-developer-guide.md §9). Hex values appear in comments only.
// The literals used in the self-test:
//     42      = 0x2a            (arbitrary ra value to round-trip via slot 0)
//     4096    = 0x1000          (arbitrary mepc value to round-trip via
//                                sup.pc — same decimal as R2b's x86_64
//                                self-test for cross-arch consistency)
//     256     = 0x100           (gpr/fpu array size — byte-loop bound)
//     8       = 0x8             (u64 pack/unpack byte count; also RISC-V
//                                syscall SCAUSE for trap_is_syscall)
//     13      = 0x0d            (RISC-V load page-fault SCAUSE)
//     12, 15  = 0x0c, 0x0f      (page-fault SCAUSE range bounds)
//     5       = 0x05            (load access fault — NOT a page fault)
//     24      = 0x18            (_pad array size — byte-loop bound)
//     255     = 0xff            (u8 mask, applied after the >> shift)
//     0..2    = self-test return codes (1..2 = individual check failures)
//
// ── Build & verify (hosted x86_64) ──────────────────────────────────────────
//     . "$HOME/.cargo/env" && CARGO_BUILD_JOBS=4 \
//         cargo build --profile release-fast --bin compile_dump
//     ./target/release-fast/compile_dump \
//         womb/kernel/arch/riscv64/trap_trampoline.vuma \
//         /tmp/trap_trampoline.bin x86_64 --verify
//     /tmp/trap_trampoline.bin ; echo "exit=$?"
// Expected: IVE Pass, exit=0 (the 2 adapter self-test checks both pass).

// ────────────────────────────────────────────────────────────────────────────
// Superset TrapFrame layout (re-declared byte-identically from R2a).
// ────────────────────────────────────────────────────────────────────────────
// 576 bytes total: 256 (gpr) + 8×5 (pc/status/vector/error_code/sp) + 256
// (fpu) + 24 (_pad). See womb/kernel/trap/trap_frame.vuma (R2a) for the
// canonical definition and full field-semantics documentation. The
// re-declaration here MUST be byte-identical (same field names, types,
// order, _pad size) so the field offsets the adapter writes match the
// offsets the arch-independent consumers read.
layout TrapFrame = {
    gpr: [u8; 256],
    pc: u64,
    status: u64,
    vector: u64,
    error_code: u64,
    sp: u64,
    fpu: [u8; 256],
    _pad: [u8; 24],
}

// ────────────────────────────────────────────────────────────────────────────
// tf_get_gpr: read the u64 GPR at canonical slot `idx` from sup.gpr.
// ────────────────────────────────────────────────────────────────────────────
// 8-byte little-endian unpack at byte offset `idx * 8`. Same loop pattern
// as task.vuma's pt_get_pid but with a u64 accumulator and an 8-byte loop
// bound. Byte-identical to R2a's tf_get_gpr (same param name, same body).
fn tf_get_gpr(tf: State<TrapFrame>, idx: u32) -> u64 {
    let off = idx * 8;
    let v: u64 = 0;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let b = tf.gpr[off + i] as u64;
        v = v + (b << sh);
        i = i + 1;
    }
    return v;
}

// ────────────────────────────────────────────────────────────────────────────
// tf_set_gpr: write the u64 `val` to canonical slot `idx` in sup.gpr.
// ────────────────────────────────────────────────────────────────────────────
// 8-byte little-endian pack at byte offset `idx * 8`. Same loop pattern
// as task.vuma's pt_set_pid but with an 8-byte loop bound. Byte-identical
// to R2a's tf_set_gpr (same param name, same body).
fn tf_set_gpr(tf: State<TrapFrame>, idx: u32, val: u64) {
    let off = idx * 8;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let b = (val >> sh) & 255;
        tf.gpr[off + i] = b as u8;
        i = i + 1;
    }
}

// ────────────────────────────────────────────────────────────────────────────
// tf_init: zero every field of a caller-allocated superset TrapFrame.
// ────────────────────────────────────────────────────────────────────────────
// Called once per TrapFrame before riscv_trap_to_superset (or any other
// arch's adapter) populates the arch-specific fields. Byte-identical to
// R2a's tf_init (same param name, same body).
fn tf_init(tf: State<TrapFrame>) {
    let i = 0;
    while i < 256 { tf.gpr[i] = 0; i = i + 1; }
    tf.pc = 0;
    tf.status = 0;
    tf.vector = 0;
    tf.error_code = 0;
    tf.sp = 0;
    let j = 0;
    while j < 256 { tf.fpu[j] = 0; j = j + 1; }
    let k = 0;
    while k < 24 { tf._pad[k] = 0; k = k + 1; }
}

// ────────────────────────────────────────────────────────────────────────────
// RiscVTrapFrame layout (the old K3c TrapFrame, renamed for R2d).
// ────────────────────────────────────────────────────────────────────────────
// 35 fields × 8 bytes = 280 bytes. The field order MUST match trap.S
// exactly (K11 will write trap.S to match). Kept byte-identical to K3c's
// TrapFrame (only the name changes), so nothing else in the kernel needs
// to change. The riscv_trap_to_superset adapter below bridges the old
// layout to the new superset.
layout RiscVTrapFrame = {
    ra: u64,        // x1  — return address
    sp: u64,        // x2  — stack pointer
    gp: u64,        // x3  — global pointer
    tp: u64,        // x4  — thread pointer
    t0: u64,        // x5  — temporary
    t1: u64,        // x6  — temporary
    t2: u64,        // x7  — temporary
    s0: u64,        // x8  — callee-saved (frame pointer)
    s1: u64,        // x9  — callee-saved
    a0: u64,        // x10 — argument / return value
    a1: u64,        // x11 — argument / return value
    a2: u64,        // x12 — argument
    a3: u64,        // x13 — argument
    a4: u64,        // x14 — argument
    a5: u64,        // x15 — argument
    a6: u64,        // x16 — argument
    a7: u64,        // x17 — argument (syscall number on RISC-V Linux)
    s2: u64,        // x18 — callee-saved
    s3: u64,        // x19 — callee-saved
    s4: u64,        // x20 — callee-saved
    s5: u64,        // x21 — callee-saved
    s6: u64,        // x22 — callee-saved
    s7: u64,        // x23 — callee-saved
    s8: u64,        // x24 — callee-saved
    s9: u64,        // x25 — callee-saved
    s10: u64,       // x26 — callee-saved
    s11: u64,       // x27 — callee-saved
    t3: u64,        // x28 — temporary
    t4: u64,        // x29 — temporary
    t5: u64,        // x30 — temporary
    t6: u64,        // x31 — temporary
    mepc: u64,      // machine exception program counter (CSR 0x341)
    mstatus: u64,   // machine status register (CSR 0x300)
    scause: u64,    // supervisor cause register (CSR 0x142)
    stval: u64,     // supervisor trap value register (CSR 0x143)
}

// ────────────────────────────────────────────────────────────────────────────
// Extern "C" trampolines — STVEC load, PLIC mask/unmask/eoi/get_irq,
// STVAL read.
// ────────────────────────────────────────────────────────────────────────────
// Hosted: __ffi_fallback_stub (returns 0, void calls no-op). K11 swaps
// these for real asm stubs registered in
// src/codegen/src/riscv64.rs::build_runtime_syscall_stubs. Kept verbatim
// from K3c — R2d does NOT touch the extern block. The `irq` parameters
// are u32 (not u8 as on x86_64) because the PLIC supports up to 1024 IRQ
// sources.
extern "C" {
    // Load the Supervisor Trap Vector Base Address Register. K11 stub:
    // `csrw stvec, a0; ret`.
    fn stvec_load(stvec_ptr: Address);
    // End-Of-Interrupt to the PLIC. K11 stub:
    // `sw a0, PLIC_CLAIM_OFFSET(hart_ctx_base); ret`.
    fn plic_eoi(irq: u32);
    // Mask an IRQ source at the PLIC. K11 stub: compute register bank =
    // irq / 32, mask bit = 1 << (irq % 32), then CLEAR the bit in the
    // PLIC's ENABLE register for that bank.
    fn plic_mask(irq: u32);
    // Unmask an IRQ source at the PLIC. Pairs with plic_mask.
    fn plic_unmask(irq: u32);
    // Read the PLIC claim register — returns the active IRQ source ID
    // (1..1023) or 0 if no IRQ is pending. K11 stub:
    // `lw a0, PLIC_CLAIM_OFFSET(hart_ctx_base); ret`.
    fn plic_get_irq() -> u32;
    // Read STVAL — the Supervisor Trap Value Register. K11 stub:
    // `csrr a0, stval; ret`.
    fn stval_read() -> u64;
}

// ────────────────────────────────────────────────────────────────────────────
// Helpers.
// ────────────────────────────────────────────────────────────────────────────
// Init-style API (caller allocates via state_new, passes by reference).
// The State<T> params here are regular VUMA-fn borrows (NOT extern
// #[borrow] — VUMA fn calls don't need the attribute, only extern "C"
// calls do).

// Initialize a RiscVTrapFrame to zeros. Writes all 35 fields to 0. Kept
// verbatim from K3c — only the param type name changes (TrapFrame →
// RiscVTrapFrame).
fn trap_frame_init(tf: State<RiscVTrapFrame>) {
    tf.ra = 0;
    tf.sp = 0;
    tf.gp = 0;
    tf.tp = 0;
    tf.t0 = 0;
    tf.t1 = 0;
    tf.t2 = 0;
    tf.s0 = 0;
    tf.s1 = 0;
    tf.a0 = 0;
    tf.a1 = 0;
    tf.a2 = 0;
    tf.a3 = 0;
    tf.a4 = 0;
    tf.a5 = 0;
    tf.a6 = 0;
    tf.a7 = 0;
    tf.s2 = 0;
    tf.s3 = 0;
    tf.s4 = 0;
    tf.s5 = 0;
    tf.s6 = 0;
    tf.s7 = 0;
    tf.s8 = 0;
    tf.s9 = 0;
    tf.s10 = 0;
    tf.s11 = 0;
    tf.t3 = 0;
    tf.t4 = 0;
    tf.t5 = 0;
    tf.t6 = 0;
    tf.mepc = 0;
    tf.mstatus = 0;
    tf.scause = 0;
    tf.stval = 0;
}

// Check whether the trap was a syscall — i.e., SCAUSE == 8 (Environment
// call from U-mode, RISC-V Privileged ISA §4.1.15). The dispatcher routes
// the syscall path on this test: read a7 (syscall number, x17), dispatch
// to the syscall table indexed by a7, write the return value to a0 (x10),
// then advance mepc by 4 (the ECALL instruction is 4 bytes — return to
// the instruction AFTER ECALL, not re-execute ECALL and re-trap forever).
// Returns u8 (1 = syscall, 0 = not syscall).
//
// Kept verbatim from K3c — only the param type name changes (TrapFrame →
// RiscVTrapFrame). riscv_trap_to_superset doesn't call this directly (it
// copies scause into sup.vector verbatim and lets the arch-independent
// dispatcher do its own EC/SCAUSE switching), but the helper is kept
// here so any arch-specific caller that still has a RiscVTrapFrame can
// use it.
fn trap_is_syscall(tf: State<RiscVTrapFrame>) -> u8 {
    return (tf.scause == 8) as u8;
}

// Check whether the trap was a page fault — i.e., SCAUSE is in 12..15
// (the four page-fault codes per the RISC-V Privileged ISA §4.1.15:
//   12 = Instruction page fault,
//   13 = Load page fault,
//   14 = Store/AMO page fault,
//   15 = (reserved in Privileged ISA 1.12, but the K3c contract's
//        "(12=instr, 13=load, 14=store, 15=instr page fault)" annotation
//        is the source of truth for this helper's range check).
// Returns u8 (1 = page fault, 0 = not page fault). Implemented as a
// nested if (NOT `c >= 12 && c <= 15`) per the K3c contract's exact
// structure.
//
// Kept verbatim from K3c — only the param type name changes (TrapFrame →
// RiscVTrapFrame). Same rationale as trap_is_syscall: kept for arch-
// specific callers that have a RiscVTrapFrame in hand.
fn trap_is_page_fault(tf: State<RiscVTrapFrame>) -> u8 {
    let c = tf.scause;
    if c >= 12 {
        if c <= 15 {
            return 1;
        }
    }
    return 0;
}

// ────────────────────────────────────────────────────────────────────────────
// riscv_trap_to_superset: copy an old RiscVTrapFrame into a superset TrapFrame.
// ────────────────────────────────────────────────────────────────────────────
// The arch-specific adapter required by R2a's contract (R2d is the riscv64
// instance; R2b is x86_64; R2c is aarch64). The CALLER allocates `old`
// (typically populated by the trap_entry stub from the live save area)
// and `sup` (typically a scratch TrapFrame on the exception stack), calls
// tf_init(sup) first to get a clean slate, then calls this adapter to
// copy fields. After this returns, `sup` is ready to be passed to any
// arch-independent consumer that takes State<TrapFrame>.
//
// Mapping (per the R2d contract — see the file header's slot table):
//   GPR slots 0..30 ← old.ra, old.sp, old.gp, old.tp, old.t0, old.t1,
//                       old.t2, old.s0, old.s1, old.a0..old.a7,
//                       old.s2..old.s11, old.t3, old.t4, old.t5, old.t6
//     (31 registers, one per slot; slot 31 stays 0 from tf_init.)
//   sup.pc         ← old.mepc
//   sup.status     ← old.mstatus
//   sup.vector     ← old.scause
//   sup.error_code ← old.stval
//   sup.sp         ← old.sp           (DUPLICATES gpr slot 1 — see the
//                                       "duplicate-sp question" note in
//                                       R2a's trap_frame.vuma header: the
//                                       RISC-V ABI's sp is also GPR index 2
//                                       which maps to superset slot 1; the
//                                       top-level sup.sp scalar is the
//                                       fast-access path the dispatcher
//                                       uses without a gpr unpack round-trip)
//   NOT migrated: fpu (the RiscVTrapFrame doesn't save F0..F31 state —
//                  a future wave may extend the save area).
//
// State<T> params: 2 (old: State<RiscVTrapFrame>, sup: State<TrapFrame>).
// Pure reads of `old.*` + pure writes to `sup.*` via tf_set_gpr +
// direct field writes. The 31 tf_set_gpr calls each do an 8-byte LE pack
// loop; the 5 scalar field assignments are single stores. No `*ptr` /
// `&x` / `allocate` anywhere.
//
// The two State<T> params pattern is precedent-set by
// womb/kernel/syscall/abi.vuma::syscall_args_from_frame
// (tf: State<TrapFrame>, args: State<SyscallArgs>) — VUMA's codegen
// tracks both States' lifetimes through regular fn calls.
fn riscv_trap_to_superset(old: State<RiscVTrapFrame>, sup: State<TrapFrame>) {
    // 31 GP registers → slots 0..30 (ABI-order save order).
    tf_set_gpr(sup, 0, old.ra);
    tf_set_gpr(sup, 1, old.sp);
    tf_set_gpr(sup, 2, old.gp);
    tf_set_gpr(sup, 3, old.tp);
    tf_set_gpr(sup, 4, old.t0);
    tf_set_gpr(sup, 5, old.t1);
    tf_set_gpr(sup, 6, old.t2);
    tf_set_gpr(sup, 7, old.s0);
    tf_set_gpr(sup, 8, old.s1);
    tf_set_gpr(sup, 9, old.a0);
    tf_set_gpr(sup, 10, old.a1);
    tf_set_gpr(sup, 11, old.a2);
    tf_set_gpr(sup, 12, old.a3);
    tf_set_gpr(sup, 13, old.a4);
    tf_set_gpr(sup, 14, old.a5);
    tf_set_gpr(sup, 15, old.a6);
    tf_set_gpr(sup, 16, old.a7);
    tf_set_gpr(sup, 17, old.s2);
    tf_set_gpr(sup, 18, old.s3);
    tf_set_gpr(sup, 19, old.s4);
    tf_set_gpr(sup, 20, old.s5);
    tf_set_gpr(sup, 21, old.s6);
    tf_set_gpr(sup, 22, old.s7);
    tf_set_gpr(sup, 23, old.s8);
    tf_set_gpr(sup, 24, old.s9);
    tf_set_gpr(sup, 25, old.s10);
    tf_set_gpr(sup, 26, old.s11);
    tf_set_gpr(sup, 27, old.t3);
    tf_set_gpr(sup, 28, old.t4);
    tf_set_gpr(sup, 29, old.t5);
    tf_set_gpr(sup, 30, old.t6);
    // Scalar fields — direct u64 stores.
    sup.pc = old.mepc;
    sup.status = old.mstatus;
    sup.vector = old.scause;
    sup.error_code = old.stval;
    sup.sp = old.sp;
}

// ────────────────────────────────────────────────────────────────────────────
// Self-test (main).
// ────────────────────────────────────────────────────────────────────────────
// Exercises the riscv_trap_to_superset adapter end-to-end:
//   1. Allocate a RiscVTrapFrame `old`, zero it via trap_frame_init.
//   2. Allocate a TrapFrame `sup`, zero it via tf_init.
//   3. Set old.ra = 42, old.mepc = 4096 (representative GPR + scalar values
//      — 42 is the same decimal constant R2a's trap_frame.vuma self-test
//      uses for slot-0 round-trip; 4096 matches R2b's x86_64 self-test for
//      cross-arch consistency on the PC-field value).
//   4. Call riscv_trap_to_superset(old, sup).
//   5. Verify tf_get_gpr(sup, 0) == 42 — confirms the ra → slot 0 mapping
//      + the 8-byte LE pack/unpack round-trip through the adapter.
//   6. Verify sup.pc == 4096 — confirms the old.mepc → sup.pc scalar field
//      copy.
//
// Returns 0 on success, 1..2 on the corresponding failure (so a future CI
// failure pinpoints the broken check):
//   1: tf_get_gpr(sup, 0) != 42 after riscv_trap_to_superset
//   2: sup.pc != 4096 after riscv_trap_to_superset
//
// Per the R2d contract's "Use decimal constants" rule: all non-zero
// constants in the self-test use DECIMAL (42, 4096 — not 0x2a, 0x1000).
fn main() -> i32 {
    let old = state_new(RiscVTrapFrame);
    trap_frame_init(old);
    let sup = state_new(TrapFrame);
    tf_init(sup);
    old.ra = 42;
    old.mepc = 4096;
    riscv_trap_to_superset(old, sup);
    if tf_get_gpr(sup, 0) != 42 { return 1; }
    if sup.pc != 4096 { return 2; }
    return 0;
}
