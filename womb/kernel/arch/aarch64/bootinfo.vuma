// ═══════════════════════════════════════════════════════════════════════════
// womb/kernel/arch/aarch64/bootinfo.vuma
// aarch64 bootinfo — populates the canonical superset BootInfo from DTB.
// ═══════════════════════════════════════════════════════════════════════════
//
// This file is the aarch64 arch-side companion to womb/kernel/bootinfo.vuma
// (the canonical superset). It re-declares the superset BootInfo layout
// byte-identically (VUMA has no `import` — see kernel-developer-guide.md §9
// "Byte-identical re-declaration invariant"), then provides:
//
//   bootinfo_init(bi)
//       The same zero-all-fields helper as the canonical file. Re-declared
//       here so this file compiles standalone.
//
//   arm64_bootinfo_init(bi, dtb_addr, mem_start, mem_size)
//       aarch64-specific init: calls bootinfo_init first (clean slate),
//       then sets boot_type=1 (dtb), and records the device tree blob
//       address plus the usable-RAM window in mem_start/mem_size.
//
//       The DTB parser is stubbed for hosted mode: the caller passes the
//       dtb_addr (typically x0 at kernel entry, per the aarch64 boot
//       protocol — ARM DEN0048C §3 / Documentation/arm64/booting.rst) and
//       the RAM window directly. K13+ will replace the stub with a real
//       flat device-tree walker (parse the DTB magic 0xd00dfeed, walk the
//       /memory@n/reg properties, walk /chosen/bootargs for cmdline, walk
//       /chosen/framebuffer for fb_* — all PMT-pure typed-memory views).
//
// ── aarch64 boot protocol recap (for K13+ implementer) ──────────────────────
//   At kernel entry on aarch64 (EL1 or EL2, per bootloader policy), the
//   CPU registers contain:
//     X0 = physical address of the device tree blob (DTB).
//     X1 = 0 (reserved — historically "board id" on 32-bit ARM, must be 0
//           on arm64; Linux arm64 ignores it).
//     X2 = 0 (reserved).
//     X3 = 0 (reserved).
//   The DTB is a flat, hierarchical binary structure (Devicetree Spec
//   v0.4 §5):
//     offset 0   u32  magic         (0xd00dfeed = 3735905741 decimal)
//     offset 4   u32  totalsize     (size of the entire DTB in bytes)
//     offset 8   u32  off_dt_struct (offset to the structure block)
//     offset 12  u32  off_dt_strings(offset to the strings block)
//     offset 16  u32  off_mem_rsvmap (offset to the memory-reservation
//                                     block — array of u64 addr/size pairs
//                                     terminated by a 0,0 pair)
//     offset 20  u32  version       (DTB spec version, currently 17)
//     ...
//   The structure block is a sequence of tokens:
//     0x1 = FDT_BEGIN_NODE   (followed by NUL-terminated node name + pad)
//     0x2 = FDT_END_NODE
//     0x3 = FDT_PROP         (followed by u32 len, u32 nameoff, then
//                              `len` bytes of property data + pad to 4)
//     0x4 = FDT_NOP
//     0x9 = FDT_END          (terminates the structure block)
//   The strings block is a packed array of NUL-terminated property-name
//   strings, addressed by 32-bit byte offsets from off_dt_strings.
//
//   The K13+ real implementation:
//     1. Verify DTB magic at dtb_addr == 3735905741 (0xd00dfeed).
//     2. Walk the reservation block — record any reserved region so kmain
//        doesn't allocate over it. (Wave R1a's superset BootInfo has no
//        reservation field; K13+ may add one, or kmain can walk the DTB
//        itself.)
//     3. Walk the structure block — for each node:
//          /memory@n with property "reg" — read u64 base + u64 size (or
//            two u32 cells each on 32-bit cells-per-address-size settings,
//            but arm64 standard is #address-cells=2, #size-cells=2), pick
//            the largest RAM region, set mem_start/mem_size.
//          /chosen with property "bootargs" — set bi.cmdline = prop_data_addr.
//          /chosen with property "linux,initrd-start"/"linux,initrd-end" —
//            record initramfs location (K13+).
//          /chosen/framebuffer (or /framebuffer) with properties "width",
//            "height", "reg" — set bi.framebuffer / fb_width / fb_height.
//     4. Set bi.boot_type = 1 (dtb).
//
//   For now (hosted mode / Wave R1b), the stub just stores the caller-
//   supplied dtb_addr / mem_start / mem_size unchanged and leaves
//   cmdline/framebuffer at 0. The stub is sufficient for kmain's hosted-
//   mode smoke tests (which only read boot_type/mem_start/mem_size/dtb_addr).
//
// ── PMT discipline ──────────────────────────────────────────────────────────
//   NO `*ptr`, `&x`, `allocate`, or `free` anywhere in this file. The
//   BootInfo is a flat typed-memory record; the caller allocates it via
//   `state_new(BootInfo)` and passes it by reference to arm64_bootinfo_init
//   (init-style API — same convention as the canonical file).
//
//   In particular, the K13+ DTB parser will NOT use raw pointer arithmetic
//   to walk the DTB — it will construct `layout FdtHeader = { magic: u32,
//   totalsize: u32, ... }` and `layout FdtProp = { len: u32, nameoff: u32 }`
//   views over the dtb_addr region and use typed field access. (This is the
//   same PMT pattern K9a uses for sk_buff views: define a layout, cast the
//   State to it, read fields by name.)
//
// ── Decimal constants ──────────────────────────────────────────────────────
//   All numeric literals in this file are decimal (per the project-wide
//   convention). Hex values are documented in comments only.
//     1073741824  = 0x40000000     (1 GB — typical aarch64 RAM base/size
//                                    in QEMU `-M virt` configurations and
//                                    the self-test's dtb_addr/mem_start)
//     268435456   = 0x10000000     (256 MB — self-test mem_size)
//     3735905741  = 0xd00dfeed     (DTB magic — K13+ parser checks this)
//
// ── Build & verify (hosted x86_64) ──────────────────────────────────────────
//     . "$HOME/.cargo/env" && CARGO_BUILD_JOBS=4 \
//         cargo build --profile release-fast --bin compile_dump
//     ./target/release-fast/compile_dump \
//         womb/kernel/arch/aarch64/bootinfo.vuma \
//         /tmp/arm64_bootinfo.bin x86_64 --verify
//     /tmp/arm64_bootinfo.bin ; echo "exit=$?"
// Expected: IVE Pass, exit=0 (arm64_bootinfo_init sets boot_type=1,
// dtb_addr=1073741824, mem_start=1073741824, mem_size=268435456; the 4
// self-test checks pass).
//
// Cross-arch sanity (the file should also IVE-verify on aarch64 itself —
// the superset layout is genuinely arch-independent):
//     ./target/release-fast/compile_dump \
//         womb/kernel/arch/aarch64/bootinfo.vuma \
//         /tmp/arm64_bootinfo_native.bin aarch64 --verify
// (Binary can't EXEC on this x86 host — exit 126 "Exec format error" — but
// the IVE verification step is what matters for arch-independence.)

// ────────────────────────────────────────────────────────────────────────────
// Layout — Canonical superset BootInfo (byte-identical re-declaration).
// ────────────────────────────────────────────────────────────────────────────
// MUST match womb/kernel/bootinfo.vuma byte-for-byte (same field order,
// same types, same names). Any drift would silently produce different
// field offsets at the call site — see kernel-developer-guide.md §9.
layout BootInfo = {
    mem_start: u64,
    mem_size: u64,
    cmdline: u64,
    dtb_addr: u64,
    multiboot_magic: u64,
    framebuffer: u64,
    fb_width: u32,
    fb_height: u32,
    boot_type: u8,
    _pad: [u8; 7],
}

// ────────────────────────────────────────────────────────────────────────────
// bootinfo_init: zero every field of a caller-allocated BootInfo.
// ────────────────────────────────────────────────────────────────────────────
// Same as the canonical womb/kernel/bootinfo.vuma::bootinfo_init —
// re-declared here so this file compiles standalone. arm64_bootinfo_init
// calls this first to get a clean slate before populating aarch64-specific
// fields.
fn bootinfo_init(bi: State<BootInfo>) {
    bi.mem_start = 0;
    bi.mem_size = 0;
    bi.cmdline = 0;
    bi.dtb_addr = 0;
    bi.multiboot_magic = 0;
    bi.framebuffer = 0;
    bi.fb_width = 0;
    bi.fb_height = 0;
    bi.boot_type = 0;
    let i = 0;
    while i < 7 {
        bi._pad[i] = 0;
        i = i + 1;
    }
}

// ────────────────────────────────────────────────────────────────────────────
// arm64_bootinfo_init: populate the superset BootInfo from aarch64 boot regs.
// ────────────────────────────────────────────────────────────────────────────
//   bi         caller-allocated State<BootInfo> (modified in place).
//   dtb_addr   physical address of the device tree blob (X0 at kernel entry
//              per the aarch64 boot protocol — ARM DEN0048C §3). Stored
//              unchanged in bi.dtb_addr so kmain can later pass it to the
//              DTB parser (K13+).
//   mem_start  start of usable RAM (physical byte address). On arm64 QEMU
//              `-M virt` this is typically 0x40000000 (= 1073741824); on
//              real hardware it's whatever /memory@n/reg in the DTB says.
//              Stored unchanged in bi.mem_start.
//   mem_size   size of usable RAM in bytes. Stored unchanged in bi.mem_size.
//
// Behavior:
//   1. bootinfo_init(bi)    — zero everything (clean slate).
//   2. bi.boot_type = 1     — dtb (aarch64).
//   3. bi.dtb_addr = dtb_addr.
//   4. bi.mem_start = mem_start.
//   5. bi.mem_size  = mem_size.
//   6. (K13+) Parse DTB at dtb_addr → cmdline (from /chosen/bootargs),
//      framebuffer / fb_width / fb_height (from /chosen/framebuffer or
//      /framebuffer), refine mem_start/mem_size from /memory@n/reg.
//
// State<T> params: 1 (bi). The dtb_addr / mem_start / mem_size params are
// pure u64 values (no State indirection). The body is 4 field writes after
// the bootinfo_init call — pure typed-memory writes, no pointer ops.
fn arm64_bootinfo_init(bi: State<BootInfo>, dtb_addr: u64, mem_start: u64, mem_size: u64) {
    bootinfo_init(bi);
    bi.boot_type = 1;            // dtb (aarch64)
    bi.dtb_addr = dtb_addr;
    bi.mem_start = mem_start;
    bi.mem_size = mem_size;
    // Stub: the K13+ real implementation will walk the DTB at dtb_addr to
    // extract cmdline (from /chosen/bootargs), framebuffer info, and
    // refine mem_start/mem_size from /memory@n/reg. For now the caller
    // passes mem_start/mem_size directly — sufficient for hosted mode.
}

// ────────────────────────────────────────────────────────────────────────────
// Self-test (main).
// ────────────────────────────────────────────────────────────────────────────
// Exercises the arm64_bootinfo_init API end-to-end:
//   1. Allocate a fresh BootInfo.
//   2. arm64_bootinfo_init(bi, 1073741824, 1073741824, 268435456)
//        dtb_addr   = 0x40000000 = 1073741824  (typical arm64 RAM base)
//        mem_start  = 0x40000000 = 1073741824  (same — QEMU `-M virt`)
//        mem_size   = 0x10000000 = 268435456   (256 MB)
//   3. Check boot_type  == 1          (dtb).
//   4. Check dtb_addr   == 1073741824 (0x40000000).
//   5. Check mem_start  == 1073741824 (0x40000000).
//   6. Check mem_size   == 268435456  (0x10000000).
//
// Returns 0 on success, 1..4 on the 4 individual check failures:
//   1: boot_type != 1
//   2: dtb_addr  != 1073741824
//   3: mem_start != 1073741824
//   4: mem_size  != 268435456
fn main() -> i32 {
    let bi = state_new(BootInfo);
    arm64_bootinfo_init(bi, 1073741824, 1073741824, 268435456);
    if bi.boot_type != 1 { return 1; }
    if bi.dtb_addr != 1073741824 { return 2; }
    if bi.mem_start != 1073741824 { return 3; }
    if bi.mem_size != 268435456 { return 4; }
    return 0;
}
