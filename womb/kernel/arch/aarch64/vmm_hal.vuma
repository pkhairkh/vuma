// ═══════════════════════════════════════════════════════════════════════════
// womb/kernel/arch/aarch64/vmm_hal.vuma
// aarch64 VMM HAL — page-table walker (PGD→PUD→PMD→PTE, 4 KB granule) for
// the R3b dispatcher's arm_map_page / arm_translate entry points.
// ═══════════════════════════════════════════════════════════════════════════
//
// Wave R3e. Implements the aarch64 half of the R3b HAL boundary:
//   - arm_map_page(root, vaddr, paddr, flags, levels) — walk PGD→PUD→PMD→PTE,
//     write the leaf PTE.
//   - arm_translate(root, vaddr) — walk to leaf, return the mapped paddr.
//
// These are REAL VUMA functions (PMT transforms), NOT externs. The walker
// owns its own page-table interpretation (ARMv8 ARM D8.2 stage-1 VMSAv8-64
// 4-level paging with 4 KB granule). The only externs declared here are
// pte_read / pte_write — the raw 8-byte MMIO load/store at a physical
// address (real asm stub in K11 bare-metal, __ffi_fallback_stub returns
// 0 / no-op in hosted mode).
//
// aarch64 4-level paging geometry (ARMv8 ARM D8.2, 4 KB granule):
//     PGD (level 3) — bits 47-39 of vaddr → next-level PUD
//     PUD (level 2) — bits 38-30          → next-level PMD
//     PMD (level 1) — bits 29-21          → next-level PTE
//     PTE (level 0) — bits 20-12          → leaf, points at a 4 KB page
// Each level's index is 9 bits wide; 512 8-byte PTEs fit in one 4 KB page.
// The 9-bit index for level L is at vaddr bits (12 + 9*L) .. (12 + 9*L + 8)
// — identical bit-math to x86_64 4-level paging. Only the PTE format
// differs (aarch64 uses the ARMv8 stage-1 descriptor format with the
// Access Flag in bit 9, not the x86_64 P/R/W/U bits in 0-2).
//
// Leaf PTE format (ARMv8 ARM D8.2.2, level-3 "page descriptor"):
//     bits 0-1   Descriptor type — 0b11 = page descriptor (level 3 leaf)
//     bits 2-11  attribute bits (MemAttr, NS, AP, Shareability, AF, nG, ...)
//     bits 12-47 Output address (36 bits, 4 KB-aligned)
//     bit 51     PXN
//     bit 54     UXN
// The leaf PTE written by arm_map_page is:
//     (paddr & 281474976706560) | (flags & 4095) | 3 | 512
// where:
//     281474976706560 = 0x0000FFFFFFFFF000  (bits 12-47 — output addr mask)
//     4095            = 0xFFF               (low 12 bits — flag/attr byte)
//     3               = 0b11                (descriptor type = page/table)
//     512             = 0x200               (AF bit, bit 9 — must be 1 or
//                                            hardware faults with AF fault)
//
// Intermediate-PTE "present" check: descriptor type != 0 (bits 0-1).
// (pte & 3) == 0 → invalid descriptor → walker returns without mapping.
// Allocating a fresh intermediate page requires the PMM, which the R3e
// walker does NOT pull in (it stays a pure PMT transform over `pte_read` /
// `pte_write`). K11 wires the PMM and adds the allocation step.
//
// ── PMT discipline ─────────────────────────────────────────────────────────
// NO `*ptr`, `&x`, `allocate`, or `free` anywhere in this file. The walker
// manipulates plain u64 scalars (root, vaddr, paddr, flags, level, idx,
// pte_addr, pte) — no State<T> buffer is needed because the page-table
// pages live in physical memory reached via `pte_read` / `pte_write`
// (extern MMIO), not in the ___pmt_buffer arena. VmmNode + VmmSpace are
// re-declared here only so a future kmain.vuma that re-typing them
// byte-identically can refer to them; the walker itself takes `root: u64`
// (matching the R3b extern signature).
//
// ── Why re-declare VmmNode + VmmSpace? ──────────────────────────────────────
// VUMA has no `import` (Open Work §7). Every kernel module re-declares the
// layouts it uses byte-identically (same pattern as
// womb/kernel/arch/aarch64/mm_trampoline.vuma re-declaring PageTable). The
// layouts below MUST match womb/kernel/mm/vmm.vuma (R3b):
//     layout VmmNode  = { entries: [u8; 4096] }
//     layout VmmSpace = { root: u64, levels: u8, arch: u8, _pad: [u8; 6] }
//
// ── Why re-declare PageTableEntry? ──────────────────────────────────────────
// Same reason — byte-identical to womb/kernel/arch/aarch64/pt.vuma (K2d):
//     layout PageTableEntry = { raw: u64 }
// The walker doesn't actually USE State<PageTableEntry> (PTEs are passed
// around as raw u64s — they fit in a register), but the layout is declared
// so a future caller that wants to pack/unpack a PTE structurally can.
//
// ── Decimal-constants table (VUMA accepts 0x.. too, but decimal is safer) ──
//   511                = 0x1FF                  (9-bit index mask)
//   4095               = 0xFFF                  (low 12 bits — flag/attr byte)
//   281474976706560    = 0x0000FFFFFFFFF000     (output addr bits 12-47)
//   17592186044415     = 0xFFFFFFFFFF           (44-bit PPN mask — NOT used
//                                                 here; documented for
//                                                 reference. The aarch64 PA
//                                                 mask is 36 bits, not 44.)
//   20015998343868     = 0x123456789ABC         (self-test vaddr)
//   524288             = 0x80000                (self-test paddr — 512 KB)
//   4096               = 0x1000                 (self-test vaddr #2 — 4 KB)
//   512                = 512                    (PTEs per 4 KB table)
//   8                  = 8                      (bytes per PTE)
//   3                  = 0b11                   (descriptor type = page/table)
//   512                = 0x200                  (AF bit, bit 9)
//   3                  = 3                      (top level for 4-level paging)
//
// ── Build & verify (hosted x86_64 — real bare-metal testing is K11's job
//    on aarch64) ────────────────────────────────────────────────────────────
//     ./target/release-fast/compile_dump \
//         womb/kernel/arch/aarch64/vmm_hal.vuma \
//         /tmp/vmm_hal.bin x86_64 --verify
//     /tmp/vmm_hal.bin ; echo "exit=$?"
// Expected: IVE Pass, exit=0
//
// In hosted mode, pte_read returns 0 (__ffi_fallback_stub), so the walk
// early-exits at the first intermediate level (descriptor type == 0) and
// arm_translate returns 0. The self-test therefore verifies INDEX
// EXTRACTION (the arch-independent bit math, which the walker uses inline)
// plus a no-crash call through arm_map_page / arm_translate.

// ────────────────────────────────────────────────────────────────────────────
// Layouts (re-declared byte-identically to womb/kernel/mm/vmm.vuma R3b
// and womb/kernel/arch/aarch64/pt.vuma K2d).
// ────────────────────────────────────────────────────────────────────────────

// Generic page-table node — 4096 bytes (one page). The walker treats this
// as an opaque byte array (it never instantiates State<VmmNode> — the
// page-table pages are reached via `pte_read` / `pte_write` at physical
// addresses, not via the arena). Declared here for callers that want to
// allocate page-table pages from the PMM as VmmNodes.
layout VmmNode = {
    entries: [u8; 4096],
}

// VMM address space — root + arch info. `root` is the physical address of
// the PGD table (TTBR0_EL1 or TTBR1_EL1 points here). `levels` is 4 for
// aarch64 4-level paging. `arch` is 1 (aarch64). `_pad` pads to 16 bytes.
// The walker takes `root: u64` (not State<VmmSpace>) to match the R3b
// extern signature; VmmSpace is declared here for callers.
layout VmmSpace = {
    root: u64,
    levels: u8,
    arch: u8,
    _pad: [u8; 6],
}

// ARMv8 Page Table Entry — 8 bytes, stored as a u64. See
// womb/kernel/arch/aarch64/pt.vuma for the field-access helpers
// (pte_valid / pte_accessible / pte_make / etc.). This walker uses raw
// u64 arithmetic inline rather than calling those helpers — the walker
// only needs the descriptor type (bits 0-1) and the output-address mask
// (bits 12-47), so the inline form is shorter and easier to audit.
layout PageTableEntry = { raw: u64 }

// ────────────────────────────────────────────────────────────────────────────
// Extern "C" — raw PTE access (real MMIO in bare-metal, stubs in hosted).
// ────────────────────────────────────────────────────────────────────────────
// Hosted: __ffi_fallback_stub — pte_read returns 0, pte_write is a no-op.
// K11 bare-metal: direct 8-byte load/store at the PTE's physical address
// (aarch64 page tables live in regular memory, reached via the kernel's
// identity-mapped physmem window OR with TTBR0/1-aware translation — K11's
// job to register the stub). The walker does the address arithmetic
// (root + idx * 8) itself; the externs are pure load/store at a u64.
extern "C" {
    // Read an 8-byte PTE at physical address `addr`. Returns the raw u64.
    fn pte_read(addr: u64) -> u64;
    // Write an 8-byte PTE value `val` at physical address `addr`.
    fn pte_write(addr: u64, val: u64);
}

// ────────────────────────────────────────────────────────────────────────────
// arm_idx — extract the 9-bit page-table index for a given walk level.
// ────────────────────────────────────────────────────────────────────────────
// For walk level L (0..levels-1), the 9-bit index occupies bits
// (12 + 9*L) .. (12 + 9*L + 8) of the virtual address:
//   L=0 → bits 20-12   (PTE table index — leaf)
//   L=1 → bits 29-21   (PMD table index)
//   L=2 → bits 38-30   (PUD table index)
//   L=3 → bits 47-39   (PGD table index)
// The formula is identical for x86_64 4-level, aarch64 4-level, and
// riscv64 Sv39 3-level — only the number of levels walked differs. The
// walker calls this helper inline (DRY); the self-test calls it to verify
// the bit-extraction math for a known vaddr.

fn arm_idx(vaddr: u64, level: u32) -> u64 {
    let sh = 12 + 9 * level;
    return (vaddr >> sh) & 511;
}

// ────────────────────────────────────────────────────────────────────────────
// arm_map_page — walk PGD→PUD→PMD→PTE and write the leaf PTE.
// ────────────────────────────────────────────────────────────────────────────
// Walks `levels` levels (4 for aarch64 4-level paging), starting at the
// top (PGD = root) and descending to the leaf (PTE). At each intermediate
// level, reads the PTE; if the descriptor type is invalid (bits 0-1 == 0),
// returns WITHOUT mapping — the R3e walker does not allocate fresh
// intermediate tables (that needs the PMM, which is K11's job). At the
// leaf (level 0), writes the new PTE:
//     (paddr & 281474976706560) | (flags & 4095) | 3 | 512
//   281474976706560 = 0x0000FFFFFFFFF000 (output addr bits 12-47)
//   4095            = 0xFFF               (low 12 bits — flag/attr byte)
//   3               = 0b11                (descriptor type — page/table)
//   512             = 0x200               (AF bit, bit 9 — avoids AF fault)
//
// In hosted mode, pte_read returns 0, so the walk early-exits at the first
// intermediate level. The self-test therefore only verifies index
// extraction + a no-crash call.

fn arm_map_page(root: u64, vaddr: u64, paddr: u64, flags: u64, levels: u8) {
    let cur = root;
    let level = (levels as u32) - 1;
    while level > 0 {
        let idx = arm_idx(vaddr, level);
        let pte_addr = cur + idx * 8;
        let pte = pte_read(pte_addr);
        if (pte & 3) == 0 {
            // Invalid descriptor — can't allocate a fresh intermediate
            // table without the PMM (K11). Bail out without writing the
            // leaf.
            return;
        }
        // Follow to next level: PTE bits 12-47 are the next table's PA.
        cur = pte & 281474976706560;
        level = level - 1;
    }
    // Leaf level (level 0) — write the new PTE.
    let leaf_idx = arm_idx(vaddr, 0);
    let leaf_addr = cur + leaf_idx * 8;
    let leaf_pte = (paddr & 281474976706560) | (flags & 4095) | 3 | 512;
    pte_write(leaf_addr, leaf_pte);
}

// ────────────────────────────────────────────────────────────────────────────
// arm_translate — walk to leaf and return the mapped physical address.
// ────────────────────────────────────────────────────────────────────────────
// Same walk as arm_map_page, but reads the leaf PTE instead of writing
// it. Returns the output address (bits 12-47 of the leaf PTE) on success,
// or 0 if any level's descriptor is invalid. The 4-level depth is
// hardcoded (aarch64 always uses 4-level paging with a 4 KB granule;
// 5-level FEAT_LPA and 3-level 64 KB-granule variants are K11+ if needed).
//
// Returns u64 (not State<T>) — no state-typedness propagation issue.

fn arm_translate(root: u64, vaddr: u64) -> u64 {
    let cur = root;
    let level = 3 as u32;
    while level > 0 {
        let idx = arm_idx(vaddr, level);
        let pte_addr = cur + idx * 8;
        let pte = pte_read(pte_addr);
        if (pte & 3) == 0 {
            return 0;
        }
        cur = pte & 281474976706560;
        level = level - 1;
    }
    // Leaf level (level 0) — read the leaf PTE and return its output addr.
    let leaf_idx = arm_idx(vaddr, 0);
    let leaf_addr = cur + leaf_idx * 8;
    let leaf_pte = pte_read(leaf_addr);
    if (leaf_pte & 3) == 0 {
        return 0;
    }
    return leaf_pte & 281474976706560;
}

// ────────────────────────────────────────────────────────────────────────────
// Self-test (the R3e DoD).
// ────────────────────────────────────────────────────────────────────────────
// Verifies:
//   (1) arm_idx extracts the correct 9-bit index at each of the 4 levels
//       for vaddr 20015998343868 (= 0x123456789ABC). Expected indices:
//         level 3 (PGD) → 36
//         level 2 (PUD) → 209
//         level 1 (PMD) → 179
//         level 0 (PTE) → 393
//       (computed via Python: (0x123456789ABC >> (12 + 9*L)) & 511.)
//   (2) arm_map_page + arm_translate don't crash in hosted mode (where
//       pte_read returns 0, so the walk early-exits and translate
//       returns 0).
// Returns 0 on pass, 1..4 on the corresponding index-extraction failure,
// 5 on the no-crash check.

fn main() -> i32 {
    // ── Part 1: index extraction (the contract's required self-test) ───────
    let v = 20015998343868;  // 0x123456789ABC
    if arm_idx(v, 3) != 36 { return 1; }
    if arm_idx(v, 2) != 209 { return 2; }
    if arm_idx(v, 1) != 179 { return 3; }
    if arm_idx(v, 0) != 393 { return 4; }

    // ── Part 2: no-crash call through the walker ───────────────────────────
    // Hosted mode: pte_read returns 0, walk early-exits at level 3 (PGD)
    // because (0 & 3) == 0. arm_map_page returns without writing;
    // arm_translate returns 0. The check is "did not crash + returned 0".
    arm_map_page(0, 4096, 524288, 0, 4);
    let pa = arm_translate(0, 4096);
    if pa != 0 { return 5; }

    return 0;
}
