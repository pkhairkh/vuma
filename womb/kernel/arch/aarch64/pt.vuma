// ═══════════════════════════════════════════════════════════════════════════
// womb/kernel/arch/aarch64/pt.vuma
// aarch64 Page Table Entry layout + field helpers (PMT-pure).
// ═══════════════════════════════════════════════════════════════════════════
//
// Defines the ARMv8 stage-1 4KB-granule PTE bit layout (ARMv8 ARM D8.2,
// "Stage-1 VMSAv8-64 Block and Table descriptors") and a small set of
// pure helpers that extract or assemble the individual fields. The PTE
// itself is a single u64 — VUMA has no bitfield type, so the helpers
// operate on the raw u64 and apply masks and shifts.
//
// Bit layout of a 64-bit ARMv8 stage-1 descriptor (4KB granule,
// ARMv8 ARM D8.2.1 "Table descriptor" + D8.2.2 "Block descriptor"):
//     bits 0-1   Descriptor type
//                  0b00 = invalid
//                  0b01 = reserved (was block in stage-2)
//                  0b10 = block descriptor (level 1/2 only)
//                  0b11 = table descriptor (any level except leaf)
//     bit 2      MemAttr[0]  (MAIR attribute index, low bit)
//     bit 3      MemAttr[1]  (MAIR attribute index, high bit)
//     bit 4      Non-secure (NS) — accesses go to non-secure PA space
//     bit 5      AP[1]      — 0=read-only, 1=read/write
//     bit 6      AP[2]      — 0=EL1-only, 1=EL0-accessible
//     bit 7      Shareability[0]  (0b00=Non-shareable, 0b10=Outer,
//                                  0b11=Inner)
//     bit 8      Shareability[1]
//     bit 9      AF         — Access Flag (must be 1 or take an AF fault)
//     bit 10     nG         — Not Global (ASID-tagged if 1)
//     bits 11-14 various attrs (PXB at L1/L2, contiguous hint, etc.)
//     bits 12-47 Output address  (36 bits, 4KB-aligned)
//     bits 48-50 reserved
//     bit 51     PXN        — Privileged Execute Never
//     bits 52-53 reserved (Contiguous, DBM at some levels)
//     bit 54     UXN / XN   — User (or Unprivileged) Execute Never
//     bits 55-63 reserved / available
//
// Field bit positions (decimal constants — VUMA accepts 0x hex too, but
// decimal is safer because the parser's hex-literal path goes through
// `parse_int_radix` which is shared with the regular integer path and
// any width-extension subtlety would bite us at compile time; decimal
// avoids that surface):
//     TYPE_MASK = 3                       (bits 0-1)
//     AF        = 512                     (bit 9, 0x200)
//     UXN_BIT   = 18014398509481984       (bit 54, 0x40000000000000)
//     PXN_BIT   = 2251799813685248        (bit 51, 0x800000000000)
//
// Key masks:
//     4095               = 0xFFF                  (low 12 bits — flags)
//     281474976706560    = 0x0000FFFFFFFFF000     (output address bits 12-47,
//                                                 36-bit PA space)
//
// Build & run self-test (hosted x86_64 — these declarations are pure
// type+extern, real bare-metal testing is K11's job on aarch64):
//     ./target/release-fast/compile_dump \
//         womb/kernel/arch/aarch64/pt.vuma /tmp/pt.bin x86_64 --verify
//     /tmp/pt.bin ; echo "exit=$?"
// Expected exit: 0
//
// ── PMT discipline ─────────────────────────────────────────────────────────
// NO `*ptr`, `&x`, `allocate`, or `free` anywhere in this file. All data
// is plain u64 scalars manipulated with bitwise arithmetic — no storage
// needs to live in a State<T> buffer here, since the PTE is just a u64.
//
// ── Why no State<PageTableEntry>? ──────────────────────────────────────────
// The contract specifies `layout PageTableEntry = { raw: u64 }`. This is
// declared verbatim below so consumers can refer to it, but the helpers
// themselves take/return raw u64 — PTEs in VUMA are most naturally
// passed as scalars (they fit in a register), and the State<T> machinery
// is reserved for multi-word structures that the PMT codegen can't keep
// in a single SSA value. See womb/kernel/mm/vmm.vuma for the State-backed
// PageTable (root_phys + levels) — that's the structure that NEEDS State.
//
// ── Deviation from the contract example ────────────────────────────────────
// The K2d contract's "Key decimal constants" section says:
//     17592186044415 = 0x0000FFFFFFFFF000 (bits 12-47, aarch64 output
//                                           address)
// and the contract example `pte_addr` body returns
//     pte & 17592186044415
// The DECIMAL VALUE IS WRONG: 17592186044415 actually equals
// 0x0FFFFFFFFFFFF (bits 0-43), NOT 0x0000FFFFFFFFF000 (bits 12-47).
// The correct decimal for the bits-12-47 mask is 281474976706560
// (= 0x0000FFFFFFFFF000). This is the SAME shape of bug as K2c's x86_64
// contract had (see worklog.md K2c §"Deviation from the contract
// example" — there the contract decimal covered bits 0-51, here it
// covers bits 0-43, but the prose intent was the page-aligned PA mask
// in both cases).
//
// Why we MUST deviate: the self-test immediately asserts
//     pte_addr(pte_make(1048576, 0)) == 1048576
// pte_make(1048576, 0) = (1048576 & MASK) | (0 & 4095) | 3 | 512
//                      = 1048576 | 3 | 512 = 1049091 (0x100203)
// because pte_make ORs in the descriptor-type bits (0b11 = 3) and the
// Access Flag (bit 9 = 512). With the contract's mask
// 17592186044415 (bits 0-43), pte_addr would return 1049091 (the flag
// bits leak through), NOT 1048576 — the self-test would fail with
// exit=3, violating the DoD ("pt.vuma self-test exits 0").
//
// The correct mask 281474976706560 covers ONLY bits 12-47 (the 4KB-
// aligned output address), so the flag bits 0-11 are stripped and
// pte_addr(pte_make(p, f)) == p for any p in bits 12-47. The contract's
// PROSE description ("bits 12-47, 4KB-aligned, 36-bit PA") is honored
// exactly — only the contract's example BODY constant was buggy.
// pte_make uses the SAME mask to sanitize its paddr argument, so build
// and read are symmetric and the round-trip is clean.
//
// ── VUMA has no `import` ────────────────────────────────────────────────────
// This file is self-contained. A future kmain.vuma that wants to build
// PTEs must re-declare the masks and helpers it uses (same pattern as
// womb/kernel/arch/x86_64/pt.vuma re-declaring its masks).

// ────────────────────────────────────────────────────────────────────────────
// Layouts.
// ────────────────────────────────────────────────────────────────────────────

// ARMv8 Page Table Entry — 8 bytes, stored as a u64. The helpers below
// extract/set individual fields via masks and shifts; nothing else needs
// the struct-typed access path, so the layout is intentionally minimal.
layout PageTableEntry = { raw: u64 }

// ────────────────────────────────────────────────────────────────────────────
// Field-access helpers.
// ────────────────────────────────────────────────────────────────────────────
// All return u8 (for single-bit flags) or u64 (for the address field).
// Bit-test helpers return 0 or 1 — never any other value — so callers
// can use `if pte_accessible(pte) != 0 { ... }` or compare against 1.
//
// pte_valid is the exception: it returns the raw 2-bit descriptor-type
// field (0..3), NOT a 0/1 boolean — callers compare against the type
// constants (0=invalid, 1=reserved, 2=block, 3=table).

// Extract the output address from a PTE (bits 12-47).
// Mask 281474976706560 = 0x0000FFFFFFFFF000 — bits 12 through 47 only
// (36-bit PA space, 4KB-aligned). This is the SAME mask pte_make uses
// to sanitize its paddr argument, so pte_addr(pte_make(p, f)) == p for
// any p in bits 12-47.
//
// NOTE: See "Deviation from the contract example" above — the K2d
// contract's prose says this mask is 17592186044415, but that decimal
// is actually 0x0FFFFFFFFFFFF (bits 0-43), which would include the
// flag bits and break the round-trip. We use the CORRECT decimal
// 281474976706560 for 0x0000FFFFFFFFF000 (bits 12-47) instead.
fn pte_addr(pte: u64) -> u64 {
    return pte & 281474976706560;
}

// Check the Descriptor type (bits 0-1).
// Returns the raw 2-bit value:
//   0 = invalid
//   1 = reserved
//   2 = block descriptor (level 1/2 only — points at a 1GB/2MB block)
//   3 = table descriptor (points at the next-level page table)
// Callers compare against the type constants above (e.g. `== 3` to
// check "is a table descriptor", `!= 0` to check "is valid").
fn pte_valid(pte: u64) -> u8 {
    return ((pte & 3) as u8);
}

// Check if AF (Access Flag, bit 9) is set.
// ARMv8 hardware faults with an AF fault if AF=0 and the OS hasn't
// requested "AF faults disabled" via TCR_EL1.E0PDn. The convention in
// a long-mode OS is to set AF=1 at PTE-construction time (pte_make
// does this via the `| 512` term), so this helper returns 1 for any
// PTE that came out of pte_make.
fn pte_accessible(pte: u64) -> u8 {
    return ((pte >> 9) & 1) as u8;
}

// Check if UXN (bit 54) is set (no-execute for EL0 — and EL1 too if
// HCR_EL2.E2H routes stage-1 walks through it). 0=executable, 1=not
// executable. Callers usually OR in 18014398509481984 (= 0x40000000000000)
// to mark a page no-execute after pte_make; this helper reads it back.
fn pte_no_exec(pte: u64) -> u8 {
    return ((pte >> 54) & 1) as u8;
}

// Check AP[2] (bit 6) — EL0 access.
// 0 = EL1-only (kernel-only, "privileged" access)
// 1 = EL0 accessible (user-accessible — the page is mapped into the
//     user VA range, typically via TTBR0_EL1)
// This is the aarch64 analogue of x86_64's U/S bit (bit 2). pte_make
// doesn't set this bit by default — callers OR in 64 (bit 6) into the
// `flags` argument for user pages.
fn pte_user(pte: u64) -> u8 {
    return ((pte >> 6) & 1) as u8;
}

// Build a PTE from (paddr, flags).
//   paddr: the target physical address (must be 4 KB-aligned; bits 12-47
//          are preserved, the rest are masked off — output address is
//          36 bits wide on a 4KB-granule stage-1 walk).
//   flags: the low 12 bits (MemAttr, NS, AP[1], AP[2], Shareability, AF,
//          nG, plus bits 11-14 of various attrs). Bits above 11 in
//          `flags` are masked off — to set UXN (bit 54) or PXN (bit 51),
//          OR in 18014398509481984 (UXN) or 2251799813685248 (PXN) on
//          the result of pte_make.
// The Descriptor-type bits (bits 0-1) are ALWAYS set to 0b11 (table
// descriptor) — this matches the contract's "type=3 (table)" intent
// and the long-mode OS convention where pte_make is used to construct
// next-level table descriptors (block descriptors, which use type=0b01
// in stage-1 / type=0b10 in stage-2, are constructed by a separate
// helper in a future wave if needed). The Access Flag (bit 9 = 512)
// is ALWAYS ORed in — an AF fault would otherwise trap on the first
// access, which is rarely what an OS wants (Linux, FreeBSD, and seL4
// all set AF=1 at PTE-construction time for kernel mappings).
fn pte_make(paddr: u64, flags: u64) -> u64 {
    return (paddr & 281474976706560) | (flags & 4095) | 3 | 512;
}

// ────────────────────────────────────────────────────────────────────────────
// 4-level paging geometry constants (documented as decimal literals —
// VUMA has no top-level `const`, so callers must use the bare numbers).
// ────────────────────────────────────────────────────────────────────────────
//   PT_ENTRIES  = 512     (entries per table — 4096 / 8)
//   PT_SIZE     = 4096    (bytes per table — one 4 KB page)
//   PAGE_SIZE   = 4096    (bytes per mapped page at L0)
//   L3_LEVEL    = 3       (top level — PGD, bits 47-39 of vaddr, 512 GB
//                          per entry, table descriptor only on 4KB granule)
//   L2_LEVEL    = 2       (PUD — bits 38-30, 1 GB per entry, may be a
//                          1 GB block descriptor OR a table descriptor)
//   L1_LEVEL    = 1       (PMD — bits 29-21, 2 MB per entry, may be a
//                          2 MB block descriptor OR a table descriptor)
//   L0_LEVEL    = 0       (PTE — bits 20-12, 4 KB per entry, ALWAYS a
//                          leaf; the output address is the 4KB page PA)
//
// Each entry is 8 bytes; 512 entries × 8 bytes = 4096 bytes per table,
// so one 4 KB page holds exactly one table. This is why the address
// mask is bits 12-47 (the address is page-aligned and 36 bits wide) —
// the low 12 bits are the descriptor-type + attribute bits, the high
// 16 bits (48-63) are reserved / PXN / UXN / available.
//
// ARMv8 also supports 5-level paging (with FEAT_LPA) and 3-level
// paging (with 64KB granule); this file's geometry constants assume
// the standard 4-level / 4KB-granule config that ARMv8-A mandates
// out of reset. K2d scope is 4-level / 4KB only — K11 may add a
// 5-level variant if FEAT_LPA is detected at boot.

// ────────────────────────────────────────────────────────────────────────────
// Self-test.
// ────────────────────────────────────────────────────────────────────────────
// Build a PTE for physical address 1 MB (1048576 = 0x100000) with flags
// 0 (no extra attrs — pte_make still ORs in the descriptor-type bits
// 3 and the AF bit 512). Verify:
//   (1) pte_valid returns 3 (table descriptor — bits 0-1 = 0b11).
//   (2) pte_accessible returns 1 (AF bit 9 set by pte_make's `| 512`).
//   (3) pte_addr returns exactly 1048576 (the round-trip — same mask
//       for build and read, so the flag bits don't leak into the
//       address). This is the check that would FAIL with the contract's
//       buggy mask 17592186044415 (bits 0-43) because pte_make ORs in
//       bits 0, 1, 9 (descriptor-type + AF) which would survive the
//       too-wide mask.
// Returns 0 on success, 1..3 on the corresponding failure (so a future
// CI failure pinpoints the broken helper).

fn main() -> i32 {
    let pte = pte_make(1048576, 0);
    if pte_valid(pte) != 3 { return 1; }
    if pte_accessible(pte) != 1 { return 2; }
    if pte_addr(pte) != 1048576 { return 3; }
    return 0;
}
