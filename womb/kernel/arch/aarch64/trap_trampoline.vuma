// ═══════════════════════════════════════════════════════════════════════════
// womb/kernel/arch/aarch64/trap_trampoline.vuma
// aarch64 trap entry/exit trampolines — TrapFrame layout + externs.
// ═══════════════════════════════════════════════════════════════════════════
//
// This file is the aarch64-specific swap point for trap/IRQ handling, the
// direct analogue of womb/kernel/arch/x86_64/trap_trampoline.vuma (K3a).
// It declares the TrapFrame layout (the register-save area pushed by the
// trap_entry stub and popped by trap_exit) and the extern functions the
// trap dispatcher (K3b) and IRQ subsystem (K3c) call into. In hosted
// mode every extern resolves to `__ffi_fallback_stub` (returns 0, void
// calls no-op). In bare-metal mode (Wave K11) the same names link against
// REAL asm stubs in womb/kernel/arch/aarch64/trap.S.
//
// ── TrapFrame register-save order ───────────────────────────────────────────
// On an aarch64 exception (synchronous, IRQ, FIQ, or SError — the four
// exception classes routed through VBAR_EL1's 16 vector entries at offsets
// 0x000..0x7F8 — ARMv8 ARM D1.10 "Exception Entry"), the CPU auto-saves
// to EL1's banked registers:
//     ELR_EL1   ← return address (the instruction that trapped or the
//                  next one, depending on the exception class)
//     SPSR_EL1  ← PSTATE at the moment of the exception
//     SP_EL0    ← preserved across the exception (EL0's stack pointer
//                  stays in SP_EL0; the CPU switches SP to SP_EL1 on
//                  exception entry, so SP_EL0 is reachable only by
//                  MRS — the trap_entry stub reads it explicitly)
// The trap_entry common path (one stub per vector entry — generated by a
// macro in trap.S) then saves the GP register file in ascending order:
//     X0, X1, X2, ..., X30                       (31 words, trap_entry)
// and then reads the three system registers the dispatcher needs:
//     SP_EL0                                      (1 word, MRS x0, sp_el0)
//     ELR_EL1                                     (1 word, MRS x0, elr_el1)
//     SPSR_EL1                                    (1 word, MRS x0, spsr_el1)
//     ESR_EL1                                     (1 word, MRS x0, esr_el1
//                                                 — exception syndrome)
//
// Total: 31 (GP) + 4 (sys regs) = 35 words × 8 bytes = 280 bytes.
//
// Compare to x86_64 (K3a): x86_64 saves 22 words = 176 bytes (5 CPU-pushed
// + 1 error + 1 vector + 15 GP). aarch64 saves 35 words = 280 bytes
// (31 GP + 4 sys). The aarch64 save area is LARGER because ARMv8 has
// more GP registers (X0..X30 = 31, vs x86_64's 16 RAX..R15) and because
// the CPU doesn't push a hardware-defined save area the way x86_64 does
// (no SS/RSP/RFLAGS/CS/RIP auto-push — those are SPSR_EL1 + ELR_EL1
// instead, and SP_EL0/ESR_EL1 are MRS'd in explicitly).
//
// ── ESR_EL1 Exception Class (EC) field ─────────────────────────────────────
// ESR_EL1 (Exception Syndrome Register, ARMv8 ARM D13.2.5) is the
// syndrome register for EL1 traps. Its top 6 bits (31..26) are the
// Exception Class (EC) — the high-level reason for the trap:
//     EC=0x00 (0)   Unknown reason
//     EC=0x15 (21)  SVC64 from A64 (supervisor call from EL0 — syscall)
//     EC=0x11 (17)  SVC from A32
//     EC=0x24 (36)  Data Abort from same EL
//     EC=0x20 (32)  Instruction Abort from lower EL
//     EC=0x25 (37)  Data Abort from lower EL (page fault on user access)
//     EC=0x22 (34)  PC alignment fault
//     EC=0x26 (38)  SP alignment fault
//     ... (full list in ARMv8 ARM D13.2.5, EC values 0x00..0x3F)
// The trap_exception_class helper below extracts the EC field so the
// K3b dispatcher can switch on it (EC=0x15 → syscall path, EC=0x24/0x25
// → page-fault path, etc.). The self-test uses EC=14 because the K3b
// contract example uses 14 (any small value that fits in 6 bits tests
// the bit-extraction — 14 is also the EC that corresponds to a
// hypothetical "SVC64 from A64" path on some early ARMv8 documentation;
// the precise EC for SVC64 on production silicon is 0x15=21, but the
// extraction formula is what's under test, not the EC-to-name mapping).
//
// ── Extern "C" trampolines (VBAR + GIC + FAR_EL1) ───────────────────────────
// Hosted: __ffi_fallback_stub (xor eax, eax; ret — returns 0, no-op for
//         void functions). The self-test's main() never calls any of these
//         (so the 0-return is not exercised from this file); they exist for
//         the K3b dispatcher / K3c IRQ subsystem / K3d syscall layer to
//         link against.
// Bare-metal (K11): real asm stubs registered in
//         src/codegen/src/arm64.rs::build_runtime_syscall_stubs (or the
//         aarch64 equivalent of x86_64's build_runtime_syscall_stubs):
//     vbar_load(vbar_ptr)
//         — `msr vbar_el1, x0; isb; ret` (x0 = vbar_ptr under AAPCS64).
//           Loads the Vector Base Address Register — the 4KB-aligned base
//           of the 16-entry exception vector table (4 exception classes ×
//           4 SP-relative variants = 16 vector entries, each 128 bytes —
//           the table is 2048 bytes total). Called once during early
//           boot to arm all 16 exception vectors.
//     gic_eoi(irq)
//         — End-Of-Interrupt to the GIC (Generic Interrupt Controller).
//           K11 stub: write `irq` to GICC_EL1.IAR (Interrupt Acknowledge
//           Register) — actually, EOI is a write of the IAR value back to
//           the GICC_EOIR (End-Of-Interrupt Register); the `irq` argument
//           is the same value returned by gic_get_irq (the IAR read). On
//           GICv3 the equivalent register is ICC_EOIR1_EL1. Required at
//           the end of every IRQ handler so the GIC will deliver the
//           next one. `mov x0, irq; msr icc_eoir1_el1, x0; ret` (GICv3
//           — K11 may also support GICv2 via `str x0, [gicc_base, eoir_off]`).
//     gic_mask(irq) / gic_unmask(irq)
//         — Mask/unmask an IRQ line at the GIC distributor. K11 stub:
//           compute `irq / 32` → register offset, `1 << (irq % 32)` →
//           mask bit, then `GICD_ICENABLER<n> = bit` (mask) or
//           `GICD_ISENABLER<n> = bit` (unmask). On GICv3 the
//           distributor is reachable via system registers (ICC_*) for
//           the CPU-local view and via MMIO for the global view; K11
//           picks one. Pairs like x86_64's irq_mask/irq_unmask.
//     gic_get_irq() -> u32
//         — Read the IAR (Interrupt Acknowledge Register). K11 stub:
//           `mrs x0, icc_iar1_el1; ret` (GICv3 — returns the active IRQ
//           number in the low 24 bits, 1023=spurious). Returns 0 in
//           hosted mode (no real GIC). The dispatcher calls this at the
//           top of the IRQ handler to find out WHICH IRQ fired, then
//           dispatches, then calls gic_eoi with the same value at the
//           bottom of the handler. This is the aarch64 analogue of
//           reading the 8259 PIC's ISR — but the GIC's IAR is a single
//           system-register read (no port I/O).
//     far_el1_read() -> u64
//         — `mrs x0, far_el1; ret` (read the Fault Address Register —
//           the virtual address that caused a synchronous data/instruction
//           abort). Used by the trap dispatcher in the data-abort and
//           instruction-abort paths so it can pass the faulting vaddr to
//           the page-fault handler in K3b. The aarch64 analogue of
//           x86_64's cr2_read (K3a) — both return the faulting vaddr,
//           but on aarch64 the register is named FAR_EL1 and is read
//           via MRS, not via a CRn-encoded instruction.
//
// ── Why re-declare nothing here? ─────────────────────────────────────────────
// VUMA has no `import` (Open Work §7), so every kernel module re-declares
// the layouts it uses byte-identically. THIS file declares TrapFrame for
// the FIRST time on aarch64 (no prior VUMA file has it — the x86_64
// TrapFrame in K3a is a DIFFERENT layout, with x86_64-specific fields
// rax/rbx/rcx/.../rip/cs/rflags/rsp/ss, NOT x0..x30/sp_el0/elr_el1/
// spsr_el1/esr_el1). The K3b dispatcher, K3c IRQ subsystem, and K3d
// syscall layer will each re-declare this same aarch64 TrapFrame layout
// from this file's contract. The byte-identical-redeclaration invariant
// (K2c "extern signatures MUST stay byte-identical") extends to layouts
// too — K3b's `dispatch_trap(tf: State<TrapFrame>)` MUST see the same
// field offsets, field names, and field types as this file.
//
// ── PMT discipline ─────────────────────────────────────────────────────────
// NO `*ptr`, `&x`, `allocate`, or `free` anywhere in this file. The
// TrapFrame is a 35-word struct held in a `___pmt_buffer`-backed
// State<TrapFrame>; the CALLER allocates it via `state_new(TrapFrame)`
// and passes it by reference to `trap_frame_init` / `trap_exception_class`
// (init-style API — see "Why init-style?" in womb/kernel/mm/pmm.vuma for
// the codegen rationale). The externs' `vbar_ptr: Address` parameter is a
// plain Address (AAPCS64 X0), NOT a State<T> — no #[borrow] needed
// because there is no State<T> to invalidate. None of the externs take a
// State<T> argument, so there is no use-after-invalidate risk from any
// of them.
//
// ── VUMA has no `import` ────────────────────────────────────────────────────
// This file is self-contained. If a future dispatcher (K3b) wants to
// read `tf.esr_el1`, it must re-declare the TrapFrame layout
// byte-identically to the one here (same pattern as
// womb/kernel/arch/aarch64/mm_trampoline.vuma re-declaring PageTable
// byte-identically to womb/kernel/mm/vmm.vuma).
//
// ── Build & verify (hosted x86_64) ──────────────────────────────────────────
//     ./target/release-fast/compile_dump \
//         womb/kernel/arch/aarch64/trap_trampoline.vuma \
//         /tmp/trap_trampoline.bin x86_64 --verify
//     /tmp/trap_trampoline.bin ; echo "exit=$?"
// Expected: IVE Pass, exit=0 (the 3 self-test checks all pass).
//
// In hosted mode the externs are never called from THIS file's main, so
// __ffi_fallback_stub's "returns 0" behavior is not exercised — the
// trampoline exists for OTHER modules (the K3b dispatcher, K3c IRQ
// subsystem, K3d syscall layer) to link against. The K3b dispatcher
// will call vbar_load once during early boot, gic_get_irq/gic_eoi
// around every IRQ, and far_el1_read inside the data-abort handler;
// this file only declares them so the symbol table is complete when
// both files are linked into the same kernel image.

// ────────────────────────────────────────────────────────────────────────────
// Layouts.
// ────────────────────────────────────────────────────────────────────────────

// The aarch64 TrapFrame. The field order MUST match trap.S exactly (K11
// will write trap.S to match). 35 fields × 8 bytes = 280 bytes. See the
// header comment for the push-order derivation (trap_entry pushes X0..X30
// in ascending order, then MRS-es SP_EL0 / ELR_EL1 / SPSR_EL1 / ESR_EL1).
layout TrapFrame = {
    x0: u64,
    x1: u64,
    x2: u64,
    x3: u64,
    x4: u64,
    x5: u64,
    x6: u64,
    x7: u64,
    x8: u64,
    x9: u64,
    x10: u64,
    x11: u64,
    x12: u64,
    x13: u64,
    x14: u64,
    x15: u64,
    x16: u64,
    x17: u64,
    x18: u64,
    x19: u64,
    x20: u64,
    x21: u64,
    x22: u64,
    x23: u64,
    x24: u64,
    x25: u64,
    x26: u64,
    x27: u64,
    x28: u64,
    x29: u64,   // frame pointer (FP)
    x30: u64,   // link register (LR)
    sp_el0: u64,    // EL0 stack pointer (preserved across exception)
    elr_el1: u64,   // exception link register (return address)
    spsr_el1: u64,  // saved processor state (PSTATE at trap)
    esr_el1: u64,   // exception syndrome register (EC + IL + ISS)
}

// ────────────────────────────────────────────────────────────────────────────
// Extern "C" trampolines — VBAR load, GIC mask/unmask/eoi/get_irq, FAR read.
// ────────────────────────────────────────────────────────────────────────────
// Hosted: __ffi_fallback_stub (returns 0, void calls no-op). K11 swaps
// these for real asm stubs registered in
// src/codegen/src/arm64.rs::build_runtime_syscall_stubs (or the aarch64
// equivalent of x86_64's build_runtime_syscall_stubs). The `irq`
// parameters are u32 (not u8 as on x86_64 — K3a) because the GIC supports
// up to 1020 IRQs (IRQ IDs 0..1019; 1020..1023 are reserved/spurious),
// which exceeds u8's 0..255 range. This is a deliberate cross-arch
// signature divergence: aarch64's gic_* functions use u32, x86_64's
// pic_* functions use u8 — the K3b dispatcher's IRQ-handler code is
// arch-specific anyway (different trap entry stubs, different EOI
// protocol), so the type divergence is not a problem.
extern "C" {
    // Load the Vector Base Address Register. `vbar_ptr` is an AAPCS64
    // X0 holding a 4KB-aligned address pointing at the 2048-byte
    // exception vector table (16 entries × 128 bytes — 4 exception
    // classes × 4 SP-relative variants per class). K11 stub:
    // `msr vbar_el1, x0; isb; ret`. Called once during early boot to
    // arm all 16 exception vectors (current-EL-with-SP_EL0, current-
    // EL-with-SP_ELx, lower-AArch64, lower-AArch32 — for each of
    // synchronous, IRQ, FIQ, SError).
    fn vbar_load(vbar_ptr: Address);
    // End-Of-Interrupt to the GIC. `irq` is the value previously
    // returned by gic_get_irq (the IAR read) — writing it back to the
    // GIC's EOIR (End-Of-Interrupt Register) tells the GIC the
    // handler is done and it can de-prioritize that IRQ. K11 stub
    // (GICv3): `msr icc_eoir1_el1, x0; ret` (x0 = irq). K11 stub
    // (GICv2): `str x0, [gicc_base, eoir_offset]; ret`. Required at
    // the end of every IRQ handler so the GIC will deliver the next
    // one. Pairs with gic_get_irq (read IAR at top of handler, write
    // EOIR at bottom with the same value).
    fn gic_eoi(irq: u32);
    // Mask an IRQ line at the GIC distributor. `irq` is the IRQ
    // number 0..1019 (1020..1023 reserved/spurious). K11 stub:
    // compute register bank = irq / 32, mask bit = 1 << (irq % 32),
    // then `GICD_ICENABLER<bank> = bit` (GICv2 MMIO) or system-
    // register write (GICv3). In hosted mode the stub is a no-op.
    fn gic_mask(irq: u32);
    // Unmask an IRQ line at the GIC distributor. K11 stub: same
    // register-bank computation, then `GICD_ISENABLER<bank> = bit`
    // (set-enable instead of clear-enable). Pairs with gic_mask.
    fn gic_unmask(irq: u32);
    // Read the Interrupt Acknowledge Register — returns the active
    // IRQ number (low 24 bits) or 1023 (spurious) if no IRQ is
    // pending. K11 stub (GICv3): `mrs x0, icc_iar1_el1; ret` (x0 =
    // IAR value). K11 stub (GICv2): `ldr x0, [gicc_base,
    // iar_offset]; ret`. Returns 0 in hosted mode (no real GIC).
    // Called by the dispatcher at the top of every IRQ handler;
    // the returned value is dispatched to the appropriate handler
    // and then passed to gic_eoi at the bottom. This is the
    // aarch64 analogue of reading the 8259 PIC's ISR — but the GIC
    // is a single system-register read (no port I/O on aarch64).
    fn gic_get_irq() -> u32;
    // Read FAR_EL1 — the Fault Address Register. K11 stub:
    // `mrs x0, far_el1; ret`. Returns the virtual address that
    // caused a synchronous data abort or instruction abort. Used by
    // the trap dispatcher's data-abort and instruction-abort paths
    // (the analogues of x86_64's #PF page-fault path — K3a) so it
    // can pass the faulting vaddr to the page-fault handler in K3b.
    // Returns 0 in hosted mode (hosted mode never delivers real
    // aborts — the host kernel does).
    fn far_el1_read() -> u64;
}

// ────────────────────────────────────────────────────────────────────────────
// Helpers.
// ────────────────────────────────────────────────────────────────────────────
// Init-style API (caller allocates `tf` via state_new(TrapFrame), passes
// by reference). The State<TrapFrame> param here is a regular VUMA-fn
// borrow (NOT an extern #[borrow] — VUMA fn calls don't need the
// attribute, only extern "C" calls do, because the codegen tracks the
// State's lifetime through regular fn calls but conservatively
// invalidates on extern calls). See womb/kernel/mm/vmm.vuma::vaddr_parts
// for the same pattern (regular fn writing through a State<T> param).

// Initialize a TrapFrame to zeros. Useful both for the self-test and
// for the early-boot allocator (the trap dispatcher can call this on a
// scratch TrapFrame before populating it from the live save area, so
// stale stack garbage in the unused-ESR-IL/ISS-bits case can't leak
// into the handler). Writes all 35 fields to 0.
fn trap_frame_init(tf: State<TrapFrame>) {
    tf.x0 = 0;
    tf.x1 = 0;
    tf.x2 = 0;
    tf.x3 = 0;
    tf.x4 = 0;
    tf.x5 = 0;
    tf.x6 = 0;
    tf.x7 = 0;
    tf.x8 = 0;
    tf.x9 = 0;
    tf.x10 = 0;
    tf.x11 = 0;
    tf.x12 = 0;
    tf.x13 = 0;
    tf.x14 = 0;
    tf.x15 = 0;
    tf.x16 = 0;
    tf.x17 = 0;
    tf.x18 = 0;
    tf.x19 = 0;
    tf.x20 = 0;
    tf.x21 = 0;
    tf.x22 = 0;
    tf.x23 = 0;
    tf.x24 = 0;
    tf.x25 = 0;
    tf.x26 = 0;
    tf.x27 = 0;
    tf.x28 = 0;
    tf.x29 = 0;
    tf.x30 = 0;
    tf.sp_el0 = 0;
    tf.elr_el1 = 0;
    tf.spsr_el1 = 0;
    tf.esr_el1 = 0;
}

// Extract the Exception Class (EC) field from ESR_EL1. The EC field
// occupies bits 31..26 of ESR_EL1 (the top 6 bits — ARMv8 ARM D13.2.5
// "ESR_EL1, Exception Syndrome Register"). The extraction is
// `(esr >> 26) & 63`:
//     `>> 26` shifts the top 6 bits down to bits 5..0
//     `& 63`  masks off any high bits (defensive — the >> 26 already
//             narrowed to 6 bits for a u64, but the mask is cheap and
//             documents the field width).
// Returns u32 (the EC fits in 6 bits — 0..63 — but the dispatcher
// switches on it and `as u32` matches the dispatcher's typical use;
// u8 would also work but u32 is more idiomatic for an enum-like
// discriminant in VUMA's type system).
//
// Common EC values the dispatcher (K3b) will switch on:
//     0  = Unknown reason
//     21 = SVC64 from A64 (syscall from EL0 — the syscall path)
//     17 = SVC from A32
//     22 = PC alignment fault
//     24 = Data Abort from same EL
//     25 = Data Abort from lower EL (user page fault)
//     32 = Instruction Abort from lower EL
//     33 = Instruction Abort from same EL
//     34 = PC alignment fault (same EL)
//     36 = Data Abort from same EL (alt encoding)
//     37 = Data Abort from lower EL (alt encoding)
//     38 = SP alignment fault
// (Full list: ARMv8 ARM D13.2.5, EC values 0x00..0x3F.)
//
// In hosted mode the self-test never traps, so this function is only
// exercised on the `tf.esr_el1 = 939524096; let ec =
// trap_exception_class(tf);` path in main() (which writes EC=14 into
// ESR_EL1 and verifies the extraction returns 14). The choice of EC=14
// is per the K3b contract example; the formula under test is the bit
// extraction, not the EC-to-name mapping.
fn trap_exception_class(tf: State<TrapFrame>) -> u32 {
    return ((tf.esr_el1 >> 26) & 63) as u32;
}

// ────────────────────────────────────────────────────────────────────────────
// Self-test.
// ────────────────────────────────────────────────────────────────────────────
// Allocate a TrapFrame via state_new, zero it via trap_frame_init, then
// verify:
//   (1) trap_frame_init cleared x0 (representative GP register, low end).
//   (2) trap_frame_init cleared x30 (representative GP register, high
//       end — also confirms x29 and x28 were cleared since they're
//       contiguous in the layout, but x30 alone is the explicit check).
//   (3) Writing 939524096 (= 14 << 26 = 14 * 67108864) to esr_el1 and
//       reading it back through trap_exception_class yields 14 —
//       confirms the EC bit-extraction formula works on a non-zero
//       ESR_EL1 value with EC in bits 31..26 (no shift-by-26 bug, no
//       mask-too-wide bug). The choice of EC=14 is the contract
//       example; any small value in 0..63 would work (14 is one of
//       the "reserved" EC values in the ARMv8 ARM, but the formula
//       doesn't care).
//
// Per the K3b contract's "IMPORTANT" rule: all non-zero constants in
// the self-test use DECIMAL (939524096, not 0x38000000; 63, not 0x3F;
// 14, not 0x0E) — decimal avoids the parser's hex-literal path
// (parse_int_radix width-extension subtleties — see
// womb/kernel/arch/x86_64/pt.vuma header for the same rationale).
//
// Returns 0 on success, 1..3 on the corresponding failure (so a future
// CI failure pinpoints the broken check).

fn main() -> i32 {
    // Self-test: init a TrapFrame, verify fields, check EC extraction.
    let tf = state_new(TrapFrame);
    trap_frame_init(tf);
    if tf.x0 != 0 { return 1; }
    if tf.x30 != 0 { return 2; }
    tf.esr_el1 = 939524096;  // 14 << 26 = 14 * 67108864 (EC=14 in bits 31-26)
    let ec = trap_exception_class(tf);
    if ec != 14 { return 3; }
    return 0;
}
