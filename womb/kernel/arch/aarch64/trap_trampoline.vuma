// ═══════════════════════════════════════════════════════════════════════════
// womb/kernel/arch/aarch64/trap_trampoline.vuma
// aarch64 trap entry/exit trampolines — old Arm64TrapFrame + superset adapter.
// ═══════════════════════════════════════════════════════════════════════════
//
// This file is the aarch64-specific swap point for trap/IRQ handling, evolved
// through three waves:
//   K3b (initial):  declared the 35-field aarch64 TrapFrame (x0..x30,
//                   sp_el0, elr_el1, spsr_el1, esr_el1) + the VBAR/GIC
//                   externs + trap_exception_class helper + a self-test
//                   that round-tripped the layout + the EC extraction.
//   R2a (superset): created the canonical 576-byte superset TrapFrame in
//                   womb/kernel/trap/trap_frame.vuma — a single layout that
//                   every arch's trap_entry stub populates and every arch-
//                   independent consumer reads from. The R2a Golden Rule:
//                     "Do not write arch-conditional logic inside kernel
//                      transforms."
//   R2c (this file): re-declares the superset TrapFrame + tf_get_gpr +
//                    tf_set_gpr + tf_init byte-identically from R2a, RENAMES
//                    the old 35-field aarch64 TrapFrame to Arm64TrapFrame
//                    (so the existing trap-entry stubs and K3d's trap.vuma
//                    dispatcher keep working unchanged), updates
//                    trap_exception_class to read from Arm64TrapFrame, and
//                    adds the arm64_trap_to_superset(old, sup) adapter that
//                    copies fields from Arm64TrapFrame into the superset.
//
// In hosted mode every extern resolves to `__ffi_fallback_stub` (returns 0,
// void calls no-op). In bare-metal mode (Wave K11) the same names link
// against REAL asm stubs in womb/kernel/arch/aarch64/trap.S.
//
// ── Arm64TrapFrame register-save order ──────────────────────────────────────
// On an aarch64 exception (synchronous, IRQ, FIQ, or SError — the four
// exception classes routed through VBAR_EL1's 16 vector entries at offsets
// 0x000..0x7F8 — ARMv8 ARM D1.10 "Exception Entry"), the CPU auto-saves
// to EL1's banked registers:
//     ELR_EL1   ← return address (the instruction that trapped or the
//                  next one, depending on the exception class)
//     SPSR_EL1  ← PSTATE at the moment of the exception
//     SP_EL0    ← preserved across the exception (EL0's stack pointer
//                  stays in SP_EL0; the CPU switches SP to SP_EL1 on
//                  exception entry, so SP_EL0 is reachable only by
//                  MRS — the trap_entry stub reads it explicitly)
// The trap_entry common path (one stub per vector entry — generated by a
// macro in trap.S) then saves the GP register file in ascending order:
//     X0, X1, X2, ..., X30                       (31 words, trap_entry)
// and then reads the four system registers the dispatcher needs:
//     SP_EL0                                      (1 word, MRS x0, sp_el0)
//     ELR_EL1                                     (1 word, MRS x0, elr_el1)
//     SPSR_EL1                                    (1 word, MRS x0, spsr_el1)
//     ESR_EL1                                     (1 word, MRS x0, esr_el1
//                                                 — exception syndrome)
//
// Total: 31 (GP) + 4 (sys regs) = 35 words × 8 bytes = 280 bytes.
// (See the Arm64TrapFrame layout below for the 35 named fields.)
//
// ── Canonical GPR slot mapping for aarch64 (R2c contract) ──────────────────
// The R2c contract pins the aarch64→superset GPR mapping to the natural
// ascending save order (matching the existing trap_entry stub's push order
// AND matching the R2a file header's documented "slot 0..30 = x0..x30"
// mapping):
//     slot  0 = x0     slot 10 = x10    slot 20 = x20    slot 30 = x30
//     slot  1 = x1     slot 11 = x11    slot 21 = x21
//     ...              ...              ...              (31 registers,
//     slot  9 = x9     slot 19 = x19    slot 29 = x29     slots 0..30;
//                                                       slot 31 stays 0)
//   Scalar fields:
//     sup.pc         ← old.elr_el1       (Exception Link Register)
//     sup.status     ← old.spsr_el1      (Saved Processor State Register)
//     sup.vector     ← trap_exception_class(old)  (= (old.esr_el1 >> 26)
//                                                   & 63 — the EC field)
//     sup.error_code ← old.esr_el1       (full Exception Syndrome Register)
//     sup.sp         ← old.sp_el0        (EL0 stack pointer)
//   NOT migrated (left 0 by tf_init):
//     sup.fpu[0..255]   — aarch64 saves V0..V31 state separately (not in
//                         the Arm64TrapFrame); a future wave may extend
//                         the save area and copy v0..v31 here.
//
// ── ESR_EL1 Exception Class (EC) field ─────────────────────────────────────
// ESR_EL1 (Exception Syndrome Register, ARMv8 ARM D13.2.5) is the
// syndrome register for EL1 traps. Its top 6 bits (31..26) are the
// Exception Class (EC) — the high-level reason for the trap:
//     EC=0x00 (0)   Unknown reason
//     EC=0x15 (21)  SVC64 from A64 (supervisor call from EL0 — syscall)
//     EC=0x11 (17)  SVC from A32
//     EC=0x24 (36)  Data Abort from same EL
//     EC=0x20 (32)  Instruction Abort from lower EL
//     EC=0x25 (37)  Data Abort from lower EL (page fault on user access)
//     EC=0x22 (34)  PC alignment fault
//     EC=0x26 (38)  SP alignment fault
//     ... (full list in ARMv8 ARM D13.2.5, EC values 0x00..0x3F)
// The trap_exception_class helper below extracts the EC field so the
// arch-independent dispatcher can switch on it. The R2c adapter routes the
// EC into sup.vector so the dispatcher's vector switch (which on x86_64
// is the IDT vector number 0..255) works uniformly — the dispatcher sees
// an aarch64 EC (0..63) in sup.vector and an x86_64 vector (0..255) in
// sup.vector, but the values are disjoint (x86_64 ECs never collide with
// aarch64 ECs because the dispatcher switches on (arch, vector) pairs in
// the future arch-aware routing — out of scope for R2c).
//
// ── Extern "C" trampolines (VBAR + GIC + FAR_EL1) ───────────────────────────
// Hosted: __ffi_fallback_stub (returns 0, void calls no-op). The self-
// test's main() never calls any of these. K11 swaps them for real asm
// stubs registered in src/codegen/src/arm64.rs::build_runtime_syscall_stubs.
//     vbar_load(vbar_ptr)        — `msr vbar_el1, x0; isb; ret`
//     gic_eoi(irq)               — `msr icc_eoir1_el1, x0; ret` (GICv3)
//     gic_mask(irq) / gic_unmask(irq)
//                                — GICD_ICENABLER/ISENABLER bit write
//     gic_get_irq() -> u32       — `mrs x0, icc_iar1_el1; ret`
//     far_el1_read() -> u64      — `mrs x0, far_el1; ret`
// The `irq` parameters are u32 (not u8 as on x86_64) because the GIC
// supports up to 1020 IRQs.
//
// ── Why re-declare the superset here? ────────────────────────────────────────
// VUMA has no `import` (Open Work §7), so every kernel module re-declares
// the layouts it uses byte-identically. THIS file re-declares the canonical
// superset TrapFrame + tf_get_gpr + tf_set_gpr + tf_init byte-identically
// from womb/kernel/trap/trap_frame.vuma (R2a) so that the
// arm64_trap_to_superset adapter can call tf_set_gpr / write to sup.pc etc.
// against the same field offsets R2a defined.
//
// ── PMT discipline ─────────────────────────────────────────────────────────
// NO `*ptr`, `&x`, `allocate`, or `free` anywhere in this file. The
// TrapFrame and Arm64TrapFrame are flat typed-memory records held in
// `___pmt_buffer`-backed State<T> values; the caller allocates them via
// `state_new(T)` and passes them by reference to tf_init / trap_frame_init
// / arm64_trap_to_superset (init-style API — same convention as R1a's
// bootinfo_init, R2a's tf_init, and R2b's x86_trap_to_superset). The
// externs' `vbar_ptr: Address` parameter is a plain Address (AAPCS64 X0),
// NOT a State<T> — no #[borrow] needed. None of the externs take a
// State<T> argument, so there is no use-after-invalidate risk from any
// of them.
//
// ── Decimal constants ──────────────────────────────────────────────────────
// All numeric literals in CODE are decimal (per the project-wide convention
// — see kernel-developer-guide.md §9). Hex values appear in comments only.
// The literals used in the self-test:
//     42      = 0x2a            (arbitrary x0 value to round-trip via slot 0)
//     8192    = 0x2000          (arbitrary elr_el1 value to round-trip via
//                                sup.pc — different from R2b's 4096 to make
//                                cross-arch self-test drift easy to spot)
//     256     = 0x100           (gpr/fpu array size — byte-loop bound)
//     8       = 0x8             (u64 pack/unpack byte count)
//     24      = 0x18            (_pad array size — byte-loop bound)
//     255     = 0xff            (u8 mask, applied after the >> shift)
//     26      = 0x1a            (ESR_EL1 EC field right-shift amount)
//     63      = 0x3f            (ESR_EL1 EC field mask, 6 bits)
//     0..2    = self-test return codes (1..2 = individual check failures)
//
// ── Build & verify (hosted x86_64) ──────────────────────────────────────────
//     . "$HOME/.cargo/env" && CARGO_BUILD_JOBS=4 \
//         cargo build --profile release-fast --bin compile_dump
//     ./target/release-fast/compile_dump \
//         womb/kernel/arch/aarch64/trap_trampoline.vuma \
//         /tmp/trap_trampoline.bin x86_64 --verify
//     /tmp/trap_trampoline.bin ; echo "exit=$?"
// Expected: IVE Pass, exit=0 (the 2 adapter self-test checks both pass).

// ────────────────────────────────────────────────────────────────────────────
// Superset TrapFrame layout (re-declared byte-identically from R2a).
// ────────────────────────────────────────────────────────────────────────────
// 576 bytes total: 256 (gpr) + 8×5 (pc/status/vector/error_code/sp) + 256
// (fpu) + 24 (_pad). See womb/kernel/trap/trap_frame.vuma (R2a) for the
// canonical definition and full field-semantics documentation. The
// re-declaration here MUST be byte-identical (same field names, types,
// order, _pad size) so the field offsets the adapter writes match the
// offsets the arch-independent consumers read.
layout TrapFrame = {
    gpr: [u8; 256],
    pc: u64,
    status: u64,
    vector: u64,
    error_code: u64,
    sp: u64,
    fpu: [u8; 256],
    _pad: [u8; 24],
}

// ────────────────────────────────────────────────────────────────────────────
// tf_get_gpr: read the u64 GPR at canonical slot `idx` from sup.gpr.
// ────────────────────────────────────────────────────────────────────────────
// 8-byte little-endian unpack at byte offset `idx * 8`. Same loop pattern
// as task.vuma's pt_get_pid but with a u64 accumulator and an 8-byte loop
// bound. Byte-identical to R2a's tf_get_gpr (same param name, same body).
fn tf_get_gpr(tf: State<TrapFrame>, idx: u32) -> u64 {
    let off = idx * 8;
    let v: u64 = 0;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let b = tf.gpr[off + i] as u64;
        v = v + (b << sh);
        i = i + 1;
    }
    return v;
}

// ────────────────────────────────────────────────────────────────────────────
// tf_set_gpr: write the u64 `val` to canonical slot `idx` in sup.gpr.
// ────────────────────────────────────────────────────────────────────────────
// 8-byte little-endian pack at byte offset `idx * 8`. Same loop pattern
// as task.vuma's pt_set_pid but with an 8-byte loop bound. Byte-identical
// to R2a's tf_set_gpr (same param name, same body).
fn tf_set_gpr(tf: State<TrapFrame>, idx: u32, val: u64) {
    let off = idx * 8;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let b = (val >> sh) & 255;
        tf.gpr[off + i] = b as u8;
        i = i + 1;
    }
}

// ────────────────────────────────────────────────────────────────────────────
// tf_init: zero every field of a caller-allocated superset TrapFrame.
// ────────────────────────────────────────────────────────────────────────────
// Called once per TrapFrame before arm64_trap_to_superset (or any other
// arch's adapter) populates the arch-specific fields. Byte-identical to
// R2a's tf_init (same param name, same body).
fn tf_init(tf: State<TrapFrame>) {
    let i = 0;
    while i < 256 { tf.gpr[i] = 0; i = i + 1; }
    tf.pc = 0;
    tf.status = 0;
    tf.vector = 0;
    tf.error_code = 0;
    tf.sp = 0;
    let j = 0;
    while j < 256 { tf.fpu[j] = 0; j = j + 1; }
    let k = 0;
    while k < 24 { tf._pad[k] = 0; k = k + 1; }
}

// ────────────────────────────────────────────────────────────────────────────
// Arm64TrapFrame layout (the old K3b TrapFrame, renamed for R2c).
// ────────────────────────────────────────────────────────────────────────────
// 35 fields × 8 bytes = 280 bytes. The field order MUST match trap.S
// exactly (K11 will write trap.S to match). Kept byte-identical to K3b's
// TrapFrame (only the name changes), so nothing else in the kernel needs
// to change. The arm64_trap_to_superset adapter below bridges the old
// layout to the new superset.
layout Arm64TrapFrame = {
    x0: u64,
    x1: u64,
    x2: u64,
    x3: u64,
    x4: u64,
    x5: u64,
    x6: u64,
    x7: u64,
    x8: u64,
    x9: u64,
    x10: u64,
    x11: u64,
    x12: u64,
    x13: u64,
    x14: u64,
    x15: u64,
    x16: u64,
    x17: u64,
    x18: u64,
    x19: u64,
    x20: u64,
    x21: u64,
    x22: u64,
    x23: u64,
    x24: u64,
    x25: u64,
    x26: u64,
    x27: u64,
    x28: u64,
    x29: u64,   // frame pointer (FP)
    x30: u64,   // link register (LR)
    sp_el0: u64,    // EL0 stack pointer (preserved across exception)
    elr_el1: u64,   // exception link register (return address)
    spsr_el1: u64,  // saved processor state (PSTATE at trap)
    esr_el1: u64,   // exception syndrome register (EC + IL + ISS)
}

// ────────────────────────────────────────────────────────────────────────────
// Extern "C" trampolines — VBAR load, GIC mask/unmask/eoi/get_irq, FAR read.
// ────────────────────────────────────────────────────────────────────────────
// Hosted: __ffi_fallback_stub (returns 0, void calls no-op). K11 swaps
// these for real asm stubs registered in
// src/codegen/src/arm64.rs::build_runtime_syscall_stubs. Kept verbatim
// from K3b — R2c does NOT touch the extern block. The `irq` parameters
// are u32 (not u8 as on x86_64) because the GIC supports up to 1020 IRQs.
extern "C" {
    // Load the Vector Base Address Register. K11 stub:
    // `msr vbar_el1, x0; isb; ret`.
    fn vbar_load(vbar_ptr: Address);
    // End-Of-Interrupt to the GIC. K11 stub (GICv3):
    // `msr icc_eoir1_el1, x0; ret`.
    fn gic_eoi(irq: u32);
    // Mask an IRQ line at the GIC distributor. K11 stub: compute
    // register bank = irq / 32, mask bit = 1 << (irq % 32), then
    // GICD_ICENABLER<bank> = bit.
    fn gic_mask(irq: u32);
    // Unmask an IRQ line at the GIC distributor. Pairs with gic_mask.
    fn gic_unmask(irq: u32);
    // Read the Interrupt Acknowledge Register — returns the active
    // IRQ number (low 24 bits) or 1023 (spurious). K11 stub (GICv3):
    // `mrs x0, icc_iar1_el1; ret`.
    fn gic_get_irq() -> u32;
    // Read FAR_EL1 — the Fault Address Register. K11 stub:
    // `mrs x0, far_el1; ret`.
    fn far_el1_read() -> u64;
}

// ────────────────────────────────────────────────────────────────────────────
// Helpers.
// ────────────────────────────────────────────────────────────────────────────
// Init-style API (caller allocates via state_new, passes by reference).
// The State<T> params here are regular VUMA-fn borrows (NOT extern
// #[borrow] — VUMA fn calls don't need the attribute, only extern "C"
// calls do).

// Initialize an Arm64TrapFrame to zeros. Writes all 35 fields to 0. Kept
// verbatim from K3b — only the param type name changes (TrapFrame →
// Arm64TrapFrame).
fn trap_frame_init(tf: State<Arm64TrapFrame>) {
    tf.x0 = 0;
    tf.x1 = 0;
    tf.x2 = 0;
    tf.x3 = 0;
    tf.x4 = 0;
    tf.x5 = 0;
    tf.x6 = 0;
    tf.x7 = 0;
    tf.x8 = 0;
    tf.x9 = 0;
    tf.x10 = 0;
    tf.x11 = 0;
    tf.x12 = 0;
    tf.x13 = 0;
    tf.x14 = 0;
    tf.x15 = 0;
    tf.x16 = 0;
    tf.x17 = 0;
    tf.x18 = 0;
    tf.x19 = 0;
    tf.x20 = 0;
    tf.x21 = 0;
    tf.x22 = 0;
    tf.x23 = 0;
    tf.x24 = 0;
    tf.x25 = 0;
    tf.x26 = 0;
    tf.x27 = 0;
    tf.x28 = 0;
    tf.x29 = 0;
    tf.x30 = 0;
    tf.sp_el0 = 0;
    tf.elr_el1 = 0;
    tf.spsr_el1 = 0;
    tf.esr_el1 = 0;
}

// Extract the Exception Class (EC) field from ESR_EL1. The EC field
// occupies bits 31..26 of ESR_EL1 (the top 6 bits — ARMv8 ARM D13.2.5
// "ESR_EL1, Exception Syndrome Register"). The extraction is
// `(esr >> 26) & 63`:
//     `>> 26` shifts the top 6 bits down to bits 5..0
//     `& 63`  masks off any high bits (defensive — the >> 26 already
//             narrowed to 6 bits for a u64, but the mask is cheap and
//             documents the field width).
// Returns u32 (the EC fits in 6 bits — 0..63 — but u32 is more idiomatic
// for an enum-like discriminant in VUMA's type system).
//
// Common EC values the dispatcher will switch on:
//     0  = Unknown reason
//     21 = SVC64 from A64 (syscall from EL0)
//     17 = SVC from A32
//     22 = PC alignment fault
//     24 = Data Abort from same EL
//     25 = Data Abort from lower EL (user page fault)
//     32 = Instruction Abort from lower EL
//     33 = Instruction Abort from same EL
//     38 = SP alignment fault
// (Full list: ARMv8 ARM D13.2.5, EC values 0x00..0x3F.)
//
// Kept verbatim from K3b — only the param type name changes
// (TrapFrame → Arm64TrapFrame). The arm64_trap_to_superset adapter below
// calls this to populate sup.vector.
fn trap_exception_class(tf: State<Arm64TrapFrame>) -> u32 {
    return ((tf.esr_el1 >> 26) & 63) as u32;
}

// ────────────────────────────────────────────────────────────────────────────
// arm64_trap_to_superset: copy an old Arm64TrapFrame into a superset TrapFrame.
// ────────────────────────────────────────────────────────────────────────────
// The arch-specific adapter required by R2a's contract (R2c is the aarch64
// instance; R2b is x86_64; R2d is riscv64). The CALLER allocates `old`
// (typically populated by the trap_entry stub from the live save area)
// and `sup` (typically a scratch TrapFrame on the exception stack), calls
// tf_init(sup) first to get a clean slate, then calls this adapter to
// copy fields. After this returns, `sup` is ready to be passed to any
// arch-independent consumer that takes State<TrapFrame>.
//
// Mapping (per the R2c contract — see the file header's slot table):
//   GPR slots 0..30 ← old.x0, old.x1, ..., old.x30
//     (31 registers, one per slot; slot 31 stays 0 from tf_init.)
//   sup.pc         ← old.elr_el1
//   sup.status     ← old.spsr_el1
//   sup.vector     ← trap_exception_class(old)   (= (old.esr_el1 >> 26) & 63)
//   sup.error_code ← old.esr_el1
//   sup.sp         ← old.sp_el0
//   NOT migrated: fpu (the Arm64TrapFrame doesn't save V-register state —
//                  a future wave may extend the save area).
//
// State<T> params: 2 (old: State<Arm64TrapFrame>, sup: State<TrapFrame>).
// Pure reads of `old.*` + pure writes to `sup.*` via tf_set_gpr +
// direct field writes + one helper call (trap_exception_class, which
// reads old.esr_el1). The 31 tf_set_gpr calls each do an 8-byte LE pack
// loop; the 5 scalar field assignments are single stores. No `*ptr` /
// `&x` / `allocate` anywhere.
//
// The two State<T> params pattern is precedent-set by
// womb/kernel/syscall/abi.vuma::syscall_args_from_frame
// (tf: State<TrapFrame>, args: State<SyscallArgs>) — VUMA's codegen
// tracks both States' lifetimes through regular fn calls.
fn arm64_trap_to_superset(old: State<Arm64TrapFrame>, sup: State<TrapFrame>) {
    // 31 GP registers → slots 0..30 (ascending save order).
    tf_set_gpr(sup, 0, old.x0);
    tf_set_gpr(sup, 1, old.x1);
    tf_set_gpr(sup, 2, old.x2);
    tf_set_gpr(sup, 3, old.x3);
    tf_set_gpr(sup, 4, old.x4);
    tf_set_gpr(sup, 5, old.x5);
    tf_set_gpr(sup, 6, old.x6);
    tf_set_gpr(sup, 7, old.x7);
    tf_set_gpr(sup, 8, old.x8);
    tf_set_gpr(sup, 9, old.x9);
    tf_set_gpr(sup, 10, old.x10);
    tf_set_gpr(sup, 11, old.x11);
    tf_set_gpr(sup, 12, old.x12);
    tf_set_gpr(sup, 13, old.x13);
    tf_set_gpr(sup, 14, old.x14);
    tf_set_gpr(sup, 15, old.x15);
    tf_set_gpr(sup, 16, old.x16);
    tf_set_gpr(sup, 17, old.x17);
    tf_set_gpr(sup, 18, old.x18);
    tf_set_gpr(sup, 19, old.x19);
    tf_set_gpr(sup, 20, old.x20);
    tf_set_gpr(sup, 21, old.x21);
    tf_set_gpr(sup, 22, old.x22);
    tf_set_gpr(sup, 23, old.x23);
    tf_set_gpr(sup, 24, old.x24);
    tf_set_gpr(sup, 25, old.x25);
    tf_set_gpr(sup, 26, old.x26);
    tf_set_gpr(sup, 27, old.x27);
    tf_set_gpr(sup, 28, old.x28);
    tf_set_gpr(sup, 29, old.x29);
    tf_set_gpr(sup, 30, old.x30);
    // Scalar fields — direct u64 stores.
    sup.pc = old.elr_el1;
    sup.status = old.spsr_el1;
    sup.vector = trap_exception_class(old) as u64;
    sup.error_code = old.esr_el1;
    sup.sp = old.sp_el0;
}

// ────────────────────────────────────────────────────────────────────────────
// Self-test (main).
// ────────────────────────────────────────────────────────────────────────────
// Exercises the arm64_trap_to_superset adapter end-to-end:
//   1. Allocate an Arm64TrapFrame `old`, zero it via trap_frame_init.
//   2. Allocate a TrapFrame `sup`, zero it via tf_init.
//   3. Set old.x0 = 42, old.elr_el1 = 8192 (representative GPR + scalar
//      values — 42 is the same decimal constant R2a's trap_frame.vuma
//      self-test uses for slot-0 round-trip; 8192 differs from R2b's 4096
//      deliberately so cross-arch self-test drift is easy to spot).
//   4. Call arm64_trap_to_superset(old, sup).
//   5. Verify tf_get_gpr(sup, 0) == 42 — confirms the x0 → slot 0
//      mapping + the 8-byte LE pack/unpack round-trip through the adapter.
//   6. Verify sup.pc == 8192 — confirms the old.elr_el1 → sup.pc scalar
//      field copy.
//
// Returns 0 on success, 1..2 on the corresponding failure (so a future CI
// failure pinpoints the broken check):
//   1: tf_get_gpr(sup, 0) != 42 after arm64_trap_to_superset
//   2: sup.pc != 8192 after arm64_trap_to_superset
//
// Per the R2c contract's "Use decimal constants" rule: all non-zero
// constants in the self-test use DECIMAL (42, 8192 — not 0x2a, 0x2000).
fn main() -> i32 {
    let old = state_new(Arm64TrapFrame);
    trap_frame_init(old);
    let sup = state_new(TrapFrame);
    tf_init(sup);
    old.x0 = 42;
    old.elr_el1 = 8192;
    arm64_trap_to_superset(old, sup);
    if tf_get_gpr(sup, 0) != 42 { return 1; }
    if sup.pc != 8192 { return 2; }
    return 0;
}
