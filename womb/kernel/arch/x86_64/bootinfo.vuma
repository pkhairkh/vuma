// ═══════════════════════════════════════════════════════════════════════════
// womb/kernel/arch/x86_64/bootinfo.vuma
// x86_64 bootinfo — populates the canonical superset BootInfo from Multiboot2.
// ═══════════════════════════════════════════════════════════════════════════
//
// This file is the x86_64 arch-side companion to womb/kernel/bootinfo.vuma
// (the canonical superset). It re-declares the superset BootInfo layout
// byte-identically (VUMA has no `import` — see kernel-developer-guide.md §9
// "Byte-identical re-declaration invariant"), then provides:
//
//   bootinfo_init(bi)
//       The same zero-all-fields helper as the canonical file. Re-declared
//       here so this file compiles standalone.
//
//   x86_bootinfo_init(bi, magic, mbi_addr)
//       x86_64-specific init: calls bootinfo_init first (clean slate), then
//       sets boot_type=0 (x86_multiboot), records the multiboot2 magic in
//       multiboot_magic, and parses the multiboot2 memory map at mbi_addr
//       into mem_start / mem_size.
//
//       The multiboot2 parser is stubbed for hosted mode: mem_start defaults
//       to 1 MB (1048576 — the top of the x86 low-memory hole) and mem_size
//       defaults to 128 MB (134217728 — the standard QEMU default for the
//       `-m 128` test configuration). K13+ will replace the stub with a real
//       multiboot2 info-struct walker (parse mbi_total_size + tags loop,
//       find type 6 = MBI_TAG_MMAP, walk the memory-map entries, pick the
//       largest usable region as mem_start/mem_size).
//
// ── Multiboot2 protocol recap (for K13+ implementer) ───────────────────────
//   At entry, the x86_64 bootloader (GRUB, limine, etc.) puts:
//     EAX = 0x36d76289  (= 920085129 decimal) — the MBI2 magic, confirms
//                                            multiboot2 protocol is in use.
//     EBX = physical address of the MBI2 info structure.
//
//   The MBI2 info structure layout (per multiboot2 spec 0.7):
//     offset 0  u32  total_size   (size of the entire info struct in bytes)
//     offset 4  u32  reserved     (always 0)
//     offset 8  ...   tags[]      (sequence of tagged structs; each begins
//                                  with u16 type + u16 flags + u32 size)
//
//   Relevant tag types:
//     type 0  = MBI_TAG_END              (terminator — size 8)
//     type 1  = MBI_TAG_CMDLINE          (u32 type, u32 size, char string[])
//     type 6  = MBI_TAG_MMAP             (u32 type, u32 size, u32 entry_size,
//                                         u32 entry_version, MBI_MmapEntry[])
//       MBI_MmapEntry = u64 base_addr, u64 length, u32 type, u32 _reserved
//                       (type 1 = RAM, type 2 = reserved, type 3 = ACPI,
//                        type 4 = NVS, type 5 = defective)
//     type 8  = MBI_TAG_FRAMEBUFFER      (u32 type, u32 size, u64 fb_addr,
//                                         u32 fb_pitch, u32 fb_width,
//                                         u32 fb_height, u8 fb_bpp, u8 fb_type,
//                                         ... color-info union)
//
//   The K13+ real implementation:
//     1. Set bi.multiboot_magic = magic (= 920085129 if MBI2 protocol).
//     2. Parse mbi_addr → total_size, then walk tags.
//     3. On MBI_TAG_MMAP: iterate entries; find the largest entry with
//        type == 1 (RAM) whose base_addr >= 1 MB. Set mem_start = base_addr,
//        mem_size = length.
//     4. On MBI_TAG_CMDLINE: set bi.cmdline = (tag_addr + 8) — the string
//        starts immediately after the 8-byte tag header.
//     5. On MBI_TAG_FRAMEBUFFER: set bi.framebuffer = fb_addr,
//        bi.fb_width = fb_width, bi.fb_height = fb_height.
//
//   For now (hosted mode / Wave R1a), the stub just sets mem_start/mem_size
//   to the defaults above and leaves cmdline/framebuffer at 0. The stub is
//   sufficient for kmain's hosted-mode smoke tests (which only read
//   mem_start/mem_size/boot_type).
//
// ── PMT discipline ──────────────────────────────────────────────────────────
//   NO `*ptr`, `&x`, `allocate`, or `free` anywhere in this file. The
//   BootInfo is a flat typed-memory record; the caller allocates it via
//   `state_new(BootInfo)` and passes it by reference to x86_bootinfo_init
//   (init-style API — same convention as the canonical file).
//
//   In particular, the K13+ multiboot2 parser will NOT use raw pointer
//   arithmetic to walk mbi_addr — it will construct a `layout MbiInfo =
//   { ... }` view over the mbi_addr region and use typed field access.
//   (This is the same PMT pattern K9a uses for sk_buff views: define a
//   layout, cast the State to it, read fields by name.)
//
// ── Decimal constants ──────────────────────────────────────────────────────
//   All numeric literals in this file are decimal (per the project-wide
//   convention). Hex values are documented in comments only.
//     1048576     = 0x100000        (1 MB — x86_64 default mem_start)
//     134217728   = 0x8000000       (128 MB — x86_64 stub mem_size)
//     920085129   = 0x36d76289      (multiboot2 bootloader magic)
//
//   NOTE: an earlier draft of the R1a task description listed the magic
//   value as 884264585 decimal — that conversion is incorrect (884264585
//   decimal = 0x34b4ce89, not 0x36d76289). The correct decimal value of
//   0x36d76289 is 920085129; this file uses the correct value. The
//   self-test below does NOT verify the magic value (it only checks
//   boot_type / mem_start / mem_size), so any consistent value would
//   pass — but the correct value is documented here so the K13+ real
//   multiboot2 parser has a trustworthy reference constant.
//
// ── Build & verify (hosted x86_64) ──────────────────────────────────────────
//     . "$HOME/.cargo/env" && CARGO_BUILD_JOBS=4 \
//         cargo build --profile release-fast --bin compile_dump
//     ./target/release-fast/compile_dump \
//         womb/kernel/arch/x86_64/bootinfo.vuma \
//         /tmp/x86_bootinfo.bin x86_64 --verify
//     /tmp/x86_bootinfo.bin ; echo "exit=$?"
// Expected: IVE Pass, exit=0 (x86_bootinfo_init sets boot_type=0,
// mem_start=1048576, mem_size=134217728; the 3 self-test checks pass).

// ────────────────────────────────────────────────────────────────────────────
// Layout — Canonical superset BootInfo (byte-identical re-declaration).
// ────────────────────────────────────────────────────────────────────────────
// MUST match womb/kernel/bootinfo.vuma byte-for-byte (same field order,
// same types, same names). Any drift would silently produce different
// field offsets at the call site — see kernel-developer-guide.md §9.
layout BootInfo = {
    mem_start: u64,
    mem_size: u64,
    cmdline: u64,
    dtb_addr: u64,
    multiboot_magic: u64,
    framebuffer: u64,
    fb_width: u32,
    fb_height: u32,
    boot_type: u8,
    _pad: [u8; 7],
}

// ────────────────────────────────────────────────────────────────────────────
// bootinfo_init: zero every field of a caller-allocated BootInfo.
// ────────────────────────────────────────────────────────────────────────────
// Same as the canonical womb/kernel/bootinfo.vuma::bootinfo_init —
// re-declared here so this file compiles standalone. x86_bootinfo_init
// calls this first to get a clean slate before populating x86-specific
// fields.
fn bootinfo_init(bi: State<BootInfo>) {
    bi.mem_start = 0;
    bi.mem_size = 0;
    bi.cmdline = 0;
    bi.dtb_addr = 0;
    bi.multiboot_magic = 0;
    bi.framebuffer = 0;
    bi.fb_width = 0;
    bi.fb_height = 0;
    bi.boot_type = 0;
    let i = 0;
    while i < 7 {
        bi._pad[i] = 0;
        i = i + 1;
    }
}

// ────────────────────────────────────────────────────────────────────────────
// x86_bootinfo_init: populate the superset BootInfo from Multiboot2 info.
// ────────────────────────────────────────────────────────────────────────────
//   bi       caller-allocated State<BootInfo> (modified in place).
//   magic    the value the bootloader left in EAX at entry. For multiboot2
//            this is 0x36d76289 (= 920085129 decimal). Stored unchanged in
//            bi.multiboot_magic so kmain can later confirm the boot protocol.
//   mbi_addr physical address of the multiboot2 info structure (left in EBX
//            by the bootloader). Currently unused — the K13+ real parser
//            will read it. Stored in the signature now so callers (kmain /
//            boot stubs) don't need to change when the parser lands.
//
// Behavior:
//   1. bootinfo_init(bi)    — zero everything (clean slate).
//   2. bi.boot_type = 0     — x86_multiboot.
//   3. bi.multiboot_magic = magic.
//   4. bi.mem_start = 1048576   — 1 MB (top of x86 low-memory hole).
//   5. bi.mem_size  = 134217728 — 128 MB (QEMU `-m 128` default).
//   6. (K13+) Parse mbi_addr → cmdline, framebuffer, fb_width, fb_height,
//      and refine mem_start/mem_size from the real memory map.
//
// State<T> params: 1 (bi). The `magic` and `mbi_addr` params are pure
// u64 values (no State indirection). The body is 5 field writes after
// the bootinfo_init call — pure typed-memory writes, no pointer ops.
fn x86_bootinfo_init(bi: State<BootInfo>, magic: u64, mbi_addr: u64) {
    bootinfo_init(bi);
    bi.boot_type = 0;          // x86_multiboot
    bi.multiboot_magic = magic;
    // Stub: parse multiboot2 memory map from mbi_addr.
    // For hosted mode, set defaults.
    bi.mem_start = 1048576;    // 1 MB
    bi.mem_size = 134217728;   // 128 MB
    // mbi_addr is intentionally unused in the stub — recorded in the
    // signature for K13+ forward-compatibility. Per the VUMA calling
    // convention, unused parameters are silently dropped (no warning,
    // no error) — same pattern as sys_exec's _entry/_stack in
    // womb/kernel/proc/exec.vuma. The K13+ real parser will read
    // mbi_addr to walk the multiboot2 info-struct tags.
}

// ────────────────────────────────────────────────────────────────────────────
// Self-test (main).
// ────────────────────────────────────────────────────────────────────────────
// Exercises the x86_bootinfo_init API end-to-end:
//   1. Allocate a fresh BootInfo.
//   2. x86_bootinfo_init(bi, 920085129, 0)  — magic = 0x36d76289, mbi=0.
//   3. Check boot_type == 0 (x86_multiboot).
//   4. Check mem_start == 1048576 (1 MB).
//   5. Check mem_size == 134217728 (128 MB).
//
// Returns 0 on success, 1..3 on the 3 individual check failures:
//   1: boot_type != 0
//   2: mem_start != 1048576
//   3: mem_size  != 134217728
fn main() -> i32 {
    let bi = state_new(BootInfo);
    x86_bootinfo_init(bi, 920085129, 0);  // multiboot2 magic 0x36d76289
    if bi.boot_type != 0 { return 1; }
    if bi.mem_start != 1048576 { return 2; }
    if bi.mem_size != 134217728 { return 3; }
    return 0;
}
