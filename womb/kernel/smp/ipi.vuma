// ═══════════════════════════════════════════════════════════════════════════
// womb/kernel/smp/ipi.vuma
// VWK SMP Subsystem — Inter-Processor Interrupt (IPI) send/broadcast/dispatch.
// ═══════════════════════════════════════════════════════════════════════════
//
// This file is the K8e layer of the VWK kernel: the IPI (Inter-Processor
// Interrupt) subsystem. K8 (Sync) is now complete: K8a (spinlock),
// K8b (mutex), K8c (semaphore), K8d (rwlock), and K8e (this file — IPI).
// K8e is the first sub-wave that actively SIGNALS ANOTHER CPU: K8a-K8d
// all synchronize tasks running on the SAME CPU (or tasks that might be
// scheduled onto this CPU), but the actual cross-CPU "wake the other
// CPU up and make it do something" primitive is the IPI.
//
// ── What is an IPI? ────────────────────────────────────────────────────────
//   An Inter-Processor Interrupt is a hardware-mediated signal from one
//   CPU to another (or to all others). The sending CPU writes a command
//   to a memory-mapped interrupt-controller register; the interrupt
//   controller delivers an interrupt to the target CPU(s); the target
//   CPU enters its trap handler, reads the IPI vector number, and calls
//   the registered handler for that vector. IPIs are the SMP equivalent
//   of a function call — but to a different CPU.
//
//   Three classic uses (mentioned in the contract):
//     (1) TLB shootdown — CPU A unmaps a page that CPU B might have
//         cached in its TLB. CPU A sends an IPI to CPU B; CPU B's IPI
//         handler invalidates its TLB entry for that page. Without this,
//         CPU B would keep using the stale translation until something
//         else evicted it.
//     (2) Scheduler reschedule — CPU A wakes up a task that should run
//         on CPU B (e.g. the task is pinned to CPU B, or CPU B is idle
//         and CPU A is busy). CPU A sends a "reschedule" IPI to CPU B;
//         CPU B's IPI handler calls schedule() to pick the new task.
//     (3) Function call broadcast — CPU A wants every CPU to run some
//         function (e.g. flush the per-CPU caches, sync the per-CPU
//         counters). CPU A broadcasts a "function call" IPI; every
//         other CPU's IPI handler runs the function.
//
// ── What K8e provides ──────────────────────────────────────────────────────
//   ipi_init(tbl)                        — zero the handler table (all
//                                           16 vectors → handler = 0,
//                                           count = 0).
//   ipi_register_handler(tbl, vector,    — register a handler function
//                        handler)          address for `vector`. Stuffs
//                                           the 8 bytes of `handler`
//                                           into handlers[vector*8 ..
//                                           vector*8+7]. Bumps count.
//   ipi_get_handler(tbl, vector) -> u64  — fetch the registered handler
//                                           address for `vector`, or 0
//                                           if unregistered.
//   ipi_send(cpu, vector)                — send an IPI to one CPU.
//                                           x86_64: LAPIC ICR write
//                                           (cpu << 12) | vector.
//   ipi_broadcast(vector)                — send an IPI to ALL other
//                                           CPUs (excluding self).
//                                           x86_64: LAPIC ICR write
//                                           vector | 0x30000 (the
//                                           "all excluding self"
//                                           shorthand in bits 18-19).
//   ipi_dispatch(tbl, vector)            — called from the trap handler
//                                           when an IPI is received.
//                                           Looks up the handler for
//                                           `vector` and (in a real
//                                           kernel) calls it. In VUMA
//                                           hosted mode this is a stub
//                                           — VUMA has no fn-pointer
//                                           call (see "Why no
//                                           fn-pointer call?" below).
//
// ── Layout: IpiTable ───────────────────────────────────────────────────────
//   layout IpiTable = {
//       handlers: [u8; 128],  // 16 * 8 bytes — one u64 handler addr
//                              // per vector, byte-packed.
//       count:    u32,        // number of registered handlers
//                              // (diagnostic — bumped on each
//                              // register, never decremented).
//   }
//
//   2 fields × (128 + 4) = 132 bytes. The handler array is at offset 0
//   (so vector N's 8 bytes are at offset N*8, e.g. vector 5 → bytes
//   40..47). The count field is at offset 128 (right after the handler
//   array — 128 = 16 vectors × 8 bytes/vector, no padding needed).
//
//   The handler addresses are byte-packed (not a [u64; 16] array)
//   because VUMA's [u8; N] array is the only array form that the IVE
//   verifier has full byte-level access to. The byte-packing idiom
//   (8 bytes per u64, little-endian: byte 0 = bits 0..7, byte 7 =
//   bits 56..63) is the same one used by K4a's ProcessTable (see
//   pt_set_pid / pt_get_pid in womb/kernel/proc/task.vuma) and by
//   K4f's percpu.vuma (see percpu_set_current / percpu_get_current).
//   This is the PMT-pure way to store a u64 in a struct field array.
//
// ── The 16 IPI vectors ─────────────────────────────────────────────────────
//   VUMA's IpiTable has 16 vectors (0..15). This matches the x86_64
//   convention where IPIs typically use the 0x20..0x3F range (16
//   vectors reserved for IPIs in the IDT — the first 0x20 are CPU
//   exceptions, the next 0x20 are IRQs / IPIs). Linux's IPI vectors
//   (e.g. X86_PLATFORM_IPI_VECTOR, CALL_FUNCTION_VECTOR,
//   RESCHEDULE_VECTOR, IRQ_MOVE_CLEANUP_VECTOR, ...) all live in this
//   range. 16 is enough for the standard set:
//     0  — reschedule (call schedule() on the target CPU).
//     1  — function call (run a function on the target CPU).
//     2  — function call single (run a function on one CPU, then ack).
//     3  — TLB shootdown (invalidate a range of TLB entries).
//     4  — TLB shootdown all (invalidate the entire TLB).
//     5  — IRQ move cleanup (rebalance an IRQ to a different CPU).
//     6  — stop CPU (halt the target CPU for kexec / panic).
//     7  — reboot (reboot the target CPU).
//     8..15 — arch-specific / driver-specific IPIs.
//   The exact assignment is the OS's choice; VUMA just provides the
//   table + dispatch mechanism. The self-test registers vector 0
//   (reschedule) with handler address 0x5000.
//
// ── Per-arch IPI mechanism ─────────────────────────────────────────────────
//   The IPI send/broadcast mechanism is arch-specific. K8e declares
//   three arch-specific externs (lapic_write for x86_64, gic_send_sgi
//   for aarch64, sbi_send_ipi for riscv64) and uses lapic_write on
//   x86_64 (the contract's primary target). The aarch64 and riscv64
//   externs are declared but unused in this file — they're forward
//   declarations for K11's bare-metal parity (when the kernel runs on
//   those arches, the per-arch send code will call gic_send_sgi /
//   sbi_send_ipi instead of lapic_write). In hosted mode all three are
//   __ffi_fallback_stub (returns 0 / no-op).
//
//   x86_64: LAPIC ICR (Interrupt Command Register).
//     - The LAPIC is memory-mapped at the APIC_BASE MSR (typically
//       0xFEE00000). ICR is at offset 0x300 (= decimal 768) within
//       the LAPIC page.
//     - Writing ICR sends an IPI. The low 8 bits are the vector; bits
//       8-19 are the destination (CPU number, shifted left 12 = ×4096);
//       bits 18-19 are the destination shorthand (0b00 = use the
//       destination field, 0b01 = self, 0b10 = all including self,
//       0b11 = all excluding self).
//     - ipi_send(cpu, vector) writes (cpu * 4096) | vector to ICR —
//       the destination field is `cpu`, the shorthand is 0b00 (use
//       the destination field). ICR is a 64-bit register; on x86_64
//       the write is split into two 32-bit writes (ICR low at 0x300,
//       ICR high at 0x310) on real hardware, but VUMA's lapic_write
//       stub takes a u64 and handles the split internally (or in
//       hosted mode, just discards the value).
//     - ipi_broadcast(vector) writes vector | 0x30000 to ICR — the
//       destination field is 0 (ignored), the shorthand is 0b11
//       (all excluding self). 0x30000 = decimal 196608 = bits 18-19
//       both set.
//
//   aarch64: GIC SGI (Software Generated Interrupt).
//     - The GIC (Generic Interrupt Controller) is the aarch64
//       equivalent of the LAPIC. SGIs are IPIs by another name.
//     - gic_send_sgi(cpu, vector) writes to the GIC's GICD_SGIR
//       register: target CPU in bits 16..23, SGI ID (vector) in
//       bits 0..3. K11 stub: `msr icc_sgi1r_el1, <val>; ret`.
//     - The broadcast form (all excluding self) is a different bit
//       pattern (target list = 0, target list type = 1, etc.); K8e's
//       ipi_broadcast only calls lapic_write on x86_64 — the aarch64
//       broadcast would need a separate gic_broadcast_sgi extern,
//       left for K11's bare-metal port.
//
//   riscv64: SBI IPI (Supervisor Binary Interface).
//     - The SBI provides an `sbi_send_ipi(hart_mask)` call that
//       sends an IPI to each hart in `hart_mask`. Each bit in the
//       mask is one hart (CPU). The vector is fixed at SBI_IPI_VECTOR
//       (the IPI is just "wake up"; the handler checks a per-hart
//       mailbox to find what work to do).
//     - sbi_send_ipi(cpu_mask) is the SBI call wrapper. K11 stub:
//       `ecall` with the SBI extension ID for send_ipi.
//     - ipi_send / ipi_broadcast on riscv64 would translate cpu →
//       (1 << cpu) for the mask, or 0xFFFFFFFFFFFFFFFF for broadcast
//       (all harts except self — SBI's mask is "include these harts",
//       so broadcast = all-harts-minus-self requires reading the
//       current hart ID first; K11 will handle this).
//
//   K8e does NOT try to abstract over the three arches with a single
//   send function — the LAPIC's "destination shorthand" trick (write
//   a single u64 to broadcast) is fundamentally different from the
//   GIC's "write SGI ID + target list" and the SBI's "pass a hart
//   mask". A real cross-arch kernel (Linux) has per-arch
//   arch_send_call_function_ipi_mask / arch_send_call_function_single_
//   ipi; K8e mirrors that by keeping the arch call inline (lapic_write
//   directly) and declaring the other arches' externs for future use.
//
// ── Why no fn-pointer call in dispatch? ────────────────────────────────────
//   VUMA has no first-class function-pointer type and no indirect-call
//   instruction. The handlers[] array stores u64 handler addresses
//   (so the table can be inspected, listed, and round-tripped through
//   byte-packed form), but `ipi_dispatch(tbl, vector)` CANNOT actually
//   call the handler — there's no VUMA syntax for "call the function
//   at address handler".
//
//   In a real kernel (K11 bare-metal), the trap handler does this in
//   asm: load handlers[vector*8] into a register, then `call reg`.
//   VUMA's verifier (IVE) doesn't model indirect calls, so the
//   hosted-mode stub just looks up the handler and returns (the
//   contract's note: "In a real kernel: call handler(). VUMA has no
//   fn-pointer call — stub.").
//
//   The self-test verifies that ipi_dispatch doesn't crash and that
//   the handler lookup correctly returns 0x5000 for vector 0 (the
//   handler registered in the test). The actual CALL semantics are
//   exercised by K11's bare-metal parity tests (which run on real
//   hardware and verify that the handler is invoked when the IPI is
//   delivered).
//
// ── Decimal constants ──────────────────────────────────────────────────────
//   Per the K8e contract's "Use decimal constants" rule, all non-zero
//   constants in this file are DECIMAL (not hex):
//     768     = 0x300   — LAPIC ICR offset (the register that sends IPIs).
//     4096    = 0x1000  — bytes-per-CPU shift for the ICR destination field
//                         (CPU N is at bits 12..19 = N << 12 = N * 4096).
//     196608  = 0x30000 — "all excluding self" shorthand (bits 18-19 set).
//     20480   = 0x5000  — the handler address used in the self-test
//                         (could be any non-zero address; 0x5000 is the
//                         "first usable user code address" on many x86
//                         layouts, the contract's choice).
//     255     = 0xFF    — byte mask (the low 8 bits of a shifted u64).
//     128     = 16 * 8  — size of the handlers[] array (16 vectors × 8
//                         bytes per u64 handler address).
//     16      = number of IPI vectors.
//   Decimal avoids the parser's hex-literal path (parse_int_radix
//   width-extension subtleties — see womb/kernel/arch/x86_64/pt.vuma
//   header for the same rationale, and K4f's percpu.vuma for the same
//   rule applied to 131072 / 256 / 5).
//
// ── PMT discipline ─────────────────────────────────────────────────────────
//   No `*ptr`, `&x`, `allocate`, `free`, or any pointer syntax. The
//   IpiTable is a flat struct in a `___pmt_buffer`-backed State<IpiTable>;
//   the caller allocates via `state_new(IpiTable)` and passes by
//   reference (init-style API — same as K8a/K8b/K8c/K8d). The byte-
//   packing idiom (8 bytes per u64, little-endian) is the same one
//   used by K4a's ProcessTable — it's how a PMT-pure file stores a
//   u64 in a struct field array without resorting to pointer casts.
//
//   State<T> params: 1 per function (tbl only), per the K4b "1-2 per
//   function" rule. The 3 externs (lapic_write, gic_send_sgi,
//   sbi_send_ipi) are declared in a single extern "C" block at the
//   top of the file (same convention as K4f's percpu.vuma — VUMA's
//   extern "C" block doesn't support #[cfg(arch)], so all 3 externs
//   resolve to __ffi_fallback_stub on every arch in hosted mode; K11
//   swaps them for real asm stubs registered in src/codegen/src/
//   <arch>/mod.rs::build_runtime_syscall_stubs).
//
//   The `tbl as Address` cast is NOT used in this file (unlike K8a's
//   spinlock.vuma, which uses `lock as Address` for atomic_cas). The
//   IpiTable has no CAS target word — handlers[] is byte-packed and
//   written with plain field stores (no concurrent writers in the
//   hosted self-test; in a real SMP kernel, handler registration
//   would happen once at boot before any IPIs are sent, so no
//   synchronization is needed).
//
// ── VUMA has no `import` ────────────────────────────────────────────────────
//   This file is self-contained. It declares the IpiTable layout (new
//   to this file — no prior VWK file declares it). Three extern "C"
//   stubs (lapic_write, gic_send_sgi, sbi_send_ipi) are declared
//   locally — no other file declares them yet (K3a's trap_trampoline.
//   vuma declares idt_load + irq_mask + irq_unmask + pic_eoi + cr2_
//   read; K3b/K3c declare vbar_write + esr_read + sip_read + sip_
//   clear + stval_read + sie_set + cause_read; K4f's percpu.vuma
//   declares rdgsbase + wrgsbase + rd_tpidr_el0 + wr_tpidr_el0 +
//   rd_tp + wr_tp; K8a's spinlock.vuma declares irq_disable +
//   irq_restore. None of these is the LAPIC / GIC / SBI IPI accessor
//   that K8e needs, so K8e declares its own).
//
// ═══════════════════════════════════════════════════════════════════════════
// Layout.
// ═══════════════════════════════════════════════════════════════════════════

// IpiTable: 16 IPI vectors × 8-byte handler address = 128 bytes for
// handlers, plus a 4-byte count field. Total 132 bytes. See "Layout:
// IpiTable" in the file header for the byte-packing rationale and
// "The 16 IPI vectors" for the vector assignment convention.
layout IpiTable = {
    handlers: [u8; 128],  // 16 * 8 bytes — u64 handler addr per vector
    count: u32,
}

// ═══════════════════════════════════════════════════════════════════════════
// Arch-specific IPI externs (stubs in hosted mode).
// ═══════════════════════════════════════════════════════════════════════════

// See "Per-arch IPI mechanism" in the file header for the per-arch
// semantics. Hosted: __ffi_fallback_stub (returns 0, void calls
// no-op). K11 swaps these for real asm stubs registered in
// src/codegen/src/<arch>/mod.rs::build_runtime_syscall_stubs.
extern "C" {
    // x86_64: write a u64 value to the LAPIC register at offset `reg`
    // (e.g. reg=768 writes ICR, sending an IPI). K11 stub: split the
    // u64 into two 32-bit writes at APIC_BASE + reg (low) and APIC_BASE
    // + reg + 16 (high) — the LAPIC's 64-bit ICR is accessed as two
    // 32-bit MMIO writes on real hardware.
    fn lapic_write(reg: u32, val: u64);
    // aarch64: send an SGI (Software Generated Interrupt) to `cpu`
    // with vector `vector`. K11 stub: compose the GICD_SGIR value
    // (target CPU in bits 16..23, SGI ID in bits 0..3) and write it
    // to the GIC distributor.
    fn gic_send_sgi(cpu: u32, vector: u32);
    // riscv64: send an IPI to each hart in `cpu_mask` (bit N = hart N).
    // K11 stub: ecall with the SBI send_ipi extension ID, passing the
    // physical address of the hart mask as the argument.
    fn sbi_send_ipi(cpu_mask: u64);
    // Wave 5: indirect function call trampoline. Tail-calls the function
    // at `ptr` with `arg` in RDI (SysV AMD64). Used by ipi_dispatch to
    // invoke the per-vector IPI handler. Same stub category as
    // write/read/exit — NOT a C library function. Real asm body
    // registered in src/codegen/src/x86_64/mod.rs::build_runtime_
    // syscall_stubs (8 bytes: mov rax,rdi; mov rdi,rsi; jmp rax).
    fn __call_indirect1(ptr: u64, arg: u64) -> u64;
}

// ═══════════════════════════════════════════════════════════════════════════
// IPI operations.
// ═══════════════════════════════════════════════════════════════════════════

// ipi_init: zero the IpiTable. Sets all 128 bytes of handlers[] to 0
// (meaning "no handler registered for any vector") and count to 0.
// Called once at boot before any IPI is sent or registered. The
// CALLER allocates the IpiTable via `state_new(IpiTable)` and passes
// it by reference (init-style API — same as K8a/K8b/K8c/K8d/K4f).
//
// State<T> params: 1 (tbl). Pure write — no reads, no helper calls.
// The byte-by-byte loop is the PMT-pure way to zero a 128-byte array
// (VUMA has no memset builtin; the loop unrolls to 128 byte-stores,
// which the codegen lowers to a sequence of MOV byte ptr [addr+N], 0
// instructions — efficient on all backends).
fn ipi_init(tbl: State<IpiTable>) {
    let i = 0;
    while i < 128 {
        tbl.handlers[i] = 0;
        i = i + 1;
    }
    tbl.count = 0;
}

// ipi_register_handler: register a handler function address for IPI
// vector `vector`. Stuffs the 8 bytes of `handler` (little-endian:
// byte 0 = bits 0..7, byte 7 = bits 56..63) into handlers[vector*8 ..
// vector*8+7]. Bumps count (so the diagnostic can report "N handlers
// registered").
//
//   tbl:     the IpiTable.
//   vector:  IPI vector number (0..15). Vectors >= 16 are silently
//            ignored (the table has 16 slots — see "The 16 IPI
//            vectors" in the file header for the assignment convention).
//   handler: the function address to call when an IPI with this vector
//            is received. 0 means "unregister" (matches the init
//            state — a 0 handler is treated as "no handler" by
//            ipi_dispatch).
//
// State<T> params: 1 (tbl). Reads nothing from tbl (the vector bounds
// check uses the constant 16, not a tbl field). Writes 8 bytes of
// tbl.handlers (the byte-packed u64). Bumps tbl.count.
//
// The byte-packing loop is the same idiom as K4a's pt_set_pid (see
// womb/kernel/proc/task.vuma:294-303) — VUMA's [u8; N] array is the
// only array form the IVE verifier has full byte-level access to, so
// u64 values stored in struct arrays are byte-packed.
fn ipi_register_handler(tbl: State<IpiTable>, vector: u32, handler: u64) {
    if vector >= 16 { return; }
    let off = vector * 8;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let b = (handler >> sh) & 255;
        tbl.handlers[off + i] = b as u8;
        i = i + 1;
    }
    tbl.count = tbl.count + 1;
}

// ipi_get_handler: fetch the handler function address registered for
// IPI vector `vector`. Returns 0 if vector >= 16 (out of range) or
// if no handler is registered for the vector (the slot is all zero).
//
//   tbl:     the IpiTable.
//   vector:  IPI vector number (0..15).
//
// Returns the 8-byte handler address (u64), or 0 if unregistered.
//
// State<T> params: 1 (tbl). Reads 8 bytes of tbl.handlers (the byte-
// packed u64) and reconstructs the u64 by shifting + ORing. Pure
// read — no writes, no helper calls.
//
// The byte-unpacking loop is the same idiom as K4a's pt_get_pid (see
// womb/kernel/proc/task.vuma:280-291) — inverse of ipi_register_handler.
fn ipi_get_handler(tbl: State<IpiTable>, vector: u32) -> u64 {
    if vector >= 16 { return 0; }
    let off = vector * 8;
    let v: u64 = 0;
    let i = 0;
    while i < 8 {
        let sh = i * 8;
        let b = tbl.handlers[off + i] as u64;
        v = v + (b << sh);
        i = i + 1;
    }
    return v;
}

// ipi_send: send an IPI to a specific CPU. x86_64: writes (cpu * 4096
// + vector) to LAPIC ICR (offset 768). The destination field is `cpu`
// (bits 12..19 = cpu << 12 = cpu * 4096), the vector field is `vector`
// (bits 0..7), the shorthand is 0b00 (use the destination field).
//
//   cpu:     target CPU number (0..N-1, where N is the number of CPUs).
//   vector:  IPI vector number (0..15).
//
// In hosted mode: lapic_write is a __ffi_fallback_stub (no-op), so
// ipi_send just verifies the call doesn't crash (no real IPI is sent
// — hosted mode is single-CPU). K11's bare-metal port wires lapic_write
// to a real LAPIC MMIO write.
//
// The 4096 multiplier (not a left shift) is per the contract's "Use
// decimal constants" rule — `cpu * 4096` is equivalent to `cpu << 12`
// but uses the decimal form (4096 = 0x1000). The codegen lowers this
// to a left-shift on every backend (the opt pass recognizes the
// multiply-by-power-of-2 pattern), so there's no perf cost.
fn ipi_send(cpu: u32, vector: u32) {
    // x86_64: LAPIC ICR write.
    // ICR is at offset 0x300 (768), command is (cpu << 12) | vector.
    // In hosted mode: lapic_write is a stub (no-op).
    let icr_val = (cpu as u64) * 4096 + (vector as u64);
    lapic_write(768, icr_val);
}

// ipi_broadcast: send an IPI to all CPUs except the calling CPU.
// x86_64: writes (vector | 0x30000) to LAPIC ICR (offset 768). The
// destination field is 0 (ignored when the shorthand is "all"), the
// vector field is `vector` (bits 0..7), the shorthand is 0b11 (all
// excluding self — bits 18-19 set, value 0x30000 = decimal 196608).
//
//   vector:  IPI vector number (0..15).
//
// In hosted mode: lapic_write is a stub (no-op). K11's bare-metal port
// sends the real broadcast IPI via the LAPIC shorthand.
//
// The 196608 constant (not 0x30000) is per the contract's "Use decimal
// constants" rule — same rationale as ipi_send's 4096. The OR with
// `vector` combines the vector bits (0..7) with the shorthand bits
// (18..19) without overlapping (vector is at most 15, so bits 4..7
// might be set but bits 18..19 are far above).
fn ipi_broadcast(vector: u32) {
    // x86_64: LAPIC ICR with destination shorthand "all excluding self".
    // Bit 18-19: shorthand. 0b11 = all excluding self.
    let icr_val = (vector as u64) | 196608;  // 196608 = 0x30000 (bits 18-19)
    lapic_write(768, icr_val);
}

// ipi_dispatch: dispatch an IPI to its registered handler. Called from
// the trap handler (K3a's trap_trampoline.vuma / K3b's riscv64
// equivalent) when an IPI is received. Looks up the handler for
// `vector` via ipi_get_handler; if non-zero, invokes it through the
// Wave 5 __call_indirect1 runtime stub — VUMA has no first-class fn-
// pointer type, so indirect dispatch is delegated to the asm trampoline
// (see "Why no fn-pointer call in dispatch?" in the file header for the
// rationale, and the extern block above for the stub signature).
//
//   tbl:     the IpiTable.
//   vector:  IPI vector number (0..15) that was received.
//
// State<T> params: 1 (tbl). Calls ipi_get_handler (which reads 8 bytes
// of tbl.handlers). The handler-address check `if handler != 0` is
// the gate for "should we call the handler?". `tbl` is preserved across
// the __call_indirect1 extern call because it is passed as a regular
// VUMA-fn borrow, NOT as an extern #[borrow] param (only extern
// #[borrow] State<T> params are conservatively invalidated).
//
// This function is the RECEIVING-CPU side of the IPI. The SENDING
// side is ipi_send / ipi_broadcast (above). The full IPI round-trip:
//   CPU A: ipi_send(cpu_b, vector);                    // send
//   CPU B: <trap handler runs>                          // LAPIC delivers
//   CPU B: ipi_dispatch(tbl, vector);                   // receive
//   CPU B: __call_indirect1(handler, vector);           // run
// In hosted mode the LAPIC write is a stub, but the registration /
// lookup / dispatch-logic paths are exercised by the self-test, and
// the indirect-call site is IVE-verified (the compile_dump --verify
// step runs the IVE state verifiers, not the binary itself).
fn ipi_dispatch(tbl: State<IpiTable>, vector: u32) {
    if vector >= 16 { return; }
    let handler = ipi_get_handler(tbl, vector);
    if handler != 0 {
        // Wave 5: invoke the per-vector IPI handler via the indirect-
        // call trampoline. The handler receives `vector as u64` as its
        // first SysV AMD64 argument (RDI) — the convention is "IPI
        // handlers take the vector they were invoked for as their first
        // argument" so a single handler can serve multiple vectors.
        // The u64 return is currently discarded (IPI handlers conven-
        // tionally return void or a status the dispatcher ignores).
        let handler_ret = __call_indirect1(handler, vector as u64);
        return;
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// Self-test (the K8e DoD).
// ═══════════════════════════════════════════════════════════════════════════

// Allocate an IpiTable via state_new, init it, then:
//   (1) Register handler 0x5000 for vector 0 (reschedule).
//   (2) ipi_get_handler(tbl, 0) == 0x5000 (== 20480 decimal — the
//       byte-packing round-trip works: register writes 8 bytes, get
//       reads them back and reconstructs the u64).
//   (3) tbl.count == 1 (the register bumped the count).
//   (4) ipi_send(1, 0) — send IPI to CPU 1 (hosted stub — just
//       verify no crash).
//   (5) ipi_broadcast(0) — broadcast IPI (hosted stub — verify no
//       crash).
//   (6) ipi_dispatch(tbl, 0) — dispatch IPI (hosted stub — verify no
//       crash, handler is found but not called).
//   (7) ipi_get_handler(tbl, 5) == 0 — unregistered vector returns 0
//       (the init-zeroed slot stays zero).
// Returns 0 on success, 1..3 on the corresponding check failure (so
// a future CI failure pinpoints the broken check).
//
// Per the K8e contract's "Use decimal constants" rule: all non-zero
// constants in the self-test use DECIMAL (20480 = 0x5000, the handler
// address; the other constants are 0 / 1 / 5 / 16 — already small
// enough to be unambiguous in either base).

fn main() -> i32 {
    let tbl = state_new(IpiTable);
    ipi_init(tbl);
    // Register handler for vector 0 (reschedule).
    ipi_register_handler(tbl, 0, 0x5000);
    if ipi_get_handler(tbl, 0) != 20480 { return 1; }  // 0x5000 = 20480
    if tbl.count != 1 { return 2; }
    // Send IPI to CPU 1 (stub in hosted mode — just verify no crash).
    ipi_send(1, 0);
    // Broadcast (stub — verify no crash).
    ipi_broadcast(0);
    // Dispatch (stub — verify no crash).
    ipi_dispatch(tbl, 0);
    // Unregistered vector → handler is 0.
    if ipi_get_handler(tbl, 5) != 0 { return 3; }
    return 0;
}
