}

// ────────────────────────────────────────────────────────────────────────────
// Lifecycle primitives.
// ────────────────────────────────────────────────────────────────────────────

// pt_init: zero all 256 states (mark every slot FREE) and set count = 0.
// Idempotent. Called by kmain at boot before the first task_alloc.
// Does NOT zero the other Task fields (pids, ppids, vruntimes, etc.)
// — those are populated by task_alloc / K4d's fork on first use, so
// zeroing them here would be wasted work (and VUMA has no memset).
fn pt_init(tbl: State<ProcessTable>) {
    let i = 0;
    while i < 256 {
        pt_set_state(tbl, i, 0);
        i = i + 1;
    }
    tbl.count = 0;
}

// task_alloc: find the first FREE slot (state == 0), mark it READY
// (state = 2), assign PID = slot + 1 (so PID 0 is never handed out),
// bump count, return the slot index. Returns 256 if the table is full
// (the caller MUST check — K4d's fork returns -EAGAIN in that case).
//
// The lowest-free-slot-wins policy matches Linux's find_next_zero_bit
// (verified by the self-test: free slot 0, alloc → returns 0, not 2).
fn task_alloc(tbl: State<ProcessTable>) -> u32 {
    let i = 0;
    while i < 256 {
        if pt_get_state(tbl, i) == 0 {
            pt_set_state(tbl, i, 2);  // READY
            pt_set_pid(tbl, i, i + 1);  // PID = slot + 1
            tbl.count = tbl.count + 1;
            return i;
        }
        i = i + 1;
    }
    return 256;  // table full
}

// task_free: mark slot `idx` as FREE (state = 0), decrement count.
// Does NOT zero the other Task fields (pid, regs, etc. stay stale until
// task_alloc reuses the slot — task_alloc only writes state + pid,
// leaving the other fields for K4d's fork to repopulate). K4e (exit/
// wait) will flip state to ZOMBIE first (state = 4) and only call
// task_free (state = 0) when the parent reaps via waitpid.
fn task_free(tbl: State<ProcessTable>, idx: u32) {
    pt_set_state(tbl, idx, 0);
    tbl.count = tbl.count - 1;
}

// ────────────────────────────────────────────────────────────────────────────
// Self-test (the K4a DoD).
// ────────────────────────────────────────────────────────────────────────────
// Allocate a ProcessTable via state_new, init it via pt_init, then:
//   (1) task_alloc → returns 0 (first slot).
//   (2) pt_get_state(0) == 2 (READY).
//   (3) pt_get_pid(0) == 1 (PID = slot + 1).
//   (4) tbl.count == 1.
//   (5) task_alloc → returns 1 (second slot).
//   (6) tbl.count == 2.
//   (7) task_free(0); pt_get_state(0) == 0 (FREE).
//   (8) tbl.count == 1.
//   (9) task_alloc → returns 0 (reuses the freed slot — lowest-free-
//       slot-wins policy).
// Returns 0 on success, 1..9 on the corresponding check failure (so a
// future CI failure pinpoints the broken check).
//
// Per the K4a contract's "decimal constants" rule: all non-zero
// constants in the self-test use DECIMAL (1, 2, 9) — decimal avoids
// the parser's hex-literal path (parse_int_radix width-extension
// subtleties — see womb/kernel/arch/x86_64/pt.vuma header for the
// same rationale, and K3a's trap_trampoline.vuma for the same rule
// applied to vector=14 and rip=4096).

fn main() -> i32 {
    let tbl = state_new(ProcessTable);
    pt_init(tbl);

    // Alloc a task — should return slot 0.
    let t0 = task_alloc(tbl);
    if t0 != 0 { return 1; }

    // The new slot should be READY (state == 2).
    if pt_get_state(tbl, 0) != 2 { return 2; }

    // The new slot's PID should be 1 (slot + 1).
    if pt_get_pid(tbl, 0) != 1 { return 3; }

    // count should be 1.
    if tbl.count != 1 { return 4; }

    // Alloc another — should return slot 1.
    let t1 = task_alloc(tbl);
    if t1 != 1 { return 5; }

    // count should be 2.
    if tbl.count != 2 { return 6; }

    // Free slot 0 — state should go to 0 (FREE).
    task_free(tbl, t0);
    if pt_get_state(tbl, 0) != 0 { return 7; }

    // count should be 1.
    if tbl.count != 1 { return 8; }

    // Alloc should reuse slot 0 (lowest-free-slot-wins).
    let t2 = task_alloc(tbl);
    if t2 != 0 { return 9; }

    return 0;
}
