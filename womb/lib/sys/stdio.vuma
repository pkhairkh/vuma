// womb/lib/stdio.vuma — Standard I/O (POSIX stdio.h equivalent)
// No main() — importable library module.
// Provides: write_str, write_int, write_hex, write_u64, read_line, file ops
// Uses the vuma-native syscall() intrinsic for write & read syscalls (asm-generic nrs 64/63).
//
// PMT migration (Wave 8c): the local `allocate(N)` scratch buffers
// (sized 1, 12, 16, 20, 24, 68 bytes) used by the various write_* /
// read_* / eprint_* helpers are replaced by typed `State<BufN>` states
// with `data: [u8; N]` array fields. Access via `*(buf + i)` becomes
// `buf.data[i]`. The states are passed to syscall(63)/syscall(64) /
// write_str/eprint_str where the codegen lowers `State<T>` to its
// underlying buffer address (and callees treat it as a raw `Address`).
// All `allocate`/`free` sites in this file are eliminated.

layout Buf1  = { data: [u8; 1]  }
layout Buf12 = { data: [u8; 12] }
layout Buf16 = { data: [u8; 16] }
layout Buf20 = { data: [u8; 20] }
layout Buf24 = { data: [u8; 24] }
layout Buf68 = { data: [u8; 68] }

const STDOUT: i64 = 1;
const STDERR: i64 = 2;
const STDIN: i64 = 0;

// ===========================================================================
// Output functions
// ===========================================================================

fn write_str(s: Address) -> i64 {
    n: u32 = 0;
    while *(s + n) != 0 { n = n + 1; }
    return syscall(64, STDOUT, s, n as i64);
}

fn write_str_fd(fd: i64, s: Address) -> i64 {
    n: u32 = 0;
    while *(s + n) != 0 { n = n + 1; }
    return syscall(64, fd, s, n as i64);
}

fn write_bytes(fd: i64, buf: Address, len: u32) -> i64 {
    return syscall(64, fd, buf, len as i64);
}

fn write_char(c: u32) -> i64 {
    let buf = state_new(Buf1);
    buf.data[0] = c & 255;
    ret: i64 = syscall(64, STDOUT, buf, 1);
    return ret;
}

fn write_newline() -> i64 {
    let buf = state_new(Buf1);
    buf.data[0] = 10;
    ret: i64 = syscall(64, STDOUT, buf, 1);
    return ret;
}

fn write_int(val: i64) -> i64 {
    let buf = state_new(Buf24);
    if val == 0 {
        buf.data[0] = 48;
        buf.data[1] = 0;
        write_str(buf);
        return 1;
    }
    v: i64 = val;
    pos: u32 = 0;
    if val < 0 { v = 0 - val; }

    let temp = state_new(Buf24);
    tp: u32 = 0;
    while v > 0 {
        d: u32 = v % 10;
        temp.data[tp] = 48 + d;
        tp = tp + 1;
        v = v / 10;
    }

    if val < 0 { buf.data[pos] = 45; pos = pos + 1; }
    while tp > 0 {
        tp = tp - 1;
        buf.data[pos] = temp.data[tp];
        pos = pos + 1;
    }
    buf.data[pos] = 0;
    ret: i64 = write_str(buf);
    return ret;
}

fn write_uint(val: u64) -> i64 {
    let buf = state_new(Buf24);
    if val == 0 {
        buf.data[0] = 48;
        buf.data[1] = 0;
        write_str(buf);
        return 1;
    }
    v: u64 = val;
    pos: u32 = 0;
    let temp = state_new(Buf24);
    tp: u32 = 0;
    while v > 0 {
        d: u64 = v % 10;
        temp.data[tp] = 48 + d;
        tp = tp + 1;
        v = v / 10;
    }
    while tp > 0 {
        tp = tp - 1;
        buf.data[pos] = temp.data[tp];
        pos = pos + 1;
    }
    buf.data[pos] = 0;
    ret: i64 = write_str(buf);
    return ret;
}

fn write_hex(val: u64) -> i64 {
    let buf = state_new(Buf20);
    buf.data[0] = 48;  // '0'
    buf.data[1] = 120; // 'x'
    pos: u32 = 2;

    let temp = state_new(Buf16);
    tp: u32 = 0;
    v: u64 = val;
    i: u32 = 0;
    while i < 16 {
        nibble: u64 = (v >> 60) & 15;
        c: u32 = 0;
        if nibble < 10 { c = 48 + nibble; } else { c = 97 + nibble - 10; }
        temp.data[tp] = c;
        tp = tp + 1;
        v = v << 4;
        i = i + 1;
    }

    // Skip leading zeros
    start: u32 = 0;
    while start < tp - 1 {
        if temp.data[start] != 48 { break; }
        start = start + 1;
    }

    i = start;
    while i < tp {
        buf.data[pos] = temp.data[i];
        pos = pos + 1;
        i = i + 1;
    }
    buf.data[pos] = 0;

    ret: i64 = write_str(buf);
    return ret;
}

fn write_hex_u32(val: u32) -> i64 {
    let buf = state_new(Buf12);
    buf.data[0] = 48;
    buf.data[1] = 120;
    pos: u32 = 2;
    i: u32 = 0;
    while i < 8 {
        nibble: u32 = (val >> 28) & 15;
        c: u32 = 0;
        if nibble < 10 { c = 48 + nibble; } else { c = 97 + nibble - 10; }
        buf.data[pos] = c;
        pos = pos + 1;
        val = val << 4;
        i = i + 1;
    }
    buf.data[pos] = 0;
    ret: i64 = write_str(buf);
    return ret;
}

fn write_bin(val: u64) -> i64 {
    let buf = state_new(Buf68);
    buf.data[0] = 48;
    buf.data[1] = 98;
    pos: u32 = 2;
    i: u32 = 0;
    while i < 64 {
        bit: u32 = (val >> 63) & 1;
        buf.data[pos] = 48 + bit;
        pos = pos + 1;
        val = val << 1;
        i = i + 1;
    }
    buf.data[pos] = 0;
    ret: i64 = write_str(buf);
    return ret;
}

// ===========================================================================
// printf-style formatted output
// ===========================================================================

fn printf_str(s: Address) -> i64 {
    return write_str(s);
}

fn printf_int(val: i64) -> i64 {
    return write_int(val);
}

fn printf_uint(val: u64) -> i64 {
    return write_uint(val);
}

fn printf_hex(val: u64) -> i64 {
    return write_hex(val);
}

fn printf_newline() -> i64 {
    return write_newline();
}

fn printf_str_int(str_part: Address, int_val: i64) -> i64 {
    write_str(str_part);
    return write_int(int_val);
}

fn printf_int_str(int_val: i64, str_part: Address) -> i64 {
    write_int(int_val);
    return write_str(str_part);
}

fn printf_str_int_str(part1: Address, val: i64, part2: Address) -> i64 {
    write_str(part1);
    write_int(val);
    return write_str(part2);
}

fn printf_str_uint_str(part1: Address, val: u64, part2: Address) -> i64 {
    write_str(part1);
    write_uint(val);
    return write_str(part2);
}

fn printf_str_hex_str(part1: Address, val: u64, part2: Address) -> i64 {
    write_str(part1);
    write_hex(val);
    return write_str(part2);
}

// ===========================================================================
// Input functions
// ===========================================================================

fn read_line(buf: Address, max_len: u32) -> u32 {
    pos: u32 = 0;
    while pos < max_len - 1 {
        let char_buf = state_new(Buf1);
        n: i64 = syscall(63, STDIN, char_buf, 1);
        if n <= 0 {
            break;
        }
        c: u32 = char_buf.data[0];
        if c == 10 {  // newline
            break;
        }
        *(buf + pos) = c;
        pos = pos + 1;
    }
    *(buf + pos) = 0;
    return pos;
}

fn read_bytes(buf: Address, max_len: u32) -> i64 {
    return syscall(63, STDIN, buf, max_len as i64);
}

fn read_byte() -> u32 {
    let char_buf = state_new(Buf1);
    n: i64 = syscall(63, STDIN, char_buf, 1);
    if n <= 0 {
        return 4294967295;  // EOF
    }
    c: u32 = char_buf.data[0];
    return c;
}

// ===========================================================================
// Error output (stderr)
// ===========================================================================

fn eprint_str(s: Address) -> i64 {
    n: u32 = 0;
    while *(s + n) != 0 { n = n + 1; }
    return syscall(64, STDERR, s, n as i64);
}

fn eprint_int(val: i64) -> i64 {
    let buf = state_new(Buf24);
    if val == 0 {
        buf.data[0] = 48;
        buf.data[1] = 0;
        eprint_str(buf);
        return 1;
    }
    v: i64 = val;
    pos: u32 = 0;
    if val < 0 { v = 0 - val; }
    let temp = state_new(Buf24);
    tp: u32 = 0;
    while v > 0 {
        d: u32 = v % 10;
        temp.data[tp] = 48 + d;
        tp = tp + 1;
        v = v / 10;
    }
    if val < 0 { buf.data[pos] = 45; pos = pos + 1; }
    while tp > 0 {
        tp = tp - 1;
        buf.data[pos] = temp.data[tp];
        pos = pos + 1;
    }
    buf.data[pos] = 0;
    ret: i64 = eprint_str(buf);
    return ret;
}

fn eprintln_str(s: Address) -> i64 {
    eprint_str(s);
    let nl = state_new(Buf1);
    nl.data[0] = 10;
    ret: i64 = syscall(64, STDERR, nl, 1);
    return ret;
}
