// womb/lib/time.vuma — Time and Sleep Functions (POSIX time.h equivalent)
// No main() — importable library module.
// Uses the vuma-native syscall() intrinsic for clock_gettime & nanosleep
// syscalls (asm-generic nrs 113 / 101).
//
// PMT migration (Wave 8c): the local `allocate(16)` timespec scratch
// buffers (in `time_now`, `time_monotonic`, `time_monotonic_ns`,
// `epoch_millis`, `sleep_ms`) are replaced by typed `State<Timespec>`
// with `sec: i64` and `nsec: i64` fields. The byte-stitched
// load/store loops are eliminated — fields are accessed directly as
// `ts.sec` / `ts.nsec`. The `ts`/`req`/`rem` states are passed to
// syscall(113)/syscall(101) where the codegen lowers `State<T>` to its
// underlying buffer address. All `allocate`/`free` sites in this file
// are eliminated.

layout Timespec = { sec: i64, nsec: i64 }

const CLOCK_REALTIME: i64 = 0;
const CLOCK_MONOTONIC: i64 = 1;
const CLOCK_PROCESS_CPUTIME_ID: i64 = 2;
const CLOCK_THREAD_CPUTIME_ID: i64 = 3;

fn time_now() -> u64 {
    let ts = state_new(Timespec);
    syscall(113, CLOCK_REALTIME, ts);
    return ts.sec as u64;
}

fn time_monotonic() -> u64 {
    let ts = state_new(Timespec);
    syscall(113, CLOCK_MONOTONIC, ts);
    return ts.sec as u64;
}

fn time_monotonic_ns() -> u64 {
    let ts = state_new(Timespec);
    syscall(113, CLOCK_MONOTONIC, ts);
    return (ts.sec as u64) * 1000000000 + (ts.nsec as u64);
}

fn time_monotonic_us() -> u64 {
    return time_monotonic_ns() / 1000;
}

fn time_monotonic_ms() -> u64 {
    return time_monotonic_ns() / 1000000;
}

// ===========================================================================
// Sleep functions
// ===========================================================================

fn sleep_ms(ms: u32) -> i64 {
    let req = state_new(Timespec);
    req.sec = (ms / 1000) as i64;
    req.nsec = ((ms % 1000) * 1000000) as i64;

    let rem = state_new(Timespec);
    let ret: i64 = syscall(101, req, rem);
    return ret;
}

fn sleep_us(us: u32) -> i64 {
    return sleep_ms(us / 1000);
}

fn sleep_s(secs: u32) -> i64 {
    return sleep_ms(secs * 1000);
}

// ===========================================================================
// Timestamp helpers
// ===========================================================================

fn time_diff_ms(start: u64, end: u64) -> u64 {
    return (end - start) / 1000000;
}

fn time_diff_us(start: u64, end: u64) -> u64 {
    return (end - start) / 1000;
}

fn time_diff_ns(start: u64, end: u64) -> u64 {
    return end - start;
}

// ===========================================================================
// Epoch conversion helpers (Unix epoch)
// ===========================================================================

fn epoch_seconds() -> u64 {
    return time_now();
}

fn epoch_millis() -> u64 {
    let ts = state_new(Timespec);
    syscall(113, CLOCK_REALTIME, ts);
    return (ts.sec as u64) * 1000 + (ts.nsec as u64) / 1000000;
}
