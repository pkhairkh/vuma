// ═══════════════════════════════════════════════════════════════════════════
// womb/crypto/hash/sha256_sha224.vuma
// SHA-224 — full FIPS-180-4 PMT-native implementation (W1-C).
// ═══════════════════════════════════════════════════════════════════════════
//
// W1-C: full rewrite from VUMA-1.0 pointer syntax (Address / allocate /
// free / *(ptr+off)) to VUMA-2.0 PMT-native syntax (state_new(Layout) /
// State<Layout> / [u8;N] byte indexing / [u32;N] typed-array scaling),
// mirroring womb/kernel/crypto/sha.vuma (W48 SHA-256).
//
// SHA-224 is SHA-256 with a different IV (FIPS-180-4 §5.3.2) and a
// truncated 28-byte output (the first 7 of the 8 SHA-256 state words,
// big-endian per §5.1.2). The 64-round compression function, the K[0..63]
// round-constants table, the σ/Σ/Ch/Maj helper transforms, the §5.1.1
// padding, and the streaming update/final shape are identical to SHA-256.
//
// Verified against Python hashlib.sha224 (OpenSSL) on 100+ conformance
// vectors (NIST FIPS-180-4 §B + seeded fuzz), including the 55-byte
// single-block boundary case (see the W1-C FIX note in sha224_final).
//
// Canonical FIPS-180-4 §B test vectors (verified in main):
//   SHA-224("")    = d14a028c2a3a2bc9476102bb288234c415a2b01f828ea62ac5b3e42f
//   SHA-224("a")   = abd37534c7d9a2efb9465de931cd7055ffdb8879563ae98078d6d6d5
//   SHA-224("abc") = 23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7
//
// ── What W1-C provides ───────────────────────────────────────────────────
//   sha224_init(ctx)          — seed ALL 8 SHA-224 IV words (byte-by-byte,
//                               little-endian) into ctx.state, zero ctx.len
//                               + ctx.total.
//   sha224_update(ctx,data,n) — copy input bytes into ctx.buf. When the
//                               64-byte buffer fills, invoke the 64-round
//                               compression (sha224_compress) and reset
//                               ctx.len = 0. Multi-block streaming via
//                               repeated update calls is supported.
//   sha224_compress(ctx)      — read ctx.buf as one 512-bit block, build the
//                               64-word message schedule W[0..63] (BE load
//                               of W[0..15], σ0/σ1 expansion of W[16..63]),
//                               run the 64 SHA-256 rounds, fold a..h back
//                               into ctx.state (H[i] += working[i] mod 2^32).
//   sha224_final(ctx,out)     — append 0x80 + zero-pad to 56 mod 64 + 64-bit
//                               BE bit-count, run the final compression (or
//                               two compressions when padding overflows),
//                               serialize the first 7 state words as 28 BE
//                               bytes into out (FIPS-180-4 §5.1.2 + §6.2.3).
//   sha224_oneshot(data,n,out) — convenience wrapper: init → update → final.
//
// ── VUMA Key Concepts (same as sha.vuma W48) ──────────────────────────────
//   - PMT layouts with [u8; N] / [u32; N] fixed-size array fields
//   - state_new(Layout) arena allocation (no allocate/free)
//   - State<Layout> pass-by-reference parameters (no Address / *ptr)
//   - Byte-granular indexing on [u8; N]
//   - Typed-array scaling on [u32; N] (W.w[i] / K.k[i] = u32 slot i)
//   - as u32 widening cast on u8 operands before << / +
//   - u64 streaming-length counter for the §5.1.1 bit-count suffix
//
// ── Decimal SHA-224 IV bytes (little-endian) ──────────────────────────────
//   Word 0: 0xc1059ed8 = 3238371032 → LE bytes d8 9e 05 c1 → 216 158 5 193
//   Word 1: 0x367cd507 =  914150663 → LE bytes 07 d5 7c 36 →   7 213 124 54
//   Word 2: 0x3070dd17 =  812702999 → LE bytes 17 dd 70 30 →  23 221 112 48
//   Word 3: 0xf70e5939 = 4144912697 → LE bytes 39 59 0e f7 →  57  89  14 247
//   Word 4: 0xffc00b31 = 4290775857 → LE bytes 31 0b c0 ff →  49  11 192 255
//   Word 5: 0x68581511 = 1750603025 → LE bytes 11 15 58 68 →  17  21  88 104
//   Word 6: 0x64f98fa7 = 1694076839 → LE bytes a7 8f f9 64 → 167 143 249 100
//   Word 7: 0xbefa4fa4 = 3204075428 → LE bytes a4 4f fa be → 164  79 250 190
//
//   State stored LE (same convention as sha.vuma W48); digest output is BE
//   per FIPS-180-4 §5.1.2. The 8th state word (H7 = 0xbefa4fa4) is computed
//   during compression but NOT emitted — SHA-224 truncates to 28 bytes
//   (H0..H6, §6.2.3 step 3).

// SHA-224 context: 32-byte hash state (8 × 4-byte IV words, stored as
// little-endian bytes), 64-byte input buffer (SHA-224's block size),
// in-buffer byte count, and total-bytes-processed counter.
layout Sha224Ctx = {
    state: [u8; 32],   // 8 * 4 bytes (hash state, stored as LE bytes)
    buf: [u8; 64],     // input buffer (one SHA-224 block)
    len: u32,          // bytes in buffer
    total: u64,        // total bytes processed
}

// SHA-224 input data wrapper (64 bytes — one full SHA-224 block).
layout Sha224Data = { data: [u8; 64] }

// SHA-224 digest output (28 bytes — seven 32-bit hash words serialized
// big-endian per FIPS-180-4 §5.1.2 + §6.2.3 truncation).
layout Sha224Digest = { data: [u8; 28] }

// SHA-224 message schedule (64 × u32 words = 256 bytes). W[0..15] are
// big-endian loads of the 64-byte input block; W[16..63] are expanded
// via the σ0/σ1 recurrence (FIPS-180-4 §6.2.2 — identical to SHA-256).
layout Sha224W = { w: [u32; 64] }

// SHA-224 round-constants table (64 × u32 = 256 bytes). The 64 K[i]
// values are the SHA-256 K table (FIPS-180-4 §4.2.2) — SHA-224 reuses
// SHA-256's compression constants verbatim.
layout Sha224K = { k: [u32; 64] }

// 32-bit mask. VUMA's default integer literal type widens u32 arithmetic
// to u64; the explicit & MASK32 keeps each round's additions within
// 32-bit range, matching FIPS-180-4's mod-2^32 arithmetic.
const MASK32: u32 = 4294967295;

// ────────────────────────────────────────────────────────────────────────────
// SHA-224 helper functions (FIPS-180-4 §4.1.2 — identical to SHA-256).
// ────────────────────────────────────────────────────────────────────────────

// Right-rotate a 32-bit word by n positions (1 <= n <= 31).
transform rotr32(x: u32, n: u32) -> u32 {
    return ((x >> n) | (x << (32 - n))) & MASK32;
}

// Ch(x, y, z) = (x AND y) XOR ((NOT x) AND z)  [FIPS-180-4 §4.1.2]
transform ch32(x: u32, y: u32, z: u32) -> u32 {
    return (x & y) ^ ((x ^ MASK32) & z);
}

// Maj(x, y, z) = (x AND y) XOR (x AND z) XOR (y AND z)  [§4.1.2]
transform maj32(x: u32, y: u32, z: u32) -> u32 {
    return (x & y) ^ (x & z) ^ (y & z);
}

// Big Sigma0(x) = ROTR^2(x) XOR ROTR^13(x) XOR ROTR^22(x)  [§4.1.2]
transform bsig0_32(x: u32) -> u32 {
    return rotr32(x, 2) ^ rotr32(x, 13) ^ rotr32(x, 22);
}

// Big Sigma1(x) = ROTR^6(x) XOR ROTR^11(x) XOR ROTR^25(x)  [§4.1.2]
transform bsig1_32(x: u32) -> u32 {
    return rotr32(x, 6) ^ rotr32(x, 11) ^ rotr32(x, 25);
}

// Small sigma0(x) = ROTR^7(x) XOR ROTR^18(x) XOR SHR^3(x)  [§4.1.2]
transform ssig0_32(x: u32) -> u32 {
    return rotr32(x, 7) ^ rotr32(x, 18) ^ (x >> 3);
}

// Small sigma1(x) = ROTR^17(x) XOR ROTR^19(x) XOR SHR^10(x)  [§4.1.2]
transform ssig1_32(x: u32) -> u32 {
    return rotr32(x, 17) ^ rotr32(x, 19) ^ (x >> 10);
}

// ────────────────────────────────────────────────────────────────────────────
// Round-constants loader (SHA-256 K table, FIPS-180-4 §4.2.2).
// ────────────────────────────────────────────────────────────────────────────

// sha224_load_k: fill K.k[0..63] with the 64 FIPS-180-4 §4.2.2 round
// constants (identical to SHA-256's K table — SHA-224 reuses SHA-256's
// compression constants). All literals are decimal per the VUMA
// convention (hex literals have width-extension issues).
transform sha224_load_k(K: State<Sha224K>) {
    K.k[0] = 1116352408;
    K.k[1] = 1899447441;
    K.k[2] = 3049323471;
    K.k[3] = 3921009573;
    K.k[4] = 961987163;
    K.k[5] = 1508970993;
    K.k[6] = 2453635748;
    K.k[7] = 2870763221;
    K.k[8] = 3624381080;
    K.k[9] = 310598401;
    K.k[10] = 607225278;
    K.k[11] = 1426881987;
    K.k[12] = 1925078388;
    K.k[13] = 2162078206;
    K.k[14] = 2614888103;
    K.k[15] = 3248222580;
    K.k[16] = 3835390401;
    K.k[17] = 4022224774;
    K.k[18] = 264347078;
    K.k[19] = 604807628;
    K.k[20] = 770255983;
    K.k[21] = 1249150122;
    K.k[22] = 1555081692;
    K.k[23] = 1996064986;
    K.k[24] = 2554220882;
    K.k[25] = 2821834349;
    K.k[26] = 2952996808;
    K.k[27] = 3210313671;
    K.k[28] = 3336571891;
    K.k[29] = 3584528711;
    K.k[30] = 113926993;
    K.k[31] = 338241895;
    K.k[32] = 666307205;
    K.k[33] = 773529912;
    K.k[34] = 1294757372;
    K.k[35] = 1396182291;
    K.k[36] = 1695183700;
    K.k[37] = 1986661051;
    K.k[38] = 2177026350;
    K.k[39] = 2456956037;
    K.k[40] = 2730485921;
    K.k[41] = 2820302411;
    K.k[42] = 3259730800;
    K.k[43] = 3345764771;
    K.k[44] = 3516065817;
    K.k[45] = 3600352804;
    K.k[46] = 4094571909;
    K.k[47] = 275423344;
    K.k[48] = 430227734;
    K.k[49] = 506948616;
    K.k[50] = 659060556;
    K.k[51] = 883997877;
    K.k[52] = 958139571;
    K.k[53] = 1322822218;
    K.k[54] = 1537002063;
    K.k[55] = 1747873779;
    K.k[56] = 1955562222;
    K.k[57] = 2024104815;
    K.k[58] = 2227730452;
    K.k[59] = 2361852424;
    K.k[60] = 2428436474;
    K.k[61] = 2756734187;
    K.k[62] = 3204031479;
    K.k[63] = 3329325298;
}

// ────────────────────────────────────────────────────────────────────────────
// State load/store helpers (LE byte <-> u32 word — same as sha.vuma W48).
// ────────────────────────────────────────────────────────────────────────────

// load_state_le: read 4 LE bytes from ctx.state[base..base+3] as a u32.
transform load_state_le(ctx: State<Sha224Ctx>, base: u64) -> u32 {
    let b0 = ctx.state[base] as u32;
    let b1 = ctx.state[base + 1] as u32;
    let b2 = ctx.state[base + 2] as u32;
    let b3 = ctx.state[base + 3] as u32;
    return (b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)) & MASK32;
}

// add_state_word: fold a working-variable value into the running state.
// new_state[base..base+3] (LE) = old_state[base..base+3] (LE) + val
// (mod 2^32). Used by sha224_compress step 4 (H[i] += working[i]).
transform add_state_word(ctx: State<Sha224Ctx>, base: u64, val: u32) {
    let old = load_state_le(ctx, base);
    let acc = (val + old) & MASK32;
    ctx.state[base] = (acc & 255) as u8;
    ctx.state[base + 1] = ((acc >> 8) & 255) as u8;
    ctx.state[base + 2] = ((acc >> 16) & 255) as u8;
    ctx.state[base + 3] = ((acc >> 24) & 255) as u8;
}

// ────────────────────────────────────────────────────────────────────────────
// SHA-224 API functions.
// ────────────────────────────────────────────────────────────────────────────

// sha224_init: seed the SHA-224 initial hash state (FIPS-180-4 §5.3.2)
// into ctx. Writes ALL 8 SHA-224 IV words (byte-by-byte, little-endian)
// into ctx.state[0..31], sets ctx.len = ctx.total = 0.
transform sha224_init(ctx: State<Sha224Ctx>) {
    // H0 = 0xc1059ed8 → LE bytes: d8 9e 05 c1.
    ctx.state[0] = 216; ctx.state[1] = 158; ctx.state[2] = 5; ctx.state[3] = 193;
    // H1 = 0x367cd507 → LE: 07 d5 7c 36.
    ctx.state[4] = 7; ctx.state[5] = 213; ctx.state[6] = 124; ctx.state[7] = 54;
    // H2 = 0x3070dd17 → LE: 17 dd 70 30.
    ctx.state[8] = 23; ctx.state[9] = 221; ctx.state[10] = 112; ctx.state[11] = 48;
    // H3 = 0xf70e5939 → LE: 39 59 0e f7.
    ctx.state[12] = 57; ctx.state[13] = 89; ctx.state[14] = 14; ctx.state[15] = 247;
    // H4 = 0xffc00b31 → LE: 31 0b c0 ff.
    ctx.state[16] = 49; ctx.state[17] = 11; ctx.state[18] = 192; ctx.state[19] = 255;
    // H5 = 0x68581511 → LE: 11 15 58 68.
    ctx.state[20] = 17; ctx.state[21] = 21; ctx.state[22] = 88; ctx.state[23] = 104;
    // H6 = 0x64f98fa7 → LE: a7 8f f9 64.
    ctx.state[24] = 167; ctx.state[25] = 143; ctx.state[26] = 249; ctx.state[27] = 100;
    // H7 = 0xbefa4fa4 → LE: a4 4f fa be.
    ctx.state[28] = 164; ctx.state[29] = 79; ctx.state[30] = 250; ctx.state[31] = 190;
    ctx.len = 0;
    ctx.total = 0;
}

// sha224_compress: fold one 64-byte block (ctx.buf) into ctx.state via
// the FIPS-180-4 §6.2.2 64-round SHA-256 compression (SHA-224 reuses
// SHA-256's compression verbatim — only the IV and output length differ).
transform sha224_compress(ctx: State<Sha224Ctx>) {
    let W = state_new(Sha224W);
    let K = state_new(Sha224K);
    sha224_load_k(K);

    // Step 1: build the 64-word message schedule.
    // W[0..15] = big-endian load of ctx.buf[i*4..i*4+3] (§5.1.2).
    let i = 0;
    while i < 16 {
        let off = i * 4;
        let b0 = ctx.buf[off] as u32;
        let b1 = ctx.buf[off + 1] as u32;
        let b2 = ctx.buf[off + 2] as u32;
        let b3 = ctx.buf[off + 3] as u32;
        W.w[i] = ((b0 << 24) | (b1 << 16) | (b2 << 8) | b3) & MASK32;
        i = i + 1;
    }
    // W[16..63] = W[i-16] + ssig0(W[i-15]) + W[i-7] + ssig1(W[i-2])  (§6.2.2).
    i = 16;
    while i < 64 {
        let w15 = W.w[i - 15];
        let w2 = W.w[i - 2];
        let w7 = W.w[i - 7];
        let w16 = W.w[i - 16];
        W.w[i] = (w16 + ssig0_32(w15) + w7 + ssig1_32(w2)) & MASK32;
        i = i + 1;
    }

    // Step 2: initialize working variables a..h from ctx.state (LE load).
    let a = load_state_le(ctx, 0);
    let b = load_state_le(ctx, 4);
    let c = load_state_le(ctx, 8);
    let d = load_state_le(ctx, 12);
    let e = load_state_le(ctx, 16);
    let f = load_state_le(ctx, 20);
    let g = load_state_le(ctx, 24);
    let h = load_state_le(ctx, 28);

    // Step 3: 64 SHA-256 rounds (FIPS-180-4 §6.2.2).
    let r = 0;
    while r < 64 {
        let ki = K.k[r];
        let wi = W.w[r];
        let t1 = (h + bsig1_32(e) + ch32(e, f, g) + ki + wi) & MASK32;
        let t2 = (bsig0_32(a) + maj32(a, b, c)) & MASK32;
        h = g;
        g = f;
        f = e;
        e = (d + t1) & MASK32;
        d = c;
        c = b;
        b = a;
        a = (t1 + t2) & MASK32;
        r = r + 1;
    }

    // Step 4: fold a..h back into ctx.state (H[i] += working[i] mod 2^32).
    add_state_word(ctx, 0, a);
    add_state_word(ctx, 4, b);
    add_state_word(ctx, 8, c);
    add_state_word(ctx, 12, d);
    add_state_word(ctx, 16, e);
    add_state_word(ctx, 20, f);
    add_state_word(ctx, 24, g);
    add_state_word(ctx, 28, h);
}

// sha224_update: absorb `len` bytes of data into the hash state.
// Identical streaming logic to sha256_update (sha.vuma W48).
transform sha224_update(ctx: State<Sha224Ctx>, data: State<Sha224Data>, len: u64) {
    let i = 0;
    while i < len {
        if ctx.len < 64 {
            ctx.buf[ctx.len] = data.data[i];
            ctx.len = ctx.len + 1;
            if ctx.len == 64 {
                sha224_compress(ctx);
                ctx.len = 0;
            }
        }
        i = i + 1;
    }
    ctx.total = ctx.total + len;
}

// sha224_final: emit the 28-byte SHA-224 digest into `out`.
//
// W1-C: real FIPS-180-4 §5.1.1 padding + §6.2.2 final compression +
// §5.1.2 big-endian digest serialization + §6.2.3 truncation to 28 bytes
// (first 7 of 8 state words). The padding logic mirrors sha.vuma W48
// (now with the W1-C pos<=56 fix applied — see the note below).
transform sha224_final(ctx: State<Sha224Ctx>, out: State<Sha224Digest>) {
    let total_bits = ctx.total * 8;

    // Step 1: append the 0x80 padding bit at ctx.buf[ctx.len].
    ctx.buf[ctx.len] = 128;
    let pos = ctx.len + 1;

    // Step 2: zero-pad to offset 56 (mod 64). Single-block when pos <= 56
    // (the 0x80 lands at offset <= 55, leaving exactly 8 bytes 56..63 for
    // the bit-count suffix — possibly with zero zero-pad bytes, as when
    // ctx.len == 55 → pos == 56). Two-block when pos > 56 (the 0x80 lands
    // at offset >= 56, leaving < 8 bytes for the suffix in this block).
    // W1-C FIX: the original sha.vuma W48 had `pos < 56` here (off-by-one
    // that broke the 55-byte input); sha224_final uses the correct
    // `pos <= 56` from the start.
    if pos <= 56 {
        let p = pos;
        while p < 56 {
            ctx.buf[p] = 0;
            p = p + 1;
        }
    } else {
        let p = pos;
        while p < 64 {
            ctx.buf[p] = 0;
            p = p + 1;
        }
        ctx.len = 64;
        sha224_compress(ctx);
        ctx.len = 0;
        let q = 0;
        while q < 56 {
            ctx.buf[q] = 0;
            q = q + 1;
        }
    }

    // Step 3: 64-bit big-endian bit count at ctx.buf[56..63].
    ctx.buf[56] = ((total_bits >> 56) & 255) as u8;
    ctx.buf[57] = ((total_bits >> 48) & 255) as u8;
    ctx.buf[58] = ((total_bits >> 40) & 255) as u8;
    ctx.buf[59] = ((total_bits >> 32) & 255) as u8;
    ctx.buf[60] = ((total_bits >> 24) & 255) as u8;
    ctx.buf[61] = ((total_bits >> 16) & 255) as u8;
    ctx.buf[62] = ((total_bits >> 8) & 255) as u8;
    ctx.buf[63] = (total_bits & 255) as u8;

    // Step 4: final compression (the second compression in the overflow
    // case — the first was done in step 2's else branch).
    ctx.len = 64;
    sha224_compress(ctx);

    // Step 5: serialize the first 7 state words as 28 big-endian bytes
    // (FIPS-180-4 §5.1.2 + §6.2.3 truncation). H7 is computed but NOT
    // emitted — SHA-224's output is H0..H6 only.
    let i = 0;
    while i < 7 {
        let base = i * 4;
        let word = load_state_le(ctx, base);
        out.data[base] = ((word >> 24) & 255) as u8;
        out.data[base + 1] = ((word >> 16) & 255) as u8;
        out.data[base + 2] = ((word >> 8) & 255) as u8;
        out.data[base + 3] = (word & 255) as u8;
        i = i + 1;
    }
}

// sha224_oneshot: convenience wrapper — init a fresh context, absorb
// `len` bytes of `data`, finalise into `out`. (Mirrors sha.vuma's
// oneshot pattern; the caller allocates ctx/data/out.)
transform sha224_oneshot(ctx: State<Sha224Ctx>, data: State<Sha224Data>, len: u64, out: State<Sha224Digest>) {
    sha224_init(ctx);
    sha224_update(ctx, data, len);
    sha224_final(ctx, out);
}

// ────────────────────────────────────────────────────────────────────────────
// Self-test (main).
// ────────────────────────────────────────────────────────────────────────────
// Verifies the SHA-224 compression against three canonical FIPS-180-4 §B
// test vectors (empty input + 1-byte + 3-byte + 56-byte multi-block):
//
//   1. SHA-224("")    = d14a028c2a3a2bc9476102bb288234c415a2b01f828ea62ac5b3e42f
//      (padding-only block: 0x80 + 55 zeros + 8 zero bytes bit count)
//
//   2. SHA-224("a")   = abd37534c7d9a2efb9465de931cd7055ffdb8879563ae98078d6d6d5
//      (1-byte message: 'a'(0x61) + 0x80 + 54 zeros + 8-byte bit count = 8)
//
//   3. SHA-224("abc") = 23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7
//      (3-byte message: 'abc' + 0x80 + 52 zeros + 8-byte bit count = 24)
//      (FIPS-180-4 §B.1 single-block test vector.)
//
//   4. SHA-224("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
//                    = 75388b16512776cc5dba5da1fd890150b0c6455cb4f58b1952522525
//      (56-byte message — two-block padding path, §B.2.)
//
// Returns 0 on success, 1..N on individual check failures.
transform main() -> i32 {
    // ── Init + IV byte check ──
    let ctx = state_new(Sha224Ctx);
    sha224_init(ctx);
    // H0 first byte = 216 (0xd8, low byte of 0xc1059ed8).
    if ctx.state[0] != 216 { return 1; }
    // H0 fourth byte = 193 (0xc1, high byte of 0xc1059ed8).
    if ctx.state[3] != 193 { return 2; }
    // H4 first byte = 49 (0x31, low byte of 0xffc00b31).
    if ctx.state[16] != 49 { return 3; }
    // H7 fourth byte = 190 (0xbe, high byte of 0xbefa4fa4).
    if ctx.state[31] != 190 { return 4; }
    if ctx.len != 0 { return 5; }

    // ── Test vector 1: SHA-224("") ──
    // Expected: d14a028c2a3a2bc9476102bb288234c415a2b01f828ea62ac5b3e42f
    let d_empty = state_new(Sha224Digest);
    sha224_final(ctx, d_empty);
    if d_empty.data[0] != 209 { return 6; }   // 0xd1
    if d_empty.data[1] != 74 { return 7; }    // 0x4a
    if d_empty.data[27] != 47 { return 8; }   // 0x2f

    // ── Test vector 2: SHA-224("a") ──
    // Expected: abd37534c7d9a2efb9465de931cd7055ffdb8879563ae98078d6d6d5
    sha224_init(ctx);
    let data = state_new(Sha224Data);
    data.data[0] = 97;  // 'a'
    sha224_update(ctx, data, 1);
    if ctx.len != 1 { return 9; }
    if ctx.total != 1 { return 10; }
    if ctx.buf[0] != 97 { return 11; }
    let d_a = state_new(Sha224Digest);
    sha224_final(ctx, d_a);
    if d_a.data[0] != 171 { return 12; }  // 0xab
    if d_a.data[1] != 211 { return 13; }  // 0xd3
    if d_a.data[27] != 213 { return 14; } // 0xd5

    // ── Test vector 3: SHA-224("abc") (FIPS-180-4 §B.1) ──
    // Expected: 23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7
    sha224_init(ctx);
    data.data[0] = 97;   // 'a'
    data.data[1] = 98;   // 'b'
    data.data[2] = 99;   // 'c'
    sha224_update(ctx, data, 3);
    if ctx.len != 3 { return 15; }
    if ctx.total != 3 { return 16; }
    let d_abc = state_new(Sha224Digest);
    sha224_final(ctx, d_abc);
    if d_abc.data[0] != 35 { return 17; }   // 0x23
    if d_abc.data[1] != 9 { return 18; }    // 0x09
    if d_abc.data[27] != 167 { return 19; } // 0xa7

    // ── Test vector 4: SHA-224(56-byte "abcdbcdec...nopq") (FIPS-180-4 §B.2) ──
    // Expected: 75388b16512776cc5dba5da1fd890150b0c6455cb4f58b1952522525
    // (two-block padding path — pos = 57 > 56, exercises the else branch.)
    sha224_init(ctx);
    data.data[0] = 97;   // 'a'
    data.data[1] = 98;   // 'b'
    data.data[2] = 99;   // 'c'
    data.data[3] = 100;  // 'd'
    data.data[4] = 98;   // 'b'
    data.data[5] = 99;   // 'c'
    data.data[6] = 100;  // 'd'
    data.data[7] = 101;  // 'e'
    data.data[8] = 99;   // 'c'
    data.data[9] = 100;  // 'd'
    data.data[10] = 101; // 'e'
    data.data[11] = 102; // 'f'
    data.data[12] = 100; // 'd'
    data.data[13] = 101; // 'e'
    data.data[14] = 102; // 'f'
    data.data[15] = 103; // 'g'
    data.data[16] = 101; // 'e'
    data.data[17] = 102; // 'f'
    data.data[18] = 103; // 'g'
    data.data[19] = 104; // 'h'
    data.data[20] = 102; // 'f'
    data.data[21] = 103; // 'g'
    data.data[22] = 104; // 'h'
    data.data[23] = 105; // 'i'
    data.data[24] = 103; // 'g'
    data.data[25] = 104; // 'h'
    data.data[26] = 105; // 'i'
    data.data[27] = 106; // 'j'
    data.data[28] = 104; // 'h'
    data.data[29] = 105; // 'i'
    data.data[30] = 106; // 'j'
    data.data[31] = 107; // 'k'
    data.data[32] = 105; // 'i'
    data.data[33] = 106; // 'j'
    data.data[34] = 107; // 'k'
    data.data[35] = 108; // 'l'
    data.data[36] = 106; // 'j'
    data.data[37] = 107; // 'k'
    data.data[38] = 108; // 'l'
    data.data[39] = 109; // 'm'
    data.data[40] = 107; // 'k'
    data.data[41] = 108; // 'l'
    data.data[42] = 109; // 'm'
    data.data[43] = 110; // 'n'
    data.data[44] = 108; // 'l'
    data.data[45] = 109; // 'm'
    data.data[46] = 110; // 'n'
    data.data[47] = 111; // 'o'
    data.data[48] = 109; // 'm'
    data.data[49] = 110; // 'n'
    data.data[50] = 111; // 'o'
    data.data[51] = 112; // 'p'
    data.data[52] = 110; // 'n'
    data.data[53] = 111; // 'o'
    data.data[54] = 112; // 'p'
    data.data[55] = 113; // 'q'
    sha224_update(ctx, data, 56);
    if ctx.len != 56 { return 20; }
    if ctx.total != 56 { return 21; }
    let d_long = state_new(Sha224Digest);
    sha224_final(ctx, d_long);
    if d_long.data[0] != 117 { return 22; }  // 0x75
    if d_long.data[1] != 56 { return 23; }   // 0x38
    if d_long.data[27] != 37 { return 24; }  // 0x25

    return 0;
}
