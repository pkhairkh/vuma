// womb/crypto/hash/sha384.vuma — SHA-384 (NIST FIPS 180-4 Section 6.3.2)
// PMT-native, spec-compliant, self-contained library module (no main()).
//
// 80-round Merkle-Damgard hash over 1024-bit (128-byte) blocks; the
// 512-bit state is truncated to 384 bits (48 bytes = first six of the
// eight 64-bit state words) for output. SHA-384 uses the same compression
// function and round constants K[0..79] as SHA-512; only the initial hash
// values and output length differ.
//
// Streaming API: sha384_init / sha384_update / sha384_final / sha384_oneshot,
// plus the exposed compression primitive sha384_compress and the
// sha384_load_k round-constants loader.
//
// ── PMT patterns (identical to sha512.vuma) ─────────────────────────────────
//   - `state_new(Layout)` for all allocations (NEVER `allocate()`)
//   - `State<T>` for transform parameters (NEVER `Address` / `*ptr`)
//   - `[u8; N]` byte arrays with literal indices for state load/store
//   - `[u64; N]` typed arrays for the message schedule (W) and round
//     constants (K)
//   - Loop-variable-derived indices precomputed into local vars before
//     array access (e.g. `let off = i * 8; ctx.buf[off]`)
//
// ── State layout ────────────────────────────────────────────────────────────
//   Identical to SHA-512: 8 hash state words stored big-endian in
//   ctx.state[0..63]. The only difference from SHA-512 is the IV (set by
//   sha384_init) and the 48-byte truncated output (sha384_final copies only
//   ctx.state[0..47] to the digest).
//
// VUMA's parser rejects integer literals >= 2^63 for u64. Constants at or
// above that threshold are written as (1 << 63) | lower_63_bits.

const MASK64: u64 = (1 << 63) | ((1 << 63) - 1);

// ===========================================================================
// SHA-512 round constants K[0..79] (FIPS 180-4 Section 4.2.3).
// SHA-384 uses the same compression function as SHA-512, hence the same K.
// ===========================================================================

const K00: u64 = 4794697086780616226;
const K01: u64 = 8158064640168781261;
const K02: u64 = (1 << 63) | 3873372549979913007;
const K03: u64 = (1 << 63) | 7617235848656444348;
const K04: u64 = 4131703408338449720;
const K05: u64 = 6480981068601479193;
const K06: u64 = (1 << 63) | 1314913260039393179;
const K07: u64 = (1 << 63) | 3106462115564454168;
const K08: u64 = (1 << 63) | 6343226172721267266;
const K09: u64 = 1334009975649890238;
const K10: u64 = 2608012711638119052;
const K11: u64 = 6128411473006802146;
const K12: u64 = 8268148722764581231;
const K13: u64 = (1 << 63) | 62683150300911281;
const K14: u64 = (1 << 63) | 2007486848863506997;
const K15: u64 = (1 << 63) | 4727637717853742740;
const K16: u64 = (1 << 63) | 7249504305499163346;
const K17: u64 = (1 << 63) | 8051951825580926435;
const K18: u64 = 1135362057144423861;
const K19: u64 = 2597628984639134821;
const K20: u64 = 3308224258029322869;
const K21: u64 = 5365058923640841347;
const K22: u64 = 6679025012923562964;
const K23: u64 = 8573033837759648693;
const K24: u64 = (1 << 63) | 1746923122095218603;
const K25: u64 = (1 << 63) | 2896314207596458512;
const K26: u64 = (1 << 63) | 3459652681264210239;
const K27: u64 = (1 << 63) | 4564820193195265764;
const K28: u64 = (1 << 63) | 5107095116777557954;
const K29: u64 = (1 << 63) | 6172061550930208549;
const K30: u64 = 489312712824947311;
const K31: u64 = 1452737877330783856;
const K32: u64 = 2861767655752347644;
const K33: u64 = 3322285676063803686;
const K34: u64 = 5560940570517711597;
const K35: u64 = 5996557281743188959;
const K36: u64 = 7280758554555802590;
const K37: u64 = 8532644243296465576;
const K38: u64 = (1 << 63) | 126884940132232934;
const K39: u64 = (1 << 63) | 1329173790114067771;
const K40: u64 = (1 << 63) | 2503975697319527268;
const K41: u64 = (1 << 63) | 2889734586378629121;
const K42: u64 = (1 << 63) | 4777065146415093649;
const K43: u64 = (1 << 63) | 5146578234805370416;
const K44: u64 = (1 << 63) | 5878015661349753368;
const K45: u64 = (1 << 63) | 6240025511819847952;
const K46: u64 = (1 << 63) | 8362680404887543850;
const K47: u64 = 1182934255886127544;
const K48: u64 = 1847814050463011016;
const K49: u64 = 2177327727835720531;
const K50: u64 = 2830643537854262169;
const K51: u64 = 3796741975233480872;
const K52: u64 = 4115178125766777443;
const K53: u64 = 5681478168544905931;
const K54: u64 = 6601373596472566643;
const K55: u64 = 7507060721942968483;
const K56: u64 = 8399075790359081724;
const K57: u64 = 8693463985226723168;
const K58: u64 = (1 << 63) | 344657401505426290;
const K59: u64 = (1 << 63) | 920706882646325740;
const K60: u64 = (1 << 63) | 1206683199982476840;
const K61: u64 = (1 << 63) | 2616711143808482793;
const K62: u64 = (1 << 63) | 4537838383804086549;
const K63: u64 = (1 << 63) | 5075971239616598827;
const K64: u64 = (1 << 63) | 5343308541310951836;
const K65: u64 = (1 << 63) | 5874585929355674119;
const K66: u64 = (1 << 63) | 7699604874473827102;
const K67: u64 = (1 << 63) | 8466010285406081400;
const K68: u64 = 500013540394364858;
const K69: u64 = 748580250866718886;
const K70: u64 = 1242879168328830382;
const K71: u64 = 1977374033974150939;
const K72: u64 = 2944078676154940804;
const K73: u64 = 3659926193048069267;
const K74: u64 = 4368137639120453308;
const K75: u64 = 4836135668995329356;
const K76: u64 = 5532061633213252278;
const K77: u64 = 6448918945643986474;
const K78: u64 = 6902733635092675308;
const K79: u64 = 7801388544844847127;

// ===========================================================================
// SHA-384 initial hash values (FIPS 180-4 Section 5.3.3).
// H0=0xcbbb9d5dc1059ed8 H1=0x629a292a367cd507 H2=0x9159015a3070dd17
// H3=0x152fecd8f70e5939 H4=0x67332667ffc00b31 H5=0x8eb44a8768581511
// H6=0xdb0c2e0d64f98fa7 H7=0x47b5481dbefa4fa4
// ===========================================================================

const H0I: u64 = (1 << 63) | 5457128399485378264;
const H1I: u64 = 7105036623409894663;
const H2I: u64 = (1 << 63) | 1250031858443410711;
const H3I: u64 = 1526699215303891257;
const H4I: u64 = 7436329637833083697;
const H5I: u64 = (1 << 63) | 1059553757770552593;
const H6I: u64 = (1 << 63) | 6560669392235499431;
const H7I: u64 = 5167115440072839076;

// ===========================================================================
// Layouts
// ===========================================================================

// SHA-384 context (identical layout to Sha512Ctx — only the IV and output
// length differ between SHA-384 and SHA-512).
layout Sha384Ctx = {
    state: [u8; 64],
    buf: [u8; 128],
    len: u32,
    total_lo: u32,
    total_hi: u32,
}

layout Sha384Data = { data: [u8; 128] }

// SHA-384 digest output (48 bytes — first six 64-bit hash words serialized
// big-endian per FIPS-180-4 §5.1.2).
layout Sha384Digest = { data: [u8; 48] }

layout Sha384W = { w: [u64; 80] }
layout Sha384K = { k: [u64; 80] }

// ===========================================================================
// SHA-512 helper functions (FIPS-180-4 §4.1.3) — identical to sha512.vuma.
// ===========================================================================

transform rotr64(x: u64, n: u64) -> u64 {
    if n == 0 { return x; }
    return (x >> n) | (x << (64 - n));
}

transform ch64(x: u64, y: u64, z: u64) -> u64 {
    return (x & y) ^ ((x ^ MASK64) & z);
}

transform maj64(x: u64, y: u64, z: u64) -> u64 {
    return (x & y) ^ (x & z) ^ (y & z);
}

transform big_sigma0_64(x: u64) -> u64 {
    return rotr64(x, 28) ^ rotr64(x, 34) ^ rotr64(x, 39);
}

transform big_sigma1_64(x: u64) -> u64 {
    return rotr64(x, 14) ^ rotr64(x, 18) ^ rotr64(x, 41);
}

transform small_sigma0_64(x: u64) -> u64 {
    return rotr64(x, 1) ^ rotr64(x, 8) ^ (x >> 7);
}

transform small_sigma1_64(x: u64) -> u64 {
    return rotr64(x, 19) ^ rotr64(x, 61) ^ (x >> 6);
}

// ===========================================================================
// Round-constants loader.
// ===========================================================================

transform sha384_load_k(K: State<Sha384K>) {
    K.k[0] = K00; K.k[1] = K01; K.k[2] = K02; K.k[3] = K03;
    K.k[4] = K04; K.k[5] = K05; K.k[6] = K06; K.k[7] = K07;
    K.k[8] = K08; K.k[9] = K09; K.k[10] = K10; K.k[11] = K11;
    K.k[12] = K12; K.k[13] = K13; K.k[14] = K14; K.k[15] = K15;
    K.k[16] = K16; K.k[17] = K17; K.k[18] = K18; K.k[19] = K19;
    K.k[20] = K20; K.k[21] = K21; K.k[22] = K22; K.k[23] = K23;
    K.k[24] = K24; K.k[25] = K25; K.k[26] = K26; K.k[27] = K27;
    K.k[28] = K28; K.k[29] = K29; K.k[30] = K30; K.k[31] = K31;
    K.k[32] = K32; K.k[33] = K33; K.k[34] = K34; K.k[35] = K35;
    K.k[36] = K36; K.k[37] = K37; K.k[38] = K38; K.k[39] = K39;
    K.k[40] = K40; K.k[41] = K41; K.k[42] = K42; K.k[43] = K43;
    K.k[44] = K44; K.k[45] = K45; K.k[46] = K46; K.k[47] = K47;
    K.k[48] = K48; K.k[49] = K49; K.k[50] = K50; K.k[51] = K51;
    K.k[52] = K52; K.k[53] = K53; K.k[54] = K54; K.k[55] = K55;
    K.k[56] = K56; K.k[57] = K57; K.k[58] = K58; K.k[59] = K59;
    K.k[60] = K60; K.k[61] = K61; K.k[62] = K62; K.k[63] = K63;
    K.k[64] = K64; K.k[65] = K65; K.k[66] = K66; K.k[67] = K67;
    K.k[68] = K68; K.k[69] = K69; K.k[70] = K70; K.k[71] = K71;
    K.k[72] = K72; K.k[73] = K73; K.k[74] = K74; K.k[75] = K75;
    K.k[76] = K76; K.k[77] = K77; K.k[78] = K78; K.k[79] = K79;
}

// ===========================================================================
// SHA-384 API functions.
// ===========================================================================

// sha384_init: seed the SHA-384 initial hash state into ctx.
transform sha384_init(ctx: State<Sha384Ctx>) {
    // H0 = 0xcbbb9d5dc1059ed8
    ctx.state[0] = ((H0I >> 56) & 255) as u8;
    ctx.state[1] = ((H0I >> 48) & 255) as u8;
    ctx.state[2] = ((H0I >> 40) & 255) as u8;
    ctx.state[3] = ((H0I >> 32) & 255) as u8;
    ctx.state[4] = ((H0I >> 24) & 255) as u8;
    ctx.state[5] = ((H0I >> 16) & 255) as u8;
    ctx.state[6] = ((H0I >> 8) & 255) as u8;
    ctx.state[7] = (H0I & 255) as u8;
    // H1 = 0x629a292a367cd507
    ctx.state[8] = ((H1I >> 56) & 255) as u8;
    ctx.state[9] = ((H1I >> 48) & 255) as u8;
    ctx.state[10] = ((H1I >> 40) & 255) as u8;
    ctx.state[11] = ((H1I >> 32) & 255) as u8;
    ctx.state[12] = ((H1I >> 24) & 255) as u8;
    ctx.state[13] = ((H1I >> 16) & 255) as u8;
    ctx.state[14] = ((H1I >> 8) & 255) as u8;
    ctx.state[15] = (H1I & 255) as u8;
    // H2 = 0x9159015a3070dd17
    ctx.state[16] = ((H2I >> 56) & 255) as u8;
    ctx.state[17] = ((H2I >> 48) & 255) as u8;
    ctx.state[18] = ((H2I >> 40) & 255) as u8;
    ctx.state[19] = ((H2I >> 32) & 255) as u8;
    ctx.state[20] = ((H2I >> 24) & 255) as u8;
    ctx.state[21] = ((H2I >> 16) & 255) as u8;
    ctx.state[22] = ((H2I >> 8) & 255) as u8;
    ctx.state[23] = (H2I & 255) as u8;
    // H3 = 0x152fecd8f70e5939
    ctx.state[24] = ((H3I >> 56) & 255) as u8;
    ctx.state[25] = ((H3I >> 48) & 255) as u8;
    ctx.state[26] = ((H3I >> 40) & 255) as u8;
    ctx.state[27] = ((H3I >> 32) & 255) as u8;
    ctx.state[28] = ((H3I >> 24) & 255) as u8;
    ctx.state[29] = ((H3I >> 16) & 255) as u8;
    ctx.state[30] = ((H3I >> 8) & 255) as u8;
    ctx.state[31] = (H3I & 255) as u8;
    // H4 = 0x67332667ffc00b31
    ctx.state[32] = ((H4I >> 56) & 255) as u8;
    ctx.state[33] = ((H4I >> 48) & 255) as u8;
    ctx.state[34] = ((H4I >> 40) & 255) as u8;
    ctx.state[35] = ((H4I >> 32) & 255) as u8;
    ctx.state[36] = ((H4I >> 24) & 255) as u8;
    ctx.state[37] = ((H4I >> 16) & 255) as u8;
    ctx.state[38] = ((H4I >> 8) & 255) as u8;
    ctx.state[39] = (H4I & 255) as u8;
    // H5 = 0x8eb44a8768581511
    ctx.state[40] = ((H5I >> 56) & 255) as u8;
    ctx.state[41] = ((H5I >> 48) & 255) as u8;
    ctx.state[42] = ((H5I >> 40) & 255) as u8;
    ctx.state[43] = ((H5I >> 32) & 255) as u8;
    ctx.state[44] = ((H5I >> 24) & 255) as u8;
    ctx.state[45] = ((H5I >> 16) & 255) as u8;
    ctx.state[46] = ((H5I >> 8) & 255) as u8;
    ctx.state[47] = (H5I & 255) as u8;
    // H6 = 0xdb0c2e0d64f98fa7
    ctx.state[48] = ((H6I >> 56) & 255) as u8;
    ctx.state[49] = ((H6I >> 48) & 255) as u8;
    ctx.state[50] = ((H6I >> 40) & 255) as u8;
    ctx.state[51] = ((H6I >> 32) & 255) as u8;
    ctx.state[52] = ((H6I >> 24) & 255) as u8;
    ctx.state[53] = ((H6I >> 16) & 255) as u8;
    ctx.state[54] = ((H6I >> 8) & 255) as u8;
    ctx.state[55] = (H6I & 255) as u8;
    // H7 = 0x47b5481dbefa4fa4
    ctx.state[56] = ((H7I >> 56) & 255) as u8;
    ctx.state[57] = ((H7I >> 48) & 255) as u8;
    ctx.state[58] = ((H7I >> 40) & 255) as u8;
    ctx.state[59] = ((H7I >> 32) & 255) as u8;
    ctx.state[60] = ((H7I >> 24) & 255) as u8;
    ctx.state[61] = ((H7I >> 16) & 255) as u8;
    ctx.state[62] = ((H7I >> 8) & 255) as u8;
    ctx.state[63] = (H7I & 255) as u8;
    ctx.len = 0;
    ctx.total_lo = 0;
    ctx.total_hi = 0;
}

// sha384_compress: fold one 128-byte block (ctx.buf) into ctx.state via
// the FIPS-180-4 §6.3.2 80-round SHA-512 compression (identical to
// sha512_compress — SHA-384 reuses the SHA-512 compression function).
transform sha384_compress(ctx: State<Sha384Ctx>) {
    let W = state_new(Sha384W);
    let K = state_new(Sha384K);
    sha384_load_k(K);

    // Step 1: build the message schedule.
    let i = 0;
    while i < 16 {
        let off = i * 8;
        let b0 = ctx.buf[off] as u64;
        let b1 = ctx.buf[off + 1] as u64;
        let b2 = ctx.buf[off + 2] as u64;
        let b3 = ctx.buf[off + 3] as u64;
        let b4 = ctx.buf[off + 4] as u64;
        let b5 = ctx.buf[off + 5] as u64;
        let b6 = ctx.buf[off + 6] as u64;
        let b7 = ctx.buf[off + 7] as u64;
        W.w[i] = (b0 << 56) | (b1 << 48) | (b2 << 40) | (b3 << 32)
               | (b4 << 24) | (b5 << 16) | (b6 << 8) | b7;
        i = i + 1;
    }
    i = 16;
    while i < 80 {
        let w15 = W.w[i - 15];
        let w2 = W.w[i - 2];
        let w7 = W.w[i - 7];
        let w16 = W.w[i - 16];
        W.w[i] = w16 + small_sigma0_64(w15) + w7 + small_sigma1_64(w2);
        i = i + 1;
    }

    // Step 2: initialize working variables a..h from ctx.state (BE load).
    let a0 = (ctx.state[0] as u64) << 56 | (ctx.state[1] as u64) << 48
           | (ctx.state[2] as u64) << 40 | (ctx.state[3] as u64) << 32
           | (ctx.state[4] as u64) << 24 | (ctx.state[5] as u64) << 16
           | (ctx.state[6] as u64) << 8  | (ctx.state[7] as u64);
    let b0 = (ctx.state[8] as u64) << 56 | (ctx.state[9] as u64) << 48
           | (ctx.state[10] as u64) << 40 | (ctx.state[11] as u64) << 32
           | (ctx.state[12] as u64) << 24 | (ctx.state[13] as u64) << 16
           | (ctx.state[14] as u64) << 8  | (ctx.state[15] as u64);
    let c0 = (ctx.state[16] as u64) << 56 | (ctx.state[17] as u64) << 48
           | (ctx.state[18] as u64) << 40 | (ctx.state[19] as u64) << 32
           | (ctx.state[20] as u64) << 24 | (ctx.state[21] as u64) << 16
           | (ctx.state[22] as u64) << 8  | (ctx.state[23] as u64);
    let d0 = (ctx.state[24] as u64) << 56 | (ctx.state[25] as u64) << 48
           | (ctx.state[26] as u64) << 40 | (ctx.state[27] as u64) << 32
           | (ctx.state[28] as u64) << 24 | (ctx.state[29] as u64) << 16
           | (ctx.state[30] as u64) << 8  | (ctx.state[31] as u64);
    let e0 = (ctx.state[32] as u64) << 56 | (ctx.state[33] as u64) << 48
           | (ctx.state[34] as u64) << 40 | (ctx.state[35] as u64) << 32
           | (ctx.state[36] as u64) << 24 | (ctx.state[37] as u64) << 16
           | (ctx.state[38] as u64) << 8  | (ctx.state[39] as u64);
    let f0 = (ctx.state[40] as u64) << 56 | (ctx.state[41] as u64) << 48
           | (ctx.state[42] as u64) << 40 | (ctx.state[43] as u64) << 32
           | (ctx.state[44] as u64) << 24 | (ctx.state[45] as u64) << 16
           | (ctx.state[46] as u64) << 8  | (ctx.state[47] as u64);
    let g0 = (ctx.state[48] as u64) << 56 | (ctx.state[49] as u64) << 48
           | (ctx.state[50] as u64) << 40 | (ctx.state[51] as u64) << 32
           | (ctx.state[52] as u64) << 24 | (ctx.state[53] as u64) << 16
           | (ctx.state[54] as u64) << 8  | (ctx.state[55] as u64);
    let h0 = (ctx.state[56] as u64) << 56 | (ctx.state[57] as u64) << 48
           | (ctx.state[58] as u64) << 40 | (ctx.state[59] as u64) << 32
           | (ctx.state[60] as u64) << 24 | (ctx.state[61] as u64) << 16
           | (ctx.state[62] as u64) << 8  | (ctx.state[63] as u64);

    let a: u64 = a0;
    let b: u64 = b0;
    let c: u64 = c0;
    let d: u64 = d0;
    let e: u64 = e0;
    let f: u64 = f0;
    let g: u64 = g0;
    let h: u64 = h0;

    // Step 3: 80 SHA-512 rounds.
    let r = 0;
    while r < 80 {
        let ki = K.k[r];
        let wi = W.w[r];
        let t1 = h + big_sigma1_64(e) + ch64(e, f, g) + ki + wi;
        let t2 = big_sigma0_64(a) + maj64(a, b, c);
        h = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
        r = r + 1;
    }

    // Step 4: fold a..h back into ctx.state (H[i] += working[i] mod 2^64).
    let na = a0 + a;
    let nb = b0 + b;
    let nc = c0 + c;
    let nd = d0 + d;
    let ne = e0 + e;
    let nf = f0 + f;
    let ng = g0 + g;
    let nh = h0 + h;
    ctx.state[0] = ((na >> 56) & 255) as u8;
    ctx.state[1] = ((na >> 48) & 255) as u8;
    ctx.state[2] = ((na >> 40) & 255) as u8;
    ctx.state[3] = ((na >> 32) & 255) as u8;
    ctx.state[4] = ((na >> 24) & 255) as u8;
    ctx.state[5] = ((na >> 16) & 255) as u8;
    ctx.state[6] = ((na >> 8) & 255) as u8;
    ctx.state[7] = (na & 255) as u8;
    ctx.state[8] = ((nb >> 56) & 255) as u8;
    ctx.state[9] = ((nb >> 48) & 255) as u8;
    ctx.state[10] = ((nb >> 40) & 255) as u8;
    ctx.state[11] = ((nb >> 32) & 255) as u8;
    ctx.state[12] = ((nb >> 24) & 255) as u8;
    ctx.state[13] = ((nb >> 16) & 255) as u8;
    ctx.state[14] = ((nb >> 8) & 255) as u8;
    ctx.state[15] = (nb & 255) as u8;
    ctx.state[16] = ((nc >> 56) & 255) as u8;
    ctx.state[17] = ((nc >> 48) & 255) as u8;
    ctx.state[18] = ((nc >> 40) & 255) as u8;
    ctx.state[19] = ((nc >> 32) & 255) as u8;
    ctx.state[20] = ((nc >> 24) & 255) as u8;
    ctx.state[21] = ((nc >> 16) & 255) as u8;
    ctx.state[22] = ((nc >> 8) & 255) as u8;
    ctx.state[23] = (nc & 255) as u8;
    ctx.state[24] = ((nd >> 56) & 255) as u8;
    ctx.state[25] = ((nd >> 48) & 255) as u8;
    ctx.state[26] = ((nd >> 40) & 255) as u8;
    ctx.state[27] = ((nd >> 32) & 255) as u8;
    ctx.state[28] = ((nd >> 24) & 255) as u8;
    ctx.state[29] = ((nd >> 16) & 255) as u8;
    ctx.state[30] = ((nd >> 8) & 255) as u8;
    ctx.state[31] = (nd & 255) as u8;
    ctx.state[32] = ((ne >> 56) & 255) as u8;
    ctx.state[33] = ((ne >> 48) & 255) as u8;
    ctx.state[34] = ((ne >> 40) & 255) as u8;
    ctx.state[35] = ((ne >> 32) & 255) as u8;
    ctx.state[36] = ((ne >> 24) & 255) as u8;
    ctx.state[37] = ((ne >> 16) & 255) as u8;
    ctx.state[38] = ((ne >> 8) & 255) as u8;
    ctx.state[39] = (ne & 255) as u8;
    ctx.state[40] = ((nf >> 56) & 255) as u8;
    ctx.state[41] = ((nf >> 48) & 255) as u8;
    ctx.state[42] = ((nf >> 40) & 255) as u8;
    ctx.state[43] = ((nf >> 32) & 255) as u8;
    ctx.state[44] = ((nf >> 24) & 255) as u8;
    ctx.state[45] = ((nf >> 16) & 255) as u8;
    ctx.state[46] = ((nf >> 8) & 255) as u8;
    ctx.state[47] = (nf & 255) as u8;
    ctx.state[48] = ((ng >> 56) & 255) as u8;
    ctx.state[49] = ((ng >> 48) & 255) as u8;
    ctx.state[50] = ((ng >> 40) & 255) as u8;
    ctx.state[51] = ((ng >> 32) & 255) as u8;
    ctx.state[52] = ((ng >> 24) & 255) as u8;
    ctx.state[53] = ((ng >> 16) & 255) as u8;
    ctx.state[54] = ((ng >> 8) & 255) as u8;
    ctx.state[55] = (ng & 255) as u8;
    ctx.state[56] = ((nh >> 56) & 255) as u8;
    ctx.state[57] = ((nh >> 48) & 255) as u8;
    ctx.state[58] = ((nh >> 40) & 255) as u8;
    ctx.state[59] = ((nh >> 32) & 255) as u8;
    ctx.state[60] = ((nh >> 24) & 255) as u8;
    ctx.state[61] = ((nh >> 16) & 255) as u8;
    ctx.state[62] = ((nh >> 8) & 255) as u8;
    ctx.state[63] = (nh & 255) as u8;
}

// Increment the 64-bit bit counter by `bits`, carrying into total_hi.
transform sha384_add_bits(ctx: State<Sha384Ctx>, bits: u32) {
    let lo = ctx.total_lo;
    let hi = ctx.total_hi;
    let new_lo = lo + bits;
    if new_lo < lo {
        ctx.total_hi = hi + 1;
    }
    ctx.total_lo = new_lo;
}

// sha384_update: absorb `len` bytes of data into the hash state.
transform sha384_update(ctx: State<Sha384Ctx>, data: State<Sha384Data>, len: u32) {
    let i: u32 = 0;
    while i < len {
        let bl = ctx.len;
        ctx.buf[bl] = data.data[i];
        ctx.len = bl + 1;
        i = i + 1;
        if ctx.len == 128 {
            sha384_compress(ctx);
            sha384_add_bits(ctx, 1024);
            ctx.len = 0;
        }
    }
}

// sha384_final: emit the 48-byte SHA-384 digest into `out`.
// Padding is identical to SHA-512 (§5.1.2, 1024-bit variant). The only
// difference from sha512_final is that only the first 48 bytes (6 state
// words) are copied to the digest output — SHA-384 truncation.
transform sha384_final(ctx: State<Sha384Ctx>, out: State<Sha384Digest>) {
    let buf_len: u32 = ctx.len;
    sha384_add_bits(ctx, buf_len * 8);

    ctx.buf[buf_len] = 128;
    buf_len = buf_len + 1;

    if buf_len > 112 {
        while buf_len < 128 {
            ctx.buf[buf_len] = 0;
            buf_len = buf_len + 1;
        }
        sha384_compress(ctx);
        buf_len = 0;
    }
    while buf_len < 112 {
        ctx.buf[buf_len] = 0;
        buf_len = buf_len + 1;
    }

    let lo = ctx.total_lo;
    let hi = ctx.total_hi;
    ctx.buf[112] = 0;
    ctx.buf[113] = 0;
    ctx.buf[114] = 0;
    ctx.buf[115] = 0;
    ctx.buf[116] = 0;
    ctx.buf[117] = 0;
    ctx.buf[118] = 0;
    ctx.buf[119] = 0;
    ctx.buf[120] = ((hi >> 24) & 255) as u8;
    ctx.buf[121] = ((hi >> 16) & 255) as u8;
    ctx.buf[122] = ((hi >> 8) & 255) as u8;
    ctx.buf[123] = (hi & 255) as u8;
    ctx.buf[124] = ((lo >> 24) & 255) as u8;
    ctx.buf[125] = ((lo >> 16) & 255) as u8;
    ctx.buf[126] = ((lo >> 8) & 255) as u8;
    ctx.buf[127] = (lo & 255) as u8;

    sha384_compress(ctx);

    // Emit first 6 state words (48 bytes) big-endian — SHA-384 truncation.
    let i = 0;
    while i < 48 {
        out.data[i] = ctx.state[i];
        i = i + 1;
    }
}

// Convenience wrapper: initialise a fresh context, absorb `data`, finalise
// into `out`.
transform sha384_oneshot(data: State<Sha384Data>, len: u32, out: State<Sha384Digest>) {
    let ctx = state_new(Sha384Ctx);
    sha384_init(ctx);
    sha384_update(ctx, data, len);
    sha384_final(ctx, out);
}
