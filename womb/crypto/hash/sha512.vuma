// womb/crypto/hash/sha512.vuma — SHA-512 (NIST FIPS 180-4 Section 6.4.2)
// PMT-native, spec-compliant, self-contained library module (no main()).
//
// 80-round Merkle-Damgard hash over 1024-bit (128-byte) blocks; produces
// the full 512-bit (64-byte) digest. SHA-512 is the canonical 64-bit hash
// in the SHA-2 family; SHA-384, SHA-512/224, and SHA-512/256 reuse the
// same compression function with different IVs and output lengths.
//
// Streaming API: sha512_init / sha512_update / sha512_final / sha512_oneshot,
// plus the exposed compression primitive sha512_compress and the
// sha512_load_k round-constants loader.
//
// ── PMT patterns ────────────────────────────────────────────────────────────
//   - `state_new(Layout)` for all allocations (NEVER `allocate()`)
//   - `State<T>` for transform parameters (NEVER `Address` / `*ptr`)
//   - `[u8; N]` byte arrays with literal indices for state load/store
//   - `[u64; N]` typed arrays for the message schedule (W) and round
//     constants (K) — typed-array index scaling reads/writes the u64 word
//     at slot i
//   - Loop-variable-derived indices precomputed into local vars before
//     array access (e.g. `let off = i * 8; ctx.buf[off]`)
//
// ── State layout ────────────────────────────────────────────────────────────
//   The 8 hash state words are stored big-endian in ctx.state[0..63] —
//   byte 0 is the most-significant byte of H0, byte 7 is the least-
//   significant byte of H0, byte 8 is the MSB of H1, etc. This matches
//   the FIPS-180-4 §5.1.2 digest serialization order, so sha512_final
//   copies state bytes directly to the digest output without conversion.
//
//   The 128-bit message bit-length (used in the §5.1.2 padding suffix)
//   is tracked as two u32 limbs (total_lo, total_hi) holding the low
//   and high 32 bits of the 64-bit bit count. The high 64 bits of the
//   128-bit field are always zero (sufficient for messages up to 2^61
//   bytes — far beyond any practical input).
//
// VUMA's parser rejects integer literals >= 2^63 for u64. Constants at or
// above that threshold are written as (2147483648 << 32) | lower_63_bits, which the
// parser evaluates to the correct unsigned u64 value.

const MASK64: u64 = 4294967295 | (4294967295 << 32);

// ===========================================================================
// SHA-512 round constants K[0..79] (FIPS 180-4 Section 4.2.3).
// These are the first 64 bits of the fractional parts of the cube roots of
// the first 80 prime numbers. Values >= 2^63 use the (2147483648 << 32) | lower form.
// ===========================================================================

const K00: u64 = 4794697086780616226;
const K01: u64 = 8158064640168781261;
const K02: u64 = (2147483648 << 32) | 3873372549979913007;
const K03: u64 = (2147483648 << 32) | 7617235848656444348;
const K04: u64 = 4131703408338449720;
const K05: u64 = 6480981068601479193;
const K06: u64 = (2147483648 << 32) | 1314913260039393179;
const K07: u64 = (2147483648 << 32) | 3106462115564454168;
const K08: u64 = (2147483648 << 32) | 6343226172721267266;
const K09: u64 = 1334009975649890238;
const K10: u64 = 2608012711638119052;
const K11: u64 = 6128411473006802146;
const K12: u64 = 8268148722764581231;
const K13: u64 = (2147483648 << 32) | 62683150300911281;
const K14: u64 = (2147483648 << 32) | 2007486848863506997;
const K15: u64 = (2147483648 << 32) | 4727637717853742740;
const K16: u64 = (2147483648 << 32) | 7249504305499163346;
const K17: u64 = (2147483648 << 32) | 8051951825580926435;
const K18: u64 = 1135362057144423861;
const K19: u64 = 2597628984639134821;
const K20: u64 = 3308224258029322869;
const K21: u64 = 5365058923640841347;
const K22: u64 = 6679025012923562964;
const K23: u64 = 8573033837759648693;
const K24: u64 = (2147483648 << 32) | 1746923122095218603;
const K25: u64 = (2147483648 << 32) | 2896314207596458512;
const K26: u64 = (2147483648 << 32) | 3459652681264210239;
const K27: u64 = (2147483648 << 32) | 4564820193195265764;
const K28: u64 = (2147483648 << 32) | 5107095116777557954;
const K29: u64 = (2147483648 << 32) | 6172061550930208549;
const K30: u64 = 489312712824947311;
const K31: u64 = 1452737877330783856;
const K32: u64 = 2861767655752347644;
const K33: u64 = 3322285676063803686;
const K34: u64 = 5560940570517711597;
const K35: u64 = 5996557281743188959;
const K36: u64 = 7280758554555802590;
const K37: u64 = 8532644243296465576;
const K38: u64 = (2147483648 << 32) | 126884940132232934;
const K39: u64 = (2147483648 << 32) | 1329173790114067771;
const K40: u64 = (2147483648 << 32) | 2503975697319527268;
const K41: u64 = (2147483648 << 32) | 2889734586378629121;
const K42: u64 = (2147483648 << 32) | 4777065146415093649;
const K43: u64 = (2147483648 << 32) | 5146578234805370416;
const K44: u64 = (2147483648 << 32) | 5878015661349753368;
const K45: u64 = (2147483648 << 32) | 6240025511819847952;
const K46: u64 = (2147483648 << 32) | 8362680404887543850;
const K47: u64 = 1182934255886127544;
const K48: u64 = 1847814050463011016;
const K49: u64 = 2177327727835720531;
const K50: u64 = 2830643537854262169;
const K51: u64 = 3796741975233480872;
const K52: u64 = 4115178125766777443;
const K53: u64 = 5681478168544905931;
const K54: u64 = 6601373596472566643;
const K55: u64 = 7507060721942968483;
const K56: u64 = 8399075790359081724;
const K57: u64 = 8693463985226723168;
const K58: u64 = (2147483648 << 32) | 344657401505426290;
const K59: u64 = (2147483648 << 32) | 920706882646325740;
const K60: u64 = (2147483648 << 32) | 1206683199982476840;
const K61: u64 = (2147483648 << 32) | 2616711143808482793;
const K62: u64 = (2147483648 << 32) | 4537838383804086549;
const K63: u64 = (2147483648 << 32) | 5075971239616598827;
const K64: u64 = (2147483648 << 32) | 5343308541310951836;
const K65: u64 = (2147483648 << 32) | 5874585929355674119;
const K66: u64 = (2147483648 << 32) | 7699604874473827102;
const K67: u64 = (2147483648 << 32) | 8466010285406081400;
const K68: u64 = 500013540394364858;
const K69: u64 = 748580250866718886;
const K70: u64 = 1242879168328830382;
const K71: u64 = 1977374033974150939;
const K72: u64 = 2944078676154940804;
const K73: u64 = 3659926193048069267;
const K74: u64 = 4368137639120453308;
const K75: u64 = 4836135668995329356;
const K76: u64 = 5532061633213252278;
const K77: u64 = 6448918945643986474;
const K78: u64 = 6902733635092675308;
const K79: u64 = 7801388544844847127;

// ===========================================================================
// SHA-512 initial hash values (FIPS 180-4 Section 5.3.4).
// H0=0x6a09e667f3bcc908 H1=0xbb67ae8584caa73b H2=0x3c6ef372fe94f82b
// H3=0xa54ff53a5f1d36f1 H4=0x510e527fade682d1 H5=0x9b05688c2b3e6c1f
// H6=0x1f83d9abfb41bd6b H7=0x5be0cd19137e2179
// ===========================================================================

const H0I: u64 = 7640891576956012808;
const H1I: u64 = (2147483648 << 32) | 4280581859320702779;
const H2I: u64 = 4354685564936845355;
const H3I: u64 = (2147483648 << 32) | 2688637133616133873;
const H4I: u64 = 5840696475078001361;
const H5I: u64 = (2147483648 << 32) | 1947077365137828895;
const H6I: u64 = 2270897969802886507;
const H7I: u64 = 6620516959819538809;

// ===========================================================================
// Layouts
// ===========================================================================

// SHA-512 context (228 bytes):
//   [  0.. 63] state[64]    8 × 8-byte big-endian hash state words
//   [ 64..191] buf[128]     partial block accumulator (1024-bit block)
//   [192..195] len          bytes currently in the message buffer (u32)
//   [196..199] total_lo     low 32 bits of total message bit count
//   [200..203] total_hi     high 32 bits of total message bit count
layout Sha512Ctx = {
    state: [u8; 64],
    buf: [u8; 128],
    len: u32,
    total_lo: u32,
    total_hi: u32,
}

// Input data wrapper (128 bytes — one full SHA-512 block).
layout Sha512Data = { data: [u8; 128] }

// SHA-512 digest output (64 bytes — eight 64-bit hash words serialized
// big-endian per FIPS-180-4 §5.1.2).
layout Sha512Digest = { data: [u8; 64] }

// SHA-512 message schedule (80 × u64 words). Allocated via state_new(Sha512W)
// inside sha512_compress. W[0..15] are big-endian loads of the 128-byte
// input block; W[16..79] are expanded via the σ0/σ1 recurrence (§6.3.2).
layout Sha512W = { w: [u64; 80] }

// SHA-512 round-constants table (80 × u64). Loaded once per compression
// call via sha512_load_k. K.k[i] returns the u64 constant at slot i.
layout Sha512K = { k: [u64; 80] }

// ===========================================================================
// SHA-512 helper functions (FIPS-180-4 §4.1.3).
// All arithmetic is u64; additions wrap mod 2^64 by definition in VUMA,
// so no explicit masking is needed (unlike u32 SHA-256 which needs MASK32).
// ===========================================================================

// Right-rotate a 64-bit word by n positions (1 <= n <= 63).
// NOTE: On arm32, variable shift amounts >= 32 trigger a codegen bug in
// the 64-bit ShrL CS branch. The sigma functions below inline the rotations
// with literal shift amounts to avoid this bug.
transform rotr64(x: u64, n: u64) -> u64 {
    if n == 0 { return x; }
    return (x >> n) | (x << (64 - n));
}

// Ch(x, y, z) = (x AND y) XOR ((NOT x) AND z)  [§4.1.3]
// (NOT x is computed as x XOR MASK64 — VUMA has no unary NOT on u64.)
transform ch64(x: u64, y: u64, z: u64) -> u64 {
    // Algebraic identity: (x & y) ^ ((!x) & z) = z ^ (x & (y ^ z))
    // This avoids the MASK64 constant (which is broken on 32-bit backends).
    return z ^ (x & (y ^ z));
}

// Maj(x, y, z) = (x AND y) XOR (x AND z) XOR (y AND z)  [§4.1.3]
transform maj64(x: u64, y: u64, z: u64) -> u64 {
    return (x & y) ^ (x & z) ^ (y & z);
}

// Big Sigma0(x) = ROTR^28(x) XOR ROTR^34(x) XOR ROTR^39(x)  [§4.1.3]
// Inlined rotations with literal shift amounts to avoid arm32 variable-shift bug.
transform big_sigma0_64(x: u64) -> u64 {
    return ((x >> 28) | (x << 36)) ^ ((x >> 34) | (x << 30)) ^ ((x >> 39) | (x << 25));
}

// Big Sigma1(x) = ROTR^14(x) XOR ROTR^18(x) XOR ROTR^41(x)  [§4.1.3]
// Inlined rotations with literal shift amounts.
transform big_sigma1_64(x: u64) -> u64 {
    return ((x >> 14) | (x << 50)) ^ ((x >> 18) | (x << 46)) ^ ((x >> 41) | (x << 23));
}

// Small sigma0(x) = ROTR^1(x) XOR ROTR^8(x) XOR SHR^7(x)  [§4.1.3]
// Inlined rotations (all shifts < 32, but inline for consistency).
transform small_sigma0_64(x: u64) -> u64 {
    return ((x >> 1) | (x << 63)) ^ ((x >> 8) | (x << 56)) ^ (x >> 7);
}

// Small sigma1(x) = ROTR^19(x) XOR ROTR^61(x) XOR SHR^6(x)  [§4.1.3]
// Inlined rotations with literal shift amounts.
transform small_sigma1_64(x: u64) -> u64 {
    return ((x >> 19) | (x << 45)) ^ ((x >> 61) | (x << 3)) ^ (x >> 6);
}

// ===========================================================================
// Round-constants loader.
// ===========================================================================

// sha512_load_k: fill K.k[0..79] with the 80 FIPS-180-4 §4.2.3 round
// constants. All literals are decimal or (1<<63)|lower form per the VUMA
// convention for u64 values >= 2^63.
transform sha512_load_k(K: State<Sha512K>) {
    K.k[0] = K00; K.k[1] = K01; K.k[2] = K02; K.k[3] = K03;
    K.k[4] = K04; K.k[5] = K05; K.k[6] = K06; K.k[7] = K07;
    K.k[8] = K08; K.k[9] = K09; K.k[10] = K10; K.k[11] = K11;
    K.k[12] = K12; K.k[13] = K13; K.k[14] = K14; K.k[15] = K15;
    K.k[16] = K16; K.k[17] = K17; K.k[18] = K18; K.k[19] = K19;
    K.k[20] = K20; K.k[21] = K21; K.k[22] = K22; K.k[23] = K23;
    K.k[24] = K24; K.k[25] = K25; K.k[26] = K26; K.k[27] = K27;
    K.k[28] = K28; K.k[29] = K29; K.k[30] = K30; K.k[31] = K31;
    K.k[32] = K32; K.k[33] = K33; K.k[34] = K34; K.k[35] = K35;
    K.k[36] = K36; K.k[37] = K37; K.k[38] = K38; K.k[39] = K39;
    K.k[40] = K40; K.k[41] = K41; K.k[42] = K42; K.k[43] = K43;
    K.k[44] = K44; K.k[45] = K45; K.k[46] = K46; K.k[47] = K47;
    K.k[48] = K48; K.k[49] = K49; K.k[50] = K50; K.k[51] = K51;
    K.k[52] = K52; K.k[53] = K53; K.k[54] = K54; K.k[55] = K55;
    K.k[56] = K56; K.k[57] = K57; K.k[58] = K58; K.k[59] = K59;
    K.k[60] = K60; K.k[61] = K61; K.k[62] = K62; K.k[63] = K63;
    K.k[64] = K64; K.k[65] = K65; K.k[66] = K66; K.k[67] = K67;
    K.k[68] = K68; K.k[69] = K69; K.k[70] = K70; K.k[71] = K71;
    K.k[72] = K72; K.k[73] = K73; K.k[74] = K74; K.k[75] = K75;
    K.k[76] = K76; K.k[77] = K77; K.k[78] = K78; K.k[79] = K79;
}

// ===========================================================================
// SHA-512 API functions.
// ===========================================================================

// sha512_init: seed the SHA-512 initial hash state into ctx.
// Writes all 8 IV words (byte-by-byte, big-endian) into ctx.state[0..63]
// and zeroes ctx.len + ctx.total_lo + ctx.total_hi.
transform sha512_init(ctx: State<Sha512Ctx>) {
    // H0 = 0x6a09e667f3bcc908 → BE bytes
    ctx.state[0] = ((H0I >> 56) & 255) as u8;
    ctx.state[1] = ((H0I >> 48) & 255) as u8;
    ctx.state[2] = ((H0I >> 40) & 255) as u8;
    ctx.state[3] = ((H0I >> 32) & 255) as u8;
    ctx.state[4] = ((H0I >> 24) & 255) as u8;
    ctx.state[5] = ((H0I >> 16) & 255) as u8;
    ctx.state[6] = ((H0I >> 8) & 255) as u8;
    ctx.state[7] = (H0I & 255) as u8;
    // H1 = 0xbb67ae8584caa73b
    ctx.state[8] = ((H1I >> 56) & 255) as u8;
    ctx.state[9] = ((H1I >> 48) & 255) as u8;
    ctx.state[10] = ((H1I >> 40) & 255) as u8;
    ctx.state[11] = ((H1I >> 32) & 255) as u8;
    ctx.state[12] = ((H1I >> 24) & 255) as u8;
    ctx.state[13] = ((H1I >> 16) & 255) as u8;
    ctx.state[14] = ((H1I >> 8) & 255) as u8;
    ctx.state[15] = (H1I & 255) as u8;
    // H2 = 0x3c6ef372fe94f82b
    ctx.state[16] = ((H2I >> 56) & 255) as u8;
    ctx.state[17] = ((H2I >> 48) & 255) as u8;
    ctx.state[18] = ((H2I >> 40) & 255) as u8;
    ctx.state[19] = ((H2I >> 32) & 255) as u8;
    ctx.state[20] = ((H2I >> 24) & 255) as u8;
    ctx.state[21] = ((H2I >> 16) & 255) as u8;
    ctx.state[22] = ((H2I >> 8) & 255) as u8;
    ctx.state[23] = (H2I & 255) as u8;
    // H3 = 0xa54ff53a5f1d36f1
    ctx.state[24] = ((H3I >> 56) & 255) as u8;
    ctx.state[25] = ((H3I >> 48) & 255) as u8;
    ctx.state[26] = ((H3I >> 40) & 255) as u8;
    ctx.state[27] = ((H3I >> 32) & 255) as u8;
    ctx.state[28] = ((H3I >> 24) & 255) as u8;
    ctx.state[29] = ((H3I >> 16) & 255) as u8;
    ctx.state[30] = ((H3I >> 8) & 255) as u8;
    ctx.state[31] = (H3I & 255) as u8;
    // H4 = 0x510e527fade682d1
    ctx.state[32] = ((H4I >> 56) & 255) as u8;
    ctx.state[33] = ((H4I >> 48) & 255) as u8;
    ctx.state[34] = ((H4I >> 40) & 255) as u8;
    ctx.state[35] = ((H4I >> 32) & 255) as u8;
    ctx.state[36] = ((H4I >> 24) & 255) as u8;
    ctx.state[37] = ((H4I >> 16) & 255) as u8;
    ctx.state[38] = ((H4I >> 8) & 255) as u8;
    ctx.state[39] = (H4I & 255) as u8;
    // H5 = 0x9b05688c2b3e6c1f
    ctx.state[40] = ((H5I >> 56) & 255) as u8;
    ctx.state[41] = ((H5I >> 48) & 255) as u8;
    ctx.state[42] = ((H5I >> 40) & 255) as u8;
    ctx.state[43] = ((H5I >> 32) & 255) as u8;
    ctx.state[44] = ((H5I >> 24) & 255) as u8;
    ctx.state[45] = ((H5I >> 16) & 255) as u8;
    ctx.state[46] = ((H5I >> 8) & 255) as u8;
    ctx.state[47] = (H5I & 255) as u8;
    // H6 = 0x1f83d9abfb41bd6b
    ctx.state[48] = ((H6I >> 56) & 255) as u8;
    ctx.state[49] = ((H6I >> 48) & 255) as u8;
    ctx.state[50] = ((H6I >> 40) & 255) as u8;
    ctx.state[51] = ((H6I >> 32) & 255) as u8;
    ctx.state[52] = ((H6I >> 24) & 255) as u8;
    ctx.state[53] = ((H6I >> 16) & 255) as u8;
    ctx.state[54] = ((H6I >> 8) & 255) as u8;
    ctx.state[55] = (H6I & 255) as u8;
    // H7 = 0x5be0cd19137e2179
    ctx.state[56] = ((H7I >> 56) & 255) as u8;
    ctx.state[57] = ((H7I >> 48) & 255) as u8;
    ctx.state[58] = ((H7I >> 40) & 255) as u8;
    ctx.state[59] = ((H7I >> 32) & 255) as u8;
    ctx.state[60] = ((H7I >> 24) & 255) as u8;
    ctx.state[61] = ((H7I >> 16) & 255) as u8;
    ctx.state[62] = ((H7I >> 8) & 255) as u8;
    ctx.state[63] = (H7I & 255) as u8;
    ctx.len = 0;
    ctx.total_lo = 0;
    ctx.total_hi = 0;
}

// sha512_compress: fold one 128-byte block (ctx.buf) into ctx.state via
// the FIPS-180-4 §6.3.2 80-round SHA-512 compression.
//
// Steps:
//   1. Build the 80-word message schedule W[0..79]:
//        W[0..15] = big-endian load of ctx.buf[i*8..i*8+7]
//        W[i] (16 <= i < 80) = W[i-16] + σ0(W[i-15]) + W[i-7] + σ1(W[i-2])
//   2. Initialize working variables a..h from ctx.state (BE load).
//   3. Run 80 rounds:
//        T1 = h + Σ1(e) + Ch(e,f,g) + K[i] + W[i]
//        T2 = Σ0(a) + Maj(a,b,c)
//        h = g; g = f; f = e; e = d + T1;
//        d = c; c = b; b = a; a = T1 + T2.
//   4. Fold a..h back into ctx.state (H[i] += working[i] mod 2^64).
transform sha512_compress(ctx: State<Sha512Ctx>) {
    let W = state_new(Sha512W);
    let K = state_new(Sha512K);
    sha512_load_k(K);

    // Step 1: build the message schedule.
    // W[0..15] = big-endian load of ctx.buf[i*8..i*8+7].
    let i = 0;
    while i < 16 {
        let off = i * 8;
        let b0 = ctx.buf[off] as u64;
        let b1 = ctx.buf[off + 1] as u64;
        let b2 = ctx.buf[off + 2] as u64;
        let b3 = ctx.buf[off + 3] as u64;
        let b4 = ctx.buf[off + 4] as u64;
        let b5 = ctx.buf[off + 5] as u64;
        let b6 = ctx.buf[off + 6] as u64;
        let b7 = ctx.buf[off + 7] as u64;
        W.w[i] = (b0 << 56) | (b1 << 48) | (b2 << 40) | (b3 << 32)
               | (b4 << 24) | (b5 << 16) | (b6 << 8) | b7;
        i = i + 1;
    }
    // W[16..79] = W[i-16] + ssig0(W[i-15]) + W[i-7] + ssig1(W[i-2])  (§6.3.2).
    i = 16;
    while i < 80 {
        let w15 = W.w[i - 15];
        let w2 = W.w[i - 2];
        let w7 = W.w[i - 7];
        let w16 = W.w[i - 16];
        W.w[i] = w16 + small_sigma0_64(w15) + w7 + small_sigma1_64(w2);
        i = i + 1;
    }

    // Step 2: initialize working variables a..h from ctx.state (BE load).
    let a0 = (ctx.state[0] as u64) << 56 | (ctx.state[1] as u64) << 48
           | (ctx.state[2] as u64) << 40 | (ctx.state[3] as u64) << 32
           | (ctx.state[4] as u64) << 24 | (ctx.state[5] as u64) << 16
           | (ctx.state[6] as u64) << 8  | (ctx.state[7] as u64);
    let b0 = (ctx.state[8] as u64) << 56 | (ctx.state[9] as u64) << 48
           | (ctx.state[10] as u64) << 40 | (ctx.state[11] as u64) << 32
           | (ctx.state[12] as u64) << 24 | (ctx.state[13] as u64) << 16
           | (ctx.state[14] as u64) << 8  | (ctx.state[15] as u64);
    let c0 = (ctx.state[16] as u64) << 56 | (ctx.state[17] as u64) << 48
           | (ctx.state[18] as u64) << 40 | (ctx.state[19] as u64) << 32
           | (ctx.state[20] as u64) << 24 | (ctx.state[21] as u64) << 16
           | (ctx.state[22] as u64) << 8  | (ctx.state[23] as u64);
    let d0 = (ctx.state[24] as u64) << 56 | (ctx.state[25] as u64) << 48
           | (ctx.state[26] as u64) << 40 | (ctx.state[27] as u64) << 32
           | (ctx.state[28] as u64) << 24 | (ctx.state[29] as u64) << 16
           | (ctx.state[30] as u64) << 8  | (ctx.state[31] as u64);
    let e0 = (ctx.state[32] as u64) << 56 | (ctx.state[33] as u64) << 48
           | (ctx.state[34] as u64) << 40 | (ctx.state[35] as u64) << 32
           | (ctx.state[36] as u64) << 24 | (ctx.state[37] as u64) << 16
           | (ctx.state[38] as u64) << 8  | (ctx.state[39] as u64);
    let f0 = (ctx.state[40] as u64) << 56 | (ctx.state[41] as u64) << 48
           | (ctx.state[42] as u64) << 40 | (ctx.state[43] as u64) << 32
           | (ctx.state[44] as u64) << 24 | (ctx.state[45] as u64) << 16
           | (ctx.state[46] as u64) << 8  | (ctx.state[47] as u64);
    let g0 = (ctx.state[48] as u64) << 56 | (ctx.state[49] as u64) << 48
           | (ctx.state[50] as u64) << 40 | (ctx.state[51] as u64) << 32
           | (ctx.state[52] as u64) << 24 | (ctx.state[53] as u64) << 16
           | (ctx.state[54] as u64) << 8  | (ctx.state[55] as u64);
    let h0 = (ctx.state[56] as u64) << 56 | (ctx.state[57] as u64) << 48
           | (ctx.state[58] as u64) << 40 | (ctx.state[59] as u64) << 32
           | (ctx.state[60] as u64) << 24 | (ctx.state[61] as u64) << 16
           | (ctx.state[62] as u64) << 8  | (ctx.state[63] as u64);

    let a: u64 = a0;
    let b: u64 = b0;
    let c: u64 = c0;
    let d: u64 = d0;
    let e: u64 = e0;
    let f: u64 = f0;
    let g: u64 = g0;
    let h: u64 = h0;

    // Step 3: 80 SHA-512 rounds (FIPS-180-4 §6.3.2).
    let r = 0;
    while r < 80 {
        let ki = K.k[r];
        let wi = W.w[r];
        let t1 = h + big_sigma1_64(e) + ch64(e, f, g) + ki + wi;
        let t2 = big_sigma0_64(a) + maj64(a, b, c);
        h = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
        r = r + 1;
    }

    // Step 4: fold a..h back into ctx.state (H[i] += working[i] mod 2^64).
    let na = a0 + a;
    let nb = b0 + b;
    let nc = c0 + c;
    let nd = d0 + d;
    let ne = e0 + e;
    let nf = f0 + f;
    let ng = g0 + g;
    let nh = h0 + h;
    ctx.state[0] = ((na >> 56) & 255) as u8;
    ctx.state[1] = ((na >> 48) & 255) as u8;
    ctx.state[2] = ((na >> 40) & 255) as u8;
    ctx.state[3] = ((na >> 32) & 255) as u8;
    ctx.state[4] = ((na >> 24) & 255) as u8;
    ctx.state[5] = ((na >> 16) & 255) as u8;
    ctx.state[6] = ((na >> 8) & 255) as u8;
    ctx.state[7] = (na & 255) as u8;
    ctx.state[8] = ((nb >> 56) & 255) as u8;
    ctx.state[9] = ((nb >> 48) & 255) as u8;
    ctx.state[10] = ((nb >> 40) & 255) as u8;
    ctx.state[11] = ((nb >> 32) & 255) as u8;
    ctx.state[12] = ((nb >> 24) & 255) as u8;
    ctx.state[13] = ((nb >> 16) & 255) as u8;
    ctx.state[14] = ((nb >> 8) & 255) as u8;
    ctx.state[15] = (nb & 255) as u8;
    ctx.state[16] = ((nc >> 56) & 255) as u8;
    ctx.state[17] = ((nc >> 48) & 255) as u8;
    ctx.state[18] = ((nc >> 40) & 255) as u8;
    ctx.state[19] = ((nc >> 32) & 255) as u8;
    ctx.state[20] = ((nc >> 24) & 255) as u8;
    ctx.state[21] = ((nc >> 16) & 255) as u8;
    ctx.state[22] = ((nc >> 8) & 255) as u8;
    ctx.state[23] = (nc & 255) as u8;
    ctx.state[24] = ((nd >> 56) & 255) as u8;
    ctx.state[25] = ((nd >> 48) & 255) as u8;
    ctx.state[26] = ((nd >> 40) & 255) as u8;
    ctx.state[27] = ((nd >> 32) & 255) as u8;
    ctx.state[28] = ((nd >> 24) & 255) as u8;
    ctx.state[29] = ((nd >> 16) & 255) as u8;
    ctx.state[30] = ((nd >> 8) & 255) as u8;
    ctx.state[31] = (nd & 255) as u8;
    ctx.state[32] = ((ne >> 56) & 255) as u8;
    ctx.state[33] = ((ne >> 48) & 255) as u8;
    ctx.state[34] = ((ne >> 40) & 255) as u8;
    ctx.state[35] = ((ne >> 32) & 255) as u8;
    ctx.state[36] = ((ne >> 24) & 255) as u8;
    ctx.state[37] = ((ne >> 16) & 255) as u8;
    ctx.state[38] = ((ne >> 8) & 255) as u8;
    ctx.state[39] = (ne & 255) as u8;
    ctx.state[40] = ((nf >> 56) & 255) as u8;
    ctx.state[41] = ((nf >> 48) & 255) as u8;
    ctx.state[42] = ((nf >> 40) & 255) as u8;
    ctx.state[43] = ((nf >> 32) & 255) as u8;
    ctx.state[44] = ((nf >> 24) & 255) as u8;
    ctx.state[45] = ((nf >> 16) & 255) as u8;
    ctx.state[46] = ((nf >> 8) & 255) as u8;
    ctx.state[47] = (nf & 255) as u8;
    ctx.state[48] = ((ng >> 56) & 255) as u8;
    ctx.state[49] = ((ng >> 48) & 255) as u8;
    ctx.state[50] = ((ng >> 40) & 255) as u8;
    ctx.state[51] = ((ng >> 32) & 255) as u8;
    ctx.state[52] = ((ng >> 24) & 255) as u8;
    ctx.state[53] = ((ng >> 16) & 255) as u8;
    ctx.state[54] = ((ng >> 8) & 255) as u8;
    ctx.state[55] = (ng & 255) as u8;
    ctx.state[56] = ((nh >> 56) & 255) as u8;
    ctx.state[57] = ((nh >> 48) & 255) as u8;
    ctx.state[58] = ((nh >> 40) & 255) as u8;
    ctx.state[59] = ((nh >> 32) & 255) as u8;
    ctx.state[60] = ((nh >> 24) & 255) as u8;
    ctx.state[61] = ((nh >> 16) & 255) as u8;
    ctx.state[62] = ((nh >> 8) & 255) as u8;
    ctx.state[63] = (nh & 255) as u8;
}

// Increment the 64-bit bit counter (stored as two u32 limbs) by `bits`.
// Carries into total_hi when the low limb wraps mod 2^32.
transform sha512_add_bits(ctx: State<Sha512Ctx>, bits: u32) {
    let lo = ctx.total_lo;
    let hi = ctx.total_hi;
    let new_lo = lo + bits;
    if new_lo < lo {
        ctx.total_hi = hi + 1;
    }
    ctx.total_lo = new_lo;
}

// sha512_update: absorb `len` bytes of data into the hash state.
// Buffers input bytes into ctx.buf. When ctx.len reaches 128, calls
// sha512_compress to fold the block into ctx.state and resets ctx.len.
transform sha512_update(ctx: State<Sha512Ctx>, data: State<Sha512Data>, len: u32) {
    let i: u32 = 0;
    while i < len {
        let bl = ctx.len;
        ctx.buf[bl] = data.data[i];
        ctx.len = bl + 1;
        i = i + 1;
        if ctx.len == 128 {
            sha512_compress(ctx);
            sha512_add_bits(ctx, 1024);
            ctx.len = 0;
        }
    }
}

// sha512_final: emit the 64-byte SHA-512 digest into `out`.
//
// FIPS-180-4 §5.1.2 padding (1024-bit variant):
//   1. Append 0x80 at ctx.buf[ctx.len].
//   2. Zero-pad to offset 112 (mod 128). If ctx.len + 1 > 112, the padding
//      overflows into a second block — compress the first, then start a
//      fresh zero block for the length suffix.
//   3. Write the 128-bit big-endian bit count at ctx.buf[112..127].
//      (High 64 bits at 112..119 = 0; low 64 bits at 120..127 from
//      total_hi:total_lo.)
//   4. Run the final compression.
//   5. Copy ctx.state[0..63] to out.data[0..63] (already BE — §5.1.2).
transform sha512_final(ctx: State<Sha512Ctx>, out: State<Sha512Digest>) {
    let buf_len: u32 = ctx.len;
    sha512_add_bits(ctx, buf_len * 8);

    // Step 1: append the 0x80 padding bit.
    ctx.buf[buf_len] = 128;
    buf_len = buf_len + 1;

    // Step 2: zero-pad to offset 112 (mod 128).
    if buf_len > 112 {
        while buf_len < 128 {
            ctx.buf[buf_len] = 0;
            buf_len = buf_len + 1;
        }
        sha512_compress(ctx);
        buf_len = 0;
    }
    while buf_len < 112 {
        ctx.buf[buf_len] = 0;
        buf_len = buf_len + 1;
    }

    // Step 3: 128-bit big-endian bit count at ctx.buf[112..127].
    // High 64 bits (112..119) = 0 (already zero-padded above).
    // Low 64 bits (120..127) = total_hi : total_lo (each BE 4 bytes).
    let lo = ctx.total_lo;
    let hi = ctx.total_hi;
    ctx.buf[112] = 0;
    ctx.buf[113] = 0;
    ctx.buf[114] = 0;
    ctx.buf[115] = 0;
    ctx.buf[116] = 0;
    ctx.buf[117] = 0;
    ctx.buf[118] = 0;
    ctx.buf[119] = 0;
    ctx.buf[120] = ((hi >> 24) & 255) as u8;
    ctx.buf[121] = ((hi >> 16) & 255) as u8;
    ctx.buf[122] = ((hi >> 8) & 255) as u8;
    ctx.buf[123] = (hi & 255) as u8;
    ctx.buf[124] = ((lo >> 24) & 255) as u8;
    ctx.buf[125] = ((lo >> 16) & 255) as u8;
    ctx.buf[126] = ((lo >> 8) & 255) as u8;
    ctx.buf[127] = (lo & 255) as u8;

    // Step 4: final compression.
    sha512_compress(ctx);

    // Step 5: copy state (BE) to digest output (BE — direct copy).
    let i = 0;
    while i < 64 {
        out.data[i] = ctx.state[i];
        i = i + 1;
    }
}

// Convenience wrapper: initialise a fresh context, absorb `data`, finalise
// into `out`.
transform sha512_oneshot(data: State<Sha512Data>, len: u32, out: State<Sha512Digest>) {
    let ctx = state_new(Sha512Ctx);
    sha512_init(ctx);
    sha512_update(ctx, data, len);
    sha512_final(ctx, out);
}
