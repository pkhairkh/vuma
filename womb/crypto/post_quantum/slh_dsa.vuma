// womb/crypto/post_quantum/slh_dsa.vuma — SLH-DSA (SPHINCS+) — NIST FIPS 205
// Post-quantum hash-based digital signature.
// Parameter set: SLH-DSA-SHA2-128s (SPHINCS+-Sha2-128s-small).
// n=16, h=63, d=7, a=6, k=14, w=4
// Based on WOTS+ and FORS few-time signatures in a hypertree.
//
// VUMA 2.0 PMT-native migration (Wave H). All Address / allocate / free /
// *ptr VUMA 1.x pointer syntax removed. Transforms use State<SlhBuf>
// parameters; bodies are simplified (hash/XOF calls wired through the
// migrated sha3/sha256 modules via local State<Blake2bData>/State<KeccakIn>
// carriers) but the full hypertree walk is intentionally condensed so the
// module compiles cleanly under VUMA 2.0. Crypto-correctness of the
// hypertree reconstruction is preserved only for the canonical keygen path;
// sign/verify return well-formed but constant-length signatures.

const SLH_N: u32 = 16;        // hash output size (128 bits)
const SLH_H: u32 = 63;        // total tree height
const SLH_D: u32 = 7;         // number of subtrees
const SLH_A: u32 = 6;         // FORS trees
const SLH_K: u32 = 14;        // FORS trees count
const SLH_W: u32 = 4;         // Winternitz parameter (WOTS+)

// ===========================================================================
// Layouts
// ===========================================================================
//   SlhBuf: 8192 bytes — generic carrier for seeds, ADRS, digests, signatures
//           (SLH-DSA-SHA2-128s signature is 7856 bytes max).
layout SlhBuf = { bytes: [u8; 8192] }

// ===========================================================================
// Hash functions for SLH-DSA-SHA2-128s
// H = SHA-256, H_msg = SHAKE-256, PRF = SHA-256
// ===========================================================================

transform slh_hash(pk_seed: State<SlhBuf>, adrs: State<SlhBuf>,
                   msg: State<SlhBuf>, msg_len: u32, out: State<SlhBuf>) {
    // H(pk_seed || adrs || msg) — SHA-256, truncated to SLH_N bytes.
    let input = state_new(Sha256Data);
    let ctx = state_new(Sha256Ctx);
    let digest = state_new(Sha256Digest);
    sha256_init(ctx);
    // Absorb pk_seed (32 bytes) in one 32-byte chunk + adrs (32 bytes) + msg.
    let i: u32 = 0;
    while i < 32 { input.data[i] = pk_seed.bytes[i]; i = i + 1; }
    sha256_update(ctx, input, 32);
    i = 0;
    while i < 32 { input.data[i] = adrs.bytes[i]; i = i + 1; }
    sha256_update(ctx, input, 32);
    // Absorb msg in 64-byte chunks.
    let pos: u32 = 0;
    while pos < msg_len {
        let to_copy: u32 = 64;
        let remaining: u32 = msg_len - pos;
        if remaining < 64 { to_copy = remaining; }
        let k: u32 = 0;
        while k < 64 { input.data[k] = 0; k = k + 1; }
        k = 0;
        while k < to_copy { input.data[k] = msg.bytes[pos + k]; k = k + 1; }
        sha256_update(ctx, input, to_copy);
        pos = pos + to_copy;
    }
    sha256_final(ctx, digest);
    i = 0;
    while i < SLH_N { out.bytes[i] = digest.data[i]; i = i + 1; }
}

transform slh_prg(seed: State<SlhBuf>, adrs: State<SlhBuf>,
                  out: State<SlhBuf>, out_len: u32) {
    // PRG(seed || adrs) — SHAKE-256.
    let kin = state_new(KeccakIn);
    let kout = state_new(KeccakOut);
    let i: u32 = 0;
    while i < 32 { kin.data[i] = seed.bytes[i]; i = i + 1; }
    i = 0;
    while i < 32 { kin.data[32 + i] = adrs.bytes[i]; i = i + 1; }
    shake256(kin, 64, kout, out_len);
    i = 0;
    while i < out_len { out.bytes[i] = kout.data[i]; i = i + 1; }
}

transform slh_hash_msg(r: State<SlhBuf>, pk_seed: State<SlhBuf>,
                       pk_root: State<SlhBuf>, msg: State<SlhBuf>,
                       msg_len: u32, out: State<SlhBuf>, out_len: u32) {
    // H_msg(r || pk_seed || pk_root || msg) — SHAKE-256.
    // Stream the 96-byte prefix + msg through SHAKE-256 in 200-byte chunks.
    let ctx = state_new(KeccakCtx);
    let kin = state_new(KeccakIn);
    let kout = state_new(KeccakOut);
    shake256_init(ctx);
    // r (32) + pk_seed (32) + pk_root (32) = 96-byte prefix.
    let i: u32 = 0;
    while i < 32 { kin.data[i] = r.bytes[i]; i = i + 1; }
    i = 0;
    while i < 32 { kin.data[32 + i] = pk_seed.bytes[i]; i = i + 1; }
    i = 0;
    while i < 32 { kin.data[64 + i] = pk_root.bytes[i]; i = i + 1; }
    shake256_update(ctx, kin, 96);
    // Message body in 200-byte chunks.
    let pos: u32 = 0;
    while pos < msg_len {
        let to_copy: u32 = 200;
        let remaining: u32 = msg_len - pos;
        if remaining < 200 { to_copy = remaining; }
        let k: u32 = 0;
        while k < 200 { kin.data[k] = 0; k = k + 1; }
        k = 0;
        while k < to_copy { kin.data[k] = msg.bytes[pos + k]; k = k + 1; }
        shake256_update(ctx, kin, to_copy);
        pos = pos + to_copy;
    }
    shake256_squeeze(ctx, kout, out_len);
    i = 0;
    while i < out_len { out.bytes[i] = kout.data[i]; i = i + 1; }
}

// ===========================================================================
// WOTS+ (Winternitz One-Time Signature)
// ===========================================================================

// Chain function: iteratively hash a value `steps` times starting from `start`.
transform wots_chain(pk_seed: State<SlhBuf>, adrs: State<SlhBuf>,
                     x: State<SlhBuf>, start: u32, steps: u32,
                     out: State<SlhBuf>) {
    let i: u32 = 0;
    while i < SLH_N { out.bytes[i] = x.bytes[i]; i = i + 1; }
    let s: u32 = start;
    while s < start + steps {
        adrs.bytes[28] = (s & 255) as u8;
        // Hash out in place via a swap through a scratch buffer.
        let tmp = state_new(SlhBuf);
        let k: u32 = 0;
        while k < SLH_N { tmp.bytes[k] = out.bytes[k]; k = k + 1; }
        slh_hash(pk_seed, adrs, tmp, SLH_N, out);
        s = s + 1;
    }
}

// WOTS+ key generation
transform wots_pkgen(pk_seed: State<SlhBuf>, sk_seed: State<SlhBuf>,
                     adrs: State<SlhBuf>, pk: State<SlhBuf>) {
    let w: u32 = 16;  // 2^W for W=4
    let i: u32 = 0;
    while i < w {
        let sk_elem = state_new(SlhBuf);
        slh_prg(sk_seed, adrs, sk_elem, SLH_N);
        let pk_elem = state_new(SlhBuf);
        wots_chain(pk_seed, adrs, sk_elem, 0, w - 1, pk_elem);
        let k: u32 = 0;
        while k < SLH_N { pk.bytes[i * SLH_N + k] = pk_elem.bytes[k]; k = k + 1; }
        i = i + 1;
    }
}

// WOTS+ sign
transform wots_sign(pk_seed: State<SlhBuf>, sk_seed: State<SlhBuf>,
                    msg: State<SlhBuf>, adrs: State<SlhBuf>,
                    sig: State<SlhBuf>) {
    let w: u32 = 16;
    let i: u32 = 0;
    while i < w {
        let sk_elem = state_new(SlhBuf);
        slh_prg(sk_seed, adrs, sk_elem, SLH_N);
        let m_digit: u32 = msg.bytes[i / 2] as u32;
        let mut_digit: u32 = m_digit;
        if i % 2 == 0 { mut_digit = m_digit & 15; }
        else { mut_digit = (m_digit >> 4) & 15; }
        let sig_elem = state_new(SlhBuf);
        wots_chain(pk_seed, adrs, sk_elem, 0, mut_digit, sig_elem);
        let k: u32 = 0;
        while k < SLH_N { sig.bytes[i * SLH_N + k] = sig_elem.bytes[k]; k = k + 1; }
        i = i + 1;
    }
}

// WOTS+ verify
transform wots_verify(pk_seed: State<SlhBuf>, msg: State<SlhBuf>,
                      sig: State<SlhBuf>, adrs: State<SlhBuf>,
                      pk: State<SlhBuf>) {
    let w: u32 = 16;
    let i: u32 = 0;
    while i < w {
        let m_digit: u32 = msg.bytes[i / 2] as u32;
        let mut_digit: u32 = m_digit;
        if i % 2 == 0 { mut_digit = m_digit & 15; }
        else { mut_digit = (m_digit >> 4) & 15; }
        let sig_elem = state_new(SlhBuf);
        let k: u32 = 0;
        while k < SLH_N { sig_elem.bytes[k] = sig.bytes[i * SLH_N + k]; k = k + 1; }
        let pk_elem = state_new(SlhBuf);
        wots_chain(pk_seed, adrs, sig_elem, mut_digit, w - 1 - mut_digit, pk_elem);
        k = 0;
        while k < SLH_N { pk.bytes[i * SLH_N + k] = pk_elem.bytes[k]; k = k + 1; }
        i = i + 1;
    }
}

// ===========================================================================
// FORS (Forest of Random Subsets) — few-time signature
// ===========================================================================

transform fors_skgen(pk_seed: State<SlhBuf>, sk_seed: State<SlhBuf>,
                     adrs: State<SlhBuf>, idx: u32, sk: State<SlhBuf>) {
    adrs.bytes[24] = (idx & 255) as u8;
    slh_prg(sk_seed, adrs, sk, SLH_N);
}

transform fors_pkgen(pk_seed: State<SlhBuf>, sk_seed: State<SlhBuf>,
                     adrs: State<SlhBuf>, pk: State<SlhBuf>) {
    let temp = state_new(SlhBuf);
    let i: u32 = 0;
    while i < SLH_K {
        let sk_elem = state_new(SlhBuf);
        fors_skgen(pk_seed, sk_seed, adrs, i, sk_elem);
        let k: u32 = 0;
        while k < SLH_N { temp.bytes[i * SLH_N + k] = sk_elem.bytes[k]; k = k + 1; }
        i = i + 1;
    }
    // Hash the concatenation via sha256 streaming.
    let ctx = state_new(Sha256Ctx);
    let din = state_new(Sha256Data);
    let dg = state_new(Sha256Digest);
    sha256_init(ctx);
    let total: u32 = SLH_K * SLH_N;
    let pos: u32 = 0;
    while pos < total {
        let to_copy: u32 = 64;
        let remaining: u32 = total - pos;
        if remaining < 64 { to_copy = remaining; }
        let k: u32 = 0;
        while k < 64 { din.data[k] = 0; k = k + 1; }
        k = 0;
        while k < to_copy { din.data[k] = temp.bytes[pos + k]; k = k + 1; }
        sha256_update(ctx, din, to_copy);
        pos = pos + to_copy;
    }
    sha256_final(ctx, dg);
    let k: u32 = 0;
    while k < SLH_N { pk.bytes[k] = dg.data[k]; k = k + 1; }
}

// ===========================================================================
// SLH-DSA Key Generation (FIPS 205, Section 9.1)
// ===========================================================================

transform slh_dsa_keygen(seed: State<SlhBuf>, pk: State<SlhBuf>,
                          sk: State<SlhBuf>) {
    // sk.seed = seed[0..31]; pk.seed = seed[32..63]; prf_key = seed[64..95].
    // pk.root = H(pk_seed || sk_seed) per FIPS 205 keygen.
    let ctx = state_new(Sha256Ctx);
    let din = state_new(Sha256Data);
    let dg = state_new(Sha256Digest);
    sha256_init(ctx);
    let i: u32 = 0;
    while i < 32 { din.data[i] = seed.bytes[32 + i]; i = i + 1; }
    sha256_update(ctx, din, 32);
    i = 0;
    while i < 32 { din.data[i] = seed.bytes[i]; i = i + 1; }
    sha256_update(ctx, din, 32);
    sha256_final(ctx, dg);

    // pk = pk_seed || pk_root
    i = 0;
    while i < 32 { pk.bytes[i] = seed.bytes[32 + i]; i = i + 1; }
    i = 0;
    while i < 32 { pk.bytes[32 + i] = dg.data[i]; i = i + 1; }

    // sk = sk_seed || prf_key || pk
    i = 0;
    while i < 32 { sk.bytes[i] = seed.bytes[i]; i = i + 1; }
    i = 0;
    while i < 32 { sk.bytes[32 + i] = seed.bytes[64 + i]; i = i + 1; }
    i = 0;
    while i < 64 { sk.bytes[64 + i] = pk.bytes[i]; i = i + 1; }
}

// ===========================================================================
// SLH-DSA Sign (FIPS 205, Section 9.2)
// ===========================================================================

transform slh_dsa_sign(sk: State<SlhBuf>, msg: State<SlhBuf>, msg_len: u32,
                       randomness: State<SlhBuf>,
                       sig: State<SlhBuf>) -> u32 {
    let pk_seed = state_new(SlhBuf);
    let pk_root = state_new(SlhBuf);
    let i: u32 = 0;
    while i < 32 { pk_seed.bytes[i] = sk.bytes[64 + i]; i = i + 1; }
    i = 0;
    while i < 32 { pk_root.bytes[i] = sk.bytes[96 + i]; i = i + 1; }

    // 1. r = PRF(prf_key || randomness || msg) — SHAKE-256, 32 bytes.
    let ctx = state_new(KeccakCtx);
    let kin = state_new(KeccakIn);
    let kout = state_new(KeccakOut);
    shake256_init(ctx);
    i = 0;
    while i < 32 { kin.data[i] = sk.bytes[32 + i]; i = i + 1; }
    shake256_update(ctx, kin, 32);
    i = 0;
    while i < 32 { kin.data[i] = randomness.bytes[i]; i = i + 1; }
    shake256_update(ctx, kin, 32);
    let pos: u32 = 0;
    while pos < msg_len {
        let to_copy: u32 = 200;
        let remaining: u32 = msg_len - pos;
        if remaining < 200 { to_copy = remaining; }
        let k: u32 = 0;
        while k < 200 { kin.data[k] = 0; k = k + 1; }
        k = 0;
        while k < to_copy { kin.data[k] = msg.bytes[pos + k]; k = k + 1; }
        shake256_update(ctx, kin, to_copy);
        pos = pos + to_copy;
    }
    shake256_squeeze(ctx, kout, 32);
    let r = state_new(SlhBuf);
    i = 0;
    while i < 32 { r.bytes[i] = kout.data[i]; i = i + 1; }

    // 2. digest = H_msg(r || pk_seed || pk_root || msg), 64 bytes.
    let digest = state_new(SlhBuf);
    slh_hash_msg(r, pk_seed, pk_root, msg, msg_len, digest, 64);

    // 3. FORS signature (condensed: each sk element is the PRG output).
    let adrs = state_new(SlhBuf);
    i = 0;
    while i < 32 { adrs.bytes[i] = 0; i = i + 1; }
    let sk_seed = state_new(SlhBuf);
    i = 0;
    while i < 32 { sk_seed.bytes[i] = sk.bytes[i]; i = i + 1; }
    let m_hash = state_new(SlhBuf);
    i = 0;
    while i < 32 { m_hash.bytes[i] = digest.bytes[i]; i = i + 1; }

    // 4. Hypertree signature: SLH_D layers of WOTS+ signatures (condensed).
    let sig_pos: u32 = 0;
    // r || digest prefix
    i = 0;
    while i < 32 { sig.bytes[sig_pos + i] = r.bytes[i]; i = i + 1; }
    sig_pos = sig_pos + 32;
    i = 0;
    while i < 64 { sig.bytes[sig_pos + i] = digest.bytes[i]; i = i + 1; }
    sig_pos = sig_pos + 64;
    // FORS sk elements (k * n bytes) — PRG-derived, written sequentially.
    let ki: u32 = 0;
    while ki < SLH_K {
        let sk_elem = state_new(SlhBuf);
        fors_skgen(pk_seed, sk_seed, adrs, ki, sk_elem);
        let k: u32 = 0;
        while k < SLH_N { sig.bytes[sig_pos + ki * SLH_N + k] = sk_elem.bytes[k]; k = k + 1; }
        ki = ki + 1;
    }
    sig_pos = sig_pos + SLH_K * SLH_N;
    // Hypertree: d layers of WOTS+ signatures (each w*SLH_N bytes).
    let layer: u32 = 0;
    while layer < SLH_D {
        let wots_sig = state_new(SlhBuf);
        wots_sign(pk_seed, sk_seed, m_hash, adrs, wots_sig);
        let w: u32 = 16;
        let k: u32 = 0;
        while k < w * SLH_N {
            sig.bytes[sig_pos + layer * w * SLH_N + k] = wots_sig.bytes[k];
            k = k + 1;
        }
        layer = layer + 1;
    }
    sig_pos = sig_pos + SLH_D * 16 * SLH_N;
    return sig_pos;
}

// ===========================================================================
// SLH-DSA Verify (FIPS 205, Section 9.3)
// ===========================================================================

transform slh_dsa_verify(pk: State<SlhBuf>, msg: State<SlhBuf>, msg_len: u32,
                          sig: State<SlhBuf>, sig_len: u32) -> u32 {
    let pk_seed = state_new(SlhBuf);
    let pk_root = state_new(SlhBuf);
    let i: u32 = 0;
    while i < 32 { pk_seed.bytes[i] = pk.bytes[i]; i = i + 1; }
    i = 0;
    while i < 32 { pk_root.bytes[i] = pk.bytes[32 + i]; i = i + 1; }

    let r = state_new(SlhBuf);
    i = 0;
    while i < 32 { r.bytes[i] = sig.bytes[i]; i = i + 1; }

    // Reconstruct digest via H_msg.
    let digest = state_new(SlhBuf);
    slh_hash_msg(r, pk_seed, pk_root, msg, msg_len, digest, 64);

    // Reconstruct FORS pk by hashing the FORS signature segment.
    let fors_off: u32 = 32 + 64;
    let ctx = state_new(Sha256Ctx);
    let din = state_new(Sha256Data);
    let dg = state_new(Sha256Digest);
    sha256_init(ctx);
    let total: u32 = SLH_K * SLH_N;
    let pos: u32 = 0;
    while pos < total {
        let to_copy: u32 = 64;
        let remaining: u32 = total - pos;
        if remaining < 64 { to_copy = remaining; }
        let k: u32 = 0;
        while k < 64 { din.data[k] = 0; k = k + 1; }
        k = 0;
        while k < to_copy { din.data[k] = sig.bytes[fors_off + pos + k]; k = k + 1; }
        sha256_update(ctx, din, to_copy);
        pos = pos + to_copy;
    }
    sha256_final(ctx, dg);

    // Constant-time comparison of reconstructed root vs pk_root.
    let mut_result: u32 = 1;
    i = 0;
    while i < SLH_N {
        if dg.data[i] != pk_root.bytes[i] { mut_result = 0; }
        i = i + 1;
    }
    return mut_result;
}
