// womb/crypto/falcon.vuma — Falcon — NTRU-lattice post-quantum signature
// Parameter set: Falcon-512 (n=512, q=12289, security level 1).
//
// VUMA 2.0 PMT-native migration (Wave H). All Address / allocate / free /
// *ptr VUMA 1.x pointer syntax removed. Public API uses State<FalconBuf>
// parameters; bodies preserve the original Falcon-512 algorithmic shape
// (schoolbook poly mul, extended-Euclidean poly inverse, CDT discrete
// Gaussian sampler, BDD-style rejection signer) but operate on
// arena-backed State<FalconBuf> byte arrays (32 KiB each) instead of
// VUMA 1.x Address/allocate/free pointers.

import "/home/z/my-project/workdir/vuma/womb/crypto/hash/sha3.vuma"::{
    KeccakCtx, KeccakIn, KeccakOut,
    shake256_init, shake256_update, shake256_squeeze
};

const FALCON_N: u32 = 512;
const FALCON_Q: u32 = 12289;
const FALCON_ETA: u32 = 2;
const FALCON_POLY_BYTES: u32 = 2048;      // 512 * 4
const FALCON_PK_BYTES: u32 = 2048;        // h
const FALCON_SK_BYTES: u32 = 4096;        // f || g
const FALCON_SIG_BYTES: u32 = 2048;       // s
const FALCON_POLY_PLUS1_BYTES: u32 = 2052; // (N+1) * 4 for Euclidean buffers

const FALCON_SIG_L2_BOUND: f64 = 5000.0;
const FALCON_HASH_INF_BOUND: u32 = 6144;  // floor(q/2)

const FALCON_SIG_L2_BOUND_SQ: u32 = 25000000;
const FALCON_BDD_MAX_RETRIES: u32 = 16;
const FALCON_GAUSS_SIGMA: f64 = 1.278461;
const FALCON_GAUSS_MAX: u32 = 8;

const DEG_ZERO: u32 = 4294967295;          // 0xFFFFFFFF
const DIV_ERROR: u32 = 4294967294;         // 0xFFFFFFFE

// ===========================================================================
// Layouts
// ===========================================================================
//   FalconBuf: 32768 bytes — generic carrier for polynomials (FALCON_N u32
//              coefs each, 2048 bytes), extended-Euclidean scratch buffers
//              (N+1 coefs, 2052 bytes), and SHAKE-256 noise expansions.
layout FalconBuf = { bytes: [u8; 32768] }

// ===========================================================================
// Byte load/store helpers (little-endian u32) on a State<FalconBuf>.
// ===========================================================================

transform store_u32_le_at(buf: State<FalconBuf>, off: u32, val: u32) {
    buf.bytes[off]     = (val & 255) as u8;
    buf.bytes[off + 1] = ((val >> 8)  & 255) as u8;
    buf.bytes[off + 2] = ((val >> 16) & 255) as u8;
    buf.bytes[off + 3] = ((val >> 24) & 255) as u8;
}

transform load_u32_le_at(buf: State<FalconBuf>, off: u32) -> u32 {
    let b0: u32 = buf.bytes[off]     as u32;
    let b1: u32 = buf.bytes[off + 1] as u32;
    let b2: u32 = buf.bytes[off + 2] as u32;
    let b3: u32 = buf.bytes[off + 3] as u32;
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

// ===========================================================================
// Polynomial helpers — arrays of FALCON_N u32 coefficients (4 bytes each).
// All arithmetic is mod FALCON_Q in the ring Z[x]/(x^N + 1).
// ===========================================================================

transform poly_zero_at(buf: State<FalconBuf>, base: u32) {
    let i: u32 = 0;
    while i < FALCON_N { store_u32_le_at(buf, base + i * 4, 0); i = i + 1; }
}

transform poly_zero_sized_at(buf: State<FalconBuf>, base: u32, m: u32) {
    let i: u32 = 0;
    while i < m { store_u32_le_at(buf, base + i * 4, 0); i = i + 1; }
}

transform poly_copy_at(dst: State<FalconBuf>, dst_base: u32,
                      src: State<FalconBuf>, src_base: u32) {
    let i: u32 = 0;
    while i < FALCON_POLY_BYTES {
        dst.bytes[dst_base + i] = src.bytes[src_base + i];
        i = i + 1;
    }
}

transform poly_copy_sized_at(dst: State<FalconBuf>, dst_base: u32,
                              src: State<FalconBuf>, src_base: u32, m: u32) {
    let i: u32 = 0;
    while i < m * 4 {
        dst.bytes[dst_base + i] = src.bytes[src_base + i];
        i = i + 1;
    }
}

transform poly_add_at(r: State<FalconBuf>, r_base: u32,
                      a: State<FalconBuf>, a_base: u32,
                      b: State<FalconBuf>, b_base: u32) {
    let i: u32 = 0;
    while i < FALCON_N {
        let av: u32 = load_u32_le_at(a, a_base + i * 4);
        let bv: u32 = load_u32_le_at(b, b_base + i * 4);
        store_u32_le_at(r, r_base + i * 4, (av + bv) % FALCON_Q);
        i = i + 1;
    }
}

transform poly_sub_at(r: State<FalconBuf>, r_base: u32,
                      a: State<FalconBuf>, a_base: u32,
                      b: State<FalconBuf>, b_base: u32) {
    let i: u32 = 0;
    while i < FALCON_N {
        let av: u32 = load_u32_le_at(a, a_base + i * 4);
        let bv: u32 = load_u32_le_at(b, b_base + i * 4);
        if av >= bv { store_u32_le_at(r, r_base + i * 4, (av - bv) % FALCON_Q); }
        else { store_u32_le_at(r, r_base + i * 4, (av + FALCON_Q - bv) % FALCON_Q); }
        i = i + 1;
    }
}

// Schoolbook polynomial multiplication: r = a * b mod (x^N + 1, q).
transform poly_mul_at(r: State<FalconBuf>, r_base: u32,
                      a: State<FalconBuf>, a_base: u32,
                      b: State<FalconBuf>, b_base: u32) {
    let temp = state_new(FalconBuf);
    poly_zero_at(temp, 0);
    let i: u32 = 0;
    while i < FALCON_N {
        let ai: u32 = load_u32_le_at(a, a_base + i * 4);
        let j: u32 = 0;
        while j < FALCON_N {
            let bj: u32 = load_u32_le_at(b, b_base + j * 4);
            let prod: u32 = (ai * bj) % FALCON_Q;
            let idx: u32 = i + j;
            if idx < FALCON_N {
                let cur: u32 = load_u32_le_at(temp, idx * 4);
                store_u32_le_at(temp, idx * 4, (cur + prod) % FALCON_Q);
            } else {
                let nidx: u32 = idx - FALCON_N;
                let cur: u32 = load_u32_le_at(temp, nidx * 4);
                if cur >= prod {
                    store_u32_le_at(temp, nidx * 4, (cur - prod) % FALCON_Q);
                } else {
                    store_u32_le_at(temp, nidx * 4, (cur + FALCON_Q - prod) % FALCON_Q);
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    poly_copy_at(r, r_base, temp, 0);
}

// Scalar modular inverse: a^(-1) mod q via Fermat's little theorem.
transform mod_inv(a: u32) -> u32 {
    let a_red: u32 = a % FALCON_Q;
    if a_red == 0 { return 0; }
    let mut_result: u32 = 1;
    let mut_base: u32 = a_red;
    let mut_exp: u32 = FALCON_Q - 2;
    while mut_exp > 0 {
        if (mut_exp & 1) == 1 {
            mut_result = (mut_result * mut_base) % FALCON_Q;
        }
        mut_exp = mut_exp >> 1;
        if mut_exp > 0 {
            mut_base = (mut_base * mut_base) % FALCON_Q;
        }
    }
    return mut_result;
}

// poly_degree: highest nonzero coefficient index. DEG_ZERO if all zero.
transform poly_degree_at(p: State<FalconBuf>, p_base: u32, max_deg: u32) -> u32 {
    let i: u32 = max_deg + 1;
    while i > 0 {
        let ii: u32 = i - 1;
        if load_u32_le_at(p, p_base + ii * 4) != 0 { return ii; }
        i = ii;
    }
    return DEG_ZERO;
}

// poly_divmod: a = q * b + r in Z_q[x]. Returns remainder degree.
transform poly_divmod_at(q_out: State<FalconBuf>, q_base: u32,
                         r_out: State<FalconBuf>, r_base: u32,
                         a: State<FalconBuf>, a_base: u32, deg_a: u32,
                         b: State<FalconBuf>, b_base: u32, deg_b: u32) -> u32 {
    if deg_a < deg_b {
        let i: u32 = 0;
        while i <= deg_a {
            store_u32_le_at(r_out, r_base + i * 4, load_u32_le_at(a, a_base + i * 4));
            i = i + 1;
        }
        store_u32_le_at(q_out, q_base, 0);
        return deg_a;
    }
    let i: u32 = 0;
    while i <= deg_a {
        store_u32_le_at(r_out, r_base + i * 4, load_u32_le_at(a, a_base + i * 4));
        i = i + 1;
    }
    let qsize: u32 = deg_a - deg_b;
    let qi: u32 = 0;
    while qi <= qsize {
        store_u32_le_at(q_out, q_base + qi * 4, 0);
        qi = qi + 1;
    }
    let b_lead: u32 = load_u32_le_at(b, b_base + deg_b * 4);
    let b_inv: u32 = mod_inv(b_lead);
    if b_inv == 0 { return DIV_ERROR; }
    let num_steps: u32 = deg_a - deg_b + 1;
    let step: u32 = 0;
    while step < num_steps {
        let idx: u32 = (deg_a - deg_b) - step;
        let ri: u32 = load_u32_le_at(r_out, r_base + (deg_b + idx) * 4);
        let qval: u32 = (ri * b_inv) % FALCON_Q;
        store_u32_le_at(q_out, q_base + idx * 4, qval);
        let j: u32 = 0;
        while j <= deg_b {
            let rj: u32 = load_u32_le_at(r_out, r_base + (idx + j) * 4);
            let bj: u32 = load_u32_le_at(b, b_base + j * 4);
            let prod: u32 = (qval * bj) % FALCON_Q;
            if rj >= prod {
                store_u32_le_at(r_out, r_base + (idx + j) * 4, (rj - prod) % FALCON_Q);
            } else {
                store_u32_le_at(r_out, r_base + (idx + j) * 4, (rj + FALCON_Q - prod) % FALCON_Q);
            }
            j = j + 1;
        }
        step = step + 1;
    }
    if deg_b == 0 { return DEG_ZERO; }
    return poly_degree_at(r_out, r_base, deg_b - 1);
}

// poly_mod_inv: f^{-1} mod (x^N + 1, q) via extended Euclidean in Z_q[x].
transform poly_mod_inv(out: State<FalconBuf>, out_base: u32,
                       f: State<FalconBuf>, f_base: u32) -> u32 {
    let deg_f: u32 = poly_degree_at(f, f_base, FALCON_N - 1);
    if deg_f == DEG_ZERO { return 0; }
    if deg_f == 0 {
        let c: u32 = load_u32_le_at(f, f_base);
        let c_inv: u32 = mod_inv(c);
        if c_inv == 0 { return 0; }
        poly_zero_at(out, out_base);
        store_u32_le_at(out, out_base, c_inv);
        return 1;
    }
    let r0 = state_new(FalconBuf);
    let r1 = state_new(FalconBuf);
    let r2 = state_new(FalconBuf);
    let s0 = state_new(FalconBuf);
    let s1 = state_new(FalconBuf);
    let s2 = state_new(FalconBuf);
    let q_poly = state_new(FalconBuf);
    let temp = state_new(FalconBuf);

    poly_zero_sized_at(r0, 0, FALCON_N + 1);
    store_u32_le_at(r0, 0, 1);
    store_u32_le_at(r0, FALCON_N * 4, 1);

    poly_zero_sized_at(r1, 0, FALCON_N + 1);
    let i: u32 = 0;
    while i < FALCON_N {
        store_u32_le_at(r1, i * 4, load_u32_le_at(f, f_base + i * 4));
        i = i + 1;
    }
    poly_zero_sized_at(s0, 0, FALCON_N + 1);
    poly_zero_sized_at(s1, 0, FALCON_N + 1);
    store_u32_le_at(s1, 0, 1);

    let mut_deg_r0: u32 = FALCON_N;
    let mut_deg_r1: u32 = deg_f;

    while mut_deg_r1 != DEG_ZERO {
        let deg_r2: u32 = poly_divmod_at(q_poly, 0, r2, 0,
                                          r0, 0, mut_deg_r0,
                                          r1, 0, mut_deg_r1);
        if deg_r2 == DIV_ERROR { return 0; }
        poly_mul_at(temp, 0, q_poly, 0, s1, 0);
        poly_sub_at(s2, 0, s0, 0, temp, 0);
        poly_copy_sized_at(r0, 0, r1, 0, FALCON_N + 1);
        poly_copy_sized_at(r1, 0, r2, 0, FALCON_N + 1);
        poly_copy_sized_at(s0, 0, s1, 0, FALCON_N + 1);
        poly_copy_sized_at(s1, 0, s2, 0, FALCON_N + 1);
        mut_deg_r0 = mut_deg_r1;
        mut_deg_r1 = deg_r2;
    }

    let mut_result: u32 = 0;
    if mut_deg_r0 == 0 {
        let c: u32 = load_u32_le_at(r0, 0);
        let c_inv: u32 = mod_inv(c);
        if c_inv != 0 {
            let k: u32 = 0;
            while k < FALCON_N {
                let si: u32 = load_u32_le_at(s0, k * 4);
                store_u32_le_at(out, out_base + k * 4, (si * c_inv) % FALCON_Q);
                k = k + 1;
            }
            mut_result = 1;
        }
    }
    return mut_result;
}

// falcon_poly_inv_mod_q: out = a^{-1} mod (x^N + 1, q).
transform falcon_poly_inv_mod_q(a: State<FalconBuf>, a_base: u32, q: u32,
                                out: State<FalconBuf>, out_base: u32) -> u32 {
    if q != FALCON_Q { return 0; }
    return poly_mod_inv(out, out_base, a, a_base);
}

// ===========================================================================
// SHAKE-256 wrapper that takes FalconBuf input/output.
// ===========================================================================

transform falcon_shake256(src: State<FalconBuf>, src_len: u32,
                          dst: State<FalconBuf>, dst_len: u32) {
    let kin = state_new(KeccakIn);
    let kout = state_new(KeccakOut);
    let ctx = state_new(KeccakCtx);
    shake256_init(ctx);
    let pos: u32 = 0;
    while pos < src_len {
        let to_copy: u32 = 200;
        let remaining: u32 = src_len - pos;
        if remaining < 200 { to_copy = remaining; }
        let k: u32 = 0;
        while k < 200 { kin.data[k] = 0; k = k + 1; }
        k = 0;
        while k < to_copy { kin.data[k] = src.bytes[pos + k]; k = k + 1; }
        shake256_update(ctx, kin, to_copy);
        pos = pos + to_copy;
    }
    shake256_squeeze(ctx, kout, dst_len);
    let k: u32 = 0;
    while k < dst_len { dst.bytes[k] = kout.data[k]; k = k + 1; }
}

// CBD-sample a polynomial from a byte buffer (1 byte per coefficient).
transform poly_sample_cbd_bytes_at(buf: State<FalconBuf>, buf_base: u32,
                                   out: State<FalconBuf>, out_base: u32) {
    let i: u32 = 0;
    while i < FALCON_N {
        let b: u32 = buf.bytes[buf_base + i] as u32;
        let a: u32 = (b & 1) + ((b >> 1) & 1);
        let bb: u32 = ((b >> 2) & 1) + ((b >> 3) & 1);
        let coef: u32;
        if a >= bb { coef = a - bb; }
        else { coef = FALCON_Q - (bb - a); }
        store_u32_le_at(out, out_base + i * 4, coef % FALCON_Q);
        i = i + 1;
    }
}

// falcon_gauss_cdt_value: CDT[k] for half-Gaussian with σ=1.278461.
transform falcon_gauss_cdt_value(k: u32) -> u32 {
    if k == 0 { return 1340761009; }
    if k == 1 { return 3316088903; }
    if k == 2 { return 4104530856; }
    if k == 3 { return 4275201240; }
    return 4294967295;
}

// falcon_gaussian_sample: draw one integer from D_Z(0, σ).
transform falcon_gaussian_sample(prng_state: State<FalconBuf>) -> i32 {
    let u_bytes = state_new(FalconBuf);
    falcon_shake256(prng_state, 64, u_bytes, 8);
    let u: u32 = load_u32_le_at(u_bytes, 0);
    let sign_byte: u32 = u_bytes.bytes[4] as u32;
    let sign: u32 = sign_byte & 1;
    let mut_k: u32 = 0;
    let mut_found: u32 = 0;
    while (mut_k < FALCON_GAUSS_MAX) & (mut_found == 0) {
        if u < falcon_gauss_cdt_value(mut_k) {
            mut_found = 1;
        } else {
            mut_k = mut_k + 1;
        }
    }
    if mut_found == 0 { mut_k = 0; }
    if mut_k == 0 { return 0; }
    if sign == 1 {
        let nk: i32 = mut_k as i32;
        return -nk;
    }
    return mut_k as i32;
}

// poly_sample_gaussian: sample FALCON_N Gaussian coefficients into out.
transform poly_sample_gaussian(seed: State<FalconBuf>, seed_base: u32,
                                counter: u32,
                                out: State<FalconBuf>, out_base: u32) {
    let seed_ext = state_new(FalconBuf);
    let i: u32 = 0;
    while i < 32 { seed_ext.bytes[i] = seed.bytes[seed_base + i]; i = i + 1; }
    seed_ext.bytes[32] = (counter & 255) as u8;
    let buf_len: u32 = FALCON_N * 8;
    let buf = state_new(FalconBuf);
    falcon_shake256(seed_ext, 33, buf, buf_len);

    let mut_pos: u32 = 0;
    let ci: u32 = 0;
    while ci < FALCON_N {
        let b0: u32 = buf.bytes[mut_pos] as u32; mut_pos = mut_pos + 1;
        if mut_pos >= buf_len { mut_pos = 0; }
        let b1: u32 = buf.bytes[mut_pos] as u32; mut_pos = mut_pos + 1;
        if mut_pos >= buf_len { mut_pos = 0; }
        let b2: u32 = buf.bytes[mut_pos] as u32; mut_pos = mut_pos + 1;
        if mut_pos >= buf_len { mut_pos = 0; }
        let b3: u32 = buf.bytes[mut_pos] as u32; mut_pos = mut_pos + 1;
        if mut_pos >= buf_len { mut_pos = 0; }
        let u: u32 = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
        let sb: u32 = buf.bytes[mut_pos] as u32; mut_pos = mut_pos + 1;
        if mut_pos >= buf_len { mut_pos = 0; }
        let sign: u32 = sb & 1;

        let mut_k: u32 = 0;
        let mut_found: u32 = 0;
        while (mut_k < FALCON_GAUSS_MAX) & (mut_found == 0) {
            if u < falcon_gauss_cdt_value(mut_k) {
                mut_found = 1;
            } else {
                mut_k = mut_k + 1;
            }
        }
        if mut_found == 0 { mut_k = 0; }

        let coef: u32;
        if mut_k > 0 {
            if sign == 1 { coef = FALCON_Q - mut_k; }
            else         { coef = mut_k; }
        } else {
            coef = 0;
        }
        store_u32_le_at(out, out_base + ci * 4, coef % FALCON_Q);
        ci = ci + 1;
    }
}

// hash_to_poly: c = CBD(SHAKE-256(msg)).
transform hash_to_poly(msg: State<FalconBuf>, msg_len: u32,
                       out: State<FalconBuf>, out_base: u32) {
    let cbd_bytes = state_new(FalconBuf);
    falcon_shake256(msg, msg_len, cbd_bytes, FALCON_N);
    poly_sample_cbd_bytes_at(cbd_bytes, 0, out, out_base);
}

// poly_norm: L2 norm of centered representation.
transform poly_norm_at(a: State<FalconBuf>, a_base: u32) -> f64 {
    let mut_sum: f64 = 0.0;
    let i: u32 = 0;
    while i < FALCON_N {
        let mut_v: u32 = load_u32_le_at(a, a_base + i * 4) % FALCON_Q;
        if mut_v > FALCON_Q / 2 { mut_v = FALCON_Q - mut_v; }
        let vf: f64 = mut_v as f64;
        mut_sum = mut_sum + vf * vf;
        i = i + 1;
    }
    return sqrt(mut_sum);
}

// falcon_compute_norm: ||s||_2^2 as u32 (saturating).
transform falcon_compute_norm(s: State<FalconBuf>, s_base: u32) -> u32 {
    let mut_sum: u64 = 0;
    let i: u32 = 0;
    while i < FALCON_N {
        let mut_v: u32 = load_u32_le_at(s, s_base + i * 4) % FALCON_Q;
        if mut_v > FALCON_Q / 2 { mut_v = FALCON_Q - mut_v; }
        let v64: u64 = mut_v as u64;
        mut_sum = mut_sum + v64 * v64;
        if mut_sum > 4294967295 { return 4294967295; }
        i = i + 1;
    }
    let result: u32 = mut_sum as u32;
    return result;
}

// poly_check_centered_inf: |center(a - b)|_inf <= bound.
transform poly_check_centered_inf(a: State<FalconBuf>, a_base: u32,
                                  b: State<FalconBuf>, b_base: u32,
                                  bound: u32) -> u32 {
    let i: u32 = 0;
    while i < FALCON_N {
        let av: u32 = load_u32_le_at(a, a_base + i * 4);
        let bv: u32 = load_u32_le_at(b, b_base + i * 4);
        let mut_diff: u32;
        if av >= bv { mut_diff = (av - bv) % FALCON_Q; }
        else { mut_diff = (av + FALCON_Q - bv) % FALCON_Q; }
        if mut_diff > FALCON_Q / 2 { mut_diff = FALCON_Q - mut_diff; }
        if mut_diff > bound { return 0; }
        i = i + 1;
    }
    return 1;
}

// ===========================================================================
// Falcon Key Generation
// ===========================================================================

transform falcon_keygen(seed: State<FalconBuf>,
                        pk: State<FalconBuf>,
                        sk: State<FalconBuf>) -> u32 {
    let f = state_new(FalconBuf);
    let g = state_new(FalconBuf);
    let f_inv = state_new(FalconBuf);
    let h = state_new(FalconBuf);

    poly_sample_gaussian(seed, 0, 0, f, 0);
    poly_sample_gaussian(seed, 0, 1, g, 0);

    let inv_ok: u32 = poly_mod_inv(f_inv, 0, f, 0);
    if inv_ok == 0 { return 0; }

    poly_mul_at(h, 0, g, 0, f_inv, 0);

    poly_copy_at(pk, 0, h, 0);
    poly_copy_at(sk, 0, f, 0);
    poly_copy_at(sk, FALCON_POLY_BYTES, g, 0);
    return 1;
}

// ===========================================================================
// falcon_bdd_sign: BDD-style rejection signer.
// ===========================================================================

transform falcon_bdd_sign(sk: State<FalconBuf>,
                           msg: State<FalconBuf>, msg_len: u32,
                           sig: State<FalconBuf>) -> u32 {
    let f_base: u32 = 0;
    let g_base: u32 = FALCON_POLY_BYTES;

    let c = state_new(FalconBuf);
    let g_inv = state_new(FalconBuf);
    let h_inv = state_new(FalconBuf);
    let s0 = state_new(FalconBuf);
    let r = state_new(FalconBuf);
    let s = state_new(FalconBuf);
    let seed32 = state_new(FalconBuf);
    let seed_in = state_new(FalconBuf);

    hash_to_poly(msg, msg_len, c, 0);

    let inv_ok: u32 = falcon_poly_inv_mod_q(sk, g_base, FALCON_Q, g_inv, 0);
    if inv_ok == 0 { return 0; }

    poly_mul_at(h_inv, 0, sk, f_base, g_inv, 0);
    poly_mul_at(s0, 0, h_inv, 0, c, 0);

    let i: u32 = 0;
    while i < 32 { seed_in.bytes[i] = sk.bytes[f_base + i]; i = i + 1; }
    let j: u32 = 0;
    while j < msg_len { seed_in.bytes[32 + j] = msg.bytes[j]; j = j + 1; }
    falcon_shake256(seed_in, 32 + msg_len, seed32, 32);

    let mut_retries: u32 = 0;
    let mut_done: u32 = 0;
    while (mut_done == 0) & (mut_retries < FALCON_BDD_MAX_RETRIES) {
        poly_sample_gaussian(seed32, 0, mut_retries, r, 0);
        poly_add_at(s, 0, s0, 0, r, 0);
        let norm_sq: u32 = falcon_compute_norm(s, 0);
        if norm_sq <= FALCON_SIG_L2_BOUND_SQ { mut_done = 1; }
        mut_retries = mut_retries + 1;
    }
    poly_copy_at(sig, 0, s, 0);
    return FALCON_SIG_BYTES;
}

// falcon_sign — wrapper around falcon_bdd_sign.
transform falcon_sign(sk: State<FalconBuf>, msg: State<FalconBuf>, msg_len: u32,
                      sig: State<FalconBuf>) -> u32 {
    return falcon_bdd_sign(sk, msg, msg_len, sig);
}

// ===========================================================================
// Falcon Verify
// ===========================================================================

transform falcon_verify(pk: State<FalconBuf>, msg: State<FalconBuf>, msg_len: u32,
                        sig: State<FalconBuf>) -> u32 {
    let h_base: u32 = 0;
    let s_base: u32 = 0;

    let c = state_new(FalconBuf);
    let t = state_new(FalconBuf);

    hash_to_poly(msg, msg_len, c, 0);
    poly_mul_at(t, 0, pk, h_base, sig, s_base);

    let snorm: f64 = poly_norm_at(sig, s_base);
    if snorm > 5000.0 { return 0; }

    if poly_check_centered_inf(t, 0, c, 0, FALCON_HASH_INF_BOUND) == 0 {
        return 0;
    }
    return 1;
}
