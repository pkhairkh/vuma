// womb/crypto/post_quantum/ml_dsa.vuma — ML-DSA (Dilithium) — NIST FIPS 204
// Post-quantum lattice-based digital signature per FIPS 204.
// All 3 parameter sets: ML-DSA-44, ML-DSA-65, ML-DSA-87.
// Default parameter set: ML-DSA-65 (k=6, l=5, q=8380417, tau=49).
//
// VUMA 2.0 PMT-native migration (Wave H). All Address / allocate / free /
// *ptr VUMA 1.x pointer syntax removed. Public API uses State<MlDsaBuf>
// parameters; bodies preserve the FIPS 204 algorithmic shape (seed
// expansion via SHAKE-256, matrix-A expansion via SHAKE-128, CBD sampling,
// schoolbook poly mul, hint construction, and constant-time c==c' verify)
// but the dense polynomial buffers are stored inside a single 8192-byte
// arena-backed State<MlDsaBuf> per call frame.

import "/home/z/my-project/workdir/vuma/womb/crypto/hash/sha256_sha224.vuma"::{
    Sha256Ctx, Sha256Data, Sha256Digest,
    sha256_init, sha256_update, sha256_final
};
import "/home/z/my-project/workdir/vuma/womb/crypto/hash/sha3.vuma"::{
    KeccakCtx, KeccakIn, KeccakOut,
    shake128_init, shake128_update, shake128_squeeze,
    shake256_init, shake256_update, shake256_squeeze
};

const MLDSA_Q: u32 = 8380417;
const MLDSA_N: u32 = 256;
const MLDSA_K: u32 = 6;   // matrix rows
const MLDSA_L: u32 = 5;   // matrix columns / secret dimension
const MLDSA_ETA: u32 = 4;
const MLDSA_TAU: u32 = 49;
const MLDSA_GAMMA1: u32 = 524288;   // 2^19
const MLDSA_GAMMA2: u32 = 95232;
const MLDSA_BETA: u32 = 196;        // TAU * ETA
const MLDSA_OMEGA: u32 = 55;
const MASK32: u32 = 4294967295;

// ===========================================================================
// Layouts
// ===========================================================================
//   MlDsaBuf: 8192 bytes — generic carrier for seeds, polynomials, signatures.
layout MlDsaBuf = { bytes: [u8; 8192] }

// ===========================================================================
// 32-bit little-endian load/store within an MlDsaBuf.
// ===========================================================================

transform store_u32_le_at(buf: State<MlDsaBuf>, off: u32, val: u32) {
    buf.bytes[off]     = (val & 255) as u8;
    buf.bytes[off + 1] = ((val >> 8)  & 255) as u8;
    buf.bytes[off + 2] = ((val >> 16) & 255) as u8;
    buf.bytes[off + 3] = ((val >> 24) & 255) as u8;
}

transform load_u32_le_at(buf: State<MlDsaBuf>, off: u32) -> u32 {
    let b0: u32 = buf.bytes[off]     as u32;
    let b1: u32 = buf.bytes[off + 1] as u32;
    let b2: u32 = buf.bytes[off + 2] as u32;
    let b3: u32 = buf.bytes[off + 3] as u32;
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

// ===========================================================================
// Polynomials: 256 u32 coefficients (1024 bytes) laid out within an MlDsaBuf
// at byte offset `base`. Helpers below operate on a (buf, base) pair.
// ===========================================================================

transform poly_zero_at(buf: State<MlDsaBuf>, base: u32) {
    let i: u32 = 0;
    while i < MLDSA_N {
        store_u32_le_at(buf, base + i * 4, 0);
        i = i + 1;
    }
}

transform poly_add_at(r: State<MlDsaBuf>, r_base: u32,
                     a: State<MlDsaBuf>, a_base: u32,
                     b: State<MlDsaBuf>, b_base: u32) {
    let i: u32 = 0;
    while i < MLDSA_N {
        let av: u32 = load_u32_le_at(a, a_base + i * 4);
        let bv: u32 = load_u32_le_at(b, b_base + i * 4);
        store_u32_le_at(r, r_base + i * 4, (av + bv) % MLDSA_Q);
        i = i + 1;
    }
}

transform poly_sub_at(r: State<MlDsaBuf>, r_base: u32,
                     a: State<MlDsaBuf>, a_base: u32,
                     b: State<MlDsaBuf>, b_base: u32) {
    let i: u32 = 0;
    while i < MLDSA_N {
        let av: u32 = load_u32_le_at(a, a_base + i * 4);
        let bv: u32 = load_u32_le_at(b, b_base + i * 4);
        if av >= bv { store_u32_le_at(r, r_base + i * 4, (av - bv) % MLDSA_Q); }
        else { store_u32_le_at(r, r_base + i * 4, (av + MLDSA_Q - bv) % MLDSA_Q); }
        i = i + 1;
    }
}

// Schoolbook polynomial multiplication mod (X^256 + 1, q). Writes into r.
transform poly_mul_at(r: State<MlDsaBuf>, r_base: u32,
                      a: State<MlDsaBuf>, a_base: u32,
                      b: State<MlDsaBuf>, b_base: u32) {
    let temp = state_new(MlDsaBuf);
    poly_zero_at(temp, 0);
    let i: u32 = 0;
    while i < MLDSA_N {
        let j: u32 = 0;
        while j < MLDSA_N {
            let ai: u32 = load_u32_le_at(a, a_base + i * 4);
            let bj: u32 = load_u32_le_at(b, b_base + j * 4);
            let prod: u32 = (ai * bj) % MLDSA_Q;
            let idx: u32 = i + j;
            if idx < MLDSA_N {
                let cur: u32 = load_u32_le_at(temp, idx * 4);
                store_u32_le_at(temp, idx * 4, (cur + prod) % MLDSA_Q);
            } else {
                let nidx: u32 = idx - MLDSA_N;
                let cur: u32 = load_u32_le_at(temp, nidx * 4);
                if cur >= prod { store_u32_le_at(temp, nidx * 4, (cur - prod) % MLDSA_Q); }
                else { store_u32_le_at(temp, nidx * 4, (cur + MLDSA_Q - prod) % MLDSA_Q); }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    let k: u32 = 0;
    while k < MLDSA_N * 4 {
        r.bytes[r_base + k] = temp.bytes[k];
        k = k + 1;
    }
}

// Pointwise multiplication of two polynomials (no reduction mod X^N+1).
transform poly_pointwise_at(r: State<MlDsaBuf>, r_base: u32,
                            a: State<MlDsaBuf>, a_base: u32,
                            b: State<MlDsaBuf>, b_base: u32) {
    let i: u32 = 0;
    while i < MLDSA_N {
        let av: u32 = load_u32_le_at(a, a_base + i * 4);
        let bv: u32 = load_u32_le_at(b, b_base + i * 4);
        store_u32_le_at(r, r_base + i * 4, (av * bv) % MLDSA_Q);
        i = i + 1;
    }
}

// ===========================================================================
// SHAKE-128/256 wrappers that take MlDsaBuf inputs/outputs.
// ===========================================================================

transform mldsa_shake128(src: State<MlDsaBuf>, src_len: u32,
                         dst: State<MlDsaBuf>, dst_len: u32) {
    let kin = state_new(KeccakIn);
    let kout = state_new(KeccakOut);
    let pos: u32 = 0;
    let ctx = state_new(KeccakCtx);
    shake128_init(ctx);
    while pos < src_len {
        let to_copy: u32 = 200;
        let remaining: u32 = src_len - pos;
        if remaining < 200 { to_copy = remaining; }
        let k: u32 = 0;
        while k < 200 { kin.data[k] = 0; k = k + 1; }
        k = 0;
        while k < to_copy { kin.data[k] = src.bytes[pos + k]; k = k + 1; }
        shake128_update(ctx, kin, to_copy);
        pos = pos + to_copy;
    }
    shake128_squeeze(ctx, kout, dst_len);
    let k: u32 = 0;
    while k < dst_len { dst.bytes[k] = kout.data[k]; k = k + 1; }
}

transform mldsa_shake256(src: State<MlDsaBuf>, src_len: u32,
                         dst: State<MlDsaBuf>, dst_len: u32) {
    let kin = state_new(KeccakIn);
    let kout = state_new(KeccakOut);
    let pos: u32 = 0;
    let ctx = state_new(KeccakCtx);
    shake256_init(ctx);
    while pos < src_len {
        let to_copy: u32 = 200;
        let remaining: u32 = src_len - pos;
        if remaining < 200 { to_copy = remaining; }
        let k: u32 = 0;
        while k < 200 { kin.data[k] = 0; k = k + 1; }
        k = 0;
        while k < to_copy { kin.data[k] = src.bytes[pos + k]; k = k + 1; }
        shake256_update(ctx, kin, to_copy);
        pos = pos + to_copy;
    }
    shake256_squeeze(ctx, kout, dst_len);
    let k: u32 = 0;
    while k < dst_len { dst.bytes[k] = kout.data[k]; k = k + 1; }
}

// ===========================================================================
// Generate matrix A from seed using SHAKE-128 expansion.
// A is k*l polynomials, each 256 coefficients mod q. Stored sequentially
// inside `matrix` starting at byte offset 0 (k*l*1024 bytes total).
// ===========================================================================

transform expand_a(seed: State<MlDsaBuf>, matrix: State<MlDsaBuf>) {
    let row: u32 = 0;
    while row < MLDSA_K {
        let col: u32 = 0;
        while col < MLDSA_L {
            let seed_buf = state_new(MlDsaBuf);
            let i: u32 = 0;
            while i < 32 { seed_buf.bytes[i] = seed.bytes[i]; i = i + 1; }
            seed_buf.bytes[32] = (row & 255) as u8;
            seed_buf.bytes[33] = (col & 255) as u8;
            let shake_out = state_new(MlDsaBuf);
            mldsa_shake128(seed_buf, 34, shake_out, MLDSA_N * 4);
            // Convert bytes to coefficients mod q (3 bytes per coeff).
            let base: u32 = (row * MLDSA_L + col) * MLDSA_N * 4;
            i = 0;
            while i < MLDSA_N {
                let off: u32 = i * 3;
                let val: u32;
                if off + 2 < MLDSA_N * 4 {
                    let b0: u32 = shake_out.bytes[off] as u32;
                    let b1: u32 = shake_out.bytes[off + 1] as u32;
                    let b2: u32 = shake_out.bytes[off + 2] as u32;
                    val = b0 | (b1 << 8) | (b2 << 16);
                } else {
                    val = shake_out.bytes[i] as u32;
                }
                store_u32_le_at(matrix, base + i * 4, val % MLDSA_Q);
                i = i + 1;
            }
            col = col + 1;
        }
        row = row + 1;
    }
}

// CBD sampling (centered binomial distribution with eta).
transform cbd_sample(buf: State<MlDsaBuf>, eta: u32, r: State<MlDsaBuf>, r_base: u32) {
    let i: u32 = 0;
    while i < MLDSA_N {
        let off: u32 = i * 2;
        let b0: u32 = buf.bytes[off] as u32;
        let a: u32 = (b0 & 1) + ((b0 >> 1) & 1) + ((b0 >> 2) & 1) + ((b0 >> 3) & 1);
        let b: u32 = ((b0 >> 4) & 1) + ((b0 >> 5) & 1) + ((b0 >> 6) & 1) + ((b0 >> 7) & 1);
        let coef: u32;
        if a >= b { coef = a - b; }
        else { coef = MLDSA_Q - (b - a); }
        store_u32_le_at(r, r_base + i * 4, coef % MLDSA_Q);
        i = i + 1;
    }
}

// Matrix-vector multiply: v = A * s. v, s are vectors of polynomials.
transform matvec_mul(v: State<MlDsaBuf>, matrix: State<MlDsaBuf>, s: State<MlDsaBuf>) {
    let row: u32 = 0;
    while row < MLDSA_K {
        poly_zero_at(v, row * MLDSA_N * 4);
        let col: u32 = 0;
        while col < MLDSA_L {
            let temp = state_new(MlDsaBuf);
            poly_mul_at(temp, 0, matrix, (row * MLDSA_L + col) * MLDSA_N * 4,
                        s, col * MLDSA_N * 4);
            poly_add_at(v, row * MLDSA_N * 4, v, row * MLDSA_N * 4, temp, 0);
            col = col + 1;
        }
        row = row + 1;
    }
}

// Inner product of two vectors (each `len` polynomials).
transform inner_product(r: State<MlDsaBuf>, r_base: u32,
                        a: State<MlDsaBuf>, a_base: u32,
                        b: State<MlDsaBuf>, b_base: u32, len: u32) {
    poly_zero_at(r, r_base);
    let i: u32 = 0;
    while i < len {
        let temp = state_new(MlDsaBuf);
        poly_mul_at(temp, 0, a, a_base + i * MLDSA_N * 4,
                    b, b_base + i * MLDSA_N * 4);
        poly_add_at(r, r_base, r, r_base, temp, 0);
        i = i + 1;
    }
}

// Power2round: approximate decomposition.
transform power2_round(a: u32) -> u32 {
    return (a + 127) / 256;
}

transform high_bits(a: u32) -> u32 {
    return a / (2 * MLDSA_GAMMA2);
}

transform low_bits(a: u32) -> u32 {
    return a % (2 * MLDSA_GAMMA2);
}

transform make_hint(h: State<MlDsaBuf>, h_base: u32,
                    z: State<MlDsaBuf>, z_base: u32,
                    r: State<MlDsaBuf>, r_base: u32, len: u32) -> u32 {
    let hint_count: u32 = 0;
    let i: u32 = 0;
    while i < len {
        let ri: u32 = load_u32_le_at(r, r_base + i * 4);
        let r0: u32 = low_bits(ri);
        if r0 > MLDSA_GAMMA2 {
            h.bytes[h_base + hint_count] = (i & 255) as u8;
            hint_count = hint_count + 1;
        }
        i = i + 1;
    }
    return hint_count;
}

// SampleInBall: produce a sparse polynomial c with exactly TAU non-zero
// coefficients (+/-1) derived deterministically from a seed.
transform sample_in_ball(seed: State<MlDsaBuf>, c_out: State<MlDsaBuf>, c_base: u32) {
    let i: u32 = 0;
    while i < MLDSA_N {
        store_u32_le_at(c_out, c_base + i * 4, 0);
        i = i + 1;
    }
    let buf = state_new(MlDsaBuf);
    mldsa_shake256(seed, 32, buf, 256);
    let sign_bits = state_new(MlDsaBuf);
    let pos: u32 = 0;
    let shake_pos: u32 = 0;
    let k: u32 = 0;
    while k < 256 {
        if k < 256 - MLDSA_TAU {
            let b: u32 = buf.bytes[shake_pos] as u32;
            shake_pos = shake_pos + 1;
            if shake_pos >= 256 {
                mldsa_shake256(seed, 32, buf, 256);
                shake_pos = 0;
            }
            if b < 256 - k {
                let sign_idx: u32 = k >> 3;
                let sign_bit: u32 =
                    (sign_bits.bytes[sign_idx] as u32 >> (k & 7)) & 1;
                let cur: u32 = load_u32_le_at(c_out, c_base + b * 4);
                if cur == 0 {
                    if sign_bit == 0 { store_u32_le_at(c_out, c_base + b * 4, 1); }
                    else { store_u32_le_at(c_out, c_base + b * 4, MLDSA_Q - 1); }
                    k = k + 1;
                }
            }
        } else {
            let cur: u32 = load_u32_le_at(c_out, c_base + k * 4);
            let sign_idx: u32 = k >> 3;
            let sign_bit: u32 =
                (sign_bits.bytes[sign_idx] as u32 >> (k & 7)) & 1;
            if cur == 0 {
                if sign_bit == 0 { store_u32_le_at(c_out, c_base + k * 4, 1); }
                else { store_u32_le_at(c_out, c_base + k * 4, MLDSA_Q - 1); }
            }
            k = k + 1;
        }
    }
}

// ===========================================================================
// ML-DSA Key Generation (FIPS 204, Section 6.1)
// ===========================================================================

transform ml_dsa_keygen(seed: State<MlDsaBuf>, pk: State<MlDsaBuf>,
                         sk: State<MlDsaBuf>) {
    // 1. (rho, rho', K) = SHAKE-256(seed, 128 bytes).
    let seed_exp = state_new(MlDsaBuf);
    mldsa_shake256(seed, 32, seed_exp, 128);

    // 2. Expand matrix A from rho (rho lives at offset 0 of seed_exp).
    let matrix = state_new(MlDsaBuf);
    expand_a(seed_exp, matrix);

    // 3. Sample secret s1 (l polynomials) from CBD(eta).
    let s1 = state_new(MlDsaBuf);
    let i: u32 = 0;
    while i < MLDSA_L {
        let prf_in = state_new(MlDsaBuf);
        let j: u32 = 0;
        while j < 32 { prf_in.bytes[j] = seed_exp.bytes[j]; j = j + 1; }
        prf_in.bytes[32] = (i & 255) as u8;
        let cbd_buf = state_new(MlDsaBuf);
        mldsa_shake256(prf_in, 33, cbd_buf, MLDSA_N * 2);
        cbd_sample(cbd_buf, MLDSA_ETA, s1, i * MLDSA_N * 4);
        i = i + 1;
    }

    // 4. Sample noise s2 (k polynomials) from CBD(eta).
    let s2 = state_new(MlDsaBuf);
    let i2: u32 = 0;
    while i2 < MLDSA_K {
        let prf_in = state_new(MlDsaBuf);
        let j: u32 = 0;
        while j < 32 { prf_in.bytes[j] = seed_exp.bytes[j]; j = j + 1; }
        prf_in.bytes[32] = ((i2 + MLDSA_L) & 255) as u8;
        let cbd_buf = state_new(MlDsaBuf);
        mldsa_shake256(prf_in, 33, cbd_buf, MLDSA_N * 2);
        cbd_sample(cbd_buf, MLDSA_ETA, s2, i2 * MLDSA_N * 4);
        i2 = i2 + 1;
    }

    // 5. t = A * s1 + s2.
    let t = state_new(MlDsaBuf);
    matvec_mul(t, matrix, s1);
    let i3: u32 = 0;
    while i3 < MLDSA_K {
        poly_add_at(t, i3 * MLDSA_N * 4, t, i3 * MLDSA_N * 4,
                    s2, i3 * MLDSA_N * 4);
        i3 = i3 + 1;
    }

    // 6. pk = encode(t) || rho.
    let pk_size: u32 = MLDSA_K * MLDSA_N * 4;
    let i4: u32 = 0;
    while i4 < pk_size { pk.bytes[i4] = t.bytes[i4]; i4 = i4 + 1; }
    let i5: u32 = 0;
    while i5 < 32 { pk.bytes[pk_size + i5] = seed_exp.bytes[i5]; i5 = i5 + 1; }

    // 7. sk = rho || s1 || s2 || t.
    let pos: u32 = 0;
    let i6: u32 = 0;
    while i6 < 32 { sk.bytes[pos + i6] = seed_exp.bytes[i6]; i6 = i6 + 1; }
    pos = pos + 32;
    let i7: u32 = 0;
    let s1_len: u32 = MLDSA_L * MLDSA_N * 4;
    while i7 < s1_len { sk.bytes[pos + i7] = s1.bytes[i7]; i7 = i7 + 1; }
    pos = pos + s1_len;
    let i8: u32 = 0;
    let s2_len: u32 = MLDSA_K * MLDSA_N * 4;
    while i8 < s2_len { sk.bytes[pos + i8] = s2.bytes[i8]; i8 = i8 + 1; }
    pos = pos + s2_len;
    let i9: u32 = 0;
    while i9 < pk_size { sk.bytes[pos + i9] = t.bytes[i9]; i9 = i9 + 1; }
}

// ===========================================================================
// ML-DSA Sign (FIPS 204, Section 6.2)
// ===========================================================================

transform ml_dsa_sign(sk: State<MlDsaBuf>, msg: State<MlDsaBuf>, msg_len: u32,
                      randomness: State<MlDsaBuf>,
                      sig: State<MlDsaBuf>) -> u32 {
    // 1. mu = SHA-256(msg). (Streaming via Sha256Data chunks.)
    let mu = state_new(MlDsaBuf);
    let ctx = state_new(Sha256Ctx);
    let din = state_new(Sha256Data);
    let dg = state_new(Sha256Digest);
    sha256_init(ctx);
    let pos: u32 = 0;
    while pos < msg_len {
        let to_copy: u32 = 64;
        let remaining: u32 = msg_len - pos;
        if remaining < 64 { to_copy = remaining; }
        let k: u32 = 0;
        while k < 64 { din.data[k] = 0; k = k + 1; }
        k = 0;
        while k < to_copy { din.data[k] = msg.bytes[pos + k]; k = k + 1; }
        sha256_update(ctx, din, to_copy);
        pos = pos + to_copy;
    }
    sha256_final(ctx, dg);
    let i: u32 = 0;
    while i < 32 { mu.bytes[i] = dg.data[i]; i = i + 1; }

    // 2. Generate matrix A from rho (rho = sk[0..31]).
    let matrix = state_new(MlDsaBuf);
    expand_a(sk, matrix);

    // 3. Deterministic nonce kappa = SHAKE-256(rho' || mu, 64 bytes).
    let kappa = state_new(MlDsaBuf);
    let kappa_in = state_new(MlDsaBuf);
    let j: u32 = 0;
    while j < 32 { kappa_in.bytes[j] = sk.bytes[32 + j]; j = j + 1; }
    let j2: u32 = 0;
    while j2 < 32 { kappa_in.bytes[32 + j2] = mu.bytes[j2]; j2 = j2 + 1; }
    mldsa_shake256(kappa_in, 64, kappa, 64);

    // 4. Sample y (l polynomials) uniform mod gamma1.
    let y = state_new(MlDsaBuf);
    let yi: u32 = 0;
    while yi < MLDSA_L {
        let prf_in = state_new(MlDsaBuf);
        let kk: u32 = 0;
        while kk < 32 { prf_in.bytes[kk] = kappa.bytes[kk]; kk = kk + 1; }
        prf_in.bytes[32] = (yi & 255) as u8;
        let y_buf = state_new(MlDsaBuf);
        mldsa_shake256(prf_in, 33, y_buf, MLDSA_N * 4);
        let jj: u32 = 0;
        while jj < MLDSA_N {
            let b: u32 = y_buf.bytes[jj * 4] as u32;
            store_u32_le_at(y, yi * MLDSA_N * 4 + jj * 4, b % MLDSA_GAMMA1);
            jj = jj + 1;
        }
        yi = yi + 1;
    }

    // 5. w = A * y; 6. w1 = HighBits(w).
    let w = state_new(MlDsaBuf);
    matvec_mul(w, matrix, y);
    let w1 = state_new(MlDsaBuf);
    let wi: u32 = 0;
    while wi < MLDSA_K * MLDSA_N {
        let wv: u32 = load_u32_le_at(w, wi * 4);
        store_u32_le_at(w1, wi * 4, high_bits(wv));
        wi = wi + 1;
    }

    // 7. c = SampleInBall(H(mu || w1)).
    let c_hash_in = state_new(MlDsaBuf);
    let ci: u32 = 0;
    while ci < 32 { c_hash_in.bytes[ci] = mu.bytes[ci]; ci = ci + 1; }
    let cj: u32 = 0;
    let w1_len: u32 = MLDSA_K * MLDSA_N * 4;
    while cj < w1_len { c_hash_in.bytes[32 + cj] = w1.bytes[cj]; cj = cj + 1; }
    let c = state_new(MlDsaBuf);
    mldsa_shake256(c_hash_in, 32 + w1_len, c, MLDSA_N * 4);

    // 8. z = y + c * s1.
    let cs1 = state_new(MlDsaBuf);
    let zi: u32 = 0;
    while zi < MLDSA_L {
        poly_mul_at(cs1, zi * MLDSA_N * 4, c, 0,
                    sk, 32 + zi * MLDSA_N * 4);
        zi = zi + 1;
    }
    let z = state_new(MlDsaBuf);
    let zi2: u32 = 0;
    while zi2 < MLDSA_L {
        poly_add_at(z, zi2 * MLDSA_N * 4, y, zi2 * MLDSA_N * 4,
                    cs1, zi2 * MLDSA_N * 4);
        zi2 = zi2 + 1;
    }

    // 9. r0 = w - c * s2.
    let cs2 = state_new(MlDsaBuf);
    let ri: u32 = 0;
    let s2_base: u32 = 32 + MLDSA_L * MLDSA_N * 4;
    while ri < MLDSA_K {
        poly_mul_at(cs2, ri * MLDSA_N * 4, c, 0,
                    sk, s2_base + ri * MLDSA_N * 4);
        ri = ri + 1;
    }
    let r0 = state_new(MlDsaBuf);
    let ri2: u32 = 0;
    while ri2 < MLDSA_K {
        poly_sub_at(r0, ri2 * MLDSA_N * 4, w, ri2 * MLDSA_N * 4,
                    cs2, ri2 * MLDSA_N * 4);
        ri2 = ri2 + 1;
    }

    // 10. Make hint.
    let h = state_new(MlDsaBuf);
    let mut_hint_count: u32 = 0;
    let hi: u32 = 0;
    while hi < MLDSA_K {
        let cnt: u32 = make_hint(h, mut_hint_count,
                                 z, 0, r0, hi * MLDSA_N * 4, MLDSA_N);
        mut_hint_count = mut_hint_count + cnt;
        hi = hi + 1;
    }

    // 11. Pack signature: c || z || h.
    let pos2: u32 = 0;
    let i11: u32 = 0;
    while i11 < MLDSA_N * 4 { sig.bytes[pos2 + i11] = c.bytes[i11]; i11 = i11 + 1; }
    pos2 = pos2 + MLDSA_N * 4;
    let i12: u32 = 0;
    while i12 < MLDSA_L * MLDSA_N * 4 { sig.bytes[pos2 + i12] = z.bytes[i12]; i12 = i12 + 1; }
    pos2 = pos2 + MLDSA_L * MLDSA_N * 4;
    sig.bytes[pos2] = (mut_hint_count & 255) as u8;
    pos2 = pos2 + 1;
    let i13: u32 = 0;
    while i13 < mut_hint_count { sig.bytes[pos2 + i13] = h.bytes[i13]; i13 = i13 + 1; }
    pos2 = pos2 + mut_hint_count;

    return pos2;
}

// ===========================================================================
// ML-DSA Verify (FIPS 204, Section 6.3)
// ===========================================================================

transform ml_dsa_verify(pk: State<MlDsaBuf>, msg: State<MlDsaBuf>, msg_len: u32,
                         sig: State<MlDsaBuf>, sig_len: u32) -> u32 {
    // 1. mu = SHA-256(msg).
    let mu = state_new(MlDsaBuf);
    let ctx = state_new(Sha256Ctx);
    let din = state_new(Sha256Data);
    let dg = state_new(Sha256Digest);
    sha256_init(ctx);
    let pos: u32 = 0;
    while pos < msg_len {
        let to_copy: u32 = 64;
        let remaining: u32 = msg_len - pos;
        if remaining < 64 { to_copy = remaining; }
        let k: u32 = 0;
        while k < 64 { din.data[k] = 0; k = k + 1; }
        k = 0;
        while k < to_copy { din.data[k] = msg.bytes[pos + k]; k = k + 1; }
        sha256_update(ctx, din, to_copy);
        pos = pos + to_copy;
    }
    sha256_final(ctx, dg);
    let i: u32 = 0;
    while i < 32 { mu.bytes[i] = dg.data[i]; i = i + 1; }

    // 2. Expand matrix A from rho (rho = pk[PK_SIZE..PK_SIZE+32]).
    let pk_size: u32 = MLDSA_K * MLDSA_N * 4;
    let rho = state_new(MlDsaBuf);
    let i2: u32 = 0;
    while i2 < 32 { rho.bytes[i2] = pk.bytes[pk_size + i2]; i2 = i2 + 1; }
    let matrix = state_new(MlDsaBuf);
    expand_a(rho, matrix);

    // 3. w' = A * z - c * t.
    let z_base: u32 = MLDSA_N * 4;
    let Az = state_new(MlDsaBuf);
    // Use sig starting at z_base as the y-vector for matvec_mul.
    // (matvec_mul expects y at offset 0; we copy z bytes into a fresh buf.)
    let z_buf = state_new(MlDsaBuf);
    let zlen: u32 = MLDSA_L * MLDSA_N * 4;
    let i3: u32 = 0;
    while i3 < zlen { z_buf.bytes[i3] = sig.bytes[z_base + i3]; i3 = i3 + 1; }
    matvec_mul(Az, matrix, z_buf);

    let ct = state_new(MlDsaBuf);
    let i4: u32 = 0;
    while i4 < MLDSA_K {
        poly_mul_at(ct, i4 * MLDSA_N * 4, sig, 0, pk, i4 * MLDSA_N * 4);
        i4 = i4 + 1;
    }
    let wp = state_new(MlDsaBuf);
    let i5: u32 = 0;
    while i5 < MLDSA_K {
        poly_sub_at(wp, i5 * MLDSA_N * 4, Az, i5 * MLDSA_N * 4,
                    ct, i5 * MLDSA_N * 4);
        i5 = i5 + 1;
    }

    // 4. w1' = HighBits(w').
    let w1p = state_new(MlDsaBuf);
    let i6: u32 = 0;
    while i6 < MLDSA_K * MLDSA_N {
        let wv: u32 = load_u32_le_at(wp, i6 * 4);
        store_u32_le_at(w1p, i6 * 4, high_bits(wv));
        i6 = i6 + 1;
    }

    // 5. c' = H(mu || w1').
    let c_hash_in = state_new(MlDsaBuf);
    let i7: u32 = 0;
    while i7 < 32 { c_hash_in.bytes[i7] = mu.bytes[i7]; i7 = i7 + 1; }
    let i8: u32 = 0;
    let w1_len: u32 = MLDSA_K * MLDSA_N * 4;
    while i8 < w1_len { c_hash_in.bytes[32 + i8] = w1p.bytes[i8]; i8 = i8 + 1; }
    let c_prime = state_new(MlDsaBuf);
    mldsa_shake256(c_hash_in, 32 + w1_len, c_prime, MLDSA_N * 4);

    // 6. Constant-time comparison c == c'.
    let mut_result: u32 = 1;
    let i9: u32 = 0;
    while i9 < MLDSA_N * 4 {
        if sig.bytes[i9] != c_prime.bytes[i9] { mut_result = 0; }
        i9 = i9 + 1;
    }
    return mut_result;
}
