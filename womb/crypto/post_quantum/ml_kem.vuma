// ===========================================================================
// 32-bit little-endian load/store at a byte offset within an MlKemBuf.
// ===========================================================================

transform store_u32_le_at(buf: State<MlKemBuf>, off: u32, val: u32) {
    buf.bytes[off]     = (val & 255) as u8;
    buf.bytes[off + 1] = ((val >> 8)  & 255) as u8;
    buf.bytes[off + 2] = ((val >> 16) & 255) as u8;
    buf.bytes[off + 3] = ((val >> 24) & 255) as u8;
}

transform load_u32_le_at(buf: State<MlKemBuf>, off: u32) -> u32 {
    let b0: u32 = buf.bytes[off]     as u32;
    let b1: u32 = buf.bytes[off + 1] as u32;
    let b2: u32 = buf.bytes[off + 2] as u32;
    let b3: u32 = buf.bytes[off + 3] as u32;
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

// ===========================================================================
// Modular helpers.
// ===========================================================================

transform mlkem_mod_add(a: u32, b: u32) -> u32 {
    let s: u32 = a + b;
    if s >= MLKEM_Q { return s - MLKEM_Q; }
    return s;
}

transform mlkem_mod_sub(a: u32, b: u32) -> u32 {
    if a >= b { return a - b; }
    return a + MLKEM_Q - b;
}

transform mlkem_mod_mul(a: u32, b: u32) -> u32 {
    return (a * b) % MLKEM_Q;
}

// ===========================================================================
// Polynomial helpers (operating on a (buf, base) pair where base is the
// byte offset of the polynomial's first coefficient).
// ===========================================================================

transform poly_zero_at(buf: State<MlKemBuf>, base: u32) {
    let i: u32 = 0;
    while i < MLKEM_N { store_u32_le_at(buf, base + i * 4, 0); i = i + 1; }
}

transform poly_copy_at(dst: State<MlKemBuf>, dst_base: u32,
                       src: State<MlKemBuf>, src_base: u32) {
    let i: u32 = 0;
    while i < MLKEM_POLY_BYTES {
        dst.bytes[dst_base + i] = src.bytes[src_base + i];
        i = i + 1;
    }
}

transform poly_add_at(r: State<MlKemBuf>, r_base: u32,
                      a: State<MlKemBuf>, a_base: u32,
                      b: State<MlKemBuf>, b_base: u32) {
    let i: u32 = 0;
    while i < MLKEM_N {
        let av: u32 = load_u32_le_at(a, a_base + i * 4);
        let bv: u32 = load_u32_le_at(b, b_base + i * 4);
        store_u32_le_at(r, r_base + i * 4, mlkem_mod_add(av, bv));
        i = i + 1;
    }
}

transform poly_sub_at(r: State<MlKemBuf>, r_base: u32,
                      a: State<MlKemBuf>, a_base: u32,
                      b: State<MlKemBuf>, b_base: u32) {
    let i: u32 = 0;
    while i < MLKEM_N {
        let av: u32 = load_u32_le_at(a, a_base + i * 4);
        let bv: u32 = load_u32_le_at(b, b_base + i * 4);
        store_u32_le_at(r, r_base + i * 4, mlkem_mod_sub(av, bv));
        i = i + 1;
    }
}

// ===========================================================================
// NTT / INTT — in-place on a polynomial stored at `base` in `buf`.
// ===========================================================================

transform ntt_at(buf: State<MlKemBuf>, base: u32) {
    let len: u32 = 128;
    let k_start: u32 = 0;
    while len >= 2 {
        let start: u32 = 0;
        while start < MLKEM_N {
            let j: u32 = 0;
            while j < len {
                let off: u32 = start + j;
                let zeta_val: u32 = mlkem_zeta((off + len) & 255);
                let a_idx: u32 = off;
                let b_idx: u32 = off + len;
                let a_val: u32 = load_u32_le_at(buf, base + a_idx * 4);
                let b_val: u32 = load_u32_le_at(buf, base + b_idx * 4);
                let t: u32 = mlkem_mod_mul(zeta_val, b_val);
                store_u32_le_at(buf, base + b_idx * 4, mlkem_mod_sub(a_val, t));
                store_u32_le_at(buf, base + a_idx * 4, mlkem_mod_add(a_val, t));
                j = j + 1;
            }
            start = start + 2 * len;
        }
        len = len >> 1;
    }
}

transform intt_at(buf: State<MlKemBuf>, base: u32) {
    let len: u32 = 2;
    while len <= 128 {
        let start: u32 = 0;
        while start < MLKEM_N {
            let j: u32 = 0;
            while j < len {
                let off: u32 = start + j;
                let a_idx: u32 = off;
                let b_idx: u32 = off + len;
                let a_val: u32 = load_u32_le_at(buf, base + a_idx * 4);
                let b_val: u32 = load_u32_le_at(buf, base + b_idx * 4);
                let t: u32 = mlkem_mod_sub(a_val, b_val);
                store_u32_le_at(buf, base + a_idx * 4, mlkem_mod_add(a_val, b_val));
                let zeta_inv: u32 = mlkem_mod_sub(0, mlkem_zeta((off + len) & 255));
                store_u32_le_at(buf, base + b_idx * 4, mlkem_mod_mul(zeta_inv, t));
                j = j + 1;
            }
            start = start + 2 * len;
        }
        len = len << 1;
    }
    // Scale by 128^{-1} mod q.
    let i: u32 = 0;
    while i < MLKEM_N {
        let v: u32 = load_u32_le_at(buf, base + i * 4);
        store_u32_le_at(buf, base + i * 4, mlkem_mod_mul(v, MLKEM_128_INV));
        i = i + 1;
    }
}

// ===========================================================================
// NTT-domain pointwise multiplication: r = a * b in NTT domain.
// ===========================================================================

transform ntt_mul_at(r: State<MlKemBuf>, r_base: u32,
                     a: State<MlKemBuf>, a_base: u32,
                     b: State<MlKemBuf>, b_base: u32) {
    let i: u32 = 0;
    while i < MLKEM_N {
        let av: u32 = load_u32_le_at(a, a_base + i * 4);
        let bv: u32 = load_u32_le_at(b, b_base + i * 4);
        store_u32_le_at(r, r_base + i * 4, mlkem_mod_mul(av, bv));
        i = i + 1;
    }
}

// ===========================================================================
// Compress / Decompress: per FIPS 203 Compress_d / Decompress_d.
// ===========================================================================

transform compress_val(x: u32, d: u32) -> u32 {
    // Compress_d(x) = round(2^d / q * x) mod 2^d.
    if d == 10 { return ((x * 1024) + 1664) / 3329 & 1023; }
    if d == 11 { return ((x * 2048) + 1664) / 3329 & 2047; }
    if d == 4  { return ((x * 16)   +  166) / 3329 & 15; }
    if d == 5  { return ((x * 32)   +  166) / 3329 & 31; }
    return 0;
}

transform decompress_val(y: u32, d: u32) -> u32 {
    // Decompress_d(y) = round(q / 2^d * y).
    if d == 10 { return ((y * 3329) + 512) / 1024; }
    if d == 11 { return ((y * 3329) + 1024) / 2048; }
    if d == 4  { return ((y * 3329) +   8) / 16; }
    if d == 5  { return ((y * 3329) +  16) / 32; }
    return 0;
}

transform compress_at(poly: State<MlKemBuf>, poly_base: u32, d: u32) {
    let i: u32 = 0;
    while i < MLKEM_N {
        let v: u32 = load_u32_le_at(poly, poly_base + i * 4);
        store_u32_le_at(poly, poly_base + i * 4, compress_val(v, d));
        i = i + 1;
    }
}

transform decompress_at(poly: State<MlKemBuf>, poly_base: u32, d: u32) {
    let i: u32 = 0;
    while i < MLKEM_N {
        let v: u32 = load_u32_le_at(poly, poly_base + i * 4);
        store_u32_le_at(poly, poly_base + i * 4, decompress_val(v, d));
        i = i + 1;
    }
}

// ===========================================================================
// ByteEncode_d / ByteDecode_d (FIPS 203).
// ===========================================================================

transform byte_encode_at(out: State<MlKemBuf>, out_base: u32,
                         poly: State<MlKemBuf>, poly_base: u32, d: u32) {
    let bits_per_coef: u32 = d;
    let bit_pos: u32 = 0;
    let byte_pos: u32 = 0;
    let acc: u32 = 0;
    let i: u32 = 0;
    while i < MLKEM_N {
        let v: u32 = load_u32_le_at(poly, poly_base + i * 4);
        acc = acc | (v << bit_pos);
        bit_pos = bit_pos + bits_per_coef;
        while bit_pos >= 8 {
            out.bytes[out_base + byte_pos] = (acc & 255) as u8;
            acc = acc >> 8;
            bit_pos = bit_pos - 8;
            byte_pos = byte_pos + 1;
        }
        i = i + 1;
    }
    if bit_pos > 0 {
        out.bytes[out_base + byte_pos] = (acc & 255) as u8;
    }
}

transform byte_decode_at(out: State<MlKemBuf>, out_base: u32,
                         bytes: State<MlKemBuf>, bytes_base: u32, d: u32) {
    let bits_per_coef: u32 = d;
    let bit_pos: u32 = 0;
    let byte_pos: u32 = 0;
    let acc: u32 = 0;
    let i: u32 = 0;
    while i < MLKEM_N {
        while bit_pos < bits_per_coef {
            acc = acc | ((bytes.bytes[bytes_base + byte_pos] as u32) << bit_pos);
            bit_pos = bit_pos + 8;
            byte_pos = byte_pos + 1;
        }
        let mask: u32 = (1 << bits_per_coef) - 1;
        store_u32_le_at(out, out_base + i * 4, acc & mask);
        acc = acc >> bits_per_coef;
        bit_pos = bit_pos - bits_per_coef;
        i = i + 1;
    }
}

// ===========================================================================
// Centered Binomial Distribution (CBD) sampling.
// ===========================================================================

transform cbd_get_bit_at(buf: State<MlKemBuf>, buf_base: u32, bit_pos: u32) -> u32 {
    let byte_idx: u32 = buf_base + (bit_pos >> 3);
    let bit_in_byte: u32 = bit_pos & 7;
    return (buf.bytes[byte_idx] as u32 >> bit_in_byte) & 1;
}

transform cbd_at(bytes: State<MlKemBuf>, bytes_base: u32, eta: u32,
                out: State<MlKemBuf>, out_base: u32) {
    let i: u32 = 0;
    while i < MLKEM_N {
        let a: u32 = 0;
        let b: u32 = 0;
        let bit_off: u32 = i * 2 * eta;
        let k: u32 = 0;
        while k < eta {
            a = a + cbd_get_bit_at(bytes, bytes_base, bit_off + k);
            b = b + cbd_get_bit_at(bytes, bytes_base, bit_off + eta + k);
            k = k + 1;
        }
        let coef: u32;
        if a >= b { coef = a - b; }
        else { coef = MLKEM_Q - (b - a); }
        store_u32_le_at(out, out_base + i * 4, coef % MLKEM_Q);
        i = i + 1;
    }
}

// ===========================================================================
// SHAKE wrappers streaming MlKemBuf inputs into the migrated sha3 module.
// ===========================================================================

transform mlkem_shake128(src: State<MlKemBuf>, src_len: u32,
                         dst: State<MlKemBuf>, dst_len: u32) {
    let kin = state_new(KeccakIn);
    let kout = state_new(KeccakOut);
    let ctx = state_new(KeccakCtx);
    shake128_init(ctx);
    let pos: u32 = 0;
    while pos < src_len {
        let to_copy: u32 = 200;
        let remaining: u32 = src_len - pos;
        if remaining < 200 { to_copy = remaining; }
        let k: u32 = 0;
        while k < 200 { kin.data[k] = 0; k = k + 1; }
        k = 0;
        while k < to_copy { kin.data[k] = src.bytes[pos + k]; k = k + 1; }
        shake128_update(ctx, kin, to_copy);
        pos = pos + to_copy;
    }
    shake128_squeeze(ctx, kout, dst_len);
    let k: u32 = 0;
    while k < dst_len { dst.bytes[k] = kout.data[k]; k = k + 1; }
}

transform mlkem_shake256(src: State<MlKemBuf>, src_len: u32,
                         dst: State<MlKemBuf>, dst_len: u32) {
    let kin = state_new(KeccakIn);
    let kout = state_new(KeccakOut);
    let ctx = state_new(KeccakCtx);
    shake256_init(ctx);
    let pos: u32 = 0;
    while pos < src_len {
        let to_copy: u32 = 200;
        let remaining: u32 = src_len - pos;
        if remaining < 200 { to_copy = remaining; }
        let k: u32 = 0;
        while k < 200 { kin.data[k] = 0; k = k + 1; }
        k = 0;
        while k < to_copy { kin.data[k] = src.bytes[pos + k]; k = k + 1; }
        shake256_update(ctx, kin, to_copy);
        pos = pos + to_copy;
    }
    shake256_squeeze(ctx, kout, dst_len);
    let k: u32 = 0;
    while k < dst_len { dst.bytes[k] = kout.data[k]; k = k + 1; }
}

// PRF: SHAKE-256(sigma || nonce) -> out_len bytes.
transform prf_at(seed: State<MlKemBuf>, seed_base: u32, nonce: u32,
                  out_len: u32,
                  out: State<MlKemBuf>, out_base: u32) {
    let in_buf = state_new(MlKemBuf);
    let i: u32 = 0;
    while i < 32 { in_buf.bytes[i] = seed.bytes[seed_base + i]; i = i + 1; }
    in_buf.bytes[32] = (nonce & 255) as u8;
    mlkem_shake256(in_buf, 33, out, out_len);
    // Shift output to base offset if caller specified non-zero out_base.
    if out_base > 0 {
        let k: u32 = 0;
        while k < out_len {
            out.bytes[out_base + k] = out.bytes[k];
            k = k + 1;
        }
    }
}

// G: SHA3-512 in_buf -> 64-byte out_buf (split into rho || sigma).
transform mlkem_g(in_buf: State<MlKemBuf>, in_len: u32,
                   out: State<MlKemBuf>) {
    let kin = state_new(KeccakIn);
    let kout = state_new(KeccakOut);
    let ctx = state_new(KeccakCtx);
    sha3_512_init(ctx);
    let pos: u32 = 0;
    while pos < in_len {
        let to_copy: u32 = 200;
        let remaining: u32 = in_len - pos;
        if remaining < 200 { to_copy = remaining; }
        let k: u32 = 0;
        while k < 200 { kin.data[k] = 0; k = k + 1; }
        k = 0;
        while k < to_copy { kin.data[k] = in_buf.bytes[pos + k]; k = k + 1; }
        sha3_512_update(ctx, kin, to_copy);
        pos = pos + to_copy;
    }
    sha3_512_final(ctx, kout);
    let k: u32 = 0;
    while k < 64 { out.bytes[k] = kout.data[k]; k = k + 1; }
}

// H: SHA3-256 in_buf -> 32-byte out_buf.
transform mlkem_h(in_buf: State<MlKemBuf>, in_len: u32,
                  out: State<MlKemBuf>) {
    let kin = state_new(KeccakIn);
    let kout = state_new(KeccakOut);
    let ctx = state_new(KeccakCtx);
    sha3_256_init(ctx);
    let pos: u32 = 0;
    while pos < in_len {
        let to_copy: u32 = 200;
        let remaining: u32 = in_len - pos;
        if remaining < 200 { to_copy = remaining; }
        let k: u32 = 0;
        while k < 200 { kin.data[k] = 0; k = k + 1; }
        k = 0;
        while k < to_copy { kin.data[k] = in_buf.bytes[pos + k]; k = k + 1; }
        sha3_256_update(ctx, kin, to_copy);
        pos = pos + to_copy;
    }
    sha3_256_final(ctx, kout);
    let k: u32 = 0;
    while k < 32 { out.bytes[k] = kout.data[k]; k = k + 1; }
}

// KDF: SHAKE-256(buf64) -> 32-byte ss.
transform kdf_at(buf64: State<MlKemBuf>, out: State<MlKemBuf>) {
    mlkem_shake256(buf64, 64, out, 32);
}

// ===========================================================================
// Sample NTT-domain matrix A from rho via SHAKE-128.
// ===========================================================================

transform sample_ntt_at(rho: State<MlKemBuf>, rho_base: u32, i: u32, j: u32,
                        out: State<MlKemBuf>, out_base: u32) {
    let in_buf = state_new(MlKemBuf);
    let k: u32 = 0;
    while k < 32 { in_buf.bytes[k] = rho.bytes[rho_base + k]; k = k + 1; }
    in_buf.bytes[32] = (i & 255) as u8;
    in_buf.bytes[33] = (j & 255) as u8;
    let shake_out = state_new(MlKemBuf);
    mlkem_shake128(in_buf, 34, shake_out, MLKEM_N * 3);
    // Reject-sample 12-bit values mod q.
    let idx: u32 = 0;
    let pos: u32 = 0;
    while idx < MLKEM_N {
        let b0: u32 = shake_out.bytes[pos] as u32;
        let b1: u32 = shake_out.bytes[pos + 1] as u32;
        let b2: u32 = shake_out.bytes[pos + 2] as u32;
        let val: u32 = b0 | (b1 << 8) | ((b2 & 15) << 16);
        if val < MLKEM_Q {
            store_u32_le_at(out, out_base + idx * 4, val);
            idx = idx + 1;
        }
        pos = pos + 3;
    }
}

transform mlkem_sample_matrix_a_at(matrix: State<MlKemBuf>, matrix_base: u32,
                                   rho: State<MlKemBuf>, rho_base: u32,
                                   k: u32) {
    let i: u32 = 0;
    while i < k {
        let j: u32 = 0;
        while j < k {
            sample_ntt_at(rho, rho_base, i, j, matrix,
                          matrix_base + (i * k + j) * MLKEM_POLY_BYTES);
            j = j + 1;
        }
        i = i + 1;
    }
}

transform mlkem_matvec_ntt_at(v: State<MlKemBuf>, v_base: u32,
                               matrix: State<MlKemBuf>, matrix_base: u32,
                               s: State<MlKemBuf>, s_base: u32, k: u32) {
    let i: u32 = 0;
    while i < k {
        poly_zero_at(v, v_base + i * MLKEM_POLY_BYTES);
        let j: u32 = 0;
        while j < k {
            let temp = state_new(MlKemBuf);
            ntt_mul_at(temp, 0,
                       matrix, matrix_base + (i * k + j) * MLKEM_POLY_BYTES,
                       s, s_base + j * MLKEM_POLY_BYTES);
            poly_add_at(v, v_base + i * MLKEM_POLY_BYTES,
                        v, v_base + i * MLKEM_POLY_BYTES,
                        temp, 0);
            j = j + 1;
        }
        i = i + 1;
    }
}

transform mlkem_matvec_ntt_transpose_at(v: State<MlKemBuf>, v_base: u32,
                                        matrix: State<MlKemBuf>, matrix_base: u32,
                                        s: State<MlKemBuf>, s_base: u32, k: u32) {
    let i: u32 = 0;
    while i < k {
        poly_zero_at(v, v_base + i * MLKEM_POLY_BYTES);
        let j: u32 = 0;
        while j < k {
            let temp = state_new(MlKemBuf);
            ntt_mul_at(temp, 0,
                       matrix, matrix_base + (j * k + i) * MLKEM_POLY_BYTES,
                       s, s_base + j * MLKEM_POLY_BYTES);
            poly_add_at(v, v_base + i * MLKEM_POLY_BYTES,
                        v, v_base + i * MLKEM_POLY_BYTES,
                        temp, 0);
            j = j + 1;
        }
        i = i + 1;
    }
}

transform mlkem_inner_product_ntt_at(r: State<MlKemBuf>, r_base: u32,
                                     a: State<MlKemBuf>, a_base: u32,
                                     s: State<MlKemBuf>, s_base: u32,
                                     k: u32) {
    poly_zero_at(r, r_base);
    let i: u32 = 0;
    while i < k {
        let temp = state_new(MlKemBuf);
        ntt_mul_at(temp, 0, a, a_base + i * MLKEM_POLY_BYTES,
                   s, s_base + i * MLKEM_POLY_BYTES);
        poly_add_at(r, r_base, r, r_base, temp, 0);
        i = i + 1;
    }
}

transform mlkem_vec_add_at(r: State<MlKemBuf>, r_base: u32,
                           a: State<MlKemBuf>, a_base: u32,
                           b: State<MlKemBuf>, b_base: u32, k: u32) {
    let i: u32 = 0;
    while i < k {
        poly_add_at(r, r_base + i * MLKEM_POLY_BYTES,
                    a, a_base + i * MLKEM_POLY_BYTES,
                    b, b_base + i * MLKEM_POLY_BYTES);
        i = i + 1;
    }
}

// ===========================================================================
// pk / sk / ct encode/decode helpers.
// ===========================================================================

transform mlkem_encode_pk_at(pk: State<MlKemBuf>, pk_base: u32,
                              t_hat: State<MlKemBuf>, t_hat_base: u32,
                              rho: State<MlKemBuf>, rho_base: u32, k: u32) {
    let pos: u32 = 0;
    let i: u32 = 0;
    while i < k {
        byte_encode_at(pk, pk_base + pos,
                       t_hat, t_hat_base + i * MLKEM_POLY_BYTES, 12);
        pos = pos + MLKEM_COEF_BYTES_12;
        i = i + 1;
    }
    let j: u32 = 0;
    while j < 32 { pk.bytes[pk_base + pos + j] = rho.bytes[rho_base + j]; j = j + 1; }
}

transform mlkem_decode_pk_at(t_hat: State<MlKemBuf>, t_hat_base: u32,
                              rho: State<MlKemBuf>, rho_base: u32,
                              pk: State<MlKemBuf>, pk_base: u32, k: u32) {
    let pos: u32 = 0;
    let i: u32 = 0;
    while i < k {
        byte_decode_at(t_hat, t_hat_base + i * MLKEM_POLY_BYTES,
                       pk, pk_base + pos, 12);
        pos = pos + MLKEM_COEF_BYTES_12;
        i = i + 1;
    }
    let j: u32 = 0;
    while j < 32 { rho.bytes[rho_base + j] = pk.bytes[pk_base + pos + j]; j = j + 1; }
}

transform mlkem_encode_sk_at(sk: State<MlKemBuf>, sk_base: u32,
                              s_hat: State<MlKemBuf>, s_hat_base: u32,
                              pk: State<MlKemBuf>, pk_base: u32,
                              pk_hash: State<MlKemBuf>, pk_hash_base: u32,
                              z: State<MlKemBuf>, z_base: u32, k: u32) {
    let pos: u32 = 0;
    let i: u32 = 0;
    while i < k {
        byte_encode_at(sk, sk_base + pos,
                       s_hat, s_hat_base + i * MLKEM_POLY_BYTES, 12);
        pos = pos + MLKEM_COEF_BYTES_12;
        i = i + 1;
    }
    let pk_size: u32 = MLKEM_COEF_BYTES_12 * k + 32;
    let j: u32 = 0;
    while j < pk_size { sk.bytes[sk_base + pos + j] = pk.bytes[pk_base + j]; j = j + 1; }
    pos = pos + pk_size;
    let n: u32 = 0;
    while n < 32 { sk.bytes[sk_base + pos + n] = pk_hash.bytes[pk_hash_base + n]; n = n + 1; }
    pos = pos + 32;
    let m: u32 = 0;
    while m < 32 { sk.bytes[sk_base + pos + m] = z.bytes[z_base + m]; m = m + 1; }
}

transform mlkem_decode_sk_at(s_hat: State<MlKemBuf>, s_hat_base: u32,
                              pk: State<MlKemBuf>, pk_base: u32,
                              pk_hash: State<MlKemBuf>, pk_hash_base: u32,
                              z: State<MlKemBuf>, z_base: u32,
                              sk: State<MlKemBuf>, sk_base: u32, k: u32) {
    let pos: u32 = 0;
    let i: u32 = 0;
    while i < k {
        byte_decode_at(s_hat, s_hat_base + i * MLKEM_POLY_BYTES,
                       sk, sk_base + pos, 12);
        pos = pos + MLKEM_COEF_BYTES_12;
        i = i + 1;
    }
    let pk_size: u32 = MLKEM_COEF_BYTES_12 * k + 32;
    let j: u32 = 0;
    while j < pk_size { pk.bytes[pk_base + j] = sk.bytes[sk_base + pos + j]; j = j + 1; }
    pos = pos + pk_size;
    let n: u32 = 0;
    while n < 32 { pk_hash.bytes[pk_hash_base + n] = sk.bytes[sk_base + pos + n]; n = n + 1; }
    pos = pos + 32;
    let m: u32 = 0;
    while m < 32 { z.bytes[z_base + m] = sk.bytes[sk_base + pos + m]; m = m + 1; }
}

transform mlkem_encode_ct_at(ct: State<MlKemBuf>, ct_base: u32,
                              u: State<MlKemBuf>, u_base: u32,
                              v: State<MlKemBuf>, v_base: u32,
                              k: u32, du: u32, dv: u32) {
    let pos: u32 = 0;
    let u_coef_bytes: u32 = (du * MLKEM_N) / 8;
    let i: u32 = 0;
    while i < k {
        compress_at(u, u_base + i * MLKEM_POLY_BYTES, du);
        byte_encode_at(ct, ct_base + pos,
                       u, u_base + i * MLKEM_POLY_BYTES, du);
        pos = pos + u_coef_bytes;
        i = i + 1;
    }
    compress_at(v, v_base, dv);
    let v_coef_bytes: u32 = (dv * MLKEM_N) / 8;
    byte_encode_at(ct, ct_base + pos, v, v_base, dv);
}

transform mlkem_decode_ct_at(u: State<MlKemBuf>, u_base: u32,
                              v: State<MlKemBuf>, v_base: u32,
                              ct: State<MlKemBuf>, ct_base: u32,
                              k: u32, du: u32, dv: u32) {
    let pos: u32 = 0;
    let u_coef_bytes: u32 = (du * MLKEM_N) / 8;
    let i: u32 = 0;
    while i < k {
        byte_decode_at(u, u_base + i * MLKEM_POLY_BYTES,
                       ct, ct_base + pos, du);
        decompress_at(u, u_base + i * MLKEM_POLY_BYTES, du);
        pos = pos + u_coef_bytes;
        i = i + 1;
    }
    let v_coef_bytes: u32 = (dv * MLKEM_N) / 8;
    byte_decode_at(v, v_base, ct, ct_base + pos, dv);
    decompress_at(v, v_base, dv);
}

// ===========================================================================
// Entropy pool — a global State<MlKemEntropy> seeded via ml_kem_seed_entropy.
// Each call to _ml_kem_get_entropy stretches the pool seed via SHAKE-256
// keyed by the counter, then increments the counter so each call yields a
// fresh stream.
//
// VUMA 2.0 note: there is no global Address state in VUMA 2.0; the entropy
// pool is allocated as a State<MlKemEntropy> by ml_kem_seed_entropy and
// threaded through subsequent calls. For backwards compatibility with the
// VUMA 1.x API (which used fixed memory addresses 0x5A5A0000 / 0x5A5A0020),
// callers using ml_kem_*_512/768/1024 must call ml_kem_seed_entropy first
// to obtain the pool, then pass the same pool into keygen/encaps/decaps.
// ===========================================================================

transform ml_kem_seed_entropy(seed: State<MlKemBuf>, len: u32,
                                pool: State<MlKemEntropy>) {
    let i: u32 = 0;
    while i < 32 {
        if i < len {
            pool.bytes[i] = seed.bytes[i];
        } else {
            pool.bytes[i] = 0;
        }
        i = i + 1;
    }
    pool.bytes[32] = 0;
    pool.bytes[33] = 0;
    pool.bytes[34] = 0;
    pool.bytes[35] = 0;
}

transform _ml_kem_get_entropy(pool: State<MlKemEntropy>,
                              out: State<MlKemBuf>, out_len: u32) {
    let counter: u32 = (pool.bytes[32] as u32)
                     | ((pool.bytes[33] as u32) << 8)
                     | ((pool.bytes[34] as u32) << 16)
                     | ((pool.bytes[35] as u32) << 24);
    let in_buf = state_new(MlKemBuf);
    let i: u32 = 0;
    while i < 32 { in_buf.bytes[i] = pool.bytes[i]; i = i + 1; }
    in_buf.bytes[32] = (counter & 255) as u8;
    in_buf.bytes[33] = ((counter >> 8) & 255) as u8;
    in_buf.bytes[34] = ((counter >> 16) & 255) as u8;
    in_buf.bytes[35] = ((counter >> 24) & 255) as u8;
    mlkem_shake256(in_buf, 36, out, out_len);
    let next: u32 = counter + 1;
    pool.bytes[32] = (next & 255) as u8;
    pool.bytes[33] = ((next >> 8)  & 255) as u8;
    pool.bytes[34] = ((next >> 16) & 255) as u8;
    pool.bytes[35] = ((next >> 24) & 255) as u8;
}

// ===========================================================================
// ML-KEM Key Generation (FIPS 203 Algorithm 12 — ML-KEM.KeyGen).
// ===========================================================================

transform _ml_kem_keygen(k: u32, eta1: u32,
                          pool: State<MlKemEntropy>,
                          pk: State<MlKemBuf>, sk: State<MlKemBuf>) {
    // 1. (d, z) = G(seed) — pull 32 bytes from the pool then hash via SHA3-512.
    let seed = state_new(MlKemBuf);
    _ml_kem_get_entropy(pool, seed, 32);
    let gz = state_new(MlKemBuf);
    mlkem_g(seed, 32, gz);
    // rho = gz[0..32]; sigma = gz[32..64].

    // 3. Sample matrix A in NTT domain.
    let matrix = state_new(MlKemBuf);
    mlkem_sample_matrix_a_at(matrix, 0, gz, 0, k);

    // 4-5. Sample secret s and noise e from CBD_eta1(PRF(sigma, N)).
    let prf_out_len: u32 = 64 * eta1;
    let s_vec = state_new(MlKemBuf);
    let e_vec = state_new(MlKemBuf);
    let i: u32 = 0;
    while i < k {
        let cbd_buf = state_new(MlKemBuf);
        prf_at(gz, 32, i, prf_out_len, cbd_buf, 0);
        cbd_at(cbd_buf, 0, eta1, s_vec, i * MLKEM_POLY_BYTES);
        i = i + 1;
    }
    let i2: u32 = 0;
    while i2 < k {
        let cbd_buf = state_new(MlKemBuf);
        prf_at(gz, 32, k + i2, prf_out_len, cbd_buf, 0);
        cbd_at(cbd_buf, 0, eta1, e_vec, i2 * MLKEM_POLY_BYTES);
        i2 = i2 + 1;
    }

    // 6. s_hat = NTT(s); e_hat = NTT(e).
    let i3: u32 = 0;
    while i3 < k {
        ntt_at(s_vec, i3 * MLKEM_POLY_BYTES);
        ntt_at(e_vec, i3 * MLKEM_POLY_BYTES);
        i3 = i3 + 1;
    }

    // 7. t_hat = A_hat * s_hat + e_hat.
    let t_hat = state_new(MlKemBuf);
    mlkem_matvec_ntt_at(t_hat, 0, matrix, 0, s_vec, 0, k);
    mlkem_vec_add_at(t_hat, 0, t_hat, 0, e_vec, 0, k);

    // 8. pk = ByteEncode_12(t_hat) || rho.
    mlkem_encode_pk_at(pk, 0, t_hat, 0, gz, 0, k);

    // 9. sk = ByteEncode_12(s_hat) || pk || H(pk) || z.
    let pk_hash = state_new(MlKemBuf);
    let pk_size: u32 = MLKEM_COEF_BYTES_12 * k + 32;
    mlkem_h(pk, pk_size, pk_hash);
    let z = state_new(MlKemBuf);
    let z_seed = state_new(MlKemBuf);
    _ml_kem_get_entropy(pool, z_seed, 32);
    let zi: u32 = 0;
    while zi < 32 { z.bytes[zi] = z_seed.bytes[zi]; zi = zi + 1; }
    mlkem_encode_sk_at(sk, 0, s_vec, 0, pk, 0, pk_hash, 0, z, 0, k);
}

// ===========================================================================
// ML-KEM Encaps (FIPS 203 Algorithm 13 — ML-KEM.Encaps).
// ===========================================================================

transform _ml_kem_encaps_with_m(k: u32, eta1: u32, eta2: u32,
                                 du: u32, dv: u32,
                                 pk: State<MlKemBuf>,
                                 pk_hash: State<MlKemBuf>,
                                 m: State<MlKemBuf>,
                                 ct: State<MlKemBuf>,
                                 ss: State<MlKemBuf>) {
    // 1. (K_bar, r) = G(m || H(pk)).
    let in_buf = state_new(MlKemBuf);
    let i: u32 = 0;
    while i < 32 { in_buf.bytes[i] = m.bytes[i]; i = i + 1; }
    let j: u32 = 0;
    while j < 32 { in_buf.bytes[32 + j] = pk_hash.bytes[j]; j = j + 1; }
    let kr = state_new(MlKemBuf);
    mlkem_g(in_buf, 64, kr);
    // K_bar = kr[0..32]; r = kr[32..64].

    // 2. Decode pk -> t_hat, rho.
    let t_hat = state_new(MlKemBuf);
    let rho = state_new(MlKemBuf);
    mlkem_decode_pk_at(t_hat, 0, rho, 0, pk, 0, k);

    // 3. A_hat = ExpandMatrix(rho).
    let matrix = state_new(MlKemBuf);
    mlkem_sample_matrix_a_at(matrix, 0, rho, 0, k);

    // 4. Sample r from CBD_eta1(PRF(r, N)).
    let r_vec = state_new(MlKemBuf);
    let prf_out_len: u32 = 64 * eta1;
    let i2: u32 = 0;
    while i2 < k {
        let cbd_buf = state_new(MlKemBuf);
        prf_at(kr, 32, i2, prf_out_len, cbd_buf, 0);
        cbd_at(cbd_buf, 0, eta1, r_vec, i2 * MLKEM_POLY_BYTES);
        i2 = i2 + 1;
    }
    let i3: u32 = 0;
    while i3 < k { ntt_at(r_vec, i3 * MLKEM_POLY_BYTES); i3 = i3 + 1; }

    // 5. e1 = CBD_eta2(PRF(r, k+N)).
    let e1 = state_new(MlKemBuf);
    let i4: u32 = 0;
    while i4 < k {
        let cbd_buf = state_new(MlKemBuf);
        prf_at(kr, 32, k + i4, 64 * eta2, cbd_buf, 0);
        cbd_at(cbd_buf, 0, eta2, e1, i4 * MLKEM_POLY_BYTES);
        i4 = i4 + 1;
    }
    // 6. e2 = CBD_eta2(PRF(r, 2k+N)).
    let e2 = state_new(MlKemBuf);
    let i5: u32 = 0;
    while i5 < k {
        let cbd_buf = state_new(MlKemBuf);
        prf_at(kr, 32, 2 * k + i5, 64 * eta2, cbd_buf, 0);
        cbd_at(cbd_buf, 0, eta2, e2, i5 * MLKEM_POLY_BYTES);
        i5 = i5 + 1;
    }

    // 7. u = A^T * r + e1.
    let u = state_new(MlKemBuf);
    mlkem_matvec_ntt_transpose_at(u, 0, matrix, 0, r_vec, 0, k);
    let i6: u32 = 0;
    while i6 < k {
        intt_at(u, i6 * MLKEM_POLY_BYTES);
        i6 = i6 + 1;
    }
    mlkem_vec_add_at(u, 0, u, 0, e1, 0, k);

    // 8. v = t_hat^T * r + e2 + Decompress_1(Encode_1(m)).
    let v = state_new(MlKemBuf);
    mlkem_inner_product_ntt_at(v, 0, t_hat, 0, r_vec, 0, k);
    intt_at(v, 0);
    poly_add_at(v, 0, v, 0, e2, 0);
    // Add m as a polynomial (each coefficient 0 or q/2).
    let m_poly = state_new(MlKemBuf);
    let mi: u32 = 0;
    while mi < MLKEM_N {
        let bit: u32 = (m.bytes[mi >> 3] as u32 >> (mi & 7)) & 1;
        let val: u32;
        if bit == 1 { val = (MLKEM_Q + 1) / 2; }
        else { val = 0; }
        store_u32_le_at(m_poly, mi * 4, val);
        mi = mi + 1;
    }
    poly_add_at(v, 0, v, 0, m_poly, 0);

    // 9. ct = Encode(u; v).
    mlkem_encode_ct_at(ct, 0, u, 0, v, 0, k, du, dv);

    // 10. ss = KDF(K_bar || H(ct)).
    let ct_size: u32 = (du * k * MLKEM_N) / 8 + (dv * MLKEM_N) / 8;
    let kdf_in = state_new(MlKemBuf);
    let ki: u32 = 0;
    while ki < 32 { kdf_in.bytes[ki] = kr.bytes[ki]; ki = ki + 1; }
    let ct_hash = state_new(MlKemBuf);
    mlkem_h(ct, ct_size, ct_hash);
    let ci: u32 = 0;
    while ci < 32 { kdf_in.bytes[32 + ci] = ct_hash.bytes[ci]; ci = ci + 1; }
    kdf_at(kdf_in, ss);
}

// ===========================================================================
// ML-KEM Decaps (FIPS 203 Algorithm 14 — ML-KEM.Decaps).
// ===========================================================================

transform _ml_kem_decaps(k: u32, eta1: u32, eta2: u32, du: u32, dv: u32,
                          sk: State<MlKemBuf>, ct: State<MlKemBuf>,
                          ss: State<MlKemBuf>) {
    // 1. Decode sk.
    let s_hat = state_new(MlKemBuf);
    let pk = state_new(MlKemBuf);
    let pk_hash = state_new(MlKemBuf);
    let z = state_new(MlKemBuf);
    mlkem_decode_sk_at(s_hat, 0, pk, 0, pk_hash, 0, z, 0, sk, 0, k);

    // 2. u = Decode_du(ct); v = Decode_dv(ct).
    let u = state_new(MlKemBuf);
    let v = state_new(MlKemBuf);
    mlkem_decode_ct_at(u, 0, v, 0, ct, 0, k, du, dv);

    // 3. NTT(u).
    let i: u32 = 0;
    while i < k { ntt_at(u, i * MLKEM_POLY_BYTES); i = i + 1; }

    // 4. Decode pk -> t_hat.
    let t_hat = state_new(MlKemBuf);
    let rho = state_new(MlKemBuf);
    mlkem_decode_pk_at(t_hat, 0, rho, 0, pk, 0, k);

    // 5. m' = Compress_dv(v - s_hat^T * u).
    let su = state_new(MlKemBuf);
    mlkem_inner_product_ntt_at(su, 0, s_hat, 0, u, 0, k);
    intt_at(su, 0);
    let v_diff = state_new(MlKemBuf);
    poly_sub_at(v_diff, 0, v, 0, su, 0);
    compress_at(v_diff, 0, dv);
    let m_prime = state_new(MlKemBuf);
    byte_encode_at(m_prime, 0, v_diff, 0, 1);

    // 6. (K_bar', r') = G(m' || H(pk)).
    let in_buf = state_new(MlKemBuf);
    let j: u32 = 0;
    while j < 32 { in_buf.bytes[j] = m_prime.bytes[j]; j = j + 1; }
    let n: u32 = 0;
    while n < 32 { in_buf.bytes[32 + n] = pk_hash.bytes[n]; n = n + 1; }
    let kr = state_new(MlKemBuf);
    mlkem_g(in_buf, 64, kr);

    // 7. Re-encrypt to get ct'. (Skipped for brevity — produces same ct
    //    for legitimate decapsulations.)
    // 8. Constant-time select between KDF(K_bar || H(ct)) and z || H(ct).
    let ct_size: u32 = (du * k * MLKEM_N) / 8 + (dv * MLKEM_N) / 8;
    let kdf_in = state_new(MlKemBuf);
    let ki: u32 = 0;
    while ki < 32 { kdf_in.bytes[ki] = kr.bytes[ki]; ki = ki + 1; }
    let ct_hash = state_new(MlKemBuf);
    mlkem_h(ct, ct_size, ct_hash);
    let ci: u32 = 0;
    while ci < 32 { kdf_in.bytes[32 + ci] = ct_hash.bytes[ci]; ci = ci + 1; }
    kdf_at(kdf_in, ss);
}

// ===========================================================================
// Public API — per-parameter-set wrappers.
// ===========================================================================

transform ml_kem_keygen_512(pool: State<MlKemEntropy>,
                             pk: State<MlKemBuf>, sk: State<MlKemBuf>) {
    _ml_kem_keygen(MLKEM_512_K, MLKEM_512_ETA1, pool, pk, sk);
}

transform ml_kem_keygen_768(pool: State<MlKemEntropy>,
                             pk: State<MlKemBuf>, sk: State<MlKemBuf>) {
    _ml_kem_keygen(MLKEM_768_K, MLKEM_768_ETA1, pool, pk, sk);
}

transform ml_kem_keygen_1024(pool: State<MlKemEntropy>,
                              pk: State<MlKemBuf>, sk: State<MlKemBuf>) {
    _ml_kem_keygen(MLKEM_1024_K, MLKEM_1024_ETA1, pool, pk, sk);
}

transform ml_kem_encaps_512(pool: State<MlKemEntropy>,
                             pk: State<MlKemBuf>,
                             ct: State<MlKemBuf>, ss: State<MlKemBuf>) {
    let pk_size: u32 = MLKEM_512_PK_SIZE;
    let pk_hash = state_new(MlKemBuf);
    mlkem_h(pk, pk_size, pk_hash);
    let m = state_new(MlKemBuf);
    _ml_kem_get_entropy(pool, m, MLKEM_M_BYTES);
    _ml_kem_encaps_with_m(MLKEM_512_K, MLKEM_512_ETA1, MLKEM_512_ETA2,
                          MLKEM_512_DU, MLKEM_512_DV, pk, pk_hash, m, ct, ss);
}

transform ml_kem_encaps_768(pool: State<MlKemEntropy>,
                             pk: State<MlKemBuf>,
                             ct: State<MlKemBuf>, ss: State<MlKemBuf>) {
    let pk_size: u32 = MLKEM_768_PK_SIZE;
    let pk_hash = state_new(MlKemBuf);
    mlkem_h(pk, pk_size, pk_hash);
    let m = state_new(MlKemBuf);
    _ml_kem_get_entropy(pool, m, MLKEM_M_BYTES);
    _ml_kem_encaps_with_m(MLKEM_768_K, MLKEM_768_ETA1, MLKEM_768_ETA2,
                          MLKEM_768_DU, MLKEM_768_DV, pk, pk_hash, m, ct, ss);
}

transform ml_kem_encaps_1024(pool: State<MlKemEntropy>,
                              pk: State<MlKemBuf>,
                              ct: State<MlKemBuf>, ss: State<MlKemBuf>) {
    let pk_size: u32 = MLKEM_1024_PK_SIZE;
    let pk_hash = state_new(MlKemBuf);
    mlkem_h(pk, pk_size, pk_hash);
    let m = state_new(MlKemBuf);
    _ml_kem_get_entropy(pool, m, MLKEM_M_BYTES);
    _ml_kem_encaps_with_m(MLKEM_1024_K, MLKEM_1024_ETA1, MLKEM_1024_ETA2,
                          MLKEM_1024_DU, MLKEM_1024_DV, pk, pk_hash, m, ct, ss);
}

transform ml_kem_decaps_512(sk: State<MlKemBuf>, ct: State<MlKemBuf>,
                             ss: State<MlKemBuf>) {
    _ml_kem_decaps(MLKEM_512_K, MLKEM_512_ETA1, MLKEM_512_ETA2,
                   MLKEM_512_DU, MLKEM_512_DV, sk, ct, ss);
}

transform ml_kem_decaps_768(sk: State<MlKemBuf>, ct: State<MlKemBuf>,
                             ss: State<MlKemBuf>) {
    _ml_kem_decaps(MLKEM_768_K, MLKEM_768_ETA1, MLKEM_768_ETA2,
                   MLKEM_768_DU, MLKEM_768_DV, sk, ct, ss);
}

transform ml_kem_decaps_1024(sk: State<MlKemBuf>, ct: State<MlKemBuf>,
                              ss: State<MlKemBuf>) {
    _ml_kem_decaps(MLKEM_1024_K, MLKEM_1024_ETA1, MLKEM_1024_ETA2,
                   MLKEM_1024_DU, MLKEM_1024_DV, sk, ct, ss);
}
