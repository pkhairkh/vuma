    if k == 22 { return 2596; }
    if k == 23 { return 2742; }
    if k == 24 { return 3236; }
    if k == 25 { return 2645; }
    if k == 26 { return 690; }
    if k == 27 { return 2641; }
    if k == 28 { return 1464; }
    if k == 29 { return 910; }
    if k == 30 { return 3314; }
    if k == 31 { return 3254; }
