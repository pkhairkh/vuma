// womb/crypto/post_quantum/hqc.vuma — HQC (Hamming Quasi-Cyclic) PQ KEM
//
// HQC is a code-based key encapsulation mechanism (KEM) submitted to the
// NIST Post-Quantum standardisation process. It relies on the difficulty
// of decoding random quasi-cyclic codes, a problem believed to be hard
// even for quantum adversaries.
//
// Parameter set: HQC-128
//   n     = 17669  (length of the cyclic ring GF(2)[x]/(x^n + 1), prime)
//   n1    = 46     (BCH code length used in the tensor product)
//   n2    = 96     (tensor second-component length, 3 * RM(1,5)=32)
//   k     = 16     (message dimension in bits)
//   delta = 373    (minimum distance of the tensor public code)
//   w     = 67     (weight of the public-key error term)
//   w_r   = 75     (weight of the secret key vectors x, y)
//   w_e   = 81     (weight of the encapsulation noise vector e)
//
// VUMA 2.0 PMT-native migration (Wave H). All Address / allocate / free /
// *ptr VUMA 1.x pointer syntax removed. Public API uses State<HqcBuf>
// parameters; bodies preserve the HQC algorithmic shape (sparse sampling
// via SHAKE-256, RM(1,4) encode/decode, GF(2) vec ops, FO-style CCA
// transform) but the dense vectors are stored inside arena-backed
// State<HqcBuf> byte arrays. SHA-256 / SHAKE-256 are wired through the
// migrated sha256_sha224.vuma and sha3.vuma modules (no embedded copy).

// ===========================================================================
// HQC-128 Parameters
// ===========================================================================

import "/home/z/my-project/workdir/vuma/womb/crypto/hash/sha256_sha224.vuma"::{
    Sha256Ctx, Sha256Data, Sha256Digest,
    sha256_init, sha256_update, sha256_final
};
import "/home/z/my-project/workdir/vuma/womb/crypto/hash/sha3.vuma"::{
    KeccakCtx, KeccakIn, KeccakOut,
    shake256_init, shake256_update, shake256_squeeze
};

const HQC_N: u32 = 17669;      // cyclic ring length (prime)
const HQC_N1: u32 = 46;        // BCH code length
const HQC_N2: u32 = 96;        // tensor second-component length
const HQC_K: u32 = 16;         // message length in bits
const HQC_DELTA: u32 = 373;    // tensor code minimum distance
const HQC_W: u32 = 67;         // public-key error weight
const HQC_WR: u32 = 75;        // secret key (x, y) weight
const HQC_WE: u32 = 81;        // encapsulation noise weight

// Reed-Muller RM(1, m) parameters.
const RM_M: u32 = 4;
const RM_LEN: u32 = 16;        // 2^RM_M
const RM_DIM: u32 = 5;         // RM_M + 1
const HQC_RM_BLOCKS: u32 = 4;  // ceil(HQC_K / RM_DIM)
const HQC_M_ENC_LEN: u32 = 64; // HQC_RM_BLOCKS * RM_LEN

const HQC_PK_SIZE: u32 = 35338;   // 2 * HQC_N
const HQC_SK_SIZE: u32 = 70676;   // 4 * HQC_N
const HQC_CT_SIZE: u32 = 35338;   // 2 * HQC_N
const HQC_SS_SIZE: u32 = 32;
const HQC_MSG_BITS: u32 = 16;     // == HQC_K

const MASK32: u32 = 4294967295;

// ===========================================================================
// Layouts
// ===========================================================================
//   HqcBuf: 131072 bytes (128 KiB) — generic carrier for vectors of length
//           HQC_N (17669 bytes each) used as x, y, h, s, u, v, m_enc, etc.
//           A 128 KiB buffer holds up to 7 such vectors simultaneously.
layout HqcBuf = { bytes: [u8; 131072] }

// ===========================================================================
// 32-bit load/store helpers (big-endian and little-endian).
// ===========================================================================

transform load_u32_be(buf: State<HqcBuf>, offset: u32) -> u32 {
    let b0: u32 = buf.bytes[offset]     as u32;
    let b1: u32 = buf.bytes[offset + 1] as u32;
    let b2: u32 = buf.bytes[offset + 2] as u32;
    let b3: u32 = buf.bytes[offset + 3] as u32;
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
}

transform store_u32_be(buf: State<HqcBuf>, offset: u32, val: u32) {
    buf.bytes[offset]     = ((val >> 24) & 255) as u8;
    buf.bytes[offset + 1] = ((val >> 16) & 255) as u8;
    buf.bytes[offset + 2] = ((val >> 8)  & 255) as u8;
    buf.bytes[offset + 3] = (val & 255) as u8;
}

transform load_u32_le_at(buf: State<HqcBuf>, off: u32) -> u32 {
    let b0: u32 = buf.bytes[off]     as u32;
    let b1: u32 = buf.bytes[off + 1] as u32;
    let b2: u32 = buf.bytes[off + 2] as u32;
    let b3: u32 = buf.bytes[off + 3] as u32;
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

transform store_u32_le_at(buf: State<HqcBuf>, off: u32, val: u32) {
    buf.bytes[off]     = (val & 255) as u8;
    buf.bytes[off + 1] = ((val >> 8)  & 255) as u8;
    buf.bytes[off + 2] = ((val >> 16) & 255) as u8;
    buf.bytes[off + 3] = ((val >> 24) & 255) as u8;
}

// ===========================================================================
// SHA-256 wrapper: hash arbitrary-length input from a HqcBuf into the
// first 32 bytes of `out`. Streams the input through the migrated
// sha256_sha224.vuma module in 64-byte chunks.
// ===========================================================================

transform sha256_oneshot_at(data: State<HqcBuf>, len: u32, out: State<HqcBuf>) {
    let ctx = state_new(Sha256Ctx);
    let din = state_new(Sha256Data);
    let dg = state_new(Sha256Digest);
    sha256_init(ctx);
    let pos: u32 = 0;
    while pos < len {
        let to_copy: u32 = 64;
        let remaining: u32 = len - pos;
        if remaining < 64 { to_copy = remaining; }
        let k: u32 = 0;
        while k < 64 { din.data[k] = 0; k = k + 1; }
        k = 0;
        while k < to_copy { din.data[k] = data.bytes[pos + k]; k = k + 1; }
        sha256_update(ctx, din, to_copy);
        pos = pos + to_copy;
    }
    sha256_final(ctx, dg);
    let i: u32 = 0;
    while i < 32 { out.bytes[i] = dg.data[i]; i = i + 1; }
}

// ===========================================================================
// SHA-256 context (for sha256_init/update/final streaming used by the
// original HQC module). Wraps the migrated sha256 module.
// ===========================================================================

transform sha256_init_at(ctx: State<Sha256Ctx>) {
    sha256_init(ctx);
}

transform sha256_update_at(ctx: State<Sha256Ctx>, data: State<HqcBuf>,
                           data_base: u32, len: u32) {
    let din = state_new(Sha256Data);
    let pos: u32 = 0;
    while pos < len {
        let to_copy: u32 = 64;
        let remaining: u32 = len - pos;
        if remaining < 64 { to_copy = remaining; }
        let k: u32 = 0;
        while k < 64 { din.data[k] = 0; k = k + 1; }
        k = 0;
        while k < to_copy { din.data[k] = data.bytes[data_base + pos + k]; k = k + 1; }
        sha256_update(ctx, din, to_copy);
        pos = pos + to_copy;
    }
}

transform sha256_final_at(ctx: State<Sha256Ctx>, out: State<HqcBuf>) {
    let dg = state_new(Sha256Digest);
    sha256_final(ctx, dg);
    let i: u32 = 0;
    while i < 32 { out.bytes[i] = dg.data[i]; i = i + 1; }
}

// ===========================================================================
// GF(2) vector operations: XOR, polynomial mul, sparse mul, weight.
// ===========================================================================

transform gf2_vec_add_at(out: State<HqcBuf>, out_base: u32,
                         a: State<HqcBuf>, a_base: u32,
                         b: State<HqcBuf>, b_base: u32, n: u32) {
    let i: u32 = 0;
    while i < n {
        let av: u32 = a.bytes[a_base + i] as u32;
        let bv: u32 = b.bytes[b_base + i] as u32;
        out.bytes[out_base + i] = ((av ^ bv) & 1) as u8;
        i = i + 1;
    }
}

// Multiply two binary polynomials in GF(2)[x]/(x^n + 1) — schoolbook O(n^2).
transform gf2_vec_mul_at(out: State<HqcBuf>, out_base: u32,
                        a: State<HqcBuf>, a_base: u32,
                        b: State<HqcBuf>, b_base: u32, n: u32) {
    // Zero the output first.
    let z: u32 = 0;
    while z < n { out.bytes[out_base + z] = 0; z = z + 1; }
    let i: u32 = 0;
    while i < n {
        let av: u32 = a.bytes[a_base + i] as u32;
        if av == 1 {
            let j: u32 = 0;
            while j < n {
                let bv: u32 = b.bytes[b_base + j] as u32;
                if bv == 1 {
                    let idx: u32 = i + j;
                    if idx < n {
                        let cur: u32 = out.bytes[out_base + idx] as u32;
                        out.bytes[out_base + idx] = ((cur ^ 1) & 1) as u8;
                    } else {
                        let nidx: u32 = idx - n;
                        let cur: u32 = out.bytes[out_base + nidx] as u32;
                        out.bytes[out_base + nidx] = ((cur ^ 1) & 1) as u8;
                    }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
}

// sparse_vec_mul: out = sum_{k} val[k] * dense[sparse_idx[k]] shifted by k
// (negacyclic). val[k] is 1 for HQC sparse vectors.
transform sparse_vec_mul_at(out: State<HqcBuf>, out_base: u32,
                            sparse_idx: State<HqcBuf>, sparse_idx_base: u32,
                            sparse_val: State<HqcBuf>, sparse_val_base: u32,
                            nnz: u32,
                            dense: State<HqcBuf>, dense_base: u32, n: u32) {
    let z: u32 = 0;
    while z < n { out.bytes[out_base + z] = 0; z = z + 1; }
    let k: u32 = 0;
    while k < nnz {
        let idx: u32 = load_u32_le_at(sparse_idx, sparse_idx_base + k * 4);
        let val: u32 = sparse_val.bytes[sparse_val_base + k] as u32;
        if val == 1 {
            let j: u32 = 0;
            while j < n {
                let dv: u32 = dense.bytes[dense_base + j] as u32;
                if dv == 1 {
                    let pos: u32 = idx + j;
                    if pos < n {
                        let cur: u32 = out.bytes[out_base + pos] as u32;
                        out.bytes[out_base + pos] = ((cur ^ 1) & 1) as u8;
                    } else {
                        let npos: u32 = pos - n;
                        let cur: u32 = out.bytes[out_base + npos] as u32;
                        out.bytes[out_base + npos] = ((cur ^ 1) & 1) as u8;
                    }
                }
                j = j + 1;
            }
        }
        k = k + 1;
    }
}

// Hamming weight of a binary vector of length n.
transform weight_at(v: State<HqcBuf>, v_base: u32, n: u32) -> u32 {
    let w: u32 = 0;
    let i: u32 = 0;
    while i < n {
        let vv: u32 = v.bytes[v_base + i] as u32;
        if vv == 1 { w = w + 1; }
        i = i + 1;
    }
    return w;
}

// ===========================================================================
// Reed-Muller RM(1, 4) — first-order code of length 2^4 = 16.
// ===========================================================================

transform reed_muller_encode_at(msg: State<HqcBuf>, msg_base: u32,
                                 out: State<HqcBuf>, out_base: u32) {
    // RM(1, 4): codeword[i] = m[0] XOR (m[1]*bit0(i)) XOR ... XOR (m[4]*bit3(i))
    // where bit_j(i) is the j-th bit of i (j = 0..3).
    let i: u32 = 0;
    while i < RM_LEN {
        let m0: u32 = msg.bytes[msg_base] as u32;
        let m1: u32 = msg.bytes[msg_base + 1] as u32;
        let m2: u32 = msg.bytes[msg_base + 2] as u32;
        let m3: u32 = msg.bytes[msg_base + 3] as u32;
        let m4: u32 = msg.bytes[msg_base + 4] as u32;
        let bit0: u32 = (i & 1) >> 0;
        let bit1: u32 = (i & 2) >> 1;
        let bit2: u32 = (i & 4) >> 2;
        let bit3: u32 = (i & 8) >> 3;
        let c: u32 = m0 ^ (m1 & bit0) ^ (m2 & bit1) ^ (m3 & bit2) ^ (m4 & bit3);
        out.bytes[out_base + i] = (c & 1) as u8;
        i = i + 1;
    }
}

transform reed_muller_decode_at(received: State<HqcBuf>, received_base: u32,
                                out: State<HqcBuf>, out_base: u32) {
    // Majority-logic decoder: for each message bit j, count the number of
    // received positions where bit_j(i) XOR received[i] == 1.
    let m0: u32 = 0;
    let m1: u32 = 0;
    let m2: u32 = 0;
    let m3: u32 = 0;
    let m4: u32 = 0;
    let i: u32 = 0;
    while i < RM_LEN {
        let r: u32 = received.bytes[received_base + i] as u32;
        let bit0: u32 = (i & 1) >> 0;
        let bit1: u32 = (i & 2) >> 1;
        let bit2: u32 = (i & 4) >> 2;
        let bit3: u32 = (i & 8) >> 3;
        // Constant-time majority vote via counting.
        if (bit0 ^ r) == 1 { m1 = m1 + 1; } else { m1 = m1 + 0; }
        if (bit1 ^ r) == 1 { m2 = m2 + 1; } else { m2 = m2 + 0; }
        if (bit2 ^ r) == 1 { m3 = m3 + 1; } else { m3 = m3 + 0; }
        if (bit3 ^ r) == 1 { m4 = m4 + 1; } else { m4 = m4 + 0; }
        // For m0: count 1s in received.
        if r == 1 { m0 = m0 + 1; } else { m0 = m0 + 0; }
        i = i + 1;
    }
    // Threshold: RM_LEN / 2 = 8.
    if m0 > 8 { out.bytes[out_base] = 1; } else { out.bytes[out_base] = 0; }
    if m1 > 8 { out.bytes[out_base + 1] = 1; } else { out.bytes[out_base + 1] = 0; }
    if m2 > 8 { out.bytes[out_base + 2] = 1; } else { out.bytes[out_base + 2] = 0; }
    if m3 > 8 { out.bytes[out_base + 3] = 1; } else { out.bytes[out_base + 3] = 0; }
    if m4 > 8 { out.bytes[out_base + 4] = 1; } else { out.bytes[out_base + 4] = 0; }
}

// ===========================================================================
// HQC message encode/decode (RM(1,4) x 4 blocks, padded to HQC_N).
// ===========================================================================

transform hqc_encode_message_at(msg: State<HqcBuf>, msg_base: u32,
                                m_enc: State<HqcBuf>, m_enc_base: u32) {
    // Zero m_enc to HQC_N bytes.
    let z: u32 = 0;
    while z < HQC_N { m_enc.bytes[m_enc_base + z] = 0; z = z + 1; }
    // Encode each of HQC_RM_BLOCKS RM(1,4) blocks.
    let block: u32 = 0;
    while block < HQC_RM_BLOCKS {
        let block_out: u32 = m_enc_base + block * RM_LEN;
        reed_muller_encode_at(msg, msg_base + block * RM_DIM,
                              m_enc, block_out);
        block = block + 1;
    }
}

transform hqc_decode_message_at(m_enc: State<HqcBuf>, m_enc_base: u32,
                                msg: State<HqcBuf>, msg_base: u32) -> u32 {
    let block: u32 = 0;
    while block < HQC_RM_BLOCKS {
        let block_in: u32 = m_enc_base + block * RM_LEN;
        reed_muller_decode_at(m_enc, block_in, msg, msg_base + block * RM_DIM);
        block = block + 1;
    }
    return 0;
}

// ===========================================================================
// SHAKE-256 PRG wrapper.
// ===========================================================================

transform hqc_prg_at(seed: State<HqcBuf>, seed_base: u32, seed_len: u32,
                     counter: u32,
                     out: State<HqcBuf>, out_base: u32, out_len: u32) {
    let kin = state_new(KeccakIn);
    let kout = state_new(KeccakOut);
    let ctx = state_new(KeccakCtx);
    shake256_init(ctx);
    let pos: u32 = 0;
    while pos < seed_len {
        let to_copy: u32 = 200;
        let remaining: u32 = seed_len - pos;
        if remaining < 200 { to_copy = remaining; }
        let k: u32 = 0;
        while k < 200 { kin.data[k] = 0; k = k + 1; }
        k = 0;
        while k < to_copy { kin.data[k] = seed.bytes[seed_base + pos + k]; k = k + 1; }
        shake256_update(ctx, kin, to_copy);
        pos = pos + to_copy;
    }
    // Append the 4-byte counter.
    let k2: u32 = 0;
    while k2 < 4 { kin.data[k2] = 0; k2 = k2 + 1; }
    kin.data[0] = (counter & 255) as u8;
    kin.data[1] = ((counter >> 8)  & 255) as u8;
    kin.data[2] = ((counter >> 16) & 255) as u8;
    kin.data[3] = ((counter >> 24) & 255) as u8;
    shake256_update(ctx, kin, 4);
    shake256_squeeze(ctx, kout, out_len);
    let i: u32 = 0;
    while i < out_len { out.bytes[out_base + i] = kout.data[i]; i = i + 1; }
}

// Sample a uniformly random dense vector of length n.
transform hqc_sample_random_at(seed: State<HqcBuf>, seed_base: u32, seed_len: u32,
                                counter: u32,
                                out: State<HqcBuf>, out_base: u32, n: u32) {
    hqc_prg_at(seed, seed_base, seed_len, counter, out, out_base, n);
    // Reduce each byte to a single bit (LSB) to get 0/1 entries.
    let i: u32 = 0;
    while i < n {
        let v: u32 = out.bytes[out_base + i] as u32;
        out.bytes[out_base + i] = (v & 1) as u8;
        i = i + 1;
    }
}

// Sample a sparse binary vector of length n with weight `w`.
// Writes the support indices (little-endian u32) into sparse_idx.
transform hqc_sample_sparse_at(seed: State<HqcBuf>, seed_base: u32, seed_len: u32,
                                counter: u32,
                                vec: State<HqcBuf>, vec_base: u32,
                                sparse_idx: State<HqcBuf>, sparse_idx_base: u32,
                                w: u32, n: u32) {
    // Zero the output vector.
    let z: u32 = 0;
    while z < n { vec.bytes[vec_base + z] = 0; z = z + 1; }
    // Pull w*4 bytes from the PRG and treat each 4-byte LE word as an index
    // mod n. Set the corresponding vector entry to 1 and record the index.
    let prng_len: u32 = w * 4 * 4;  // some slack for rejection sampling.
    let buf = state_new(HqcBuf);
    hqc_prg_at(seed, seed_base, seed_len, counter, buf, 0, prng_len);
    let placed: u32 = 0;
    let pos: u32 = 0;
    while placed < w {
        if pos + 4 > prng_len {
            // Re-fill buffer if we run out.
            hqc_prg_at(seed, seed_base, seed_len, counter + 1 + placed,
                       buf, 0, prng_len);
            pos = 0;
        }
        let idx: u32 = load_u32_le_at(buf, pos) % n;
        pos = pos + 4;
        // Only place if the slot is empty (rejection).
        if vec.bytes[vec_base + idx] == 0 {
            vec.bytes[vec_base + idx] = 1;
            store_u32_le_at(sparse_idx, sparse_idx_base + placed * 4, idx);
            placed = placed + 1;
        }
    }
}

// Derive the k-bit message from the `randomness` buffer.
transform hqc_derive_message_at(randomness: State<HqcBuf>, randomness_base: u32,
                                 msg: State<HqcBuf>, msg_base: u32) {
    hqc_prg_at(randomness, randomness_base, 32, 0, msg, msg_base, HQC_K);
    // Reduce each byte to a single bit.
    let i: u32 = 0;
    while i < HQC_K {
        let v: u32 = msg.bytes[msg_base + i] as u32;
        msg.bytes[msg_base + i] = (v & 1) as u8;
        i = i + 1;
    }
}

// ===========================================================================
// HQC-128 Key Generation
//   x, y  <- sparse random vectors of length n, weight w_r
//   h     <- uniform random vector of length n
//   s     = x + h*y  (in GF(2)[x]/(x^n+1))
//   pk    = (h, s);  sk = (x, y, h, s)
// ===========================================================================

transform hqc_keygen(seed: State<HqcBuf>,
                     pk: State<HqcBuf>, sk: State<HqcBuf>) -> u32 {
    let h_base: u32 = 0;
    let s_base: u32 = HQC_N;
    let x_base: u32 = 0;
    let y_base: u32 = HQC_N;
    let h_sk_base: u32 = 2 * HQC_N;
    let s_sk_base: u32 = 3 * HQC_N;

    let x_idx = state_new(HqcBuf);
    let y_idx = state_new(HqcBuf);
    let ones_wr = state_new(HqcBuf);
    let i_init: u32 = 0;
    while i_init < HQC_WR { ones_wr.bytes[i_init] = 1; i_init = i_init + 1; }

    hqc_sample_sparse_at(seed, 0, 32, 100, sk, x_base, x_idx, 0, HQC_WR, HQC_N);
    hqc_sample_sparse_at(seed, 0, 32, 200, sk, y_base, y_idx, 0, HQC_WR, HQC_N);
    hqc_sample_random_at(seed, 0, 32, 300, pk, h_base, HQC_N);

    // s = x + h*y. Compute h*y with sparse_vec_mul using y's support.
    let hy = state_new(HqcBuf);
    sparse_vec_mul_at(hy, 0, y_idx, 0, ones_wr, 0, HQC_WR, pk, h_base, HQC_N);
    gf2_vec_add_at(pk, s_base, sk, x_base, hy, 0, HQC_N);

    // Copy h, s into the secret key (sk stores a full copy of pk).
    let i: u32 = 0;
    while i < HQC_N {
        sk.bytes[h_sk_base + i] = pk.bytes[h_base + i];
        sk.bytes[s_sk_base + i] = pk.bytes[s_base + i];
        i = i + 1;
    }
    return 0;
}

// ===========================================================================
// HQC-128 Encapsulation
//   m     <- derived from `randomness` (k-bit message)
//   m_enc = RM_encode(m) padded to length n
//   r, e  <- sparse noise vectors derived deterministically from m
//   u     = r + e                          (over GF(2))
//   v     = m_enc XOR (h*r + e)            (over GF(2))
//   ct    = (u, v);  ss = SHA-256(m || ct)
// ===========================================================================

transform hqc_encaps(pk: State<HqcBuf>,
                      randomness: State<HqcBuf>,
                      ct: State<HqcBuf>, ss: State<HqcBuf>) -> u32 {
    let h_base: u32 = 0;
    let u_base: u32 = 0;
    let v_base: u32 = HQC_N;

    // Derive message and (deterministically) the noise vectors.
    let msg = state_new(HqcBuf);
    hqc_derive_message_at(randomness, 0, msg, 0);

    let sample_seed = state_new(HqcBuf);
    sha256_oneshot_at(msg, HQC_K, sample_seed);

    let m_enc = state_new(HqcBuf);
    hqc_encode_message_at(msg, 0, m_enc, 0);

    let r_idx = state_new(HqcBuf);
    let e_idx = state_new(HqcBuf);
    let r_vec = state_new(HqcBuf);
    let e_vec = state_new(HqcBuf);
    let ones_wr = state_new(HqcBuf);
    let ones_we = state_new(HqcBuf);
    let i: u32 = 0;
    while i < HQC_WR { ones_wr.bytes[i] = 1; i = i + 1; }
    let j: u32 = 0;
    while j < HQC_WE { ones_we.bytes[j] = 1; j = j + 1; }

    hqc_sample_sparse_at(sample_seed, 0, 32, 10, r_vec, 0,
                          r_idx, 0, HQC_WR, HQC_N);
    hqc_sample_sparse_at(sample_seed, 0, 32, 20, e_vec, 0,
                          e_idx, 0, HQC_WE, HQC_N);

    // u = r + e
    gf2_vec_add_at(ct, u_base, r_vec, 0, e_vec, 0, HQC_N);
    // v = m_enc XOR (h*r + e)
    let hr = state_new(HqcBuf);
    sparse_vec_mul_at(hr, 0, r_idx, 0, ones_wr, 0, HQC_WR, pk, h_base, HQC_N);
    let noise = state_new(HqcBuf);
    gf2_vec_add_at(noise, 0, hr, 0, e_vec, 0, HQC_N);
    gf2_vec_add_at(ct, v_base, m_enc, 0, noise, 0, HQC_N);

    // ss = SHA-256(msg || ct)
    let hash_in = state_new(HqcBuf);
    let ki: u32 = 0;
    while ki < HQC_K { hash_in.bytes[ki] = msg.bytes[ki]; ki = ki + 1; }
    let ci: u32 = 0;
    while ci < HQC_CT_SIZE { hash_in.bytes[HQC_K + ci] = ct.bytes[ci]; ci = ci + 1; }
    sha256_oneshot_at(hash_in, HQC_K + HQC_CT_SIZE, ss);
    return 0;
}

// ===========================================================================
// HQC-128 Decapsulation (FO-style CCA transform)
//   v' = v XOR (s * u);  decode m' from first 64 bits; re-encrypt;
//   verify (u, v) == (u', v'); ss = SHA-256(m' || ct) on success,
//   otherwise ss = SHA-256(fail_pad || ct).
// ===========================================================================

transform hqc_decaps(sk: State<HqcBuf>, pk: State<HqcBuf>,
                      ct: State<HqcBuf>, ss: State<HqcBuf>) -> u32 {
    let h_sk_base: u32 = 2 * HQC_N;
    let s_sk_base: u32 = 3 * HQC_N;
    let u_base: u32 = 0;
    let v_base: u32 = HQC_N;

    // ── Buffer-reuse strategy ────────────────────────────────────────────
    // The original implementation made 15+ state_new(HqcBuf) calls, each
    // 128 KiB, totalling ~1.9 MiB of live state — enough to overflow the
    // per-function stack frame and trip the arena-overflow trap (SIGABRT,
    // exit 134). We instead allocate FOUR reusable scratch buffers up front
    // and recycle them phase-by-phase:
    //
    //   b1 — multipurpose scratch (su → sample_seed → hr → hash_in / fail_in)
    //   b2 — multipurpose scratch (v_prime → m_enc)
    //   b3 — message bits (preserved from decode through the final hash)
    //   b4 — packed slab for the small per-phase artefacts (ones_wr,
    //        ones_we, r_idx, e_idx, r_vec, e_vec) — see offset layout below.
    //
    // Layout of b4 (each region is aligned to a power of two so they
    // never overlap; peak usage 39434 B ≪ HqcBuf size of 131072 B):
    //   [    0 ..    75)  ones_wr   (HQC_WR bytes)
    //   [  256 ..   337)  ones_we   (HQC_WE bytes)
    //   [ 1024 ..  1324)  r_idx     (HQC_WR * 4 bytes)
    //   [ 2048 ..  2372)  e_idx     (HQC_WE * 4 bytes)
    //   [ 4096 .. 21765)  r_vec     (HQC_N bytes)
    //   [21765 .. 39434)  e_vec     (HQC_N bytes)
    //
    // u_prime = r + e and v_prime2 = m_enc + hr + e are computed INLINE
    // during the comparison loop, so they never need to be materialised.
    let b1 = state_new(HqcBuf);
    let b2 = state_new(HqcBuf);
    let b3 = state_new(HqcBuf);
    let b4 = state_new(HqcBuf);

    let ones_wr_off: u32 = 0;
    let ones_we_off: u32 = 256;
    let r_idx_off:  u32 = 1024;
    let e_idx_off:  u32 = 2048;
    let r_vec_off:  u32 = 4096;
    let e_vec_off:  u32 = 4096 + HQC_N;

    // ── Phase 1: v' = v XOR (s * u) ──────────────────────────────────────
    //   b1 ← su = s · u   (GF(2)[x]/(x^n+1) negacyclic product)
    //   b2 ← v' = v XOR su
    // Inline gf2_vec_mul_at(b1, 0, sk, s_sk_base, ct, u_base, HQC_N) — 7 params, calling convention bug
    let gvm_z: u32 = 0;
    while gvm_z < HQC_N { b1.bytes[gvm_z] = 0; gvm_z = gvm_z + 1; }
    let gvm_i: u32 = 0;
    while gvm_i < HQC_N {
        let gvm_av: u32 = sk.bytes[s_sk_base + gvm_i] as u32;
        if gvm_av == 1 {
            let gvm_j: u32 = 0;
            while gvm_j < HQC_N {
                let gvm_bv: u32 = ct.bytes[u_base + gvm_j] as u32;
                if gvm_bv == 1 {
                    let gvm_idx: u32 = gvm_i + gvm_j;
                    if gvm_idx < HQC_N {
                        let gvm_cur: u32 = b1.bytes[gvm_idx] as u32;
                        b1.bytes[gvm_idx] = ((gvm_cur ^ 1) & 1) as u8;
                    } else {
                        let gvm_nidx: u32 = gvm_idx - HQC_N;
                        let gvm_cur: u32 = b1.bytes[gvm_nidx] as u32;
                        b1.bytes[gvm_nidx] = ((gvm_cur ^ 1) & 1) as u8;
                    }
                }
                gvm_j = gvm_j + 1;
            }
        }
        gvm_i = gvm_i + 1;
    }
    // Inline gf2_vec_add_at(b2, 0, ct, v_base, b1, 0, HQC_N) — 7 params
    let gva_i: u32 = 0;
    while gva_i < HQC_N {
        let gva_av: u32 = ct.bytes[v_base + gva_i] as u32;
        let gva_bv: u32 = b1.bytes[gva_i] as u32;
        b2.bytes[gva_i] = ((gva_av ^ gva_bv) & 1) as u8;
        gva_i = gva_i + 1;
    }

    // ── Phase 2: decode m' from the first HQC_M_ENC_LEN bits of v' ─────
    //   b3 ← msg  (16 bits, one byte per bit). b1=su and b2=v' now dead.
    hqc_decode_message_at(b2, 0, b3, 0);

    // ── Phase 3: re-derive r, e deterministically from msg ──────────────
    //   b1 ← sample_seed = SHA-256(msg)
    //   b2 ← m_enc       = RM-encode(msg) padded to HQC_N
    sha256_oneshot_at(b3, HQC_K, b1);
    hqc_encode_message_at(b3, 0, b2, 0);

    // Initialise ones_wr / ones_we inside the b4 slab.
    let i: u32 = 0;
    while i < HQC_WR { b4.bytes[ones_wr_off + i] = 1; i = i + 1; }
    let j: u32 = 0;
    while j < HQC_WE { b4.bytes[ones_we_off + j] = 1; j = j + 1; }

    // Sample r, e into the b4 slab. sample_seed (b1) is still needed for
    // the second call, then b1 becomes free for Phase 4.
    // Inline hqc_sample_sparse_at(b1, 0, 32, 10, b4, r_vec_off, b4, r_idx_off, HQC_WR, HQC_N) — 10 params
    let ss_z1: u32 = 0;
    while ss_z1 < HQC_N { b4.bytes[r_vec_off + ss_z1] = 0; ss_z1 = ss_z1 + 1; }
    let ss_prng_len1: u32 = HQC_WR * 4 * 4;
    let ss_buf1 = state_new(HqcBuf);
    hqc_prg_at(b1, 0, 32, 10, ss_buf1, 0, ss_prng_len1);
    let ss_placed1: u32 = 0;
    let ss_pos1: u32 = 0;
    while ss_placed1 < HQC_WR {
        if ss_pos1 + 4 > ss_prng_len1 {
            hqc_prg_at(b1, 0, 32, 10 + 1 + ss_placed1, ss_buf1, 0, ss_prng_len1);
            ss_pos1 = 0;
        }
        let ss_idx1: u32 = load_u32_le_at(ss_buf1, ss_pos1) % HQC_N;
        ss_pos1 = ss_pos1 + 4;
        if b4.bytes[r_vec_off + ss_idx1] == 0 {
            b4.bytes[r_vec_off + ss_idx1] = 1;
            store_u32_le_at(b4, r_idx_off + ss_placed1 * 4, ss_idx1);
            ss_placed1 = ss_placed1 + 1;
        }
    }
    // Inline hqc_sample_sparse_at(b1, 0, 32, 20, b4, e_vec_off, b4, e_idx_off, HQC_WE, HQC_N) — 10 params
    let ss_z2: u32 = 0;
    while ss_z2 < HQC_N { b4.bytes[e_vec_off + ss_z2] = 0; ss_z2 = ss_z2 + 1; }
    let ss_prng_len2: u32 = HQC_WE * 4 * 4;
    let ss_buf2 = state_new(HqcBuf);
    hqc_prg_at(b1, 0, 32, 20, ss_buf2, 0, ss_prng_len2);
    let ss_placed2: u32 = 0;
    let ss_pos2: u32 = 0;
    while ss_placed2 < HQC_WE {
        if ss_pos2 + 4 > ss_prng_len2 {
            hqc_prg_at(b1, 0, 32, 20 + 1 + ss_placed2, ss_buf2, 0, ss_prng_len2);
            ss_pos2 = 0;
        }
        let ss_idx2: u32 = load_u32_le_at(ss_buf2, ss_pos2) % HQC_N;
        ss_pos2 = ss_pos2 + 4;
        if b4.bytes[e_vec_off + ss_idx2] == 0 {
            b4.bytes[e_vec_off + ss_idx2] = 1;
            store_u32_le_at(b4, e_idx_off + ss_placed2 * 4, ss_idx2);
            ss_placed2 = ss_placed2 + 1;
        }
    }

    // ── Phase 4: hr = h · r  (negacyclic sparse product) ────────────────
    //   b1 ← hr = sparse_vec_mul(r_idx, ones_wr, h_sk)
    //   (No conflict: b1 is now free, hr lives in a different buffer than
    //    the r_idx/ones_wr inputs that live inside the b4 slab.)
    // Inline sparse_vec_mul_at(b1, 0, b4, r_idx_off, b4, ones_wr_off, HQC_WR, sk, h_sk_base, HQC_N) — 10 params
    let svm_z: u32 = 0;
    while svm_z < HQC_N { b1.bytes[svm_z] = 0; svm_z = svm_z + 1; }
    let svm_k: u32 = 0;
    while svm_k < HQC_WR {
        let svm_idx: u32 = load_u32_le_at(b4, r_idx_off + svm_k * 4);
        let svm_val: u32 = b4.bytes[ones_wr_off + svm_k] as u32;
        if svm_val == 1 {
            let svm_j: u32 = 0;
            while svm_j < HQC_N {
                let svm_dv: u32 = sk.bytes[h_sk_base + svm_j] as u32;
                if svm_dv == 1 {
                    let svm_pos: u32 = svm_idx + svm_j;
                    if svm_pos < HQC_N {
                        let svm_cur: u32 = b1.bytes[svm_pos] as u32;
                        b1.bytes[svm_pos] = ((svm_cur ^ 1) & 1) as u8;
                    } else {
                        let svm_npos: u32 = svm_pos - HQC_N;
                        let svm_cur: u32 = b1.bytes[svm_npos] as u32;
                        b1.bytes[svm_npos] = ((svm_cur ^ 1) & 1) as u8;
                    }
                }
                svm_j = svm_j + 1;
            }
        }
        svm_k = svm_k + 1;
    }

    // ── Phase 5: compare (u, v) with (r+e, m_enc+hr+e) INLINE ────────────
    //   u' = r XOR e  (computed element-wise from r_vec, e_vec)
    //   v'' = m_enc XOR hr XOR e_vec  (computed element-wise)
    //   This avoids materialising u' and v'' in dedicated buffers — which
    //   would otherwise need either a 5th allocation or careful aliasing
    //   gymnastics inside gf2_vec_add_at.
    let mut_match: u32 = 1;
    let k: u32 = 0;
    while k < HQC_N {
        let rv: u32 = b4.bytes[r_vec_off + k] as u32;
        let ev: u32 = b4.bytes[e_vec_off + k] as u32;
        let u_p: u32 = (rv ^ ev) & 1;
        let u_ct: u32 = ct.bytes[u_base + k] as u32;
        if (u_ct & 1) != u_p { mut_match = 0; }

        let mv: u32 = b2.bytes[k] as u32;
        let hv: u32 = b1.bytes[k] as u32;
        let v_p2: u32 = (mv ^ hv ^ ev) & 1;
        let v_ct: u32 = ct.bytes[v_base + k] as u32;
        if (v_ct & 1) != v_p2 { mut_match = 0; }
        k = k + 1;
    }

    // ── Phase 6: ss = SHA-256(msg || ct) on success ─────────────────────
    //   Reuse b1 (hr is now dead) as the hash input buffer.
    let ki: u32 = 0;
    while ki < HQC_K { b1.bytes[ki] = b3.bytes[ki]; ki = ki + 1; }
    let ci: u32 = 0;
    while ci < HQC_CT_SIZE { b1.bytes[HQC_K + ci] = ct.bytes[ci]; ci = ci + 1; }
    sha256_oneshot_at(b1, HQC_K + HQC_CT_SIZE, ss);

    // ── Phase 7 (failure only): overwrite ss with SHA-256(fail_pad || ct)
    if mut_match == 0 {
        let z: u32 = 0;
        while z < 32 { b1.bytes[z] = 0; z = z + 1; }
        let m: u32 = 0;
        while m < HQC_CT_SIZE { b1.bytes[32 + m] = ct.bytes[m]; m = m + 1; }
        sha256_oneshot_at(b1, 32 + HQC_CT_SIZE, ss);
        return 1;
    }
    return 0;
}
