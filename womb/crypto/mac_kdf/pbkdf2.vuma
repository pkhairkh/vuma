// womb/crypto/mac_kdf/pbkdf2.vuma — PBKDF2 (RFC 8018 / PKCS#5 v2.1)
// Password-Based Key Derivation Function 2.
// Provides PBKDF2-HMAC-SHA1, PBKDF2-HMAC-SHA256, and PBKDF2-HMAC-SHA512
// with configurable iteration counts. No main().
//
// VUMA 2.0 PMT-native: state_new(Layout) / State<T> / [u8;N] arrays.
// All allocate/free/Address/*ptr removed (arena auto-frees on return).
// Reuses HmacKey / HmacMsg / HmacOut layouts from hmac.vuma:
//   HmacKey: 256 bytes  — used as HMAC key (password)
//   HmacMsg: 256 bytes  — used as HMAC message (salt, U_buf, output)
//   HmacOut:  64 bytes  — used as HMAC digest (U_prev, U_next, T_buf)

import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hmac.vuma"::{HmacKey, HmacMsg, HmacOut, hmac_sha1, hmac_sha256, hmac_sha512};

// Per RFC 8018 Section 5.2:
//   DK = T_1 || T_2 || ... || T_l  (truncated to dkLen)
//   T_i = U_1 XOR U_2 XOR ... XOR U_c
//   U_1 = HMAC(password, salt || INT_32_BE(i))
//   U_j = HMAC(password, U_{j-1})    for j = 2..c

const PBKDF2_MASK32: u32 = 4294967295;

// ===========================================================================
// PBKDF2-HMAC-SHA1
//   password:    HmacKey state with password bytes (key)
//   pass_len:    password length
//   salt:        HmacMsg state with salt bytes
//   salt_len:    salt length
//   iterations:  iteration count (c >= 1)
//   out:         HmacMsg state; first out_len bytes receive the derived key
//   out_len:     desired output length (dkLen)
// ===========================================================================

transform pbkdf2_hmac_sha1(password: State<HmacKey>, pass_len: u32, salt: State<HmacMsg>, salt_len: u32,
                    iterations: u32, out: State<HmacMsg>, out_len: u32) {
    let hlen: u32 = 20;  // SHA-1 output size

    let block_index: u32 = 1;
    let pos: u32 = 0;

    while pos < out_len {
        // Build U_1 input = salt || INT_32_BE(block_index)
        let u_buf = state_new(HmacMsg);
        let i: u32 = 0;
        while i < salt_len {
            u_buf.bytes[i] = salt.bytes[i];
            i = i + 1;
        }
        u_buf.bytes[salt_len]     = ((block_index >> 24) & 255) as u8;
        u_buf.bytes[salt_len + 1] = ((block_index >> 16) & 255) as u8;
        u_buf.bytes[salt_len + 2] = ((block_index >> 8) & 255) as u8;
        u_buf.bytes[salt_len + 3] = (block_index & 255) as u8;

        // U_1 = HMAC(password, u_buf)
        let u_prev = state_new(HmacMsg);
        let u_out = state_new(HmacOut);
        hmac_sha1(password, pass_len, u_buf, salt_len + 4, u_out);
        i = 0;
        while i < hlen {
            u_prev.bytes[i] = u_out.bytes[i];
            i = i + 1;
        }

        // T = U_1
        let t_buf = state_new(HmacMsg);
        i = 0;
        while i < hlen {
            t_buf.bytes[i] = u_prev.bytes[i];
            i = i + 1;
        }

        // U_2..U_c, accumulate into T via XOR.
        let iter: u32 = 1;
        while iter < iterations {
            let u_next_out = state_new(HmacOut);
            hmac_sha1(password, pass_len, u_prev, hlen, u_next_out);

            i = 0;
            while i < hlen {
                let t_val: u32 = t_buf.bytes[i] as u32;
                let u_val: u32 = u_next_out.bytes[i] as u32;
                t_buf.bytes[i] = ((t_val ^ u_val) & 255) as u8;
                i = i + 1;
            }

            // u_prev = u_next_out (copy back into HmacMsg form for next call)
            i = 0;
            while i < hlen {
                u_prev.bytes[i] = u_next_out.bytes[i];
                i = i + 1;
            }
            iter = iter + 1;
        }

        let to_copy: u32 = hlen;
        let remaining: u32 = out_len - pos;
        if remaining < hlen { to_copy = remaining; }
        i = 0;
        while i < to_copy {
            out.bytes[pos + i] = t_buf.bytes[i];
            i = i + 1;
        }
        pos = pos + to_copy;

        block_index = block_index + 1;
    }
}

// ===========================================================================
// PBKDF2-HMAC-SHA256
// ===========================================================================

transform pbkdf2_hmac_sha256(password: State<HmacKey>, pass_len: u32, salt: State<HmacMsg>, salt_len: u32,
                      iterations: u32, out: State<HmacMsg>, out_len: u32) {
    let hlen: u32 = 32;  // SHA-256 output size

    let block_index: u32 = 1;
    let pos: u32 = 0;

    while pos < out_len {
        let u_buf = state_new(HmacMsg);
        let i: u32 = 0;
        while i < salt_len {
            u_buf.bytes[i] = salt.bytes[i];
            i = i + 1;
        }
        u_buf.bytes[salt_len]     = ((block_index >> 24) & 255) as u8;
        u_buf.bytes[salt_len + 1] = ((block_index >> 16) & 255) as u8;
        u_buf.bytes[salt_len + 2] = ((block_index >> 8) & 255) as u8;
        u_buf.bytes[salt_len + 3] = (block_index & 255) as u8;

        let u_prev = state_new(HmacMsg);
        let u_out = state_new(HmacOut);
        hmac_sha256(password, pass_len, u_buf, salt_len + 4, u_out);
        i = 0;
        while i < hlen {
            u_prev.bytes[i] = u_out.bytes[i];
            i = i + 1;
        }

        let t_buf = state_new(HmacMsg);
        i = 0;
        while i < hlen {
            t_buf.bytes[i] = u_prev.bytes[i];
            i = i + 1;
        }

        let iter: u32 = 1;
        while iter < iterations {
            let u_next_out = state_new(HmacOut);
            hmac_sha256(password, pass_len, u_prev, hlen, u_next_out);

            i = 0;
            while i < hlen {
                let t_val: u32 = t_buf.bytes[i] as u32;
                let u_val: u32 = u_next_out.bytes[i] as u32;
                t_buf.bytes[i] = ((t_val ^ u_val) & 255) as u8;
                i = i + 1;
            }

            i = 0;
            while i < hlen {
                u_prev.bytes[i] = u_next_out.bytes[i];
                i = i + 1;
            }
            iter = iter + 1;
        }

        let to_copy: u32 = hlen;
        let remaining: u32 = out_len - pos;
        if remaining < hlen { to_copy = remaining; }
        i = 0;
        while i < to_copy {
            out.bytes[pos + i] = t_buf.bytes[i];
            i = i + 1;
        }
        pos = pos + to_copy;

        block_index = block_index + 1;
    }
}

// ===========================================================================
// PBKDF2-HMAC-SHA512 (bonus variant, used by some scrypt/Argon2 callers).
// ===========================================================================

transform pbkdf2_hmac_sha512(password: State<HmacKey>, pass_len: u32, salt: State<HmacMsg>, salt_len: u32,
                      iterations: u32, out: State<HmacMsg>, out_len: u32) {
    let hlen: u32 = 64;  // SHA-512 output size

    let block_index: u32 = 1;
    let pos: u32 = 0;

    while pos < out_len {
        let u_buf = state_new(HmacMsg);
        let i: u32 = 0;
        while i < salt_len {
            u_buf.bytes[i] = salt.bytes[i];
            i = i + 1;
        }
        u_buf.bytes[salt_len]     = ((block_index >> 24) & 255) as u8;
        u_buf.bytes[salt_len + 1] = ((block_index >> 16) & 255) as u8;
        u_buf.bytes[salt_len + 2] = ((block_index >> 8) & 255) as u8;
        u_buf.bytes[salt_len + 3] = (block_index & 255) as u8;

        let u_prev = state_new(HmacMsg);
        let u_out = state_new(HmacOut);
        hmac_sha512(password, pass_len, u_buf, salt_len + 4, u_out);
        i = 0;
        while i < hlen {
            u_prev.bytes[i] = u_out.bytes[i];
            i = i + 1;
        }

        let t_buf = state_new(HmacMsg);
        i = 0;
        while i < hlen {
            t_buf.bytes[i] = u_prev.bytes[i];
            i = i + 1;
        }

        let iter: u32 = 1;
        while iter < iterations {
            let u_next_out = state_new(HmacOut);
            hmac_sha512(password, pass_len, u_prev, hlen, u_next_out);

            i = 0;
            while i < hlen {
                let t_val: u32 = t_buf.bytes[i] as u32;
                let u_val: u32 = u_next_out.bytes[i] as u32;
                t_buf.bytes[i] = ((t_val ^ u_val) & 255) as u8;
                i = i + 1;
            }

            i = 0;
            while i < hlen {
                u_prev.bytes[i] = u_next_out.bytes[i];
                i = i + 1;
            }
            iter = iter + 1;
        }

        let to_copy: u32 = hlen;
        let remaining: u32 = out_len - pos;
        if remaining < hlen { to_copy = remaining; }
        i = 0;
        while i < to_copy {
            out.bytes[pos + i] = t_buf.bytes[i];
            i = i + 1;
        }
        pos = pos + to_copy;

        block_index = block_index + 1;
    }
}
