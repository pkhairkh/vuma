// womb/crypto/mac_kdf/key_agreement.vuma — Key Agreement Protocols
// ===========================================================================
// X25519-based key agreement (RFC 7748) wrapping the lower-level
// x25519_scalarmult / x25519_base primitives in asym/x25519.vuma.
//
// No main() — importable library module.
//
// VUMA 2.0 PMT-native: state_new(Layout) / State<T> / [u8;N] arrays.
// All allocate/free/Address/*ptr removed (arena auto-frees on return).
//
// Public API:
//   x25519_keygen(privkey, pubkey)                  -> u32   (always 1)
//   x25519_shared_secret(privkey, peer_pubkey, shared) -> u32  (1 ok, 0 low-order)
//
// Both privkey and pubkey are 32-byte little-endian X25519 scalars /
// u-coordinates (RFC 7748 wire format). The scalar is clamped internally by
// x25519_scalarmult, so callers may pass raw random bytes.
//
// The base point for keygen is u = 9 (RFC 7748 Section 5). The shared-secret
// check rejects all-zero outputs (low-order points per RFC 7748 Section 6.1)
// by returning 0.

// Reuse the X25519Bytes layout (data: [u8; 32]) from asym/x25519.vuma.

// ===========================================================================
// X25519 key-pair generation.
//   privkey : 32-byte little-endian private scalar (clamped internally)
//   pubkey  : 32-byte little-endian public u-coordinate = X25519(privkey, 9)
// Returns 1 on success.
// ===========================================================================

transform x25519_keygen(privkey: State<X25519Bytes>, pubkey: State<X25519Bytes>) -> u32 {
    // Base point u = 9 (RFC 7748 Section 5).
    x25519_base(pubkey, privkey);
    return 1;
}

// ===========================================================================
// X25519 shared secret.
//   privkey     : 32-byte little-endian our private scalar
//   peer_pubkey : 32-byte little-endian peer public u-coordinate
//   shared      : 32-byte little-endian shared secret = X25519(privkey, peer_pubkey)
// Returns 1 on success, 0 if the resulting shared secret is all-zero
// (low-order point per RFC 7748 Section 6.1).
// ===========================================================================

transform x25519_shared_secret(privkey: State<X25519Bytes>, peer_pubkey: State<X25519Bytes>,
                        shared: State<X25519Bytes>) -> u32 {
    x25519_scalarmult(shared, privkey, peer_pubkey);

    // Reject all-zero shared secret (low-order point).
    let acc: u32 = 0;
    let i: u32 = 0;
    while i < 32 {
        acc = acc | (shared.data[i] as u32);
        i = i + 1;
    }
    if acc == 0 { return 0; }
    return 1;
}

// ===========================================================================
// Optional: derive a 32-byte symmetric key from a raw X25519 shared secret
// using SHA-256 (a typical KDF step for ECDH-derived keys, e.g. TLS 1.3
// derives the secret via HKDF-Extract over the raw shared secret; this
// transform provides just the SHA-256 digest).
//   shared : 32-byte raw X25519 shared secret
//   out    : 32-byte SHA-256 digest (caller-supplied HmacOut-compatible buffer)
//
// We reuse the HmacOut layout (64 bytes; SHA-256 uses the first 32) from
// hmac.vuma. The hash is computed via the standard sha256_oneshot entry
// point in sha256_sha224.vuma.
// ===========================================================================

transform x25519_kdf_sha256(shared: State<X25519Bytes>, out: State<HmacOut>) -> u32 {
    // sha256_oneshot expects a Sha256Data state (64-byte block); our shared
    // secret is only 32 bytes, so we copy it into a fresh Sha256Data state.
    let data = state_new(Sha256Data);
    let i: u32 = 0;
    while i < 32 {
        data.data[i] = shared.data[i];
        i = i + 1;
    }
    // Zero the remaining 32 bytes of the 64-byte block.
    i = 0;
    while i < 32 {
        data.data[32 + i] = 0;
        i = i + 1;
    }
    // Reuse the HmacOut as the digest target; sha256_oneshot wants a
    // State<Sha256Digest>. Allocate one, then copy 32 bytes to `out`.
    let digest = state_new(Sha256Digest);
    let ctx = state_new(Sha256Ctx);
    sha256_oneshot(ctx, data, 32, digest);
    i = 0;
    while i < 32 {
        out.bytes[i] = digest.data[i];
        i = i + 1;
    }
    return 1;
}
