// womb/crypto/mac_kdf/hkdf.vuma — HKDF (RFC 5869)
// HMAC-based Extract-and-Expand Key Derivation Function.
// Provides HKDF-Extract, HKDF-Expand, and HKDF (oneshot) for SHA-256 and
// SHA-512. No main().
//
// VUMA 2.0 PMT-native: state_new(Layout) / State<T> / [u8;N] arrays.
// All allocate/free/Address/*ptr removed (arena auto-frees on return).
// Reuses HmacKey / HmacMsg / HmacOut layouts from hmac.vuma:
//   HmacKey: 256 bytes  — used as HMAC key (salt, PRK)
//   HmacMsg: 256 bytes  — used as HMAC message (IKM, info, OKM, input)
//   HmacOut:  64 bytes  — used as HMAC digest (PRK, T, zeros)

import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hmac.vuma"::{HmacKey, HmacMsg, HmacOut, hmac_sha256, hmac_sha512};

const HKDF_HASH256_LEN: u32 = 32;
const HKDF_HASH512_LEN: u32 = 64;
const HKDF_MAX_BLOCKS: u32 = 255;

// ===========================================================================
// HKDF-Extract (RFC 5869 Section 2.2) with SHA-256.
//   PRK = HMAC-SHA-256(salt, IKM)
//   If salt is empty, a string of HashLen zero bytes is used as the salt.
// ===========================================================================

transform hkdf_extract_sha256(salt: State<HmacKey>, salt_len: u32, ikm: State<HmacMsg>, ikm_len: u32, prk: State<HmacOut>) {
    if salt_len == 0 {
        let zeros = state_new(HmacKey);
        let i: u32 = 0;
        while i < HKDF_HASH256_LEN {
            zeros.bytes[i] = 0;
            i = i + 1;
        }
        hmac_sha256(zeros, HKDF_HASH256_LEN, ikm, ikm_len, prk);
    } else {
        hmac_sha256(salt, salt_len, ikm, ikm_len, prk);
    }
}

// ===========================================================================
// HKDF-Expand (RFC 5869 Section 2.3) with SHA-256.
//   N = ceil(L / HashLen)
//   T(0) = empty
//   T(i) = HMAC-SHA-256(PRK, T(i-1) || info || i)
//   OKM = first L octets of T(1) || T(2) || ... || T(N)
// L must be <= 255 * HashLen; this is the caller's responsibility.
// ===========================================================================

transform hkdf_expand_sha256(prk: State<HmacKey>, info: State<HmacMsg>, info_len: u32, okm: State<HmacMsg>, okm_len: u32) {
    let t = state_new(HmacOut);
    let i: u32 = 0;
    while i < HKDF_HASH256_LEN {
        t.bytes[i] = 0;
        i = i + 1;
    }

    let t_len: u32 = 0;
    let counter: u32 = 1;
    let pos: u32 = 0;

    while pos < okm_len {
        // input = T(prev) || info || counter
        let input_len: u32 = t_len + info_len + 1;
        let input = state_new(HmacMsg);

        i = 0;
        while i < t_len {
            input.bytes[i] = t.bytes[i];
            i = i + 1;
        }
        i = 0;
        while i < info_len {
            input.bytes[t_len + i] = info.bytes[i];
            i = i + 1;
        }
        input.bytes[t_len + info_len] = (counter & 255) as u8;

        hmac_sha256(prk, HKDF_HASH256_LEN, input, input_len, t);
        t_len = HKDF_HASH256_LEN;

        let to_copy: u32 = HKDF_HASH256_LEN;
        let remaining: u32 = okm_len - pos;
        if remaining < to_copy { to_copy = remaining; }

        i = 0;
        while i < to_copy {
            okm.bytes[pos + i] = t.bytes[i];
            i = i + 1;
        }
        pos = pos + to_copy;
        counter = counter + 1;
    }
}

// ===========================================================================
// HKDF-SHA256 (RFC 5869) — Extract + Expand in one call.
// ===========================================================================

transform hkdf_sha256(salt: State<HmacKey>, salt_len: u32, ikm: State<HmacMsg>, ikm_len: u32,
               info: State<HmacMsg>, info_len: u32, okm: State<HmacMsg>, okm_len: u32) {
    let prk = state_new(HmacOut);
    hkdf_extract_sha256(salt, salt_len, ikm, ikm_len, prk);
    // Copy PRK into a HmacKey state for the expand call (it is used as the HMAC key).
    let prk_key = state_new(HmacKey);
    let i: u32 = 0;
    while i < HKDF_HASH256_LEN {
        prk_key.bytes[i] = prk.bytes[i];
        i = i + 1;
    }
    hkdf_expand_sha256(prk_key, info, info_len, okm, okm_len);
}

// ===========================================================================
// HKDF-Extract with SHA-512.
// ===========================================================================

transform hkdf_extract_sha512(salt: State<HmacKey>, salt_len: u32, ikm: State<HmacMsg>, ikm_len: u32, prk: State<HmacOut>) {
    if salt_len == 0 {
        let zeros = state_new(HmacKey);
        let i: u32 = 0;
        while i < HKDF_HASH512_LEN {
            zeros.bytes[i] = 0;
            i = i + 1;
        }
        hmac_sha512(zeros, HKDF_HASH512_LEN, ikm, ikm_len, prk);
    } else {
        hmac_sha512(salt, salt_len, ikm, ikm_len, prk);
    }
}

// ===========================================================================
// HKDF-Expand with SHA-512.
// ===========================================================================

transform hkdf_expand_sha512(prk: State<HmacKey>, info: State<HmacMsg>, info_len: u32, okm: State<HmacMsg>, okm_len: u32) {
    let t = state_new(HmacOut);
    let i: u32 = 0;
    while i < HKDF_HASH512_LEN {
        t.bytes[i] = 0;
        i = i + 1;
    }

    let t_len: u32 = 0;
    let counter: u32 = 1;
    let pos: u32 = 0;

    while pos < okm_len {
        let input_len: u32 = t_len + info_len + 1;
        let input = state_new(HmacMsg);

        i = 0;
        while i < t_len {
            input.bytes[i] = t.bytes[i];
            i = i + 1;
        }
        i = 0;
        while i < info_len {
            input.bytes[t_len + i] = info.bytes[i];
            i = i + 1;
        }
        input.bytes[t_len + info_len] = (counter & 255) as u8;

        hmac_sha512(prk, HKDF_HASH512_LEN, input, input_len, t);
        t_len = HKDF_HASH512_LEN;

        let to_copy: u32 = HKDF_HASH512_LEN;
        let remaining: u32 = okm_len - pos;
        if remaining < to_copy { to_copy = remaining; }

        i = 0;
        while i < to_copy {
            okm.bytes[pos + i] = t.bytes[i];
            i = i + 1;
        }
        pos = pos + to_copy;
        counter = counter + 1;
    }
}

// ===========================================================================
// HKDF-SHA512 (RFC 5869) — Extract + Expand in one call.
// ===========================================================================

transform hkdf_sha512(salt: State<HmacKey>, salt_len: u32, ikm: State<HmacMsg>, ikm_len: u32,
               info: State<HmacMsg>, info_len: u32, okm: State<HmacMsg>, okm_len: u32) {
    let prk = state_new(HmacOut);
    hkdf_extract_sha512(salt, salt_len, ikm, ikm_len, prk);
    let prk_key = state_new(HmacKey);
    let i: u32 = 0;
    while i < HKDF_HASH512_LEN {
        prk_key.bytes[i] = prk.bytes[i];
        i = i + 1;
    }
    hkdf_expand_sha512(prk_key, info, info_len, okm, okm_len);
}
