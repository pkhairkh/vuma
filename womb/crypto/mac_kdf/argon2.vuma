// womb/crypto/mac_kdf/argon2.vuma — Argon2id (RFC 9106)
// Memory-hard password hashing with Blake2b, the G compression function
// (P permutation + GB round), and a memory-hard fill loop. No main().
//
// VUMA 2.0 PMT-native: state_new(Layout) / State<T> / [u8;N] arrays.
// All allocate/free/Address/*ptr removed (arena auto-frees on return).
// Requires: blake2.vuma (for blake2b_init_64 / blake2b_update /
//                          blake2b_final and the Blake2bData/Blake2bDigest
//                          layouts).

const ARGON2_BLOCK_SIZE: u32 = 1024;
const ARGON2_PREHASH_DIGEST_LENGTH: u32 = 64;
const ARGON2_SYNC_POINTS: u32 = 4;
const ARGON2_VERSION: u32 = 19;          // 0x13
const ARGON2_TYPE_ID: u32 = 2;
const ARGON2_MASK32: u32 = 4294967295;
const ARGON2_MASK64: u64 = (1 << 63) | ((1 << 63) - 1);

// ===========================================================================
// Layouts
// ===========================================================================
//   Argon2Block: 1024 bytes — one Argon2 memory block (R, Z, A, B, output).
//   Argon2Buf:   8192 bytes — variable-length working buffers (param_buf,
//                seed0/seed1, h_prime inputs/outputs, final_block tag, etc.).
//   Argon2Mem:   32768 bytes (32 KiB) — the memory matrix
//                (m_prime * 1024 bytes; sufficient for m_prime <= 32, i.e.,
//                 p=1, m<=8). For larger m, enlarge this buffer.
//                NOTE: stack-probe support added to x86_64 codegen now handles
//                large stack frames > 4KB (was previously segfaulting).
layout Argon2Block = { bytes: [u8; 1024] }
layout Argon2Buf    = { bytes: [u8; 8192] }
layout Argon2Mem    = { bytes: [u8; 32768] }

// ===========================================================================
// 64-bit little-endian byte helpers (read/write a u64 lane within a block).
// ===========================================================================

transform argon2_load_u64(S: State<Argon2Block>, off: u32) -> u64 {
    let b0: u64 = S.bytes[off]     as u64;
    let b1: u64 = S.bytes[off + 1] as u64;
    let b2: u64 = S.bytes[off + 2] as u64;
    let b3: u64 = S.bytes[off + 3] as u64;
    let b4: u64 = S.bytes[off + 4] as u64;
    let b5: u64 = S.bytes[off + 5] as u64;
    let b6: u64 = S.bytes[off + 6] as u64;
    let b7: u64 = S.bytes[off + 7] as u64;
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
         | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56);
}

transform argon2_store_u64(S: State<Argon2Block>, off: u32, val: u64) {
    S.bytes[off]     = (val & 255) as u8;
    S.bytes[off + 1] = ((val >> 8)  & 255) as u8;
    S.bytes[off + 2] = ((val >> 16) & 255) as u8;
    S.bytes[off + 3] = ((val >> 24) & 255) as u8;
    S.bytes[off + 4] = ((val >> 32) & 255) as u8;
    S.bytes[off + 5] = ((val >> 40) & 255) as u8;
    S.bytes[off + 6] = ((val >> 48) & 255) as u8;
    S.bytes[off + 7] = ((val >> 56) & 255) as u8;
}

// 64-bit rotate right (no NOT, so build masks explicitly when needed).
transform argon2_rotr64(x: u64, n: u32) -> u64 {
    if n == 0 { return x; }
    return (x >> n) | (x << (64 - n));
}

// ===========================================================================
// argon2_blake2b_var — BLAKE2b over an arbitrarily long input held in
// `data: State<Argon2Buf>` (length `len` bytes, up to 8192). Streams the
// input through blake2b in 128-byte chunks (the BLAKE2b block size),
// emitting a 64-byte digest into `out: State<Blake2bDigest>`.
//
// blake2b_oneshot in blake2.vuma only accepts a single Blake2bData (128
// bytes max); this wrapper exposes blake2b_init_64 + blake2b_update +
// blake2b_final directly so argon2's h_prime and h0 derivations can hash
// longer inputs (param_buf, seed0/seed1, final_block).
// ===========================================================================

transform argon2_blake2b_var(data: State<Argon2Buf>, len: u32, out: State<Blake2bDigest>) {
    let ctx = state_new(Blake2bCtx);
    blake2b_init_64(ctx);
    // Zero ctx.buf to prevent stale arena data from corrupting the hash.
    // blake2b_init does NOT zero ctx.buf, and blake2b_final's zero-pad loop
    // has a VUMA codegen bug that skips for certain buf_len values.
    let zi: u32 = 0;
    while zi < 128 { ctx.buf[zi] = 0; zi = zi + 1; }
    let chunk = state_new(Blake2bData);
    let pos: u32 = 0;
    while pos < len {
        let to_copy: u32 = 128;
        let remaining: u32 = len - pos;
        if remaining < 128 { to_copy = remaining; }
        // Zero the chunk buffer (only the first to_copy bytes are overwritten).
        let i: u32 = 0;
        while i < 128 { chunk.data[i] = 0; i = i + 1; }
        i = 0;
        while i < to_copy {
            chunk.data[i] = data.bytes[pos + i];
            i = i + 1;
        }
        blake2b_update(ctx, chunk, to_copy);
        pos = pos + to_copy;
    }
    blake2b_final(ctx, out);
}

// Variant with variable digest length (1..64). Matches C blake2b_long's
// behavior of using digest_size=outlen for the <= 64 case.
transform argon2_blake2b_var_n(data: State<Argon2Buf>, len: u32,
                                out: State<Blake2bDigest>, dl: u32) {
    let ctx = state_new(Blake2bCtx);
    ctx.digest_len = dl;
    blake2b_init(ctx);
    // Zero ctx.buf (same reason as argon2_blake2b_var).
    let zi: u32 = 0;
    while zi < 128 { ctx.buf[zi] = 0; zi = zi + 1; }
    let chunk = state_new(Blake2bData);
    let pos: u32 = 0;
    while pos < len {
        let to_copy: u32 = 128;
        let remaining: u32 = len - pos;
        if remaining < 128 { to_copy = remaining; }
        let i: u32 = 0;
        while i < 128 { chunk.data[i] = 0; i = i + 1; }
        i = 0;
        while i < to_copy {
            chunk.data[i] = data.bytes[pos + i];
            i = i + 1;
        }
        blake2b_update(ctx, chunk, to_copy);
        pos = pos + to_copy;
    }
    blake2b_final(ctx, out);
}

// ===========================================================================
// H' — variable-length output from BLAKE2b (RFC 9106 Section 3.3 / blake2b_long).
//   For out_len <= 64:  output = BLAKE2b(out_len || input, digest_size=out_len)
//   For out_len > 64:   V_1 = BLAKE2b(out_len || input, 64)
//                       output[0..32] = V_1[0..32]
//                       toproduce = out_len - 32
//                       while toproduce > 64:
//                           V_next = BLAKE2b(V_prev, 64)
//                           output[next 32] = V_next[0..32]
//                           toproduce -= 32
//                       V_last = BLAKE2b(V_prev, digest_size=toproduce)
//                       output[remaining] = V_last
//
// input/output are caller-allocated Argon2Buf buffers (8192 bytes each,
// sufficient for any out_len <= 8192).
// ===========================================================================

transform argon2_h_prime(input: State<Argon2Buf>, input_len: u32,
                         output: State<Argon2Buf>, out_len: u32) {
    // Prefix: 4-byte little-endian out_len followed by input bytes.
    let buf = state_new(Argon2Buf);
    buf.bytes[0] = (out_len & 255) as u8;
    buf.bytes[1] = ((out_len >> 8)  & 255) as u8;
    buf.bytes[2] = ((out_len >> 16) & 255) as u8;
    buf.bytes[3] = ((out_len >> 24) & 255) as u8;
    let i: u32 = 0;
    while i < input_len {
        buf.bytes[4 + i] = input.bytes[i];
        i = i + 1;
    }
    let total: u32 = 4 + input_len;

    if out_len <= 64 {
        // BLAKE2b with digest_size = out_len (NOT 64). This matches the C
        // blake2b_long implementation which uses blake2b_init(&state, outlen).
        let tmp = state_new(Blake2bDigest);
        argon2_blake2b_var_n(buf, total, tmp, out_len);
        let k: u32 = 0;
        while k < out_len {
            output.bytes[k] = tmp.data[k];
            k = k + 1;
        }
    } else {
        // Iterative BLAKE2b per C blake2b_long:
        //   V_1 = BLAKE2b(prefix || input, 64)
        //   output[0..32] = V_1[0..32]  (only first 32 bytes!)
        //   toproduce = out_len - 32
        //   while toproduce > 64:
        //       V_next = BLAKE2b(V_prev, 64)
        //       output[next 32] = V_next[0..32]
        //       toproduce -= 32
        //   V_last = BLAKE2b(V_prev, toproduce)  (digest_size = toproduce)
        //   output[remaining] = V_last
        let v  = state_new(Argon2Buf);
        let vd = state_new(Blake2bDigest);
        let dl64: u32 = 64;
        argon2_blake2b_var_n(buf, total, vd, dl64);
        let k: u32 = 0;
        while k < 64 { v.bytes[k] = vd.data[k]; k = k + 1; }
        // Copy first 32 bytes of V_1 into output[0..32).
        k = 0;
        while k < 32 { output.bytes[k] = v.bytes[k]; k = k + 1; }

        let pos: u32 = 32;
        let toproduce: u32 = out_len - 32;
        while toproduce > 64 {
            // V_next = BLAKE2b(V_prev, 64)
            argon2_blake2b_var_n(v, 64, vd, dl64);
            k = 0;
            while k < 64 { v.bytes[k] = vd.data[k]; k = k + 1; }
            // Copy first 32 bytes of V_next
            k = 0;
            while k < 32 {
                output.bytes[pos + k] = v.bytes[k];
                k = k + 1;
            }
            pos = pos + 32;
            toproduce = toproduce - 32;
        }
        // Final: V_last = BLAKE2b(V_prev, digest_size=toproduce)
        argon2_blake2b_var_n(v, 64, vd, toproduce);
        k = 0;
        while k < toproduce {
            output.bytes[pos + k] = vd.data[k];
            k = k + 1;
        }
    }
}

// ===========================================================================
// GB — single G round on 4 u64 words stored at byte offsets a_off, b_off,
// c_off, d_off within the 1024-byte block S.  Per RFC 9106 Section 3.5.
// ===========================================================================

transform argon2_gb(S: State<Argon2Block>, a_off: u32, b_off: u32,
                                       c_off: u32, d_off: u32) {
    let a: u64 = argon2_load_u64(S, a_off);
    let b: u64 = argon2_load_u64(S, b_off);
    let c: u64 = argon2_load_u64(S, c_off);
    let d: u64 = argon2_load_u64(S, d_off);

    let mut_a: u64 = a;
    let mut_b: u64 = b;
    let mut_c: u64 = c;
    let mut_d: u64 = d;

    let a_lo: u64 = mut_a & ARGON2_MASK32;
    let b_lo: u64 = mut_b & ARGON2_MASK32;
    let c_lo: u64 = mut_c & ARGON2_MASK32;
    let d_lo: u64 = mut_d & ARGON2_MASK32;

    mut_a = mut_a + mut_b + 2 * (a_lo * b_lo);
    mut_d = argon2_rotr64(mut_d ^ mut_a, 32);
    let c_lo2: u64 = mut_c & ARGON2_MASK32;
    let d_lo2: u64 = mut_d & ARGON2_MASK32;
    mut_c = mut_c + mut_d + 2 * (c_lo2 * d_lo2);
    mut_b = argon2_rotr64(mut_b ^ mut_c, 24);
    let a_lo3: u64 = mut_a & ARGON2_MASK32;
    let b_lo3: u64 = mut_b & ARGON2_MASK32;
    mut_a = mut_a + mut_b + 2 * (a_lo3 * b_lo3);
    mut_d = argon2_rotr64(mut_d ^ mut_a, 16);
    let c_lo4: u64 = mut_c & ARGON2_MASK32;
    let d_lo4: u64 = mut_d & ARGON2_MASK32;
    mut_c = mut_c + mut_d + 2 * (c_lo4 * d_lo4);
    mut_b = argon2_rotr64(mut_b ^ mut_c, 63);

    argon2_store_u64(S, a_off, mut_a);
    argon2_store_u64(S, b_off, mut_b);
    argon2_store_u64(S, c_off, mut_c);
    argon2_store_u64(S, d_off, mut_d);
}

// ===========================================================================
// P — apply the BLAKE2b P permutation to a 16-word sub-block (128 bytes)
// of S starting at byte offset `off`. 8 GB rounds (4 column + 4 diagonal).
//
// VUMA 2.0 note: GB reads/writes lanes via byte offsets within the 1024-byte
// block; we precompute the 16 offsets up-front (LITERAL where possible, with
// `off + k*8` derived indices).
// ===========================================================================

transform argon2_p(S: State<Argon2Block>, off: u32) {
    let w0:  u32 = off + 0;
    let w1:  u32 = off + 8;
    let w2:  u32 = off + 16;
    let w3:  u32 = off + 24;
    let w4:  u32 = off + 32;
    let w5:  u32 = off + 40;
    let w6:  u32 = off + 48;
    let w7:  u32 = off + 56;
    let w8:  u32 = off + 64;
    let w9:  u32 = off + 72;
    let w10: u32 = off + 80;
    let w11: u32 = off + 88;
    let w12: u32 = off + 96;
    let w13: u32 = off + 104;
    let w14: u32 = off + 112;
    let w15: u32 = off + 120;

    // Column rounds
    argon2_gb(S, w0, w4, w8,  w12);
    argon2_gb(S, w1, w5, w9,  w13);
    argon2_gb(S, w2, w6, w10, w14);
    argon2_gb(S, w3, w7, w11, w15);
    // Diagonal rounds
    argon2_gb(S, w0, w5, w10, w15);
    argon2_gb(S, w1, w6, w11, w12);
    argon2_gb(S, w2, w7, w8,  w13);
    argon2_gb(S, w3, w4, w9,  w14);
}

// ===========================================================================
// Copy 8 bytes from src.bytes[off..off+7] into dst.bytes[off2..off2+7].
// Both buffers are Argon2Block (1024 bytes).
// ===========================================================================

transform argon2_load_to_buf(src: State<Argon2Block>, off: u32,
                             dst: State<Argon2Block>, off2: u32) {
    let k: u32 = 0;
    while k < 8 {
        dst.bytes[off2 + k] = src.bytes[off + k];
        k = k + 1;
    }
}

transform argon2_store_from_buf(dst: State<Argon2Block>, off: u32,
                                src: State<Argon2Block>, off2: u32) {
    let k: u32 = 0;
    while k < 8 {
        dst.bytes[off + k] = src.bytes[off2 + k];
        k = k + 1;
    }
}

// ===========================================================================
// G — compression function (RFC 9106 Section 3.5).
//   1. R = A XOR B  (1024 bytes)
//   2. Z = R
//   3. Apply P to Z row-wise (8 rows of 128 bytes each)
//   4. Apply P to Z column-wise (8 column pairs, each gathering 128 bytes)
//   5. Output = Z XOR R
// ===========================================================================

transform argon2_g(a: State<Argon2Block>, b: State<Argon2Block>,
                   out: State<Argon2Block>) {
    let r = state_new(Argon2Block);
    let z = state_new(Argon2Block);

    // R = A XOR B
    let i: u32 = 0;
    while i < ARGON2_BLOCK_SIZE {
        let av: u32 = a.bytes[i] as u32;
        let bv: u32 = b.bytes[i] as u32;
        r.bytes[i] = ((av ^ bv) & 255) as u8;
        i = i + 1;
    }
    // Z = R
    let k: u32 = 0;
    while k < ARGON2_BLOCK_SIZE {
        z.bytes[k] = r.bytes[k];
        k = k + 1;
    }

    // Row-wise: 8 rows of 128 bytes each (16 u64 words).
    let row: u32 = 0;
    while row < 8 {
        argon2_p(z, row * 128);
        row = row + 1;
    }
    // Column-wise: 8 column pairs. Each pair gathers 2 columns × 8 rows =
    // 16 words = 128 bytes. Word layout: word indices 2*i, 2*i+1, 2*i+16,
    // 2*i+17, 2*i+32, 2*i+33, ..., 2*i+112, 2*i+113 (each word = 8 bytes).
    let ci: u32 = 0;
    while ci < 8 {
        let col_buf = state_new(Argon2Block);
        let kk: u32 = 0;
        while kk < 8 {
            let src_off_lo: u32 = (2 * ci + 2 * kk * 8) * 8;
            let src_off_hi: u32 = src_off_lo + 8;
            argon2_load_to_buf(z, src_off_lo, col_buf, 2 * kk * 8);
            argon2_load_to_buf(z, src_off_hi, col_buf, 2 * kk * 8 + 8);
            kk = kk + 1;
        }
        argon2_p(col_buf, 0);
        // Scatter back
        kk = 0;
        while kk < 8 {
            let dst_off_lo: u32 = (2 * ci + 2 * kk * 8) * 8;
            let dst_off_hi: u32 = dst_off_lo + 8;
            argon2_store_from_buf(z, dst_off_lo, col_buf, 2 * kk * 8);
            argon2_store_from_buf(z, dst_off_hi, col_buf, 2 * kk * 8 + 8);
            kk = kk + 1;
        }
        ci = ci + 1;
    }

    // Output = Z XOR R
    let j: u32 = 0;
    while j < ARGON2_BLOCK_SIZE {
        let zv: u32 = z.bytes[j] as u32;
        let rv: u32 = r.bytes[j] as u32;
        out.bytes[j] = ((zv ^ rv) & 255) as u8;
        j = j + 1;
    }
}

// ===========================================================================
// Read 8 little-endian bytes from a memory matrix at byte offset `base`.
// The memory matrix is a State<Argon2Mem>; we copy the 8 bytes into a
// scratch State<Argon2Block> and reuse argon2_load_u64.
// ===========================================================================

transform argon2_load_u64_mem(mem: State<Argon2Mem>, base: u32) -> u64 {
    let b0: u64 = mem.bytes[base]     as u64;
    let b1: u64 = mem.bytes[base + 1] as u64;
    let b2: u64 = mem.bytes[base + 2] as u64;
    let b3: u64 = mem.bytes[base + 3] as u64;
    let b4: u64 = mem.bytes[base + 4] as u64;
    let b5: u64 = mem.bytes[base + 5] as u64;
    let b6: u64 = mem.bytes[base + 6] as u64;
    let b7: u64 = mem.bytes[base + 7] as u64;
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
         | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56);
}

// ===========================================================================
// Compute the reference block index using the index_alpha algorithm from
// the official Argon2 reference C implementation (core.c:index_alpha).
//
// Inputs:
//   pass, slice, index (position in segment), same_lane (ref_lane == lane),
//   segment_length, lane_length, pseudo_rand (J1, the low 32 bits).
// ===========================================================================

transform argon2_index_alpha(pass: u32, slice: u32, index: u32,
                             same_lane: u32, segment_length: u32,
                             lane_length: u32, pseudo_rand: u32) -> u32 {
    let reference_area_size: u32;
    if pass == 0 {
        if slice == 0 {
            reference_area_size = index - 1;
        } else {
            if same_lane == 1 {
                reference_area_size = slice * segment_length + index - 1;
            } else {
                if index == 0 {
                    // Underflow-safe: equivalent to (slice * segment_length - 1)
                    // but only when index == 0; we use the same formula as the C
                    // code (which casts -1 to u32 = 0xFFFFFFFF, then adds 0 below).
                    // To match exactly, set reference_area_size = slice*segment_length - 1.
                    reference_area_size = slice * segment_length - 1;
                } else {
                    reference_area_size = slice * segment_length;
                }
            }
        }
    } else {
        // Pass > 0
        if same_lane == 1 {
            reference_area_size = lane_length - segment_length + index - 1;
        } else {
            if index == 0 {
                reference_area_size = lane_length - segment_length - 1;
            } else {
                reference_area_size = lane_length - segment_length;
            }
        }
    }
    // Guard against underflow (shouldn't happen for valid params, but be safe).
    if reference_area_size > lane_length { reference_area_size = 0; }

    // relative_position = pseudo_rand
    // relative_position = (relative_position * relative_position) >> 32
    // relative_position = reference_area_size - 1 -
    //                     ((reference_area_size * relative_position) >> 32)
    let pr64: u64 = pseudo_rand as u64;
    let rel_pos: u64 = (pr64 * pr64) >> 32;
    let scaled: u64 = (reference_area_size as u64 * rel_pos) >> 32;
    let rel_pos_final: u64 = (reference_area_size as u64) - 1 - scaled;
    let rel_pos_u32: u32 = rel_pos_final & ARGON2_MASK32;

    // start_position
    let start_position: u32 = 0;
    if pass != 0 {
        if slice == ARGON2_SYNC_POINTS - 1 {
            start_position = 0;
        } else {
            start_position = (slice + 1) * segment_length;
        }
    }

    let absolute: u32 = (start_position + rel_pos_u32) % lane_length;
    return absolute;
}

// ===========================================================================
// Initialize the input block for data-independent address generation.
// The input block is a 1024-byte Argon2Block (128 u64 words). Words 0-5 hold
// pass, lane, slice, memory_blocks, passes, type. Word 6 is the counter
// (incremented before each address block generation).
// ===========================================================================

transform argon2_init_input_block(input_block: State<Argon2Block>,
                                  pass: u32, lane: u32, slice: u32,
                                  m_prime: u32, t: u32) {
    // Zero the entire block first.
    let zi: u32 = 0;
    while zi < ARGON2_BLOCK_SIZE {
        input_block.bytes[zi] = 0;
        zi = zi + 1;
    }
    // v[0] = pass (u64 at bytes 0..7)
    argon2_store_u64(input_block, 0,  pass as u64);
    // v[1] = lane
    argon2_store_u64(input_block, 8,  lane as u64);
    // v[2] = slice
    argon2_store_u64(input_block, 16, slice as u64);
    // v[3] = memory_blocks (= m')
    argon2_store_u64(input_block, 24, m_prime as u64);
    // v[4] = passes (= t)
    argon2_store_u64(input_block, 32, t as u64);
    // v[5] = type (= ARGON2_TYPE_ID = 2)
    argon2_store_u64(input_block, 40, ARGON2_TYPE_ID as u64);
    // v[6] = 0 (counter, will be incremented by argon2_next_addresses)
}

// ===========================================================================
// Generate the next address block via two G calls (RFC 9106 / ref.c:next_addresses).
//   input_block.v[6]++
//   address_block  = G(zero_block, input_block)
//   address_block  = G(zero_block, address_block)
// ===========================================================================

transform argon2_next_addresses(address_block: State<Argon2Block>,
                                input_block: State<Argon2Block>,
                                zero_block: State<Argon2Block>) {
    // Increment counter (v[6] at byte offset 48).
    let ctr: u64 = argon2_load_u64(input_block, 48);
    argon2_store_u64(input_block, 48, ctr + 1);
    // address_block = G(zero_block, input_block)
    argon2_g(zero_block, input_block, address_block);
    // address_block = G(zero_block, address_block)
    let tmp = state_new(Argon2Block);
    argon2_g(zero_block, address_block, tmp);
    // Copy tmp -> address_block
    let ci: u32 = 0;
    while ci < ARGON2_BLOCK_SIZE {
        address_block.bytes[ci] = tmp.bytes[ci];
        ci = ci + 1;
    }
}

// ===========================================================================
// Copy a 1024-byte slice of the memory matrix into a State<Argon2Block>.
// ===========================================================================

transform argon2_mem_to_block(mem: State<Argon2Mem>, base: u32,
                              blk: State<Argon2Block>) {
    let i: u32 = 0;
    while i < ARGON2_BLOCK_SIZE {
        blk.bytes[i] = mem.bytes[base + i];
        i = i + 1;
    }
}

// Copy a 1024-byte State<Argon2Block> back into the memory matrix.
transform argon2_block_to_mem(blk: State<Argon2Block>,
                              mem: State<Argon2Mem>, base: u32) {
    let i: u32 = 0;
    while i < ARGON2_BLOCK_SIZE {
        mem.bytes[base + i] = blk.bytes[i];
        i = i + 1;
    }
}

// ===========================================================================
// Argon2id — RFC 9106.
//   password:  user password bytes (Argon2Buf; first pass_len bytes used)
//   pass_len:  password length
//   salt:      random salt bytes (Argon2Buf; first salt_len bytes used)
//   salt_len:  salt length
//   t:         time cost (iterations)
//   m:         memory cost (KiB)
//   p:         parallelism (lanes)
//   out:       output buffer (Argon2Buf; first out_len bytes written)
//   out_len:   desired output length (tag length)
// ===========================================================================

transform argon2id(password: State<Argon2Buf>, pass_len: u32,
                   salt: State<Argon2Buf>, salt_len: u32,
                   t: u32, m: u32, p: u32,
                   out: State<Argon2Buf>, out_len: u32) {
    // 1. Build H0 input = p || tau || m || t || v || y || pass_len || password
    //                       || salt_len || salt || 0 || 0 || 0 || 0
    let param_buf = state_new(Argon2Buf);
    param_buf.bytes[0]  = (p & 255) as u8;
    param_buf.bytes[1]  = ((p >> 8)  & 255) as u8;
    param_buf.bytes[2]  = ((p >> 16) & 255) as u8;
    param_buf.bytes[3]  = ((p >> 24) & 255) as u8;
    param_buf.bytes[4]  = (out_len & 255) as u8;
    param_buf.bytes[5]  = ((out_len >> 8)  & 255) as u8;
    param_buf.bytes[6]  = ((out_len >> 16) & 255) as u8;
    param_buf.bytes[7]  = ((out_len >> 24) & 255) as u8;
    param_buf.bytes[8]  = (m & 255) as u8;
    param_buf.bytes[9]  = ((m >> 8)  & 255) as u8;
    param_buf.bytes[10] = ((m >> 16) & 255) as u8;
    param_buf.bytes[11] = ((m >> 24) & 255) as u8;
    param_buf.bytes[12] = (t & 255) as u8;
    param_buf.bytes[13] = ((t >> 8)  & 255) as u8;
    param_buf.bytes[14] = ((t >> 16) & 255) as u8;
    param_buf.bytes[15] = ((t >> 24) & 255) as u8;
    param_buf.bytes[16] = (ARGON2_VERSION & 255) as u8;
    param_buf.bytes[17] = 0;
    param_buf.bytes[18] = 0;
    param_buf.bytes[19] = 0;
    param_buf.bytes[20] = (ARGON2_TYPE_ID & 255) as u8;
    param_buf.bytes[21] = 0;
    param_buf.bytes[22] = 0;
    param_buf.bytes[23] = 0;

    // H0 input per RFC 9106 Section 3.4:
    //   p || tau || m || t || v || y || |P| || P || |S| || S || |K| || K || |AD| || AD
    // The |P| field (password length, 4 bytes LE) MUST come before the password bytes.
    let mut_pos: u32 = 24;
    // Write |P| (password length, 4 bytes LE)
    param_buf.bytes[mut_pos]     = (pass_len & 255) as u8;
    param_buf.bytes[mut_pos + 1] = ((pass_len >> 8)  & 255) as u8;
    param_buf.bytes[mut_pos + 2] = ((pass_len >> 16) & 255) as u8;
    param_buf.bytes[mut_pos + 3] = ((pass_len >> 24) & 255) as u8;
    mut_pos = mut_pos + 4;
    // Write P (password bytes)
    let i: u32 = 0;
    while i < pass_len {
        param_buf.bytes[mut_pos] = password.bytes[i];
        mut_pos = mut_pos + 1;
        i = i + 1;
    }
    // Write |S| (salt length, 4 bytes LE)
    param_buf.bytes[mut_pos]     = (salt_len & 255) as u8;
    param_buf.bytes[mut_pos + 1] = ((salt_len >> 8)  & 255) as u8;
    param_buf.bytes[mut_pos + 2] = ((salt_len >> 16) & 255) as u8;
    param_buf.bytes[mut_pos + 3] = ((salt_len >> 24) & 255) as u8;
    mut_pos = mut_pos + 4;
    // Write S (salt bytes)
    let j: u32 = 0;
    while j < salt_len {
        param_buf.bytes[mut_pos] = salt.bytes[j];
        mut_pos = mut_pos + 1;
        j = j + 1;
    }
    // Write |K| (key length = 0, 4 bytes LE)
    param_buf.bytes[mut_pos]     = 0;
    param_buf.bytes[mut_pos + 1]  = 0;
    param_buf.bytes[mut_pos + 2]  = 0;
    param_buf.bytes[mut_pos + 3]  = 0;
    mut_pos = mut_pos + 4;
    param_buf.bytes[mut_pos]     = 0;
    param_buf.bytes[mut_pos + 1]  = 0;
    param_buf.bytes[mut_pos + 2]  = 0;
    param_buf.bytes[mut_pos + 3]  = 0;
    mut_pos = mut_pos + 4;

    // H0 = BLAKE2b(param_buf, digest_size=64) — NO h_prime prefix.
    // The C reference (core.c:initial_hash) uses blake2b_init(&state, 64)
    // directly, NOT blake2b_long. So we use argon2_blake2b_var (which does
    // plain BLAKE2b with digest_size=64) instead of argon2_h_prime.
    let h0 = state_new(Argon2Buf);
    let h0_digest = state_new(Blake2bDigest);
    argon2_blake2b_var(param_buf, mut_pos, h0_digest);
    let h0k: u32 = 0;
    while h0k < 64 { h0.bytes[h0k] = h0_digest.data[h0k]; h0k = h0k + 1; }

    // 2. Memory: m' = m rounded down to nearest multiple of 4*p.
    let mut_m_prime: u32 = (m / (4 * p)) * (4 * p);
    if mut_m_prime < 8 * p { mut_m_prime = 8 * p; }
    let lane_length: u32 = mut_m_prime / p;

    let mem = state_new(Argon2Mem);

    // 3. Compute B[lane][0] and B[lane][1] from H0.
    let lane: u32 = 0;
    while lane < p {
        let seed0 = state_new(Argon2Buf);
        let k: u32 = 0;
        while k < 64 { seed0.bytes[k] = h0.bytes[k]; k = k + 1; }
        seed0.bytes[64] = 0; seed0.bytes[65] = 0;
        seed0.bytes[66] = 0; seed0.bytes[67] = 0;
        seed0.bytes[68] = (lane & 255) as u8;
        seed0.bytes[69] = ((lane >> 8)  & 255) as u8;
        seed0.bytes[70] = ((lane >> 16) & 255) as u8;
        seed0.bytes[71] = ((lane >> 24) & 255) as u8;
        let blk0 = state_new(Argon2Buf);
        let seed_len: u32 = 72;
        let blk_out_len: u32 = ARGON2_BLOCK_SIZE;
        argon2_h_prime(seed0, seed_len, blk0, blk_out_len);
        argon2_block_to_mem_helper(blk0, mem, lane * lane_length * ARGON2_BLOCK_SIZE);

        let seed1 = state_new(Argon2Buf);
        let kk: u32 = 0;
        while kk < 64 { seed1.bytes[kk] = h0.bytes[kk]; kk = kk + 1; }
        seed1.bytes[64] = 1; seed1.bytes[65] = 0;
        seed1.bytes[66] = 0; seed1.bytes[67] = 0;
        seed1.bytes[68] = (lane & 255) as u8;
        seed1.bytes[69] = ((lane >> 8)  & 255) as u8;
        seed1.bytes[70] = ((lane >> 16) & 255) as u8;
        seed1.bytes[71] = ((lane >> 24) & 255) as u8;
        let blk1 = state_new(Argon2Buf);
        argon2_h_prime(seed1, seed_len, blk1, blk_out_len);
        argon2_block_to_mem_helper(blk1, mem,
            (lane * lane_length + 1) * ARGON2_BLOCK_SIZE);
        lane = lane + 1;
    }

    // 4. Fill remaining blocks using proper sync-point (slice) iteration.
    //    Per RFC 9106 / ref.c:fill_segment:
    //      - For Argon2id pass 0, slices 0 and 1 use data-INDEPENDENT addressing
    //        (address block generated from input_block counter).
    //      - All other (slice >= 2 in pass 0, all slices in pass > 0) use
    //        data-DEPENDENT addressing (J1, J2 from first 8 bytes of prev block).
    //      - For pass > 0, the new block is XORed into the existing block (with_xor=1).
    //      - For pass 0, the new block overwrites (with_xor=0).
    //      - prev_offset wraps to the last block of the lane when curr_offset
    //        is at the start of a lane (curr_offset % lane_length == 0).
    let segment_length: u32 = lane_length / ARGON2_SYNC_POINTS;

    let iter: u32 = 0;
    while iter < t {
        let sl: u32 = 0;
        while sl < ARGON2_SYNC_POINTS {
            let ln: u32 = 0;
            while ln < p {
                // Data-independent for Argon2id pass 0, slices 0..1
                let data_indep: u32 = 0;
                if iter == 0 {
                    if sl < 2 { data_indep = 1; }
                }

                // Pre-allocate address-generation state for this slice.
                let address_block = state_new(Argon2Block);
                let input_block   = state_new(Argon2Block);
                let zero_block    = state_new(Argon2Block);
                if data_indep == 1 {
                    // Zero the zero_block.
                    let zi: u32 = 0;
                    while zi < ARGON2_BLOCK_SIZE {
                        zero_block.bytes[zi] = 0;
                        zi = zi + 1;
                    }
                    argon2_init_input_block(input_block, iter, ln, sl, mut_m_prime, t);
                    // Generate the first address block.
                    argon2_next_addresses(address_block, input_block, zero_block);
                }

                // starting_index: 2 for pass 0, slice 0 (blocks 0, 1 precomputed); else 0.
                let starting_index: u32 = 0;
                if iter == 0 {
                    if sl == 0 { starting_index = 2; }
                }

                // curr_offset = lane * lane_length + slice * segment_length + starting_index
                let curr_offset: u32 = ln * lane_length + sl * segment_length + starting_index;
                // prev_offset: if curr is at start of lane, wrap to last block.
                let prev_offset: u32;
                if (curr_offset % lane_length) == 0 {
                    prev_offset = curr_offset + lane_length - 1;
                } else {
                    prev_offset = curr_offset - 1;
                }

                // Loop over blocks in this segment.
                let i: u32 = starting_index;
                while i < segment_length {
                    // 1. Rotating prev_offset if curr_offset % lane_length == 1
                    if (curr_offset % lane_length) == 1 {
                        prev_offset = curr_offset - 1;
                    }

                    // 2. Get pseudo_rand (J1 in low 32, J2 in high 32 of a u64).
                    let pseudo_rand: u64;
                    if data_indep == 1 {
                        // Use address_block.v[i] (u64 at byte offset i*8).
                        // Generate new address block every 128 blocks (ARGON2_ADDRESSES_IN_BLOCK).
                        // For segment_length <= 128 (our test cases), one block suffices.
                        pseudo_rand = argon2_load_u64(address_block, i * 8);
                    } else {
                        // Read first 8 bytes of prev block from memory matrix.
                        let prev_byte_off: u32 = prev_offset * ARGON2_BLOCK_SIZE;
                        pseudo_rand = argon2_load_u64_mem(mem, prev_byte_off);
                    }

                    // 3. ref_lane = (pseudo_rand >> 32) % p
                    //    But for pass 0, slice 0: ref_lane = lane (forced).
                    let ref_lane: u32 = ((pseudo_rand >> 32) & ARGON2_MASK32) % p;
                    if iter == 0 {
                        if sl == 0 { ref_lane = ln; }
                    }

                    // 4. ref_index via index_alpha.
                    let j1: u32 = pseudo_rand & ARGON2_MASK32;
                    let same_lane: u32 = 0;
                    if ref_lane == ln { same_lane = 1; }
                    let ref_index: u32 = argon2_index_alpha(iter, sl, i, same_lane,
                                                           segment_length, lane_length, j1);

                    // 5. Compute new block = G(prev_block, ref_block).
                    let prev_byte_off: u32 = prev_offset * ARGON2_BLOCK_SIZE;
                    let ref_byte_off: u32 = (ref_lane * lane_length + ref_index) * ARGON2_BLOCK_SIZE;
                    let curr_byte_off: u32 = curr_offset * ARGON2_BLOCK_SIZE;
                    let blk_prev = state_new(Argon2Block);
                    let blk_ref  = state_new(Argon2Block);
                    let blk_out  = state_new(Argon2Block);
                    argon2_mem_to_block(mem, prev_byte_off, blk_prev);
                    argon2_mem_to_block(mem, ref_byte_off,  blk_ref);
                    argon2_g(blk_prev, blk_ref, blk_out);

                    // 6. Write back. For pass 0: overwrite. For pass > 0: XOR into existing.
                    if iter == 0 {
                        argon2_block_to_mem(blk_out, mem, curr_byte_off);
                    } else {
                        // XOR blk_out into existing mem[curr_byte_off].
                        let blk_cur = state_new(Argon2Block);
                        argon2_mem_to_block(mem, curr_byte_off, blk_cur);
                        let xi: u32 = 0;
                        while xi < ARGON2_BLOCK_SIZE {
                            let cur_v: u32 = blk_cur.bytes[xi] as u32;
                            let out_v: u32 = blk_out.bytes[xi] as u32;
                            blk_cur.bytes[xi] = ((cur_v ^ out_v) & 255) as u8;
                            xi = xi + 1;
                        }
                        argon2_block_to_mem(blk_cur, mem, curr_byte_off);
                    }

                    curr_offset = curr_offset + 1;
                    prev_offset = prev_offset + 1;
                    i = i + 1;
                }
                ln = ln + 1;
            }
            sl = sl + 1;
        }
        iter = iter + 1;
    }

    // 5. Final block: XOR the last block of each lane into a 1024-byte buf.
    let final_block = state_new(Argon2Buf);
    let fi: u32 = 0;
    while fi < ARGON2_BLOCK_SIZE { final_block.bytes[fi] = 0; fi = fi + 1; }
    let ln2: u32 = 0;
    while ln2 < p {
        let last_off: u32 = (ln2 * lane_length + lane_length - 1) * ARGON2_BLOCK_SIZE;
        let fb_blk = state_new(Argon2Block);
        argon2_mem_to_block(mem, last_off, fb_blk);
        let gi: u32 = 0;
        while gi < ARGON2_BLOCK_SIZE {
            let cur: u32 = final_block.bytes[gi] as u32;
            let nw: u32 = fb_blk.bytes[gi] as u32;
            final_block.bytes[gi] = ((cur ^ nw) & 255) as u8;
            gi = gi + 1;
        }
        ln2 = ln2 + 1;
    }

    // 6. Output = H'(final_block, out_len).
    let fb_len: u32 = ARGON2_BLOCK_SIZE;
    argon2_h_prime(final_block, fb_len, out, out_len);
}

// ===========================================================================
// argon2_block_to_mem_helper — copy a 1024-byte Argon2Buf (used as a block
// carrier for h_prime outputs whose out_len == ARGON2_BLOCK_SIZE) into the
// memory matrix. The Argon2Buf holds the block in bytes[0..1024); the rest
// is unused.
// ===========================================================================

transform argon2_block_to_mem_helper(blk: State<Argon2Buf>,
                                     mem: State<Argon2Mem>, base: u32) {
    let i: u32 = 0;
    while i < ARGON2_BLOCK_SIZE {
        mem.bytes[base + i] = blk.bytes[i];
        i = i + 1;
    }
}
