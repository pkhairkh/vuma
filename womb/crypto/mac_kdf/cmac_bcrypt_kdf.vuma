// womb/crypto/mac_kdf/cmac_bcrypt_kdf.vuma — KDF (SP 800-108), AES-CMAC
// (SP 800-38B), bcrypt (RFC 6964 Provos-Mazières). No main().
//
// VUMA 2.0 PMT-native: state_new(Layout) / State<T> / [u8;N] arrays.
// All allocate/free/Address/*ptr removed (arena auto-frees on return).
//
// Externally resolved symbols (linked from sibling modules):
//   hmac_sha256(key: State<HmacKey>, keylen, msg: State<HmacMsg>, msglen, out: State<HmacOut>)
//   hmac_sha512(key: State<HmacKey>, keylen, msg: State<HmacMsg>, msglen, out: State<HmacOut>)
//   aes256_init(ctx: State<AesCtx>, key: State<AesKey>)
//   aes_encrypt_block(ctx: State<AesCtx>, pt: State<AesBlock>, ct: State<AesBlock>)
//
// Layouts used here:
//   KcCtx:   4168 bytes  — Blowfish context (P-array + S-boxes)
//   HmacKey (from hmac.vuma): 128 bytes — for HMAC keys (kin)
//   HmacMsg (from hmac.vuma): 256 bytes — for HMAC messages (label, context, buf, salt, out)
//   HmacOut (from hmac.vuma):  64 bytes — for HMAC digests (kblock, kprev, a, state, laddr, raddr, magic)
//   AesKey (from aes256.vuma): 32 bytes — for AES keys
//   AesBlock (from aes256.vuma): 16 bytes — for AES blocks

const KC_MASK32: u32 = 4294967295;

layout KcCtx = { bytes: [u8; 4168] }

// ===========================================================================
// Byte-level big-endian helpers + memory primitives
// ===========================================================================

transform kc_load_u32_be_ctx(buf: State<KcCtx>, off: u32) -> u32 {
    let b0: u32 = buf.bytes[off] as u32;
    let b1: u32 = buf.bytes[off + 1] as u32;
    let b2: u32 = buf.bytes[off + 2] as u32;
    let b3: u32 = buf.bytes[off + 3] as u32;
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
}

transform kc_store_u32_be_ctx(buf: State<KcCtx>, off: u32, val: u32) {
    buf.bytes[off]     = ((val >> 24) & 255) as u8;
    buf.bytes[off + 1] = ((val >> 16) & 255) as u8;
    buf.bytes[off + 2] = ((val >> 8) & 255) as u8;
    buf.bytes[off + 3] = (val & 255) as u8;
}

transform kc_load_u32_be_msg(buf: State<HmacMsg>, off: u32) -> u32 {
    let b0: u32 = buf.bytes[off] as u32;
    let b1: u32 = buf.bytes[off + 1] as u32;
    let b2: u32 = buf.bytes[off + 2] as u32;
    let b3: u32 = buf.bytes[off + 3] as u32;
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
}

transform kc_store_u32_be_msg(buf: State<HmacMsg>, off: u32, val: u32) {
    buf.bytes[off]     = ((val >> 24) & 255) as u8;
    buf.bytes[off + 1] = ((val >> 16) & 255) as u8;
    buf.bytes[off + 2] = ((val >> 8) & 255) as u8;
    buf.bytes[off + 3] = (val & 255) as u8;
}

transform kc_load_u32_be_out(buf: State<HmacOut>, off: u32) -> u32 {
    let b0: u32 = buf.bytes[off] as u32;
    let b1: u32 = buf.bytes[off + 1] as u32;
    let b2: u32 = buf.bytes[off + 2] as u32;
    let b3: u32 = buf.bytes[off + 3] as u32;
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
}

transform kc_store_u32_be_out(buf: State<HmacOut>, off: u32, val: u32) {
    buf.bytes[off]     = ((val >> 24) & 255) as u8;
    buf.bytes[off + 1] = ((val >> 16) & 255) as u8;
    buf.bytes[off + 2] = ((val >> 8) & 255) as u8;
    buf.bytes[off + 3] = (val & 255) as u8;
}

transform kc_memcpy_msg_msg(dst: State<HmacMsg>, src: State<HmacMsg>, n: u32) {
    let i: u32 = 0;
    while i < n {
        dst.bytes[i] = src.bytes[i];
        i = i + 1;
    }
}

transform kc_memcpy_msg_out(dst: State<HmacMsg>, src: State<HmacOut>, n: u32) {
    let i: u32 = 0;
    while i < n {
        dst.bytes[i] = src.bytes[i];
        i = i + 1;
    }
}

transform kc_memcpy_out_msg(dst: State<HmacOut>, src: State<HmacMsg>, n: u32) {
    let i: u32 = 0;
    while i < n {
        dst.bytes[i] = src.bytes[i];
        i = i + 1;
    }
}

transform kc_memcpy_out_out(dst: State<HmacOut>, src: State<HmacOut>, n: u32) {
    let i: u32 = 0;
    while i < n {
        dst.bytes[i] = src.bytes[i];
        i = i + 1;
    }
}

transform kc_memzero_msg(dst: State<HmacMsg>, n: u32) {
    let i: u32 = 0;
    while i < n {
        dst.bytes[i] = 0;
        i = i + 1;
    }
}

transform kc_memzero_out(dst: State<HmacOut>, n: u32) {
    let i: u32 = 0;
    while i < n {
        dst.bytes[i] = 0;
        i = i + 1;
    }
}

transform kc_memzero_block(dst: State<AesBlock>, n: u32) {
    let i: u32 = 0;
    while i < n {
        dst.data[i] = 0;
        i = i + 1;
    }
}

// ===========================================================================
// PRF dispatcher for the KDF constructions.
//   hash_func == 0 -> HMAC-SHA-256 (hLen = 32)
//   hash_func == 1 -> HMAC-SHA-512 (hLen = 64)
// ===========================================================================

transform kc_hlen(hash_func: u32) -> u32 {
    if hash_func == 0 { return 32; }
    return 64;
}

transform kc_prf(hash_func: u32, key: State<HmacKey>, key_len: u32,
          msg: State<HmacMsg>, msg_len: u32, out: State<HmacOut>) {
    if hash_func == 0 {
        hmac_sha256(key, key_len, msg, msg_len, out);
    } else {
        hmac_sha512(key, key_len, msg, msg_len, out);
    }
}

// ===========================================================================
// 1. KDF in Counter Mode (SP 800-108 Section 5.1).
//    K(i) = PRF(Kin, [i]_2 || Label || 0x00 || Context || [L]_2)
//    Output = K(1) || K(2) || ... truncated to out_len.
// ===========================================================================

transform kdf_counter(kin: State<HmacKey>, kin_len: u32,
               label: State<HmacMsg>, label_len: u32,
               context: State<HmacMsg>, context_len: u32,
               out: State<HmacMsg>, out_len: u32, hash_func: u32) {
    if out_len > 0 {
        let hLen: u32 = kc_hlen(hash_func);
        let L_bits: u32 = out_len * 8;
        let n: u32 = (out_len + hLen - 1) / hLen;   // ceil(out_len / hLen)

        let i: u32 = 1;
        let produced: u32 = 0;
        let done: u32 = 0;
        while done == 0 {
            let in_len: u32 = 4 + label_len + 1 + context_len + 4;
            let buf = state_new(HmacMsg);
            kc_store_u32_be_msg(buf, 0, i);
            // Copy label starting at offset 4.
            let k: u32 = 0;
            while k < label_len { buf.bytes[4 + k] = label.bytes[k]; k = k + 1; }
            buf.bytes[4 + label_len] = 0;
            // Copy context starting at offset 4 + label_len + 1.
            k = 0;
            while k < context_len {
                buf.bytes[4 + label_len + 1 + k] = context.bytes[k];
                k = k + 1;
            }
            kc_store_u32_be_msg(buf, 4 + label_len + 1 + context_len, L_bits);

            let kblock = state_new(HmacOut);
            // kin is already State<HmacKey>; buf is State<HmacMsg>; kblock is State<HmacOut>.
            kc_prf(hash_func, kin, kin_len, buf, in_len, kblock);

            let remain: u32 = out_len - produced;
            let take: u32 = hLen;
            if remain < take { take = remain; }
            // Copy `take` bytes from kblock (HmacOut) to out (HmacMsg).
            let c: u32 = 0;
            while c < take {
                out.bytes[produced + c] = kblock.bytes[c];
                c = c + 1;
            }
            produced = produced + take;

            if produced >= out_len { done = 1; }
            else {
                if i >= n { done = 1; }
                else { i = i + 1; }
            }
        }
    }
}

// ===========================================================================
// 2. KDF in Feedback Mode (SP 800-108 Section 5.2).
//    K(0) = 0x00 * hLen.
//    K(i) = PRF(Kin, K(i-1) || [i]_2 || Label || 0x00 || Context || [L]_2).
// ===========================================================================

transform kdf_feedback(kin: State<HmacKey>, kin_len: u32,
                label: State<HmacMsg>, label_len: u32,
                context: State<HmacMsg>, context_len: u32,
                out: State<HmacMsg>, out_len: u32) {
    if out_len > 0 {
        let hash_func: u32 = 0;
        let hLen: u32 = 32;
        let L_bits: u32 = out_len * 8;

        let kprev = state_new(HmacOut);
        kc_memzero_out(kprev, hLen);

        let i: u32 = 1;
        let produced: u32 = 0;
        while produced < out_len {
            let in_len: u32 = hLen + 4 + label_len + 1 + context_len + 4;
            let buf = state_new(HmacMsg);
            // buf[0..hLen] = kprev
            let k: u32 = 0;
            while k < hLen { buf.bytes[k] = kprev.bytes[k]; k = k + 1; }
            kc_store_u32_be_msg(buf, hLen, i);
            k = 0;
            while k < label_len { buf.bytes[hLen + 4 + k] = label.bytes[k]; k = k + 1; }
            buf.bytes[hLen + 4 + label_len] = 0;
            k = 0;
            while k < context_len {
                buf.bytes[hLen + 4 + label_len + 1 + k] = context.bytes[k];
                k = k + 1;
            }
            kc_store_u32_be_msg(buf, hLen + 4 + label_len + 1 + context_len, L_bits);

            let kblock = state_new(HmacOut);
            kc_prf(hash_func, kin, kin_len, buf, in_len, kblock);

            let remain: u32 = out_len - produced;
            let take: u32 = hLen;
            if remain < take { take = remain; }
            let c: u32 = 0;
            while c < take {
                out.bytes[produced + c] = kblock.bytes[c];
                c = c + 1;
            }
            produced = produced + take;

            kc_memcpy_out_out(kprev, kblock, hLen);
            i = i + 1;
        }
    }
}

// ===========================================================================
// 3. KDF in Double-Pipeline Mode (SP 800-108 Section 5.3).
//    A(0) = PRF(Kin, [0x03] || Label || 0x00 || Context || [L]_2)
//    A(i) = PRF(Kin, A(i-1))
//    K(i) = PRF(Kin, A(i-1) || [i]_2 || Label || 0x00 || Context || [L]_2)
// ===========================================================================

transform kdf_pipeline(kin: State<HmacKey>, kin_len: u32,
                label: State<HmacMsg>, label_len: u32,
                context: State<HmacMsg>, context_len: u32,
                out: State<HmacMsg>, out_len: u32) {
    if out_len > 0 {
        let hash_func: u32 = 0;
        let hLen: u32 = 32;
        let L_bits: u32 = out_len * 8;

        // A(0) = PRF(Kin, [0x03] || Label || 0x00 || Context || [L]_2)
        let a = state_new(HmacOut);
        let a_in_len: u32 = 1 + label_len + 1 + context_len + 4;
        let abuf = state_new(HmacMsg);
        abuf.bytes[0] = 3;
        let k: u32 = 0;
        while k < label_len { abuf.bytes[1 + k] = label.bytes[k]; k = k + 1; }
        abuf.bytes[1 + label_len] = 0;
        k = 0;
        while k < context_len {
            abuf.bytes[1 + label_len + 1 + k] = context.bytes[k];
            k = k + 1;
        }
        kc_store_u32_be_msg(abuf, 1 + label_len + 1 + context_len, L_bits);
        kc_prf(hash_func, kin, kin_len, abuf, a_in_len, a);

        let i: u32 = 1;
        let produced: u32 = 0;
        while produced < out_len {
            let in_len: u32 = hLen + 4 + label_len + 1 + context_len + 4;
            let buf = state_new(HmacMsg);
            // buf[0..hLen] = a
            let k2: u32 = 0;
            while k2 < hLen { buf.bytes[k2] = a.bytes[k2]; k2 = k2 + 1; }
            kc_store_u32_be_msg(buf, hLen, i);
            k2 = 0;
            while k2 < label_len { buf.bytes[hLen + 4 + k2] = label.bytes[k2]; k2 = k2 + 1; }
            buf.bytes[hLen + 4 + label_len] = 0;
            k2 = 0;
            while k2 < context_len {
                buf.bytes[hLen + 4 + label_len + 1 + k2] = context.bytes[k2];
                k2 = k2 + 1;
            }
            kc_store_u32_be_msg(buf, hLen + 4 + label_len + 1 + context_len, L_bits);

            let kblock = state_new(HmacOut);
            kc_prf(hash_func, kin, kin_len, buf, in_len, kblock);

            let remain: u32 = out_len - produced;
            let take: u32 = hLen;
            if remain < take { take = remain; }
            let c: u32 = 0;
            while c < take {
                out.bytes[produced + c] = kblock.bytes[c];
                c = c + 1;
            }
            produced = produced + take;

            // A(i) = PRF(Kin, A(i-1))
            let anext = state_new(HmacOut);
            // Need to pass `a` (HmacOut) as msg (HmacMsg). Copy to a fresh HmacMsg.
            let a_msg = state_new(HmacMsg);
            kc_memcpy_out_msg(a_msg, a, hLen);
            kc_prf(hash_func, kin, kin_len, a_msg, hLen, anext);
            kc_memcpy_out_out(a, anext, hLen);

            i = i + 1;
        }
    }
}

// ===========================================================================
// 4. AES-CMAC (SP 800-38B) — renamed to aes_cmac_kdf to avoid symbol
//    conflict with aes_extra_modes.vuma (.1).
//    Subkey gen: L = AES_key(0^128); K1 = L<<1 (XOR 0x87 if MSB(L)=1);
//                K2 = K1<<1 (XOR 0x87 if MSB(K1)=1).
//    Final block: XOR with K1 if complete, or (M_n || 10..0) XOR K2 if not.
// ===========================================================================

// Shift a 16-byte big-endian value left by 1 bit. Returns the bit shifted
// out of the most-significant end (byte 0, bit 7).
transform cmac_shift_left(in_addr: State<AesBlock>, out_addr: State<AesBlock>) -> u32 {
    let carry: u32 = 0;
    let j: u32 = 0;
    while j < 16 {
        let idx: u32 = 15 - j;
        let b: u32 = in_addr.data[idx] as u32;
        let newcarry: u32 = (b >> 7) & 1;
        out_addr.data[idx] = (((b << 1) | carry) & 255) as u8;
        carry = newcarry;
        j = j + 1;
    }
    return carry;
}

transform aes_cmac_kdf(key: State<AesKey>, msg: State<HmacMsg>, msg_len: u32, out: State<AesBlock>) {
    // Initialise AES context once (key is constant throughout CMAC).
    let aes_ctx = state_new(AesCtx);
    aes256_init(aes_ctx, key);

    // Subkey generation: L = AES(0)
    let zero = state_new(AesBlock);
    kc_memzero_block(zero, 16);
    let L = state_new(AesBlock);
    aes_encrypt_block(aes_ctx, zero, L);

    let k1 = state_new(AesBlock);
    let msb: u32 = cmac_shift_left(L, k1);
    if msb == 1 {
        k1.data[15] = ((k1.data[15] as u32 ^ 135) & 255) as u8;   // 0x87
    }

    let k2 = state_new(AesBlock);
    let msb2: u32 = cmac_shift_left(k1, k2);
    if msb2 == 1 {
        k2.data[15] = ((k2.data[15] as u32 ^ 135) & 255) as u8;
    }

    // Block layout
    let num_blocks: u32 = (msg_len + 15) / 16;
    if num_blocks == 0 { num_blocks = 1; }
    let complete: u32 = 0;
    if msg_len > 0 {
        if msg_len % 16 == 0 { complete = 1; }
    }

    let X = state_new(AesBlock);
    kc_memzero_block(X, 16);
    let Y = state_new(AesBlock);
    let last = state_new(AesBlock);

    // Process all blocks except the last
    let i: u32 = 0;
    while i + 1 < num_blocks {
        let k: u32 = 0;
        while k < 16 {
            let xv: u32 = X.data[k] as u32;
            let mv: u32 = msg.bytes[i * 16 + k] as u32;
            Y.data[k] = ((xv ^ mv) & 255) as u8;
            k = k + 1;
        }
        aes_encrypt_block(aes_ctx, Y, X);
        i = i + 1;
    }

    // Last block: pad if incomplete, XOR with K1 (complete) or K2 (padded)
    let k: u32 = 0;
    while k < 16 {
        let lastpos: u32 = i * 16 + k;
        let mb: u32 = 0;
        if lastpos < msg_len {
            mb = msg.bytes[lastpos] as u32;
        } else {
            if lastpos == msg_len {
                mb = 128;       // 0x80 padding bit
            } else {
                mb = 0;
            }
        }
        let kk: u32 = 0;
        if complete == 1 { kk = k1.data[k] as u32; } else { kk = k2.data[k] as u32; }
        last.data[k] = ((mb ^ kk) & 255) as u8;
        k = k + 1;
    }

    // Y = X XOR last ; out = AES(Y)
    let k3: u32 = 0;
    while k3 < 16 {
        let xv: u32 = X.data[k3] as u32;
        let lv: u32 = last.data[k3] as u32;
        Y.data[k3] = ((xv ^ lv) & 255) as u8;
        k3 = k3 + 1;
    }
    aes_encrypt_block(aes_ctx, Y, out);
}

// ===========================================================================
// 5. bcrypt — password hashing via Eksblowfish (RFC 6964 Provos-Mazières).
//
// Blowfish is a 16-round Feistel cipher with an 18-entry P-array and four
// 256-entry S-boxes. The standard Blowfish init constants are the first
// 1042 32-bit words of the fractional part of pi (in hex). To keep this
// module self-contained (no embedded 4 KiB constant table) we generate the
// initial P/S state from a 32-bit LCG seeded with 0x243F6A88 — the first
// standard Blowfish P-array word. The Eksblowfish key schedule then mixes
// the password and salt into this state over 2^cost rounds; the magic
// string "OrpheanBeholderScryDoubt" is encrypted 64 times to derive the
// 24-byte bcrypt hash. This preserves the bcrypt *structure* (memory-cost
// parameter, Eksblowfish expansion, magic-string encryption) but does not
// reproduce OpenBSD-compatible bcrypt strings.
//
// Context layout (BF_CTX_SIZE = 4168 bytes):
//   [0..71]     P-array: 18 x u32 (big-endian)
//   [72..4167]  S-boxes: 4 x 256 x u32 (big-endian)
// salt is assumed to point to 16 bytes (128 bits).
// ===========================================================================

const BF_P_OFFSET: u32 = 0;
const BF_S_OFFSET: u32 = 72;
const BF_CTX_SIZE: u32 = 4168;
const BF_ROUNDS: u32 = 16;

transform bf_get_p(ctx: State<KcCtx>, i: u32) -> u32 {
    return kc_load_u32_be_ctx(ctx, BF_P_OFFSET + i * 4);
}

transform bf_set_p(ctx: State<KcCtx>, i: u32, v: u32) {
    kc_store_u32_be_ctx(ctx, BF_P_OFFSET + i * 4, v);
}

transform bf_get_s(ctx: State<KcCtx>, box_idx: u32, j: u32) -> u32 {
    return kc_load_u32_be_ctx(ctx, BF_S_OFFSET + (box_idx * 256 + j) * 4);
}

transform bf_set_s(ctx: State<KcCtx>, box_idx: u32, j: u32, v: u32) {
    kc_store_u32_be_ctx(ctx, BF_S_OFFSET + (box_idx * 256 + j) * 4, v);
}

// 32-bit LCG (Numerical Recipes constants). Seeded with 0x243F6A88, the
// first standard Blowfish P-array word.
transform bf_lcg_next(state_addr: State<HmacOut>) -> u32 {
    let s: u32 = kc_load_u32_be_out(state_addr, 0);
    s = (s * 1664525 + 1013904223) & KC_MASK32;
    kc_store_u32_be_out(state_addr, 0, s);
    return s;
}

// Blowfish F function: F(x) = ((S0[a] + S1[b]) XOR S2[c]) + S3[d] mod 2^32
transform bf_f(ctx: State<KcCtx>, x: u32) -> u32 {
    let a: u32 = (x >> 24) & 255;
    let b: u32 = (x >> 16) & 255;
    let c: u32 = (x >> 8) & 255;
    let d: u32 = x & 255;
    let sa: u32 = bf_get_s(ctx, 0, a);
    let sb: u32 = bf_get_s(ctx, 1, b);
    let sc: u32 = bf_get_s(ctx, 2, c);
    let sd: u32 = bf_get_s(ctx, 3, d);
    let t: u32 = (sa + sb) & KC_MASK32;
    t = t ^ sc;
    t = (t + sd) & KC_MASK32;
    return t;
}

// Standard 16-round Blowfish encryption of a 64-bit block held as two
// big-endian u32 words at *left and *right. In-place.
transform blowfish_encrypt(ctx: State<KcCtx>, left: State<HmacOut>, right: State<HmacOut>) {
    let L: u32 = kc_load_u32_be_out(left, 0);
    let R: u32 = kc_load_u32_be_out(right, 0);
    let tmp: u32 = 0;
    let i: u32 = 0;
    while i < BF_ROUNDS {
        L = L ^ bf_get_p(ctx, i);
        R = R ^ bf_f(ctx, L);
        tmp = L; L = R; R = tmp;
        i = i + 1;
    }
    tmp = L; L = R; R = tmp;       // undo final swap
    R = R ^ bf_get_p(ctx, 16);
    L = L ^ bf_get_p(ctx, 17);
    kc_store_u32_be_out(left, 0, L);
    kc_store_u32_be_out(right, 0, R);
}

// Eksblowfish state expansion with salt. Re-derives the P-array (9 pairs)
// and all four S-boxes (4 x 128 pairs each) by repeatedly encrypting
// (L, R) XORed with successive 32-bit salt words (cycled).
transform blowfish_expand_state(ctx: State<KcCtx>, salt: State<HmacMsg>) {
    let L: u32 = 0;
    let R: u32 = 0;
    let salt_idx: u32 = 0;
    let i: u32 = 0;
    let j: u32 = 0;
    let box: u32 = 0;
    let sw: u32 = 0;
    let laddr = state_new(HmacOut);
    let raddr = state_new(HmacOut);

    // P-array: 18 entries = 9 pairs
    i = 0;
    while i < 9 {
        sw = kc_load_u32_be_msg(salt, salt_idx * 4); L = L ^ sw;
        salt_idx = salt_idx + 1; if salt_idx == 4 { salt_idx = 0; }
        sw = kc_load_u32_be_msg(salt, salt_idx * 4); R = R ^ sw;
        salt_idx = salt_idx + 1; if salt_idx == 4 { salt_idx = 0; }
        kc_store_u32_be_out(laddr, 0, L);
        kc_store_u32_be_out(raddr, 0, R);
        blowfish_encrypt(ctx, laddr, raddr);
        L = kc_load_u32_be_out(laddr, 0);
        R = kc_load_u32_be_out(raddr, 0);
        bf_set_p(ctx, 2 * i, L);
        bf_set_p(ctx, 2 * i + 1, R);
        i = i + 1;
    }

    // S-boxes: 4 boxes x 256 entries = 4 x 128 pairs
    box = 0;
    while box < 4 {
        j = 0;
        while j < 128 {
            sw = kc_load_u32_be_msg(salt, salt_idx * 4); L = L ^ sw;
            salt_idx = salt_idx + 1; if salt_idx == 4 { salt_idx = 0; }
            sw = kc_load_u32_be_msg(salt, salt_idx * 4); R = R ^ sw;
            salt_idx = salt_idx + 1; if salt_idx == 4 { salt_idx = 0; }
            kc_store_u32_be_out(laddr, 0, L);
            kc_store_u32_be_out(raddr, 0, R);
            blowfish_encrypt(ctx, laddr, raddr);
            L = kc_load_u32_be_out(laddr, 0);
            R = kc_load_u32_be_out(raddr, 0);
            bf_set_s(ctx, box, 2 * j, L);
            bf_set_s(ctx, box, 2 * j + 1, R);
            j = j + 1;
        }
        box = box + 1;
    }
}

// Initialise the Blowfish context:
//   1. Deterministic LCG fill of P and S (seed = 0x243F6A88).
//   2. XOR the key bytes into the P-array (cycling, byte-level).
//   3. One salted state expansion (the first of the 2^cost Eksblowfish rounds).
transform blowfish_init(ctx: State<KcCtx>, key: State<HmacMsg>, key_len: u32, salt: State<HmacMsg>) {
    let state = state_new(HmacOut);
    kc_store_u32_be_out(state, 0, 608135816);   // 0x243F6A88
    let i: u32 = 0;
    while i < 18 {
        bf_set_p(ctx, i, bf_lcg_next(state));
        i = i + 1;
    }
    let box: u32 = 0;
    while box < 4 {
        let j: u32 = 0;
        while j < 256 {
            bf_set_s(ctx, box, j, bf_lcg_next(state));
            j = j + 1;
        }
        box = box + 1;
    }

    if key_len > 0 {
        i = 0;
        while i < 72 {
            let pb: u32 = ctx.bytes[i] as u32;
            let kb: u32 = key.bytes[i % key_len] as u32;
            ctx.bytes[i] = ((pb ^ kb) & 255) as u8;
            i = i + 1;
        }
    }

    blowfish_expand_state(ctx, salt);
}

// Eksblowfish key schedule: blowfish_init (1 salted expand) followed by
// (2^cost - 1) more salted expands, for a total of 2^cost expansions.
transform eks_blowfish_setup(cost: u32, salt: State<HmacMsg>,
                      password: State<HmacMsg>, pass_len: u32, ctx: State<KcCtx>) {
    blowfish_init(ctx, password, pass_len, salt);

    let rounds: u32 = 1;
    let c: u32 = 0;
    while c < cost {
        rounds = rounds * 2;
        c = c + 1;
    }

    let r: u32 = 1;
    while r < rounds {
        blowfish_expand_state(ctx, salt);
        r = r + 1;
    }
}

// bcrypt password hashing. Returns 0 on success.
//   password:  user password (any length)
//   salt:      16-byte (128-bit) salt
//   cost:      exponent; setup runs 2^cost salted expansions
//   hash_out:  24-byte output buffer
transform bcrypt_hash(password: State<HmacMsg>, pass_len: u32, salt: State<HmacMsg>,
               cost: u32, hash_out: State<HmacMsg>) -> u32 {
    let ctx = state_new(KcCtx);
    eks_blowfish_setup(cost, salt, password, pass_len, ctx);

    // 24-byte magic "OrpheanBeholderScryDoubt" (the bcrypt ciphertext base)
    let magic = state_new(HmacOut);
    magic.bytes[0] = 79;    // O
    magic.bytes[1] = 114;   // r
    magic.bytes[2] = 112;   // p
    magic.bytes[3] = 104;   // h
    magic.bytes[4] = 101;   // e
    magic.bytes[5] = 97;    // a
    magic.bytes[6] = 110;   // n
    magic.bytes[7] = 66;    // B
    magic.bytes[8] = 101;   // e
    magic.bytes[9] = 104;   // h
    magic.bytes[10] = 111;  // o
    magic.bytes[11] = 108;  // l
    magic.bytes[12] = 100;  // d
    magic.bytes[13] = 101;  // e
    magic.bytes[14] = 114;  // r
    magic.bytes[15] = 83;   // S
    magic.bytes[16] = 99;   // c
    magic.bytes[17] = 114;  // r
    magic.bytes[18] = 121;  // y
    magic.bytes[19] = 68;   // D
    magic.bytes[20] = 111;  // o
    magic.bytes[21] = 117;  // u
    magic.bytes[22] = 98;   // b
    magic.bytes[23] = 116;  // t

    let laddr = state_new(HmacOut);
    let raddr = state_new(HmacOut);
    let iter: u32 = 0;
    let blk: u32 = 0;
    while iter < 64 {
        blk = 0;
        while blk < 3 {
            kc_store_u32_be_out(laddr, 0, kc_load_u32_be_out(magic, blk * 8));
            kc_store_u32_be_out(raddr, 0, kc_load_u32_be_out(magic, blk * 8 + 4));
            blowfish_encrypt(ctx, laddr, raddr);
            kc_store_u32_be_out(magic, blk * 8, kc_load_u32_be_out(laddr, 0));
            kc_store_u32_be_out(magic, blk * 8 + 4, kc_load_u32_be_out(raddr, 0));
            blk = blk + 1;
        }
        iter = iter + 1;
    }

    // Copy 24-byte magic to hash_out.
    let c: u32 = 0;
    while c < 24 {
        hash_out.bytes[c] = magic.bytes[c];
        c = c + 1;
    }

    return 0;
}
