// ═══════════════════════════════════════════════════════════════════════════
// womb/crypto/symmetric/aes_cfb_ofb.vuma — AES CFB and OFB Modes (NIST SP800-38A)
// PMT-native rewrite (W2-B2).
// ═══════════════════════════════════════════════════════════════════════════
//
// Implements CFB-128 and OFB modes using the AES-128 core from
// womb/crypto/symmetric/aes128.vuma (W2-A1).
//
// NIST SP800-38A test vectors (Appendix F):
//   Key: 2b7e151628aed2a6abf7158809cf4f3c
//   IV:  000102030405060708090a0b0c0d0e0f
//   Plaintext (4 blocks): same as ECB/CBC/CTR

import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/aes128.vuma"::{AesCtx, AesBlock, AesKey, aes128_init, aes_encrypt_block, aes_decrypt_block};

// ===========================================================================
// Layouts
// ===========================================================================

layout CfbOfbBuf = { bytes: [u8; 64] }
layout CfbOfbIv = { bytes: [u8; 16] }

// ===========================================================================
// CFB-128 mode (Cipher Feedback, 128-bit segment)
// ===========================================================================

// C[0] = P[0] XOR E(k, IV)
// C[i] = P[i] XOR E(k, C[i-1])
transform aes_cfb128_encrypt(ctx: State<AesCtx>, iv: State<CfbOfbIv>, pt: State<CfbOfbBuf>, ct: State<CfbOfbBuf>, num_blocks: u32) {
    let feedback = state_new(AesBlock);
    let ks = state_new(AesBlock);

    // Initialize feedback = IV
    let j: u32 = 0;
    while j < 16 {
        feedback.data[j] = iv.bytes[j];
        j = j + 1;
    }

    let i: u32 = 0;
    while i < num_blocks {
        let off = i * 16;
        // Generate keystream: E(k, feedback)
        aes_encrypt_block(ctx, feedback, ks);
        // C[i] = P[i] XOR keystream
        let k: u32 = 0;
        while k < 16 {
            ct.bytes[off + k] = pt.bytes[off + k] ^ ks.data[k];
            k = k + 1;
        }
        // Update feedback = C[i]
        k = 0;
        while k < 16 {
            feedback.data[k] = ct.bytes[off + k];
            k = k + 1;
        }
        i = i + 1;
    }
}

// CFB-128 decrypt: P[i] = C[i] XOR E(k, C[i-1])
transform aes_cfb128_decrypt(ctx: State<AesCtx>, iv: State<CfbOfbIv>, ct: State<CfbOfbBuf>, pt: State<CfbOfbBuf>, num_blocks: u32) {
    let feedback = state_new(AesBlock);
    let ks = state_new(AesBlock);

    let j: u32 = 0;
    while j < 16 {
        feedback.data[j] = iv.bytes[j];
        j = j + 1;
    }

    let i: u32 = 0;
    while i < num_blocks {
        let off = i * 16;
        // Generate keystream: E(k, feedback)
        aes_encrypt_block(ctx, feedback, ks);
        // P[i] = C[i] XOR keystream
        let k: u32 = 0;
        while k < 16 {
            pt.bytes[off + k] = ct.bytes[off + k] ^ ks.data[k];
            k = k + 1;
        }
        // Update feedback = C[i] (for next block)
        k = 0;
        while k < 16 {
            feedback.data[k] = ct.bytes[off + k];
            k = k + 1;
        }
        i = i + 1;
    }
}

// ===========================================================================
// OFB mode (Output Feedback)
// ===========================================================================

// O[0] = E(k, IV)
// O[i] = E(k, O[i-1])
// C[i] = P[i] XOR O[i]
transform aes_ofb_crypt(ctx: State<AesCtx>, iv: State<CfbOfbIv>, data: State<CfbOfbBuf>, num_blocks: u32) {
    let feedback = state_new(AesBlock);
    let ks = state_new(AesBlock);

    // Initialize feedback = IV
    let j: u32 = 0;
    while j < 16 {
        feedback.data[j] = iv.bytes[j];
        j = j + 1;
    }

    let i: u32 = 0;
    while i < num_blocks {
        let off = i * 16;
        // Generate keystream: E(k, feedback)
        aes_encrypt_block(ctx, feedback, ks);
        // C[i] = P[i] XOR keystream
        let k: u32 = 0;
        while k < 16 {
            data.bytes[off + k] = data.bytes[off + k] ^ ks.data[k];
            k = k + 1;
        }
        // Update feedback = keystream (NOT ciphertext — this is OFB, not CFB)
        k = 0;
        while k < 16 {
            feedback.data[k] = ks.data[k];
            k = k + 1;
        }
        i = i + 1;
    }
}
