// womb/crypto/symmetric/aes192.vuma — AES-192 (NIST FIPS 197)
// 192-bit key (24 bytes, Nk=6), 12 rounds, 208-byte round key schedule.
// PMT-native rewrite (W2-A2). Includes encrypt AND decrypt (inverse cipher).
//
// PMT patterns (per W48 sha.vuma / W1-A md5.vuma):
//   - state_new(Layout) for allocations (NEVER allocate/free/Address/*ptr)
//   - State<T> for transform parameters that take pointers
//   - [u8; N] byte arrays with LITERAL indices for state load/store
//   - Precompute loop-variable indices into local vars (let off = i * 4;)
//     before array access (avoids v0.2.0-alpha.15 param-index codegen bug)
//   - S-box / inverse S-box stored as [u8; 256] fields in AesCtx
//   - add_round_key inlined into encrypt/decrypt (avoids passing round as
//     a function parameter — the index-offset-as-param codegen bug)
//   - Separate gmul2/gmul3/gmul9/gmul11/gmul13/gmul14 transforms (avoids
//     the shared-function-with-literal-args codegen bug)
//   - Decimal literals for all S-box values
//
// No main() — importable library module.

const MASK32: u32 = 4294967295;

// ===========================================================================
// Layouts
// ===========================================================================

// AES context: round-key schedule (max 240 bytes for AES-256), round count,
// and the 256-byte S-box + inverse S-box tables embedded directly (avoids
// passing a separate tables state to every round function — compiler-bug
// workaround #3: store parameters as fields in the context layout).
layout AesCtx = {
    round_keys: [u8; 240],
    rounds: u32,
    sbox: [u8; 256],
    inv_sbox: [u8; 256],
}

// AES block (16 bytes = 128 bits — the AES block size for all key sizes).
layout AesBlock = { data: [u8; 16] }

// AES key (max 32 bytes for AES-256; AES-128 uses [0..15], AES-192 [0..23]).
layout AesKey = { data: [u8; 32] }

