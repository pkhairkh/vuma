// ===========================================================================
// GF(2^8) arithmetic helpers (FIPS 197 §4.2 — xtime = multiply by 2)
// ===========================================================================

// xtime(a) = a * 2 in GF(2^8), with the AES reduction polynomial x^8+x^4+x^3+x+1.
transform aes_xtime(a: u32) -> u32 {
    let hi = (a >> 7) & 1;
    let result = (a << 1) & 255;
    if hi == 1 { result = result ^ 27; }
    return result;
}

// Precomputed GF(2^8) multipliers for MixColumns / InvMixColumns.
// Each is a separate transform (no literal multiplier parameter) to avoid
// the shared-function-with-literal-args codegen bug (workaround #3).
transform aes_gmul2(x: u32) -> u32 {
    return aes_xtime(x) & 255;
}
transform aes_gmul3(x: u32) -> u32 {
    return (aes_xtime(x) ^ x) & 255;
}
transform aes_gmul9(x: u32) -> u32 {
    let x2 = aes_xtime(x);
    let x4 = aes_xtime(x2);
    let x8 = aes_xtime(x4);
    return (x8 ^ x) & 255;
}
transform aes_gmul11(x: u32) -> u32 {
    let x2 = aes_xtime(x);
    let x4 = aes_xtime(x2);
    let x8 = aes_xtime(x4);
    return (x8 ^ x2 ^ x) & 255;
}
transform aes_gmul13(x: u32) -> u32 {
    let x2 = aes_xtime(x);
    let x4 = aes_xtime(x2);
    let x8 = aes_xtime(x4);
    return (x8 ^ x4 ^ x) & 255;
}
transform aes_gmul14(x: u32) -> u32 {
    let x2 = aes_xtime(x);
    let x4 = aes_xtime(x2);
    let x8 = aes_xtime(x4);
    return (x8 ^ x4 ^ x2) & 255;
}

// ===========================================================================
// AES round functions (FIPS 197 §5.1.1 — operate on the 16-byte state)
// ===========================================================================

// SubBytes: replace each state byte with its S-box entry.
transform aes_sub_bytes(ctx: State<AesCtx>, state: State<AesBlock>) {
    let i: u32 = 0;
    while i < 16 {
        let idx = state.data[i] as u32;
        state.data[i] = ctx.sbox[idx];
        i = i + 1;
    }
}

// InvSubBytes: replace each state byte with its inverse S-box entry.
transform aes_inv_sub_bytes(ctx: State<AesCtx>, state: State<AesBlock>) {
    let i: u32 = 0;
    while i < 16 {
        let idx = state.data[i] as u32;
        state.data[i] = ctx.inv_sbox[idx];
        i = i + 1;
    }
}

// ShiftRows: cyclic left-shift of each row by its row index.
// State is column-major: byte[r + 4*c] where r=row, c=col.
//   Row 0: no shift. Row 1: shift left 1. Row 2: shift left 2. Row 3: shift left 3.
transform aes_shift_rows(state: State<AesBlock>) {
    // Row 1: [1,5,9,13] -> [5,9,13,1]
    let t1: u32 = state.data[1] as u32;
    state.data[1] = state.data[5];
    state.data[5] = state.data[9];
    state.data[9] = state.data[13];
    state.data[13] = t1 as u8;
    // Row 2: [2,6,10,14] -> [10,14,2,6]
    let t2: u32 = state.data[2] as u32;
    state.data[2] = state.data[10];
    state.data[10] = t2 as u8;
    let t6: u32 = state.data[6] as u32;
    state.data[6] = state.data[14];
    state.data[14] = t6 as u8;
    // Row 3: [3,7,11,15] -> [15,3,7,11]
    let t15: u32 = state.data[15] as u32;
    state.data[15] = state.data[11];
    state.data[11] = state.data[7];
    state.data[7] = state.data[3];
    state.data[3] = t15 as u8;
}

// InvShiftRows: cyclic right-shift of each row by its row index.
transform aes_inv_shift_rows(state: State<AesBlock>) {
    // Row 1: [1,5,9,13] -> [13,1,5,9]
    let t13: u32 = state.data[13] as u32;
    state.data[13] = state.data[9];
    state.data[9] = state.data[5];
    state.data[5] = state.data[1];
    state.data[1] = t13 as u8;
    // Row 2: [2,6,10,14] -> [10,14,2,6]
    let t2: u32 = state.data[2] as u32;
    state.data[2] = state.data[10];
    state.data[10] = t2 as u8;
    let t6: u32 = state.data[6] as u32;
    state.data[6] = state.data[14];
    state.data[14] = t6 as u8;
    // Row 3: [3,7,11,15] -> [7,11,15,3]
    let t3: u32 = state.data[3] as u32;
    state.data[3] = state.data[7];
    state.data[7] = state.data[11];
    state.data[11] = state.data[15];
    state.data[15] = t3 as u8;
}

// MixColumns: transform each column via the GF(2^8) matrix {02,03,01,01}.
// Uses the optimized xtime formula: s'_i = s_i ^ t ^ xtime(s_i ^ s_{i+1})
// where t = s0 ^ s1 ^ s2 ^ s3 (column XOR).
transform aes_mix_columns(state: State<AesBlock>) {
    let c: u32 = 0;
    while c < 4 {
        let off = c * 4;
        let s0 = state.data[off] as u32;
        let s1 = state.data[off + 1] as u32;
        let s2 = state.data[off + 2] as u32;
        let s3 = state.data[off + 3] as u32;
        let t = (s0 ^ s1 ^ s2 ^ s3) & 255;
        state.data[off]     = ((s0 ^ t ^ aes_xtime(s0 ^ s1)) & 255) as u8;
        state.data[off + 1] = ((s1 ^ t ^ aes_xtime(s1 ^ s2)) & 255) as u8;
        state.data[off + 2] = ((s2 ^ t ^ aes_xtime(s2 ^ s3)) & 255) as u8;
        state.data[off + 3] = ((s3 ^ t ^ aes_xtime(s3 ^ s0)) & 255) as u8;
        c = c + 1;
    }
}

// InvMixColumns: transform each column via the GF(2^8) matrix {0e,0b,0d,09}.
transform aes_inv_mix_columns(state: State<AesBlock>) {
    let c: u32 = 0;
    while c < 4 {
        let off = c * 4;
        let s0 = state.data[off] as u32;
        let s1 = state.data[off + 1] as u32;
        let s2 = state.data[off + 2] as u32;
        let s3 = state.data[off + 3] as u32;
        state.data[off]     = ((aes_gmul14(s0) ^ aes_gmul11(s1) ^ aes_gmul13(s2) ^ aes_gmul9(s3)) & 255) as u8;
        state.data[off + 1] = ((aes_gmul9(s0)  ^ aes_gmul14(s1) ^ aes_gmul11(s2) ^ aes_gmul13(s3)) & 255) as u8;
        state.data[off + 2] = ((aes_gmul13(s0) ^ aes_gmul9(s1)  ^ aes_gmul14(s2) ^ aes_gmul11(s3)) & 255) as u8;
        state.data[off + 3] = ((aes_gmul11(s0) ^ aes_gmul13(s1) ^ aes_gmul9(s2)  ^ aes_gmul14(s3)) & 255) as u8;
        c = c + 1;
    }
}

// ===========================================================================
// AES-192 Key Expansion (FIPS 197 §5.2 — Nk=6, Nr=12, 52 words = 208 bytes)
// Copy 6 key words; for i=6..51: temp = w[i-1]; if i%6==0:
//   temp = SubWord(RotWord(temp)) XOR Rcon[i/6]; w[i] = w[i-6] XOR temp.
// ===========================================================================
transform aes192_init(ctx: State<AesCtx>, key: State<AesKey>) {
    aes192_load_sbox(ctx);
    aes192_load_inv_sbox(ctx);
    ctx.rounds = 12;

    // Copy the 24-byte (6-word) key into the first 6 round-key words.
    let i: u32 = 0;
    while i < 24 {
        ctx.round_keys[i] = key.data[i];
        i = i + 1;
    }

    // Expand words 6 .. 51 (46 more words = 184 bytes).
    let rcon: u32 = 1;
    i = 6;
    while i < 52 {
        let prev_off = (i - 1) * 4;
        let t0 = ctx.round_keys[prev_off] as u32;
        let t1 = ctx.round_keys[prev_off + 1] as u32;
        let t2 = ctx.round_keys[prev_off + 2] as u32;
        let t3 = ctx.round_keys[prev_off + 3] as u32;

        if i % 6 == 0 {
            // RotWord: rotate left by one byte.
            let tmp = t0;
            let nt0 = t1;
            let nt1 = t2;
            let nt2 = t3;
            let nt3 = tmp;
            // SubWord: apply S-box to each byte.
            let st0 = ctx.sbox[nt0] as u32;
            let st1 = ctx.sbox[nt1] as u32;
            let st2 = ctx.sbox[nt2] as u32;
            let st3 = ctx.sbox[nt3] as u32;
            t0 = st0 ^ rcon;
            t1 = st1;
            t2 = st2;
            t3 = st3;
            rcon = aes_xtime(rcon);
        }

        let woff = (i - 6) * 4;
        let w0 = ctx.round_keys[woff] as u32;
        let w1 = ctx.round_keys[woff + 1] as u32;
        let w2 = ctx.round_keys[woff + 2] as u32;
        let w3 = ctx.round_keys[woff + 3] as u32;

        let doff = i * 4;
        ctx.round_keys[doff]     = ((w0 ^ t0) & 255) as u8;
        ctx.round_keys[doff + 1] = ((w1 ^ t1) & 255) as u8;
        ctx.round_keys[doff + 2] = ((w2 ^ t2) & 255) as u8;
        ctx.round_keys[doff + 3] = ((w3 ^ t3) & 255) as u8;

        i = i + 1;
    }
}

// ===========================================================================
// AES encrypt one 16-byte block (FIPS 197 §5.1, §7.1)
// AddRoundKey(0); for round 1..Nr-1: SubBytes, ShiftRows, MixColumns, AddRoundKey;
// final: SubBytes, ShiftRows, AddRoundKey(Nr).
//
// AddRoundKey is inlined (not a separate transform) to avoid passing `round`
// as a function parameter — the index-offset-as-param codegen bug (see
// md5.vuma's workaround note).
// ===========================================================================
transform aes_encrypt_block(ctx: State<AesCtx>, pt: State<AesBlock>, ct: State<AesBlock>) {
    // Copy plaintext to working state (ct doubles as the working buffer).
    let i: u32 = 0;
    while i < 16 {
        ct.data[i] = pt.data[i];
        i = i + 1;
    }

    // AddRoundKey(0) — inlined.
    let j: u32 = 0;
    while j < 16 {
        let sj = ct.data[j] as u32;
        let rj = ctx.round_keys[j] as u32;
        ct.data[j] = ((sj ^ rj) & 255) as u8;
        j = j + 1;
    }

    // Rounds 1 .. Nr-1.
    let round: u32 = 1;
    while round < ctx.rounds {
        aes_sub_bytes(ctx, ct);
        aes_shift_rows(ct);
        aes_mix_columns(ct);
        // AddRoundKey(round) — inlined.
        let off = round * 16;
        let k: u32 = 0;
        while k < 16 {
            let sk = ct.data[k] as u32;
            let rk = ctx.round_keys[off + k] as u32;
            ct.data[k] = ((sk ^ rk) & 255) as u8;
            k = k + 1;
        }
        round = round + 1;
    }

    // Final round (no MixColumns).
    aes_sub_bytes(ctx, ct);
    aes_shift_rows(ct);
    // AddRoundKey(Nr) — inlined.
    let final_off = ctx.rounds * 16;
    let m: u32 = 0;
    while m < 16 {
        let sm = ct.data[m] as u32;
        let rm = ctx.round_keys[final_off + m] as u32;
        ct.data[m] = ((sm ^ rm) & 255) as u8;
        m = m + 1;
    }
}

// ===========================================================================
// AES decrypt one 16-byte block (FIPS 197 §5.3, §7.2 — inverse cipher)
// AddRoundKey(Nr); for round Nr-1..1: InvShiftRows, InvSubBytes, AddRoundKey,
// InvMixColumns; final: InvShiftRows, InvSubBytes, AddRoundKey(0).
// ===========================================================================
transform aes_decrypt_block(ctx: State<AesCtx>, ct: State<AesBlock>, pt: State<AesBlock>) {
    // Copy ciphertext to working state (pt doubles as the working buffer).
    let i: u32 = 0;
    while i < 16 {
        pt.data[i] = ct.data[i];
        i = i + 1;
    }

    // AddRoundKey(Nr) — inlined.
    let init_off = ctx.rounds * 16;
    let j: u32 = 0;
    while j < 16 {
        let sj = pt.data[j] as u32;
        let rj = ctx.round_keys[init_off + j] as u32;
        pt.data[j] = ((sj ^ rj) & 255) as u8;
        j = j + 1;
    }

    // Rounds Nr-1 .. 1.
    let round: u32 = ctx.rounds - 1;
    while round > 0 {
        aes_inv_shift_rows(pt);
        aes_inv_sub_bytes(ctx, pt);
        // AddRoundKey(round) — inlined.
        let off = round * 16;
        let k: u32 = 0;
        while k < 16 {
            let sk = pt.data[k] as u32;
            let rk = ctx.round_keys[off + k] as u32;
            pt.data[k] = ((sk ^ rk) & 255) as u8;
            k = k + 1;
        }
        aes_inv_mix_columns(pt);
        round = round - 1;
    }

    // Final round (no InvMixColumns).
    aes_inv_shift_rows(pt);
    aes_inv_sub_bytes(ctx, pt);
    // AddRoundKey(0) — inlined.
    let m: u32 = 0;
    while m < 16 {
        let sm = pt.data[m] as u32;
        let rm = ctx.round_keys[m] as u32;
        pt.data[m] = ((sm ^ rm) & 255) as u8;
        m = m + 1;
    }
}
