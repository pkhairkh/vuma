// womb/crypto/symmetric/aes_extra_modes.vuma — AES-XTS, AES-KW, AES-KWP,
// AES-GCM-SIV and AES-CMAC.
// PMT-native rewrite (Wave E).
//
// Implements:
//   * AES-CMAC      (NIST SP 800-38B) — message authentication code with
//                    proper subkey generation and constant-time verify.
//   * AES-KW        (RFC 3394)        — wrap/unwrap of 64-bit-aligned key
//                    material (n >= 2 blocks) with the standard 0xA6A6A6A6
//                    integrity check register.
//   * AES-KWP       (RFC 5649)        — wrap/unwrap of arbitrary-length
//                    key material using the 0xA65959A6 || MLI integrity
//                    register and zero padding to the next 8-byte
//                    boundary.
//   * AES-XTS       (NIST SP 800-38E / IEEE 1619) — tweakable block
//                    cipher for sector encryption with two keys (data
//                    key K1, tweak key K2) and ciphertext stealing for
//                    partial final blocks.
//   * AES-GCM-SIV   (RFC 8452)        — misuse-resistant AEAD using
//                    POLYVAL (little-endian GHASH) for the SIV tag and
//                    AES-CTR for confidentiality.
//
// All modes invoke the canonical AES-128 block primitive from
// aes128.vuma (aes_encrypt_block / aes_decrypt_block). The mode
// logic is identical for every AES key size.
//
// No main() — importable library module.

import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/aes128.vuma"::{
    AesCtx, AesBlock, AesKey, aes128_init, aes_encrypt_block, aes_decrypt_block,
};

const XTS_BLOCK: u32 = 16;
const XTS_GFPOLY: u32 = 135;       // 0x87 — x^128 + x^7 + x^2 + x + 1
const CMAC_GFPOLY: u32 = 135;      // same polynomial
const KW_ICV_BYTE: u32 = 166;      // 0xA6 — RFC 3394 integrity byte
const KWP_ICV0: u32 = 166;         // 0xA6
const KWP_ICV1: u32 = 89;          // 0x59
const KWP_ICV2: u32 = 89;          // 0x59
const KWP_ICV3: u32 = 166;         // 0xA6
const AEX_MASK32: u32 = 4294967295;

// ===========================================================================
// Layouts
// ===========================================================================

// General-purpose 256-byte buffer (data, msg, ciphertext, plaintext, AAD).
layout AesXBuf = { bytes: [u8; 256] }

// 16-byte block (CMAC subkeys, XTS tweak/alpha, GCM-SIV SIV, IVs).
layout AesXBlock = { bytes: [u8; 16] }

// 8-byte buffer for AES-KW integrity register A.
layout AesXWord64 = { bytes: [u8; 8] }

// ===========================================================================
// Little-endian u32 store/load helpers.
// ===========================================================================

transform store_u32_le_at(buf: State<AesXBuf>, off: u32, val: u32) {
    buf.bytes[off]     = (val & 255) as u8;
    buf.bytes[off + 1] = ((val >> 8) & 255) as u8;
    buf.bytes[off + 2] = ((val >> 16) & 255) as u8;
    buf.bytes[off + 3] = ((val >> 24) & 255) as u8;
}

transform load_u32_le_at(buf: State<AesXBuf>, off: u32) -> u32 {
    let b0 = buf.bytes[off] as u32;
    let b1 = buf.bytes[off + 1] as u32;
    let b2 = buf.bytes[off + 2] as u32;
    let b3 = buf.bytes[off + 3] as u32;
    return (b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)) & AEX_MASK32;
}

transform store_u32_be_at(buf: State<AesXBuf>, off: u32, val: u32) {
    buf.bytes[off]     = ((val >> 24) & 255) as u8;
    buf.bytes[off + 1] = ((val >> 16) & 255) as u8;
    buf.bytes[off + 2] = ((val >> 8) & 255) as u8;
    buf.bytes[off + 3] = (val & 255) as u8;
}

transform load_u32_be_at(buf: State<AesXBuf>, off: u32) -> u32 {
    let b0 = buf.bytes[off] as u32;
    let b1 = buf.bytes[off + 1] as u32;
    let b2 = buf.bytes[off + 2] as u32;
    let b3 = buf.bytes[off + 3] as u32;
    return ((b0 << 24) | (b1 << 16) | (b2 << 8) | b3) & AEX_MASK32;
}

// Same helpers but operating on an AesXBlock (16-byte block).
transform store_u32_be_at_block(buf: State<AesXBlock>, off: u32, val: u32) {
    buf.bytes[off]     = ((val >> 24) & 255) as u8;
    buf.bytes[off + 1] = ((val >> 16) & 255) as u8;
    buf.bytes[off + 2] = ((val >> 8) & 255) as u8;
    buf.bytes[off + 3] = (val & 255) as u8;
}

transform load_u32_be_at_block(buf: State<AesXBlock>, off: u32) -> u32 {
    let b0 = buf.bytes[off] as u32;
    let b1 = buf.bytes[off + 1] as u32;
    let b2 = buf.bytes[off + 2] as u32;
    let b3 = buf.bytes[off + 3] as u32;
    return ((b0 << 24) | (b1 << 16) | (b2 << 8) | b3) & AEX_MASK32;
}

// ===========================================================================
// AES block-call adapter: encrypt 16 bytes from `in_block` (AesXBlock) into
// `out_block` (AesXBlock) using `ctx` (pre-initialized AesCtx).
// ===========================================================================

transform aesx_encrypt(ctx: State<AesCtx>, in_block: State<AesXBlock>, out_block: State<AesXBlock>) {
    let pt = state_new(AesBlock);
    let ct = state_new(AesBlock);
    let i: u32 = 0;
    while i < 16 {
        pt.data[i] = in_block.bytes[i];
        i = i + 1;
    }
    aes_encrypt_block(ctx, pt, ct);
    let j: u32 = 0;
    while j < 16 {
        out_block.bytes[j] = ct.data[j];
        j = j + 1;
    }
}

transform aesx_decrypt(ctx: State<AesCtx>, in_block: State<AesXBlock>, out_block: State<AesXBlock>) {
    let ct = state_new(AesBlock);
    let pt = state_new(AesBlock);
    let i: u32 = 0;
    while i < 16 {
        ct.data[i] = in_block.bytes[i];
        i = i + 1;
    }
    aes_decrypt_block(ctx, ct, pt);
    let j: u32 = 0;
    while j < 16 {
        out_block.bytes[j] = pt.data[j];
        j = j + 1;
    }
}

// ===========================================================================
// AES-CMAC (SP 800-38B)
// ===========================================================================

// Left-shift a 16-byte big-endian field element by 1 bit, reducing modulo
// x^128 + x^7 + x^2 + x + 1 (constant 0x87 in the low byte).
transform gf128_shl_be(x: State<AesXBlock>) {
    let msb: u32 = (x.bytes[0] as u32) >> 7;
    let i: u32 = 0;
    while i < 15 {
        let cur = x.bytes[i] as u32;
        let nxt = x.bytes[i + 1] as u32;
        x.bytes[i] = (((cur << 1) | (nxt >> 7)) & 255) as u8;
        i = i + 1;
    }
    let last = x.bytes[15] as u32;
    x.bytes[15] = ((last << 1) & 255) as u8;
    if msb == 1 {
        x.bytes[15] = ((x.bytes[15] as u32) ^ CMAC_GFPOLY) as u8;
    }
}

// Generate CMAC subkeys K1 and K2 (each 16 bytes).
transform cmac_gen_subkeys(ctx: State<AesCtx>, k1: State<AesXBlock>, k2: State<AesXBlock>) {
    let zero_block = state_new(AesXBlock);
    let l = state_new(AesXBlock);
    let i: u32 = 0;
    while i < 16 { zero_block.bytes[i] = 0; i = i + 1; }
    aesx_encrypt(ctx, zero_block, l);

    // K1 = L << 1 (with conditional reduction)
    let j: u32 = 0;
    while j < 16 { k1.bytes[j] = l.bytes[j]; j = j + 1; }
    gf128_shl_be(k1);

    // K2 = K1 << 1 (with conditional reduction)
    let k: u32 = 0;
    while k < 16 { k2.bytes[k] = k1.bytes[k]; k = k + 1; }
    gf128_shl_be(k2);
}

// Compute AES-CMAC(key, msg[0..msg_len)) into out[0..16).
transform aes_cmac(key: State<AesKey>, msg: State<AesXBuf>, msg_len: u32, out: State<AesXBuf>) {
    let ctx = state_new(AesCtx);
    aes128_init(ctx, key);

    let k1 = state_new(AesXBlock);
    let k2 = state_new(AesXBlock);
    cmac_gen_subkeys(ctx, k1, k2);

    let num_blocks: u32 = (msg_len + 15) / 16;
    if num_blocks == 0 { num_blocks = 1; }

    let x = state_new(AesXBlock);
    let i: u32 = 0;
    while i < 16 { x.bytes[i] = 0; i = i + 1; }

    // Process all blocks except the last.
    let block_idx: u32 = 0;
    while block_idx + 1 < num_blocks {
        let block = state_new(AesXBlock);
        let base = block_idx * 16;
        let k: u32 = 0;
        while k < 16 {
            let off = base + k;
            block.bytes[k] = ((msg.bytes[off] as u32) ^ (x.bytes[k] as u32)) as u8;
            k = k + 1;
        }
        aesx_encrypt(ctx, block, x);
        block_idx = block_idx + 1;
    }

    // Build the final block (with padding if needed).
    let last = state_new(AesXBlock);
    let m: u32 = 0;
    while m < 16 { last.bytes[m] = 0; m = m + 1; }
    let last_start: u32 = block_idx * 16;
    let n: u32 = 0;
    while n < msg_len - last_start {
        let off = last_start + n;
        last.bytes[n] = msg.bytes[off];
        n = n + 1;
    }

    let is_complete: u32 = 0;
    if msg_len > 0 {
        if msg_len % 16 == 0 { is_complete = 1; }
    }

    if is_complete == 1 {
        // XOR with K1.
        let p: u32 = 0;
        while p < 16 {
            last.bytes[p] = ((last.bytes[p] as u32) ^ (k1.bytes[p] as u32)) as u8;
            p = p + 1;
        }
    } else {
        // Apply 0x80 || 0...0 padding, then XOR with K2.
        let pad_pos = msg_len - last_start;
        last.bytes[pad_pos] = 128;
        let p: u32 = 0;
        while p < 16 {
            last.bytes[p] = ((last.bytes[p] as u32) ^ (k2.bytes[p] as u32)) as u8;
            p = p + 1;
        }
    }

    // Final encryption: T = AES_enc(K, X XOR M_last).
    let final_in = state_new(AesXBlock);
    let q: u32 = 0;
    while q < 16 {
        final_in.bytes[q] = ((x.bytes[q] as u32) ^ (last.bytes[q] as u32)) as u8;
        q = q + 1;
    }
    let final_out = state_new(AesXBlock);
    aesx_encrypt(ctx, final_in, final_out);

    // Copy 16-byte tag into out[0..15].
    let r: u32 = 0;
    while r < 16 {
        out.bytes[r] = final_out.bytes[r];
        r = r + 1;
    }
}

// Constant-time verification of an AES-CMAC tag. Returns 1 on match, 0
// otherwise.
transform aes_cmac_verify(key: State<AesKey>, msg: State<AesXBuf>, msg_len: u32, tag: State<AesXBuf>) -> u32 {
    let computed = state_new(AesXBuf);
    aes_cmac(key, msg, msg_len, computed);

    let diff: u32 = 0;
    let i: u32 = 0;
    while i < 16 {
        diff = diff | ((computed.bytes[i] as u32) ^ (tag.bytes[i] as u32));
        i = i + 1;
    }

    if diff == 0 { return 1; }
    return 0;
}

// ===========================================================================
// AES-KW (RFC 3394) — Key Wrap
// ===========================================================================

// XOR a 32-bit big-endian integer t into bytes [4..7] of `a`.
transform xor_u64_be(a: State<AesXWord64>, t: u32) {
    // Load big-endian u32 from a.bytes[4..7]
    let b0 = a.bytes[4] as u32;
    let b1 = a.bytes[5] as u32;
    let b2 = a.bytes[6] as u32;
    let b3 = a.bytes[7] as u32;
    let cur = ((b0 << 24) | (b1 << 16) | (b2 << 8) | b3) & AEX_MASK32;
    let new_val = cur ^ t;
    a.bytes[4] = ((new_val >> 24) & 255) as u8;
    a.bytes[5] = ((new_val >> 16) & 255) as u8;
    a.bytes[6] = ((new_val >> 8) & 255) as u8;
    a.bytes[7] = (new_val & 255) as u8;
}

transform aes_kw_wrap(kek: State<AesKey>, plaintext: State<AesXBuf>, pt_len: u32, ciphertext: State<AesXBuf>) -> u32 {
    if pt_len < 16 { return 0; }
    if pt_len % 8 != 0 { return 0; }
    let n: u32 = pt_len / 8;
    if n < 2 { return 0; }

    let ctx = state_new(AesCtx);
    aes128_init(ctx, kek);

    let a = state_new(AesXWord64);
    a.bytes[0] = KW_ICV_BYTE as u8;
    a.bytes[1] = KW_ICV_BYTE as u8;
    a.bytes[2] = KW_ICV_BYTE as u8;
    a.bytes[3] = KW_ICV_BYTE as u8;
    a.bytes[4] = KW_ICV_BYTE as u8;
    a.bytes[5] = KW_ICV_BYTE as u8;
    a.bytes[6] = KW_ICV_BYTE as u8;
    a.bytes[7] = KW_ICV_BYTE as u8;

    let r = state_new(AesXBuf);
    let i: u32 = 0;
    while i < pt_len {
        r.bytes[i] = plaintext.bytes[i];
        i = i + 1;
    }

    let j: u32 = 0;
    while j < 6 {
        let k: u32 = 0;
        while k < n {
            // B = AES_enc(KEK, A || R[i])
            let b_input = state_new(AesXBlock);
            let p: u32 = 0;
            while p < 8 { b_input.bytes[p] = a.bytes[p]; p = p + 1; }
            let rbase = k * 8;
            let q: u32 = 0;
            while q < 8 {
                let off = rbase + q;
                b_input.bytes[8 + q] = r.bytes[off];
                q = q + 1;
            }
            let b_output = state_new(AesXBlock);
            aesx_encrypt(ctx, b_input, b_output);

            // A = B[0..7] XOR t  where t = n*j + i + 1
            let s: u32 = 0;
            while s < 8 { a.bytes[s] = b_output.bytes[s]; s = s + 1; }
            let t: u32 = n * j + k + 1;
            xor_u64_be(a, t);

            // R[i] = B[8..15]
            let u: u32 = 0;
            while u < 8 {
                let off = rbase + u;
                r.bytes[off] = b_output.bytes[8 + u];
                u = u + 1;
            }

            k = k + 1;
        }
        j = j + 1;
    }

    // Output: A || R
    let x: u32 = 0;
    while x < 8 {
        ciphertext.bytes[x] = a.bytes[x];
        x = x + 1;
    }
    let y: u32 = 0;
    while y < pt_len {
        ciphertext.bytes[8 + y] = r.bytes[y];
        y = y + 1;
    }

    return 8 + pt_len;
}

transform aes_kw_unwrap(kek: State<AesKey>, ciphertext: State<AesXBuf>, ct_len: u32, plaintext: State<AesXBuf>) -> u32 {
    if ct_len < 24 { return 0; }
    if ct_len % 8 != 0 { return 0; }
    let n: u32 = (ct_len - 8) / 8;
    if n < 2 { return 0; }

    let ctx = state_new(AesCtx);
    aes128_init(ctx, kek);

    let a = state_new(AesXWord64);
    let i: u32 = 0;
    while i < 8 { a.bytes[i] = ciphertext.bytes[i]; i = i + 1; }

    let r = state_new(AesXBuf);
    let m: u32 = 0;
    while m < ct_len - 8 {
        r.bytes[m] = ciphertext.bytes[8 + m];
        m = m + 1;
    }

    // 6n iterations in reverse: j = 5..1, i = n-1..0.
    let j: u32 = 6;
    while j > 0 {
        let jj = j - 1;
        let k: u32 = n;
        while k > 0 {
            let kk = k - 1;
            let t: u32 = n * jj + kk + 1;

            // (A XOR t) || R[i]
            let a_xor = state_new(AesXWord64);
            let p: u32 = 0;
            while p < 8 { a_xor.bytes[p] = a.bytes[p]; p = p + 1; }
            xor_u64_be(a_xor, t);

            let b_input = state_new(AesXBlock);
            let q: u32 = 0;
            while q < 8 { b_input.bytes[q] = a_xor.bytes[q]; q = q + 1; }
            let rbase = kk * 8;
            let s: u32 = 0;
            while s < 8 {
                let off = rbase + s;
                b_input.bytes[8 + s] = r.bytes[off];
                s = s + 1;
            }

            // B = AES_dec(KEK, ...)
            let b_output = state_new(AesXBlock);
            aesx_decrypt(ctx, b_input, b_output);

            // A = B[0..7]; R[i] = B[8..15]
            let u: u32 = 0;
            while u < 8 { a.bytes[u] = b_output.bytes[u]; u = u + 1; }
            let v: u32 = 0;
            while v < 8 {
                let off = rbase + v;
                r.bytes[off] = b_output.bytes[8 + v];
                v = v + 1;
            }

            k = k - 1;
        }
        j = j - 1;
    }

    // Verify A == 0xA6A6A6A6A6A6A6A6.
    let valid: u32 = 1;
    let w: u32 = 0;
    while w < 8 {
        if (a.bytes[w] as u32) != KW_ICV_BYTE { valid = 0; }
        w = w + 1;
    }

    if valid == 1 {
        let x: u32 = 0;
        while x < ct_len - 8 {
            plaintext.bytes[x] = r.bytes[x];
            x = x + 1;
        }
    }

    if valid == 1 { return ct_len - 8; }
    return 0;
}

// ===========================================================================
// AES-KWP (RFC 5649) — Key Wrap with Padding
// ===========================================================================

transform aes_kwp_wrap(kek: State<AesKey>, plaintext: State<AesXBuf>, pt_len: u32, ciphertext: State<AesXBuf>) -> u32 {
    if pt_len == 0 { return 0; }

    let mli: u32 = pt_len;
    // Padded input: 8-byte IV || mli bytes || zero pad to 8-byte boundary.
    let padded_input_len: u32 = 8 + mli;
    let mut_padded: u32 = padded_input_len;
    if mut_padded % 8 != 0 {
        mut_padded = mut_padded + (8 - (mut_padded % 8));
    }
    let final_padded_len: u32 = mut_padded;

    let padded_input = state_new(AesXBuf);
    let i: u32 = 0;
    while i < final_padded_len { padded_input.bytes[i] = 0; i = i + 1; }

    // IV = 0xA65959A6 || be32(MLI)
    padded_input.bytes[0] = KWP_ICV0 as u8;
    padded_input.bytes[1] = KWP_ICV1 as u8;
    padded_input.bytes[2] = KWP_ICV2 as u8;
    padded_input.bytes[3] = KWP_ICV3 as u8;
    store_u32_be_at(padded_input, 4, mli);

    // Plaintext follows the IV.
    let j: u32 = 0;
    while j < mli {
        padded_input.bytes[8 + j] = plaintext.bytes[j];
        j = j + 1;
    }

    let wrapped_len: u32 = aes_kw_wrap(kek, padded_input, final_padded_len, ciphertext);
    return wrapped_len;
}

transform aes_kwp_unwrap(kek: State<AesKey>, ciphertext: State<AesXBuf>, ct_len: u32, plaintext: State<AesXBuf>) -> u32 {
    if ct_len < 24 { return 0; }
    if ct_len % 8 != 0 { return 0; }

    // The KW unwrap output is at most ct_len - 8 bytes.
    let unwrapped = state_new(AesXBuf);
    let unwrapped_len: u32 = aes_kw_unwrap(kek, ciphertext, ct_len, unwrapped);
    if unwrapped_len == 0 {
        return 0;
    }
    if unwrapped_len < 8 {
        return 0;
    }

    // Verify the high 4 bytes of the IV.
    if (unwrapped.bytes[0] as u32) != KWP_ICV0 { return 0; }
    if (unwrapped.bytes[1] as u32) != KWP_ICV1 { return 0; }
    if (unwrapped.bytes[2] as u32) != KWP_ICV2 { return 0; }
    if (unwrapped.bytes[3] as u32) != KWP_ICV3 { return 0; }

    let mli: u32 = load_u32_be_at(unwrapped, 4);
    // Padding is between 0 and 7 bytes.
    if mli > unwrapped_len - 8 {
        return 0;
    }
    if unwrapped_len - 8 - mli >= 8 {
        return 0;
    }

    // Copy out the MLI plaintext bytes.
    let i: u32 = 0;
    while i < mli {
        plaintext.bytes[i] = unwrapped.bytes[8 + i];
        i = i + 1;
    }

    return mli;
}

// ===========================================================================
// AES-XTS (NIST SP 800-38E / IEEE 1619)
// ===========================================================================

// Multiply a 16-byte little-endian GF(2^128) element by 2.
transform xts_gf128_mul2_le(x: State<AesXBlock>) {
    let msb: u32 = (x.bytes[15] as u32) >> 7;
    let i: u32 = 15;
    while i > 0 {
        let cur = x.bytes[i] as u32;
        let prv = x.bytes[i - 1] as u32;
        x.bytes[i] = (((cur << 1) | (prv >> 7)) & 255) as u8;
        i = i - 1;
    }
    let first = x.bytes[0] as u32;
    x.bytes[0] = ((first << 1) & 255) as u8;
    if msb == 1 {
        x.bytes[0] = ((x.bytes[0] as u32) ^ XTS_GFPOLY) as u8;
    }
}

// Encrypt or decrypt a single 16-byte XTS block at index `block_idx`,
// using the precomputed initial tweak mask α_0 (encrypted tweak).
transform xts_block_crypt(ctx: State<AesCtx>, in_block: State<AesXBlock>, key1: State<AesKey>, alpha: State<AesXBlock>, encrypt: u32, out_block: State<AesXBlock>) {
    let xored = state_new(AesXBlock);
    let i: u32 = 0;
    while i < 16 {
        xored.bytes[i] = ((in_block.bytes[i] as u32) ^ (alpha.bytes[i] as u32)) as u8;
        i = i + 1;
    }

    let transformed = state_new(AesXBlock);
    if encrypt == 1 {
        aesx_encrypt(ctx, xored, transformed);
    } else {
        aesx_decrypt(ctx, xored, transformed);
    }

    let j: u32 = 0;
    while j < 16 {
        out_block.bytes[j] = ((transformed.bytes[j] as u32) ^ (alpha.bytes[j] as u32)) as u8;
        j = j + 1;
    }
}

// Compute α_i = α_0 * 2^i by i successive doublings in GF(2^128).
transform xts_alpha_at(alpha0: State<AesXBlock>, idx: u32, out: State<AesXBlock>) {
    let j: u32 = 0;
    while j < 16 { out.bytes[j] = alpha0.bytes[j]; j = j + 1; }
    let k: u32 = 0;
    while k < idx {
        xts_gf128_mul2_le(out);
        k = k + 1;
    }
}

// Read 16 bytes from `data.bytes[base..base+15]` into `block`.
transform xts_load_block(data: State<AesXBuf>, base: u32, block: State<AesXBlock>) {
    let i: u32 = 0;
    while i < 16 {
        let off = base + i;
        block.bytes[i] = data.bytes[off];
        i = i + 1;
    }
}

// Write 16 bytes from `block` into `data.bytes[base..base+15]`.
transform xts_store_block(data: State<AesXBuf>, base: u32, block: State<AesXBlock>) {
    let i: u32 = 0;
    while i < 16 {
        let off = base + i;
        data.bytes[off] = block.bytes[i];
        i = i + 1;
    }
}

transform aes_xts_encrypt(data: State<AesXBuf>, data_len: u32, key1: State<AesKey>, key2: State<AesKey>, tweak: State<AesXBlock>, out: State<AesXBuf>) -> u32 {
    if data_len < 16 { return 0; }

    let ctx1 = state_new(AesCtx);
    aes128_init(ctx1, key1);
    let ctx2 = state_new(AesCtx);
    aes128_init(ctx2, key2);

    // α_0 = AES_enc(K2, T)
    let alpha0 = state_new(AesXBlock);
    aesx_encrypt(ctx2, tweak, alpha0);

    let num_full: u32 = data_len / 16;
    let rem: u32 = data_len % 16;

    // Case A: data length is a multiple of 16 — straightforward.
    if rem == 0 {
        let block: u32 = 0;
        while block < num_full {
            let alpha = state_new(AesXBlock);
            xts_alpha_at(alpha0, block, alpha);
            let in_block = state_new(AesXBlock);
            let base = block * 16;
            xts_load_block(data, base, in_block);
            let out_block = state_new(AesXBlock);
            xts_block_crypt(ctx1, in_block, key1, alpha, 1, out_block);
            xts_store_block(out, base, out_block);
            block = block + 1;
        }
        return data_len;
    }

    // Case B: data length has a partial final block — apply CTS.
    let m: u32 = num_full;
    if m < 1 {
        return 0;
    }

    // Encrypt blocks 0..m-2 normally.
    let block: u32 = 0;
    while block < m - 1 {
        let alpha = state_new(AesXBlock);
        xts_alpha_at(alpha0, block, alpha);
        let in_block = state_new(AesXBlock);
        let base = block * 16;
        xts_load_block(data, base, in_block);
        let out_block = state_new(AesXBlock);
        xts_block_crypt(ctx1, in_block, key1, alpha, 1, out_block);
        xts_store_block(out, base, out_block);
        block = block + 1;
    }

    // Encrypt block m-1 with tweak α_{m-1} → C' (intermediate, 16 bytes).
    let alpha_m1 = state_new(AesXBlock);
    xts_alpha_at(alpha0, m - 1, alpha_m1);
    let c_prime = state_new(AesXBlock);
    let base_m1 = (m - 1) * 16;
    let in_m1 = state_new(AesXBlock);
    xts_load_block(data, base_m1, in_m1);
    xts_block_crypt(ctx1, in_m1, key1, alpha_m1, 1, c_prime);

    // Build PP = P_m || C'[rem..15]
    let alpha_m = state_new(AesXBlock);
    xts_alpha_at(alpha0, m, alpha_m);
    let pp = state_new(AesXBlock);
    let i: u32 = 0;
    let base_m = m * 16;
    while i < rem {
        let off = base_m + i;
        pp.bytes[i] = data.bytes[off];
        i = i + 1;
    }
    while i < 16 {
        let off = rem + (i - rem);
        pp.bytes[i] = c_prime.bytes[off];
        i = i + 1;
    }
    let cc = state_new(AesXBlock);
    xts_block_crypt(ctx1, pp, key1, alpha_m, 1, cc);

    // C_{m-1} (the partial ciphertext block, `rem` bytes) = CC[0..rem-1].
    // C_m     (the trailing full block, 16 bytes)         = CC[rem..15] || C'[0..rem-1].
    let p: u32 = 0;
    while p < rem {
        let off = (m - 1) * 16 + p;
        out.bytes[off] = cc.bytes[p];
        p = p + 1;
    }
    let q: u32 = 0;
    while q < 16 - rem {
        let off = m * 16 + q;
        let srcoff = rem + q;
        out.bytes[off] = cc.bytes[srcoff];
        q = q + 1;
    }
    let s: u32 = 0;
    while s < rem {
        let off = m * 16 + (16 - rem) + s;
        out.bytes[off] = c_prime.bytes[s];
        s = s + 1;
    }

    return data_len;
}

transform aes_xts_decrypt(data: State<AesXBuf>, data_len: u32, key1: State<AesKey>, key2: State<AesKey>, tweak: State<AesXBlock>, out: State<AesXBuf>) -> u32 {
    if data_len < 16 { return 0; }

    let ctx1 = state_new(AesCtx);
    aes128_init(ctx1, key1);
    let ctx2 = state_new(AesCtx);
    aes128_init(ctx2, key2);

    let alpha0 = state_new(AesXBlock);
    aesx_encrypt(ctx2, tweak, alpha0);

    let num_full: u32 = data_len / 16;
    let rem: u32 = data_len % 16;

    // Case A: full blocks only.
    if rem == 0 {
        let block: u32 = 0;
        while block < num_full {
            let alpha = state_new(AesXBlock);
            xts_alpha_at(alpha0, block, alpha);
            let in_block = state_new(AesXBlock);
            let base = block * 16;
            xts_load_block(data, base, in_block);
            let out_block = state_new(AesXBlock);
            xts_block_crypt(ctx1, in_block, key1, alpha, 0, out_block);
            xts_store_block(out, base, out_block);
            block = block + 1;
        }
        return data_len;
    }

    // Case B: CTS. Reverse the swap performed during encryption.
    let m: u32 = num_full;
    if m < 1 {
        return 0;
    }

    // Decrypt blocks 0..m-2 normally.
    let block: u32 = 0;
    while block < m - 1 {
        let alpha = state_new(AesXBlock);
        xts_alpha_at(alpha0, block, alpha);
        let in_block = state_new(AesXBlock);
        let base = block * 16;
        xts_load_block(data, base, in_block);
        let out_block = state_new(AesXBlock);
        xts_block_crypt(ctx1, in_block, key1, alpha, 0, out_block);
        xts_store_block(out, base, out_block);
        block = block + 1;
    }

    // Recover CC = C_{m-1} || C_m[0..16-rem-1].
    let alpha_m = state_new(AesXBlock);
    xts_alpha_at(alpha0, m, alpha_m);
    let cc = state_new(AesXBlock);
    let i: u32 = 0;
    let base_m1 = (m - 1) * 16;
    let base_m = m * 16;
    while i < rem {
        let off = base_m1 + i;
        cc.bytes[i] = data.bytes[off];
        i = i + 1;
    }
    while i < 16 {
        let off = base_m + (i - rem);
        cc.bytes[i] = data.bytes[off];
        i = i + 1;
    }

    // PP = XTS-decrypt(CC) with α_m.
    let pp = state_new(AesXBlock);
    xts_block_crypt(ctx1, cc, key1, alpha_m, 0, pp);

    // Recover C' = C_m[16-rem..15] || PP[rem..15].
    let c_prime = state_new(AesXBlock);
    let j: u32 = 0;
    while j < rem {
        let off = base_m + (16 - rem) + j;
        c_prime.bytes[j] = data.bytes[off];
        j = j + 1;
    }
    while j < 16 {
        c_prime.bytes[j] = pp.bytes[j];
        j = j + 1;
    }

    // P_{m-1} = XTS-decrypt(C') with α_{m-1}.
    let alpha_m1 = state_new(AesXBlock);
    xts_alpha_at(alpha0, m - 1, alpha_m1);
    let out_m1 = state_new(AesXBlock);
    xts_block_crypt(ctx1, c_prime, key1, alpha_m1, 0, out_m1);
    xts_store_block(out, base_m1, out_m1);

    // P_m = PP[0..rem-1].
    let k: u32 = 0;
    while k < rem {
        let off = base_m + k;
        out.bytes[off] = pp.bytes[k];
        k = k + 1;
    }

    return data_len;
}

// ===========================================================================
// AES-GCM-SIV (RFC 8452) — misuse-resistant AEAD
// ===========================================================================

// GF(2^128) multiplication for POLYVAL.
transform polyval_mul(x: State<AesXBlock>, h: State<AesXBlock>, out: State<AesXBlock>) {
    let z = state_new(AesXBlock);
    let v = state_new(AesXBlock);
    let i: u32 = 0;
    while i < 16 {
        z.bytes[i] = 0;
        v.bytes[i] = h.bytes[i];
        i = i + 1;
    }

    let bit: u32 = 0;
    while bit < 128 {
        // Bit `bit` of X — bit 0 is the LSB of byte 0.
        let byte_idx: u32 = bit / 8;
        let bit_in_byte: u32 = bit % 8;
        let x_bit: u32 = ((x.bytes[byte_idx] as u32) >> bit_in_byte) & 1;

        if x_bit == 1 {
            let p: u32 = 0;
            while p < 16 {
                z.bytes[p] = ((z.bytes[p] as u32) ^ (v.bytes[p] as u32)) as u8;
                p = p + 1;
            }
        }

        // Check the MSB of V (bit 7 of byte 15).
        let lsb: u32 = (v.bytes[15] as u32) >> 7;

        // V = V * 2 (V << 1 in little-endian representation).
        let q: u32 = 15;
        while q > 0 {
            let cur = v.bytes[q] as u32;
            let prv = v.bytes[q - 1] as u32;
            v.bytes[q] = (((cur << 1) | (prv >> 7)) & 255) as u8;
            q = q - 1;
        }
        let first = v.bytes[0] as u32;
        v.bytes[0] = ((first << 1) & 255) as u8;
        if lsb == 1 {
            v.bytes[0] = ((v.bytes[0] as u32) ^ 135) as u8;  // 0x87
        }

        bit = bit + 1;
    }

    let r: u32 = 0;
    while r < 16 { out.bytes[r] = z.bytes[r]; r = r + 1; }
}

// Apply a 16-byte block to a running POLYVAL state: Y = POLYVAL_mul(Y XOR block, H).
transform polyval_update(y: State<AesXBlock>, block: State<AesXBlock>, h: State<AesXBlock>) {
    let xored = state_new(AesXBlock);
    let i: u32 = 0;
    while i < 16 {
        xored.bytes[i] = ((y.bytes[i] as u32) ^ (block.bytes[i] as u32)) as u8;
        i = i + 1;
    }
    polyval_mul(xored, h, y);
}

// Derive auth_key (H) and enc_key (Ke) for AES-128-GCM-SIV.
transform gcm_siv_derive_keys(key: State<AesKey>, nonce: State<AesXBlock>, auth_key: State<AesXBlock>, enc_key: State<AesXBlock>) {
    // Build input block: nonce[0..11] || be32(counter).
    let input_block = state_new(AesXBlock);
    let i: u32 = 0;
    while i < 12 { input_block.bytes[i] = nonce.bytes[i]; i = i + 1; }
    input_block.bytes[12] = 0;
    input_block.bytes[13] = 0;
    input_block.bytes[14] = 0;
    input_block.bytes[15] = 0;
    let auth_buf = state_new(AesXBuf);
    let in_buf1 = state_new(AesXBuf);
    let j: u32 = 0;
    while j < 16 { in_buf1.bytes[j] = input_block.bytes[j]; j = j + 1; }
    aes_cmac(key, in_buf1, 16, auth_buf);
    let k: u32 = 0;
    while k < 16 { auth_key.bytes[k] = auth_buf.bytes[k]; k = k + 1; }

    input_block.bytes[12] = 0;
    input_block.bytes[13] = 0;
    input_block.bytes[14] = 0;
    input_block.bytes[15] = 1;
    let enc_buf = state_new(AesXBuf);
    let in_buf2 = state_new(AesXBuf);
    let m: u32 = 0;
    while m < 16 { in_buf2.bytes[m] = input_block.bytes[m]; m = m + 1; }
    aes_cmac(key, in_buf2, 16, enc_buf);
    let p: u32 = 0;
    while p < 16 { enc_key.bytes[p] = enc_buf.bytes[p]; p = p + 1; }
}

// Compute the SIV tag (16 bytes) from H, AAD, plaintext, and nonce.
transform gcm_siv_compute_siv(auth_key: State<AesXBlock>, nonce: State<AesXBlock>, aad: State<AesXBuf>, aad_len: u32, plaintext: State<AesXBuf>, pt_len: u32, siv: State<AesXBlock>) {
    // Y = 0
    let y = state_new(AesXBlock);
    let i: u32 = 0;
    while i < 16 { y.bytes[i] = 0; i = i + 1; }

    // Hash AAD (zero-padded to 16 bytes).
    let pos: u32 = 0;
    while pos < aad_len {
        let blk = state_new(AesXBlock);
        let p: u32 = 0;
        while p < 16 { blk.bytes[p] = 0; p = p + 1; }
        let q: u32 = 0;
        while q < 16 {
            if pos + q < aad_len {
                let off = pos + q;
                blk.bytes[q] = aad.bytes[off];
            }
            q = q + 1;
        }
        polyval_update(y, blk, auth_key);
        pos = pos + 16;
    }

    // Hash plaintext (zero-padded to 16 bytes).
    pos = 0;
    while pos < pt_len {
        let blk = state_new(AesXBlock);
        let p: u32 = 0;
        while p < 16 { blk.bytes[p] = 0; p = p + 1; }
        let q: u32 = 0;
        while q < 16 {
            if pos + q < pt_len {
                let off = pos + q;
                blk.bytes[q] = plaintext.bytes[off];
            }
            q = q + 1;
        }
        polyval_update(y, blk, auth_key);
        pos = pos + 16;
    }

    // Final length block: LE64(aad_bits) || LE64(pt_bits).
    let len_block = state_new(AesXBlock);
    let r: u32 = 0;
    while r < 16 { len_block.bytes[r] = 0; r = r + 1; }
    let aad_bits: u64 = aad_len as u64 * 8;
    let pt_bits: u64 = pt_len as u64 * 8;
    len_block.bytes[0]  = (aad_bits & 255) as u8;
    len_block.bytes[1]  = ((aad_bits >> 8) & 255) as u8;
    len_block.bytes[2]  = ((aad_bits >> 16) & 255) as u8;
    len_block.bytes[3]  = ((aad_bits >> 24) & 255) as u8;
    len_block.bytes[4]  = ((aad_bits >> 32) & 255) as u8;
    len_block.bytes[5]  = ((aad_bits >> 40) & 255) as u8;
    len_block.bytes[6]  = ((aad_bits >> 48) & 255) as u8;
    len_block.bytes[7]  = ((aad_bits >> 56) & 255) as u8;
    len_block.bytes[8]  = (pt_bits & 255) as u8;
    len_block.bytes[9]  = ((pt_bits >> 8) & 255) as u8;
    len_block.bytes[10] = ((pt_bits >> 16) & 255) as u8;
    len_block.bytes[11] = ((pt_bits >> 24) & 255) as u8;
    len_block.bytes[12] = ((pt_bits >> 32) & 255) as u8;
    len_block.bytes[13] = ((pt_bits >> 40) & 255) as u8;
    len_block.bytes[14] = ((pt_bits >> 48) & 255) as u8;
    len_block.bytes[15] = ((pt_bits >> 56) & 255) as u8;
    polyval_update(y, len_block, auth_key);

    // SIV = Y, then XOR nonce into the first 12 bytes and clear the
    // MSB of the last byte (to reserve counter space).
    let s: u32 = 0;
    while s < 16 { siv.bytes[s] = y.bytes[s]; s = s + 1; }
    let t: u32 = 0;
    while t < 12 {
        siv.bytes[t] = ((siv.bytes[t] as u32) ^ (nonce.bytes[t] as u32)) as u8;
        t = t + 1;
    }
    siv.bytes[15] = (siv.bytes[15] as u32 & 127) as u8;
}

// CTR encrypt/decrypt using `enc_key` and the SIV as IV.
transform gcm_siv_ctr(enc_key: State<AesKey>, siv: State<AesXBlock>, data: State<AesXBuf>, data_len: u32, output: State<AesXBuf>) {
    let ctx = state_new(AesCtx);
    aes128_init(ctx, enc_key);

    let counter_block = state_new(AesXBlock);
    let i: u32 = 0;
    while i < 16 { counter_block.bytes[i] = siv.bytes[i]; i = i + 1; }

    let pos: u32 = 0;
    while pos < data_len {
        let keystream = state_new(AesXBlock);
        aesx_encrypt(ctx, counter_block, keystream);

        let block_remaining: u32 = data_len - pos;
        let to_xor: u32 = 16;
        if block_remaining < 16 { to_xor = block_remaining; }

        let k: u32 = 0;
        while k < to_xor {
            let off = pos + k;
            output.bytes[off] = ((data.bytes[off] as u32) ^ (keystream.bytes[k] as u32)) as u8;
            k = k + 1;
        }

        // Big-endian increment of bytes [12..15].
        let carry: u32 = 1;
        let j: u32 = 15;
        while j >= 12 {
            let val: u32 = (counter_block.bytes[j] as u32) + carry;
            counter_block.bytes[j] = (val & 255) as u8;
            carry = val >> 8;
            if j == 0 { break; }
            j = j - 1;
        }

        pos = pos + to_xor;
    }
}

transform aes_gcm_siv_encrypt(key: State<AesKey>, nonce: State<AesXBlock>, plaintext: State<AesXBuf>, pt_len: u32, aad: State<AesXBuf>, aad_len: u32, ciphertext: State<AesXBuf>, tag: State<AesXBlock>) -> u32 {
    let auth_key = state_new(AesXBlock);
    let enc_key = state_new(AesXBlock);
    gcm_siv_derive_keys(key, nonce, auth_key, enc_key);

    let siv = state_new(AesXBlock);
    gcm_siv_compute_siv(auth_key, nonce, aad, aad_len, plaintext, pt_len, siv);

    // Copy SIV to the tag output (16 bytes).
    let i: u32 = 0;
    while i < 16 { tag.bytes[i] = siv.bytes[i]; i = i + 1; }

    // CTR encrypt the plaintext using enc_key and SIV as IV.
    gcm_siv_ctr(enc_key, siv, plaintext, pt_len, ciphertext);

    return pt_len;
}

transform aes_gcm_siv_decrypt(key: State<AesKey>, nonce: State<AesXBlock>, ciphertext: State<AesXBuf>, ct_len: u32, aad: State<AesXBuf>, aad_len: u32, tag: State<AesXBlock>, plaintext: State<AesXBuf>) -> u32 {
    let auth_key = state_new(AesXBlock);
    let enc_key = state_new(AesXBlock);
    gcm_siv_derive_keys(key, nonce, auth_key, enc_key);

    // CTR decrypt — same operation as encrypt, using the supplied tag as IV.
    gcm_siv_ctr(enc_key, tag, ciphertext, ct_len, plaintext);

    // Recompute the expected SIV and constant-time compare to the tag.
    let expected = state_new(AesXBlock);
    gcm_siv_compute_siv(auth_key, nonce, aad, aad_len, plaintext, ct_len, expected);

    let diff: u32 = 0;
    let i: u32 = 0;
    while i < 16 {
        diff = diff | ((expected.bytes[i] as u32) ^ (tag.bytes[i] as u32));
        i = i + 1;
    }

    if diff == 0 { return ct_len; }
    return 0;
}
