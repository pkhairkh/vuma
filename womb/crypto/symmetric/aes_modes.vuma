// ═══════════════════════════════════════════════════════════════════════════
// womb/crypto/symmetric/aes_modes.vuma — AES Block Cipher Modes (NIST SP800-38A)
// PMT-native rewrite (W2-B).
// ═══════════════════════════════════════════════════════════════════════════
//
// Implements ECB, CBC, and CTR modes using the AES-128 core from
// womb/crypto/symmetric/aes128.vuma (W2-A1).
//
// Block size: 128 bits (16 bytes). Key size: 128 bits (16 bytes).
//
// NIST SP800-38A test vectors (Appendix F):
//   Key: 2b7e151628aed2a6abf7158809cf4f3c
//   IV:  000102030405060708090a0b0c0d0e0f
//   Plaintext (4 blocks):
//     6bc1bee22e409f96e93d7e117393172a
//     ae2d8a571e03ac9c9eb76fac45af8e51
//     30c81c46a35ce411e5fbc1191a0a52ef
//     f69f2445df4f9b17ad2b417be66c3710
//
// PMT patterns (per W2-A1 aes128.vuma / W48 sha.vuma):
//   - state_new(Layout) for allocations
//   - State<T> for transform parameters
//   - [u8; N] byte arrays with literal/precomputed indices
//   - NO allocate/free/Address/*ptr

import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/aes128.vuma"::{AesCtx, AesBlock, AesKey, aes128_init, aes_encrypt_block, aes_decrypt_block};

const AES_MODES_MASK32: u32 = 4294967295;

// ===========================================================================
// Layouts
// ===========================================================================

// Multi-block data buffer (4 blocks = 64 bytes, matches NIST SP800-38A test vectors)
layout AesModeBuf = { bytes: [u8; 64] }

// 16-byte IV / nonce wrapper
layout AesIv = { bytes: [u8; 16] }

// ===========================================================================
// XOR helper: dst = a XOR b (16 bytes)
// ===========================================================================

transform aes_xor_blocks(dst: State<AesModeBuf>, dst_off: u32, a: State<AesModeBuf>, a_off: u32, b: State<AesIv>) {
    let i: u32 = 0;
    while i < 16 {
        dst.bytes[dst_off + i] = a.bytes[a_off + i] ^ b.bytes[i];
        i = i + 1;
    }
}

// XOR dst[off..off+15] with iv (both in AesModeBuf)
transform aes_xor_buf_iv(dst: State<AesModeBuf>, dst_off: u32, src: State<AesModeBuf>, src_off: u32, iv: State<AesModeBuf>, iv_off: u32) {
    let i: u32 = 0;
    while i < 16 {
        dst.bytes[dst_off + i] = src.bytes[src_off + i] ^ iv.bytes[iv_off + i];
        i = i + 1;
    }
}

// ===========================================================================
// ECB mode (Electronic Codebook)
// ===========================================================================

// aes_ecb_encrypt: encrypt `num_blocks` 16-byte blocks (max 4).
// Each block encrypted independently: C[i] = E(k, P[i])
transform aes_ecb_encrypt(ctx: State<AesCtx>, pt: State<AesModeBuf>, ct: State<AesModeBuf>, num_blocks: u32) {
    let pt_block = state_new(AesBlock);
    let ct_block = state_new(AesBlock);
    let i: u32 = 0;
    while i < num_blocks {
        let off = i * 16;
        // Copy plaintext block
        let j: u32 = 0;
        while j < 16 {
            pt_block.data[j] = pt.bytes[off + j];
            j = j + 1;
        }
        // Encrypt
        aes_encrypt_block(ctx, pt_block, ct_block);
        // Copy ciphertext block
        j = 0;
        while j < 16 {
            ct.bytes[off + j] = ct_block.data[j];
            j = j + 1;
        }
        i = i + 1;
    }
}

// aes_ecb_decrypt: decrypt `num_blocks` 16-byte blocks (max 4).
// P[i] = D(k, C[i])
transform aes_ecb_decrypt(ctx: State<AesCtx>, ct: State<AesModeBuf>, pt: State<AesModeBuf>, num_blocks: u32) {
    let pt_block = state_new(AesBlock);
    let ct_block = state_new(AesBlock);
    let i: u32 = 0;
    while i < num_blocks {
        let off = i * 16;
        let j: u32 = 0;
        while j < 16 {
            ct_block.data[j] = ct.bytes[off + j];
            j = j + 1;
        }
        aes_decrypt_block(ctx, ct_block, pt_block);
        j = 0;
        while j < 16 {
            pt.bytes[off + j] = pt_block.data[j];
            j = j + 1;
        }
        i = i + 1;
    }
}

// ===========================================================================
// CBC mode (Cipher Block Chaining)
// ===========================================================================

// aes_cbc_encrypt: C[0] = E(k, P[0] XOR IV), C[i] = E(k, P[i] XOR C[i-1])
transform aes_cbc_encrypt(ctx: State<AesCtx>, iv: State<AesIv>, pt: State<AesModeBuf>, ct: State<AesModeBuf>, num_blocks: u32) {
    let pt_block = state_new(AesBlock);
    let ct_block = state_new(AesBlock);
    let prev = state_new(AesModeBuf);  // holds previous ciphertext block

    // Copy IV into prev[0..15]
    let j: u32 = 0;
    while j < 16 {
        prev.bytes[j] = iv.bytes[j];
        j = j + 1;
    }

    let i: u32 = 0;
    while i < num_blocks {
        let off = i * 16;
        // XOR plaintext block with previous ciphertext (or IV for first block)
        let k: u32 = 0;
        while k < 16 {
            pt_block.data[k] = pt.bytes[off + k] ^ prev.bytes[k];
            k = k + 1;
        }
        // Encrypt
        aes_encrypt_block(ctx, pt_block, ct_block);
        // Copy ciphertext to output AND to prev for next iteration
        k = 0;
        while k < 16 {
            ct.bytes[off + k] = ct_block.data[k];
            prev.bytes[k] = ct_block.data[k];
            k = k + 1;
        }
        i = i + 1;
    }
}

// aes_cbc_decrypt: P[i] = D(k, C[i]) XOR C[i-1] (C[-1] = IV)
transform aes_cbc_decrypt(ctx: State<AesCtx>, iv: State<AesIv>, ct: State<AesModeBuf>, pt: State<AesModeBuf>, num_blocks: u32) {
    let pt_block = state_new(AesBlock);
    let ct_block = state_new(AesBlock);
    let prev = state_new(AesModeBuf);

    // Copy IV into prev[0..15]
    let j: u32 = 0;
    while j < 16 {
        prev.bytes[j] = iv.bytes[j];
        j = j + 1;
    }

    let i: u32 = 0;
    while i < num_blocks {
        let off = i * 16;
        // Copy ciphertext block
        let k: u32 = 0;
        while k < 16 {
            ct_block.data[k] = ct.bytes[off + k];
            k = k + 1;
        }
        // Decrypt
        aes_decrypt_block(ctx, ct_block, pt_block);
        // XOR with previous ciphertext (or IV for first block)
        k = 0;
        while k < 16 {
            pt.bytes[off + k] = pt_block.data[k] ^ prev.bytes[k];
            k = k + 1;
        }
        // Update prev = current ciphertext block
        k = 0;
        while k < 16 {
            prev.bytes[k] = ct.bytes[off + k];
            k = k + 1;
        }
        i = i + 1;
    }
}

// ===========================================================================
// CTR mode (Counter)
// ===========================================================================

// aes_ctr_crypt: encrypt/decrypt `num_blocks` blocks using CTR mode.
// The counter is a 16-byte value: IV[0..11] || counter[12..15] (big-endian).
// The counter starts at the value in iv.bytes[12..15] and increments per block.
// Keystream block i = E(k, IV with counter = start + i)
// C[i] = P[i] XOR keystream_i
transform aes_ctr_crypt(ctx: State<AesCtx>, iv: State<AesIv>, data: State<AesModeBuf>, num_blocks: u32) {
    let counter_block = state_new(AesBlock);
    let ks_block = state_new(AesBlock);

    // Initialize counter block from IV
    let j: u32 = 0;
    while j < 16 {
        counter_block.data[j] = iv.bytes[j];
        j = j + 1;
    }

    let i: u32 = 0;
    while i < num_blocks {
        let off = i * 16;
        // Generate keystream block
        aes_encrypt_block(ctx, counter_block, ks_block);
        // XOR data with keystream
        let k: u32 = 0;
        while k < 16 {
            data.bytes[off + k] = data.bytes[off + k] ^ ks_block.data[k];
            k = k + 1;
        }
        // Increment counter (big-endian, last 4 bytes)
        // counter_block.data[15] is the LSB
        counter_block.data[15] = counter_block.data[15] + 1;
        if counter_block.data[15] == 0 {
            counter_block.data[14] = counter_block.data[14] + 1;
            if counter_block.data[14] == 0 {
                counter_block.data[13] = counter_block.data[13] + 1;
                if counter_block.data[13] == 0 {
                    counter_block.data[12] = counter_block.data[12] + 1;
                }
            }
        }
        i = i + 1;
    }
}
