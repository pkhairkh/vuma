// ARIA cipher key CK3 (RFC 5794 §2.4) — used by FO in the third regeneration
// step (W3 = FO(W2, CK3)) for both ARIA-128 and ARIA-256.
transform aria_ck3_table(idx: u32) -> u32 {
    if idx == 0 { return 219; }   // 0xdb
    if idx == 1 { return 146; }   // 0x92
    if idx == 2 { return 55; }    // 0x37
    if idx == 3 { return 29; }    // 0x1d
    if idx == 4 { return 33; }    // 0x21
    if idx == 5 { return 38; }    // 0x26
    if idx == 6 { return 233; }   // 0xe9
    if idx == 7 { return 112; }   // 0x70
    if idx == 8 { return 3; }     // 0x03
    if idx == 9 { return 36; }    // 0x24
    if idx == 10 { return 151; }  // 0x97
    if idx == 11 { return 117; }  // 0x75
    if idx == 12 { return 4; }    // 0x04
    if idx == 13 { return 232; }  // 0xe8
    if idx == 14 { return 201; }  // 0xc9
    if idx == 15 { return 14; }   // 0x0e
    return 0;
}
