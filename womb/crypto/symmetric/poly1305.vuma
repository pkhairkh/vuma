// ═══════════════════════════════════════════════════════════════════════════
// womb/crypto/symmetric/poly1305.vuma — Poly1305 MAC (RFC 8439 §2.5)
// Rewritten with standard 26-bit limb arithmetic (Wave 5 fix).
// ═══════════════════════════════════════════════════════════════════════════
//
// One-time authenticator based on polynomial evaluation over GF(2^130 - 5).
//
// Key: 256 bits (32 bytes) = r (16 bytes) || s (16 bytes)
//   r is clamped: r &= 0x0ffffffc0fffffff0fffffff0fffffff
//   s is used as-is (added at the end, not multiplied)
//
// Algorithm:
//   acc = 0
//   for each 16-byte block M[i]:
//     n = M[i] as LE integer with 0x01 appended (1 << 128)
//     acc = (acc + n) mod (2^130 - 5)
//     acc = (acc * r) mod (2^130 - 5)
//   tag = (acc + s) mod (2^130 - 5)
//   output tag as 16 LE bytes
//
// Implementation: standard 26-bit limbs (5 × 26 = 130 bits), matching
// the poly1305-donna reference. Each limb is stored in a u32 but only
// uses 26 bits. The ×5 reduction (2^130 ≡ 5 mod p) folds the high
// product limbs back cleanly.

const POLY1305_MASK26: u32 = 67108863;   // 0x3FFFFFF (26 bits set)

// ===========================================================================
// Layouts
// ===========================================================================

layout Poly1305Ctx = {
    r: [u32; 5],      // clamped r, 5 × 26-bit limbs
    s: [u32; 4],      // s, 4 × 32-bit limbs (128 bits, not reduced)
    acc: [u32; 5],    // accumulator, 5 × 26-bit limbs
    buf: [u8; 16],    // partial block buffer
    buf_len: u32,     // bytes currently in buf
}

layout Poly1305Key = { bytes: [u8; 32] }
layout Poly1305Msg = { bytes: [u8; 256] }
layout Poly1305Tag = { bytes: [u8; 16] }

// ===========================================================================
// Initialization
// ===========================================================================

transform poly1305_init(ctx: State<Poly1305Ctx>, key: State<Poly1305Key>) {
    // Load 16-byte r as 4 u32 LE words, then extract 5 × 26-bit limbs
    // with RFC 8439 §2.5.1 clamping.
    let t0 = (key.bytes[0] as u32) | ((key.bytes[1] as u32) << 8) | ((key.bytes[2] as u32) << 16) | ((key.bytes[3] as u32) << 24);
    let t1 = (key.bytes[4] as u32) | ((key.bytes[5] as u32) << 8) | ((key.bytes[6] as u32) << 16) | ((key.bytes[7] as u32) << 24);
    let t2 = (key.bytes[8] as u32) | ((key.bytes[9] as u32) << 8) | ((key.bytes[10] as u32) << 16) | ((key.bytes[11] as u32) << 24);
    let t3 = (key.bytes[12] as u32) | ((key.bytes[13] as u32) << 8) | ((key.bytes[14] as u32) << 16) | ((key.bytes[15] as u32) << 24);

    // 26-bit limb extraction with clamping:
    // r[0] = t0 & 0x3FFFFFF                         (no clamp needed)
    // r[1] = ((t0 >> 26) | (t1 << 6)) & 0x3FFFF03   (clamp: clear bits 6-7)
    // r[2] = ((t1 >> 20) | (t2 << 12)) & 0x3FFC0FF   (clamp: clear bits 12-13)
    // r[3] = ((t2 >> 14) | (t3 << 18)) & 0x3F03FFF   (clamp: clear bits 18-19)
    // r[4] = (t3 >> 8) & 0x0FFFFF                     (clamp: clear bits 24+)
    ctx.r[0] = t0 & 67108863;
    ctx.r[1] = ((t0 >> 26) | (t1 << 6)) & 67108803;
    ctx.r[2] = ((t1 >> 20) | (t2 << 12)) & 67105023;
    ctx.r[3] = ((t2 >> 14) | (t3 << 18)) & 66076671;
    ctx.r[4] = (t3 >> 8) & 1048575;

    // Load s from key.bytes[16..31] as 4 LE u32 limbs (no clamp)
    ctx.s[0] = (key.bytes[16] as u32) | ((key.bytes[17] as u32) << 8) | ((key.bytes[18] as u32) << 16) | ((key.bytes[19] as u32) << 24);
    ctx.s[1] = (key.bytes[20] as u32) | ((key.bytes[21] as u32) << 8) | ((key.bytes[22] as u32) << 16) | ((key.bytes[23] as u32) << 24);
    ctx.s[2] = (key.bytes[24] as u32) | ((key.bytes[25] as u32) << 8) | ((key.bytes[26] as u32) << 16) | ((key.bytes[27] as u32) << 24);
    ctx.s[3] = (key.bytes[28] as u32) | ((key.bytes[29] as u32) << 8) | ((key.bytes[30] as u32) << 16) | ((key.bytes[31] as u32) << 24);

    // Zero accumulator and buffer
    ctx.acc[0] = 0;
    ctx.acc[1] = 0;
    ctx.acc[2] = 0;
    ctx.acc[3] = 0;
    ctx.acc[4] = 0;
    ctx.buf_len = 0;
}

// ===========================================================================
// Core block processing (26-bit limbs, poly1305-donna algorithm)
// ===========================================================================

// poly1305_block: process one 16-byte block.
// acc = (acc + block_with_high_bit) * r mod p
transform poly1305_block(ctx: State<Poly1305Ctx>) {
    // Load 16-byte block as 4 u32 LE words
    let t0 = (ctx.buf[0] as u32) | ((ctx.buf[1] as u32) << 8) | ((ctx.buf[2] as u32) << 16) | ((ctx.buf[3] as u32) << 24);
    let t1 = (ctx.buf[4] as u32) | ((ctx.buf[5] as u32) << 8) | ((ctx.buf[6] as u32) << 16) | ((ctx.buf[7] as u32) << 24);
    let t2 = (ctx.buf[8] as u32) | ((ctx.buf[9] as u32) << 8) | ((ctx.buf[10] as u32) << 16) | ((ctx.buf[11] as u32) << 24);
    let t3 = (ctx.buf[12] as u32) | ((ctx.buf[13] as u32) << 8) | ((ctx.buf[14] as u32) << 16) | ((ctx.buf[15] as u32) << 24);

    // Extract 5 × 26-bit limbs, set high bit (1 << 128) at bit 24 of h4
    let h0 = t0 & 67108863;
    let h1 = ((t0 >> 26) | (t1 << 6)) & 67108863;
    let h2 = ((t1 >> 20) | (t2 << 12)) & 67108863;
    let h3 = ((t2 >> 14) | (t3 << 18)) & 67108863;
    let h4 = (t3 >> 8) | (1 << 24);

    // Add h to accumulator (acc += h, with carry propagation in 26-bit limbs)
    let a0 = ctx.acc[0] + h0;
    let a1 = ctx.acc[1] + h1;
    let a2 = ctx.acc[2] + h2;
    let a3 = ctx.acc[3] + h3;
    let a4 = ctx.acc[4] + h4;

    // Carry-propagate the addition (each limb may exceed 26 bits)
    let c0 = a0 >> 26;
    let p0 = a0 & 67108863;
    let a1p = a1 + c0;
    let c1 = a1p >> 26;
    let p1 = a1p & 67108863;
    let a2p = a2 + c1;
    let c2 = a2p >> 26;
    let p2 = a2p & 67108863;
    let a3p = a3 + c2;
    let c3 = a3p >> 26;
    let p3 = a3p & 67108863;
    let a4p = a4 + c3;
    let c4 = a4p >> 26;
    let p4 = a4p & 67108863;
    // Fold final carry via ×5 (2^130 ≡ 5 mod p)
    let p0f = p0 + (c4 * 5);
    let cf = p0f >> 26;
    let p0ff = p0f & 67108863;
    let p1f = p1 + cf;

    // Now (p0ff, p1f, p2, p3, p4) is the accumulator + block value.
    // Multiply by r using the folded schoolbook method:
    // d[k] = sum_{i+j=k} h_i * r_j  (for low part, k=0..4)
    // High products (i+j >= 5) are pre-multiplied by 5 and added to d[k-5].
    let r0 = ctx.r[0];
    let r1 = ctx.r[1];
    let r2 = ctx.r[2];
    let r3 = ctx.r[3];
    let r4 = ctx.r[4];

    let d0: u64 = (p0ff as u64) * (r0 as u64)
              + 5 * ((p1f as u64) * (r4 as u64))
              + 5 * ((p2 as u64) * (r3 as u64))
              + 5 * ((p3 as u64) * (r2 as u64))
              + 5 * ((p4 as u64) * (r1 as u64));
    let d1: u64 = (p0ff as u64) * (r1 as u64)
              + (p1f as u64) * (r0 as u64)
              + 5 * ((p2 as u64) * (r4 as u64))
              + 5 * ((p3 as u64) * (r3 as u64))
              + 5 * ((p4 as u64) * (r2 as u64));
    let d2: u64 = (p0ff as u64) * (r2 as u64)
              + (p1f as u64) * (r1 as u64)
              + (p2 as u64) * (r0 as u64)
              + 5 * ((p3 as u64) * (r4 as u64))
              + 5 * ((p4 as u64) * (r3 as u64));
    let d3: u64 = (p0ff as u64) * (r3 as u64)
              + (p1f as u64) * (r2 as u64)
              + (p2 as u64) * (r1 as u64)
              + (p3 as u64) * (r0 as u64)
              + 5 * ((p4 as u64) * (r4 as u64));
    let d4: u64 = (p0ff as u64) * (r4 as u64)
              + (p1f as u64) * (r3 as u64)
              + (p2 as u64) * (r2 as u64)
              + (p3 as u64) * (r1 as u64)
              + (p4 as u64) * (r0 as u64);

    // Carry propagation: reduce d[0..4] to 5 × 26-bit limbs
    let c0m = d0 >> 26;
    let m0: u32 = (d0 & 67108863) as u32;
    let d1p = d1 + c0m;
    let c1m = d1p >> 26;
    let m1: u32 = (d1p & 67108863) as u32;
    let d2p = d2 + c1m;
    let c2m = d2p >> 26;
    let m2: u32 = (d2p & 67108863) as u32;
    let d3p = d3 + c2m;
    let c3m = d3p >> 26;
    let m3: u32 = (d3p & 67108863) as u32;
    let d4p = d4 + c3m;
    let c4m = d4p >> 26;
    let m4: u32 = (d4p & 67108863) as u32;
    // Fold final carry via ×5
    let m0p = (m0 as u64) + (c4m * 5);
    let cf2 = m0p >> 26;
    let m0f: u32 = (m0p & 67108863) as u32;
    let m1f: u32 = (m1 as u64 + cf2) as u32;

    // Store result (accumulator is now < 2^131, lazy reduction in final)
    ctx.acc[0] = m0f;
    ctx.acc[1] = m1f;
    ctx.acc[2] = m2;
    ctx.acc[3] = m3;
    ctx.acc[4] = m4;
}

// ===========================================================================
// Update (absorb message bytes)
// ===========================================================================

transform poly1305_update(ctx: State<Poly1305Ctx>, msg: State<Poly1305Msg>, len: u32) {
    let i: u32 = 0;
    while i < len {
        ctx.buf[ctx.buf_len] = msg.bytes[i];
        ctx.buf_len = ctx.buf_len + 1;
        i = i + 1;
        if ctx.buf_len == 16 {
            poly1305_block(ctx);
            ctx.buf_len = 0;
        }
    }
}

// ===========================================================================
// Finalize (produce 16-byte tag)
// ===========================================================================

transform poly1305_final(ctx: State<Poly1305Ctx>, tag: State<Poly1305Tag>) {
    // Process any remaining bytes in the buffer (partial block)
    if ctx.buf_len > 0 {
        // Append 0x01 after the last data byte, pad with zeros to 16 bytes
        ctx.buf[ctx.buf_len] = 1;
        let i: u32 = ctx.buf_len + 1;
        while i < 16 {
            ctx.buf[i] = 0;
            i = i + 1;
        }
        // Process partial block: high bit is at byte position buf_len,
        // not at bit 128. We set h4 without the (1 << 24) high bit.
        // Instead, the 0x01 byte at buf_len IS the high bit.
        poly1305_block_partial(ctx);
        ctx.buf_len = 0;
    }

    // Full carry propagation to reduce acc to < 2^130
    let c0 = ctx.acc[0] >> 26;
    ctx.acc[0] = ctx.acc[0] & 67108863;
    ctx.acc[1] = ctx.acc[1] + c0;
    let c1 = ctx.acc[1] >> 26;
    ctx.acc[1] = ctx.acc[1] & 67108863;
    ctx.acc[2] = ctx.acc[2] + c1;
    let c2 = ctx.acc[2] >> 26;
    ctx.acc[2] = ctx.acc[2] & 67108863;
    ctx.acc[3] = ctx.acc[3] + c2;
    let c3 = ctx.acc[3] >> 26;
    ctx.acc[3] = ctx.acc[3] & 67108863;
    ctx.acc[4] = ctx.acc[4] + c3;
    let c4 = ctx.acc[4] >> 26;
    ctx.acc[4] = ctx.acc[4] & 67108863;
    // Fold final carry via ×5
    ctx.acc[0] = ctx.acc[0] + (c4 * 5);
    let cf = ctx.acc[0] >> 26;
    ctx.acc[0] = ctx.acc[0] & 67108863;
    ctx.acc[1] = ctx.acc[1] + cf;

    // Now acc < 2^131. Subtract p if acc >= p (at most one subtraction).
    // p = 2^130 - 5. In 26-bit limbs: p = (67108859, 67108863, 67108863, 67108863, 67108863).
    // acc >= p iff acc + 5 >= 2^130 iff (acc + 5) produces a carry from limb 4.
    // We add 5 to acc[0] and propagate carry. If it overflows limb 4 (g4 >= 2^26),
    // then acc + 5 >= 2^130, so acc >= p.
    let g0: u32 = ctx.acc[0] + 5;
    let b0: u32 = 0;
    if g0 < ctx.acc[0] { b0 = 1; }
    if g0 >= 67108864 { b0 = b0 + 1; }  // overflow 26 bits
    let g1 = ctx.acc[1] + b0;
    let b1: u32 = 0;
    if g1 < ctx.acc[1] { b1 = 1; }
    if g1 >= 67108864 { b1 = b1 + 1; }
    let g2 = ctx.acc[2] + b1;
    let b2: u32 = 0;
    if g2 < ctx.acc[2] { b2 = 1; }
    if g2 >= 67108864 { b2 = b2 + 1; }
    let g3 = ctx.acc[3] + b2;
    let b3: u32 = 0;
    if g3 < ctx.acc[3] { b3 = 1; }
    if g3 >= 67108864 { b3 = b3 + 1; }
    let g4 = ctx.acc[4] + b3;

    // If g4 >= 2^26, then acc + 5 overflowed 130 bits → acc >= p
    let need_sub: u32 = 0;
    if g4 >= 67108864 { need_sub = 1; }

    let out0: u32;
    let out1: u32;
    let out2: u32;
    let out3: u32;
    let out4: u32;
    if need_sub == 1 {
        // Subtract p from acc (not from g)
        // p = (67108859, 67108863, 67108863, 67108863, 67108863) in 26-bit limbs
        let bb0: u32 = 0;
        if ctx.acc[0] < 67108859 { bb0 = 1; }
        out0 = ctx.acc[0] - 67108859;
        let bb1: u32 = bb0;
        if ctx.acc[1] < 67108863 { bb1 = bb1 + 1; }
        if ctx.acc[1] < bb0 { bb1 = bb1 + 1; }
        out1 = ctx.acc[1] - 67108863 - bb0;
        let bb2: u32 = bb1;
        if ctx.acc[2] < 67108863 { bb2 = bb2 + 1; }
        if ctx.acc[2] < bb1 { bb2 = bb2 + 1; }
        out2 = ctx.acc[2] - 67108863 - bb1;
        let bb3: u32 = bb2;
        if ctx.acc[3] < 67108863 { bb3 = bb3 + 1; }
        if ctx.acc[3] < bb2 { bb3 = bb3 + 1; }
        out3 = ctx.acc[3] - 67108863 - bb2;
        out4 = ctx.acc[4] - 67108863 - bb3;
    } else {
        out0 = ctx.acc[0];
        out1 = ctx.acc[1];
        out2 = ctx.acc[2];
        out3 = ctx.acc[3];
        out4 = ctx.acc[4];
    }

    // Add s to the reduced accumulator (s is 128 bits = 4 × 32-bit limbs)
    // acc + s: out is in 26-bit limbs, s is in 32-bit limbs. We need to
    // convert out to 32-bit representation, add s, then serialize.
    // Reconstruct the 128-bit value from 26-bit limbs:
    //   value = out0 + out1*2^26 + out2*2^52 + out3*2^78 + out4*2^104
    //   (out4 < 4, so bits 104-129 are just 2 bits)
    // Convert to 4 × 32-bit LE words:
    let v0: u32 = out0 | (out1 << 26);
    let v1: u32 = (out1 >> 6) | (out2 << 20);
    let v2: u32 = (out2 >> 12) | (out3 << 14);
    let v3: u32 = (out3 >> 18) | (out4 << 8);

    // Add s (4 × 32-bit, with carry)
    let f0 = v0 + ctx.s[0];
    let cs0: u32 = 0;
    if f0 < v0 { cs0 = 1; }
    let f1 = v1 + ctx.s[1] + cs0;
    let cs1: u32 = 0;
    if f1 < v1 { cs1 = 1; }
    if f1 < cs0 { cs1 = cs1 + 1; }
    let f2 = v2 + ctx.s[2] + cs1;
    let cs2: u32 = 0;
    if f2 < v2 { cs2 = 1; }
    if f2 < cs1 { cs2 = cs2 + 1; }
    let f3 = v3 + ctx.s[3] + cs2;

    // Serialize as 16 LE bytes
    tag.bytes[0]  = (f0 & 255) as u8;
    tag.bytes[1]  = ((f0 >> 8) & 255) as u8;
    tag.bytes[2]  = ((f0 >> 16) & 255) as u8;
    tag.bytes[3]  = ((f0 >> 24) & 255) as u8;
    tag.bytes[4]  = (f1 & 255) as u8;
    tag.bytes[5]  = ((f1 >> 8) & 255) as u8;
    tag.bytes[6]  = ((f1 >> 16) & 255) as u8;
    tag.bytes[7]  = ((f1 >> 24) & 255) as u8;
    tag.bytes[8]  = (f2 & 255) as u8;
    tag.bytes[9]  = ((f2 >> 8) & 255) as u8;
    tag.bytes[10] = ((f2 >> 16) & 255) as u8;
    tag.bytes[11] = ((f2 >> 24) & 255) as u8;
    tag.bytes[12] = (f3 & 255) as u8;
    tag.bytes[13] = ((f3 >> 8) & 255) as u8;
    tag.bytes[14] = ((f3 >> 16) & 255) as u8;
    tag.bytes[15] = ((f3 >> 24) & 255) as u8;
}

// poly1305_block_partial: process a partial block where the 0x01 separator
// is already inside ctx.buf at position buf_len. No extra high bit (1<<128).
transform poly1305_block_partial(ctx: State<Poly1305Ctx>) {
    // Load 16-byte block as 4 u32 LE words
    let t0 = (ctx.buf[0] as u32) | ((ctx.buf[1] as u32) << 8) | ((ctx.buf[2] as u32) << 16) | ((ctx.buf[3] as u32) << 24);
    let t1 = (ctx.buf[4] as u32) | ((ctx.buf[5] as u32) << 8) | ((ctx.buf[6] as u32) << 16) | ((ctx.buf[7] as u32) << 24);
    let t2 = (ctx.buf[8] as u32) | ((ctx.buf[9] as u32) << 8) | ((ctx.buf[10] as u32) << 16) | ((ctx.buf[11] as u32) << 24);
    let t3 = (ctx.buf[12] as u32) | ((ctx.buf[13] as u32) << 8) | ((ctx.buf[14] as u32) << 16) | ((ctx.buf[15] as u32) << 24);

    // Extract 5 × 26-bit limbs. NO high bit (1 << 24) — the 0x01 byte
    // at position buf_len IS the high bit, already inside the data.
    let h0 = t0 & 67108863;
    let h1 = ((t0 >> 26) | (t1 << 6)) & 67108863;
    let h2 = ((t1 >> 20) | (t2 << 12)) & 67108863;
    let h3 = ((t2 >> 14) | (t3 << 18)) & 67108863;
    let h4 = (t3 >> 8) & 67108863;

    // Add h to accumulator
    let a0 = ctx.acc[0] + h0;
    let a1 = ctx.acc[1] + h1;
    let a2 = ctx.acc[2] + h2;
    let a3 = ctx.acc[3] + h3;
    let a4 = ctx.acc[4] + h4;

    let c0 = a0 >> 26;
    let p0 = a0 & 67108863;
    let a1p = a1 + c0;
    let c1 = a1p >> 26;
    let p1 = a1p & 67108863;
    let a2p = a2 + c1;
    let c2 = a2p >> 26;
    let p2 = a2p & 67108863;
    let a3p = a3 + c2;
    let c3 = a3p >> 26;
    let p3 = a3p & 67108863;
    let a4p = a4 + c3;
    let c4 = a4p >> 26;
    let p4 = a4p & 67108863;
    let p0f = p0 + (c4 * 5);
    let cf = p0f >> 26;
    let p0ff = p0f & 67108863;
    let p1f = p1 + cf;

    // Multiply by r (same as poly1305_block)
    let r0 = ctx.r[0];
    let r1 = ctx.r[1];
    let r2 = ctx.r[2];
    let r3 = ctx.r[3];
    let r4 = ctx.r[4];

    let d0: u64 = (p0ff as u64) * (r0 as u64)
              + 5 * ((p1f as u64) * (r4 as u64))
              + 5 * ((p2 as u64) * (r3 as u64))
              + 5 * ((p3 as u64) * (r2 as u64))
              + 5 * ((p4 as u64) * (r1 as u64));
    let d1: u64 = (p0ff as u64) * (r1 as u64)
              + (p1f as u64) * (r0 as u64)
              + 5 * ((p2 as u64) * (r4 as u64))
              + 5 * ((p3 as u64) * (r3 as u64))
              + 5 * ((p4 as u64) * (r2 as u64));
    let d2: u64 = (p0ff as u64) * (r2 as u64)
              + (p1f as u64) * (r1 as u64)
              + (p2 as u64) * (r0 as u64)
              + 5 * ((p3 as u64) * (r4 as u64))
              + 5 * ((p4 as u64) * (r3 as u64));
    let d3: u64 = (p0ff as u64) * (r3 as u64)
              + (p1f as u64) * (r2 as u64)
              + (p2 as u64) * (r1 as u64)
              + (p3 as u64) * (r0 as u64)
              + 5 * ((p4 as u64) * (r4 as u64));
    let d4: u64 = (p0ff as u64) * (r4 as u64)
              + (p1f as u64) * (r3 as u64)
              + (p2 as u64) * (r2 as u64)
              + (p3 as u64) * (r1 as u64)
              + (p4 as u64) * (r0 as u64);

    let c0m = d0 >> 26;
    let m0: u32 = (d0 & 67108863) as u32;
    let d1p = d1 + c0m;
    let c1m = d1p >> 26;
    let m1: u32 = (d1p & 67108863) as u32;
    let d2p = d2 + c1m;
    let c2m = d2p >> 26;
    let m2: u32 = (d2p & 67108863) as u32;
    let d3p = d3 + c2m;
    let c3m = d3p >> 26;
    let m3: u32 = (d3p & 67108863) as u32;
    let d4p = d4 + c3m;
    let c4m = d4p >> 26;
    let m4: u32 = (d4p & 67108863) as u32;
    let m0p = (m0 as u64) + (c4m * 5);
    let cf2 = m0p >> 26;
    let m0f: u32 = (m0p & 67108863) as u32;
    let m1f: u32 = (m1 as u64 + cf2) as u32;

    ctx.acc[0] = m0f;
    ctx.acc[1] = m1f;
    ctx.acc[2] = m2;
    ctx.acc[3] = m3;
    ctx.acc[4] = m4;
}
