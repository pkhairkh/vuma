    ctx.sbox[384]=4; ctx.sbox[385]=11; ctx.sbox[386]=2; ctx.sbox[387]=14; ctx.sbox[388]=15; ctx.sbox[389]=0; ctx.sbox[390]=8; ctx.sbox[391]=13;
    ctx.sbox[392]=3; ctx.sbox[393]=12; ctx.sbox[394]=9; ctx.sbox[395]=7; ctx.sbox[396]=5; ctx.sbox[397]=10; ctx.sbox[398]=6; ctx.sbox[399]=1;
    ctx.sbox[400]=13; ctx.sbox[401]=0; ctx.sbox[402]=11; ctx.sbox[403]=7; ctx.sbox[404]=4; ctx.sbox[405]=9; ctx.sbox[406]=1; ctx.sbox[407]=10;
    ctx.sbox[408]=14; ctx.sbox[409]=3; ctx.sbox[410]=5; ctx.sbox[411]=12; ctx.sbox[412]=2; ctx.sbox[413]=15; ctx.sbox[414]=8; ctx.sbox[415]=6;
    ctx.sbox[416]=1; ctx.sbox[417]=4; ctx.sbox[418]=11; ctx.sbox[419]=13; ctx.sbox[420]=12; ctx.sbox[421]=3; ctx.sbox[422]=7; ctx.sbox[423]=14;
    ctx.sbox[424]=10; ctx.sbox[425]=15; ctx.sbox[426]=6; ctx.sbox[427]=8; ctx.sbox[428]=0; ctx.sbox[429]=5; ctx.sbox[430]=9; ctx.sbox[431]=2;
    ctx.sbox[432]=6; ctx.sbox[433]=11; ctx.sbox[434]=13; ctx.sbox[435]=8; ctx.sbox[436]=1; ctx.sbox[437]=4; ctx.sbox[438]=10; ctx.sbox[439]=7;
    ctx.sbox[440]=9; ctx.sbox[441]=5; ctx.sbox[442]=0; ctx.sbox[443]=15; ctx.sbox[444]=14; ctx.sbox[445]=2; ctx.sbox[446]=3; ctx.sbox[447]=12;
    // S8 (offset 448)
    ctx.sbox[448]=13; ctx.sbox[449]=2; ctx.sbox[450]=8; ctx.sbox[451]=4; ctx.sbox[452]=6; ctx.sbox[453]=15; ctx.sbox[454]=11; ctx.sbox[455]=1;
    ctx.sbox[456]=10; ctx.sbox[457]=9; ctx.sbox[458]=3; ctx.sbox[459]=14; ctx.sbox[460]=5; ctx.sbox[461]=0; ctx.sbox[462]=12; ctx.sbox[463]=7;
    ctx.sbox[464]=1; ctx.sbox[465]=15; ctx.sbox[466]=13; ctx.sbox[467]=8; ctx.sbox[468]=10; ctx.sbox[469]=3; ctx.sbox[470]=7; ctx.sbox[471]=4;
    ctx.sbox[472]=12; ctx.sbox[473]=5; ctx.sbox[474]=6; ctx.sbox[475]=11; ctx.sbox[476]=0; ctx.sbox[477]=14; ctx.sbox[478]=9; ctx.sbox[479]=2;
    ctx.sbox[480]=7; ctx.sbox[481]=11; ctx.sbox[482]=4; ctx.sbox[483]=1; ctx.sbox[484]=9; ctx.sbox[485]=12; ctx.sbox[486]=14; ctx.sbox[487]=2;
    ctx.sbox[488]=0; ctx.sbox[489]=6; ctx.sbox[490]=10; ctx.sbox[491]=13; ctx.sbox[492]=15; ctx.sbox[493]=3; ctx.sbox[494]=5; ctx.sbox[495]=8;
    ctx.sbox[496]=2; ctx.sbox[497]=1; ctx.sbox[498]=14; ctx.sbox[499]=7; ctx.sbox[500]=4; ctx.sbox[501]=10; ctx.sbox[502]=8; ctx.sbox[503]=13;
    ctx.sbox[504]=15; ctx.sbox[505]=12; ctx.sbox[506]=9; ctx.sbox[507]=0; ctx.sbox[508]=3; ctx.sbox[509]=5; ctx.sbox[510]=6; ctx.sbox[511]=11;
}


// des_load_tables: populate all 9 permutation/lookup tables in ctx.
// Called once per context (idempotent — safe to call multiple times).
transform des_load_tables(ctx: State<DesCtx>) {
    des_load_ip(ctx);
    des_load_fp(ctx);
    des_load_e(ctx);
    des_load_p(ctx);
    des_load_pc1c(ctx);
    des_load_pc1d(ctx);
    des_load_pc2(ctx);
    des_load_shifts(ctx);
    des_load_sbox(ctx);
}

// ===========================================================================
// Bit permutation primitives (FIPS 46-3 §3)
// ===========================================================================

// Initial Permutation IP — 64-bit → 64-bit.
// Output bit i (MSB-first, i=0..63) = input bit ctx.ip[i] (1-indexed MSB-first).
transform des_ip_permute(ctx: State<DesCtx>, in_hi: u32, in_lo: u32) -> u64 {
    let v: u64 = (((in_hi as u64) << 32) | (in_lo as u64));
    let out: u64 = 0;
    let i: u32 = 0;
    while i < 64 {
        let src = (ctx.ip[i] as u32) as u64;
        let bit_val = (v >> (64 - src)) & 1;
        out = out | (bit_val << (63 - (i as u64)));
        i = i + 1;
    }
    return out;
}

// Final Permutation FP (= IP^-1) — 64-bit → 64-bit.
transform des_fp_permute(ctx: State<DesCtx>, in64: u64) -> u64 {
    let out: u64 = 0;
    let i: u32 = 0;
    while i < 64 {
        let src = (ctx.fp[i] as u32) as u64;
        let bit_val = (in64 >> (64 - src)) & 1;
        out = out | (bit_val << (63 - (i as u64)));
        i = i + 1;
    }
    return out;
}

// Expansion E — 32-bit → 48-bit.
transform des_expand_e(ctx: State<DesCtx>, r: u32) -> u64 {
    let out: u64 = 0;
    let i: u32 = 0;
    while i < 48 {
        let src = (ctx.e[i] as u32) as u64;
        let bit_val = (((r as u64) >> (32 - src)) & 1);
        out = out | (bit_val << (47 - (i as u64)));
        i = i + 1;
    }
    return out;
}

// Permutation P — 32-bit → 32-bit.
transform des_perm_p(ctx: State<DesCtx>, x: u32) -> u32 {
    let out: u32 = 0;
    let i: u32 = 0;
    while i < 32 {
        let src = ctx.p[i] as u32;
        let bit_val = (x >> (32 - src)) & 1;
        out = out | (bit_val << (31 - i));
        i = i + 1;
    }
    return out;
}

// S-box lookup: 6-bit input → 4-bit output.
// row = ((v>>4)&2) | (v&1); col = (v>>1)&15; idx = row*16 + col.
// S-box table is flat: ctx.sbox[box*64 + idx].
transform des_sbox_lookup(ctx: State<DesCtx>, box_idx: u32, val6: u32) -> u32 {
    let row = ((val6 >> 4) & 2) | (val6 & 1);
    let col = (val6 >> 1) & 15;
    let idx = row * 16 + col;
    let off = box_idx * 64;
    return ctx.sbox[off + idx] as u32;
}

// Feistel f function: f(R, K) = P(S(E(R) XOR K)).
// E expands 32-bit R to 48 bits, XORs with 48-bit subkey, splits into 8
// 6-bit groups for S-boxes (S1 = bits 47..42, S8 = bits 5..0), then P permutes.
transform des_f(ctx: State<DesCtx>, r: u32, k48: u64) -> u32 {
    let er = des_expand_e(ctx, r) ^ k48;
    let out: u32 = 0;
    let box: u32 = 0;
    while box < 8 {
        let v6 = ((er >> ((42 - box * 6) as u64)) & 63) as u32;
        let s = des_sbox_lookup(ctx, box, v6);
        out = (out << 4) | s;
        box = box + 1;
    }
    return des_perm_p(ctx, out);
}

// ===========================================================================
// Key schedule (FIPS 46-3 §3.2)
// ===========================================================================

// PC-1: 64-bit key → 56-bit (C||D, each 28 bits). Parity bits dropped.
// Returns (C<<28) | D as a 56-bit u64.
transform des_pc1(ctx: State<DesCtx>, key_hi: u32, key_lo: u32) -> u64 {
    let key64: u64 = (((key_hi as u64) << 32) | (key_lo as u64));
    let c: u64 = 0;
    let d: u64 = 0;
    let i: u32 = 0;
    while i < 28 {
        let src_c = (ctx.pc1c[i] as u32) as u64;
        let vc = (key64 >> (64 - src_c)) & 1;
        c = c | (vc << (27 - (i as u64)));
        let src_d = (ctx.pc1d[i] as u32) as u64;
        let vd = (key64 >> (64 - src_d)) & 1;
        d = d | (vd << (27 - (i as u64)));
        i = i + 1;
    }
    return ((c << 28) | d) & DES_MASK56;
}

// PC-2: 56-bit (C||D) → 48-bit subkey.
transform des_pc2(ctx: State<DesCtx>, cd: u64) -> u64 {
    let out: u64 = 0;
    let i: u32 = 0;
    while i < 48 {
        let src = (ctx.pc2[i] as u32) as u64;
        let bit_val = (cd >> (56 - src)) & 1;
        out = out | (bit_val << (47 - (i as u64)));
        i = i + 1;
    }
    return out;
}

// Left-rotate 28-bit value by n positions (1 <= n <= 2).
transform des_rotl28(x: u64, n: u64) -> u64 {
    return ((x << n) | (x >> (28 - n))) & DES_MASK28;
}

// Key schedule: produce 16 subkeys (each 48 bits = 6 bytes) in ctx.subkeys.
// Takes the 64-bit key as a (hi, lo) u32 pair (big-endian) to avoid the
// v0.2.0-alpha.15 codegen bug with passing State<DesKey> as a transform
// parameter (calling des_key_schedule twice with different State<DesKey>
// args triggers SIGBUS — the parameter-state-rebinding codegen bug).
transform des_key_schedule(ctx: State<DesCtx>, key_hi: u32, key_lo: u32) {
    // PC-1: split into 28-bit halves (C, D), packed as C<<28 | D.
    let cd: u64 = des_pc1(ctx, key_hi, key_lo);

    // 16 rounds: rotate (C, D) by shifts[round], then PC-2 → 48-bit subkey.
    let round: u32 = 0;
    while round < 16 {
        let sh = (ctx.shifts[round] as u32) as u64;
        // Split, rotate each half, recombine.
        let c = (cd >> 28) & DES_MASK28;
        let d = cd & DES_MASK28;
        let new_c = des_rotl28(c, sh);
        let new_d = des_rotl28(d, sh);
        cd = ((new_c << 28) | new_d) & DES_MASK56;

        let sk = des_pc2(ctx, cd);
        // Store 48-bit subkey as 6 bytes (big-endian) at subkeys[round*6].
        let off = round * 6;
        ctx.subkeys[off]     = ((sk >> 40) & 255) as u8;
        ctx.subkeys[off + 1] = ((sk >> 32) & 255) as u8;
        ctx.subkeys[off + 2] = ((sk >> 24) & 255) as u8;
        ctx.subkeys[off + 3] = ((sk >> 16) & 255) as u8;
        ctx.subkeys[off + 4] = ((sk >> 8) & 255) as u8;
        ctx.subkeys[off + 5] = (sk & 255) as u8;
        round = round + 1;
    }
}

// Reconstruct 48-bit subkey from 6 stored bytes.
transform des_load_subkey(ctx: State<DesCtx>, round: u32) -> u64 {
    let off = round * 6;
    let b0 = ctx.subkeys[off] as u64;
    let b1 = ctx.subkeys[off + 1] as u64;
    let b2 = ctx.subkeys[off + 2] as u64;
    let b3 = ctx.subkeys[off + 3] as u64;
    let b4 = ctx.subkeys[off + 4] as u64;
    let b5 = ctx.subkeys[off + 5] as u64;
    return (b0 << 40) | (b1 << 32) | (b2 << 24) | (b3 << 16) | (b4 << 8) | b5;
}

// ===========================================================================
// DES init / encrypt / decrypt (FIPS 46-3 §3)
// ===========================================================================

// des_init: load tables + compute subkeys from key. Call once per context.
// Reads the 8 key bytes from `key.data[0..7]` and packs them into a (hi, lo)
// u32 pair before calling des_key_schedule (avoids the parameter-state-
// rebinding codegen bug — see des_key_schedule header comment).
transform des_init(ctx: State<DesCtx>, key: State<DesKey>) {
    des_load_tables(ctx);
    // Load 64-bit key as (hi, lo) u32 pair (big-endian) using LITERAL indices.
    let key_hi: u32 = (((key.data[0] as u32) << 24) | ((key.data[1] as u32) << 16)
                    | ((key.data[2] as u32) << 8)  |  (key.data[3] as u32));
    let key_lo: u32 = (((key.data[4] as u32) << 24) | ((key.data[5] as u32) << 16)
                    | ((key.data[6] as u32) << 8)  |  (key.data[7] as u32));
    des_key_schedule(ctx, key_hi, key_lo);
}

// des_encrypt_block: encrypt one 8-byte block.
// IP → 16 Feistel rounds (L,R) → swap → FP → 8-byte ciphertext.
transform des_encrypt_block(ctx: State<DesCtx>, pt: State<DesBlock>, ct: State<DesBlock>) {
    // Load 64-bit plaintext as (hi, lo) u32 pair (big-endian).
    let in_hi: u32 = 0;
    let in_lo: u32 = 0;
    let i: u32 = 0;
    while i < 4 {
        in_hi = (in_hi << 8) | (pt.data[i] as u32);
        i = i + 1;
    }
    while i < 8 {
        in_lo = (in_lo << 8) | (pt.data[i] as u32);
        i = i + 1;
    }

    // IP. After IP, L = high 32 bits, R = low 32 bits.
    let ip = des_ip_permute(ctx, in_hi, in_lo);
    let l: u32 = (ip >> 32) as u32;
    let r: u32 = ip as u32;

    // 16 rounds.
    let round: u32 = 0;
    while round < 16 {
        let sk = des_load_subkey(ctx, round);
        let new_r = l ^ des_f(ctx, r, sk);
        l = r;
        r = new_r;
        round = round + 1;
    }

    // Final permutation on (R || L) — note the swap.
    let pre_fp: u64 = (((r as u64) << 32) | (l as u64));
    let fp = des_fp_permute(ctx, pre_fp);

    // Store 64-bit ciphertext big-endian.
    ct.data[0] = ((fp >> 56) & 255) as u8;
    ct.data[1] = ((fp >> 48) & 255) as u8;
    ct.data[2] = ((fp >> 40) & 255) as u8;
    ct.data[3] = ((fp >> 32) & 255) as u8;
    ct.data[4] = ((fp >> 24) & 255) as u8;
    ct.data[5] = ((fp >> 16) & 255) as u8;
    ct.data[6] = ((fp >> 8) & 255) as u8;
    ct.data[7] = (fp & 255) as u8;
}

// des_decrypt_block: decrypt one 8-byte block (subkeys applied in reverse).
transform des_decrypt_block(ctx: State<DesCtx>, ct: State<DesBlock>, pt: State<DesBlock>) {
    let in_hi: u32 = 0;
    let in_lo: u32 = 0;
    let i: u32 = 0;
    while i < 4 {
        in_hi = (in_hi << 8) | (ct.data[i] as u32);
        i = i + 1;
    }
    while i < 8 {
        in_lo = (in_lo << 8) | (ct.data[i] as u32);
        i = i + 1;
    }

    let ip = des_ip_permute(ctx, in_hi, in_lo);
    let l: u32 = (ip >> 32) as u32;
    let r: u32 = ip as u32;

    // 16 rounds with subkeys in reverse order (15, 14, ..., 0).
    let round: u32 = 16;
    while round > 0 {
        let sk = des_load_subkey(ctx, round - 1);
        let new_r = l ^ des_f(ctx, r, sk);
        l = r;
        r = new_r;
        round = round - 1;
    }

    let pre_fp: u64 = (((r as u64) << 32) | (l as u64));
    let fp = des_fp_permute(ctx, pre_fp);

    pt.data[0] = ((fp >> 56) & 255) as u8;
    pt.data[1] = ((fp >> 48) & 255) as u8;
    pt.data[2] = ((fp >> 40) & 255) as u8;
    pt.data[3] = ((fp >> 32) & 255) as u8;
    pt.data[4] = ((fp >> 24) & 255) as u8;
    pt.data[5] = ((fp >> 16) & 255) as u8;
    pt.data[6] = ((fp >> 8) & 255) as u8;
    pt.data[7] = (fp & 255) as u8;
}

// ===========================================================================
// 3DES EDE3 (SP 800-67r1) — three independent DES contexts.
// ===========================================================================

// tdes_ede3_encrypt_block: C = E_K3(D_K2(E_K1(P))).
// Caller passes three pre-keyed contexts (ctx1=K1, ctx2=K2, ctx3=K3) plus
// a scratch block (tmp) for the E→D→E chain. The caller manages tmp's
// lifetime to avoid nested state_new() allocations.
transform tdes_ede3_encrypt_block(
    ctx1: State<DesCtx>, ctx2: State<DesCtx>, ctx3: State<DesCtx>,
    pt: State<DesBlock>, tmp: State<DesBlock>, ct: State<DesBlock>
) {
    des_encrypt_block(ctx1, pt, tmp);
    des_decrypt_block(ctx2, tmp, tmp);
    des_encrypt_block(ctx3, tmp, ct);
}

// tdes_ede3_decrypt_block: P = D_K1(E_K2(D_K3(C))).
transform tdes_ede3_decrypt_block(
    ctx1: State<DesCtx>, ctx2: State<DesCtx>, ctx3: State<DesCtx>,
    ct: State<DesBlock>, tmp: State<DesBlock>, pt: State<DesBlock>
) {
    des_decrypt_block(ctx3, ct, tmp);
    des_encrypt_block(ctx2, tmp, tmp);
    des_decrypt_block(ctx1, tmp, pt);
}
