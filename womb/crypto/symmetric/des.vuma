// ═══════════════════════════════════════════════════════════════════════════
// womb/crypto/symmetric/des.vuma — DES & Triple-DES (FIPS 46-3 / SP 800-67r1)
// PMT-native rewrite (W2-F).
// ═══════════════════════════════════════════════════════════════════════════
//
// DES: 64-bit key (56 effective bits after parity drop), 64-bit block,
// 16-round Feistel network with IP / FP bit permutations, E expansion,
// 8 S-boxes, and P permutation. Subkeys derived via PC-1 (64→56) +
// 16× (LS + PC-2) (56→48).
//
// 3DES (TDEA EDE3, SP 800-67r1): C = E_K3(D_K2(E_K1(P)));
// P = D_K1(E_K2(D_K3(C))). Three independent DES contexts are used.
//
// Test vectors (verified against PyCryptodome / OpenSSL):
//   DES (FIPS 46-3 Appendix B):
//     key       = 133457799BBCDFF1
//     plaintext = 0123456789ABCDEF
//     ciphertext= 85E813540F0AB405
//   3DES EDE3 (SP 800-67r1):
//     key1 || key2 || key3 = 0123456789ABCDEF23456789ABCDEF013456789ABCDEF012
//     plaintext = 0123456789ABCDEF
//     ciphertext= 38F194ABC829B362
//
// PMT patterns (per W2-A aes128 / W48 sha / W1-A md5 / W2-C chacha20):
//   - `state_new(Layout)` for allocations (NEVER allocate/free/Address/*ptr)
//   - `State<T>` for transform parameters that take pointers
//   - `[u8; N]` byte arrays with literal / precomputed indices for tables
//   - Tables (IP, FP, E, P, PC1-C/D, PC2, shift schedule, 8 S-boxes) are
//     stored directly in `DesCtx` as `[u8; N]` fields — same pattern as
//     `AesCtx.sbox` / `AesCtx.inv_sbox` (avoids passing a tables state
//     to every round function — compiler-bug workaround #3).
//   - u64 used throughout for 48/56/64-bit intermediate values (matches
//     the sha512.vuma PMT pattern for 64-bit words).
//   - Subkeys stored as 96 bytes (16 × 6 bytes) in ctx.subkeys.
//   - Loop-variable-derived byte offsets precomputed into local vars
//     (`let off = round * 6;`) before array access — md5.vuma pattern.
//
// No `main()` — importable library module.

const DES_MASK32: u32 = 4294967295;
const DES_MASK64: u64 = (1 << 63) | ((1 << 63) - 1);
const DES_MASK28: u64 = 268435455;          // 0x0FFFFFFF — 28 ones
const DES_MASK56: u64 = 72057594037927935;  // 0x00FFFFFFFFFFFFFF — 56 ones

// ===========================================================================
// Layouts
// ===========================================================================

// DES context: all 9 permutation/lookup tables + 16 subkeys (96 bytes).
// Tables are loaded once via des_load_tables() then re-used across all
// blocks encrypted/decrypted under the same key.
layout DesCtx = {
    ip:     [u8; 64],   // Initial Permutation (1-indexed source positions)
    fp:     [u8; 64],   // Final Permutation (inverse of IP)
    e:      [u8; 48],   // Expansion E (32→48)
    p:      [u8; 32],   // Permutation P (32→32)
    pc1c:   [u8; 28],   // PC-1 C-half (64→28)
    pc1d:   [u8; 28],   // PC-1 D-half (64→28)
    pc2:    [u8; 48],   // PC-2 (56→48)
    shifts: [u8; 16],   // Per-round rotation amount (1 or 2)
    sbox:   [u8; 512],  // 8 S-boxes × 64 entries (flat: box*64 + idx)
    subkeys:[u8; 96],   // 16 subkeys × 6 bytes (48-bit each)
}

layout DesBlock = { data: [u8; 8] }   // 64-bit plaintext/ciphertext block
layout DesKey   = { data: [u8; 8] }   // 64-bit key (parity bits ignored)

// ===========================================================================
// Table loaders — FIPS 46-3 canonical values
// ===========================================================================

transform des_load_ip(ctx: State<DesCtx>) {
    ctx.ip[0]=58; ctx.ip[1]=50; ctx.ip[2]=42; ctx.ip[3]=34; ctx.ip[4]=26; ctx.ip[5]=18; ctx.ip[6]=10; ctx.ip[7]=2;
    ctx.ip[8]=60; ctx.ip[9]=52; ctx.ip[10]=44; ctx.ip[11]=36; ctx.ip[12]=28; ctx.ip[13]=20; ctx.ip[14]=12; ctx.ip[15]=4;
    ctx.ip[16]=62; ctx.ip[17]=54; ctx.ip[18]=46; ctx.ip[19]=38; ctx.ip[20]=30; ctx.ip[21]=22; ctx.ip[22]=14; ctx.ip[23]=6;
    ctx.ip[24]=64; ctx.ip[25]=56; ctx.ip[26]=48; ctx.ip[27]=40; ctx.ip[28]=32; ctx.ip[29]=24; ctx.ip[30]=16; ctx.ip[31]=8;
    ctx.ip[32]=57; ctx.ip[33]=49; ctx.ip[34]=41; ctx.ip[35]=33; ctx.ip[36]=25; ctx.ip[37]=17; ctx.ip[38]=9; ctx.ip[39]=1;
    ctx.ip[40]=59; ctx.ip[41]=51; ctx.ip[42]=43; ctx.ip[43]=35; ctx.ip[44]=27; ctx.ip[45]=19; ctx.ip[46]=11; ctx.ip[47]=3;
    ctx.ip[48]=61; ctx.ip[49]=53; ctx.ip[50]=45; ctx.ip[51]=37; ctx.ip[52]=29; ctx.ip[53]=21; ctx.ip[54]=13; ctx.ip[55]=5;
    ctx.ip[56]=63; ctx.ip[57]=55; ctx.ip[58]=47; ctx.ip[59]=39; ctx.ip[60]=31; ctx.ip[61]=23; ctx.ip[62]=15; ctx.ip[63]=7;
}

