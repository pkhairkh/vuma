transform p521_gx_be(out: State<P521Fe>) {
    p521_fe_zero(out);
    // STUB: pending semantic rewrite.
}

transform p521_gy_be(out: State<P521Fe>) {
    p521_fe_zero(out);
    // STUB: pending semantic rewrite.
}

transform swap_endian_66(dst: State<P521Fe>, src: State<P521Fe>) {
    let i: u32 = 0;
    while i < 66 {
        let inv: u32 = 65 - i;
        dst.bytes[i] = src.bytes[inv];
        i = i + 1;
    }
}

