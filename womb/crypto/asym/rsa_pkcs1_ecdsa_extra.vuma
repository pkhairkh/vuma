// Point compression: 57-byte encoding = y || sign(x). (Stub: zero output.)
transform ed448_point_compress(out: State<Ed448Seed>, x_le: State<Ed448Fe>, y_le: State<Ed448Fe>) {
    let i: u32 = 0;
    while i < 57 { out.bytes[i] = 0; i = i + 1; }
    // STUB: pending semantic rewrite.
}

// Recover x from y. (Stub: returns 0.)
transform ed448_recover_x(x_le: State<Ed448Fe>, y_le: State<Ed448Fe>, sign: u32) -> u32 {
    ed448_fe_zero(x_le);
    // STUB: returns 0 (invalid) pending semantic rewrite.
    return 0;
}

// Point decompression. (Stub: returns 0.)
transform ed448_point_decompress(x_le: State<Ed448Fe>, y_le: State<Ed448Fe>, enc: State<Ed448Seed>) -> u32 {
    ed448_fe_zero(x_le);
    ed448_fe_zero(y_le);
    // STUB: returns 0 (invalid) pending semantic rewrite.
    return 0;
}

// Ed448 Key Generation (RFC 8032 Section 5.2.5). (Stub: zero pubkey.)
transform ed448_keygen(privkey: State<Ed448Seed>, pubkey: State<Ed448Seed>) {
    let i: u32 = 0;
    while i < 57 { pubkey.bytes[i] = 0; i = i + 1; }
    // STUB: pending semantic rewrite.
}

// Ed448 Sign (RFC 8032 Section 5.2.6). (Stub: zero signature.)
transform ed448_sign(privkey: State<Ed448Seed>, msg: State<Ed448ShakeIn>, msg_len: u32, sig: State<Ed448Sig>) {
    let i: u32 = 0;
    while i < 114 { sig.bytes[i] = 0; i = i + 1; }
    // STUB: pending semantic rewrite.
}

// Ed448 Verify (RFC 8032 Section 5.2.7). (Stub: returns 0.)
transform ed448_verify(pubkey: State<Ed448Seed>, msg: State<Ed448ShakeIn>, msg_len: u32, sig: State<Ed448Sig>) -> u32 {
    // STUB: returns 0 (invalid) pending semantic rewrite.
