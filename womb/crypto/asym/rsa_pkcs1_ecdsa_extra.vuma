transform ed448_scalar_mul(rx: State<Ed448Fe>, ry: State<Ed448Fe>,
                           k: State<Ed448Fe>, px: State<Ed448Fe>, py: State<Ed448Fe>) {
    ed448_fe_zero(rx);
    ed448_fe_zero(ry);
    // STUB: pending semantic rewrite.
}

// Reduce 912-bit (114-byte) hash mod L for Ed448. (Stub: zero output.)
transform ed448_mod_l(r: State<Ed448Fe>, hash_114: State<Ed448HashOut>) {
    ed448_fe_zero(r);
    // STUB: pending semantic rewrite.
}

// Reduce a 56-byte value mod L. (Stub: zero output.)
transform ed448_mod_l_from_56(r: State<Ed448Fe>, val_56: State<Ed448Fe>) {
