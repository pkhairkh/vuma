// ===========================================================================
//                          ECDSA P-521 (FIPS 186-4)
// ===========================================================================
//
// All P-521 transforms below are stubs pending a semantic rewrite. They
// preserve the original public API but produce no cryptographic output.

transform p521_load_u64(ptr: State<P521Fe>, off: u32) -> u64 {
    let b0: u64 = ptr.bytes[off + 0] as u64;
    let b1: u64 = ptr.bytes[off + 1] as u64;
    let b2: u64 = ptr.bytes[off + 2] as u64;
    let b3: u64 = ptr.bytes[off + 3] as u64;
    let b4: u64 = ptr.bytes[off + 4] as u64;
    let b5: u64 = ptr.bytes[off + 5] as u64;
    let b6: u64 = ptr.bytes[off + 6] as u64;
    let b7: u64 = ptr.bytes[off + 7] as u64;
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56);
}

transform p521_store_u64(ptr: State<P521Fe>, off: u32, val: u64) {
    ptr.bytes[off + 0] = (val & 255) as u8;
    ptr.bytes[off + 1] = ((val >> 8) & 255) as u8;
    ptr.bytes[off + 2] = ((val >> 16) & 255) as u8;
    ptr.bytes[off + 3] = ((val >> 24) & 255) as u8;
    ptr.bytes[off + 4] = ((val >> 32) & 255) as u8;
    ptr.bytes[off + 5] = ((val >> 40) & 255) as u8;
    ptr.bytes[off + 6] = ((val >> 48) & 255) as u8;
    ptr.bytes[off + 7] = ((val >> 56) & 255) as u8;
}

transform p521_fe_zero(r: State<P521Fe>) {
    let i: u32 = 0;
    while i < 66 { r.bytes[i] = 0; i = i + 1; }
}

transform p521_fe_one(r: State<P521Fe>) {
    p521_fe_zero(r);
    r.bytes[0] = 1;
}

transform p521_fe_copy(r: State<P521Fe>, a: State<P521Fe>) {
    let i: u32 = 0;
    while i < 66 { r.bytes[i] = a.bytes[i]; i = i + 1; }
}

transform p521_fe_is_zero(a: State<P521Fe>) -> u32 {
    let i: u32 = 0;
    while i < 8 {
        if p521_load_u64(a, i * 8) != 0 { return 0; }
        i = i + 1;
    }
    if a.bytes[64] != 0 { return 0; }
    if a.bytes[65] != 0 { return 0; }
    return 1;
}

transform p521_fe_cmp(a: State<P521Fe>, b: State<P521Fe>) -> i32 {
    if a.bytes[65] > b.bytes[65] { return 1; }
    if a.bytes[65] < b.bytes[65] { return -1; }
    if a.bytes[64] > b.bytes[64] { return 1; }
    if a.bytes[64] < b.bytes[64] { return -1; }
    let i: u32 = 7;
    while 1 == 1 {
        let av: u64 = p521_load_u64(a, i * 8);
        let bv: u64 = p521_load_u64(b, i * 8);
        if av > bv { return 1; }
        if av < bv { return -1; }
        if i == 0 { break; }
        i = i - 1;
    }
    return 0;
}

// p = 2^521 - 1. (66-byte LE: bytes 0..64 = 0xFF, byte 65 = 0x01.)
transform p521_fe_p(r: State<P521Fe>) {
    let i: u32 = 0;
    while i < 65 { r.bytes[i] = 255; i = i + 1; }
    r.bytes[65] = 1;
}

// r = (a + b) mod p. (Stub: zero output.)
transform p521_fe_add(r: State<P521Fe>, a: State<P521Fe>, b: State<P521Fe>) {
    p521_fe_zero(r);
    // STUB: pending semantic rewrite.
}

// r = (a - b) mod p. (Stub: zero output.)
transform p521_fe_sub(r: State<P521Fe>, a: State<P521Fe>, b: State<P521Fe>) {
    p521_fe_zero(r);
    // STUB: pending semantic rewrite.
}

transform p521_fe_get_bit(a: State<P521Fe>, bit: u32) -> u32 {
    let byte_idx: u32 = bit / 8;
    let bit_idx: u32 = bit % 8;
    if byte_idx >= 66 { return 0; }
    let v: u32 = a.bytes[byte_idx] as u32;
    return (v >> bit_idx) & 1;
}

transform p521_fe_bitlen(a: State<P521Fe>) -> u32 {
    let i: u32 = 65;
    while 1 == 1 {
        let v: u32 = a.bytes[i] as u32;
        if v != 0 {
            let bits: u32 = 8;
            let mut_bits: u32 = bits;
            while mut_bits > 0 {
                let p: u32 = mut_bits - 1;
                if ((v >> p) & 1) == 1 { return i * 8 + mut_bits; }
                mut_bits = mut_bits - 1;
            }
            return i * 8 + 1;
        }
        if i == 0 { break; }
        i = i - 1;
    }
    return 0;
}

// r = (a * b) mod p. (Stub: zero output.)
transform p521_fe_mul(r: State<P521Fe>, a: State<P521Fe>, b: State<P521Fe>) {
    p521_fe_zero(r);
    // STUB: pending semantic rewrite.
}

transform p521_fe_square(r: State<P521Fe>, a: State<P521Fe>) {
    p521_fe_mul(r, a, a);
}

// r = a^exp mod p via square-and-multiply. (Stub: zero output.)
transform p521_fe_mod_exp(r: State<P521Fe>, a: State<P521Fe>, exp: State<P521Fe>) {
    p521_fe_zero(r);
    // STUB: pending semantic rewrite.
}

// r = a^(-1) mod p via Fermat. (Stub: zero output.)
transform p521_fe_invert(r: State<P521Fe>, a: State<P521Fe>) {
    p521_fe_zero(r);
    // STUB: pending semantic rewrite.
}

// Binary extended GCD modular inverse mod n. (Stub: zero output.)
transform p521_mod_inv_n(r: State<P521Fe>, a: State<P521Fe>, n: State<P521Fe>) {
    p521_fe_zero(r);
    // STUB: pending semantic rewrite.
}

// Right-shift a 66-byte value by 1 bit.
transform p521_rshift1(r: State<P521Fe>, a: State<P521Fe>) {
    let i: u32 = 65;
    while i > 0 {
        let im1: u32 = i - 1;
        let cur: u32 = a.bytes[i] as u32;
        let nxt: u32 = a.bytes[im1] as u32;
        r.bytes[i] = ((cur >> 1) | (nxt << 7)) as u8;
        i = im1;
    }
    let v0: u32 = a.bytes[0] as u32;
    r.bytes[0] = (v0 >> 1) as u8;
}

// P-521 curve constant loaders. (Stub: zero output.)
transform p521_n_be(out: State<P521Fe>) {
    p521_fe_zero(out);
    // STUB: pending semantic rewrite.
}

transform p521_p_be(out: State<P521Fe>) {
    p521_fe_zero(out);
    // STUB: pending semantic rewrite.
}

transform p521_b_be(out: State<P521Fe>) {
    p521_fe_zero(out);
