// ===========================================================================
// SHA-384 streaming helper for variable-length messages up to 256 bytes.
// ===========================================================================

transform p384_sha384_hash(msg: State<B256>, msg_len: u32, out: State<B48>) {
    let ctx = state_new(Sha384Ctx);
    sha384_init(ctx);
    let i: u32 = 0;
    while i < msg_len {
        let chunk = state_new(Sha384Data);
        let remaining: u32 = msg_len - i;
        let to_copy: u32 = 128;
        if remaining < 128 { to_copy = remaining; }
        let j: u32 = 0;
        while j < to_copy {
            chunk.data[j] = msg.bytes[i + j];
            j = j + 1;
        }
        sha384_update(ctx, chunk, to_copy);
        i = i + to_copy;
    }
    let digest = state_new(Sha384Digest);
    sha384_final(ctx, digest);
    let k: u32 = 0;
    while k < 48 { out.bytes[k] = digest.data[k]; k = k + 1; }
}

// ===========================================================================
// Point operations (affine, mod p) — all in Bn384Ctx.
// ===========================================================================

transform p384_is_on_curve_bn(px: State<Bn384Ctx>, py: State<Bn384Ctx>, p_bn: State<Bn384Ctx>, b_bn: State<Bn384Ctx>) -> u32 {
    let y_sq = state_new(Bn384Ctx);
    let x_sq = state_new(Bn384Ctx);
    let x_cubed = state_new(Bn384Ctx);
    let three_x = state_new(Bn384Ctx);
    let neg_3x = state_new(Bn384Ctx);
    let rhs = state_new(Bn384Ctx);

    bn384_mod_mul(y_sq, py, py, p_bn);
    bn384_mod_mul(x_sq, px, px, p_bn);
    bn384_mod_mul(x_cubed, x_sq, px, p_bn);
    bn384_mod_add(three_x, px, px, p_bn);
    bn384_mod_add(three_x, three_x, px, p_bn);
    bn384_mod_sub(neg_3x, p_bn, three_x, p_bn);
    bn384_mod_add(rhs, x_cubed, neg_3x, p_bn);
    bn384_mod_add(rhs, rhs, b_bn, p_bn);

    if bn384_cmp(y_sq, rhs) == 0 { return 1; }
    return 0;
}

transform p384_point_double_bn(rx: State<Bn384Ctx>, ry: State<Bn384Ctx>, px: State<Bn384Ctx>, py: State<Bn384Ctx>, p_bn: State<Bn384Ctx>) {
    if bn384_is_zero(px) == 1 {
        if bn384_is_zero(py) == 1 {
            bn384_zero(rx);
            bn384_zero(ry);
            return;
        }
    }
    let a_val = state_new(Bn384Ctx);
    bn384_copy(a_val, p_bn);
    let lo = a_val.limbs[0];
    a_val.limbs[0] = lo - 3;

    let t1 = state_new(Bn384Ctx);
    let t2 = state_new(Bn384Ctx);
    let t3 = state_new(Bn384Ctx);
    let t3_inv = state_new(Bn384Ctx);
    let slope = state_new(Bn384Ctx);
    let slope_sq = state_new(Bn384Ctx);
    let two_x = state_new(Bn384Ctx);
    let x_minus_rx = state_new(Bn384Ctx);
    let slope_x = state_new(Bn384Ctx);

    bn384_mod_mul(t1, px, px, p_bn);
    bn384_mod_add(t2, t1, t1, p_bn);
    bn384_mod_add(t2, t2, t1, p_bn);
    bn384_mod_add(t2, t2, a_val, p_bn);

    bn384_mod_add(t3, py, py, p_bn);
    bn384_mod_inv(t3_inv, t3, p_bn);
    bn384_mod_mul(slope, t2, t3_inv, p_bn);

    bn384_mod_mul(slope_sq, slope, slope, p_bn);
    bn384_mod_add(two_x, px, px, p_bn);
    bn384_mod_sub(rx, slope_sq, two_x, p_bn);

    bn384_mod_sub(x_minus_rx, px, rx, p_bn);
    bn384_mod_mul(slope_x, slope, x_minus_rx, p_bn);
    bn384_mod_sub(ry, slope_x, py, p_bn);
}

transform p384_point_add_bn(rx: State<Bn384Ctx>, ry: State<Bn384Ctx>, px: State<Bn384Ctx>, py: State<Bn384Ctx>, qx: State<Bn384Ctx>, qy: State<Bn384Ctx>, p_bn: State<Bn384Ctx>) {
    if bn384_is_zero(px) == 1 {
        if bn384_is_zero(py) == 1 {
            bn384_copy(rx, qx);
            bn384_copy(ry, qy);
            return;
        }
    }
    if bn384_is_zero(qx) == 1 {
        if bn384_is_zero(qy) == 1 {
            bn384_copy(rx, px);
            bn384_copy(ry, py);
            return;
        }
    }
    if bn384_cmp(px, qx) == 0 {
        if bn384_cmp(py, qy) == 0 {
            p384_point_double_bn(rx, ry, px, py, p_bn);
            return;
        } else {
            bn384_zero(rx);
            bn384_zero(ry);
            return;
        }
    }

    let dy = state_new(Bn384Ctx);
    let dx = state_new(Bn384Ctx);
    let dx_inv = state_new(Bn384Ctx);
    let slope = state_new(Bn384Ctx);
    let slope_sq = state_new(Bn384Ctx);
    let temp = state_new(Bn384Ctx);
    let x_diff = state_new(Bn384Ctx);
    let slope_x = state_new(Bn384Ctx);

    bn384_mod_sub(dy, qy, py, p_bn);
    bn384_mod_sub(dx, qx, px, p_bn);
    bn384_mod_inv_fermat(dx_inv, dx, p_bn);
    bn384_mod_mul(slope, dy, dx_inv, p_bn);

    bn384_mod_mul(slope_sq, slope, slope, p_bn);
    bn384_mod_sub(temp, slope_sq, px, p_bn);
    bn384_mod_sub(rx, temp, qx, p_bn);

    bn384_mod_sub(x_diff, px, rx, p_bn);
    bn384_mod_mul(slope_x, slope, x_diff, p_bn);
    bn384_mod_sub(ry, slope_x, py, p_bn);
}

transform p384_scalar_mul_bn(rx: State<Bn384Ctx>, ry: State<Bn384Ctx>, k: State<Bn384Ctx>, px: State<Bn384Ctx>, py: State<Bn384Ctx>, p_bn: State<Bn384Ctx>) {
    bn384_zero(rx);
    bn384_zero(ry);
    let tx = state_new(Bn384Ctx);
    let ty = state_new(Bn384Ctx);
    let bits: u32 = bn384_bitlen(k);
    if bits == 0 { return; }
    let i: u32 = bits;
    while i > 0 {
        let ii = i - 1;
        p384_point_double_bn(tx, ty, rx, ry, p_bn);
        bn384_copy(rx, tx);
        bn384_copy(ry, ty);
        if bn384_get_bit(k, ii) == 1 {
            p384_point_add_bn(tx, ty, rx, ry, px, py, p_bn);
            bn384_copy(rx, tx);
            bn384_copy(ry, ty);
        }
        i = ii;
    }
}

// ===========================================================================
// RFC 6979 deterministic nonce for P-384 using HMAC-SHA-512 (hlen = 64).
// ===========================================================================

transform rfc6979_p384_k(x_be: State<B48>, h_be: State<B48>, n_le: State<B48>, k_le: State<B48>) {
    let hlen: u32 = 64;
    let qlen: u32 = 48;

    let V = state_new(HmacMsg);
    let K = state_new(HmacKey);
    let i: u32 = 0;
    while i < hlen { V.bytes[i] = 1; K.bytes[i] = 0; i = i + 1; }

    // bits2octets(h): h is 48 bytes already; reduce mod n
    let h_le = state_new(B48);
    swap_endian_48(h_le, h_be);
    let h_bn = state_new(Bn384Ctx);
    let n_bn = state_new(Bn384Ctx);
    b48_to_bn384(h_bn, h_le);
    b48_to_bn384(n_bn, n_le);
    if bn384_cmp(h_bn, n_bn) >= 0 { bn384_sub(h_bn, h_bn, n_bn); }
    let h_be_canon = state_new(B48);
    bn384_to_be48(h_be_canon, h_bn);

    let x_be_canon = state_new(B48);
    let j: u32 = 0;
    while j < 48 { x_be_canon.bytes[j] = x_be.bytes[j]; j = j + 1; }

    let buf1_len: u32 = hlen + 1 + 96;
    let buf1 = state_new(HmacMsg);
    let p1: u32 = 0;
    while p1 < hlen { buf1.bytes[p1] = V.bytes[p1]; p1 = p1 + 1; }
    buf1.bytes[hlen] = 0;
    let p2: u32 = 0;
    while p2 < 48 { buf1.bytes[hlen + 1 + p2] = x_be_canon.bytes[p2]; p2 = p2 + 1; }
    let p3: u32 = 0;
    while p3 < 48 { buf1.bytes[hlen + 1 + 48 + p3] = h_be_canon.bytes[p3]; p3 = p3 + 1; }

    let tmp_out = state_new(HmacOut);
    hmac_sha512(K, hlen, buf1, buf1_len, tmp_out);   // V <- HMAC_K(buf1)
    let c1: u32 = 0;
    while c1 < hlen { V.bytes[c1] = tmp_out.bytes[c1]; c1 = c1 + 1; }
    hmac_sha512(K, hlen, buf1, buf1_len, tmp_out);   // K <- HMAC_K(buf1)
    let c2: u32 = 0;
    while c2 < hlen { K.bytes[c2] = tmp_out.bytes[c2]; c2 = c2 + 1; }
    hmac_sha512(K, hlen, V, hlen, tmp_out);          // V <- HMAC_K(V)
    let c3: u32 = 0;
    while c3 < hlen { V.bytes[c3] = tmp_out.bytes[c3]; c3 = c3 + 1; }

    // buf2 = V || 0x01 || x || h
    let buf2 = state_new(HmacMsg);
    let q1: u32 = 0;
    while q1 < hlen { buf2.bytes[q1] = V.bytes[q1]; q1 = q1 + 1; }
    buf2.bytes[hlen] = 1;
    let q2: u32 = 0;
    while q2 < 48 { buf2.bytes[hlen + 1 + q2] = x_be_canon.bytes[q2]; q2 = q2 + 1; }
    let q3: u32 = 0;
    while q3 < 48 { buf2.bytes[hlen + 1 + 48 + q3] = h_be_canon.bytes[q3]; q3 = q3 + 1; }

    hmac_sha512(K, hlen, buf2, buf1_len, tmp_out);   // K <- HMAC_K(buf2)
    let d1: u32 = 0;
    while d1 < hlen { K.bytes[d1] = tmp_out.bytes[d1]; d1 = d1 + 1; }
    hmac_sha512(K, hlen, V, hlen, tmp_out);          // V <- HMAC_K(V)
    let d2: u32 = 0;
    while d2 < hlen { V.bytes[d2] = tmp_out.bytes[d2]; d2 = d2 + 1; }

    // Generate T = first qlen bytes of V (one block is enough; hlen=64 >= qlen=48)
    let T = state_new(B48);
    let e1: u32 = 0;
    while e1 < qlen { T.bytes[e1] = V.bytes[e1]; e1 = e1 + 1; }
    swap_endian_48(k_le, T);

    let accepted: u32 = 0;
    let attempts: u32 = 0;
    while accepted == 0 {
        if attempts >= 32 { accepted = 1; }
        if accepted == 0 {
            let k_bn = state_new(Bn384Ctx);
            b48_to_bn384(k_bn, k_le);
            if bn384_cmp(k_bn, n_bn) >= 0 { bn384_sub(k_bn, k_bn, n_bn); }
            bn384_to_b48(k_le, k_bn);
            if bn384_is_zero(k_bn) == 0 {
                accepted = 1;
            } else {
                let buf3 = state_new(HmacMsg);
                let f1: u32 = 0;
                while f1 < hlen { buf3.bytes[f1] = V.bytes[f1]; f1 = f1 + 1; }
                buf3.bytes[hlen] = 0;
                hmac_sha512(K, hlen, buf3, hlen + 1, tmp_out);
                let g1: u32 = 0;
                while g1 < hlen { K.bytes[g1] = tmp_out.bytes[g1]; g1 = g1 + 1; }
                hmac_sha512(K, hlen, V, hlen, tmp_out);
                let g2: u32 = 0;
                while g2 < hlen { V.bytes[g2] = tmp_out.bytes[g2]; g2 = g2 + 1; }
                // Regenerate T from V
                let e2: u32 = 0;
                while e2 < qlen { T.bytes[e2] = V.bytes[e2]; e2 = e2 + 1; }
                swap_endian_48(k_le, T);
            }
        }
        attempts = attempts + 1;
    }
}

// ===========================================================================
// ECDSA P-384 Key Generation: Q = d * G
// ===========================================================================

transform ecdsa_p384_keygen(privkey_be: State<B48>, pubkey_x_be: State<B48>, pubkey_y_be: State<B48>) {
    let n_be = state_new(B48);
    p384_n_be(n_be);
    let n_bn = state_new(Bn384Ctx);
    be48_to_bn384(n_bn, n_be);

    let d_bn = state_new(Bn384Ctx);
    be48_to_bn384(d_bn, privkey_be);
    if bn384_cmp(d_bn, n_bn) >= 0 { bn384_sub(d_bn, d_bn, n_bn); }
    if bn384_is_zero(d_bn) == 1 { bn384_set_u32(d_bn, 1); }

    let gx_be = state_new(B48);
    let gy_be = state_new(B48);
    p384_gx_be(gx_be);
    p384_gy_be(gy_be);
    let gx_bn = state_new(Bn384Ctx);
    let gy_bn = state_new(Bn384Ctx);
    be48_to_bn384(gx_bn, gx_be);
    be48_to_bn384(gy_bn, gy_be);

    let p_be = state_new(B48);
    p384_p_be(p_be);
    let p_bn = state_new(Bn384Ctx);
    be48_to_bn384(p_bn, p_be);

    let qx_bn = state_new(Bn384Ctx);
    let qy_bn = state_new(Bn384Ctx);
    p384_scalar_mul_bn(qx_bn, qy_bn, d_bn, gx_bn, gy_bn, p_bn);

    bn384_to_be48(pubkey_x_be, qx_bn);
    bn384_to_be48(pubkey_y_be, qy_bn);
    bn384_to_be48(privkey_be, d_bn);
}

// ===========================================================================
// ECDSA P-384 Sign (uses SHA-384 to match curve strength)
// ===========================================================================

transform ecdsa_p384_sign(msg: State<B256>, msg_len: u32, privkey_be: State<B48>, r_out: State<B48>, s_out: State<B48>) {
    let h_be = state_new(B48);
    p384_sha384_hash(msg, msg_len, h_be);

    let h_bn = state_new(Bn384Ctx);
    let d_bn = state_new(Bn384Ctx);
    be48_to_bn384(h_bn, h_be);
    be48_to_bn384(d_bn, privkey_be);

    let p_be = state_new(B48);
    let n_be = state_new(B48);
    let gx_be = state_new(B48);
    let gy_be = state_new(B48);
    p384_p_be(p_be);
    p384_n_be(n_be);
    p384_gx_be(gx_be);
    p384_gy_be(gy_be);
    let p_bn = state_new(Bn384Ctx);
    let n_bn = state_new(Bn384Ctx);
    let gx_bn = state_new(Bn384Ctx);
    let gy_bn = state_new(Bn384Ctx);
    be48_to_bn384(p_bn, p_be);
    be48_to_bn384(n_bn, n_be);
    be48_to_bn384(gx_bn, gx_be);
    be48_to_bn384(gy_bn, gy_be);

    if bn384_cmp(d_bn, n_bn) >= 0 { bn384_sub(d_bn, d_bn, n_bn); }
    if bn384_cmp(h_bn, n_bn) >= 0 { bn384_sub(h_bn, h_bn, n_bn); }

    let n_le = state_new(B48);
    swap_endian_48(n_le, n_be);
    let k_le = state_new(B48);
    rfc6979_p384_k(privkey_be, h_be, n_le, k_le);
    let k_bn = state_new(Bn384Ctx);
    b48_to_bn384(k_bn, k_le);

    let rx = state_new(Bn384Ctx);
    let ry = state_new(Bn384Ctx);
    p384_scalar_mul_bn(rx, ry, k_bn, gx_bn, gy_bn, p_bn);

    let r_bn = state_new(Bn384Ctx);
    bn384_copy(r_bn, rx);
    if bn384_cmp(r_bn, n_bn) >= 0 { bn384_sub(r_bn, r_bn, n_bn); }

    let k_inv = state_new(Bn384Ctx);
    let rd = state_new(Bn384Ctx);
    let h_rd = state_new(Bn384Ctx);
    let s_bn = state_new(Bn384Ctx);
    bn384_mod_inv_fermat(k_inv, k_bn, n_bn);
    bn384_mod_mul(rd, r_bn, d_bn, n_bn);
    bn384_mod_add(h_rd, h_bn, rd, n_bn);
    bn384_mod_mul(s_bn, k_inv, h_rd, n_bn);

    bn384_to_be48(r_out, r_bn);
    bn384_to_be48(s_out, s_bn);
}

// ===========================================================================
// ECDSA P-384 Verify
// ===========================================================================

transform ecdsa_p384_verify(msg: State<B256>, msg_len: u32, pubkey_x_be: State<B48>, pubkey_y_be: State<B48>, r_be: State<B48>, s_be: State<B48>) -> u32 {
    let n_be = state_new(B48);
    p384_n_be(n_be);
    let n_bn = state_new(Bn384Ctx);
    be48_to_bn384(n_bn, n_be);

    let r_bn = state_new(Bn384Ctx);
    let s_bn = state_new(Bn384Ctx);
    be48_to_bn384(r_bn, r_be);
    be48_to_bn384(s_bn, s_be);

    if bn384_is_zero(r_bn) == 1 { return 0; }
    if bn384_is_zero(s_bn) == 1 { return 0; }
    if bn384_cmp(r_bn, n_bn) >= 0 { return 0; }
    if bn384_cmp(s_bn, n_bn) >= 0 { return 0; }

    let h_be = state_new(B48);
    p384_sha384_hash(msg, msg_len, h_be);
    let h_bn = state_new(Bn384Ctx);
    be48_to_bn384(h_bn, h_be);
    if bn384_cmp(h_bn, n_bn) >= 0 { bn384_sub(h_bn, h_bn, n_bn); }

    let p_be = state_new(B48);
    let b_be = state_new(B48);
    let gx_be = state_new(B48);
    let gy_be = state_new(B48);
    p384_p_be(p_be);
    p384_b_be(b_be);
    p384_gx_be(gx_be);
    p384_gy_be(gy_be);
    let p_bn = state_new(Bn384Ctx);
    let b_bn = state_new(Bn384Ctx);
    let gx_bn = state_new(Bn384Ctx);
    let gy_bn = state_new(Bn384Ctx);
    be48_to_bn384(p_bn, p_be);
    be48_to_bn384(b_bn, b_be);
    be48_to_bn384(gx_bn, gx_be);
    be48_to_bn384(gy_bn, gy_be);

    let qx_bn = state_new(Bn384Ctx);
    let qy_bn = state_new(Bn384Ctx);
    be48_to_bn384(qx_bn, pubkey_x_be);
    be48_to_bn384(qy_bn, pubkey_y_be);

    if p384_is_on_curve_bn(qx_bn, qy_bn, p_bn, b_bn) == 0 { return 0; }

    let w = state_new(Bn384Ctx);
    let u1 = state_new(Bn384Ctx);
    let u2 = state_new(Bn384Ctx);
    bn384_mod_inv_fermat(w, s_bn, n_bn);
    bn384_mod_mul(u1, h_bn, w, n_bn);
    bn384_mod_mul(u2, r_bn, w, n_bn);

    let r1x = state_new(Bn384Ctx);
    let r1y = state_new(Bn384Ctx);
    p384_scalar_mul_bn(r1x, r1y, u1, gx_bn, gy_bn, p_bn);
    let r2x = state_new(Bn384Ctx);
    let r2y = state_new(Bn384Ctx);
    p384_scalar_mul_bn(r2x, r2y, u2, qx_bn, qy_bn, p_bn);
    let ptx = state_new(Bn384Ctx);
    let pty = state_new(Bn384Ctx);
    p384_point_add_bn(ptx, pty, r1x, r1y, r2x, r2y, p_bn);

    if bn384_is_zero(ptx) == 0 || bn384_is_zero(pty) == 0 {
        let v = state_new(Bn384Ctx);
        bn384_copy(v, ptx);
        if bn384_cmp(v, n_bn) >= 0 { bn384_sub(v, v, n_bn); }
        if bn384_cmp(v, r_bn) == 0 { return 1; }
    }
    return 0;
}

// Expose helpers for sibling modules (ecdh_p384 / key_agreement).
transform p384_scalar_mul_wrap(rx: State<B48>, ry: State<B48>, k: State<B48>, px: State<B48>, py: State<B48>, p: State<B48>) {
    let p_bn = state_new(Bn384Ctx);
    let k_bn = state_new(Bn384Ctx);
    let px_bn = state_new(Bn384Ctx);
    let py_bn = state_new(Bn384Ctx);
    be48_to_bn384(p_bn, p);
    be48_to_bn384(k_bn, k);
    be48_to_bn384(px_bn, px);
    be48_to_bn384(py_bn, py);
    let rx_bn = state_new(Bn384Ctx);
    let ry_bn = state_new(Bn384Ctx);
    p384_scalar_mul_bn(rx_bn, ry_bn, k_bn, px_bn, py_bn, p_bn);
    bn384_to_be48(rx, rx_bn);
    bn384_to_be48(ry, ry_bn);
}

transform swap_endian_48_wrap(dst: State<B48>, src: State<B48>) {
    swap_endian_48(dst, src);
}
