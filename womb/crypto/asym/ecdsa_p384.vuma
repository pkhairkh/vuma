// womb/crypto/asym/ecdsa_p384.vuma — ECDSA over NIST P-384 (FIPS 186-4)
// No main() — importable library module.
// Requires: sha384.vuma (sha384_*), hmac.vuma (hmac_sha512).
//
// P-384: p = 2^384 - 2^128 - 2^96 + 2^32 - 1, a = -3 mod p
// All scalars and point coordinates are 48-byte (384-bit) big-endian on the
// wire. Internally we operate on 48-byte little-endian via Bn384Ctx (6 × u64).
//
// VUMA 2.0 PMT-native: state_new(Layout) / State<T> / typed arrays.

import "/home/z/my-project/workdir/vuma/womb/crypto/hash/sha384.vuma"::{Sha384Ctx, Sha384Data, Sha384Digest, sha384_init, sha384_update, sha384_final};
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hmac.vuma"::{HmacKey, HmacMsg, HmacOut, HmacBuf, hmac_sha512, hmac_sha512_hash};

const P384_LIMBS: u32 = 6;
const P384_BYTES: u32 = 48;

// ===========================================================================
// Layouts
// ===========================================================================

// 384-bit bignum context — 6 × u64 limbs (little-endian).
layout Bn384Ctx = { limbs: [u64; 6] }

// 768-bit (12-limb) — 384×384 multiplication result.
layout Bn768Ctx = { limbs: [u64; 12] }

layout B48  = { bytes: [u8; 48] }     // 48-byte BE/LE field element / scalar
layout B256 = { bytes: [u8; 256] }    // message buffer

// ===========================================================================
// 384-bit bignum primitives (6 × u64 limbs, little-endian)
// ===========================================================================

transform bn384_zero(a: State<Bn384Ctx>) {
    let i: u32 = 0;
    while i < P384_LIMBS { a.limbs[i] = 0; i = i + 1; }
}

transform bn384_copy(r: State<Bn384Ctx>, a: State<Bn384Ctx>) {
    let i: u32 = 0;
    while i < P384_LIMBS { r.limbs[i] = a.limbs[i]; i = i + 1; }
}

transform bn384_set_u32(r: State<Bn384Ctx>, v: u32) {
    bn384_zero(r);
    r.limbs[0] = v as u64;
}

transform bn384_is_zero(a: State<Bn384Ctx>) -> u32 {
    let i: u32 = 0;
    while i < P384_LIMBS {
        if a.limbs[i] != 0 { return 0; }
        i = i + 1;
    }
    return 1;
}

transform bn384_cmp(a: State<Bn384Ctx>, b: State<Bn384Ctx>) -> i32 {
    let i: u32 = P384_LIMBS - 1;
    while 1 == 1 {
        let av = a.limbs[i];
        let bv = b.limbs[i];
        if av > bv { return 1; }
        if av < bv { return -1; }
        if i == 0 { break; }
        i = i - 1;
    }
    return 0;
}

// r = a + b. Returns carry-out (0 or 1).
transform bn384_add(r: State<Bn384Ctx>, a: State<Bn384Ctx>, b: State<Bn384Ctx>) -> u32 {
    let carry: u64 = 0;
    let i: u32 = 0;
    while i < P384_LIMBS {
        let av = a.limbs[i];
        let bv = b.limbs[i];
        let sum: u64 = av + bv + carry;
        r.limbs[i] = sum;
        if sum < av { carry = 1; }
        else {
            if sum == av {
                if carry == 1 { carry = 1; } else { carry = 0; }
            } else { carry = 0; }
        }
        i = i + 1;
    }
    return carry as u32;
}

// r = a - b. Returns borrow-out (0 or 1).
transform bn384_sub(r: State<Bn384Ctx>, a: State<Bn384Ctx>, b: State<Bn384Ctx>) -> u32 {
    let borrow: u64 = 0;
    let i: u32 = 0;
    while i < P384_LIMBS {
        let av = a.limbs[i];
        let bv = b.limbs[i];
        let diff: u64 = av - bv - borrow;
        r.limbs[i] = diff;
        if av < bv { borrow = 1; }
        else {
            if av == bv {
                if borrow == 1 { borrow = 1; } else { borrow = 0; }
            } else { borrow = 0; }
        }
        i = i + 1;
    }
    return borrow as u32;
}

transform bn384_lshift1(r: State<Bn384Ctx>, a: State<Bn384Ctx>) {
    let carry: u64 = 0;
    let i: u32 = 0;
    while i < P384_LIMBS {
        let v = a.limbs[i];
        r.limbs[i] = (v << 1) | carry;
        carry = v >> 63;
        i = i + 1;
    }
}

transform bn384_rshift1(r: State<Bn384Ctx>, a: State<Bn384Ctx>) {
    let i: u32 = P384_LIMBS - 1;
    while i > 0 {
        let hi = a.limbs[i];
        let im1 = i - 1;
        let lo = a.limbs[im1];
        r.limbs[i] = (hi >> 1) | (lo << 63);
        i = i - 1;
    }
    let v0 = a.limbs[0];
    r.limbs[0] = v0 >> 1;
}

transform bn384_get_bit(a: State<Bn384Ctx>, bit: u32) -> u32 {
    let limb: u32 = bit / 64;
    let pos: u32 = bit % 64;
    if limb >= P384_LIMBS { return 0; }
    let v = a.limbs[limb];
    return ((v >> pos) & 1) as u32;
}

transform bn384_bitlen(a: State<Bn384Ctx>) -> u32 {
    let i: u32 = P384_LIMBS - 1;
    while 1 == 1 {
        let v = a.limbs[i];
        if v != 0 {
            let bits: u32 = 64;
            while bits > 0 {
                let b = bits - 1;
                if ((v >> b) & 1) == 1 { return i * 64 + bits; }
                bits = bits - 1;
            }
            return i * 64 + 1;
        }
        if i == 0 { break; }
        i = i - 1;
    }
    return 0;
}

transform bn384_mod_add(r: State<Bn384Ctx>, a: State<Bn384Ctx>, b: State<Bn384Ctx>, m: State<Bn384Ctx>) {
    let carry: u32 = bn384_add(r, a, b);
    if carry == 1 { bn384_sub(r, r, m); }
    else {
        if bn384_cmp(r, m) >= 0 { bn384_sub(r, r, m); }
    }
}

transform bn384_mod_sub(r: State<Bn384Ctx>, a: State<Bn384Ctx>, b: State<Bn384Ctx>, m: State<Bn384Ctx>) {
    let borrow: u32 = bn384_sub(r, a, b);
    if borrow == 1 { bn384_add(r, r, m); }
}

// r = (a * b) mod m. Slow schoolbook: double-and-add via mod_add.
transform bn384_mod_mul(r: State<Bn384Ctx>, a: State<Bn384Ctx>, b: State<Bn384Ctx>, m: State<Bn384Ctx>) {
    bn384_zero(r);
    let temp = state_new(Bn384Ctx);
    bn384_copy(temp, a);
    let bits: u32 = bn384_bitlen(b);
    let i: u32 = 0;
    while i < bits {
        if bn384_get_bit(b, i) == 1 {
            bn384_mod_add(r, r, temp, m);
        }
        bn384_mod_add(temp, temp, temp, m);
        i = i + 1;
    }
}

transform bn384_mod_exp(r: State<Bn384Ctx>, a: State<Bn384Ctx>, exp: State<Bn384Ctx>, m: State<Bn384Ctx>) {
    bn384_zero(r);
    r.limbs[0] = 1;
    let base = state_new(Bn384Ctx);
    bn384_copy(base, a);
    let bits: u32 = bn384_bitlen(exp);
    let i: u32 = 0;
    while i < bits {
        if bn384_get_bit(exp, i) == 1 {
            let tmp = state_new(Bn384Ctx);
            bn384_mod_mul(tmp, r, base, m);
            bn384_copy(r, tmp);
        }
        let tmp2 = state_new(Bn384Ctx);
        bn384_mod_mul(tmp2, base, base, m);
        bn384_copy(base, tmp2);
        i = i + 1;
    }
}

// r = a^(-1) mod m via binary extended GCD.
transform bn384_mod_inv(r: State<Bn384Ctx>, a: State<Bn384Ctx>, m: State<Bn384Ctx>) {
    let u = state_new(Bn384Ctx);
    let v = state_new(Bn384Ctx);
    let x1 = state_new(Bn384Ctx);
    let x2 = state_new(Bn384Ctx);
    bn384_copy(u, a);
    bn384_copy(v, m);
    bn384_set_u32(x1, 1);
    bn384_zero(x2);

    while bn384_is_zero(u) == 0 {
        while bn384_get_bit(u, 0) == 0 {
            bn384_rshift1(u, u);
            if bn384_get_bit(x1, 0) == 0 {
                bn384_rshift1(x1, x1);
            } else {
                bn384_add(x1, x1, m);
                bn384_rshift1(x1, x1);
            }
        }
        while bn384_get_bit(v, 0) == 0 {
            bn384_rshift1(v, v);
            if bn384_get_bit(x2, 0) == 0 {
                bn384_rshift1(x2, x2);
            } else {
                bn384_add(x2, x2, m);
                bn384_rshift1(x2, x2);
            }
        }
        if bn384_cmp(u, v) >= 0 {
            bn384_sub(u, u, v);
            let borrow: u32 = bn384_sub(x1, x1, x2);
            if borrow == 1 { bn384_add(x1, x1, m); }
        } else {
            bn384_sub(v, v, u);
            let borrow2: u32 = bn384_sub(x2, x2, x1);
            if borrow2 == 1 { bn384_add(x2, x2, m); }
        }
    }
    bn384_copy(r, x2);
}

// r = a^(-1) mod m via Fermat's little theorem: a^(m-2) mod m.
// Only works for prime m. Uses bn384_mod_exp (correct, ~100x faster than binary GCD).
transform bn384_mod_inv_fermat(r: State<Bn384Ctx>, a: State<Bn384Ctx>, m: State<Bn384Ctx>) {
    let exp = state_new(Bn384Ctx);
    bn384_copy(exp, m);
    // exp = m - 2
    let lo = exp.limbs[0];
    if lo >= 2 {
        exp.limbs[0] = lo - 2;
    } else {
        exp.limbs[0] = lo - 2;  // wraps via u64 underflow
        let i = 1;
        let need_borrow = 1;
        while need_borrow == 1 {
            if i >= 6 { break; }
            let cur = exp.limbs[i];
            if cur == 0 {
                exp.limbs[i] = ~1;  // 2^64 - 2 (bitwise NOT of 1)
            } else {
                exp.limbs[i] = cur - 1;
                need_borrow = 0;
            }
            i = i + 1;
        }
    }
    bn384_mod_exp(r, a, exp, m);
}


// ===========================================================================
// B48 ↔ Bn384Ctx conversion (LE bytes <-> 6 × u64 limbs)
// ===========================================================================

transform b48_to_bn384(dst: State<Bn384Ctx>, src: State<B48>) {
    let li: u32 = 0;
    while li < P384_LIMBS {
        let off = li * 8;
        let b0 = src.bytes[off] as u64;
        let b1 = src.bytes[off + 1] as u64;
        let b2 = src.bytes[off + 2] as u64;
        let b3 = src.bytes[off + 3] as u64;
        let b4 = src.bytes[off + 4] as u64;
        let b5 = src.bytes[off + 5] as u64;
        let b6 = src.bytes[off + 6] as u64;
        let b7 = src.bytes[off + 7] as u64;
        dst.limbs[li] = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
                       | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56);
        li = li + 1;
    }
}

transform bn384_to_b48(dst: State<B48>, src: State<Bn384Ctx>) {
    let li: u32 = 0;
    while li < P384_LIMBS {
        let off = li * 8;
        let v: u64 = src.limbs[li];
        dst.bytes[off]     = (v & 255) as u8;
        dst.bytes[off + 1] = ((v >> 8) & 255) as u8;
        dst.bytes[off + 2] = ((v >> 16) & 255) as u8;
        dst.bytes[off + 3] = ((v >> 24) & 255) as u8;
        dst.bytes[off + 4] = ((v >> 32) & 255) as u8;
        dst.bytes[off + 5] = ((v >> 40) & 255) as u8;
        dst.bytes[off + 6] = ((v >> 48) & 255) as u8;
        dst.bytes[off + 7] = ((v >> 56) & 255) as u8;
        li = li + 1;
    }
}

transform swap_endian_48(dst: State<B48>, src: State<B48>) {
    let tmp = state_new(B48);
    let i: u32 = 0;
    while i < P384_BYTES { tmp.bytes[i] = src.bytes[47 - i]; i = i + 1; }
    let j: u32 = 0;
    while j < P384_BYTES { dst.bytes[j] = tmp.bytes[j]; j = j + 1; }
}

transform be48_to_bn384(dst: State<Bn384Ctx>, src: State<B48>) {
    let le = state_new(B48);
    swap_endian_48(le, src);
    b48_to_bn384(dst, le);
}

transform bn384_to_be48(dst: State<B48>, src: State<Bn384Ctx>) {
    let le = state_new(B48);
    bn384_to_b48(le, src);
    swap_endian_48(dst, le);
}

// ===========================================================================
// P-384 curve constants (big-endian, 48 bytes each)
// ===========================================================================

transform p384_p_be(out: State<B48>) {
