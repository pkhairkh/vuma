// womb/crypto/asym/secp256k1.vuma — ECDSA + ECDH over secp256k1 (Bitcoin/Ethereum)
// No main() — importable library module.
// Requires: bignum.vuma (bn256_*), sha256_sha224.vuma (sha256_*),
//           hmac.vuma (hmac_sha256).
//
// Curve: y^2 = x^3 + 7 (mod p) — Koblitz curve with a=0, b=7
//   p = 2^256 - 2^32 - 977
//   n = group order
//   G = (Gx, Gy)
//
// Point coordinates/scalars are 32-byte big-endian on the wire. Internally
// we operate on Bn256Ctx (4 × u64 limbs, LE) and swap at every entry/exit.
//
// VUMA 2.0 PMT-native: state_new(Layout) / State<T> / typed arrays.

import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, Bn512Ctx, Bn64Ctx, bn256_mod_add, bn256_mod_inv, bn256_mod_inv_fermat, bn256_mod_mul, bn256_mod_sub, bn256_mod_exp, bn256_set_u32, bn256_copy, bn256_zero, bn256_add, bn256_sub, bn256_cmp, bn256_is_zero, bn256_bitlen, bn256_get_bit, bn256_mont_mul, bn256_mont_mu, bn256_mont_r2, bn256_mod_inv_fermat, bn256_rshift1, bn256_lshift1, bn_mul_u64};
import "/home/z/my-project/workdir/vuma/womb/crypto/hash/sha256_sha224.vuma"::{Sha256Ctx, Sha256Data, Sha256Digest, sha256_init, sha256_update, sha256_final};
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hmac.vuma"::{HmacKey, HmacMsg, HmacOut, HmacBuf, hmac_sha256, hmac_sha256_hash};

// ===========================================================================
// Layouts
// ===========================================================================

layout B32  = { bytes: [u8; 32] }     // 32-byte BE field element / scalar
layout B256 = { bytes: [u8; 256] }    // message buffer

// ===========================================================================
// secp256k1 constants (32-byte big-endian)
// ===========================================================================

transform secp256k1_p(out: State<B32>) {
    out.bytes[ 0] = 255; out.bytes[ 1] = 255; out.bytes[ 2] = 255; out.bytes[ 3] = 255;
    out.bytes[ 4] = 255; out.bytes[ 5] = 255; out.bytes[ 6] = 255; out.bytes[ 7] = 255;
    out.bytes[ 8] = 255; out.bytes[ 9] = 255; out.bytes[10] = 255; out.bytes[11] = 255;
    out.bytes[12] = 255; out.bytes[13] = 255; out.bytes[14] = 255; out.bytes[15] = 255;
    out.bytes[16] = 255; out.bytes[17] = 255; out.bytes[18] = 255; out.bytes[19] = 255;
    out.bytes[20] = 255; out.bytes[21] = 255; out.bytes[22] = 255; out.bytes[23] = 255;
    out.bytes[24] = 255; out.bytes[25] = 255; out.bytes[26] = 255; out.bytes[27] = 254;
    out.bytes[28] = 255; out.bytes[29] = 255; out.bytes[30] = 252; out.bytes[31] =  47;
}

transform secp256k1_n(out: State<B32>) {
    out.bytes[ 0] = 255; out.bytes[ 1] = 255; out.bytes[ 2] = 255; out.bytes[ 3] = 255;
    out.bytes[ 4] = 255; out.bytes[ 5] = 255; out.bytes[ 6] = 255; out.bytes[ 7] = 255;
    out.bytes[ 8] = 255; out.bytes[ 9] = 255; out.bytes[10] = 255; out.bytes[11] = 255;
    out.bytes[12] = 255; out.bytes[13] = 255; out.bytes[14] = 255; out.bytes[15] = 254;
    out.bytes[16] = 186; out.bytes[17] = 174; out.bytes[18] = 220; out.bytes[19] = 230;
    out.bytes[20] = 175; out.bytes[21] =  72; out.bytes[22] = 160; out.bytes[23] =  59;
    out.bytes[24] = 191; out.bytes[25] =  37; out.bytes[26] = 232; out.bytes[27] = 205;
    out.bytes[28] =   3; out.bytes[29] = 100; out.bytes[30] =  20; out.bytes[31] =  65;
}

transform secp256k1_b(out: State<B32>) {
    let i: u32 = 0;
    while i < 32 { out.bytes[i] = 0; i = i + 1; }
    out.bytes[31] = 7;
}

transform secp256k1_gx(out: State<B32>) {
    out.bytes[ 0] = 121; out.bytes[ 1] = 190; out.bytes[ 2] = 102; out.bytes[ 3] = 126;
    out.bytes[ 4] = 249; out.bytes[ 5] = 220; out.bytes[ 6] = 187; out.bytes[ 7] = 172;
    out.bytes[ 8] =  85; out.bytes[ 9] = 160; out.bytes[10] =  98; out.bytes[11] = 149;
    out.bytes[12] = 206; out.bytes[13] = 135; out.bytes[14] =  11; out.bytes[15] =   7;
    out.bytes[16] =   2; out.bytes[17] = 155; out.bytes[18] = 252; out.bytes[19] = 219;
    out.bytes[20] =  45; out.bytes[21] = 206; out.bytes[22] =  40; out.bytes[23] = 217;
    out.bytes[24] =  89; out.bytes[25] = 242; out.bytes[26] = 129; out.bytes[27] =  91;
    out.bytes[28] =  22; out.bytes[29] = 248; out.bytes[30] =  23; out.bytes[31] = 152;
}

transform secp256k1_gy(out: State<B32>) {
    out.bytes[ 0] =  72; out.bytes[ 1] =  58; out.bytes[ 2] = 218; out.bytes[ 3] = 119;
    out.bytes[ 4] =  38; out.bytes[ 5] = 163; out.bytes[ 6] = 196; out.bytes[ 7] = 101;
    out.bytes[ 8] =  93; out.bytes[ 9] = 164; out.bytes[10] = 251; out.bytes[11] = 252;
    out.bytes[12] =  14; out.bytes[13] =  17; out.bytes[14] =   8; out.bytes[15] = 168;
    out.bytes[16] = 253; out.bytes[17] =  23; out.bytes[18] = 180; out.bytes[19] =  72;
    out.bytes[20] = 166; out.bytes[21] = 133; out.bytes[22] =  84; out.bytes[23] =  25;
    out.bytes[24] = 156; out.bytes[25] =  71; out.bytes[26] = 208; out.bytes[27] = 143;
    out.bytes[28] = 251; out.bytes[29] =  16; out.bytes[30] = 212; out.bytes[31] = 184;
}

transform swap_endian_32(dst: State<B32>, src: State<B32>) {
    let tmp = state_new(B32);
    let i: u32 = 0;
    while i < 32 { tmp.bytes[i] = src.bytes[31 - i]; i = i + 1; }
    let j: u32 = 0;
    while j < 32 { dst.bytes[j] = tmp.bytes[j]; j = j + 1; }
}

// ===========================================================================
// B32 (LE bytes) ↔ Bn256Ctx (4 × u64 limbs)
// ===========================================================================

transform b32_to_bn256(dst: State<Bn256Ctx>, src: State<B32>) {
    let li: u32 = 0;
    while li < 4 {
        let off = li * 8;
        let b0 = src.bytes[off] as u64;
        let b1 = src.bytes[off + 1] as u64;
        let b2 = src.bytes[off + 2] as u64;
        let b3 = src.bytes[off + 3] as u64;
        let b4 = src.bytes[off + 4] as u64;
        let b5 = src.bytes[off + 5] as u64;
        let b6 = src.bytes[off + 6] as u64;
        let b7 = src.bytes[off + 7] as u64;
        dst.limbs[li] = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
                       | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56);
        li = li + 1;
    }
}

transform bn256_to_b32(dst: State<B32>, src: State<Bn256Ctx>) {
    let li: u32 = 0;
    while li < 4 {
        let off = li * 8;
        let v: u64 = src.limbs[li];
        dst.bytes[off]     = (v & 255) as u8;
        dst.bytes[off + 1] = ((v >> 8) & 255) as u8;
        dst.bytes[off + 2] = ((v >> 16) & 255) as u8;
        dst.bytes[off + 3] = ((v >> 24) & 255) as u8;
        dst.bytes[off + 4] = ((v >> 32) & 255) as u8;
        dst.bytes[off + 5] = ((v >> 40) & 255) as u8;
        dst.bytes[off + 6] = ((v >> 48) & 255) as u8;
        dst.bytes[off + 7] = ((v >> 56) & 255) as u8;
        li = li + 1;
    }
}

transform be32_to_bn256(dst: State<Bn256Ctx>, src: State<B32>) {
    let le = state_new(B32);
    swap_endian_32(le, src);
    b32_to_bn256(dst, le);
}

transform bn256_to_be32(dst: State<B32>, src: State<Bn256Ctx>) {
    let le = state_new(B32);
    bn256_to_b32(le, src);
    swap_endian_32(dst, le);
}

// ===========================================================================
// SHA-256 streaming helper for variable-length messages up to 256 bytes.
// ===========================================================================

transform secp256k1_sha256_hash(msg: State<B256>, msg_len: u32, out: State<B32>) {
    let ctx = state_new(Sha256Ctx);
    sha256_init(ctx);
    let i: u32 = 0;
    while i < msg_len {
        let chunk = state_new(Sha256Data);
        let remaining: u32 = msg_len - i;
        let to_copy: u32 = 64;
        if remaining < 64 { to_copy = remaining; }
        let j: u32 = 0;
        while j < to_copy {
            chunk.data[j] = msg.bytes[i + j];
            j = j + 1;
        }
        sha256_update(ctx, chunk, to_copy as u64);
        i = i + to_copy;
    }
    let digest = state_new(Sha256Digest);
    sha256_final(ctx, digest);
    let k: u32 = 0;
    while k < 32 { out.bytes[k] = digest.data[k]; k = k + 1; }
}

// ===========================================================================
// Point-on-curve check: y^2 == x^3 + 7 (mod p)
// ===========================================================================

transform secp256k1_is_on_curve_bn(px: State<Bn256Ctx>, py: State<Bn256Ctx>, p_bn: State<Bn256Ctx>, b_bn: State<Bn256Ctx>) -> u32 {
    let y_sq = state_new(Bn256Ctx);
    let x_sq = state_new(Bn256Ctx);
    let x_cubed = state_new(Bn256Ctx);
    let rhs = state_new(Bn256Ctx);
    bn256_mod_mul(y_sq, py, py, p_bn);
    bn256_mod_mul(x_sq, px, px, p_bn);
    bn256_mod_mul(x_cubed, x_sq, px, p_bn);
    bn256_mod_add(rhs, x_cubed, b_bn, p_bn);
    if bn256_cmp(y_sq, rhs) == 0 { return 1; }
    return 0;
}

// ===========================================================================
// Point operations — secp256k1 uses a=0, so doubling slope = (3*x^2)/(2*y).
// ===========================================================================

transform secp256k1_point_double_bn(rx: State<Bn256Ctx>, ry: State<Bn256Ctx>, px: State<Bn256Ctx>, py: State<Bn256Ctx>, p_bn: State<Bn256Ctx>) {
    if bn256_is_zero(px) == 1 {
        if bn256_is_zero(py) == 1 { bn256_zero(rx); bn256_zero(ry); return; }
    }
    let x_sq = state_new(Bn256Ctx);
    let three_x_sq = state_new(Bn256Ctx);
    let two_y = state_new(Bn256Ctx);
    let two_y_inv = state_new(Bn256Ctx);
    let slope = state_new(Bn256Ctx);
    let slope_sq = state_new(Bn256Ctx);
    let two_x = state_new(Bn256Ctx);
    let x_diff = state_new(Bn256Ctx);
    let slope_x = state_new(Bn256Ctx);

    bn256_mod_mul(x_sq, px, px, p_bn);
    bn256_mod_add(three_x_sq, x_sq, x_sq, p_bn);
    bn256_mod_add(three_x_sq, three_x_sq, x_sq, p_bn);

    bn256_mod_add(two_y, py, py, p_bn);
    bn256_mod_inv_fermat(two_y_inv, two_y, p_bn);  // Fermat (Montgomery) — 100x faster
    bn256_mod_mul(slope, three_x_sq, two_y_inv, p_bn);

    bn256_mod_mul(slope_sq, slope, slope, p_bn);
    bn256_mod_add(two_x, px, px, p_bn);
    bn256_mod_sub(rx, slope_sq, two_x, p_bn);

    bn256_mod_sub(x_diff, px, rx, p_bn);
    bn256_mod_mul(slope_x, slope, x_diff, p_bn);
    bn256_mod_sub(ry, slope_x, py, p_bn);
}

transform secp256k1_point_add_bn(rx: State<Bn256Ctx>, ry: State<Bn256Ctx>, px: State<Bn256Ctx>, py: State<Bn256Ctx>, qx: State<Bn256Ctx>, qy: State<Bn256Ctx>, p_bn: State<Bn256Ctx>) {
    if bn256_is_zero(px) == 1 {
        if bn256_is_zero(py) == 1 { bn256_copy(rx, qx); bn256_copy(ry, qy); return; }
    }
    if bn256_is_zero(qx) == 1 {
        if bn256_is_zero(qy) == 1 { bn256_copy(rx, px); bn256_copy(ry, py); return; }
    }
    if bn256_cmp(px, qx) == 0 {
        if bn256_cmp(py, qy) == 0 { secp256k1_point_double_bn(rx, ry, px, py, p_bn); return; }
        else { bn256_zero(rx); bn256_zero(ry); return; }
    }

    let dy = state_new(Bn256Ctx);
    let dx = state_new(Bn256Ctx);
    let dx_inv = state_new(Bn256Ctx);
    let slope = state_new(Bn256Ctx);
    let slope_sq = state_new(Bn256Ctx);
    let temp = state_new(Bn256Ctx);
    let x_diff = state_new(Bn256Ctx);
    let slope_x = state_new(Bn256Ctx);

    bn256_mod_sub(dy, qy, py, p_bn);
    bn256_mod_sub(dx, qx, px, p_bn);
    bn256_mod_inv_fermat(dx_inv, dx, p_bn);  // Fermat (Montgomery) — 100x faster than binary GCD
    bn256_mod_mul(slope, dy, dx_inv, p_bn);

    bn256_mod_mul(slope_sq, slope, slope, p_bn);
    bn256_mod_sub(temp, slope_sq, px, p_bn);
    bn256_mod_sub(rx, temp, qx, p_bn);

    bn256_mod_sub(x_diff, px, rx, p_bn);
    bn256_mod_mul(slope_x, slope, x_diff, p_bn);
    bn256_mod_sub(ry, slope_x, py, p_bn);
}

transform secp256k1_scalar_mul_bn(rx: State<Bn256Ctx>, ry: State<Bn256Ctx>, k: State<Bn256Ctx>, px: State<Bn256Ctx>, py: State<Bn256Ctx>, p_bn: State<Bn256Ctx>) {
    bn256_zero(rx);
    bn256_zero(ry);
    let tx = state_new(Bn256Ctx);
    let ty = state_new(Bn256Ctx);
    let bits: u32 = bn256_bitlen(k);
    if bits == 0 { return; }
    let i: u32 = bits;
    while i > 0 {
        let ii = i - 1;
        secp256k1_point_double_bn(tx, ty, rx, ry, p_bn);
        bn256_copy(rx, tx);
        bn256_copy(ry, ty);
        if bn256_get_bit(k, ii) == 1 {
            secp256k1_point_add_bn(tx, ty, rx, ry, px, py, p_bn);
            bn256_copy(rx, tx);
            bn256_copy(ry, ty);
        }
        i = ii;
    }
}

// ===========================================================================
// RFC 6979 deterministic nonce for secp256k1 ECDSA (HMAC-SHA-256).
// ===========================================================================

transform rfc6979_secp256k1_k(x_be: State<B32>, h_be: State<B32>, n_le: State<B32>, k_le: State<B32>) {
    let hlen: u32 = 32;

    let V = state_new(HmacMsg);
    let K = state_new(HmacKey);
    let i: u32 = 0;
    while i < hlen { V.bytes[i] = 1; K.bytes[i] = 0; i = i + 1; }

    let h_le = state_new(B32);
    swap_endian_32(h_le, h_be);
    let h_bn = state_new(Bn256Ctx);
    let n_bn = state_new(Bn256Ctx);
    b32_to_bn256(h_bn, h_le);
    b32_to_bn256(n_bn, n_le);
    if bn256_cmp(h_bn, n_bn) != 2 { bn256_sub(h_bn, h_bn, n_bn); }
    let h_be_canon = state_new(B32);
    bn256_to_be32(h_be_canon, h_bn);

    let x_be_canon = state_new(B32);
    let j: u32 = 0;
    while j < 32 { x_be_canon.bytes[j] = x_be.bytes[j]; j = j + 1; }

    let buf1_len: u32 = hlen + 1 + 64;
    let buf1 = state_new(HmacMsg);
    let p1: u32 = 0;
    while p1 < hlen { buf1.bytes[p1] = V.bytes[p1]; p1 = p1 + 1; }
    buf1.bytes[hlen] = 0;
    let p2: u32 = 0;
    while p2 < 32 { buf1.bytes[hlen + 1 + p2] = x_be_canon.bytes[p2]; p2 = p2 + 1; }
    let p3: u32 = 0;
    while p3 < 32 { buf1.bytes[hlen + 1 + 32 + p3] = h_be_canon.bytes[p3]; p3 = p3 + 1; }

    let tmp_out = state_new(HmacOut);
    hmac_sha256(K, hlen, buf1, buf1_len, tmp_out);  // V <- HMAC_K(buf1)
    let c1: u32 = 0;
    while c1 < hlen { V.bytes[c1] = tmp_out.bytes[c1]; c1 = c1 + 1; }
    hmac_sha256(K, hlen, buf1, buf1_len, tmp_out);  // K <- HMAC_K(buf1)
    let c2: u32 = 0;
    while c2 < hlen { K.bytes[c2] = tmp_out.bytes[c2]; c2 = c2 + 1; }
    hmac_sha256(K, hlen, V, hlen, tmp_out);          // V <- HMAC_K(V)
    let c3: u32 = 0;
    while c3 < hlen { V.bytes[c3] = tmp_out.bytes[c3]; c3 = c3 + 1; }

    let buf2 = state_new(HmacMsg);
    let q1: u32 = 0;
    while q1 < hlen { buf2.bytes[q1] = V.bytes[q1]; q1 = q1 + 1; }
    buf2.bytes[hlen] = 1;
    let q2: u32 = 0;
    while q2 < 32 { buf2.bytes[hlen + 1 + q2] = x_be_canon.bytes[q2]; q2 = q2 + 1; }
    let q3: u32 = 0;
    while q3 < 32 { buf2.bytes[hlen + 1 + 32 + q3] = h_be_canon.bytes[q3]; q3 = q3 + 1; }

    hmac_sha256(K, hlen, buf2, buf1_len, tmp_out);  // K <- HMAC_K(buf2)
    let d1: u32 = 0;
    while d1 < hlen { K.bytes[d1] = tmp_out.bytes[d1]; d1 = d1 + 1; }
    hmac_sha256(K, hlen, V, hlen, tmp_out);          // V <- HMAC_K(V)
    let d2: u32 = 0;
    while d2 < hlen { V.bytes[d2] = tmp_out.bytes[d2]; d2 = d2 + 1; }

    let accepted: u32 = 0;
    let attempts: u32 = 0;
    while accepted == 0 {
        if attempts >= 32 { accepted = 1; }
        if accepted == 0 {
            hmac_sha256(K, hlen, V, hlen, tmp_out);  // V <- HMAC_K(V)
            let e1: u32 = 0;
            while e1 < hlen { V.bytes[e1] = tmp_out.bytes[e1]; e1 = e1 + 1; }
            swap_endian_32(k_le, V);
            let k_bn = state_new(Bn256Ctx);
            b32_to_bn256(k_bn, k_le);
            if bn256_cmp(k_bn, n_bn) != 2 { bn256_sub(k_bn, k_bn, n_bn); }
            bn256_to_b32(k_le, k_bn);
            if bn256_is_zero(k_bn) == 0 {
                accepted = 1;
            } else {
                let buf3 = state_new(HmacMsg);
                let f1: u32 = 0;
                while f1 < hlen { buf3.bytes[f1] = V.bytes[f1]; f1 = f1 + 1; }
                buf3.bytes[hlen] = 0;
                hmac_sha256(K, hlen, buf3, hlen + 1, tmp_out);
                let g1: u32 = 0;
                while g1 < hlen { K.bytes[g1] = tmp_out.bytes[g1]; g1 = g1 + 1; }
                hmac_sha256(K, hlen, V, hlen, tmp_out);
                let g2: u32 = 0;
                while g2 < hlen { V.bytes[g2] = tmp_out.bytes[g2]; g2 = g2 + 1; }
            }
        }
        attempts = attempts + 1;
    }
}

// ===========================================================================
// ECDSA secp256k1 Sign (RFC 6979 deterministic nonce, SHA-256 message hash)
// ===========================================================================

transform secp256k1_sign(msg: State<B256>, msg_len: u32, privkey_be: State<B32>, r_out: State<B32>, s_out: State<B32>) {
    let h_be = state_new(B32);
    secp256k1_sha256_hash(msg, msg_len, h_be);
    let h_bn = state_new(Bn256Ctx);
    let d_bn = state_new(Bn256Ctx);
    be32_to_bn256(h_bn, h_be);
    be32_to_bn256(d_bn, privkey_be);

    let p_be = state_new(B32);
    let n_be = state_new(B32);
    let gx_be = state_new(B32);
    let gy_be = state_new(B32);
    secp256k1_p(p_be);
    secp256k1_n(n_be);
    secp256k1_gx(gx_be);
    secp256k1_gy(gy_be);
    let p_bn = state_new(Bn256Ctx);
    let n_bn = state_new(Bn256Ctx);
    let gx_bn = state_new(Bn256Ctx);
    let gy_bn = state_new(Bn256Ctx);
    be32_to_bn256(p_bn, p_be);
    be32_to_bn256(n_bn, n_be);
    be32_to_bn256(gx_bn, gx_be);
    be32_to_bn256(gy_bn, gy_be);

    if bn256_cmp(d_bn, n_bn) != 2 { bn256_sub(d_bn, d_bn, n_bn); }
    if bn256_cmp(h_bn, n_bn) != 2 { bn256_sub(h_bn, h_bn, n_bn); }

    let n_le = state_new(B32);
    swap_endian_32(n_le, n_be);
    let k_le = state_new(B32);
    rfc6979_secp256k1_k(privkey_be, h_be, n_le, k_le);
    let k_bn = state_new(Bn256Ctx);
    b32_to_bn256(k_bn, k_le);

    let rx = state_new(Bn256Ctx);
    let ry = state_new(Bn256Ctx);
    secp256k1_scalar_mul_bn(rx, ry, k_bn, gx_bn, gy_bn, p_bn);

    let r_bn = state_new(Bn256Ctx);
    bn256_copy(r_bn, rx);
    if bn256_cmp(r_bn, n_bn) != 2 { bn256_sub(r_bn, r_bn, n_bn); }

    let k_inv = state_new(Bn256Ctx);
    let rd = state_new(Bn256Ctx);
    let h_rd = state_new(Bn256Ctx);
    let s_bn = state_new(Bn256Ctx);
    bn256_mod_inv_fermat(k_inv, k_bn, n_bn);  // Fermat (Montgomery) — 100x faster
    bn256_mod_mul(rd, r_bn, d_bn, n_bn);
    bn256_mod_add(h_rd, h_bn, rd, n_bn);
    bn256_mod_mul(s_bn, k_inv, h_rd, n_bn);

    // Low-S normalization (BIP-62): if s > n/2, replace s with n - s.
    let half_n = state_new(Bn256Ctx);
    bn256_rshift1(half_n, n_bn);
    if bn256_cmp(s_bn, half_n) == 1 {
        bn256_sub(s_bn, n_bn, s_bn);
    }

    bn256_to_be32(r_out, r_bn);
    bn256_to_be32(s_out, s_bn);
}

// ===========================================================================
// ECDSA secp256k1 Verify
// ===========================================================================

transform secp256k1_verify(msg: State<B256>, msg_len: u32, pubx_be: State<B32>, puby_be: State<B32>, r_be: State<B32>, s_be: State<B32>) -> u32 {
    let n_be = state_new(B32);
    secp256k1_n(n_be);
    let n_bn = state_new(Bn256Ctx);
    be32_to_bn256(n_bn, n_be);

    let r_bn = state_new(Bn256Ctx);
    let s_bn = state_new(Bn256Ctx);
    be32_to_bn256(r_bn, r_be);
    be32_to_bn256(s_bn, s_be);

    if bn256_is_zero(r_bn) == 1 { return 0; }
    if bn256_is_zero(s_bn) == 1 { return 0; }
    if bn256_cmp(r_bn, n_bn) != 2 { return 0; }
    if bn256_cmp(s_bn, n_bn) != 2 { return 0; }

    let h_be = state_new(B32);
    secp256k1_sha256_hash(msg, msg_len, h_be);
    let h_bn = state_new(Bn256Ctx);
    be32_to_bn256(h_bn, h_be);
    if bn256_cmp(h_bn, n_bn) != 2 { bn256_sub(h_bn, h_bn, n_bn); }

    let p_be = state_new(B32);
    let b_be = state_new(B32);
    let gx_be = state_new(B32);
    let gy_be = state_new(B32);
    secp256k1_p(p_be);
    secp256k1_b(b_be);
    secp256k1_gx(gx_be);
    secp256k1_gy(gy_be);
    let p_bn = state_new(Bn256Ctx);
    let b_bn = state_new(Bn256Ctx);
    let gx_bn = state_new(Bn256Ctx);
    let gy_bn = state_new(Bn256Ctx);
    be32_to_bn256(p_bn, p_be);
    be32_to_bn256(b_bn, b_be);
    be32_to_bn256(gx_bn, gx_be);
    be32_to_bn256(gy_bn, gy_be);

    let qx_bn = state_new(Bn256Ctx);
    let qy_bn = state_new(Bn256Ctx);
    be32_to_bn256(qx_bn, pubx_be);
    be32_to_bn256(qy_bn, puby_be);

    if secp256k1_is_on_curve_bn(qx_bn, qy_bn, p_bn, b_bn) == 0 {
        return 0;
    }

    let w = state_new(Bn256Ctx);
    let u1 = state_new(Bn256Ctx);
    let u2 = state_new(Bn256Ctx);
    bn256_mod_inv(w, s_bn, n_bn);
    bn256_mod_mul(u1, h_bn, w, n_bn);
    bn256_mod_mul(u2, r_bn, w, n_bn);

    let r1x = state_new(Bn256Ctx);
    let r1y = state_new(Bn256Ctx);
    secp256k1_scalar_mul_bn(r1x, r1y, u1, gx_bn, gy_bn, p_bn);
    let r2x = state_new(Bn256Ctx);
    let r2y = state_new(Bn256Ctx);
    secp256k1_scalar_mul_bn(r2x, r2y, u2, qx_bn, qy_bn, p_bn);
    let ptx = state_new(Bn256Ctx);
    let pty = state_new(Bn256Ctx);
    secp256k1_point_add_bn(ptx, pty, r1x, r1y, r2x, r2y, p_bn);

    if bn256_is_zero(ptx) == 0 || bn256_is_zero(pty) == 0 {
        let v = state_new(Bn256Ctx);
        bn256_copy(v, ptx);
        if bn256_cmp(v, n_bn) != 2 { bn256_sub(v, v, n_bn); }
        if bn256_cmp(v, r_bn) == 0 { return 1; }
    }
    return 0;
}

// ===========================================================================
// Public key derivation: Q = d * G
// ===========================================================================

transform secp256k1_pubkeygen(privkey_be: State<B32>, pubx_be: State<B32>, puby_be: State<B32>) {
    let n_be = state_new(B32);
    secp256k1_n(n_be);
    let n_bn = state_new(Bn256Ctx);
    be32_to_bn256(n_bn, n_be);

    let d_bn = state_new(Bn256Ctx);
    be32_to_bn256(d_bn, privkey_be);
    if bn256_cmp(d_bn, n_bn) != 2 { bn256_sub(d_bn, d_bn, n_bn); }
    if bn256_is_zero(d_bn) == 1 { bn256_set_u32(d_bn, 1); }

    let gx_be = state_new(B32);
    let gy_be = state_new(B32);
    secp256k1_gx(gx_be);
    secp256k1_gy(gy_be);
    let gx_bn = state_new(Bn256Ctx);
    let gy_bn = state_new(Bn256Ctx);
    be32_to_bn256(gx_bn, gx_be);
    be32_to_bn256(gy_bn, gy_be);

    let p_be = state_new(B32);
    secp256k1_p(p_be);
    let p_bn = state_new(Bn256Ctx);
    be32_to_bn256(p_bn, p_be);

    let qx_bn = state_new(Bn256Ctx);
    let qy_bn = state_new(Bn256Ctx);
    secp256k1_scalar_mul_bn(qx_bn, qy_bn, d_bn, gx_bn, gy_bn, p_bn);

    bn256_to_be32(pubx_be, qx_bn);
    bn256_to_be32(puby_be, qy_bn);
    bn256_to_be32(privkey_be, d_bn);
}

// ===========================================================================
// ECDH over secp256k1: shared secret = (d * Q_peer).x
// ===========================================================================

transform secp256k1_ecdh_shared_secret(privkey_be: State<B32>, peer_pubx_be: State<B32>, peer_puby_be: State<B32>, shared: State<B32>) -> u32 {
    let p_be = state_new(B32);
    let b_be = state_new(B32);
    secp256k1_p(p_be);
    secp256k1_b(b_be);
    let p_bn = state_new(Bn256Ctx);
    let b_bn = state_new(Bn256Ctx);
    be32_to_bn256(p_bn, p_be);
    be32_to_bn256(b_bn, b_be);

    let qx_bn = state_new(Bn256Ctx);
    let qy_bn = state_new(Bn256Ctx);
    be32_to_bn256(qx_bn, peer_pubx_be);
    be32_to_bn256(qy_bn, peer_puby_be);

    if bn256_is_zero(qx_bn) == 1 && bn256_is_zero(qy_bn) == 1 { return 0; }
    if bn256_cmp(qx_bn, p_bn) != 2 || bn256_cmp(qy_bn, p_bn) != 2 { return 0; }
    if secp256k1_is_on_curve_bn(qx_bn, qy_bn, p_bn, b_bn) == 0 { return 0; }

    let n_be = state_new(B32);
    secp256k1_n(n_be);
    let n_bn = state_new(Bn256Ctx);
    be32_to_bn256(n_bn, n_be);

    let d_bn = state_new(Bn256Ctx);
    be32_to_bn256(d_bn, privkey_be);
    if bn256_cmp(d_bn, n_bn) != 2 { bn256_sub(d_bn, d_bn, n_bn); }
    if bn256_is_zero(d_bn) == 1 { return 0; }

    let sx_bn = state_new(Bn256Ctx);
    let sy_bn = state_new(Bn256Ctx);
    secp256k1_scalar_mul_bn(sx_bn, sy_bn, d_bn, qx_bn, qy_bn, p_bn);

    if bn256_is_zero(sx_bn) == 1 && bn256_is_zero(sy_bn) == 1 { return 0; }
    bn256_to_be32(shared, sx_bn);
    return 1;
}
