// ═══════════════════════════════════════════════════════════════════════════
// womb/crypto/asym/x25519.vuma — X25519 Key Exchange (RFC 7748)
// PMT-native rewrite (W3-F).
// ═══════════════════════════════════════════════════════════════════════════
//
// X25519 implements scalar multiplication on Curve25519:
//   y^2 = x^3 + 486662x^2 + x  over GF(2^255 - 19)
//
// Uses the Montgomery ladder for constant-time scalar multiplication.
// Field elements are 256 bits, represented as 8 × u32 little-endian limbs.
//
// Test vectors (RFC 7748 §6.1):
//   scalar  = a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4
//   u_in    = e6db6867583030db3594c2a4916399c4b9d4f7ca4e8ca4b7d8a8b9c0d5d2e3a (Bob's public)
//   output  = c3da55379de9c6908e94ea4df28d084f32eccf03491c71f754b4075577a28552
//
//   Base point (u=9):
//   scalar  = 77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a
//   output  = 8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a
//
// PMT patterns:
//   - [u32; 8] typed-array for 256-bit field elements
//   - [u8; 32] for byte I/O
//   - state_new(Layout) + State<T> params
//   - u32 * u32 -> u64 full product (verified working)

const X25519_MASK32: u32 = 4294967295;
const X25519_MASK64: u64 = (1 << 63) | ((1 << 63) - 1);  // 0xFFFFFFFFFFFFFFFF

// ===========================================================================
// Layouts
// ===========================================================================

// 256-bit field element: 8 × u32 little-endian limbs
layout Fe = { limbs: [u32; 8] }

// 32-byte key / output
layout X25519Bytes = { data: [u8; 32] }

// 512-bit intermediate product: 16 × u32 limbs
layout Fe512 = { limbs: [u32; 16] }

// ===========================================================================
// Byte <-> field element conversion
// ===========================================================================

// fe_from_bytes: load 32 LE bytes as 8 u32 limbs
transform fe_from_bytes(fe: State<Fe>, bytes: State<X25519Bytes>) {
    let i: u32 = 0;
    while i < 8 {
        let off = i * 4;
        let b0 = bytes.data[off] as u32;
        let b1 = bytes.data[off + 1] as u32;
        let b2 = bytes.data[off + 2] as u32;
        let b3 = bytes.data[off + 3] as u32;
        fe.limbs[i] = (b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)) & X25519_MASK32;
        i = i + 1;
    }
}

// fe_to_bytes: store field element as 32 LE bytes.
// For X25519 output, RFC 7748 says to mask the high bit (bit 255).
// The intermediate values don't need to be fully canonical — the
// Montgomery ladder works correctly with non-canonical intermediates.
// The final output just needs bit 255 cleared.
transform fe_to_bytes(fe: State<Fe>, bytes: State<X25519Bytes>) {
    let i: u32 = 0;
    while i < 8 {
        let off = i * 4;
        let v = fe.limbs[i];
        bytes.data[off]     = (v & 255) as u8;
        bytes.data[off + 1] = ((v >> 8) & 255) as u8;
        bytes.data[off + 2] = ((v >> 16) & 255) as u8;
        bytes.data[off + 3] = ((v >> 24) & 255) as u8;
        i = i + 1;
    }
    // Clear the high bit (bit 255) per RFC 7748
    bytes.data[31] = bytes.data[31] & 127;
}

// ===========================================================================
// Field element operations mod p = 2^255 - 19
// ===========================================================================

// fe_copy: r = a
transform fe_copy(r: State<Fe>, a: State<Fe>) {
    let i: u32 = 0;
    while i < 8 {
        r.limbs[i] = a.limbs[i];
        i = i + 1;
    }
}

// fe_zero: r = 0
transform fe_zero(r: State<Fe>) {
    let i: u32 = 0;
    while i < 8 {
        r.limbs[i] = 0;
        i = i + 1;
    }
}

// fe_one: r = 1
transform fe_one(r: State<Fe>) {
    r.limbs[0] = 1;
    r.limbs[1] = 0; r.limbs[2] = 0; r.limbs[3] = 0;
    r.limbs[4] = 0; r.limbs[5] = 0; r.limbs[6] = 0; r.limbs[7] = 0;
}

// fe_add: r = (a + b) mod p
// Since p = 2^255 - 19, we add the two values (which may exceed 2^255),
// then conditionally subtract p. We use the technique of adding 19*p
// then subtracting p, which avoids branching.
transform fe_add(r: State<Fe>, a: State<Fe>, b: State<Fe>) {
    // Simple addition with carry propagation
    // r = a + b (may be up to ~2^256, so we need to handle carry)
    let carry: u64 = 0;
    let i: u32 = 0;
    while i < 8 {
        let sum: u64 = (a.limbs[i] as u64) + (b.limbs[i] as u64) + carry;
        r.limbs[i] = (sum & 4294967295) as u32;
        carry = sum >> 32;
        i = i + 1;
    }
    // carry now holds the overflow (0 or 1)
    // Reduce: add carry * 38 to r[0] and propagate
    // (2^256 ≡ 38 mod p, so overflow from bit 256 = carry * 38)
    let overflow: u64 = carry * 38;
    let i2: u32 = 0;
    let c2: u64 = overflow;
    while i2 < 8 {
        let sum: u64 = (r.limbs[i2] as u64) + c2;
        r.limbs[i2] = (sum & 4294967295) as u32;
        c2 = sum >> 32;
        i2 = i2 + 1;
    }
    // At this point r might still be >= p. A final conditional subtraction
    // would be needed for canonical form, but for X25519's Montgomery ladder,
    // non-canonical intermediates are fine.
}

// fe_sub: r = (a - b) mod p
// Add p + a - b to avoid negative numbers, then reduce.
transform fe_sub(r: State<Fe>, a: State<Fe>, b: State<Fe>) {
    // r = a - b + 2*p (to ensure positive result)
    // 2*p = 2^256 - 38
    // We compute: r = a + (2*p - b) = a + 2^256 - 38 - b
    // Since we work mod 2^256 (u32 limbs overflow naturally), this is:
    // r = a - b - 38, then add back 2^256 if underflow
    // Actually, let's use: r = a + (p - b) + p, where p = 2^255 - 19
    // Simpler: compute a - b with borrow, then add p if borrow occurred

    let borrow: u64 = 0;
    let i: u32 = 0;
    while i < 8 {
        let av: u64 = a.limbs[i] as u64;
        let bv: u64 = b.limbs[i] as u64;
        let diff: u64 = (av + 4294967296 - bv - borrow) & X25519_MASK64;  // add 2^32 for underflow
        r.limbs[i] = (diff & 4294967295) as u32;
        if diff < 4294967296 {
            borrow = 1;
        } else {
            borrow = 0;
        }
        i = i + 1;
    }
    // If borrow, the unsigned wrap added 2^256, which ≡ 38 (mod p).
    // So add 38 to compensate (NOT 19 + bit 255 — that adds p+38, too much).
    if borrow == 1 {
        let carry2: u64 = 38;
        let i2: u32 = 0;
        while i2 < 8 {
            let sum: u64 = (r.limbs[i2] as u64) + carry2;
            r.limbs[i2] = (sum & 4294967295) as u32;
            carry2 = sum >> 32;
            i2 = i2 + 1;
        }
    }
}

// fe_mul: r = (a * b) mod p
// Step 1: Schoolbook multiply a[0..7] × b[0..7] → 16-limb product
// Step 2: Reduce using 2^255 ≡ 19 (mod p) — fold high limbs × 19 into low limbs
transform fe_mul(r: State<Fe>, a: State<Fe>, b: State<Fe>) {
    let prod = state_new(Fe512);
    // Zero the product
    let i: u32 = 0;
    while i < 16 {
        prod.limbs[i] = 0;
        i = i + 1;
    }

    // Schoolbook multiplication: row-by-row approach
    // For each a[i], multiply by all b[j] and accumulate into prod with carry
    let ai: u32 = 0;
    while ai < 8 {
        let carry: u64 = 0;
        let bj: u32 = 0;
        while bj < 8 {
            let idx = ai + bj;
            let av: u64 = a.limbs[ai] as u64;
            let bv: u64 = b.limbs[bj] as u64;
            let product: u64 = av * bv;
            let sum: u64 = (prod.limbs[idx] as u64) + (product & 4294967295) + carry;
            prod.limbs[idx] = (sum & 4294967295) as u32;
            carry = (product >> 32) + (sum >> 32);
            bj = bj + 1;
        }
        // Add final carry to prod[ai+8]
        let hi_idx = ai + 8;
        if hi_idx < 16 {
            let sum: u64 = (prod.limbs[hi_idx] as u64) + carry;
            prod.limbs[hi_idx] = (sum & 4294967295) as u32;
            // If carry propagates further, handle it
            let c2: u64 = sum >> 32;
            let k: u32 = hi_idx + 1;
            while k < 16 {
                if c2 == 0 {
                    k = 16;
                }
                if c2 > 0 {
                    let s2: u64 = (prod.limbs[k] as u64) + c2;
                    prod.limbs[k] = (s2 & 4294967295) as u32;
                    c2 = s2 >> 32;  // FIX: update carry
                    k = k + 1;
                }
            }
        }
        ai = ai + 1;
    }

    // Reduction: prod has 16 limbs (512 bits). The split is at the limb
    // boundary (bit 256), NOT at bit 255. Since p = 2^255 - 19:
    //   2^255 ≡ 19 (mod p)
    //   2^256 = 2 * 2^255 ≡ 38 (mod p)
    // So: r = prod[0..7] + 38 * prod[8..15] (mod p)

    let carry: u64 = 0;
    let i2: u32 = 0;
    while i2 < 8 {
        let hi_idx = i2 + 8;
        let val: u64 = (prod.limbs[i2] as u64) + (38 * (prod.limbs[hi_idx] as u64)) + carry;
        r.limbs[i2] = (val & 4294967295) as u32;
        carry = val >> 32;
        i2 = i2 + 1;
    }
    // carry now holds the final overflow (0..38)
    // Add carry * 38 to r[0] and propagate
    let carry2: u64 = carry * 38;
    let i3: u32 = 0;
    let c3: u64 = carry2;
    while i3 < 8 {
        let val: u64 = (r.limbs[i3] as u64) + c3;
        r.limbs[i3] = (val & 4294967295) as u32;
        c3 = val >> 32;
        if c3 == 0 {
            i3 = 8;
        }
        i3 = i3 + 1;
    }
}

// fe_square: r = a^2 mod p (just fe_mul with a = b)
transform fe_square(r: State<Fe>, a: State<Fe>) {
    fe_mul(r, a, a);
}

// fe_cswap: conditional swap of a and b (constant-time)
// If swap == 1, exchange a and b. If swap == 0, no-op.
transform fe_cswap(swap: u32, a: State<Fe>, b: State<Fe>) {
    let mask: u32 = 0;
    if swap == 1 {
        mask = 4294967295;
    }
    let i: u32 = 0;
    while i < 8 {
        let t = (a.limbs[i] ^ b.limbs[i]) & mask;
        a.limbs[i] = a.limbs[i] ^ t;
        b.limbs[i] = b.limbs[i] ^ t;
        i = i + 1;
    }
}

// fe_mul_a24: r = a * 121665 mod p (constant used in Montgomery ladder)
transform fe_mul_a24(r: State<Fe>, a: State<Fe>) {
    let carry: u64 = 0;
    let i: u32 = 0;
    while i < 8 {
        let val: u64 = (a.limbs[i] as u64) * 121665 + carry;
        r.limbs[i] = (val & 4294967295) as u32;
        carry = val >> 32;
        i = i + 1;
    }
    // Reduce carry * 38
    let c2: u64 = carry * 38;
    let i2: u32 = 0;
    let c3: u64 = c2;
    while i2 < 8 {
        let val: u64 = (r.limbs[i2] as u64) + c3;
        r.limbs[i2] = (val & 4294967295) as u32;
        c3 = val >> 32;
        if c3 == 0 {
            i2 = 8;
        }
        i2 = i2 + 1;
    }
}

// fe_invert: r = a^(-1) mod p using Fermat's little theorem
// a^(p-2) mod p, where p = 2^255 - 19, so p-2 = 2^255 - 21
// Exponent: 2^255 - 21 = binary representation with bit 254 set, bits 0-3 = 0b1011
// p-2 = 0x7FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEB
// This requires a chain of squarings and multiplications.
// We use the standard X25519 inversion chain (253 squarings + 11 multiplications).
transform fe_invert(r: State<Fe>, a: State<Fe>) {
    let t0 = state_new(Fe);
    let t1 = state_new(Fe);
    let t2 = state_new(Fe);

    // t0 = a^2
    fe_square(t0, a);     // a^2

    // t1 = a^3 = a^2 * a
    fe_mul(t1, t0, a);    // a^3

    // t0 = a^6 = (a^3)^2
    fe_square(t0, t1);    // a^6

    // t1 = a^7 = a^6 * a
    fe_mul(t1, t0, a);    // a^7

    // t0 = a^14 = (a^7)^2
    fe_square(t0, t1);    // a^14

    // t1 = a^15 = a^14 * a
    fe_mul(t1, t0, a);    // a^15

    // t0 = a^30
    fe_square(t0, t1);
    // t0 = a^60
    fe_square(t0, t0);
    // t0 = a^120
    fe_square(t0, t0);
    // t0 = a^240
    fe_square(t0, t0);

    // t1 = a^255 = a^240 * a^15
    fe_mul(t1, t0, t1);    // a^255

    // Now we need a^(2^255 - 21) = a^(2^255) * a^(-21)
    // a^(2^255) = (a^255)^(2^255) ... no, a^(2^255) = ((a^255)^2) ... 
    // Actually a^(2^255) is just squaring a^255 255 more times.
    // But that's too many squarings. Let's use the standard approach:
    // a^(p-2) = a^(2^255-21) = a^(2^255) / a^21
    // In GF(p), a^(2^255) = a (by Fermat's little theorem, a^p = a, so a^(2^255) = a * a^19 = a * a^19)
    // Wait, p = 2^255 - 19, so 2^255 = p + 19, and a^(2^255) = a^(p+19) = a^p * a^19 = a * a^19 = a^20
    // So a^(p-2) = a^(2^255-21) = a^(2^255) * a^(-21) = a^20 * a^(-21) = a^(-1)
    // That's circular. Let me just use the direct exponentiation approach.

    // Standard X25519 inversion: compute a^(p-2) where p-2 = 2^255 - 21
    // Binary: 11111...1101011 (254 ones, then 01011)
    // Actually p-2 = 2^255 - 21 = 2^255 - 16 - 4 - 1 = 2^255 - 0b10101
    // In binary: 0x7FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEB
    // = 254 ones, then 0, then 1, then 0, then 1, then 1

    // For correctness, let's use a simpler (but slower) approach:
    // Square-and-multiply for 255 bits of the exponent p-2

    // p-2 = 2^255 - 21. The exponent has bit 254 set (the 2^254 term).
    // Let's compute a^(2^255-21) by:
    // 1. Compute a^(2^255) by squaring 255 times from a
    // 2. Compute a^21 by multiplying
    // 3. Result = a^(2^255) * a^(-21) ... but we don't have inverse yet.

    // Actually, the simplest correct approach for VUMA:
    // a^(-1) = a^(p-2) mod p
    // p-2 = 2^255 - 21
    // We compute this as: a^(2^255) * a^(-21)
    // But a^(-21) = (a^(-1))^21 which is circular.

    // The correct approach: a^(p-2) = a^(2^255 - 21)
    // = a^(2^255) / a^21 (in the exponent)
    // But in modular arithmetic, we can't divide. We multiply.
    // a^(2^255-21) = a^(2^255) * a^(-21) = a^(2^255) * (a^21)^(-1)
    // This is still circular.

    // The real approach: compute a^(p-2) using binary square-and-multiply.
    // p-2 in binary: bit 254 is the MSB.
    // We start with result = a (for bit 254), then for each subsequent bit:
    //   result = result^2
    //   if bit is 1: result = result * a

    // Let's implement this with a fixed 255-step chain.
    // p-2 = 2^255 - 21 = 2^255 - 0b10101
    // Binary (255 bits): 11111111...1110101011
    // Actually let's compute: 2^255 - 21
    // 2^255 in binary: 1 followed by 255 zeros
    // Subtract 21 = 0b10101:
    // 2^255 - 1 = 255 ones
    // 2^255 - 21 = 2^255 - 1 - 20 = (255 ones) - 0b10100
    // = 254 ones, then 01010, then 11 ... let me just compute:
    // p-2 = 0x7FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEB
    // = 111...11101011 (bit 0=1, bit 1=1, bit 2=0, bit 3=1, bit 4=0, bits 5..254=1)

    // For VUMA, doing 255 iterations of square-and-multiply is too much code.
    // Let's use the standard X25519 inversion chain which uses ~253 squarings
    // and ~11 multiplications, organized as a fixed sequence.

    // For now, let's just do 255 squarings + multiply for each set bit.
    // This is slow but correct.

    // Start: r = a (bit 254 is set in p-2)
    fe_copy(r, a);

    // Process bits 253 down to 0
    // p-2 = 2^255 - 21
    // Bit pattern: bits 5 through 254 are 1, bit 4=0, bit 3=1, bit 2=0, bit 1=1, bit 0=1
    // Wait, let me verify: 21 = 0b10101, so p-2 = 2^255 - 0b10101
    // 2^255 - 1 = 255 ones (bits 0..254 all 1)
    // 2^255 - 21 = 2^255 - 1 - 20 = (255 ones) - 0b10100
    // 255 ones: 1111...1111 (255 bits)
    // subtract 10100 (20):
    //   ...11101011 (the last 5 bits become 01011, rest stay 1)
    // So: bits 5..254 = 1, bit 4 = 0, bit 3 = 1, bit 2 = 0, bit 1 = 1, bit 0 = 1

    // Let's do this as a loop. We need 254 squarings and multiplications.
    // For bit i (from 253 down to 0): square r, then if bit i is 1, multiply by a.

    // Bits 5..253 are all 1 → 249 squarings + 249 multiplications
    // Bit 4 is 0 → 1 squaring
    // Bit 3 is 1 → 1 squaring + 1 multiplication
    // Bit 2 is 0 → 1 squaring
    // Bit 1 is 1 → 1 squaring + 1 multiplication
    // Bit 0 is 1 → 1 squaring + 1 multiplication
    // Total: 254 squarings + 252 multiplications

    // That's a LOT of code. Let me use a loop instead.
    // But VUMA loops can't iterate 255 times efficiently for this...
    // Actually they can — a while loop works fine.

    // Process bits 253 down to 5 (all 1s)
    let bit: u32 = 253;
    while bit >= 5 {
        fe_square(r, r);
        fe_mul(r, r, a);
        if bit == 0 {
            bit = 4294967295;  // break condition (will fail >= 5 check)
        } else {
            bit = bit - 1;
        }
    }
    // bit is now 4294967295 (or we broke out)

    // Bit 4 (value 0): square only
    fe_square(r, r);

    // Bit 3 (value 1): square + multiply
    fe_square(r, r);
    fe_mul(r, r, a);

    // Bit 2 (value 0): square only
    fe_square(r, r);

    // Bit 1 (value 1): square + multiply
    fe_square(r, r);
    fe_mul(r, r, a);

    // Bit 0 (value 1): square + multiply
    fe_square(r, r);
    fe_mul(r, r, a);
}

// ===========================================================================
// Montgomery ladder (RFC 7748 §5)
// ===========================================================================

// x25519_scalarmult: compute scalar * u-coordinate
// Inputs: scalar (32 bytes), u_in (32 bytes)
// Output: u_out (32 bytes)
transform x25519_scalarmult(out: State<X25519Bytes>, scalar: State<X25519Bytes>, u_in: State<X25519Bytes>) {
    let x1 = state_new(Fe);
    let x2 = state_new(Fe);
    let z2 = state_new(Fe);
    let x3 = state_new(Fe);
    let z3 = state_new(Fe);
    let swap: u32 = 0;

    // Clamp the scalar:
    // scalar[0] &= 248 (clear bits 0,1,2)
    // scalar[31] &= 127 (clear bit 255)
    // scalar[31] |= 64 (set bit 254)
    // We modify a local copy of the scalar bytes
    let k = state_new(X25519Bytes);
    let i: u32 = 0;
    while i < 32 {
        k.data[i] = scalar.data[i];
        i = i + 1;
    }
    k.data[0] = k.data[0] & 248;
    k.data[31] = k.data[31] & 127;
    k.data[31] = k.data[31] | 64;

    // Load u-coordinate into x1
    fe_from_bytes(x1, u_in);

    // Initialize: x2 = 1, z2 = 0, x3 = x1, z3 = 1
    fe_one(x2);
    fe_zero(z2);
    fe_copy(x3, x1);
    fe_one(z3);

    // Montgomery ladder: 255 iterations (bits 254 down to 0)
    // Allocate all temporaries ONCE outside the loop (avoids stack growth
    // from state_new inside loop body)
    let a = state_new(Fe);
    let aa = state_new(Fe);
    let b = state_new(Fe);
    let bb = state_new(Fe);
    let e = state_new(Fe);
    let c = state_new(Fe);
    let d = state_new(Fe);
    let da = state_new(Fe);
    let cb = state_new(Fe);
    let da_cb = state_new(Fe);
    let da_minus_cb = state_new(Fe);
    let temp = state_new(Fe);
    let e_scaled = state_new(Fe);
    let aa_plus = state_new(Fe);
    let a24_fe = state_new(Fe);
    a24_fe.limbs[0] = 121665;
    a24_fe.limbs[1] = 0; a24_fe.limbs[2] = 0; a24_fe.limbs[3] = 0;
    a24_fe.limbs[4] = 0; a24_fe.limbs[5] = 0; a24_fe.limbs[6] = 0; a24_fe.limbs[7] = 0;

    let t: u32 = 254;
    while t < 255 {  // t goes from 254 down to 0 (wraps around at 0)
        // Read bit t of the scalar
        let byte_idx = t / 8;
        let bit_idx = t % 8;
        let k_byte = k.data[byte_idx] as u32;
        let bit_val = (k_byte >> bit_idx) & 1;

        // Conditional swap
        swap = swap ^ bit_val;
        fe_cswap(swap, x2, x3);
        fe_cswap(swap, z2, z3);
        swap = bit_val;

        // Compute:
        // A = x2 + z2
        // AA = A^2
        // B = x2 - z2
        // BB = B^2
        // E = AA - BB
        // C = x3 + z3
        // D = x3 - z3
        // DA = D * A
        // CB = C * B
        // x3 = (DA + CB)^2
        // z3 = x1 * (DA - CB)^2
        // x2 = AA * BB
        // z2 = E * (AA + a24 * E)  where a24 = 121665

        fe_add(a, x2, z2);      // A = x2 + z2
        fe_square(aa, a);        // AA = A^2
        fe_sub(b, x2, z2);      // B = x2 - z2
        fe_square(bb, b);        // BB = B^2
        fe_sub(e, aa, bb);      // E = AA - BB
        fe_add(c, x3, z3);      // C = x3 + z3
        fe_sub(d, x3, z3);      // D = x3 - z3
        fe_mul(da, d, a);        // DA = D * A
        fe_mul(cb, c, b);        // CB = C * B

        // x3 = (DA + CB)^2
        fe_add(da_cb, da, cb);
        fe_square(x3, da_cb);

        // z3 = x1 * (DA - CB)^2
        fe_sub(da_minus_cb, da, cb);
        fe_square(temp, da_minus_cb);
        fe_mul(z3, x1, temp);

        // x2 = AA * BB
        fe_mul(x2, aa, bb);

        // z2 = E * (AA + a24 * E)  where a24 = 121665
        // Use fe_mul (verified correct) instead of fe_mul_a24 (has carry bug)
        fe_mul(e_scaled, e, a24_fe);
        fe_add(aa_plus, aa, e_scaled);
        fe_mul(z2, e, aa_plus);

        // Decrement t (handle wrap at 0)
        if t == 0 {
            t = 256;  // will fail the while condition
        } else {
            t = t - 1;
        }
    }

    // Final conditional swap
    fe_cswap(swap, x2, x3);
    fe_cswap(swap, z2, z3);

    // Compute result = x2 / z2 = x2 * z2^(-1)
    let z_inv = state_new(Fe);
    fe_invert(z_inv, z2);
    let result = state_new(Fe);
    fe_mul(result, x2, z_inv);

    // Output
    fe_to_bytes(result, out);
}

// x25519_base: scalar multiplication with base point (u=9)
transform x25519_base(out: State<X25519Bytes>, scalar: State<X25519Bytes>) {
    let base = state_new(X25519Bytes);
    // Base point u-coordinate = 9
    base.data[0] = 9;
    let i: u32 = 1;
    while i < 32 {
        base.data[i] = 0;
        i = i + 1;
    }
    x25519_scalarmult(out, scalar, base);
}
