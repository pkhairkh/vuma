// womb/crypto/asym/ecdsa_p256.vuma — ECDSA over NIST P-256 (FIPS 186-4)
// No main() — importable library module.
// Requires: bignum.vuma (bn256_*), sha256_sha224.vuma (sha256_*),
//           hmac.vuma (hmac_sha256).
//
// Curve: y^2 = x^3 + a*x + b (mod p)   ;   a = -3 mod p
//   p = 2^256 - 2^224 + 2^192 + 2^96 - 1
//   G = (Gx, Gy), n = group order (see constants)
//
// Point coordinates and scalars are 32-byte big-endian on the wire. The bignum
// module uses little-endian internally, so we byte-swap at every entry/exit.
//
// VUMA 2.0 PMT-native: state_new(Layout) / State<T> / typed arrays.

// ===========================================================================
// Layouts
// ===========================================================================

layout B32  = { bytes: [u8; 32] }     // 32-byte BE field element / scalar
layout B256 = { bytes: [u8; 256] }    // message buffer (max 256 bytes)
layout B128 = { bytes: [u8; 128] }    // sha256 chunk input

// ===========================================================================
// P-256 constants (32-byte big-endian).
// ===========================================================================

transform p256_p(out: State<B32>) {
    out.bytes[ 0] = 255; out.bytes[ 1] = 255; out.bytes[ 2] = 255; out.bytes[ 3] = 255;
    out.bytes[ 4] =   0; out.bytes[ 5] =   0; out.bytes[ 6] =   0; out.bytes[ 7] =   1;
    out.bytes[ 8] =   0; out.bytes[ 9] =   0; out.bytes[10] =   0; out.bytes[11] =   0;
    out.bytes[12] =   0; out.bytes[13] =   0; out.bytes[14] =   0; out.bytes[15] =   0;
    out.bytes[16] =   0; out.bytes[17] =   0; out.bytes[18] =   0; out.bytes[19] =   0;
    out.bytes[20] = 255; out.bytes[21] = 255; out.bytes[22] = 255; out.bytes[23] = 255;
    out.bytes[24] = 255; out.bytes[25] = 255; out.bytes[26] = 255; out.bytes[27] = 255;
    out.bytes[28] = 255; out.bytes[29] = 255; out.bytes[30] = 255; out.bytes[31] = 255;
}

transform p256_n(out: State<B32>) {
    out.bytes[ 0] = 255; out.bytes[ 1] = 255; out.bytes[ 2] = 255; out.bytes[ 3] = 255;
    out.bytes[ 4] =   0; out.bytes[ 5] =   0; out.bytes[ 6] =   0; out.bytes[ 7] =   0;
    out.bytes[ 8] = 255; out.bytes[ 9] = 255; out.bytes[10] = 255; out.bytes[11] = 255;
    out.bytes[12] = 255; out.bytes[13] = 255; out.bytes[14] = 255; out.bytes[15] = 255;
    out.bytes[16] = 188; out.bytes[17] = 230; out.bytes[18] = 250; out.bytes[19] = 173;
    out.bytes[20] = 167; out.bytes[21] =  23; out.bytes[22] = 158; out.bytes[23] = 132;
    out.bytes[24] = 243; out.bytes[25] = 185; out.bytes[26] = 202; out.bytes[27] = 194;
    out.bytes[28] = 252; out.bytes[29] =  99; out.bytes[30] =  37; out.bytes[31] =  81;
}

transform p256_b(out: State<B32>) {
    out.bytes[ 0] =  90; out.bytes[ 1] = 198; out.bytes[ 2] =  53; out.bytes[ 3] = 216;
    out.bytes[ 4] = 170; out.bytes[ 5] =  58; out.bytes[ 6] = 147; out.bytes[ 7] = 231;
    out.bytes[ 8] = 179; out.bytes[ 9] = 235; out.bytes[10] = 189; out.bytes[11] =  85;
    out.bytes[12] = 118; out.bytes[13] = 152; out.bytes[14] = 134; out.bytes[15] = 188;
    out.bytes[16] = 101; out.bytes[17] =  29; out.bytes[18] =   6; out.bytes[19] = 176;
    out.bytes[20] = 204; out.bytes[21] =  83; out.bytes[22] = 176; out.bytes[23] = 246;
    out.bytes[24] =  59; out.bytes[25] = 206; out.bytes[26] =  60; out.bytes[27] =  62;
    out.bytes[28] =  39; out.bytes[29] = 210; out.bytes[30] =  96; out.bytes[31] =  75;
}

transform p256_gx(out: State<B32>) {
    out.bytes[ 0] = 107; out.bytes[ 1] =  23; out.bytes[ 2] = 209; out.bytes[ 3] = 242;
    out.bytes[ 4] = 225; out.bytes[ 5] =  44; out.bytes[ 6] =  66; out.bytes[ 7] =  71;
    out.bytes[ 8] = 248; out.bytes[ 9] = 188; out.bytes[10] = 230; out.bytes[11] = 229;
    out.bytes[12] =  99; out.bytes[13] = 164; out.bytes[14] =  64; out.bytes[15] = 242;
    out.bytes[16] = 119; out.bytes[17] =   3; out.bytes[18] = 125; out.bytes[19] = 129;
    out.bytes[20] =  45; out.bytes[21] = 235; out.bytes[22] =  51; out.bytes[23] = 160;
    out.bytes[24] = 244; out.bytes[25] = 161; out.bytes[26] =  57; out.bytes[27] =  69;
    out.bytes[28] = 216; out.bytes[29] = 152; out.bytes[30] = 194; out.bytes[31] = 150;
}

transform p256_gy(out: State<B32>) {
    out.bytes[ 0] =  79; out.bytes[ 1] = 227; out.bytes[ 2] =  66; out.bytes[ 3] = 226;
    out.bytes[ 4] = 254; out.bytes[ 5] =  26; out.bytes[ 6] = 127; out.bytes[ 7] = 155;
    out.bytes[ 8] = 142; out.bytes[ 9] = 231; out.bytes[10] = 235; out.bytes[11] =  74;
    out.bytes[12] = 124; out.bytes[13] =  15; out.bytes[14] = 158; out.bytes[15] =  22;
    out.bytes[16] =  43; out.bytes[17] = 206; out.bytes[18] =  51; out.bytes[19] =  87;
    out.bytes[20] = 107; out.bytes[21] =  49; out.bytes[22] =  94; out.bytes[23] = 206;
    out.bytes[24] = 203; out.bytes[25] = 182; out.bytes[26] =  64; out.bytes[27] = 104;
    out.bytes[28] =  55; out.bytes[29] = 191; out.bytes[30] =  81; out.bytes[31] = 245;
}

// ===========================================================================
// BE ↔ LE byte swap for 32-byte field elements.
// ===========================================================================

transform swap_endian_32(dst: State<B32>, src: State<B32>) {
    let tmp = state_new(B32);
    let i: u32 = 0;
    while i < 32 { tmp.bytes[i] = src.bytes[31 - i]; i = i + 1; }
    let j: u32 = 0;
    while j < 32 { dst.bytes[j] = tmp.bytes[j]; j = j + 1; }
}

// ===========================================================================
// B32 (LE bytes) ↔ Bn256Ctx (4 × u64 limbs)
// ===========================================================================

transform b32_to_bn256(dst: State<Bn256Ctx>, src: State<B32>) {
    let li: u32 = 0;
    while li < 4 {
        let off = li * 8;
        let b0 = src.bytes[off] as u64;
        let b1 = src.bytes[off + 1] as u64;
        let b2 = src.bytes[off + 2] as u64;
        let b3 = src.bytes[off + 3] as u64;
        let b4 = src.bytes[off + 4] as u64;
        let b5 = src.bytes[off + 5] as u64;
        let b6 = src.bytes[off + 6] as u64;
        let b7 = src.bytes[off + 7] as u64;
        dst.limbs[li] = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
                       | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56);
        li = li + 1;
    }
}

transform bn256_to_b32(dst: State<B32>, src: State<Bn256Ctx>) {
    let li: u32 = 0;
    while li < 4 {
        let off = li * 8;
        let v: u64 = src.limbs[li];
        dst.bytes[off]     = (v & 255) as u8;
        dst.bytes[off + 1] = ((v >> 8) & 255) as u8;
        dst.bytes[off + 2] = ((v >> 16) & 255) as u8;
        dst.bytes[off + 3] = ((v >> 24) & 255) as u8;
        dst.bytes[off + 4] = ((v >> 32) & 255) as u8;
        dst.bytes[off + 5] = ((v >> 40) & 255) as u8;
        dst.bytes[off + 6] = ((v >> 48) & 255) as u8;
        dst.bytes[off + 7] = ((v >> 56) & 255) as u8;
        li = li + 1;
    }
}

// Convenience: load a BE-encoded scalar into Bn256Ctx (LE limbs) via swap.
transform be32_to_bn256(dst: State<Bn256Ctx>, src: State<B32>) {
    let le = state_new(B32);
    swap_endian_32(le, src);
    b32_to_bn256(dst, le);
}

transform bn256_to_be32(dst: State<B32>, src: State<Bn256Ctx>) {
    let le = state_new(B32);
    bn256_to_b32(le, src);
    swap_endian_32(dst, le);
}

// ===========================================================================
// SHA-256 streaming helper for variable-length messages up to 256 bytes.
// ===========================================================================

transform p256_sha256_hash(msg: State<B256>, msg_len: u32, out: State<B32>) {
    let ctx = state_new(Sha256Ctx);
    sha256_init(ctx);
    let i: u32 = 0;
    while i < msg_len {
        let chunk = state_new(Sha256Data);
        let remaining: u32 = msg_len - i;
        let to_copy: u32 = 64;
        if remaining < 64 { to_copy = remaining; }
        let j: u32 = 0;
        while j < to_copy {
            chunk.data[j] = msg.bytes[i + j];
            j = j + 1;
        }
        sha256_update(ctx, chunk, to_copy as u64);
        i = i + to_copy;
    }
    let digest = state_new(Sha256Digest);
    sha256_final(ctx, digest);
    let k: u32 = 0;
    while k < 32 { out.bytes[k] = digest.data[k]; k = k + 1; }
}

// ===========================================================================
// Point-on-curve check: y^2 == x^3 - 3*x + b (mod p).
// Inputs are LE Bn256Ctx (already byte-swapped).
// ===========================================================================

transform p256_is_on_curve_bn(px: State<Bn256Ctx>, py: State<Bn256Ctx>, p_bn: State<Bn256Ctx>, b_bn: State<Bn256Ctx>) -> u32 {
    let y_sq = state_new(Bn256Ctx);
    let x_sq = state_new(Bn256Ctx);
    let x_cubed = state_new(Bn256Ctx);
    let three_x = state_new(Bn256Ctx);
    let neg_3x = state_new(Bn256Ctx);
    let rhs = state_new(Bn256Ctx);

    bn256_mod_mul(y_sq, py, py, p_bn);
    bn256_mod_mul(x_sq, px, px, p_bn);
    bn256_mod_mul(x_cubed, x_sq, px, p_bn);
    bn256_mod_add(three_x, px, px, p_bn);
    bn256_mod_add(three_x, three_x, px, p_bn);
    bn256_mod_sub(neg_3x, p_bn, three_x, p_bn);
    bn256_mod_add(rhs, x_cubed, neg_3x, p_bn);
    bn256_mod_add(rhs, rhs, b_bn, p_bn);

    if bn256_cmp(y_sq, rhs) == 0 { return 1; }
    return 0;
}

// ===========================================================================
// Projective coordinate operations (Jacobian, a = -3) — avoids per-step
// modular inversions. ~10x fewer field operations per point op, and
// eliminates the expensive bn256_mod_inv from the inner loop.
// A point (X, Y, Z) represents affine (X/Z^2, Y/Z^3). Identity = Z=0.
// ===========================================================================

// Jacobian doubling with a = -3: (X1,Y1,Z1) -> (X3,Y3,Z3)
// Uses the EFD "dbl-2001-b" formulas optimized for a=-3.
transform p256_proj_double(x3: State<Bn256Ctx>, y3: State<Bn256Ctx>, z3: State<Bn256Ctx>,
                           x1: State<Bn256Ctx>, y1: State<Bn256Ctx>, z1: State<Bn256Ctx>,
                           p_bn: State<Bn256Ctx>) {
    // If Z1 == 0, return identity (0, 1, 0)
    if bn256_is_zero(z1) == 1 {
        bn256_zero(x3);
        bn256_set_u32(y3, 1);
        bn256_zero(z3);
        return;
    }
    let delta = state_new(Bn256Ctx);
    let gamma = state_new(Bn256Ctx);
    let beta  = state_new(Bn256Ctx);
    let alpha = state_new(Bn256Ctx);
    let t1    = state_new(Bn256Ctx);
    let t2    = state_new(Bn256Ctx);
    let t3    = state_new(Bn256Ctx);
    let t4    = state_new(Bn256Ctx);
    let eight_beta = state_new(Bn256Ctx);
    let four_beta  = state_new(Bn256Ctx);
    let eight_gamma2 = state_new(Bn256Ctx);

    // delta = Z1^2
    bn256_mod_mul(delta, z1, z1, p_bn);
    // gamma = Y1^2
    bn256_mod_mul(gamma, y1, y1, p_bn);
    // beta = X1 * gamma
    bn256_mod_mul(beta, x1, gamma, p_bn);
    // alpha = 3 * (X1 - delta) * (X1 + delta) = 3*(X1^2 - delta^2)
    bn256_mod_sub(t1, x1, delta, p_bn);
    bn256_mod_add(t2, x1, delta, p_bn);
    bn256_mod_mul(t3, t1, t2, p_bn);
    bn256_mod_add(alpha, t3, t3, p_bn);
    bn256_mod_add(alpha, alpha, t3, p_bn);  // alpha = 3*t3
    // X3 = alpha^2 - 8*beta
    bn256_mod_mul(t1, alpha, alpha, p_bn);   // alpha^2
    bn256_mod_add(four_beta, beta, beta, p_bn);
    bn256_mod_add(four_beta, four_beta, beta, p_bn);  // 3*beta
    bn256_mod_add(four_beta, four_beta, beta, p_bn);  // 4*beta
    bn256_mod_add(eight_beta, four_beta, four_beta, p_bn);  // 8*beta
    bn256_mod_sub(x3, t1, eight_beta, p_bn);
    // Z3 = (Y1 + Z1)^2 - gamma - delta
    bn256_mod_add(t1, y1, z1, p_bn);
    bn256_mod_mul(t2, t1, t1, p_bn);
    bn256_mod_sub(z3, t2, gamma, p_bn);
    bn256_mod_sub(z3, z3, delta, p_bn);
    // Y3 = alpha * (4*beta - X3) - 8*gamma^2
    bn256_mod_sub(t1, four_beta, x3, p_bn);   // 4*beta - X3
    bn256_mod_mul(t2, alpha, t1, p_bn);        // alpha*(4*beta - X3)
    bn256_mod_mul(t3, gamma, gamma, p_bn);     // gamma^2
    // 8*gamma^2 = double gamma^2 three times
    bn256_mod_add(t4, t3, t3, p_bn);   // 2*gamma^2
    bn256_mod_add(t4, t4, t4, p_bn);   // 4*gamma^2
    bn256_mod_add(eight_gamma2, t4, t4, p_bn);  // 8*gamma^2
    bn256_mod_sub(y3, t2, eight_gamma2, p_bn);
}

// Jacobian mixed addition: (X1,Y1,Z1) + (X2,Y2,1) -> (X3,Y3,Z3)
// P2 is affine (Z2=1). Faster than general addition.
transform p256_proj_add_mixed(x3: State<Bn256Ctx>, y3: State<Bn256Ctx>, z3: State<Bn256Ctx>,
                              x1: State<Bn256Ctx>, y1: State<Bn256Ctx>, z1: State<Bn256Ctx>,
                              x2: State<Bn256Ctx>, y2: State<Bn256Ctx>,
                              p_bn: State<Bn256Ctx>) {
    // If Z1 == 0, return P2 in Jacobian (X2, Y2, 1)
    if bn256_is_zero(z1) == 1 {
        bn256_copy(x3, x2);
        bn256_copy(y3, y2);
        bn256_set_u32(z3, 1);
        return;
    }
    let z1sq = state_new(Bn256Ctx);
    let u2   = state_new(Bn256Ctx);
    let s2   = state_new(Bn256Ctx);
    let h    = state_new(Bn256Ctx);
    let r    = state_new(Bn256Ctx);
    let hh   = state_new(Bn256Ctx);  // H^2
    let hhh  = state_new(Bn256Ctx);  // H^3
    let t1   = state_new(Bn256Ctx);
    let t2   = state_new(Bn256Ctx);

    // z1sq = Z1^2
    bn256_mod_mul(z1sq, z1, z1, p_bn);
    // U2 = X2 * Z1^2
    bn256_mod_mul(u2, x2, z1sq, p_bn);
    // S2 = Y2 * Z1^3 = Y2 * Z1 * Z1^2
    bn256_mod_mul(t1, z1, z1sq, p_bn);
    bn256_mod_mul(s2, y2, t1, p_bn);
    // H = U2 - X1
    bn256_mod_sub(h, u2, x1, p_bn);
    // r = S2 - Y1
    bn256_mod_sub(r, s2, y1, p_bn);
    // If H == 0:
    //   if r == 0: P1 == P2, should double (caller handles)
    //   else: result is identity
    if bn256_is_zero(h) == 1 {
        if bn256_is_zero(r) == 1 {
            // P1 == P2: double P1
            p256_proj_double(x3, y3, z3, x1, y1, z1, p_bn);
            return;
        } else {
            // P1 == -P2: identity
            bn256_zero(x3);
            bn256_set_u32(y3, 1);
            bn256_zero(z3);
            return;
        }
    }
    // HH = H^2
    bn256_mod_mul(hh, h, h, p_bn);
    // HHH = H * HH
    bn256_mod_mul(hhh, h, hh, p_bn);
    // X3 = r^2 - HHH - 2*X1*HH
    bn256_mod_mul(t1, r, r, p_bn);          // r^2
    bn256_mod_sub(t1, t1, hhh, p_bn);       // r^2 - H^3
    bn256_mod_mul(t2, x1, hh, p_bn);        // X1*HH
    bn256_mod_add(t2, t2, t2, p_bn);        // 2*X1*HH
    bn256_mod_sub(x3, t1, t2, p_bn);        // X3 = r^2 - H^3 - 2*X1*HH
    // Y3 = r*(X1*HH - X3) - Y1*HHH
    bn256_mod_mul(t1, x1, hh, p_bn);        // X1*HH
    bn256_mod_sub(t1, t1, x3, p_bn);        // X1*HH - X3
    bn256_mod_mul(t2, r, t1, p_bn);         // r*(X1*HH - X3)
    bn256_mod_mul(t1, y1, hhh, p_bn);       // Y1*HHH
    bn256_mod_sub(y3, t2, t1, p_bn);        // Y3
    // Z3 = Z1 * H
    bn256_mod_mul(z3, z1, h, p_bn);
}

// ===========================================================================
// Point operations (affine coordinates, mod p) — all in Bn256Ctx.
// Kept for reference; scalar_mul now uses projective coordinates internally.
// ===========================================================================

transform p256_point_double_bn(rx: State<Bn256Ctx>, ry: State<Bn256Ctx>, px: State<Bn256Ctx>, py: State<Bn256Ctx>, p_bn: State<Bn256Ctx>) {
    if bn256_is_zero(px) == 1 {
        if bn256_is_zero(py) == 1 {
            bn256_zero(rx);
            bn256_zero(ry);
            return;
        }
    }
    // a = -3 mod p = p - 3
    let a_val = state_new(Bn256Ctx);
    bn256_copy(a_val, p_bn);
    let lo = a_val.limbs[0];
    a_val.limbs[0] = lo - 3;

    let t1 = state_new(Bn256Ctx);
    let t2 = state_new(Bn256Ctx);
    let t3 = state_new(Bn256Ctx);
    let t3_inv = state_new(Bn256Ctx);
    let slope = state_new(Bn256Ctx);
    let slope_sq = state_new(Bn256Ctx);
    let two_x = state_new(Bn256Ctx);
    let x_minus_rx = state_new(Bn256Ctx);
    let slope_x = state_new(Bn256Ctx);

    bn256_mod_mul(t1, px, px, p_bn);
    bn256_mod_add(t2, t1, t1, p_bn);
    bn256_mod_add(t2, t2, t1, p_bn);
    bn256_mod_add(t2, t2, a_val, p_bn);

    bn256_mod_add(t3, py, py, p_bn);
    bn256_mod_inv(t3_inv, t3, p_bn);
    bn256_mod_mul(slope, t2, t3_inv, p_bn);

    bn256_mod_mul(slope_sq, slope, slope, p_bn);
    bn256_mod_add(two_x, px, px, p_bn);
    bn256_mod_sub(rx, slope_sq, two_x, p_bn);

    bn256_mod_sub(x_minus_rx, px, rx, p_bn);
    bn256_mod_mul(slope_x, slope, x_minus_rx, p_bn);
    bn256_mod_sub(ry, slope_x, py, p_bn);
}

transform p256_point_add_bn(rx: State<Bn256Ctx>, ry: State<Bn256Ctx>, px: State<Bn256Ctx>, py: State<Bn256Ctx>, qx: State<Bn256Ctx>, qy: State<Bn256Ctx>, p_bn: State<Bn256Ctx>) {
    if bn256_is_zero(px) == 1 {
        if bn256_is_zero(py) == 1 {
            bn256_copy(rx, qx);
            bn256_copy(ry, qy);
            return;
        }
    }
    if bn256_is_zero(qx) == 1 {
        if bn256_is_zero(qy) == 1 {
            bn256_copy(rx, px);
            bn256_copy(ry, py);
            return;
        }
    }
    if bn256_cmp(px, qx) == 0 {
        if bn256_cmp(py, qy) == 0 {
            p256_point_double_bn(rx, ry, px, py, p_bn);
            return;
        } else {
            bn256_zero(rx);
            bn256_zero(ry);
            return;
        }
    }

    let dy = state_new(Bn256Ctx);
    let dx = state_new(Bn256Ctx);
    let dx_inv = state_new(Bn256Ctx);
    let slope = state_new(Bn256Ctx);
    let slope_sq = state_new(Bn256Ctx);
    let temp = state_new(Bn256Ctx);
    let x_diff = state_new(Bn256Ctx);
    let slope_x = state_new(Bn256Ctx);

    bn256_mod_sub(dy, qy, py, p_bn);
    bn256_mod_sub(dx, qx, px, p_bn);
    bn256_mod_inv(dx_inv, dx, p_bn);
    bn256_mod_mul(slope, dy, dx_inv, p_bn);

    bn256_mod_mul(slope_sq, slope, slope, p_bn);
    bn256_mod_sub(temp, slope_sq, px, p_bn);
    bn256_mod_sub(rx, temp, qx, p_bn);

    bn256_mod_sub(x_diff, px, rx, p_bn);
    bn256_mod_mul(slope_x, slope, x_diff, p_bn);
    bn256_mod_sub(ry, slope_x, py, p_bn);
}

transform p256_scalar_mul_bn(rx: State<Bn256Ctx>, ry: State<Bn256Ctx>, k: State<Bn256Ctx>, px: State<Bn256Ctx>, py: State<Bn256Ctx>, p_bn: State<Bn256Ctx>) {
    // Handle k == 0: return identity (0, 0)
    if bn256_is_zero(k) == 1 {
        bn256_zero(rx);
        bn256_zero(ry);
        return;
    }
    // Projective scalar multiplication (double-and-add, MSB-first)
    // R starts as identity (Z=0), P is the base point in affine (Z=1)
    let rx_j = state_new(Bn256Ctx);
    let ry_j = state_new(Bn256Ctx);
    let rz_j = state_new(Bn256Ctx);
    let tx   = state_new(Bn256Ctx);
    let ty   = state_new(Bn256Ctx);
    let tz   = state_new(Bn256Ctx);

    // R = identity (0, 1, 0)
    bn256_zero(rx_j);
    bn256_set_u32(ry_j, 1);
    bn256_zero(rz_j);

    let bits: u32 = bn256_bitlen(k);
    let i: u32 = bits;
    while i > 0 {
        let ii = i - 1;
        // R = 2*R (projective double)
        p256_proj_double(tx, ty, tz, rx_j, ry_j, rz_j, p_bn);
        bn256_copy(rx_j, tx);
        bn256_copy(ry_j, ty);
        bn256_copy(rz_j, tz);
        if bn256_get_bit(k, ii) == 1 {
            // R = R + P (mixed addition, P is affine)
            p256_proj_add_mixed(tx, ty, tz, rx_j, ry_j, rz_j, px, py, p_bn);
            bn256_copy(rx_j, tx);
            bn256_copy(ry_j, ty);
            bn256_copy(rz_j, tz);
        }
        i = ii;
    }
    // Convert to affine: rx = RX * Z^(-1) mod p, ry = RY * Z^(-1) mod p
    // where Z^(-1) is the modular inverse of Z.
    // For Jacobian: x_affine = X / Z^2, y_affine = Y / Z^3.
    // Compute z_inv = Z^(-1), then rx = X * z_inv^2, ry = Y * z_inv^3.
    if bn256_is_zero(rz_j) == 1 {
        // R is identity
        bn256_zero(rx);
        bn256_zero(ry);
        return;
    }
    let z_inv   = state_new(Bn256Ctx);
    let z_inv2  = state_new(Bn256Ctx);
    let z_inv3  = state_new(Bn256Ctx);
    bn256_mod_inv(z_inv, rz_j, p_bn);
    bn256_mod_mul(z_inv2, z_inv, z_inv, p_bn);       // z_inv^2
    bn256_mod_mul(z_inv3, z_inv2, z_inv, p_bn);      // z_inv^3
    bn256_mod_mul(rx, rx_j, z_inv2, p_bn);            // X * z_inv^2
    bn256_mod_mul(ry, ry_j, z_inv3, p_bn);            // Y * z_inv^3
}

// ===========================================================================
// Key generation: produce (private scalar d, public point Q).
//   privkey_be (in/out) : 32-byte big-endian private scalar (caller seeds)
//   pubkey_x_be (out)   : 32-byte big-endian Q.x
//   pubkey_y_be (out)   : 32-byte big-endian Q.y
// ===========================================================================

transform ecdsa_p256_keygen(privkey_be: State<B32>, pubkey_x_be: State<B32>, pubkey_y_be: State<B32>) {
    let n_be = state_new(B32);
    p256_n(n_be);
    let n_bn = state_new(Bn256Ctx);
    be32_to_bn256(n_bn, n_be);

    let d_bn = state_new(Bn256Ctx);
    be32_to_bn256(d_bn, privkey_be);
    if bn256_cmp(d_bn, n_bn) != 2 {
        bn256_sub(d_bn, d_bn, n_bn);
    }
    if bn256_is_zero(d_bn) == 1 {
        bn256_set_u32(d_bn, 1);
    }

    let gx_be = state_new(B32);
    let gy_be = state_new(B32);
    p256_gx(gx_be);
    p256_gy(gy_be);
    let gx_bn = state_new(Bn256Ctx);
    let gy_bn = state_new(Bn256Ctx);
    be32_to_bn256(gx_bn, gx_be);
    be32_to_bn256(gy_bn, gy_be);

    let p_be = state_new(B32);
    p256_p(p_be);
    let p_bn = state_new(Bn256Ctx);
    be32_to_bn256(p_bn, p_be);

    let qx_bn = state_new(Bn256Ctx);
    let qy_bn = state_new(Bn256Ctx);
    p256_scalar_mul_bn(qx_bn, qy_bn, d_bn, gx_bn, gy_bn, p_bn);

    bn256_to_be32(pubkey_x_be, qx_bn);
    bn256_to_be32(pubkey_y_be, qy_bn);
    bn256_to_be32(privkey_be, d_bn);
}

// ===========================================================================
// RFC 6979 deterministic nonce for ECDSA P-256 (HMAC-SHA-256).
// Inputs (BE): x_be, h_be, n_le (LE B32).
// Output: k_le (LE B32).
// ===========================================================================

transform rfc6979_p256_k(x_be: State<B32>, h_be: State<B32>, n_le: State<B32>, k_le: State<B32>) {
    let hlen: u32 = 32;

    let V = state_new(HmacMsg);
    let K = state_new(HmacKey);
    let i: u32 = 0;
    while i < hlen { V.bytes[i] = 1; K.bytes[i] = 0; i = i + 1; }

    // bits2octets(h) = h_be reduced mod n, in BE
    let h_le = state_new(B32);
    swap_endian_32(h_le, h_be);
    let h_bn = state_new(Bn256Ctx);
    let n_bn = state_new(Bn256Ctx);
    b32_to_bn256(h_bn, h_le);
    b32_to_bn256(n_bn, n_le);
    if bn256_cmp(h_bn, n_bn) != 2 { bn256_sub(h_bn, h_bn, n_bn); }
    let h_be_reduced = state_new(B32);
    bn256_to_be32(h_be_reduced, h_bn);

    // x_be_canon: copy of x_be (caller-provided private key)
    let x_be_canon = state_new(B32);
    let j: u32 = 0;
    while j < 32 { x_be_canon.bytes[j] = x_be.bytes[j]; j = j + 1; }

    // buf1 = V || 0x00 || x || h_reduced (length = hlen + 1 + 32 + 32 = 97)
    let buf1 = state_new(HmacMsg);
    let p1: u32 = 0;
    while p1 < hlen { buf1.bytes[p1] = V.bytes[p1]; p1 = p1 + 1; }
    buf1.bytes[hlen] = 0;
    let p2: u32 = 0;
    while p2 < 32 { buf1.bytes[hlen + 1 + p2] = x_be_canon.bytes[p2]; p2 = p2 + 1; }
    let p3: u32 = 0;
    while p3 < 32 { buf1.bytes[hlen + 1 + 32 + p3] = h_be_reduced.bytes[p3]; p3 = p3 + 1; }

    let tmp_out = state_new(HmacOut);
    let buf1_len: u32 = hlen + 1 + 64;
    hmac_sha256(K, hlen, buf1, buf1_len, tmp_out);  // V <- HMAC_K(buf1)
    let c1: u32 = 0;
    while c1 < hlen { V.bytes[c1] = tmp_out.bytes[c1]; c1 = c1 + 1; }
    hmac_sha256(K, hlen, buf1, buf1_len, tmp_out);  // K <- HMAC_K(buf1) → real K
    let c2: u32 = 0;
    while c2 < hlen { K.bytes[c2] = tmp_out.bytes[c2]; c2 = c2 + 1; }
    hmac_sha256(K, hlen, V, hlen, tmp_out);          // V <- HMAC_K(V)
    let c3: u32 = 0;
    while c3 < hlen { V.bytes[c3] = tmp_out.bytes[c3]; c3 = c3 + 1; }

    // buf2 = V || 0x01 || x || h_reduced
    let buf2 = state_new(HmacMsg);
    let q1: u32 = 0;
    while q1 < hlen { buf2.bytes[q1] = V.bytes[q1]; q1 = q1 + 1; }
    buf2.bytes[hlen] = 1;
    let q2: u32 = 0;
    while q2 < 32 { buf2.bytes[hlen + 1 + q2] = x_be_canon.bytes[q2]; q2 = q2 + 1; }
    let q3: u32 = 0;
    while q3 < 32 { buf2.bytes[hlen + 1 + 32 + q3] = h_be_reduced.bytes[q3]; q3 = q3 + 1; }

    hmac_sha256(K, hlen, buf2, buf1_len, tmp_out);   // K <- HMAC_K(buf2)
    let d1: u32 = 0;
    while d1 < hlen { K.bytes[d1] = tmp_out.bytes[d1]; d1 = d1 + 1; }
    hmac_sha256(K, hlen, V, hlen, tmp_out);           // V <- HMAC_K(V)
    let d2: u32 = 0;
    while d2 < hlen { V.bytes[d2] = tmp_out.bytes[d2]; d2 = d2 + 1; }

    // Generate candidate T = V (32 bytes), reduce mod n with rejection
    let accepted: u32 = 0;
    let attempts: u32 = 0;
    while accepted == 0 {
        if attempts >= 32 { accepted = 1; }  // safety bail
        if accepted == 0 {
            hmac_sha256(K, hlen, V, hlen, tmp_out);  // V <- HMAC_K(V)
            let e1: u32 = 0;
            while e1 < hlen { V.bytes[e1] = tmp_out.bytes[e1]; e1 = e1 + 1; }
            // k = bits2int(V) = V as BE → LE → bn → reduce mod n
            swap_endian_32(k_le, V);
            let k_bn = state_new(Bn256Ctx);
            b32_to_bn256(k_bn, k_le);
            if bn256_cmp(k_bn, n_bn) != 2 { bn256_sub(k_bn, k_bn, n_bn); }
            bn256_to_b32(k_le, k_bn);
            if bn256_is_zero(k_bn) == 0 {
                accepted = 1;
            } else {
                // K = HMAC_K(V || 0x00) ; V = HMAC_K(V)
                let buf3 = state_new(HmacMsg);
                let f1: u32 = 0;
                while f1 < hlen { buf3.bytes[f1] = V.bytes[f1]; f1 = f1 + 1; }
                buf3.bytes[hlen] = 0;
                hmac_sha256(K, hlen, buf3, hlen + 1, tmp_out);
                let g1: u32 = 0;
                while g1 < hlen { K.bytes[g1] = tmp_out.bytes[g1]; g1 = g1 + 1; }
                hmac_sha256(K, hlen, V, hlen, tmp_out);
                let g2: u32 = 0;
                while g2 < hlen { V.bytes[g2] = tmp_out.bytes[g2]; g2 = g2 + 1; }
            }
        }
        attempts = attempts + 1;
    }
}

// ===========================================================================
// ECDSA P-256 Sign
// ===========================================================================

transform ecdsa_p256_sign(msg: State<B256>, msg_len: u32, privkey_be: State<B32>, r_out: State<B32>, s_out: State<B32>) {
    let h_be = state_new(B32);
    p256_sha256_hash(msg, msg_len, h_be);

    let h_bn = state_new(Bn256Ctx);
    let d_bn = state_new(Bn256Ctx);
    be32_to_bn256(h_bn, h_be);
    be32_to_bn256(d_bn, privkey_be);

    let p_be = state_new(B32);
    let n_be = state_new(B32);
    let gx_be = state_new(B32);
    let gy_be = state_new(B32);
    p256_p(p_be);
    p256_n(n_be);
    p256_gx(gx_be);
    p256_gy(gy_be);
    let p_bn = state_new(Bn256Ctx);
    let n_bn = state_new(Bn256Ctx);
    let gx_bn = state_new(Bn256Ctx);
    let gy_bn = state_new(Bn256Ctx);
    be32_to_bn256(p_bn, p_be);
    be32_to_bn256(n_bn, n_be);
    be32_to_bn256(gx_bn, gx_be);
    be32_to_bn256(gy_bn, gy_be);

    if bn256_cmp(d_bn, n_bn) != 2 { bn256_sub(d_bn, d_bn, n_bn); }
    if bn256_cmp(h_bn, n_bn) != 2 { bn256_sub(h_bn, h_bn, n_bn); }

    let n_le = state_new(B32);
    swap_endian_32(n_le, n_be);
    let k_le = state_new(B32);
    rfc6979_p256_k(privkey_be, h_be, n_le, k_le);
    let k_bn = state_new(Bn256Ctx);
    b32_to_bn256(k_bn, k_le);

    let rx = state_new(Bn256Ctx);
    let ry = state_new(Bn256Ctx);
    p256_scalar_mul_bn(rx, ry, k_bn, gx_bn, gy_bn, p_bn);

    let r_bn = state_new(Bn256Ctx);
    bn256_copy(r_bn, rx);
    if bn256_cmp(r_bn, n_bn) != 2 { bn256_sub(r_bn, r_bn, n_bn); }

    let k_inv = state_new(Bn256Ctx);
    let rd = state_new(Bn256Ctx);
    let h_rd = state_new(Bn256Ctx);
    let s_bn = state_new(Bn256Ctx);
    bn256_mod_inv(k_inv, k_bn, n_bn);
    bn256_mod_mul(rd, r_bn, d_bn, n_bn);
    bn256_mod_add(h_rd, h_bn, rd, n_bn);
    bn256_mod_mul(s_bn, k_inv, h_rd, n_bn);

    bn256_to_be32(r_out, r_bn);
    bn256_to_be32(s_out, s_bn);
}

// ===========================================================================
// ECDSA P-256 Verify
// ===========================================================================

transform ecdsa_p256_verify(msg: State<B256>, msg_len: u32, pubkey_x_be: State<B32>, pubkey_y_be: State<B32>, r_be: State<B32>, s_be: State<B32>) -> u32 {
    let n_be = state_new(B32);
    p256_n(n_be);
    let n_bn = state_new(Bn256Ctx);
    be32_to_bn256(n_bn, n_be);

    let r_bn = state_new(Bn256Ctx);
    let s_bn = state_new(Bn256Ctx);
    be32_to_bn256(r_bn, r_be);
    be32_to_bn256(s_bn, s_be);

    if bn256_is_zero(r_bn) == 1 { return 0; }
    if bn256_is_zero(s_bn) == 1 { return 0; }
    if bn256_cmp(r_bn, n_bn) != 2 { return 0; }
    if bn256_cmp(s_bn, n_bn) != 2 { return 0; }

    let h_be = state_new(B32);
    p256_sha256_hash(msg, msg_len, h_be);
    let h_bn = state_new(Bn256Ctx);
    be32_to_bn256(h_bn, h_be);
    if bn256_cmp(h_bn, n_bn) != 2 { bn256_sub(h_bn, h_bn, n_bn); }

    let p_be = state_new(B32);
    let b_be = state_new(B32);
    let gx_be = state_new(B32);
    let gy_be = state_new(B32);
    p256_p(p_be);
    p256_b(b_be);
    p256_gx(gx_be);
    p256_gy(gy_be);
    let p_bn = state_new(Bn256Ctx);
    let b_bn = state_new(Bn256Ctx);
    let gx_bn = state_new(Bn256Ctx);
    let gy_bn = state_new(Bn256Ctx);
    be32_to_bn256(p_bn, p_be);
    be32_to_bn256(b_bn, b_be);
    be32_to_bn256(gx_bn, gx_be);
    be32_to_bn256(gy_bn, gy_be);

    let qx_bn = state_new(Bn256Ctx);
    let qy_bn = state_new(Bn256Ctx);
    be32_to_bn256(qx_bn, pubkey_x_be);
    be32_to_bn256(qy_bn, pubkey_y_be);

    if p256_is_on_curve_bn(qx_bn, qy_bn, p_bn, b_bn) == 0 {
        return 0;
    }

    let w = state_new(Bn256Ctx);
    let u1 = state_new(Bn256Ctx);
    let u2 = state_new(Bn256Ctx);
    bn256_mod_inv(w, s_bn, n_bn);
    bn256_mod_mul(u1, h_bn, w, n_bn);
    bn256_mod_mul(u2, r_bn, w, n_bn);

    let r1x = state_new(Bn256Ctx);
    let r1y = state_new(Bn256Ctx);
    p256_scalar_mul_bn(r1x, r1y, u1, gx_bn, gy_bn, p_bn);
    let r2x = state_new(Bn256Ctx);
    let r2y = state_new(Bn256Ctx);
    p256_scalar_mul_bn(r2x, r2y, u2, qx_bn, qy_bn, p_bn);
    let ptx = state_new(Bn256Ctx);
    let pty = state_new(Bn256Ctx);
    p256_point_add_bn(ptx, pty, r1x, r1y, r2x, r2y, p_bn);

    if bn256_is_zero(ptx) == 0 || bn256_is_zero(pty) == 0 {
        let v = state_new(Bn256Ctx);
        bn256_copy(v, ptx);
        if bn256_cmp(v, n_bn) != 2 { bn256_sub(v, v, n_bn); }
        if bn256_cmp(v, r_bn) == 0 { return 1; }
    }
    return 0;
}

// Expose helpers for sibling modules (ecdh_p256).
transform p256_is_on_curve_wrap(px_be: State<B32>, py_be: State<B32>) -> u32 {
    let p_be = state_new(B32);
    let b_be = state_new(B32);
    p256_p(p_be);
    p256_b(b_be);
    let p_bn = state_new(Bn256Ctx);
    let b_bn = state_new(Bn256Ctx);
    be32_to_bn256(p_bn, p_be);
    be32_to_bn256(b_bn, b_be);
    let px_bn = state_new(Bn256Ctx);
    let py_bn = state_new(Bn256Ctx);
    be32_to_bn256(px_bn, px_be);
    be32_to_bn256(py_bn, py_be);
    return p256_is_on_curve_bn(px_bn, py_bn, p_bn, b_bn);
}

transform p256_scalar_mul_wrap(rx_be: State<B32>, ry_be: State<B32>, k_be: State<B32>, px_be: State<B32>, py_be: State<B32>) {
    let p_be = state_new(B32);
    p256_p(p_be);
    let p_bn = state_new(Bn256Ctx);
    be32_to_bn256(p_bn, p_be);
    let k_bn = state_new(Bn256Ctx);
    let px_bn = state_new(Bn256Ctx);
    let py_bn = state_new(Bn256Ctx);
    be32_to_bn256(k_bn, k_be);
    be32_to_bn256(px_bn, px_be);
    be32_to_bn256(py_bn, py_be);
    let rx_bn = state_new(Bn256Ctx);
    let ry_bn = state_new(Bn256Ctx);
    p256_scalar_mul_bn(rx_bn, ry_bn, k_bn, px_bn, py_bn, p_bn);
    bn256_to_be32(rx_be, rx_bn);
    bn256_to_be32(ry_be, ry_bn);
}

transform swap_endian_32_wrap(dst: State<B32>, src: State<B32>) {
    swap_endian_32(dst, src);
}
