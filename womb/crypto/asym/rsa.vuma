// womb/crypto/rsa.vuma — RSA-2048 PKCS#1 v1.5 (RFC 8017)
// 2048-bit RSA: key generation, encrypt/decrypt, sign/verify, CRT private op.
// No main() — importable library module.
//
// VUMA 2.0 PMT-native: state_new(Layout) / State<T> / [u8;N] arrays.
// All allocate/free/Address/*ptr removed (arena auto-frees on return).
//
// Requires (all VUMA 2.0 PMT-native):
//   - bignum2048.vuma (bn2048_mod_exp, bn2048_mod_mul, bn2048_mod, bn2048_mod_inv,
//                     bn2048_add, bn2048_sub, bn2048_cmp, bn2048_is_zero,
//                     bn2048_copy, bn2048_zero, bn2048_set_u32, bn2048_bitlen,
//                     bn2048_get_bit; operates on State<Bn2048Ctx>)
//   - sha256_sha224.vuma (sha256_init / sha256_update / sha256_final +
//                        Sha256Ctx / Sha256Data / Sha256Digest layouts)
//   - drbg.vuma (drbg_init / drbg_generate + DrbgCtx / DrbgData / DrbgOut layouts)
//
// Memory layout of an RSA private key (RSA_KEY_BYTES = 8 * 256 = 2048 bytes):
//   off +    0 : n    (modulus,                256 bytes, little-endian)
//   off +  256 : e    (public exponent,        256 bytes, little-endian)
//   off +  512 : d    (private exponent,       256 bytes, little-endian)
//   off +  768 : p    (first prime,            256 bytes, little-endian)
//   off + 1024 : q    (second prime,           256 bytes, little-endian)
//   off + 1280 : dp   (d mod (p-1),            256 bytes, little-endian)
//   off + 1536 : dq   (d mod (q-1),            256 bytes, little-endian)
//   off + 1792 : qinv (q^-1 mod p,             256 bytes, little-endian)
// A public key occupies the first 512 bytes (n || e).

const KEY_SIZE: u32 = 256;          // 2048 bits = 256 bytes
const RSA_KEY_BYTES: u32 = 2048;    // full private key blob (8 * 256)
const RSA_PUB_BYTES: u32 = 512;     // public key blob (n || e)
const EXP_E: u32 = 65537;           // standard public exponent F4

// ===========================================================================
// Layouts
// ===========================================================================

// 256-byte buffer: modulus, exponent, ciphertext, signature, padded EM, etc.
layout Rsa256 = { bytes: [u8; 256] }

// 2048-byte buffer: full private key blob (n || e || d || p || q || dp || dq || qinv).
layout RsaKey = { bytes: [u8; 2048] }

// 5-byte buffer: Miller-Rabin trial bases.
layout RsaBases = { bytes: [u8; 5] }

// ===========================================================================
// Byte <-> limb conversion helpers. RFC 8017 EM is a byte string; the
// bignum2048 module stores 2048-bit values as 32 little-endian u64 limbs.
// ===========================================================================

// Convert big-endian byte array to little-endian limbs.
// key_bytes is the actual key size (128 for 1024-bit, 256 for 2048-bit).
// The value is stored MSB-aligned in src.bytes[0..key_bytes-1].
// Maps to bn.limbs[0..key_bytes/8-1] with limbs[key_bytes/8..31] = 0.
transform rsa_bn_from_bytes(bn: State<Bn2048Ctx>, src: State<Rsa256>, key_bytes: u32) {
    bn2048_zero(bn);
    let n_limbs: u32 = key_bytes / 8;
    let i: u32 = 0;
    while i < n_limbs {
        let off: u32 = i * 8;
        let b0: u64 = src.bytes[off + 0] as u64;
        let b1: u64 = src.bytes[off + 1] as u64;
        let b2: u64 = src.bytes[off + 2] as u64;
        let b3: u64 = src.bytes[off + 3] as u64;
        let b4: u64 = src.bytes[off + 4] as u64;
        let b5: u64 = src.bytes[off + 5] as u64;
        let b6: u64 = src.bytes[off + 6] as u64;
        let b7: u64 = src.bytes[off + 7] as u64;
        bn.limbs[n_limbs - 1 - i] = (b0 << 56) | (b1 << 48) | (b2 << 40) | (b3 << 32) | (b4 << 24) | (b5 << 16) | (b6 << 8) | b7;
        i = i + 1;
    }
}

// Convert little-endian limbs to big-endian byte array.
// key_bytes is the actual key size (128 for 1024-bit, 256 for 2048-bit).
// Writes to dst.bytes[0..key_bytes-1], MSB-aligned.
transform rsa_bn_to_bytes(dst: State<Rsa256>, bn: State<Bn2048Ctx>, key_bytes: u32) {
    let n_limbs: u32 = key_bytes / 8;
    let i: u32 = 0;
    while i < n_limbs {
        let off: u32 = i * 8;
        let v: u64 = bn.limbs[n_limbs - 1 - i];
        dst.bytes[off + 0] = ((v >> 56) & 255) as u8;
        dst.bytes[off + 1] = ((v >> 48) & 255) as u8;
        dst.bytes[off + 2] = ((v >> 40) & 255) as u8;
        dst.bytes[off + 3] = ((v >> 32) & 255) as u8;
        dst.bytes[off + 4] = ((v >> 24) & 255) as u8;
        dst.bytes[off + 5] = ((v >> 16) & 255) as u8;
        dst.bytes[off + 6] = ((v >> 8) & 255) as u8;
        dst.bytes[off + 7] = (v & 255) as u8;
        i = i + 1;
    }
    // Zero remaining bytes
    let j: u32 = key_bytes;
    while j < 256 {
        dst.bytes[j] = 0;
        j = j + 1;
    }
}

// ===========================================================================
// Right-shift a 256-byte little-endian bignum by 1 bit (in place semantics
// through r). Implemented byte-wise so it works on any 2048-bit value.
// ===========================================================================
transform rsa_bn_rshift1(r: State<Rsa256>, a: State<Rsa256>) {
    let i: u32 = 0;
    while i < 256 {
        let cur: u32 = a.bytes[i] as u32;
        let nxt: u32 = 0;
        let ip1: u32 = i + 1;
        if ip1 < 256 { nxt = a.bytes[ip1] as u32; }
        r.bytes[i] = ((cur >> 1) | (nxt << 7)) as u8;
        i = i + 1;
    }
}

// Left-shift a 256-byte bignum by 1 bit.
transform rsa_bn_lshift1_256(r: State<Rsa256>, a: State<Rsa256>) {
    let carry: u32 = 0;
    let i: u32 = 0;
    while i < 256 {
        let cur: u32 = a.bytes[i] as u32;
        let newv: u32 = (cur << 1) | carry;
        r.bytes[i] = (newv & 255) as u8;
        carry = newv >> 8;
        i = i + 1;
    }
}

// Copy 256 bytes from src to dst.
transform ka_copy_to(dst: State<Rsa256>, src: State<Rsa256>) {
    let i: u32 = 0;
    while i < 256 { dst.bytes[i] = src.bytes[i]; i = i + 1; }
}

// Copy 256 bytes from a key-blob offset into a standalone Rsa256 buffer.
transform ka_from_blob(dst: State<Rsa256>, src: State<RsaKey>, off: u32) {
    let i: u32 = 0;
    while i < 256 { dst.bytes[i] = src.bytes[off + i]; i = i + 1; }
}

// Copy 256 bytes from a standalone Rsa256 buffer into a key-blob offset.
transform ka_to_blob(dst: State<RsaKey>, off: u32, src: State<Rsa256>) {
    let i: u32 = 0;
    while i < 256 { dst.bytes[off + i] = src.bytes[i]; i = i + 1; }
}

// ===========================================================================
// Byte-wise bignum primitives operating on State<Rsa256>.
// These wrap the corresponding bn2048_* transforms by converting between
// byte-oriented RFC 8017 EM buffers and Bn2048Ctx limb arrays.
// ===========================================================================

transform rsa_bn_copy(r: State<Rsa256>, a: State<Rsa256>) {
    let i: u32 = 0;
    while i < 256 { r.bytes[i] = a.bytes[i]; i = i + 1; }
}

transform rsa_bn_zero(r: State<Rsa256>) {
    let i: u32 = 0;
    while i < 256 { r.bytes[i] = 0; i = i + 1; }
}

transform rsa_bn_set_u32(r: State<Rsa256>, v: u32) {
    rsa_bn_zero(r);
    // Store v little-endian into bytes 0..4
    r.bytes[0] = (v & 255) as u8;
    r.bytes[1] = ((v >> 8) & 255) as u8;
    r.bytes[2] = ((v >> 16) & 255) as u8;
    r.bytes[3] = ((v >> 24) & 255) as u8;
}

transform rsa_bn_is_zero(a: State<Rsa256>) -> u32 {
    let i: u32 = 0;
    while i < 256 {
        if a.bytes[i] != 0 { return 0; }
        i = i + 1;
    }
    return 1;
}

// Three-way compare (byte-wise, big-endian). Returns 1 if a>b, 2 if a<b, 0 if equal.
// Uses u32 return type (not i32) to avoid VUMA codegen signed-comparison bug.
// Iterates from MSB (byte[0]) to LSB (byte[255]) — correct for big-endian.
transform rsa_bn_cmp(a: State<Rsa256>, b: State<Rsa256>) -> u32 {
    let i: u32 = 0;
    while i < 256 {
        let av: u32 = a.bytes[i] as u32;
        let bv: u32 = b.bytes[i] as u32;
        if av > bv { return 1; }
        if av < bv { return 2; }
        i = i + 1;
    }
    return 0;
}

// Get bit `bit` of a big-endian 256-byte number. Bit 0 = LSB (byte[255] bit 0).
transform rsa_bn_get_bit(a: State<Rsa256>, bit: u32) -> u32 {
    if bit >= 2048 { return 0; }
    let byte_idx: u32 = 255 - (bit / 8);
    let pos: u32 = bit % 8;
    let v: u32 = a.bytes[byte_idx] as u32;
    return (v >> pos) & 1;
}

// Bit length of a big-endian 256-byte number. Scans from MSB (byte[0]) to LSB.
transform rsa_bn_bitlen(a: State<Rsa256>) -> u32 {
    let i: u32 = 0;
    while i < 256 {
        if a.bytes[i] != 0 {
            let b: u32 = a.bytes[i] as u32;
            let bits: u32 = 8;
            while bits > 0 {
                let p: u32 = bits - 1;
                if ((b >> p) & 1) == 1 {
                    let remaining: u32 = 255 - i;
                    return remaining * 8 + bits;
                }
                bits = bits - 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

// r = a + b. Returns carry-out (0 or 1).
transform rsa_bn_add(r: State<Rsa256>, a: State<Rsa256>, b: State<Rsa256>) -> u32 {
    let carry: u32 = 0;
    let i: u32 = 0;
    while i < 256 {
        let av: u32 = a.bytes[i] as u32;
        let bv: u32 = b.bytes[i] as u32;
        let sum: u32 = av + bv + carry;
        r.bytes[i] = (sum & 255) as u8;
        carry = sum >> 8;
        i = i + 1;
    }
    return carry;
}

// r = a - b. Returns borrow-out (0 or 1).
transform rsa_bn_sub(r: State<Rsa256>, a: State<Rsa256>, b: State<Rsa256>) -> u32 {
    let borrow: u32 = 0;
    let i: u32 = 0;
    while i < 256 {
        let av: u32 = a.bytes[i] as u32;
        let bv: u32 = b.bytes[i] as u32;
        let diff: i64 = (av as i64) - (bv as i64) - (borrow as i64);
        if diff < 0 {
            r.bytes[i] = ((diff + 256) & 255) as u8;
            borrow = 1;
        } else {
            r.bytes[i] = (diff & 255) as u8;
            borrow = 0;
        }
        i = i + 1;
    }
    return borrow;
}

// ===========================================================================
// 1024-bit * 1024-bit schoolbook multiply into a 2048-bit (256-byte) result.
// Operates on 256-byte buffers but only the low 128 bytes of each input are
// significant (i.e. 1024-bit operands). Result occupies all 256 bytes.
// ===========================================================================
transform rsa_mul_2048(r: State<Rsa256>, a: State<Rsa256>, b: State<Rsa256>) {
    // Zero result
    let i: u32 = 0;
    while i < 256 { r.bytes[i] = 0; i = i + 1; }

    let ai: u32 = 0;
    while ai < 128 {
        let a_val: u32 = a.bytes[ai] as u32;
        if a_val != 0 {
            let bi: u32 = 0;
            while bi < 128 {
                let b_val: u32 = b.bytes[bi] as u32;
                if b_val != 0 {
                    // 16-bit product, add into r at offset ai+bi
                    let prod: u32 = a_val * b_val;
                    let off: u32 = ai + bi;
                    // Add low byte of prod with carry propagation
                    let cur0: u32 = r.bytes[off + 0] as u32;
                    let newv0: u32 = cur0 + (prod & 255);
                    r.bytes[off + 0] = (newv0 & 255) as u8;
                    let mut_carry: u32 = newv0 >> 8;
                    // Add high byte of prod with carry propagation
                    let mut_remaining: u32 = (prod >> 8) + mut_carry;
                    let k: u32 = 1;
                    let k_local: u32 = k;
                    // Unrolled first iteration (k == 1) since prod has at most
                    // 16 bits => remaining fits in 17 bits, propagated in <=2 steps.
                    if off + k_local < 256 {
                        if mut_remaining != 0 {
                            let cur1: u32 = r.bytes[off + k_local] as u32;
                            let newv1: u32 = cur1 + (mut_remaining & 255);
                            r.bytes[off + k_local] = (newv1 & 255) as u8;
                            let rem2: u32 = (mut_remaining >> 8) + (newv1 >> 8);
                            let k2: u32 = k_local + 1;
                            if off + k2 < 256 {
                                if rem2 != 0 {
                                    let cur2: u32 = r.bytes[off + k2] as u32;
                                    let newv2: u32 = cur2 + (rem2 & 255);
                                    r.bytes[off + k2] = (newv2 & 255) as u8;
                                    // prod is 16 bits, so no further carry possible
                                }
                            }
                        }
                    }
                }
                bi = bi + 1;
            }
        }
        ai = ai + 1;
    }
}

// ===========================================================================
// Extended-GCD modular inverse for 2048-bit bignums (byte-wise).
// Computes r = a^(-1) mod m via the binary extended Euclidean algorithm.
// All intermediate values stay in [0, m) using mod_add / mod_sub semantics
// on the 256-byte buffers.
// ===========================================================================
transform rsa_bn_mod_inv(r: State<Rsa256>, a: State<Rsa256>, m: State<Rsa256>) {
    let u = state_new(Rsa256);
    let v = state_new(Rsa256);
    let x1 = state_new(Rsa256);
    let x2 = state_new(Rsa256);
    rsa_bn_copy(u, a);
    rsa_bn_copy(v, m);
    rsa_bn_zero(x2);
    rsa_bn_set_u32(x1, 1);

    while rsa_bn_is_zero(u) == 0 {
        // Strip factors of 2 from u, adjusting x1 = x1/2 mod m
        while rsa_bn_get_bit(u, 0) == 0 {
            rsa_bn_rshift1(u, u);
            if rsa_bn_get_bit(x1, 0) == 0 {
                rsa_bn_rshift1(x1, x1);
            } else {
                rsa_bn_add(x1, x1, m);
                rsa_bn_rshift1(x1, x1);
            }
        }
        // Strip factors of 2 from v, adjusting x2 = x2/2 mod m
        while rsa_bn_get_bit(v, 0) == 0 {
            rsa_bn_rshift1(v, v);
            if rsa_bn_get_bit(x2, 0) == 0 {
                rsa_bn_rshift1(x2, x2);
            } else {
                rsa_bn_add(x2, x2, m);
                rsa_bn_rshift1(x2, x2);
            }
        }
        // Reduce the larger of u, v; subtract the smaller; same for x1, x2
        if rsa_bn_cmp(u, v) != 2 {
            rsa_bn_sub(u, u, v);
            let borrow: u32 = rsa_bn_sub(x1, x1, x2);
            if borrow == 1 { rsa_bn_add(x1, x1, m); }
        } else {
            rsa_bn_sub(v, v, u);
            let borrow2: u32 = rsa_bn_sub(x2, x2, x1);
            if borrow2 == 1 { rsa_bn_add(x2, x2, m); }
        }
    }
    rsa_bn_copy(r, x2);
}

// ===========================================================================
// Compute r = a mod m using repeated shift-subtract long division.
// Both inputs and output are 256-byte little-endian bignums. Works for any
// 0 <= a, m < 2^2048 (m != 0).
// ===========================================================================
transform rsa_bn_mod(r: State<Rsa256>, a: State<Rsa256>, m: State<Rsa256>) {
    let rem = state_new(Rsa256);
    rsa_bn_zero(rem);
    let bits: u32 = rsa_bn_bitlen(a);
    let i: u32 = bits;
    while i > 0 {
        let im1: u32 = i - 1;
        // rem = rem << 1
        rsa_bn_lshift1_256(rem, rem);
        // rem.bit0 = a.bit(i-1)
        if rsa_bn_get_bit(a, im1) == 1 {
            rem.bytes[0] = (rem.bytes[0] as u32 | 1) as u8;
        }
        // if rem >= m: rem -= m
        if rsa_bn_cmp(rem, m) != 2 {
            rsa_bn_sub(rem, rem, m);
        }
        i = im1;
    }
    rsa_bn_copy(r, rem);
}

// ===========================================================================
// Wrapper: r = a^exp mod m via the bn2048_mod_exp primitive. Converts the
// byte-oriented operands into Bn2048Ctx limbs and back.
// ===========================================================================
transform rsa_bn_mod_exp(c: State<Rsa256>, m: State<Rsa256>, e: State<Rsa256>, n: State<Rsa256>, key_bytes: u32) {
    let c_bn = state_new(Bn2048Ctx);
    let m_bn = state_new(Bn2048Ctx);
    let e_bn = state_new(Bn2048Ctx);
    let n_bn = state_new(Bn2048Ctx);
    rsa_bn_from_bytes(m_bn, m, key_bytes);
    rsa_bn_from_bytes(e_bn, e, key_bytes);
    rsa_bn_from_bytes(n_bn, n, key_bytes);
    bn2048_mod_exp(c_bn, m_bn, e_bn, n_bn);
    rsa_bn_to_bytes(c, c_bn, key_bytes);
}

transform rsa_bn_mod_mul(r: State<Rsa256>, a: State<Rsa256>, b: State<Rsa256>, m: State<Rsa256>, key_bytes: u32) {
    let r_bn = state_new(Bn2048Ctx);
    let a_bn = state_new(Bn2048Ctx);
    let b_bn = state_new(Bn2048Ctx);
    let m_bn = state_new(Bn2048Ctx);
    rsa_bn_from_bytes(a_bn, a, key_bytes);
    rsa_bn_from_bytes(b_bn, b, key_bytes);
    rsa_bn_from_bytes(m_bn, m, key_bytes);
    bn2048_mod_mul(r_bn, a_bn, b_bn, m_bn);
    rsa_bn_to_bytes(r, r_bn, key_bytes);
}

// ===========================================================================
// SHA-256 helper: hash up to 256 bytes of input into a 32-byte digest.
// The sha256 module's Sha256Data layout only holds 64 bytes per call, so
// multi-block inputs are streamed via init + update + final.
// ===========================================================================
transform rsa_sha256_hash(msg: State<Rsa256>, msg_len: u32, out: State<Sha256Digest>) {
    let ctx = state_new(Sha256Ctx);
    sha256_init(ctx);
    let chunk = state_new(Sha256Data);
    let pos: u32 = 0;
    while pos < msg_len {
        let remaining: u32 = msg_len - pos;
        let chunk_len: u32 = 64;
        if remaining < 64 { chunk_len = remaining; }
        // Zero the chunk buffer (clean state for unused tail bytes).
        let i: u32 = 0;
        while i < 64 { chunk.data[i] = 0; i = i + 1; }
        // Copy chunk_len bytes from msg[pos..pos+chunk_len].
        i = 0;
        while i < chunk_len { chunk.data[i] = msg.bytes[pos + i]; i = i + 1; }
        sha256_update(ctx, chunk, chunk_len as u64);
        pos = pos + chunk_len;
    }
    sha256_final(ctx, out);
}

// ===========================================================================
// Miller-Rabin primality test on a 256-byte (2048-bit) candidate.
// Returns 1 if probably prime, 0 if composite. Uses rounds = 5 small bases
// (2, 3, 5, 7, 11) — sufficient for randomly generated 1024-bit candidates
// in practical key generation.
// ===========================================================================
transform rsa_is_probably_prime(n: State<Rsa256>) -> u32 {
    if rsa_bn_is_zero(n) == 1 { return 0; }
    let n_low: u32 = n.bytes[0] as u32;
    if n_low == 2 { return 1; }
    if n_low == 3 { return 1; }
    if (n_low & 1) == 0 { return 0; }

    // Write n-1 = d * 2^r with d odd
    let nm1 = state_new(Rsa256);
    rsa_bn_set_u32(nm1, 1);
    rsa_bn_sub(nm1, n, nm1);
    let mut_r: u32 = 0;
    let d = state_new(Rsa256);
    rsa_bn_copy(d, nm1);
    while rsa_bn_get_bit(d, 0) == 0 {
        rsa_bn_rshift1(d, d);
        mut_r = mut_r + 1;
    }
    let r: u32 = mut_r;

    let bases = state_new(RsaBases);
    bases.bytes[0] = 2;
    bases.bytes[1] = 3;
    bases.bytes[2] = 5;
    bases.bytes[3] = 7;
    bases.bytes[4] = 11;

    let one = state_new(Rsa256);
    rsa_bn_set_u32(one, 1);

    let result: u32 = 1;
    let bi: u32 = 0;
    while bi < 5 {
        if result == 0 { break; }
        let a = state_new(Rsa256);
        rsa_bn_set_u32(a, bases.bytes[bi] as u32);

        let skip: u32 = 0;
        // If a >= n, skip (only matters for tiny n)
        if rsa_bn_cmp(a, n) != 2 { skip = 1; }

        if skip == 0 {
            // x = a^d mod n
            let x = state_new(Rsa256);
            rsa_bn_mod_exp(x, a, d, n, 256);

            let cont: u32 = 0;
            if rsa_bn_cmp(x, one) == 0 { cont = 1; }
            if cont == 0 {
                if rsa_bn_cmp(x, nm1) == 0 { cont = 1; }
            }

            let ri: u32 = 0;
            let mut_cont: u32 = cont;
            let mut_result: u32 = result;
            while mut_cont == 0 && ri + 1 < r {
                let x2 = state_new(Rsa256);
                rsa_bn_mod_mul(x2, x, x, n, 256);
                rsa_bn_copy(x, x2);
                if rsa_bn_cmp(x, one) == 0 { mut_result = 0; break; }
                if rsa_bn_cmp(x, nm1) == 0 { mut_cont = 1; break; }
                ri = ri + 1;
            }
            result = mut_result;
            if mut_cont == 0 && result == 1 { result = 0; }
        }
        bi = bi + 1;
    }

    return result;
}

// ===========================================================================
// Random 256-byte bignum from the DRBG. The two highest bits and the
// lowest bit are forced to 1 so that p, q are exactly 1024 bits and odd.
// The caller supplies a DrbgCtx; the keygen driver is responsible for
// instantiating/reseeding it before calling this primitive.
// ===========================================================================
transform rsa_random_1024bit_odd(out: State<Rsa256>, drbg: State<DrbgCtx>) {
    let rand = state_new(DrbgOut);
    drbg_generate(drbg, rand, 128);
    // Copy 128 random bytes into out[0..128]
    let i: u32 = 0;
    while i < 128 { out.bytes[i] = rand.bytes[i]; i = i + 1; }
    // Zero out bytes 128..255 so bn2048 sees a 1024-bit value
    i = 128;
    while i < 256 { out.bytes[i] = 0; i = i + 1; }
    out.bytes[0] = (out.bytes[0] as u32 | 1) as u8;       // force odd
    out.bytes[127] = (out.bytes[127] as u32 | 192) as u8; // set top two bits -> 1024-bit
}

// ===========================================================================
// Generate a 1024-bit prime p with p mod EXP_E != 1 (so gcd(p-1, e) = 1).
// Search starts from a random odd 1024-bit integer and increments by 2 until
// Miller-Rabin accepts the candidate.
// ===========================================================================
transform rsa_generate_prime(out: State<Rsa256>, drbg: State<DrbgCtx>) {
    rsa_random_1024bit_odd(out, drbg);
    let attempts: u32 = 0;
    while attempts < 100000 {
        // Reject p if (p mod EXP_E) == 1 (i.e. gcd(p-1, e) != 1)
        let acc: u32 = 0;
        let i: u32 = 128;
        while i > 0 {
            let im1: u32 = i - 1;
            acc = ((acc << 8) | (out.bytes[im1] as u32)) % 65537;
            i = im1;
        }
        if acc != 1 {
            if rsa_is_probably_prime(out) == 1 { return; }
        }
        // Increment by 2 (preserve oddness); carry propagates upward
        let ii: u32 = 0;
        let mut_carry: u32 = 2;
        while ii < 128 && mut_carry > 0 {
            let cur: u32 = out.bytes[ii] as u32;
            let newv: u32 = cur + mut_carry;
            out.bytes[ii] = (newv & 255) as u8;
            mut_carry = newv >> 8;
            ii = ii + 1;
        }
        attempts = attempts + 1;
    }
}

// ===========================================================================
// Generate an RSA-2048 keypair.
//   key_out : State<RsaKey> to receive the full private key blob
//             (n || e || d || p || q || dp || dq || qinv)
//   drbg    : caller-supplied HMAC-DRBG context (must be initialised).
// Returns 1 on success, 0 on failure.
// ===========================================================================
transform rsa_keygen(key_out: State<RsaKey>, drbg: State<DrbgCtx>) -> u32 {
    let p  = state_new(Rsa256);
    let q  = state_new(Rsa256);
    let n  = state_new(Rsa256);
    let e  = state_new(Rsa256);
    let d  = state_new(Rsa256);
    let p1 = state_new(Rsa256);
    let q1 = state_new(Rsa256);
    let phi = state_new(Rsa256);
    let dp = state_new(Rsa256);
    let dq = state_new(Rsa256);
    let qinv = state_new(Rsa256);

    rsa_generate_prime(p, drbg);
    rsa_generate_prime(q, drbg);
    if rsa_bn_cmp(p, q) == 0 {
        rsa_generate_prime(q, drbg);
    }

    // n = p * q
    rsa_mul_2048(n, p, q);

    // e = 65537
    rsa_bn_set_u32(e, EXP_E);

    // phi = (p-1) * (q-1)
    rsa_bn_set_u32(p1, 1); rsa_bn_sub(p1, p, p1);
    rsa_bn_set_u32(q1, 1); rsa_bn_sub(q1, q, q1);
    rsa_mul_2048(phi, p1, q1);

    // d = e^-1 mod phi
    rsa_bn_mod_inv(d, e, phi);

    // dp = d mod (p-1), dq = d mod (q-1), qinv = q^-1 mod p
    rsa_bn_mod(dp,  d, p1);
    rsa_bn_mod(dq,  d, q1);
    rsa_bn_mod_inv(qinv, q, p);

    ka_to_blob(key_out,    0, n);
    ka_to_blob(key_out,  256, e);
    ka_to_blob(key_out,  512, d);
    ka_to_blob(key_out,  768, p);
    ka_to_blob(key_out, 1024, q);
    ka_to_blob(key_out, 1280, dp);
    ka_to_blob(key_out, 1536, dq);
    ka_to_blob(key_out, 1792, qinv);

    return 1;
}

// ===========================================================================
// Core RSA primitive: c = m^e mod n (public op) and m = c^d mod n (private op)
// ===========================================================================
transform rsa_public_op(c: State<Rsa256>, m: State<Rsa256>, e: State<Rsa256>, n: State<Rsa256>, key_bytes: u32) {
    rsa_bn_mod_exp(c, m, e, n, key_bytes);
}

transform rsa_private_op(m: State<Rsa256>, c: State<Rsa256>, d: State<Rsa256>, n: State<Rsa256>, key_bytes: u32) {
    rsa_bn_mod_exp(m, c, d, n, key_bytes);
}

// CRT-accelerated private operation: m = c^d mod n = CRT(c^dp mod p, c^dq mod q).
//   m1 = c^dp mod p
//   m2 = c^dq mod q
//   h = qinv * (m1 - m2) mod p
//   m = m2 + h * q
// Inputs: key blob (full private key, RSA_KEY_BYTES), ciphertext c (256 bytes),
//         output m (256 bytes).
transform rsa_private_op_crt(m: State<Rsa256>, c: State<Rsa256>, key: State<RsaKey>) {
    let p = state_new(Rsa256); let q = state_new(Rsa256);
    let dp = state_new(Rsa256); let dq = state_new(Rsa256); let qinv = state_new(Rsa256);
    let n = state_new(Rsa256);
    ka_from_blob(p,  key, 768);
    ka_from_blob(q,  key, 1024);
    ka_from_blob(dp, key, 1280);
    ka_from_blob(dq, key, 1536);
    ka_from_blob(qinv, key, 1792);
    ka_from_blob(n,  key, 0);

    // Reduce c modulo p and q so the exponentiation operands fit in p, q
    let cp = state_new(Rsa256); let cq = state_new(Rsa256);
    rsa_bn_mod(cp, c, p);
    rsa_bn_mod(cq, c, q);

    let m1 = state_new(Rsa256); let m2 = state_new(Rsa256);
    rsa_bn_mod_exp(m1, cp, dp, p, 128);
    rsa_bn_mod_exp(m2, cq, dq, q, 128);

    // h = qinv * (m1 - m2) mod p
    let diff = state_new(Rsa256);
    let borrow: u32 = rsa_bn_sub(diff, m1, m2);
    if borrow == 1 { rsa_bn_add(diff, diff, p); }
    let t = state_new(Rsa256);
    rsa_bn_mod_mul(t, qinv, diff, p, 128);

    // m = m2 + t * q
    let tq = state_new(Rsa256);
    rsa_mul_2048(tq, t, q);
    rsa_bn_add(m, m2, tq);

    // Reduce m mod n in case t*q produced a carry into the high half
    let m_red = state_new(Rsa256);
    rsa_bn_mod(m_red, m, n);
    rsa_bn_copy(m, m_red);
}

// ===========================================================================
// PKCS#1 v1.5 padding for encryption: EM = 0x00 || 0x02 || PS || 0x00 || M
// PS is random non-zero bytes, length = key_size - msg_len - 3.
// ===========================================================================
transform rsa_pkcs1_v15_pad_encrypt(msg: State<Rsa256>, msg_len: u32, key_size: u32, random: State<Rsa256>, padded: State<Rsa256>) -> u32 {
    if msg_len > key_size - 11 { return 0; }
    let ps_len: u32 = key_size - msg_len - 3;
    padded.bytes[0] = 0;
    padded.bytes[1] = 2;
    let i: u32 = 0;
    while i < ps_len {
        let r: u32 = random.bytes[i] as u32;
        let mut_r: u32 = r;
        if r == 0 { mut_r = 1; }  // PS bytes must be non-zero
        padded.bytes[2 + i] = mut_r as u8;
        i = i + 1;
    }
    padded.bytes[2 + ps_len] = 0;
    i = 0;
    while i < msg_len { padded.bytes[3 + ps_len + i] = msg.bytes[i]; i = i + 1; }
    return key_size;
}

// PKCS#1 v1.5 padding for signatures: EM = 0x00 || 0x01 || PS || 0x00 || T
// PS is 0xFF bytes, T is the DigestInfo prefix || hash.
transform rsa_pkcs1_v15_pad_sign(hash: State<Sha256Digest>, hash_len: u32, key_size: u32, padded: State<Rsa256>) -> u32 {
    let di_len: u32 = 19;
    let t_len: u32 = di_len + hash_len;
    if t_len > key_size - 11 { return 0; }
    let ps_len: u32 = key_size - t_len - 3;
    padded.bytes[0] = 0;
    padded.bytes[1] = 1;
    let i: u32 = 0;
    while i < ps_len { padded.bytes[2 + i] = 255; i = i + 1; }
    padded.bytes[2 + ps_len] = 0;
    // DigestInfo prefix for SHA-256 (RFC 8017 Section 9.2)
    let base: u32 = 3 + ps_len;
    padded.bytes[base +  0] = 48;  padded.bytes[base +  1] = 49;
    padded.bytes[base +  2] = 48;  padded.bytes[base +  3] = 13;
    padded.bytes[base +  4] = 6;   padded.bytes[base +  5] = 9;
    padded.bytes[base +  6] = 96;  padded.bytes[base +  7] = 134;
    padded.bytes[base +  8] = 72;  padded.bytes[base +  9] = 1;
    padded.bytes[base + 10] = 101; padded.bytes[base + 11] = 3;
    padded.bytes[base + 12] = 4;   padded.bytes[base + 13] = 2;
    padded.bytes[base + 14] = 1;   padded.bytes[base + 15] = 5;
    padded.bytes[base + 16] = 0;   padded.bytes[base + 17] = 4;
    padded.bytes[base + 18] = 32;
    let i2: u32 = 0;
    while i2 < hash_len { padded.bytes[3 + ps_len + di_len + i2] = hash.data[i2]; i2 = i2 + 1; }
    return key_size;
}

// ===========================================================================
// PKCS#1 v1.5 encrypt: pad, then c = m^e mod n
// ===========================================================================
transform rsa_pkcs1_v15_encrypt(msg: State<Rsa256>, msg_len: u32, e: State<Rsa256>, n: State<Rsa256>, key_size: u32, random: State<Rsa256>, ciphertext: State<Rsa256>) -> u32 {
    let padded = state_new(Rsa256);
    let pad_len: u32 = rsa_pkcs1_v15_pad_encrypt(msg, msg_len, key_size, random, padded);
    if pad_len == 0 { return 0; }
    rsa_public_op(ciphertext, padded, e, n, key_size);
    return key_size;
}

// ===========================================================================
// PKCS#1 v1.5 decrypt: m = c^d mod n, then strip padding
// ===========================================================================
transform rsa_pkcs1_v15_decrypt(ciphertext: State<Rsa256>, d: State<Rsa256>, n: State<Rsa256>, key_size: u32, msg: State<Rsa256>) -> u32 {
    let padded = state_new(Rsa256);
    rsa_private_op(padded, ciphertext, d, n, key_size);
    if padded.bytes[0] != 0 { return 0; }
    if padded.bytes[1] != 2 { return 0; }
    let mut_i: u32 = 2;
    let mut_found: u32 = 0;
    while mut_i < key_size {
        if padded.bytes[mut_i] == 0 { mut_found = 1; break; }
        mut_i = mut_i + 1;
    }
    if mut_found == 0 { return 0; }
    if mut_i == key_size { return 0; }
    if mut_i < 10 { return 0; }  // PS must be at least 8 bytes
    let i: u32 = mut_i;
    let msg_len: u32 = key_size - i - 1;
    let j: u32 = 0;
    while j < msg_len {
        let ip1: u32 = i + 1 + j;
        msg.bytes[j] = padded.bytes[ip1];
        j = j + 1;
    }
    return msg_len;
}

// ===========================================================================
// PKCS#1 v1.5 sign: hash, pad with DigestInfo, then s = m^d mod n
// ===========================================================================
transform rsa_pkcs1_v15_sign(msg: State<Rsa256>, msg_len: u32, d: State<Rsa256>, n: State<Rsa256>, key_size: u32, signature: State<Rsa256>) -> u32 {
    let hash = state_new(Sha256Digest);
    rsa_sha256_hash(msg, msg_len, hash);
    let padded = state_new(Rsa256);
    let pad_len: u32 = rsa_pkcs1_v15_pad_sign(hash, 32, key_size, padded);
    if pad_len == 0 { return 0; }
    // Call rsa_bn_mod_exp directly (bypassing rsa_private_op to avoid codegen param issue)
    rsa_bn_mod_exp(signature, padded, d, n, key_size);
    return key_size;
}

// ===========================================================================
// PKCS#1 v1.5 verify: hash, re-pad, compare with s^e mod n in constant time
// ===========================================================================
transform rsa_pkcs1_v15_verify(msg: State<Rsa256>, msg_len: u32, e: State<Rsa256>, n: State<Rsa256>, key_size: u32, signature: State<Rsa256>) -> u32 {
    let hash = state_new(Sha256Digest);
    rsa_sha256_hash(msg, msg_len, hash);
    let decrypted = state_new(Rsa256);
    // Call rsa_bn_mod_exp directly (bypassing rsa_public_op to avoid codegen param issue)
    rsa_bn_mod_exp(decrypted, signature, e, n, key_size);
    let expected = state_new(Rsa256);
    let pad_len: u32 = rsa_pkcs1_v15_pad_sign(hash, 32, key_size, expected);
    if pad_len == 0 { return 0; }
    // Constant-time compare
    let diff: u32 = 0;
    let i: u32 = 0;
    while i < key_size {
        let di: u32 = decrypted.bytes[i] as u32;
        let ei: u32 = expected.bytes[i] as u32;
        diff = diff | (di ^ ei);
        i = i + 1;
    }
    let result: u32 = 0;
    if diff == 0 { result = 1; }
    return result;
}

// ===========================================================================
// CRT-accelerated sign variant that takes the full private key blob.
// ===========================================================================
transform rsa_pkcs1_v15_sign_crt(msg: State<Rsa256>, msg_len: u32, key: State<RsaKey>, key_size: u32, signature: State<Rsa256>) -> u32 {
    let hash = state_new(Sha256Digest);
    rsa_sha256_hash(msg, msg_len, hash);
    let padded = state_new(Rsa256);
    let pad_len: u32 = rsa_pkcs1_v15_pad_sign(hash, 32, key_size, padded);
    if pad_len == 0 { return 0; }
    rsa_private_op_crt(signature, padded, key);
    return key_size;
}
