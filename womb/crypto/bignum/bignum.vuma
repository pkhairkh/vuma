// womb/crypto/bignum.vuma — 256-bit Multi-Precision Integer Arithmetic
// 4 x u64 limbs (little-endian). Real add, sub, mul, div, mod, mod_exp,
// gcd, mod_inv. Foundation for RSA, ECDSA, ECDH. No main().
//
// VUMA 2.0 PMT-native: state_new(Layout) / State<T> / [u64;N] limb arrays.
// All allocate/free/Address/*ptr removed (arena auto-frees on return).

const BN256_MASK32: u32 = 4294967295;
const BN256_MASK64: u64 = ((1 << 63) | ((1 << 63) - 1));
const BN256_LIMBS: u32 = 4;
const BN256_BYTES: u32 = 32;

// ===========================================================================
// Layouts
// ===========================================================================

// 64-bit (1-limb) scratch — output of bn_mul_u64.
layout Bn64Ctx = { limbs: [u64; 1] }

// 256-bit (4-limb) bignum context — primary bignum size.
layout Bn256Ctx = { limbs: [u64; 4] }

// 512-bit (8-limb) — 256x256 multiplication result, 512/256 division dividend.
layout Bn512Ctx = { limbs: [u64; 8] }

// ===========================================================================
// Limb load/store helpers (now trivial: u64 limbs indexed directly).
// `off` is a LIMB index (0..3 for Bn256Ctx, 0..7 for Bn512Ctx).
// ===========================================================================

transform bn_load_u64(a: State<Bn256Ctx>, off: u32) -> u64 {
    return a.limbs[off];
}

transform bn_store_u64(r: State<Bn256Ctx>, off: u32, val: u64) {
    r.limbs[off] = val;
}

transform bn256_zero(a: State<Bn256Ctx>) {
    let i = 0;
    while i < BN256_LIMBS { a.limbs[i] = 0; i = i + 1; }
}

transform bn256_copy(r: State<Bn256Ctx>, a: State<Bn256Ctx>) {
    let i = 0;
    while i < BN256_LIMBS { r.limbs[i] = a.limbs[i]; i = i + 1; }
}

transform bn256_set_u32(r: State<Bn256Ctx>, v: u32) {
    bn256_zero(r);
    r.limbs[0] = v as u64;
}

transform bn256_is_zero(a: State<Bn256Ctx>) -> u32 {
    let i = 0;
    while i < BN256_LIMBS {
        if a.limbs[i] != 0 { return 0; }
        i = i + 1;
    }
    return 1;
}

// Three-way compare: returns 1 if a>b, 2 if a<b, 0 if equal.
// Uses u32 return type (not i32) to avoid VUMA codegen signed-comparison bug
// where `i32 >= 0` on a function-call result defaults to unsigned comparison.
transform bn256_cmp(a: State<Bn256Ctx>, b: State<Bn256Ctx>) -> u32 {
    let i: u32 = BN256_LIMBS - 1;
    while 1 == 1 {
        let av = a.limbs[i];
        let bv = b.limbs[i];
        if av > bv { return 1; }
        if av < bv { return 2; }
        if i == 0 { break; }
        i = i - 1;
    }
    return 0;
}

// r = a + b. Returns carry-out (0 or 1).
// Uses the careful carry check: sum < av catches overflow, sum == av with
// carry_in==1 propagates (covers the av + (2^64-1) + 1 wrap edge case).
transform bn256_add(r: State<Bn256Ctx>, a: State<Bn256Ctx>, b: State<Bn256Ctx>) -> u32 {
    let carry: u64 = 0;
    let i = 0;
    while i < BN256_LIMBS {
        let av = a.limbs[i];
        let bv = b.limbs[i];
        let sum: u64 = av + bv + carry;
        r.limbs[i] = sum;
        if sum < av { carry = 1; }
        else {
            if sum == av {
                if carry == 1 { carry = 1; } else { carry = 0; }
            } else { carry = 0; }
        }
        i = i + 1;
    }
    return carry as u32;
}

// r = a - b. Returns borrow-out (0 or 1).
transform bn256_sub(r: State<Bn256Ctx>, a: State<Bn256Ctx>, b: State<Bn256Ctx>) -> u32 {
    let borrow: u64 = 0;
    let i = 0;
    while i < BN256_LIMBS {
        let av = a.limbs[i];
        let bv = b.limbs[i];
        let diff: u64 = av - bv - borrow;
        r.limbs[i] = diff;
        if av < bv { borrow = 1; }
        else {
            if av == bv {
                if borrow == 1 { borrow = 1; } else { borrow = 0; }
            } else { borrow = 0; }
        }
        i = i + 1;
    }
    return borrow as u32;
}

// r = a + scalar (mod 2^256).
transform bn256_add_u32(r: State<Bn256Ctx>, a: State<Bn256Ctx>, scalar: u32) {
    let carry: u64 = scalar as u64;
    let i = 0;
    while i < BN256_LIMBS {
        let av = a.limbs[i];
        let sum: u64 = av + carry;
        r.limbs[i] = sum;
        if sum < av { carry = 1; } else { carry = 0; }
        i = i + 1;
    }
}

// r = a << 1. Returns the bit shifted out (0 or 1).
transform bn256_lshift1(r: State<Bn256Ctx>, a: State<Bn256Ctx>) -> u32 {
    let carry: u64 = 0;
    let i = 0;
    while i < BN256_LIMBS {
        let v = a.limbs[i];
        r.limbs[i] = (v << 1) | carry;
        carry = v >> 63;
        i = i + 1;
    }
    return carry as u32;
}

// r = a >> 1.
transform bn256_rshift1(r: State<Bn256Ctx>, a: State<Bn256Ctx>) {
    let i: u32 = BN256_LIMBS - 1;
    while i > 0 {
        let hi = a.limbs[i];
        let im1 = i - 1;
        let lo = a.limbs[im1];
        r.limbs[i] = (hi >> 1) | (lo << 63);
        i = i - 1;
    }
    let v0 = a.limbs[0];
    r.limbs[0] = v0 >> 1;
}

transform bn256_and(r: State<Bn256Ctx>, a: State<Bn256Ctx>, b: State<Bn256Ctx>) {
    let i = 0;
    while i < BN256_LIMBS {
        r.limbs[i] = a.limbs[i] & b.limbs[i];
        i = i + 1;
    }
}

transform bn256_or(r: State<Bn256Ctx>, a: State<Bn256Ctx>, b: State<Bn256Ctx>) {
    let i = 0;
    while i < BN256_LIMBS {
        r.limbs[i] = a.limbs[i] | b.limbs[i];
        i = i + 1;
    }
}

transform bn256_xor(r: State<Bn256Ctx>, a: State<Bn256Ctx>, b: State<Bn256Ctx>) {
    let i = 0;
    while i < BN256_LIMBS {
        r.limbs[i] = a.limbs[i] ^ b.limbs[i];
        i = i + 1;
    }
}

transform bn256_get_bit(a: State<Bn256Ctx>, bit: u32) -> u32 {
    let limb = bit / 64;
    let pos = bit % 64;
    if limb >= BN256_LIMBS { return 0; }
    let v = a.limbs[limb];
    return ((v >> pos) & 1) as u32;
}

transform bn256_bitlen(a: State<Bn256Ctx>) -> u32 {
    let i: u32 = BN256_LIMBS - 1;
    while 1 == 1 {
        let v = a.limbs[i];
        if v != 0 {
            let bits: u32 = 64;
            while bits > 0 {
                let b = bits - 1;
                if ((v >> b) & 1) == 1 { return i * 64 + bits; }
                bits = bits - 1;
            }
            return i * 64 + 1;
        }
        if i == 0 { break; }
        i = i - 1;
    }
    return 0;
}

// ===========================================================================
// 64x64 -> 128 multiplication (split into 32-bit halves so each partial
// product fits in u64). Writes low 64 bits to lo_out.limbs[0] and high
// 64 bits to hi_out.limbs[0].
// ===========================================================================

transform bn_mul_u64(a: u64, b: u64, lo_out: State<Bn64Ctx>, hi_out: State<Bn64Ctx>) {
    let a_lo: u64 = a & 4294967295;
    let a_hi: u64 = a >> 32;
    let b_lo: u64 = b & 4294967295;
    let b_hi: u64 = b >> 32;

    let ll: u64 = a_lo * b_lo;
    let lh: u64 = a_lo * b_hi;
    let hl: u64 = a_hi * b_lo;
    let hh: u64 = a_hi * b_hi;

    let mid: u64 = lh + hl;
    let mid_carry: u64 = 0;
    if mid < lh { mid_carry = 1; }

    let mid_lo: u64 = mid & 4294967295;
    let mid_hi: u64 = mid >> 32;

    let lo: u64 = ll + (mid_lo << 32);
    let lo_carry: u64 = 0;
    if lo < ll { lo_carry = 1; }

    let hi: u64 = hh + mid_hi + (mid_carry << 32) + lo_carry;

    lo_out.limbs[0] = lo;
    hi_out.limbs[0] = hi;
}

// ===========================================================================
// Schoolbook 4x4 -> 8 limb multiplication (512-bit result).
// r is a Bn512Ctx (8 limbs). r may not alias a or b.
// ===========================================================================

transform bn256_mul_512(r: State<Bn512Ctx>, a: State<Bn256Ctx>, b: State<Bn256Ctx>) {
    let i = 0;
    while i < 8 { r.limbs[i] = 0; i = i + 1; }

    let lo = state_new(Bn64Ctx);
    let hi = state_new(Bn64Ctx);

    let ai = 0;
    while ai < BN256_LIMBS {
        let bj = 0;
        while bj < BN256_LIMBS {
            let av = a.limbs[ai];
            let bv = b.limbs[bj];
            bn_mul_u64(av, bv, lo, hi);

            let idx = ai + bj;
            let carry: u64 = 0;

            // Add lo at limb idx, propagating carry into limb idx+1.
            let cur0 = r.limbs[idx];
            let addv0 = lo.limbs[0];
            let sum0: u64 = cur0 + addv0 + carry;
            r.limbs[idx] = sum0;
            if sum0 < cur0 { carry = 1; }
            else {
                if sum0 == cur0 {
                    // carry unchanged (propagates if was 1)
                } else { carry = 0; }
            }

            // Add hi at limb idx+1.
            let idx1 = idx + 1;
            let cur1 = r.limbs[idx1];
            let addv1 = hi.limbs[0];
            let sum1: u64 = cur1 + addv1 + carry;
            r.limbs[idx1] = sum1;
            if sum1 < cur1 { carry = 1; }
            else {
                if sum1 == cur1 {
                    // carry unchanged
                } else { carry = 0; }
            }

            // Rare further carry propagation.
            let k = 2;
            while carry != 0 {
                let idxk = idx + k;
                let curk = r.limbs[idxk];
                let sumk: u64 = curk + carry;
                r.limbs[idxk] = sumk;
                if sumk < curk { carry = 1; } else { carry = 0; }
                k = k + 1;
            }
            bj = bj + 1;
        }
        ai = ai + 1;
    }
    // lo, hi are arena-allocated, auto-freed on return.
}

// ===========================================================================
// 512 / 256 binary long division.
//   dividend:  Bn512Ctx (8 limbs, 512 bits)
//   divisor:   Bn256Ctx (4 limbs, 256 bits), must be non-zero
//   quotient:  Bn512Ctx (8 limbs, fits up to 512 bits)
//   remainder: Bn256Ctx (4 limbs, will be < divisor)
// ===========================================================================

transform bn256_divmod_512(dividend: State<Bn512Ctx>, divisor: State<Bn256Ctx>, quotient: State<Bn512Ctx>, remainder: State<Bn256Ctx>) {
    let i = 0;
    while i < 8 { quotient.limbs[i] = 0; i = i + 1; }
    bn256_zero(remainder);

    let bit: u32 = 512;
    while bit > 0 {
        bit = bit - 1;
        // r = (r << 1) | bit(bit of dividend)
        bn256_lshift1(remainder, remainder);
        let word = bit / 64;
        let pos = bit % 64;
        let d_word = dividend.limbs[word];
        let in_bit: u32 = ((d_word >> pos) & 1) as u32;
        if in_bit == 1 {
            let cur = remainder.limbs[0];
            remainder.limbs[0] = cur | 1;
        }
        // If r >= divisor, subtract and set quotient bit.
        if bn256_cmp(remainder, divisor) != 2 {
            bn256_sub(remainder, remainder, divisor);
            let q_word = bit / 64;
            let q_pos = bit % 64;
            let cur = quotient.limbs[q_word];
            quotient.limbs[q_word] = cur | (1 << q_pos);
        }
    }
}

// ===========================================================================
// Modular arithmetic (mod m), assumes a, b < m.
// ===========================================================================

transform bn256_mod_add(r: State<Bn256Ctx>, a: State<Bn256Ctx>, b: State<Bn256Ctx>, m: State<Bn256Ctx>) {
    let carry: u32 = bn256_add(r, a, b);
    if carry == 1 {
        bn256_sub(r, r, m);
    } else {
        if bn256_cmp(r, m) != 2 {
            bn256_sub(r, r, m);
        }
    }
}

transform bn256_mod_sub(r: State<Bn256Ctx>, a: State<Bn256Ctx>, b: State<Bn256Ctx>, m: State<Bn256Ctx>) {
    let borrow: u32 = bn256_sub(r, a, b);
    if borrow == 1 {
        bn256_add(r, r, m);
    }
}

// r = (a * b) mod m. a, b assumed < m.
transform bn256_mod_mul(r: State<Bn256Ctx>, a: State<Bn256Ctx>, b: State<Bn256Ctx>, m: State<Bn256Ctx>) {
    let prod = state_new(Bn512Ctx);
    let quot = state_new(Bn512Ctx);
    bn256_mul_512(prod, a, b);
    bn256_divmod_512(prod, m, quot, r);
}

// r = a mod m for any 256-bit a. Reduces via 512/256 long division by
// treating `a` as the low 256 bits of a zero-extended 512-bit dividend.
transform bn256_mod(r: State<Bn256Ctx>, a: State<Bn256Ctx>, m: State<Bn256Ctx>) {
    let prod = state_new(Bn512Ctx);
    let quot = state_new(Bn512Ctx);
    let i = 0;
    while i < 8 {
        if i < 4 { prod.limbs[i] = a.limbs[i]; }
        else { prod.limbs[i] = 0; }
        i = i + 1;
    }
    bn256_divmod_512(prod, m, quot, r);
}

// r = a^exp mod m via square-and-multiply (left-to-right, LSB-first scan).
// Uses Montgomery multiplication internally for ~100x speedup.
// Falls back to plain mod_mul if m is even (Montgomery requires odd modulus).
transform bn256_mod_exp(r: State<Bn256Ctx>, a: State<Bn256Ctx>, exp: State<Bn256Ctx>, m: State<Bn256Ctx>) {
    // Check if m is odd (required for Montgomery)
    if (m.limbs[0] & 1) == 0 {
        // Even modulus: fall back to slow path
        bn256_zero(r);
        r.limbs[0] = 1;
        let base = state_new(Bn256Ctx);
        bn256_mod(base, a, m);
        let bits: u32 = bn256_bitlen(exp);
        if bits == 0 { return; }
        let i = 0;
        while i < bits {
            if bn256_get_bit(exp, i) == 1 {
                let tmp = state_new(Bn256Ctx);
                bn256_mod_mul(tmp, r, base, m);
                bn256_copy(r, tmp);
            }
            let sq = state_new(Bn256Ctx);
            bn256_mod_mul(sq, base, base, m);
            bn256_copy(base, sq);
            i = i + 1;
        }
        return;
    }

    // Montgomery path: m is odd.
    // Precompute Montgomery context (one-time cost per mod_exp call).
    let m0_val: u64 = m.limbs[0];
    let mprime: u64 = bn256_mont_mu(m0_val);
    let r2 = state_new(Bn256Ctx);
    bn256_mont_r2(r2, m);

    // Convert base to Montgomery form: a_mont = a * R mod m = mont_mul(a, r2, m, mprime)
    let base_mont = state_new(Bn256Ctx);
    bn256_mod(base_mont, a, m);
    let base_m = state_new(Bn256Ctx);
    bn256_mont_mul(base_m, base_mont, r2, m, mprime);

    // result in Montgomery form starts as R mod m (= "1" in Montgomery form).
    // R mod m = mont_mul(1, r2, m, mprime).
    let one = state_new(Bn256Ctx);
    bn256_set_u32(one, 1);
    let res_m = state_new(Bn256Ctx);
    bn256_mont_mul(res_m, one, r2, m, mprime);

    let bits: u32 = bn256_bitlen(exp);
    if bits == 0 {
        // exp = 0, result = 1
        bn256_set_u32(r, 1);
        return;
    }

    let i = 0;
    while i < bits {
        if bn256_get_bit(exp, i) == 1 {
            let tmp = state_new(Bn256Ctx);
            bn256_mont_mul(tmp, res_m, base_m, m, mprime);
            bn256_copy(res_m, tmp);
        }
        let sq = state_new(Bn256Ctx);
        bn256_mont_mul(sq, base_m, base_m, m, mprime);
        bn256_copy(base_m, sq);
        i = i + 1;
    }

    // Convert result back from Montgomery form: r = res_m * R^(-1) mod m
    // = mont_mul(res_m, 1, m, mprime).
    bn256_mont_mul(r, res_m, one, m, mprime);
}

// ===========================================================================
// Montgomery multiplication (R = 2^256 for 4-limb 64-bit bignums).
// Requires m odd. ~100x faster than divmod-based mod_mul for repeated use.
// ===========================================================================

// Compute m' = -m^(-1) mod 2^64 via Newton's method.
// Input: m0 = low limb of modulus (must be odd).
// Returns: m' such that m0 * m' ≡ -1 (mod 2^64).
transform bn256_mont_mu(m0: u64) -> u64 {
    let y: u64 = 1;  // m0 is odd => m0*1 ≡ 1 (mod 2), correct starting guess
    let zero_u64: u64 = 0;
    let two_u64: u64 = 2;
    let i = 0;
    while i < 6 {
        // y = y * (2 - m0 * y) mod 2^64
        // m0 * y wraps to low 64 bits (which is all we need)
        let my: u64 = m0 * y;
        // 2 - my mod 2^64 = (0 - my) + 2 (handles wraparound)
        let neg_my: u64 = zero_u64 - my;
        let t: u64 = neg_my + two_u64;
        y = y * t;
        i = i + 1;
    }
    // m' = -y mod 2^64
    return zero_u64 - y;
}

// Compute R^2 mod m where R = 2^256.
// R^2 = 2^512. We compute 2^512 mod m via bn256_divmod_512.
// This is a one-time cost per modulus.
transform bn256_mont_r2(r: State<Bn256Ctx>, m: State<Bn256Ctx>) {
    // 2^512 = Bn512Ctx with limb[7] = 1, rest 0... wait, 2^512 is bit 512,
    // which is beyond 8 limbs (8*64 = 512 bits, indices 0..511).
    // 2^512 doesn't fit in Bn512Ctx! We need 2^512 mod m.
    // Trick: 2^256 mod m first (via 2^256 = Bn512Ctx with limb[4]=1), then
    // square it mod m. But squaring needs mod_mul which is what we're optimizing.
    // Alternative: compute 2^512 mod m by doubling 256 times from 1.
    // That's 256 iterations of mod_add — cheap.
    bn256_zero(r);
    r.limbs[0] = 1;  // r = 1
    let i = 0;
    while i < 512 {
        // r = (r * 2) mod m = r + r mod m
        let carry: u32 = bn256_lshift1(r, r);
        if carry == 1 {
            // r wrapped (>= 2^256), which means r >= m (since m < 2^256), subtract m
            bn256_sub(r, r, m);
        } else {
            if bn256_cmp(r, m) != 2 {
                bn256_sub(r, r, m);
            }
        }
        i = i + 1;
    }
}

// Montgomery reduction: r = t * R^(-1) mod m, where t is 512-bit (Bn512Ctx),
// m is 256-bit (4 limbs, odd), mprime = -m^(-1) mod 2^64.
// t is destroyed (modified in place). Result r < m.
transform bn256_mont_reduce(r: State<Bn256Ctx>, t: State<Bn512Ctx>, m: State<Bn256Ctx>, mprime: u64) {
    let lo = state_new(Bn64Ctx);
    let hi = state_new(Bn64Ctx);
    let overflow: u64 = 0;

    let i = 0;
    while i < 4 {
        // q = mprime * t[i] mod 2^64 (wraps, giving low 64 bits)
        let ti: u64 = t.limbs[i];
        let q: u64 = mprime * ti;

        // t[i..i+4] += q * m[0..3]
        let C_lo: u64 = 0;
        let C_hi: u64 = 0;  // extra bit: C can be up to 2^64+2, split into (C_lo, C_hi)
        let j = 0;
        while j < 4 {
            let mj: u64 = m.limbs[j];
            bn_mul_u64(q, mj, lo, hi);
            let prod_lo: u64 = lo.limbs[0];
            let prod_hi: u64 = hi.limbs[0];

            let idx = i + j;
            let cur: u64 = t.limbs[idx];

            // sum = cur + prod_lo + C_lo + C_hi (4-way add with carry)
            let s1: u64 = cur + prod_lo;
            let c1: u64 = 0;
            if s1 < cur { c1 = 1; }
            let s2: u64 = s1 + C_lo;
            let c2: u64 = 0;
            if s2 < s1 { c2 = 1; }
            let s3: u64 = s2 + C_hi;
            let c3: u64 = 0;
            if s3 < s2 { c3 = 1; }

            t.limbs[idx] = s3;

            // carry from 3-way addition = c1 + c2 + c3 (max 3)
            let carry_add: u64 = c1 + c2 + c3;

            // New C = prod_hi + carry_add (max 2^64-1 + 3 = 2^64+2)
            let new_C_lo: u64 = prod_hi + carry_add;
            let new_C_hi: u64 = 0;
            if new_C_lo < prod_hi { new_C_hi = 1; }
            // Also handle case where prod_hi + carry_add overflows twice:
            // carry_add <= 3, so prod_hi + carry_add < 2^64 + 3, at most 1 overflow.

            C_lo = new_C_lo;
            C_hi = new_C_hi;

            j = j + 1;
        }

        // Propagate C into t[i+4] and upward
        let idx4 = i + 4;
        let cur4: u64 = t.limbs[idx4];
        let s1: u64 = cur4 + C_lo;
        let c1: u64 = 0;
        if s1 < cur4 { c1 = 1; }
        let s2: u64 = s1 + C_hi;
        let c2: u64 = 0;
        if s2 < s1 { c2 = 1; }
        t.limbs[idx4] = s2;
        let carry: u64 = c1 + c2;

        // Propagate carry upward through t[i+5], t[i+6], ...
        let k = 1;
        while carry != 0 {
            let idxk = idx4 + k;
            if idxk >= 8 {
                // Overflow beyond t[7]: add to overflow flag.
                // REDC invariant guarantees total overflow <= 1 for input t < m*R.
                overflow = overflow + carry;
                break;
            }
            let curk: u64 = t.limbs[idxk];
            let sumk: u64 = curk + carry;
            t.limbs[idxk] = sumk;
            if sumk < curk { carry = 1; } else { carry = 0; }
            k = k + 1;
        }

        i = i + 1;
    }

    // Result is in t[4..7] (+ overflow * 2^256).
    // REDC guarantees: overflow * 2^256 + t[4..7] < 2m, so at most 1 conditional subtract.
    r.limbs[0] = t.limbs[4];
    r.limbs[1] = t.limbs[5];
    r.limbs[2] = t.limbs[6];
    r.limbs[3] = t.limbs[7];

    // Precompute -m mod 2^256 = 2^256 - m (two's complement) for overflow case.
    // Used when overflow != 0: (r + 2^256) - m = r + (2^256 - m).
    if overflow != 0 {
        let neg_m = state_new(Bn256Ctx);
        let zero = state_new(Bn256Ctx);
        bn256_zero(zero);
        bn256_sub(neg_m, zero, m);  // neg_m = 0 - m = 2^256 - m (borrow ignored)
        // Subtract m for each unit of overflow (each adds 2^256 to the result).
        // After subtraction, result < m if overflow was the only excess.
        let oi = 0;
        while oi < overflow {
            bn256_add(r, r, neg_m);  // r = r + (2^256 - m) = (r + 2^256) - m, wraps correctly
            oi = oi + 1;
        }
    }
    // Final conditional subtract (covers overflow == 0 case, and safety for overflow > 1).
    if bn256_cmp(r, m) != 2 {
        bn256_sub(r, r, m);
    }
}

// Montgomery multiplication: r = a * b * R^(-1) mod m.
// a, b should be < m. m must be odd. mprime = bn256_mont_mu(m.limbs[0]).
transform bn256_mont_mul(r: State<Bn256Ctx>, a: State<Bn256Ctx>, b: State<Bn256Ctx>, m: State<Bn256Ctx>, mprime: u64) {
    let prod = state_new(Bn512Ctx);
    bn256_mul_512(prod, a, b);
    bn256_mont_reduce(r, prod, m, mprime);
}

// ===========================================================================
// Binary GCD: r = gcd(a, b). Inputs are 256-bit unsigned.
// ===========================================================================

transform bn256_gcd(r: State<Bn256Ctx>, a: State<Bn256Ctx>, b: State<Bn256Ctx>) {
    let u = state_new(Bn256Ctx);
    let v = state_new(Bn256Ctx);
    bn256_copy(u, a);
    bn256_copy(v, b);

    let shift: u32 = 0;
    while (bn256_get_bit(u, 0) == 0) && (bn256_get_bit(v, 0) == 0) {
        bn256_rshift1(u, u);
        bn256_rshift1(v, v);
        shift = shift + 1;
    }
    // Now at least one of u, v is odd. Strip remaining factors of 2 from u.
    while bn256_get_bit(u, 0) == 0 {
        bn256_rshift1(u, u);
    }
    while bn256_is_zero(v) == 0 {
        while bn256_get_bit(v, 0) == 0 {
            bn256_rshift1(v, v);
        }
        if bn256_cmp(u, v) != 2 {
            bn256_sub(u, u, v);
        } else {
            bn256_sub(v, v, u);
            let t = state_new(Bn256Ctx);
            bn256_copy(t, u);
            bn256_copy(u, v);
            bn256_copy(v, t);
        }
    }
    bn256_copy(r, u);
    let s: u32 = 0;
    while s < shift {
        bn256_lshift1(r, r);
        s = s + 1;
    }
}

// ===========================================================================
// Modular inverse via binary extended GCD.
// Computes r = a^(-1) mod m. Requires m odd (typical for crypto primes)
// and gcd(a, m) = 1. If gcd != 1 the result is undefined.
// ===========================================================================

transform bn256_mod_inv(r: State<Bn256Ctx>, a: State<Bn256Ctx>, m: State<Bn256Ctx>) {
    let u = state_new(Bn256Ctx);
    let v = state_new(Bn256Ctx);
    let x1 = state_new(Bn256Ctx);
    let x2 = state_new(Bn256Ctx);
    let one = state_new(Bn256Ctx);

    bn256_copy(u, a);
    bn256_copy(v, m);
    bn256_set_u32(x1, 1);
    bn256_zero(x2);
    bn256_set_u32(one, 1);

    // Binary extended GCD: terminate when u==1 (result=x1) or v==1 (result=x2).
    while bn256_is_zero(u) == 0 {
        // Check termination: if u == 1, result is x1
        if bn256_cmp(u, one) == 0 { break; }
        // If v == 1, result is x2 — copy to x1 for final mod
        if bn256_cmp(v, one) == 0 { bn256_copy(x1, x2); break; }
        // Strip factors of 2 from u; x1 follows accordingly mod m.
        while bn256_get_bit(u, 0) == 0 {
            bn256_rshift1(u, u);
            if bn256_get_bit(x1, 0) == 0 {
                bn256_rshift1(x1, x1);
            } else {
                // x1 = (x1 + m) / 2 ; (x1 + m) is even because both are odd
                bn256_add(x1, x1, m);
                bn256_rshift1(x1, x1);
            }
        }
        // Strip factors of 2 from v; x2 follows accordingly mod m.
        while bn256_get_bit(v, 0) == 0 {
            bn256_rshift1(v, v);
            if bn256_get_bit(x2, 0) == 0 {
                bn256_rshift1(x2, x2);
            } else {
                bn256_add(x2, x2, m);
                bn256_rshift1(x2, x2);
            }
        }
        // Now u, v both odd. Reduce the larger.
        if bn256_cmp(u, v) != 2 {
            bn256_sub(u, u, v);
            bn256_mod_sub(x1, x1, x2, m);
        } else {
            bn256_sub(v, v, u);
            bn256_mod_sub(x2, x2, x1, m);
        }
    }
    // Result is x1 mod m.
    bn256_mod(r, x1, m);
}
