// ============================================================================
// womb/ui/render/gpu_dispatch.vuma — GPU host import declarations
// ============================================================================
// This module declares the extern "C" functions that VUMA programs call
// to dispatch GPU work. The implementations live in the C host runtime:
//   - Linux/Windows: womb/ui/render/host/gpu_vulkan.c (wraps libvulkan.so)
//   - macOS:         womb/ui/render/host/gpu_metal.m  (wraps Metal framework)
//                    womb/ui/render/host/gpu_mps.m    (wraps Metal Performance Shaders)
//
// Per ADR-0022, these are "Wrap" decisions — the GPU APIs are OS-provided
// and wrapped by a thin C shim. No Rust GPU crates (wgpu, gfx-rs, etc.).
//
// The VUMA program passes SPIR-V bytecode (embedded as a const byte array
// via V-26 Phase 2) to vk_create_compute_pipeline_spirv, which creates a
// Vulkan compute pipeline. The program then binds the pipeline, binds
// buffers/uniforms, and dispatches compute work.
//
// All functions return 0 on success, non-zero on error (Vulkan VkResult
// or Metal NSError code). The VUMA program checks the return value and
// can exit/trap on GPU errors.
//
// Naming convention:
//   vk_*  — Vulkan functions (Linux/Windows, and macOS via MoltenVK)
//   mtl_* — native Metal functions (macOS only, no MoltenVK)
//   mps_* — Metal Performance Shaders functions (macOS only)
// ============================================================================

extern "C" {
    // =========================================================================
    // Vulkan: Instance + Device setup
    // =========================================================================

    // Create a Vulkan instance (headless, no surface). Returns the VkInstance
    // handle (as Address) or NULL on failure. The instance is owned by the
    // host runtime — the VUMA program does not destroy it.
    transform vk_create_instance() -> Address;

    // Pick the first physical device with compute support. Returns the
    // VkPhysicalDevice handle or NULL on failure.
    transform vk_pick_physical_device(instance: Address) -> Address;

    // Create a logical device with one compute queue. Returns the VkDevice
    // handle or NULL. The queue family index and queue handle are returned
    // via out-params (queue_family: *u32, queue: *Address).
    transform vk_create_logical_device(
        phys_device: Address,
        queue_family: Address,  // out: *u32
        queue: Address           // out: *Address
    ) -> Address;

    // =========================================================================
    // Vulkan: Compute pipeline creation (from SPIR-V bytecode)
    // =========================================================================

    // Create a compute pipeline from SPIR-V bytecode embedded in the VUMA
    // binary's .rodata section. The spirv parameter is the address of the
    // const byte array (e.g. &TRIANGLE_FILL_SPIRV), spirv_len is its length.
    // Returns the VkPipeline handle (as i64) or 0 on failure.
    //
    // The pipeline is created with:
    //   - 0 push constants (use uniform buffers instead)
    //   - 1 descriptor set layout (set 0) with bindings 0..N
    //   - Layout bindings are inferred from the SPIR-V reflection
    //     (performed by the host runtime via spirv-cross reflection)
    transform vk_create_compute_pipeline_spirv(
        device: Address,
        spirv: Address,
        spirv_len: i64
    ) -> i64;

    // =========================================================================
    // Vulkan: Command buffer recording + dispatch
    // =========================================================================

    // Create a command pool + allocate a primary command buffer.
    // Returns the VkCommandBuffer handle or NULL.
    transform vk_create_command_buffer(device: Address, queue_family: u32) -> Address;

    // Begin command buffer recording.
    transform vk_cmd_begin(cmd: Address) -> i32;

    // Bind a compute pipeline.
    transform vk_cmd_bind_pipeline(cmd: Address, pipeline: i64) -> i32;

    // Bind a uniform buffer to (set=0, binding=N).
    transform vk_cmd_bind_uniform_buffer(
        cmd: Address,
        device: Address,
        binding: u32,
        data: Address,
        size: u64
    ) -> i32;

    // Bind a storage image to (set=0, binding=N). The image is a 2D
    // rgba8ui image of the given width/height, created by the host.
    transform vk_cmd_bind_storage_image(
        cmd: Address,
        device: Address,
        binding: u32,
        width: u32,
        height: u32
    ) -> i32;

    // Dispatch compute work. (x, y, z) are the workgroup counts.
    transform vk_cmd_dispatch(cmd: Address, x: u32, y: u32, z: u32) -> i32;

    // End command buffer recording.
    transform vk_cmd_end(cmd: Address) -> i32;

    // Submit the command buffer to the compute queue and wait for completion.
    transform vk_queue_submit_and_wait(queue: Address, cmd: Address) -> i32;

    // =========================================================================
    // Vulkan: Image readback (for testing / screenshot)
    // =========================================================================

    // Read back a storage image's pixels into a host buffer. The buffer must
    // be at least width * height * 4 bytes (rgba8ui). Returns 0 on success.
    transform vk_read_image(
        device: Address,
        cmd: Address,
        queue: Address,
        binding: u32,
        width: u32,
        height: u32,
        out_buffer: Address  // *u8, width*height*4 bytes
    ) -> i32;

    // =========================================================================
    // Vulkan: Cleanup
    // =========================================================================

    // Destroy a compute pipeline.
    transform vk_destroy_pipeline(device: Address, pipeline: i64);

    // Destroy a command buffer + pool.
    transform vk_destroy_command_buffer(device: Address, cmd: Address);

    // Destroy the logical device.
    transform vk_destroy_device(device: Address);

    // Destroy the instance.
    transform vk_destroy_instance(instance: Address);
}

// =========================================================================
// Metal: Native macOS compute pipeline (no MoltenVK, per ADR-0022)
// =========================================================================
// The Metal path uses .metallib bytecode (cross-compiled from SPIR-V via
// spirv-cross --msl, then compiled by xcrun metal). The VUMA program
// passes the .metallib bytes (embedded as a const byte array via V-26
// Phase 2) to mtl_create_compute_pipeline.

extern "C" {
    // Create the Metal device + command queue. Returns the MTLDevice handle.
    transform mtl_create_device() -> Address;

    // Create a compute pipeline from Metal library bytecode (.metallib).
    // The metallib_data parameter is the address of the const byte array,
    // metallib_len is its length. Returns the pipeline handle (i64) or 0.
    transform mtl_create_compute_pipeline(
        device: Address,
        metallib_data: Address,
        metallib_len: i64
    ) -> i64;

    // Create a command buffer.
    transform mtl_create_command_buffer() -> Address;

    // Bind a compute pipeline (creates a compute command encoder).
    transform mtl_cmd_bind_pipeline(cmd: Address, pipeline: i64) -> i32;

    // Bind a uniform buffer to the given index.
    transform mtl_cmd_bind_uniform_buffer(
        cmd: Address,
        binding: u32,
        data: Address,
        size: u64
    ) -> i32;

    // Bind a storage texture (2D RGBA8Uint) to the given index.
    transform mtl_cmd_bind_storage_texture(
        cmd: Address,
        device: Address,
        binding: u32,
        width: u32,
        height: u32
    ) -> i32;

    // Dispatch compute work. (x, y, z) are the threadgroup counts.
    // Threadgroup size is hardcoded to 16x16x1 (matches GLSL local_size).
    transform mtl_cmd_dispatch(cmd: Address, x: u32, y: u32, z: u32) -> i32;

    // Submit + wait for completion.
    transform mtl_queue_submit_and_wait(cmd: Address) -> i32;

    // Read back a texture's pixels (stub — needs texture caching).
    transform mtl_read_texture(
        cmd: Address,
        binding: u32,
        width: u32,
        height: u32,
        out_buffer: Address
    ) -> i32;

    // Cleanup.
    transform mtl_destroy_pipeline(pipeline: i64);
    transform mtl_destroy_device();
}

// =========================================================================
// MPS: Metal Performance Shaders (macOS only)
// =========================================================================
// MPS provides pre-built, highly-optimized GPU kernels for common
// operations: matrix multiply, convolution, image processing, ray
// tracing, and linear algebra. Useful for 3D rendering where a custom
// shader isn't needed (e.g., transform hierarchy matrix multiply, image
// filters, ray-triangle intersection for ray tracing).

extern "C" {
    // Create the MPS device (shares the Metal device).
    transform mps_create_device() -> Address;

    // Matrix multiply: C = alpha * A * B + beta * C.
    // A is M×K, B is K×N, C is M×N. All row-major f32.
    // Uses MPSMatrixMultiplication (tensor cores on Apple Silicon).
    transform mps_matrix_multiply(
        device: Address,
        cmd_queue: Address,
        M: u32, K: u32, N: u32,
        alpha: f32,
        matrix_a: Address,
        matrix_b: Address,
        beta: f32,
        matrix_c: Address
    ) -> i32;

    // Image Gaussian blur (RGBA8 texture).
    transform mps_image_gaussian_blur(
        device: Address,
        cmd_queue: Address,
        src_texture: Address,
        dst_texture: Address,
        sigma: f32
    ) -> i32;

    // Ray-triangle intersection (for 3D ray tracing).
    // Tests ray_count rays against triangle_count triangles.
    // Uses MPSRayIntersector (dedicated ray-tracing hardware on M1+).
    transform mps_ray_intersect(
        device: Address,
        cmd_queue: Address,
        ray_count: u32,
        ray_data: Address,
        triangle_count: u32,
        triangle_data: Address,
        intersection_data: Address
    ) -> i32;

    // Matrix LU decomposition (for solving linear systems).
    transform mps_matrix_decompose_lu(
        device: Address,
        cmd_queue: Address,
        M: u32,
        matrix: Address,
        pivot: Address
    ) -> i32;
}

// =========================================================================
// Vulkan: Graphics Pipeline (3D mesh rendering with vertex/fragment shaders)
// =========================================================================
// These functions enable 3D mesh rendering with vertex + fragment shaders,
// depth testing, and texture sampling. Separate from the compute pipeline.

extern "C" {
    // Create a render pass with a color attachment (R8G8B8A8_UNORM) and
    // a depth attachment (D32_SFLOAT). Also creates the color + depth
    // images + framebuffer. Returns the VkRenderPass handle (as i64).
    transform vk_create_render_pass(
        device: Address,
        width: u32,
        height: u32
    ) -> i64;

    // Create a graphics pipeline from vertex + fragment SPIR-V bytecode.
    // Vertex input: location 0 = vec3 position (offset 0), location 1 = vec2 tex_coord (offset 16), stride 32.
    // Descriptor set: binding 0 = uniform buffer (MVP), binding 1 = combined image sampler (texture).
    // Depth test: enabled, LESS compare. Cull mode: BACK. Front face: CLOCKWISE.
    transform vk_create_graphics_pipeline(
        device: Address,
        spirv_vert: Address,
        vert_len: i64,
        spirv_frag: Address,
        frag_len: i64
    ) -> i64;

    // Begin the render pass (clears color to black, depth to 1.0).
    transform vk_cmd_begin_render_pass(cmd: Address, render_pass: i64) -> i32;

    // Bind the graphics pipeline.
    transform vk_cmd_bind_gfx_pipeline(cmd: Address, pipeline: i64) -> i32;

    // Bind a vertex buffer (uploaded from host data) to binding 0.
    transform vk_cmd_bind_vertex_buffer(
        cmd: Address,
        device: Address,
        vertex_data: Address,
        vertex_size: u64
    ) -> i32;

    // Bind an index buffer (u32 indices, uploaded from host data).
    transform vk_cmd_bind_index_buffer(
        cmd: Address,
        device: Address,
        index_data: Address,
        index_size: u64
    ) -> i32;

    // Bind a uniform buffer (MVP matrix) to the graphics descriptor set.
    transform vk_cmd_bind_gfx_uniform_buffer(
        cmd: Address,
        device: Address,
        binding: u32,
        data: Address,
        size: u64
    ) -> i32;

    // Draw indexed: index_count vertices, 1 instance.
    transform vk_cmd_draw_indexed(
        cmd: Address,
        index_count: u32,
        instance_count: u32,
        first_index: u32,
        vertex_offset: i32,
        first_instance: u32
    ) -> i32;

    // End the render pass.
    transform vk_cmd_end_render_pass(cmd: Address) -> i32;

    // Read back the color attachment into a host buffer (for testing).
    transform vk_read_color_image(
        device: Address,
        cmd: Address,
        queue: Address,
        width: u32,
        height: u32,
        out_buffer: Address
    ) -> i32;
}

// =========================================================================
// Vulkan: Texture Support
// =========================================================================

extern "C" {
    // Create a 2D RGBA8 texture from host data. Creates the image + view +
    // sampler (linear filtering, repeat addressing). Returns 1 on success.
    transform vk_create_texture_2d(
        device: Address,
        tex_data: Address,
        width: u32,
        height: u32,
        data_size: u64
    ) -> i32;

    // Bind the texture (combined image sampler) to the graphics descriptor
    // set's binding slot.
    transform vk_cmd_bind_texture(
        cmd: Address,
        device: Address,
        binding: u32
    ) -> i32;
}

// =========================================================================
// Vulkan: Async Dispatch (fences for CPU/GPU pipelining)
// =========================================================================

extern "C" {
    // Submit a command buffer WITHOUT waiting. Returns a fence handle
    // (as i64) that can be waited on via vk_wait_fence.
    transform vk_queue_submit_async(queue: Address, cmd: Address) -> i64;

    // Wait for a fence to be signaled (GPU finished). Returns 0 on success.
    transform vk_wait_fence(fence: i64, timeout_ns: u64) -> i32;
}

// =========================================================================
// Vulkan: Swapchain + Surface (W2-A, W2-B)
// =========================================================================
// Window surface creation (VK_EXT_headless_surface for CI, VK_KHR_xcb_surface
// for real Linux windowing) + VK_KHR_swapchain for presentation. These enable
// multi-frame pipelined rendering (see W2-C FrameLoop in gpu_vulkan.c).

extern "C" {
    // Create a Vulkan instance with the given instance extensions enabled.
    // Pass ["VK_KHR_surface", "VK_EXT_headless_surface"] for swapchain support.
    // The instance handle is also stored in the shim's global state.
    transform vk_create_instance_ext(
        ext_names: Address,   // *const *const u8
        ext_count: u32
    ) -> Address;

    // Create a logical device with the given device extensions enabled and an
    // EXPLICIT queue family index. Pass ["VK_KHR_swapchain"] + the queue family
    // returned by vk_find_present_queue_family for swapchain support.
    transform vk_create_logical_device_ext(
        phys_device: Address,
        ext_names: Address,   // *const *const u8
        ext_count: u32,
        queue_family: u32,
        queue_family_out: Address,  // *u32
        queue_out: Address          // *Address
    ) -> Address;

    // Create a VkSurfaceKHR via VK_EXT_headless_surface (no display needed).
    // `width`/`height` are advisory (the swapchain specifies the actual extent).
    // Returns VkResult (0 = VK_SUCCESS).
    transform vk_create_headless_surface(
        instance: Address,
        phys_dev: Address,
        width: u32,
        height: u32,
        out_surface: Address   // *VkSurfaceKHR (i64 handle)
    ) -> i32;

    // Create a VkSurfaceKHR from an XCB connection + window (Linux X11).
    // Future use — requires a running X server. The headless surface is
    // sufficient for testing.
    transform vk_create_xcb_surface(
        instance: Address,
        connection: Address,  // xcb_connection_t*
        window: u32,          // xcb_window_t
        out_surface: Address  // *VkSurfaceKHR
    ) -> i32;

    // Find the first queue family that supports BOTH graphics AND presentation
    // to the given surface. Returns 0xFFFFFFFF if none found.
    transform vk_find_present_queue_family(
        phys_dev: Address,
        surface: i64
    ) -> u32;

    // Create a swapchain on the given surface. Picks VK_FORMAT_R8G8B8A8_UNORM
    // + SRGB_NONLINEAR if available, else the first surface format. Uses FIFO
    // present mode (vsync, always supported). Image count is clamped to surface
    // limits with a minimum of 2. Returns VkResult (0 = VK_SUCCESS).
    transform vk_create_swapchain(
        device: Address,
        phys_dev: Address,
        surface: i64,
        width: u32,
        height: u32,
        out_swapchain: Address  // *VkSwapchainKHR (i64 handle)
    ) -> i32;

    // Query swapchain images. If out_images is NULL, writes the count to
    // *out_count. Otherwise copies up to *out_count image handles into
    // out_images and updates *out_count.
    transform vk_get_swapchain_images(
        device: Address,
        swapchain: i64,
        out_count: Address,    // *u32
        out_images: Address    // *VkImage, or NULL
    ) -> i32;

    // Acquire the next available swapchain image. May signal a semaphore
    // and/or fence when the image is ready. Returns VK_SUCCESS or
    // VK_SUBOPTIMAL_KHR (5) on success.
    transform vk_acquire_next_image(
        device: Address,
        swapchain: i64,
        timeout: u64,
        semaphore: i64,
        fence: i64,
        out_index: Address     // *u32
    ) -> i32;

    // Present an acquired swapchain image. Optionally waits on a semaphore
    // before presenting (typically the render-finished semaphore).
    transform vk_present(
        queue: Address,
        swapchain: i64,
        image_index: u32,
        wait_semaphore: i64
    ) -> i32;

    // Destroy a swapchain (does not destroy the surface).
    transform vk_destroy_swapchain(device: Address, swapchain: i64);

    // Destroy a VkSurfaceKHR.
    transform vk_destroy_surface(instance: Address, surface: i64);
}

// =========================================================================
// Metal: Graphics Pipeline (3D mesh rendering, macOS)
// =========================================================================

extern "C" {
    // Create a render pipeline from metallib bytecode.
    // Sets up vertex + fragment functions, vertex descriptor (vec3 pos +
    // vec2 tex_coord, stride 32), color format RGBA8Unorm, depth format
    // Depth32Float. Creates the depth texture.
    transform mtl_create_render_pipeline(
        device: Address,
        metallib_data: Address,
        metallib_len: i64,
        width: u32,
        height: u32
    ) -> i64;

    // Begin a render pass with color + depth attachments.
    transform mtl_cmd_begin_render_pass(
        cmd: Address,
        color_texture: Address,
        width: u32,
        height: u32
    ) -> i32;

    // Bind the render pipeline.
    transform mtl_cmd_bind_render_pipeline(cmd: Address, pipeline: i64) -> i32;

    // Bind a vertex buffer to the render encoder.
    transform mtl_cmd_bind_vertex_buffer_gfx(
        cmd: Address,
        device: Address,
        vertex_data: Address,
        vertex_size: u64,
        buffer_index: u32
    ) -> i32;

    // Bind a uniform buffer (MVP) to both vertex + fragment stages.
    transform mtl_cmd_bind_gfx_uniform_buffer(
        cmd: Address,
        device: Address,
        binding: u32,
        data: Address,
        size: u64
    ) -> i32;

    // Create a 2D RGBA8 texture from host data.
    transform mtl_create_texture(
        device: Address,
        tex_data: Address,
        width: u32,
        height: u32
    ) -> Address;

    // Bind a texture to the fragment shader.
    transform mtl_cmd_bind_texture_gfx(
        cmd: Address,
        texture: Address,
        index: u32
    ) -> i32;

    // Draw indexed triangles.
    transform mtl_cmd_draw_indexed(
        cmd: Address,
        device: Address,
        index_data: Address,
        index_size: u64,
        index_count: u32
    ) -> i32;

    // End the render pass.
    transform mtl_cmd_end_render_pass(cmd: Address) -> i32;
}
