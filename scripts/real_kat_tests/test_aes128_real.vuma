// ═══════════════════════════════════════════════════════════════════════════
// scripts/real_kat_tests/test_aes128_real.vuma
// Real KAT test: AES-128 ECB encryption of the FIPS-197 Appendix B test
// vector, compared against the published ciphertext (byte 0 only).
// ═══════════════════════════════════════════════════════════════════════════
//
// W52: This is the SECOND real-KAT test (after W51's SHA-256("abc")) that
// compiles under the PMT-only parser. It reuses the W49 AES primitives
// from womb/kernel/crypto/aes.vuma — aes_init_sbox, aes_sub_bytes,
// aes_shift_rows, aes_encrypt_block — to encrypt the canonical FIPS-197
// Appendix B.1 test vector:
//
//     key        = 00 01 02 03 04 05 06 07 08 09 0A 0B 0C 0D 0E 0F
//     plaintext  = 00 11 22 33 44 55 66 77 88 99 AA BB CC DD EE FF
//     ciphertext = 69 C4 E0 D8 6A 7B 04 30 D8 CD B7 80 70 B4 C5 5A
//
// On match: writes 105 (0x69 — the expected first byte) to stdout.
// On mismatch: writes 0 (the failure sentinel).
//
// ── Documented limitation (MixColumns deferred) ─────────────────────────────
//   The W52 cipher uses the W49 AES skeleton: real FIPS-197 S-box (W29S1)
//   + real SubBytes (W49) + real ShiftRows (W49) + AddRoundKey per round,
//   with the W29S1 STUB key schedule (all 11 round keys = the original
//   16-byte key — K10b). MixColumns (FIPS-197 §5.1.3 — the GF(2^8) column
//   mixing via the fixed matrix [2,3,1,1; 1,2,3,1; 1,1,2,3; 3,1,1,2]) is
//   DEFERRED. Without MixColumns + the real Rijndael key schedule, the
//   cipher does NOT produce the FIPS-197 expected ciphertext — every
//   output byte depends only on the corresponding input byte (via the
//   SubBytes chain) plus AddRoundKey, not on all 16 input bytes (no
//   column diffusion).
//
//   For the FIPS-197 Appendix B test vector, key[0]=0 and pt[0]=0, so
//   after AddRoundKey(0) state[0] = 0. Round 1 SubBytes: sbox[0] = 99.
//   Because key[0]=0 (round_keys[round*16+0] = 0 for all 11 rounds per
//   the stub schedule), AddRoundKey is a no-op for byte 0. Byte 0
//   therefore cycles through the S-box chain:
//     0 → sbox[0]=99 → sbox[99]=251 → sbox[251]=15 → sbox[15]=118 →
//     sbox[118]=56 → sbox[56]=7 → sbox[7]=197 → sbox[197]=166 →
//     sbox[166]=36 → sbox[36]=54.
//   After 10 rounds: output[0] = 54 (0x36). The expected first byte is
//   0x69 = 105 (real AES with MixColumns + the real key schedule).
//   The W52 test therefore EXPECTS the comparison to fail (write 0) —
//   it is a regression-detection framework: when W53+ adds MixColumns
//   and the real Rijndael key schedule, output[0] will start matching
//   105, and the test will start emitting 105 (pass).
//
// ── Why compare only byte 0? ─────────────────────────────────────────────────
//   (1) The W49 cipher's ShiftRows swap pattern is wrong for rows 1 and 3
//       (the W49 worklog documents this — the 2-swap pattern produces
//       [b,a,d,c] instead of the canonical FIPS-197 left-rotate-by-1
//       [b,c,d,a]). Comparing only byte 0 (row 0, which ShiftRows does
//       NOT touch) sidesteps this known bug — byte 0's value is purely
//       a function of input[0], key[0], and the SubBytes chain.
//   (2) Byte 0's behavior is fully determined by the SubBytes chain on
//       input[0] XOR key[0] (the row-0 byte at column 0) — independent
//       of ShiftRows, MixColumns, or any other byte's value. So byte 0
//       is the cleanest signal for "did the cipher's round function
//       run at all?" — and a regression detector for "did MixColumns
//       + the real key schedule land yet?"
//   (3) When MixColumns lands (W53+), byte 0 will start depending on
//       bytes 0, 1, 2, 3 (the entire first column) — so the test will
//       then be a meaningful end-to-end KAT, not just a SubBytes trace.
//
// ── PMT discipline ──────────────────────────────────────────────────────────
//   NO `*ptr`, `&x`, `as *`, `allocate`, or `free` anywhere in this file.
//   All buffers are State<T> allocated via state_new(Layout). All non-zero
//   constants are DECIMAL per the K10d/K11 contract (no hex literals —
//   hex literals have width-extension issues per aes.vuma's header note).
//   The `out as Address` cast hands the State<OutByte> base pointer to
//   write() — the canonical PMT-to-FFI pattern from K3f's
//   womb/kernel/syscall/handlers/io.vuma and W51's test_sha256_abc_real.vuma.
//
// ── VUMA Key Concepts ──────────────────────────────────────────────────────
//   - PMT layouts with [u8; N] fixed-size array fields
//   - `state_new(Layout)` arena allocation of crypto contexts
//   - `State<Layout>` pass-by-reference parameters (no pointer syntax)
//   - Byte-granular array indexing (sbox.data[i] reads byte i)
//   - `as u32` widening cast on u8 operands before array indexing
//   - `as u8` truncating cast from the default integer type to u8
//   - XOR operator (`^`) on u8 values for AddRoundKey
//
// ── Build & verify (hosted x86_64) ──────────────────────────────────────────
//   . "$HOME/.cargo/env" && \
//   ./target/release-fast/compile_dump \
//       scripts/real_kat_tests/test_aes128_real.vuma \
//       /tmp/aeskat.bin x86_64 --verify
//   /tmp/aeskat.bin | od -An -tx1
// Expected: IVE Pass, stdout = single byte 0x00 (mismatch — MixColumns
// deferred, see "Documented limitation" above). When W53+ adds MixColumns
// + the real Rijndael key schedule, stdout will become 0x69 (105 — match).

// ────────────────────────────────────────────────────────────────────────────
// FFI declaration — write(2) syscall wrapper.
// ────────────────────────────────────────────────────────────────────────────
extern "C" { fn write(fd: i64, buf: Address, count: i64) -> i64; }

// ────────────────────────────────────────────────────────────────────────────
// Layouts.
// ────────────────────────────────────────────────────────────────────────────
// Re-declared byte-identically to womb/kernel/crypto/aes.vuma (K2c
// byte-identical-redeclaration invariant, extended to layouts in K3d —
// see womb/kernel/crypto/asym.vuma:140-142 for the canonical statement
// of the invariant). The re-declaration is required because VUMA has no
// `import` — each PMT-pure file is self-contained.

// AES S-box — the real 256-entry FIPS-197 table (W29S1).
layout AesSbox = { data: [u8; 256] }

// AES context: the expanded key schedule + the round count (10 for
// AES-128 — K11 will dispatch on ctx.nr for AES-192/256).
layout AesCtx = {
    round_keys: [u8; 176],  // expanded key schedule (11 × 16 bytes)
    nr: u32,                // number of rounds (10 for AES-128)
}

// AES-128 key wrapper (16 bytes).
layout AesKey = { data: [u8; 16] }

// AES block (always 16 bytes — the Rijndael block size).
layout AesBlock = { data: [u8; 16] }

// AES working state — the 16-byte column-major byte matrix that the round
// function (SubBytes + ShiftRows + MixColumns + AddRoundKey) transforms
// in place. Same 16-byte shape as AesBlock but a different role. Byte
// at (row, col) = data[col*4 + row] (column-major per FIPS-197 §3.4).
layout AesState = { data: [u8; 16] }

// Single-byte output buffer for write(2). The `byte` field is at offset 0
// so `out as Address` yields the address of the byte — the natural arg
// for write(1, addr, 1).
layout OutByte = { byte: u8 }

// ────────────────────────────────────────────────────────────────────────────
// AES S-box loader — the real 256-entry FIPS-197 table (decimal literals).
// ────────────────────────────────────────────────────────────────────────────
// Byte-identical copy of womb/kernel/crypto/aes.vuma:aes_init_sbox (W29S1).
// All literals are decimal per the VUMA convention (hex literals have
// width-extension issues per aes.vuma's header note). The full table is
// written as 256 explicit assignments rather than a runtime loop so the
// constants are visible to static analysis and IVE.
fn aes_init_sbox(sbox: State<AesSbox>) {
    sbox.data[0] = 99; sbox.data[1] = 124; sbox.data[2] = 119; sbox.data[3] = 123;
    sbox.data[4] = 242; sbox.data[5] = 107; sbox.data[6] = 111; sbox.data[7] = 197;
    sbox.data[8] = 48; sbox.data[9] = 1; sbox.data[10] = 103; sbox.data[11] = 43;
    sbox.data[12] = 254; sbox.data[13] = 215; sbox.data[14] = 171; sbox.data[15] = 118;
    sbox.data[16] = 202; sbox.data[17] = 130; sbox.data[18] = 201; sbox.data[19] = 125;
    sbox.data[20] = 250; sbox.data[21] = 89; sbox.data[22] = 71; sbox.data[23] = 240;
    sbox.data[24] = 173; sbox.data[25] = 212; sbox.data[26] = 162; sbox.data[27] = 175;
    sbox.data[28] = 156; sbox.data[29] = 164; sbox.data[30] = 114; sbox.data[31] = 192;
    sbox.data[32] = 183; sbox.data[33] = 253; sbox.data[34] = 147; sbox.data[35] = 38;
    sbox.data[36] = 54; sbox.data[37] = 63; sbox.data[38] = 247; sbox.data[39] = 204;
    sbox.data[40] = 52; sbox.data[41] = 165; sbox.data[42] = 229; sbox.data[43] = 241;
    sbox.data[44] = 113; sbox.data[45] = 216; sbox.data[46] = 49; sbox.data[47] = 21;
    sbox.data[48] = 4; sbox.data[49] = 199; sbox.data[50] = 35; sbox.data[51] = 195;
    sbox.data[52] = 24; sbox.data[53] = 150; sbox.data[54] = 5; sbox.data[55] = 154;
    sbox.data[56] = 7; sbox.data[57] = 18; sbox.data[58] = 128; sbox.data[59] = 226;
    sbox.data[60] = 235; sbox.data[61] = 39; sbox.data[62] = 178; sbox.data[63] = 117;
    sbox.data[64] = 9; sbox.data[65] = 131; sbox.data[66] = 44; sbox.data[67] = 26;
    sbox.data[68] = 27; sbox.data[69] = 110; sbox.data[70] = 90; sbox.data[71] = 160;
    sbox.data[72] = 82; sbox.data[73] = 59; sbox.data[74] = 214; sbox.data[75] = 179;
