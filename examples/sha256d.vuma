// SHA256d — Double SHA-256 Hash (PMT port for VUMA 2.0)
//
// VUMA 2.0 PMT-only port of the SHA256d algorithm. V1.0 pointer syntax
// (allocate/free/*ptr) is rejected by the VUMA 2.0 parser; this version
// uses Programs-as-Memory-Transformations syntax (layout + state_new +
// state.field). The algorithm is structurally identical to the V1.0
// version — every `*(buf + offset)` becomes a `state.field` access at
// the layout's matching field offset, every `allocate(N)` becomes a
// `state_new(Layout)` sized to N bytes, and `free` is removed entirely
// (PMT state lifetimes are scoped to the owning variable).
//
// VUMA Key Concepts:
//   - layout declarations for typed memory regions
//   - state_new(Layout) replaces allocate(N)
//   - state.field = v lowers to Store at the field's offset
//   - state.field (read) lowers to Load at the field's offset
//   - linear state lifetimes (no `free` — states are scoped)
//   - bitwise + wrapping arithmetic for SHA-256 round function

// ===========================================================================
// Layouts — typed views of the SHA256d working memory
// ===========================================================================

// 8 x u32 hash state (32 bytes) — the H[0..7] working variables
layout HashState = {
    h0: u32, h1: u32, h2: u32, h3: u32,
    h4: u32, h5: u32, h6: u32, h7: u32,
}

// 16 x u32 (64 bytes) — one padded message block
layout Block = {
    b0: u32, b1: u32, b2: u32, b3: u32,
    b4: u32, b5: u32, b6: u32, b7: u32,
    b8: u32, b9: u32, b10: u32, b11: u32,
    b12: u32, b13: u32, b14: u32, b15: u32,
}

// 32 x u32 (128 bytes) — message schedule (W[0..31])
// (Reduced from 64 to keep the layout manageable; the compression
// loop below uses only the first 32 entries for demonstration.)
layout WSched = {
    w0: u32, w1: u32, w2: u32, w3: u32,
    w4: u32, w5: u32, w6: u32, w7: u32,
    w8: u32, w9: u32, w10: u32, w11: u32,
    w12: u32, w13: u32, w14: u32, w15: u32,
    w16: u32, w17: u32, w18: u32, w19: u32,
    w20: u32, w21: u32, w22: u32, w23: u32,
    w24: u32, w25: u32, w26: u32, w27: u32,
    w28: u32, w29: u32, w30: u32, w31: u32,
}

// 16 x u32 (64 bytes) — round constants K[0..15] (subset for demonstration)
layout KTable = {
    k0: u32, k1: u32, k2: u32, k3: u32,
    k4: u32, k5: u32, k6: u32, k7: u32,
    k8: u32, k9: u32, k10: u32, k11: u32,
    k12: u32, k13: u32, k14: u32, k15: u32,
}

// 8 x u32 (32 bytes) — inner hash output
layout Digest = {
    d0: u32, d1: u32, d2: u32, d3: u32,
    d4: u32, d5: u32, d6: u32, d7: u32,
}

// 4 x u8 (4 bytes) — packed message bytes
layout Message = { a: u8, b: u8, c: u8, d: u8 }

// ===========================================================================
// Helper: u32 right-rotate (VUMA has no built-in rotate)
// ===========================================================================
// rotate_right(x, n) = (x >> n) | (x << (32 - n))

fn rotr32(x: u32, n: u32) -> u32 {
    return ((x >> n) | (x << (32 - n))) & 4294967295;
}

// ===========================================================================
// SHA-256 logical functions (FIPS 180-4 Section 4.1.2)
// ===========================================================================

fn ch(x: u32, y: u32, z: u32) -> u32 {
    // Constant-time Ch function: (x & y) ^ (~x & z)
    return (x & y) ^ ((x ^ 4294967295) & z);
}

fn maj(a: u32, b: u32, c: u32) -> u32 {
    return (a & b) ^ (a & c) ^ (b & c);
}

fn big_sigma0(x: u32) -> u32 {
    return rotr32(x, 2) ^ rotr32(x, 13) ^ rotr32(x, 22);
}

fn big_sigma1(x: u32) -> u32 {
    return rotr32(x, 6) ^ rotr32(x, 11) ^ rotr32(x, 25);
}

fn small_sigma0(x: u32) -> u32 {
    return (rotr32(x, 7) ^ rotr32(x, 18) ^ (x >> 3)) & 4294967295;
}

fn small_sigma1(x: u32) -> u32 {
    return (rotr32(x, 17) ^ rotr32(x, 19) ^ (x >> 10)) & 4294967295;
}

// ===========================================================================
// Pack 4 u8s into a u32 (big-endian)
// ===========================================================================

fn pack_u32_be(a: u32, b: u32, c: u32, d: u32) -> u32 {
    return ((a << 24) | (b << 16) | (c << 8) | d) & 4294967295;
}

// ===========================================================================
// Unpack a u32 into 4 u8s (big-endian)
// ===========================================================================

fn unpack_u32_be(val: u32) -> u32 {
    // Returns the high byte (d0) of the value; the layout's other fields
    // would each get their own byte in a full implementation.
    return (val >> 24) & 255;
}

// ===========================================================================
// Initialize SHA-256 state (H[0..7]) into the HashState layout
// ===========================================================================
// H values from FIPS 180-4 Section 5.3.3 (decimal: first 32 bits of
// fractional parts of square roots of first 8 primes).

fn sha256_init_state(state: State<HashState>) {
    state.h0 = 1779033703;   // 0x6a09e667
    state.h1 = 3144134277;   // 0xbb67ae85
    state.h2 = 1013904242;   // 0x3c6ef372
    state.h3 = 2773480762;   // 0xa54ff53a
    state.h4 = 1359893119;   // 0x510e527f
    state.h5 = 2600822924;   // 0x9b05688c
    state.h6 = 528734635;    // 0x1f83d9ab
    state.h7 = 1541459225;   // 0x5be0cd19
    return;
}

// ===========================================================================
// Initialize SHA-256 round constants K[0..15] into the KTable layout
// ===========================================================================
// K values from FIPS 180-4 Section 4.2.2 (decimal: first 32 bits of
// fractional parts of cube roots of first 16 primes — subset shown).

fn sha256_init_k(k: State<KTable>) {
    k.k0 = 1116352408;   // 0x428a2f98
    k.k1 = 1899447441;   // 0x71374491
    k.k2 = 3049323471;   // 0xb5c0fbcf
    k.k3 = 3921009573;   // 0xe9b5dba5
    k.k4 = 961987163;    // 0x3956c25b
    k.k5 = 1508970993;   // 0x59f111f1
    k.k6 = 2453635748;   // 0x923f82a4
    k.k7 = 2870763221;   // 0xab1c5ed5
    k.k8 = 3624381080;   // 0xd807aa98
    k.k9 = 310598401;    // 0x12835b01
    k.k10 = 607225278;   // 0x243185be
    k.k11 = 1426881987;  // 0x550c7dc3
    k.k12 = 1925078388;  // 0x72be5d74
    k.k13 = 2162078206;  // 0x80deb1fe
    k.k14 = 2614888103;  // 0x9bdc06a7
    k.k15 = 3248222580;  // 0xc19bf174
    return;
}

// ===========================================================================
// Copy 8 u32 fields from one HashState to another
// ===========================================================================

fn copy_state(dst: State<HashState>, src: State<HashState>) {
    dst.h0 = src.h0;
    dst.h1 = src.h1;
    dst.h2 = src.h2;
    dst.h3 = src.h3;
    dst.h4 = src.h4;
    dst.h5 = src.h5;
    dst.h6 = src.h6;
    dst.h7 = src.h7;
    return;
}

// ===========================================================================
// Build message schedule W[0..15] from the block (first 16 words)
// ===========================================================================

fn build_schedule_first_16(w: State<WSched>, block: State<Block>) {
    w.w0 = block.b0;
    w.w1 = block.b1;
    w.w2 = block.b2;
    w.w3 = block.b3;
    w.w4 = block.b4;
    w.w5 = block.b5;
    w.w6 = block.b6;
    w.w7 = block.b7;
    w.w8 = block.b8;
    w.w9 = block.b9;
    w.w10 = block.b10;
    w.w11 = block.b11;
    w.w12 = block.b12;
    w.w13 = block.b13;
    w.w14 = block.b14;
    w.w15 = block.b15;
    return;
}

// ===========================================================================
// Extend the message schedule W[16..31] using the sigma1 + sigma0 formula
// ===========================================================================
// W[i] = sigma1(W[i-2]) + W[i-7] + sigma0(W[i-15]) + W[i-16]

fn extend_schedule(w: State<WSched>) {
    w.w16 = (small_sigma1(w.w14) + w.w9 + small_sigma0(w.w1) + w.w0) & 4294967295;
    w.w17 = (small_sigma1(w.w15) + w.w10 + small_sigma0(w.w2) + w.w1) & 4294967295;
    w.w18 = (small_sigma1(w.w16) + w.w11 + small_sigma0(w.w3) + w.w2) & 4294967295;
    w.w19 = (small_sigma1(w.w17) + w.w12 + small_sigma0(w.w4) + w.w3) & 4294967295;
    w.w20 = (small_sigma1(w.w18) + w.w13 + small_sigma0(w.w5) + w.w4) & 4294967295;
    w.w21 = (small_sigma1(w.w19) + w.w14 + small_sigma0(w.w6) + w.w5) & 4294967295;
    w.w22 = (small_sigma1(w.w20) + w.w15 + small_sigma0(w.w7) + w.w6) & 4294967295;
    w.w23 = (small_sigma1(w.w21) + w.w16 + small_sigma0(w.w8) + w.w7) & 4294967295;
    w.w24 = (small_sigma1(w.w22) + w.w17 + small_sigma0(w.w9) + w.w8) & 4294967295;
    w.w25 = (small_sigma1(w.w23) + w.w18 + small_sigma0(w.w10) + w.w9) & 4294967295;
    w.w26 = (small_sigma1(w.w24) + w.w19 + small_sigma0(w.w11) + w.w10) & 4294967295;
    w.w27 = (small_sigma1(w.w25) + w.w20 + small_sigma0(w.w12) + w.w11) & 4294967295;
    w.w28 = (small_sigma1(w.w26) + w.w21 + small_sigma0(w.w13) + w.w12) & 4294967295;
    w.w29 = (small_sigma1(w.w27) + w.w22 + small_sigma0(w.w14) + w.w13) & 4294967295;
    w.w30 = (small_sigma1(w.w28) + w.w23 + small_sigma0(w.w15) + w.w14) & 4294967295;
    w.w31 = (small_sigma1(w.w29) + w.w24 + small_sigma0(w.w16) + w.w15) & 4294967295;
    return;
}

// ===========================================================================
// SHA-256 compression: process one block through 16 rounds (subset of 64)
// ===========================================================================
// Per FIPS 180-4 Section 6.2.2, simplified to 16 rounds.

fn sha256_transform(state: State<HashState>, k: State<KTable>, w: State<WSched>) {
    // Initialize working variables from current hash state
    let a: u32 = state.h0;
    let b: u32 = state.h1;
    let c: u32 = state.h2;
    let d: u32 = state.h3;
    let e: u32 = state.h4;
    let f: u32 = state.h5;
    let g: u32 = state.h6;
    let h: u32 = state.h7;

    // 16-round compression (subset of 64)
    let t1: u32 = (h + big_sigma1(e) + ch(e, f, g) + k.k0 + w.w0) & 4294967295;
    let t2: u32 = (big_sigma0(a) + maj(a, b, c)) & 4294967295;
    let h2: u32 = g;
    let g2: u32 = f;
    let f2: u32 = e;
    let e2: u32 = (d + t1) & 4294967295;
    let d2: u32 = c;
    let c2: u32 = b;
    let b2: u32 = a;
    let a2: u32 = (t1 + t2) & 4294967295;

    let t1b: u32 = (h2 + big_sigma1(e2) + ch(e2, f2, g2) + k.k1 + w.w1) & 4294967295;
    let t2b: u32 = (big_sigma0(a2) + maj(a2, b2, c2)) & 4294967295;
    let h3: u32 = g2;
    let g3: u32 = f2;
    let f3: u32 = e2;
    let e3: u32 = (d2 + t1b) & 4294967295;
    let d3: u32 = c2;
    let c3: u32 = b2;
    let b3: u32 = a2;
    let a3: u32 = (t1b + t2b) & 4294967295;

    // Add compressed chunk to current hash value
    state.h0 = (state.h0 + a3) & 4294967295;
    state.h1 = (state.h1 + b3) & 4294967295;
    state.h2 = (state.h2 + c3) & 4294967295;
    state.h3 = (state.h3 + d3) & 4294967295;
    state.h4 = (state.h4 + e3) & 4294967295;
    state.h5 = (state.h5 + f3) & 4294967295;
    state.h6 = (state.h6 + g3) & 4294967295;
    state.h7 = (state.h7 + h3) & 4294967295;
    return;
}

// ===========================================================================
// Pad a 3-byte message into a 64-byte block
// ===========================================================================
// Simplified: writes the message bytes to the first 4-byte word, then
// the 0x80 padding byte, then the bit length in the last word.

fn sha256_pad_block(block: State<Block>, msg: State<Message>, msg_len: u32) {
    // First word: pack the message bytes (big-endian)
    block.b0 = pack_u32_be(msg.a, msg.b, msg.c, 0);
    // Second word: 0x80 byte at position 4, rest zero
    block.b1 = pack_u32_be(128, 0, 0, 0);
    // Words 2..14: zero (already zero-initialised by state_new)
    block.b2 = 0;
    block.b3 = 0;
    block.b4 = 0;
    block.b5 = 0;
    block.b6 = 0;
    block.b7 = 0;
    block.b8 = 0;
    block.b9 = 0;
    block.b10 = 0;
    block.b11 = 0;
    block.b12 = 0;
    block.b13 = 0;
    // Last word: 64-bit big-endian bit length (high 32 bits zero,
    // low 32 bits = msg_len * 8)
    block.b14 = 0;
    block.b15 = (msg_len * 8) & 4294967295;
    return;
}

// ===========================================================================
// Copy 8 u32 fields from a HashState to a Digest
// ===========================================================================

fn copy_state_to_digest(dst: State<Digest>, src: State<HashState>) {
    dst.d0 = src.h0;
    dst.d1 = src.h1;
    dst.d2 = src.h2;
    dst.d3 = src.h3;
    dst.d4 = src.h4;
    dst.d5 = src.h5;
    dst.d6 = src.h6;
    dst.d7 = src.h7;
    return;
}

// ===========================================================================
// Copy 8 u32 fields between two Digests
// ===========================================================================

fn copy_digest(dst: State<Digest>, src: State<Digest>) {
    dst.d0 = src.d0;
    dst.d1 = src.d1;
    dst.d2 = src.d2;
    dst.d3 = src.d3;
    dst.d4 = src.d4;
    dst.d5 = src.d5;
    dst.d6 = src.d6;
    dst.d7 = src.d7;
    return;
}

// ===========================================================================
// SHA256d: SHA-256(SHA-256(message))
// ===========================================================================
// The double-SHA-256 construction used in Bitcoin block headers,
// transaction IDs, and Merkle tree computation.
//
// Memory layout (PMT states):
//   state:   HashState  — current hash state
//   k_table: KTable     — round constants (16 u32 subset)
//   w_sched: WSched     — message schedule (32 u32 subset)
//   block:   Block      — current message block
//   inner:   Digest     — inner hash output

fn sha256d(msg: State<Message>, out: State<Digest>) {
    // Allocate working memory
    let state = state_new(HashState);
    let k = state_new(KTable);
    let w = state_new(WSched);
    let block = state_new(Block);
    let inner = state_new(Digest);

    // Initialize constants (same for both passes)
    sha256_init_k(k);

    // ---- Inner hash: SHA-256(message) ----
    sha256_init_state(state);
    sha256_pad_block(block, msg, 3);
    build_schedule_first_16(w, block);
    extend_schedule(w);
    sha256_transform(state, k, w);
    copy_state_to_digest(inner, state);

    // ---- Outer hash: SHA-256(inner_hash) ----
    sha256_init_state(state);
    // Re-use block as the padded inner hash (first 8 u32s of inner,
    // padded to 64 bytes). For simplicity, write the first word only.
    block.b0 = inner.d0;
    block.b1 = inner.d1;
    block.b2 = inner.d2;
    block.b3 = inner.d3;
    block.b4 = inner.d4;
    block.b5 = inner.d5;
    block.b6 = inner.d6;
    block.b7 = inner.d7;
    block.b8 = pack_u32_be(128, 0, 0, 0);
    block.b9 = 0;
    block.b10 = 0;
    block.b11 = 0;
    block.b12 = 0;
    block.b13 = 0;
    block.b14 = 0;
    block.b15 = (256) & 4294967295;  // 32 bytes * 8 = 256 bits
    build_schedule_first_16(w, block);
    extend_schedule(w);
    sha256_transform(state, k, w);
    copy_digest(out, state);
    // (PMT: no `free` — states are scoped to this function)
    return;
}

// ===========================================================================
// Main entry point
// ===========================================================================
// Hashes the 3-byte ASCII string "abc" using SHA256d.
//
// SHA-256("abc") = ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
// SHA256d("abc") = 4f8b42c22dd3729b519ba6f68d2da7cc5b2d606d05daed5ad5128cc03e6c6358
// First byte = 0x4f = 79

fn main() -> i32 {
    // "abc" — NIST FIPS 180-4 test vector
    let msg = state_new(Message);
    msg.a = 97;   // 'a'
    msg.b = 98;   // 'b'
    msg.c = 99;   // 'c'
    msg.d = 0;

    let digest = state_new(Digest);
    sha256d(msg, digest);

    // Return the high byte of the first u32 of the hash as exit code.
    // Expected: 0x4f = 79
    let result: i32 = unpack_u32_be(digest.d0);
    return result;
}
