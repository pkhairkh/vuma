// Spinlock — demonstrates VUMA atomic operations (PMT port for VUMA 2.0)
//
// VUMA 2.0 PMT-only port of the spinlock example. V1.0 pointer syntax
// (allocate/free/*ptr) is rejected by the VUMA 2.0 parser; this version
// uses Programs-as-Memory-Transformations syntax (layout + state_new +
// state.field).
//
// VUMA atomic operations:
//   - atomic_load(addr)       — load with acquire semantics
//   - atomic_store(addr, val) — store with release semantics
//   - atomic_cas(addr, expected, desired) — compare-and-swap
//
// In PMT, the atomic ops still take an Address argument. We obtain the
// address of a state field by storing the state's pointer in a local
// variable (`let lock_addr = lock.state_addr`) — but to keep this port
// fully PMT (no `&x` or `*T`), we instead apply the atomic ops to the
// state directly via the field-access form. The `Address` parameter is
// supplied by the state-field's lowered address.

// ===========================================================================
// Layouts
// ===========================================================================

// Spinlock state: 0 = unlocked, 1 = locked (single u64)
layout SpinLock = { state: u64 }

// Counter layout: shared counter protected by the spinlock
layout Counter = { value: u64 }

// ===========================================================================
// Initialize a new spinlock in the unlocked state
// ===========================================================================

fn spinlock_init(lock: State<SpinLock>) {
    lock.state = 0;
    return;
}

// ===========================================================================
// Acquire the spinlock — spins until the lock is available
// ===========================================================================
// Uses atomic_cas in a loop:
// 1. Try to atomically change state from 0 (unlocked) to 1 (locked)
// 2. If CAS returns 0 (the old value was unlocked), we got the lock
// 3. If CAS returns non-zero, someone else holds it — retry

fn spinlock_lock(lock: State<SpinLock>) {
    loop {
        // Try to atomically change state from 0 to 1
        old = atomic_cas(lock, 0, 1);
        if old == 0 {
            // Successfully acquired the lock
            return;
        }
        // Lock is held by another thread — spin (retry)
    }
}

// ===========================================================================
// Release the spinlock — sets state back to 0
// ===========================================================================

fn spinlock_unlock(lock: State<SpinLock>) {
    atomic_store(lock, 0);
    return;
}

// ===========================================================================
// Try to acquire the lock without spinning
// ===========================================================================

fn spinlock_trylock(lock: State<SpinLock>) -> bool {
    old = atomic_cas(lock, 0, 1);
    return old == 0;
}

// ===========================================================================
// Example: using a spinlock to protect a shared counter
// ===========================================================================

fn increment_with_lock(lock: State<SpinLock>, counter: State<Counter>) {
    spinlock_lock(lock);
    // Critical section — only one thread at a time
    val = atomic_load(counter);
    atomic_store(counter, val + 1);
    spinlock_unlock(lock);
    return;
}

// ===========================================================================
// Main entry point
// ===========================================================================

fn main() -> i32 {
    // Allocate a spinlock and a shared counter via PMT state_new
    let lock = state_new(SpinLock);
    let counter = state_new(Counter);

    // Initialize
    spinlock_init(lock);
    atomic_store(counter, 0);

    // Increment the counter under the lock
    increment_with_lock(lock, counter);
    increment_with_lock(lock, counter);
    increment_with_lock(lock, counter);

    // Read the result (should be 3)
    result = atomic_load(counter);
    return result;
}
