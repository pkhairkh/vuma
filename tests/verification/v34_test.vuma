// v34_test.vuma — V-34 regression test (cast-based, avoids literal-immediate bug)
//
// V-34: bridge_type_to_ir_type at pipeline.rs:6515 didn't map "f32"/"f64"
// to IRType::F32/F64. They fell into _ => IRType::U64, causing:
//   - f32 state fields loaded as U64 (wrong arithmetic: integer ADD not ADDSD)
//   - f32 state fields stored as U64 (memory corruption: 8-byte store to 4-byte field)
//   - IVE unsoundness (discharge_rate=100% on a wrong program)
//
// This test uses integer-to-float casts (not literal f32 immediates) to
// isolate the V-34 bridge fix from the separate f32-literal-immediate
// materialization bug (tracked separately).
//
// Expected exit code: 7  (3 + 4 = 7)

layout Point = { x: f32, y: f32 }

transform get_sum(p: State<Point>) -> f32 {
    return p.x + p.y;
}

transform main() -> i32 {
    let p = state_new(Point);
    p.x = 3 as f32;
    p.y = 4 as f32;
    sum: f32 = get_sum(p);
    return sum as i32;
}
