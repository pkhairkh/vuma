    data.data[54] = 160;
    data.data[55] = 29;
    data.data[56] = 25;
    data.data[57] = 244;
    data.data[58] = 80;
    data.data[59] = 29;
    data.data[60] = 41;
    data.data[61] = 95;
    data.data[62] = 35;
    data.data[63] = 34;
    md5_oneshot(data, 64, out);
    oi = 0;
    while oi < 16 {
        print_int(1000 + (out.data[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}