    key.data[20] = 113;
    key.data[21] = 32;
    key.data[22] = 229;
    key.data[23] = 97;
    key.data[24] = 205;
    key.data[25] = 222;
    key.data[26] = 186;
    key.data[27] = 38;
    key.data[28] = 110;
    key.data[29] = 45;
    key.data[30] = 224;
    key.data[31] = 21;
    poly1305_init(ctx, key);
    poly1305_update(ctx, msg, 64);
    poly1305_final(ctx, tag);
    oi = 0;
    while oi < 16 {
        print_int(1000 + (tag.data[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}