    data.bytes[54] = 160;
    data.bytes[55] = 29;
    data.bytes[56] = 25;
    data.bytes[57] = 244;
    data.bytes[58] = 80;
    data.bytes[59] = 29;
    data.bytes[60] = 41;
    data.bytes[61] = 95;
    data.bytes[62] = 35;
    data.bytes[63] = 34;
    sha1_oneshot(data, 64, out);
    oi = 0;
    while oi < 20 {
        print_int(1000 + (out.data[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}