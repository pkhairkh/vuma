    seed.bytes[51] = 111;
    seed.bytes[52] = 29;
    seed.bytes[53] = 31;
    seed.bytes[54] = 160;
    seed.bytes[55] = 29;
    seed.bytes[56] = 25;
    seed.bytes[57] = 244;
    seed.bytes[58] = 80;
    seed.bytes[59] = 29;
    seed.bytes[60] = 41;
    seed.bytes[61] = 95;
    seed.bytes[62] = 35;
    seed.bytes[63] = 34;
    falcon_keygen(seed, pk, sk);
    oi = 0;
    while oi < 32 {
        print_int(1000 + (pk.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}