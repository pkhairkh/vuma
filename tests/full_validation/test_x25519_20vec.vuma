    scalar.data[57] = 244;
    scalar.data[58] = 80;
    scalar.data[59] = 29;
    scalar.data[60] = 41;
    scalar.data[61] = 95;
    scalar.data[62] = 35;
    scalar.data[63] = 34;
    x25519_base(out, scalar);
    oi = 0;
    while oi < 32 {
        print_int(1000 + (out.data[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}