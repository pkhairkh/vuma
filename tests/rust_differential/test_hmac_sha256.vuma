// Differential test: HMAC-SHA256 (RFC 4231 Test Case 1)
//   key  = 0x0b * 20 (decimal: 11, 11, ... 11)
//   msg  = "Hi There" (72 105 32 84 104 101 114 101)
//   Expected HMAC = b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7
//   First byte: 0xb0 = 176

// HMAC's internal streaming chunked-update path calls the SHA-256 streaming
// transforms (sha256_init/update/final) — these are cross-module references
// and must be explicitly imported (the VUMA 2.0 compiler does not auto-resolve
// symbols across module files).
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hmac.vuma"::{HmacKey, HmacMsg, HmacOut, hmac_sha256};
import "/home/z/my-project/workdir/vuma/womb/crypto/hash/sha256_sha224.vuma"::{Sha256Ctx, Sha256Data, Sha256Digest, sha256_init, sha256_update, sha256_final};

transform main() -> i32 {
    let key = state_new(HmacKey);
    let msg = state_new(HmacMsg);
    let out = state_new(HmacOut);

    // key = 0x0b repeated 20 times
    key.bytes[0] = 11;  key.bytes[1] = 11;  key.bytes[2] = 11;  key.bytes[3] = 11;
    key.bytes[4] = 11;  key.bytes[5] = 11;  key.bytes[6] = 11;  key.bytes[7] = 11;
    key.bytes[8] = 11;  key.bytes[9] = 11;  key.bytes[10] = 11; key.bytes[11] = 11;
    key.bytes[12] = 11; key.bytes[13] = 11; key.bytes[14] = 11; key.bytes[15] = 11;
    key.bytes[16] = 11; key.bytes[17] = 11; key.bytes[18] = 11; key.bytes[19] = 11;

    // msg = "Hi There"
    msg.bytes[0] = 72;   // H
    msg.bytes[1] = 105;  // i
    msg.bytes[2] = 32;   // space
    msg.bytes[3] = 84;   // T
    msg.bytes[4] = 104;  // h
    msg.bytes[5] = 101;  // e
    msg.bytes[6] = 114;  // r
    msg.bytes[7] = 101;  // e

    hmac_sha256(key, 20, msg, 8, out);

    return out.bytes[0] as i32;
}
