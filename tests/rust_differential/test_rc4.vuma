// Differential test: rc4
// Expected first byte: 187 (0xbb)

import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/rc4.vuma"::{Rc4Ctx, Rc4Key, Rc4Buf, rc4_init, rc4_crypt};

transform main() -> i32 {
    let ctx = state_new(Rc4Ctx);
    let key = state_new(Rc4Key);
    let data = state_new(Rc4Buf);

    key.bytes[0] = 75;
    key.bytes[1] = 101;
    key.bytes[2] = 121;
    data.bytes[0] = 80;
    data.bytes[1] = 108;
    data.bytes[2] = 97;
    data.bytes[3] = 105;
    data.bytes[4] = 110;
    data.bytes[5] = 116;
    data.bytes[6] = 101;
    data.bytes[7] = 120;
    data.bytes[8] = 116;

    rc4_init(ctx, key, 3);
    rc4_crypt(ctx, data, 9);

    return data.bytes[0] as i32;
}
