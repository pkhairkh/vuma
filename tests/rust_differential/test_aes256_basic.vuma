// VUMA harness for AES-256 ECB — FIPS-197 §C.3 test vector
//   key = 000102...1f (32 bytes)
//   pt  = 00112233445566778899aabbccddeeff
//   ct  = 8ea2b7ca516745bfeafc49904b496089
// Output: each ciphertext byte printed as decimal integer on its own line.
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/aes256.vuma"::{AesCtx, AesKey, AesBlock, aes256_init, aes_encrypt_block};

transform main() -> i32 {
    let ctx = state_new(AesCtx);
    let key = state_new(AesKey);
    let pt = state_new(AesBlock);
    let ct = state_new(AesBlock);

    // key = [0..31]
    key.data[0] = 0;   key.data[1] = 1;   key.data[2] = 2;   key.data[3] = 3;
    key.data[4] = 4;   key.data[5] = 5;   key.data[6] = 6;   key.data[7] = 7;
    key.data[8] = 8;   key.data[9] = 9;   key.data[10] = 10; key.data[11] = 11;
    key.data[12] = 12; key.data[13] = 13; key.data[14] = 14; key.data[15] = 15;
    key.data[16] = 16; key.data[17] = 17; key.data[18] = 18; key.data[19] = 19;
    key.data[20] = 20; key.data[21] = 21; key.data[22] = 22; key.data[23] = 23;
    key.data[24] = 24; key.data[25] = 25; key.data[26] = 26; key.data[27] = 27;
    key.data[28] = 28; key.data[29] = 29; key.data[30] = 30; key.data[31] = 31;

    // pt = 00 11 22 33 44 55 66 77 88 99 aa bb cc dd ee ff
    pt.data[0] = 0;   pt.data[1] = 17;  pt.data[2] = 34;  pt.data[3] = 51;
    pt.data[4] = 68;  pt.data[5] = 85;  pt.data[6] = 102; pt.data[7] = 119;
    pt.data[8] = 136; pt.data[9] = 153; pt.data[10] = 170; pt.data[11] = 187;
    pt.data[12] = 204; pt.data[13] = 221; pt.data[14] = 238; pt.data[15] = 255;

    aes256_init(ctx, key);
    aes_encrypt_block(ctx, pt, ct);

    let i: u32 = 0;
    while i < 16 {
        print_int((ct.data[i] as u32) + 1000);
        i = i + 1;
    }
    return 0;
}
