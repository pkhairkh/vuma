// Wave A-1 differential test: SHA-256("abc")
// Expected: ba7816bf8e01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
//           → out.data[0] = 0xba = 186 (program exit code)

import "/home/z/my-project/workdir/vuma/womb/crypto/hash/sha256_sha224.vuma"::{Sha256Ctx, Sha256Data, Sha256Digest, sha256_oneshot};

transform main() -> i32 {
    let ctx = state_new(Sha256Ctx);
    let data = state_new(Sha256Data);
    let out = state_new(Sha256Digest);

    // "abc" = 97 98 99
    data.data[0] = 97;
    data.data[1] = 98;
    data.data[2] = 99;

    sha256_oneshot(ctx, data, 3, out);

    // SHA-256("abc")[0] = 0xba = 186.
    return out.data[0] as i32;
}
