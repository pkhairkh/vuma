// Differential test: md5("")
// Expected: d41d8cd98f00b204e9800998ecf8427e
// First byte: 212 (0xd4)

import "/home/z/my-project/workdir/vuma/womb/crypto/hash/md5.vuma"::{Md5Ctx, Md5Data, Md5Digest, md5_oneshot};

transform main() -> i32 {
let data = state_new(Md5Data);
    let out = state_new(Md5Digest);



    md5_oneshot(data, 0, out);

    return out.data[0] as i32;
}
