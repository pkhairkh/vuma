// ffi_wave3/foreign_arg_pass — #[foreign(raw)] arg passes the raw field value
// Expected exit code: 0
//
// Wave 5 test: when a State<ForeignLayout> is passed to an extern fn, the
// `raw` field value (the C pointer) is passed — NOT the ___pmt_buffer
// pointer. This test declares the extern and the foreign layout; the
// marshal module's classify_arg_mode returns ForeignPass for such args.

#[foreign(raw)]
layout DbHandle = { raw: u64 }

extern "C" {
    fn use_db(db: State<DbHandle>) -> i64;
}

fn main() -> i32 {
    let db = state_new(DbHandle);
    db.raw = 0;
    // Hypothetically: use_db(db) — db.raw (the C pointer) is passed, not
    // ___pmt_buffer_base + offset. The state is preserved (not consumed,
    // since use_db is not #[foreign_consume]).
    return 0;
}
