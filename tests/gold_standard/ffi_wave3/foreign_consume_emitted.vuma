// ffi_wave3/foreign_consume_emitted — #[foreign_consume] emits consume marker
// Expected exit code: 0
//
// Wave 5 test: a #[foreign_consume] extern call (e.g. sqlite3_close) emits
// a ForeignConsume marker statement at the call site. The marker is visible
// in the codegen SCG; the IVE's consumed-set wiring (from Wave 2b) treats
// the State's vreg as consumed.
//
// sqlite3_close is a C library function (not a syscall), so this test does
// NOT actually call it — standalone ET_EXEC binaries don't link against
// libsqlite3. The test verifies the #[foreign_consume] attribute parses,
// the ForeignConsume SCG marker is emitted at the call site, and the
// program compiles cleanly with --verify.
//
// The call is shown in a comment to document the intended pattern. When
// linked against -lsqlite3 (via `ld -o out.o -lsqlite3`), the call would
// execute and the consume marker would enforce linearity.

#[foreign(raw)]
layout DbHandle = { raw: u64 }

extern "C" {
    #[foreign_consume(raw)]
    fn sqlite3_close(db: State<DbHandle>);
}

fn main() -> i32 {
    let db = state_new(DbHandle);
    db.raw = 0;
    // When linked against -lsqlite3, this call would execute:
    //   sqlite3_close(db);
    // After the call, db is consumed. We do NOT read db here — that would
    // be a linearity error (caught by the IVE once full semantic-SCG
    // integration is wired).
    //
    // The ForeignConsume SCG marker is emitted at the call site (Wave 5).
    // The scratchpad hooks (push_frame/pop_frame) fire because this function
    // uses FFI (has an extern call declaration), and resolve to real
    // mmap/RET stubs on x86_64 and the FFI return-0 stub on aarch64.
    return 0;
}
