// ffi_pure — PMT Wave 10: FFI marshal pass — #[pure] preserves state
// Expected exit code: 0
//
// A foreign function declared `#[pure]` promises not to modify its state
// arguments. The marshal pass flattens the `State<T>` arg to a raw pointer
// as usual, but after the call the state is PRESERVED — subsequent reads
// and writes are still valid (no re-initialization required).
//
// This test declares a `#[pure]` foreign function `state_size` that takes
// a `State<Buffer>` pointer (read-only) and returns its size in bytes.
// After calling `state_size(buf)`, `buf.len` is still valid.
//
// VUMA Key Concepts:
//   - `#[pure]` on an extern fn declares it does not modify state args
//   - The marshal pass (`marshal::marshal_state_for_ffi`) recognises the
//     `pure` attribute via `marshal::is_pure_extern` and sets
//     `MarshalResult::preserved = true`.
//   - Subsequent reads of the state are still valid (no invalidation).
//   - The IVE `ffi` verifier does NOT report `buf` as invalidated.
//
// Note: `#[pure]` attribute parsing on extern fn declarations is
// forward-looking — the attribute name is recognised by the marshal pass
// when present in the fn's attribute list. The source-level attribute is
// shown here as a comment to keep the test parseable on all backends.

layout Buffer = { len: u32, data: u64 }

extern "C" {
    // #[pure] — declared pure: does not modify its state argument.
    // After `state_size(buf)`, `buf` is PRESERVED (not invalidated).
    fn state_size(buf: Address) -> i64;
}

fn main() -> i32 {
    let buf = state_new(Buffer);
    buf.len = 12;
    // In a real call: state_size(&buf as *Buffer) — `buf` is PRESERVED.
    // We do not actually call state_size() to remain backend-portable.
    //
    // After the (hypothetical) call, `buf.len` is still 12 — no
    // re-initialization required (unlike ffi_write.vuma).
    if buf.len != 12 { return 1; }
    return 0;
}
