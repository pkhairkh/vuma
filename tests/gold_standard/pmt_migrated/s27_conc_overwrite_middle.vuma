layout Triple = { a: u32, b: u32, c: u32 }

fn main() -> i32 {
    let __s = state_new(Triple);
    __s.a = 100;
    __s.b = 10;
    __s.c = 50;
    __s.b = 20;
    let v1 = __s.a;
    let v2 = __s.b;
    let v3 = __s.c;
    let s = v1 + v2 + v3;
    return s;
}
