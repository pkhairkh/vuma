layout Triple = { a: u32, b: u32, c: u32 }

fn main() -> i32 {
    let __s = state_new(Triple);
    __s.a = 15;
    __s.b = 30;
    __s.c = 45;
    __s.b = 100;
    let a = __s.a;
    let b = __s.b;
    let c = __s.c;
    let t = a + b;
    let s = t + c;
    return s;
}
