layout Pair = { a: u32, b: u32 }

fn main() -> i32 {
    let __s = state_new(Pair);
    __s.a = 90;
    __s.a = 10;
    __s.b = 50;
    let v1 = __s.a;
    let v2 = __s.b;
    let r = v2 - v1;
    return r;
}
