layout Triple = { a: u32, b: u32, c: u32 }

fn main() -> i32 {
    let __s = state_new(Triple);
    __s.a = 100;
    __s.b = 50;
    __s.c = 21;
    let v1 = __s.a;
    let v2 = __s.b;
    let v3 = __s.c;
    let t = v1 - v2;
    let r = t - v3;
    return r;
}
