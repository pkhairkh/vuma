// Migrated from pointers/ptr_store_multiple.vuma
// Expected exit code: 3
//
// PMT migration: allocate/free/*ptr replaced with state_new(Layout)
// + field access. Buffer lifetime auto-managed.

layout Triple = { a: u32, b: u32, c: u32 }

fn main() -> i32 {
    let __s = state_new(Triple);
    __s.a = 1;
    __s.b = 1;
    __s.c = 1;
    let v0 = __s.a;
    let v1 = __s.b;
    let v2 = __s.c;
    let sum = v0 + v1 + v2;
    return sum;
}
