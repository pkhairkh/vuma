// Migrated from pointers/ptr_store_load_u32.vuma
// Expected exit code: 255
//
// PMT migration: allocate/free/*ptr replaced with state_new(Layout)
// + field access. Buffer lifetime auto-managed.

layout Single = { v: u32 }

fn main() -> i32 {
    let __s = state_new(Single);
    let val = 0x000000FF;
    let mask = 255;
    __s.v = val & mask;
    let loaded = __s.v;
    return loaded;
}
