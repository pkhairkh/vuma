// oob_offbyone — Off-by-one: index == length
// Expected exit code: 134
// Compile: compile_dump <file> <out> <backend> --opt-level=O3 --safe
//
// Bounds Wave 1 SAFE-ONLY negative test: allocate a 4-byte buffer
// (`[u8; 4]`) and read at index 4 — exactly one past the last valid
// index (the canonical off-by-one error). With `--safe`, the
// injected `UGe(idx, 4)` bounds check evaluates to true (4 >= 4) and
// dispatches to `__oob_trap`, which aborts with exit code 134
// (SIGABRT, 128 + 6).
//
// IMPORTANT: This test is NOT in the regular `bounds_wave1/` gold
// standard suite because it only passes when compiled with `--safe`.
// Without `--safe`, the OOB access is undefined behaviour. The
// expected exit code below assumes `--safe` was passed at compile time.
//
// VUMA Key Concepts:
//   - state_new(Layout) allocation (PMT idiom)
//   - `[u8; 4]` array field with a known 4-byte size
//   - boundary case: index == length (one past last valid index)
//   - runtime-variable index `idx = 4` so O3 cannot trivially DCE the
//     access; the injected `UGe(idx, 4)` check folds to true and the
//     trap branch survives DCE.
//   - exit 134 == SIGABRT (128 + 6) emitted by `__oob_trap`.
//   - This is the OOB mirror of inbounds_last_index (which accesses
//     index == length-1 and should NOT trap).

layout Buf = { data: [u8; 4] }

fn main() -> i32 {
    let b = state_new(Buf);
    // Read one past the 4-byte array — should trap with exit 134 when --safe
    let idx: u32 = 4;
    return b.data[idx];
}
