// oob_large_index — Very large index
// Expected exit code: 134
// Compile: compile_dump <file> <out> <backend> --opt-level=O3 --safe
//
// Bounds Wave 1 SAFE-ONLY negative test: allocate an 8-byte buffer
// (`[u8; 8]`) and read at index 255 — a very large index that is far
// out of range. With `--safe`, the injected `UGe(idx, 8)` bounds
// check evaluates to true (255 >= 8) and dispatches to `__oob_trap`,
// which aborts with exit code 134 (SIGABRT, 128 + 6).
//
// IMPORTANT: This test is NOT in the regular `bounds_wave1/` gold
// standard suite because it only passes when compiled with `--safe`.
// Without `--safe`, the OOB access is undefined behaviour: a 255-byte
// offset from a stack/heap allocation will typically land in an
// unmapped page and crash with SIGSEGV (exit 139), but the exact
// outcome is platform-dependent. The expected exit code below
// assumes `--safe` was passed at compile time.
//
// VUMA Key Concepts:
//   - state_new(Layout) allocation (PMT idiom)
//   - `[u8; 8]` array field with a known 8-byte size
//   - very-large index (255) — exercises the bounds check with a
//     maximally-divergent index value, ensuring the `UGe` check is
//     not somehow short-circuited by an arithmetic-overflow fold
//   - runtime-variable index `idx = 255` so O3 cannot trivially DCE
//     the access; the injected `UGe(idx, 8)` check folds to true.
//   - exit 134 == SIGABRT (128 + 6) emitted by `__oob_trap`.

layout Buf = { data: [u8; 8] }

fn main() -> i32 {
    let b = state_new(Buf);
    // Read far past the 8-byte array — should trap with exit 134 when --safe
    let idx: u32 = 255;
    return b.data[idx];
}
