// s3_cs_byte_spread.vuma — store 4 values at byte offsets 0,1,2,3
// Expected exit code: 10  (1 + 2 + 3 + 4)
//
// Stores four byte-sized values at consecutive byte offsets in a
// 4-byte buffer, then loads each back and sums them.

layout Buf_buf = { data: [u8; 4] }

fn main() -> i32 {
    let buf = state_new(Buf_buf);
    buf.data[0] = 1;
    buf.data[1] = 2;
    buf.data[2] = 3;
    buf.data[3] = 4;

    a: u64 = buf.data[0];
    b: u64 = buf.data[1];
    c: u64 = buf.data[2];
    d: u64 = buf.data[3];
    s1: u64 = a + b;
    s2: u64 = s1 + c;
    s3: u64 = s2 + d;

    return s3;
}
