// s42_cs_three_cell_xor.vuma — three cells, xor = 195 (0xA5 ^ 0x3C ^ 0x5A)
// Expected exit code: 195
//
// Three 8-byte cells. Store 165/60/90 via `*ptr = literal`, load all,
// xor -> 195 (0xC3). Uses `*ptr = literal` form (no offsets). Distinct
// from s38_cs_three_cell_sum (220) and s34_cs_three_cell_sum (180).

layout Buf_c1 = { data: [u8; 8] }
layout Buf_c2 = { data: [u8; 8] }
layout Buf_c3 = { data: [u8; 8] }

fn main() -> i32 {
    let c1 = state_new(Buf_c1);
    let c2 = state_new(Buf_c2);
    let c3 = state_new(Buf_c3);
    c1.data[0] = 165;             // 0xA5
    c2.data[0] = 60;              // 0x3C
    c3.data[0] = 90;              // 0x5A
    a: u64 = c1.data[0];
    b: u64 = c2.data[0];
    c: u64 = c3.data[0];
    t: u64 = a ^ b;
    r: u64 = t ^ c;        // 0xC3 = 195
    return r;
}
