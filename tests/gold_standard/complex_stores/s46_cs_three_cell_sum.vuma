// s46_cs_three_cell_sum.vuma — three cells, sum = 195 (55 + 65 + 75)
// Expected exit code: 195
//
// Three 8-byte cells. Store 55/65/75 via `*ptr = literal`, load all,
// sum -> 195. Uses `*ptr = literal` form (no offsets). Distinct
// from s42_cs_three_cell_xor (195, xor vs sum) and s38_cs_three_
// cell_sum (220).

layout Buf_c1 = { data: [u8; 8] }
layout Buf_c2 = { data: [u8; 8] }
layout Buf_c3 = { data: [u8; 8] }

fn main() -> i32 {
    let c1 = state_new(Buf_c1);
    let c2 = state_new(Buf_c2);
    let c3 = state_new(Buf_c3);
    c1.data[0] = 55;
    c2.data[0] = 65;
    c3.data[0] = 75;
    a: u64 = c1.data[0];
    b: u64 = c2.data[0];
    c: u64 = c3.data[0];
    t: u64 = a + b;
    s: u64 = t + c;        // 195
    return s;
}
