// s48_cs_three_cell_diff.vuma — three cells, diff = 180 (250 - 40 - 30)
// Expected exit code: 180
//
// Three 8-byte cells. Store 250/40/30 via `*ptr = literal`, load all,
// subtract twice -> 180. Uses `*ptr = literal` form (no offsets).
// Distinct from s46_cs_three_cell_sum (195) and s42_cs_three_cell_xor.

layout Buf_c1 = { data: [u8; 8] }
layout Buf_c2 = { data: [u8; 8] }
layout Buf_c3 = { data: [u8; 8] }

fn main() -> i32 {
    let c1 = state_new(Buf_c1);
    let c2 = state_new(Buf_c2);
    let c3 = state_new(Buf_c3);
    c1.data[0] = 250;
    c2.data[0] = 40;
    c3.data[0] = 30;
    a: u64 = c1.data[0];
    b: u64 = c2.data[0];
    c: u64 = c3.data[0];
    t: u64 = a - b;
    s: u64 = t - c;        // 180
    return s;
}
