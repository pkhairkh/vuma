// s19_cs_overwrite_middle.vuma — overwrite middle cell, sum = 90 (10 + 50 + 30)
// Expected exit code: 90
//
// Three 8-byte cells. Store 10/20/30 in c1/c2/c3, then overwrite c2
// (the middle cell) with 50. Load all three, sum -> 90. Uses
// `*ptr = literal` form (no offsets). Distinct from
// s18_cs_overwrite_last (overwrites last cell, 10/20/30 -> 10/20/99)
// and s14_cs_overwrite_first (overwrites first cell).

layout Buf_c1 = { data: [u8; 8] }
layout Buf_c2 = { data: [u8; 8] }
layout Buf_c3 = { data: [u8; 8] }

fn main() -> i32 {
    let c1 = state_new(Buf_c1);
    let c2 = state_new(Buf_c2);
    let c3 = state_new(Buf_c3);
    c1.data[0] = 10;
    c2.data[0] = 20;
    c3.data[0] = 30;
    c2.data[0] = 50;
    a: u64 = c1.data[0];
    b: u64 = c2.data[0];
    c: u64 = c3.data[0];
    s: u64 = a + b + c;
    return s;
}
