// cs2_chain.vuma — store 55 in buf1, copy to buf2, copy to buf3, load buf3
// Expected exit code: 55
//
// Three-buffer transitive copy chain: 55 -> buf1 -> buf2 -> buf3 -> load.
// Each copy step uses the `| 0` identity-expression workaround so the
// store of a loaded variable is not silently dropped by the backend.

layout Buf_b1 = { data: [u8; 8] }
layout Buf_b2 = { data: [u8; 8] }
layout Buf_b3 = { data: [u8; 8] }

fn main() -> i32 {
    let b1 = state_new(Buf_b1);
    let b2 = state_new(Buf_b2);
    let b3 = state_new(Buf_b3);
    b1.data[0] = 55;
    t1: u32 = b1.data[0];
    b2.data[0] = t1 | 0;       // copy b1 -> b2 (workaround for *ptr = variable)
    t2: u32 = b2.data[0];
    b3.data[0] = t2 | 0;       // copy b2 -> b3 (workaround for *ptr = variable)
    out: u32 = b3.data[0];
    return out;
}
