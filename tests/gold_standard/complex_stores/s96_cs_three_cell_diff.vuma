// s96_cs_three_cell_diff.vuma — three cells, diff = 120 (250 - 100 - 30)
// Expected exit code: 120
//
// Three 8-byte cells. Store 250/100/30 via `*ptr = literal`, load
// all three, 250 - 100 - 30 -> 120. Uses `*ptr = literal` form.
// Distinct from s94_cs_three_cell_sum (90),
// s90_cs_three_cell_diff (6) and s86_cs_three_cell_diff (140).
layout Buf_c1 = { data: [u8; 8] }
layout Buf_c2 = { data: [u8; 8] }
layout Buf_c3 = { data: [u8; 8] }

fn main() -> i32 {
    let c1 = state_new(Buf_c1);
    let c2 = state_new(Buf_c2);
    let c3 = state_new(Buf_c3);
    c1.data[0] = 250;
    c2.data[0] = 100;
    c3.data[0] = 30;
    a: u64 = c1.data[0];
    b: u64 = c2.data[0];
    c: u64 = c3.data[0];
    d: u64 = a - b - c;    // 120
    return d;
}
