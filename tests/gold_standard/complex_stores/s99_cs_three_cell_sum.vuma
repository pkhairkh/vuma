// s99_cs_three_cell_sum.vuma — three cells, sum = 122 (50 + 40 + 32)
// Expected exit code: 122
//
// Three 8-byte cells. Store 50/40/32 via `*ptr = literal`, load
// all three, a + b + c -> 122. Uses `*ptr = literal` form (no
// offsets). Distinct from s95_cs_three_cell_diff (43),
// s91_cs_three_cell_diff (48) and s87_cs_three_cell_diff (155).
layout Buf_c1 = { data: [u8; 8] }
layout Buf_c2 = { data: [u8; 8] }
layout Buf_c3 = { data: [u8; 8] }

fn main() -> i32 {
    let c1 = state_new(Buf_c1);
    let c2 = state_new(Buf_c2);
    let c3 = state_new(Buf_c3);
    c1.data[0] = 50;
    c2.data[0] = 40;
    c3.data[0] = 32;
    a: u64 = c1.data[0];
    b: u64 = c2.data[0];
    c: u64 = c3.data[0];
    s: u64 = a + b + c;    // 122
    return s;
}
