// s41_cs_two_cell_diff.vuma - two cells, diff = 130 (220 - 90)
// Expected exit code: 130
//
// Two 8-byte cells. Store 220/90 via `*ptr = literal`, load both,
// subtract -> 130. Uses `*ptr = literal` form (no offsets). Distinct
// from s38_cs_two_cell_diff (140) and s34_cs_two_cell_diff (65).

layout Buf_c1 = { data: [u8; 8] }
layout Buf_c2 = { data: [u8; 8] }

fn main() -> i32 {
    let c1 = state_new(Buf_c1);
    let c2 = state_new(Buf_c2);
    c1.data[0] = 220;
    c2.data[0] = 90;
    a: u64 = c1.data[0];
    b: u64 = c2.data[0];
    d: u64 = a - b;        // 130
    return d;
}
