// s86_cs_three_cell_diff.vuma — three cells, diff = 140 (240 - 80 - 20)
// Expected exit code: 140
//
// Three 8-byte cells. Store 240/80/20 via `*ptr = literal`,
// load all three, a - b - c -> 140. Uses `*ptr = literal` form
// (no offsets). Distinct from s82_cs_three_cell_diff (125),
// s78_cs_three_cell_diff (148) and s74_cs_three_cell_diff (50).
layout Buf_c1 = { data: [u8; 8] }
layout Buf_c2 = { data: [u8; 8] }
layout Buf_c3 = { data: [u8; 8] }

fn main() -> i32 {
    let c1 = state_new(Buf_c1);
    let c2 = state_new(Buf_c2);
    let c3 = state_new(Buf_c3);
    c1.data[0] = 240;
    c2.data[0] = 80;
    c3.data[0] = 20;
    a: u64 = c1.data[0];
    b: u64 = c2.data[0];
    c: u64 = c3.data[0];
    r: u64 = a - b - c;    // 140
    return r;
}
