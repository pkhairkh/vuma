// s100_cs_three_cell_sum.vuma — three cells, sum = 54 (14 + 22 + 18)
// Expected exit code: 54
//
// Three 8-byte cells. Store 14/22/18 via `*ptr = literal`,
// load all, a + b + c -> 54. Uses `*ptr = literal` form
// (no offsets).
// Distinct from s97_cs_three_cell_sum (40), s94_cs_three_cell_sum (90), s90_cs_overwrite_last (8).
layout Buf_c1 = { data: [u8; 8] }
layout Buf_c2 = { data: [u8; 8] }
layout Buf_c3 = { data: [u8; 8] }

fn main() -> i32 {
    let c1 = state_new(Buf_c1);
    let c2 = state_new(Buf_c2);
    let c3 = state_new(Buf_c3);
    c1.data[0] = 14;
    c2.data[0] = 22;
    c3.data[0] = 18;
    a: u64 = c1.data[0];
    b: u64 = c2.data[0];
    c: u64 = c3.data[0];
    s: u64 = a + b + c;    // 54
    return s;
}
