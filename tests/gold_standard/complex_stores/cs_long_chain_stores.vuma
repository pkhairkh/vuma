// s3_cs_long_chain_stores.vuma — 5 stores, 5 loads, sum
// Expected exit code: 150  (10 + 20 + 30 + 40 + 50)
//
// 40-byte buffer; stores five values at 8-byte offsets, loads each
// back and sums them. Tests store/load chain across multiple slots.

layout Buf_buf = { data: [u8; 40] }

fn main() -> i32 {
    let buf = state_new(Buf_buf);
    buf.data[0] = 10;
    buf.data[8] = 20;
    buf.data[16] = 30;
    buf.data[24] = 40;
    buf.data[32] = 50;

    a: u64 = buf.data[0];
    b: u64 = buf.data[8];
    c: u64 = buf.data[16];
    d: u64 = buf.data[24];
    e: u64 = buf.data[32];
    s1: u64 = a + b;
    s2: u64 = s1 + c;
    s3: u64 = s2 + d;
    s4: u64 = s3 + e;

    return s4;
}
