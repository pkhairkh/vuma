// s103_cs_overwrite_middle.vuma — overwrite c2 to 2, load = 2
// Expected exit code: 2
//
// Three 8-byte cells. Store 100 at c1, store 200 at c2, store 50 at c3, then overwrite c2 to 2. Load c2 -> 2 (the overwritten value). Uses `*ptr = literal` form. Straight-line code only.
// Distinct from s100_cs_overwrite_middle (47), s94_cs_overwrite_middle (42).
layout Buf_c1 = { data: [u8; 8] }
layout Buf_c2 = { data: [u8; 8] }
layout Buf_c3 = { data: [u8; 8] }

fn main() -> i32 {
    let c1 = state_new(Buf_c1);
    let c2 = state_new(Buf_c2);
    let c3 = state_new(Buf_c3);
    c1.data[0] = 100;
    c2.data[0] = 200;
    c3.data[0] = 50;
    c2.data[0] = 2;
    v: u64 = c2.data[0];          // 2
    return v;
}
