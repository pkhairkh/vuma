// s43_cs_three_cell_sum.vuma — three cells, sum = 200 (40 + 70 + 90)
// Expected exit code: 200
//
// Three 8-byte cells. Store 40/70/90 via `*ptr = literal`, load all,
// sum -> 200. Uses `*ptr = literal` form (no offsets). Distinct from
// s42_cs_three_cell_xor (195) and s38_cs_three_cell_sum (220).

layout Buf_c1 = { data: [u8; 8] }
layout Buf_c2 = { data: [u8; 8] }
layout Buf_c3 = { data: [u8; 8] }

fn main() -> i32 {
    let c1 = state_new(Buf_c1);
    let c2 = state_new(Buf_c2);
    let c3 = state_new(Buf_c3);
    c1.data[0] = 40;
    c2.data[0] = 70;
    c3.data[0] = 90;
    a: u64 = c1.data[0];
    b: u64 = c2.data[0];
    c: u64 = c3.data[0];
    s: u64 = a + b + c;    // 200
    return s;
}
