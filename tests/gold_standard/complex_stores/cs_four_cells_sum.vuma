// s12_cs_four_cells_sum.vuma — four cells, sum loads = 100 (10+20+30+40)
// Expected exit code: 100
//
// Four independent 8-byte cells. Store 10/20/30/40 via `*ptr =
// literal` form (deterministic on the current backend). All four
// loaded back and summed. Distinct from s9_cs_three_cells_asc
// (3 cells, 5/15/25 = 45) and s10_cs_pattern_4_offsets (uses
// *(p+N) form, non-deterministic).

layout Buf_c1 = { data: [u8; 8] }
layout Buf_c2 = { data: [u8; 8] }
layout Buf_c3 = { data: [u8; 8] }
layout Buf_c4 = { data: [u8; 8] }

fn main() -> i32 {
    let c1 = state_new(Buf_c1);
    let c2 = state_new(Buf_c2);
    let c3 = state_new(Buf_c3);
    let c4 = state_new(Buf_c4);
    c1.data[0] = 10;
    c2.data[0] = 20;
    c3.data[0] = 30;
    c4.data[0] = 40;
    a: u64 = c1.data[0];
    b: u64 = c2.data[0];
    c: u64 = c3.data[0];
    d: u64 = c4.data[0];
    t1: u64 = a + b;
    t2: u64 = t1 + c;
    s: u64 = t2 + d;
    return s;
}
