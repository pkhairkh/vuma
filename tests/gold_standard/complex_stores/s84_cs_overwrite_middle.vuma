// s84_cs_overwrite_middle.vuma — overwrite c2 to 16, load = 16
// Expected exit code: 16
//
// Three 8-byte cells. Store 10 at c1, store 8 at c2 then
// overwrite c2 to 16, store 20 at c3. Load c2 -> 16 (the
// overwritten value). Uses `*ptr = literal` form. Distinct
// from s82_cs_overwrite_middle (220), s78_cs_overwrite_first
// (3) and s74_cs_overwrite_last (191).
layout Buf_c1 = { data: [u8; 8] }
layout Buf_c2 = { data: [u8; 8] }
layout Buf_c3 = { data: [u8; 8] }

fn main() -> i32 {
    let c1 = state_new(Buf_c1);
    let c2 = state_new(Buf_c2);
    let c3 = state_new(Buf_c3);
    c1.data[0] = 10;
    c2.data[0] = 8;
    c2.data[0] = 16;
    c3.data[0] = 20;
    v: u64 = c2.data[0];          // 16
    return v;
}
