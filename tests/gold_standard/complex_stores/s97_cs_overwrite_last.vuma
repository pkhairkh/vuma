// s97_cs_overwrite_last.vuma — overwrite c3 to 53, load = 53
// Expected exit code: 53
//
// Three 8-byte cells. Store 100 at c1, store 200 at c2,
// store 50 at c3, then overwrite c3 to 53. Load c3 -> 53
// (the overwritten value). Uses `*ptr = literal` form.
// Distinct from s94_cs_overwrite_middle (42), s90_cs_overwrite_last (8), s86_cs_overwrite_first (230).
layout Buf_c1 = { data: [u8; 8] }
layout Buf_c2 = { data: [u8; 8] }
layout Buf_c3 = { data: [u8; 8] }

fn main() -> i32 {
    let c1 = state_new(Buf_c1);
    let c2 = state_new(Buf_c2);
    let c3 = state_new(Buf_c3);
    c1.data[0] = 100;
    c2.data[0] = 200;
    c3.data[0] = 50;
    c3.data[0] = 53;
    v: u64 = c3.data[0];          // 53
    return v;
}
