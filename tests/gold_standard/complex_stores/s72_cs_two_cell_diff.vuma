// s72_cs_two_cell_diff.vuma — two cells, diff = 155 (250 - 95)
// Expected exit code: 155
//
// Two 8-byte cells. Store 250/95 via `*ptr = literal`, load
// both, diff -> 155. Uses `*ptr = literal` form (no offsets).
// Distinct from s70_cs_two_cell_diff (90), s69_cs_two_cell_sum
// (145) and s66_cs_two_cell_diff (90).
layout Buf_c1 = { data: [u8; 8] }
layout Buf_c2 = { data: [u8; 8] }

fn main() -> i32 {
    let c1 = state_new(Buf_c1);
    let c2 = state_new(Buf_c2);
    c1.data[0] = 250;
    c2.data[0] = 95;
    a: u64 = c1.data[0];
    b: u64 = c2.data[0];
    d: u64 = a - b;        // 155
    return d;
}
