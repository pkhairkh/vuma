// s52_cs_three_cell_diff.vuma — three cells, diff = 120 (200 - 50 - 30)
// Expected exit code: 120
//
// Three 8-byte cells. Store 200/50/30 via `*ptr = literal`, load all
// three, subtract -> 200 - 50 - 30 = 120. Uses `*ptr = literal` form.
// Distinct from s50_cs_three_cell_diff (130) and s46_cs_two_cell_diff
// (150).

layout Buf_c1 = { data: [u8; 8] }
layout Buf_c2 = { data: [u8; 8] }
layout Buf_c3 = { data: [u8; 8] }

fn main() -> i32 {
    let c1 = state_new(Buf_c1);
    let c2 = state_new(Buf_c2);
    let c3 = state_new(Buf_c3);
    c1.data[0] = 200;
    c2.data[0] = 50;
    c3.data[0] = 30;
    a: u64 = c1.data[0];
    b: u64 = c2.data[0];
    c: u64 = c3.data[0];
    d1: u64 = a - b;       // 150
    r: u64 = d1 - c;       // 120
    return r;
}
