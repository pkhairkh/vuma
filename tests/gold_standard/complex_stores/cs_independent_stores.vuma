// cs_independent_stores.vuma — store in buf1, store in buf2, load buf1
// Expected exit code: 42
//
// Verifies that stores to two independent buffers don't interfere — a
// store into buf2 must not corrupt buf1.

layout Buf_buf1 = { data: [u8; 8] }
layout Buf_buf2 = { data: [u8; 8] }

fn main() -> i32 {
    let buf1 = state_new(Buf_buf1);
    let buf2 = state_new(Buf_buf2);
    buf1.data[0] = 42;
    buf2.data[0] = 99;
    val: u32 = buf1.data[0];
    return val;
}
