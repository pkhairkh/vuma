// s40_cs_three_cell_diff.vuma — three cells, diff = 100 (230 - 95 - 35)
// Expected exit code: 100
//
// Three 8-byte cells. Store 230/95/35 via `*ptr = literal`, load
// all, subtract -> 100. Uses `*ptr = literal` form (no offsets).
// Distinct from s38_cs_three_cell_sum (220) and s34_cs_three_cell_
// sum (210).

layout Buf_c1 = { data: [u8; 8] }
layout Buf_c2 = { data: [u8; 8] }
layout Buf_c3 = { data: [u8; 8] }

fn main() -> i32 {
    let c1 = state_new(Buf_c1);
    let c2 = state_new(Buf_c2);
    let c3 = state_new(Buf_c3);
    c1.data[0] = 230;
    c2.data[0] = 95;
    c3.data[0] = 35;
    a: u64 = c1.data[0];
    b: u64 = c2.data[0];
    c: u64 = c3.data[0];
    t: u64 = a - b;
    d: u64 = t - c;        // 100
    return d;
}
