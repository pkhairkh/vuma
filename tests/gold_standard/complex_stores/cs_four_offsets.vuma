// s6_cs_four_offsets.vuma — scatter 4 values across 32 bytes, sum = 100
// Expected exit code: 100  (10 + 20 + 30 + 40)
//
// 32-byte buffer. Store 10/20/30/40 at offsets 0/8/16/24. Load all
// four, sum, return 100. Distinct from s5_cs_long_scatter (different
// values 10/20/40/60).

layout Buf_buf = { data: [u8; 32] }

fn main() -> i32 {
    let buf = state_new(Buf_buf);
    buf.data[0] = 10;
    buf.data[8] = 20;
    buf.data[16] = 30;
    buf.data[24] = 40;
    a: u64 = buf.data[0];
    b: u64 = buf.data[8];
    c: u64 = buf.data[16];
    d: u64 = buf.data[24];
    t1: u64 = a + b;
    t2: u64 = c + d;
    s: u64 = t1 + t2;
    return s;
}
