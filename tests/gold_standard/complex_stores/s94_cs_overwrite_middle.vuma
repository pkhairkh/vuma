// s94_cs_overwrite_middle.vuma — overwrite c2 to 42, load = 42
// Expected exit code: 42
//
// Three 8-byte cells. Store 100 at c1, store 200 at c2, store 50 at
// c3, then overwrite c2 to 42. Load c2 -> 42 (the overwritten
// value). Uses `*ptr = literal` form. Distinct from
// s90_cs_overwrite_last (8), s86_cs_overwrite_first (230) and
// s82_cs_overwrite_middle (220).
layout Buf_c1 = { data: [u8; 8] }
layout Buf_c2 = { data: [u8; 8] }
layout Buf_c3 = { data: [u8; 8] }

fn main() -> i32 {
    let c1 = state_new(Buf_c1);
    let c2 = state_new(Buf_c2);
    let c3 = state_new(Buf_c3);
    c1.data[0] = 100;
    c2.data[0] = 200;
    c3.data[0] = 50;
    c2.data[0] = 42;
    v: u64 = c2.data[0];          // 42
    return v;
}
