// s3_cs_multi_buf_sum.vuma — 3 buffers each store value, sum loads
// Expected exit code: 90  (15 + 25 + 50)
//
// Three independent 8-byte buffers. Each gets a distinct value; main
// sums all loaded values.

layout Buf_a = { data: [u8; 8] }
layout Buf_b = { data: [u8; 8] }
layout Buf_c = { data: [u8; 8] }

fn main() -> i32 {
    let a = state_new(Buf_a);
    let b = state_new(Buf_b);
    let c = state_new(Buf_c);
    a.data[0] = 15;
    b.data[0] = 25;
    c.data[0] = 50;

    va: u64 = a.data[0];
    vb: u64 = b.data[0];
    vc: u64 = c.data[0];
    s1: u64 = va + vb;
    s2: u64 = s1 + vc;

    return s2;
}
