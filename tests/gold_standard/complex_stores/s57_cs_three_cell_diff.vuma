// s57_cs_three_cell_diff.vuma — three cells, diff = 120 (220 - 70 - 30)
// Expected exit code: 120
//
// Three 8-byte cells. Store 220/70/30 via `*ptr = literal`, load
// each, subtract sequentially -> 120. Uses `*ptr = literal` form
// (no offsets). Distinct from s54_cs_three_cell_diff (80) and s50_cs_
// three_cell_diff (60).

layout Buf_c1 = { data: [u8; 8] }
layout Buf_c2 = { data: [u8; 8] }
layout Buf_c3 = { data: [u8; 8] }

fn main() -> i32 {
    let c1 = state_new(Buf_c1);
    let c2 = state_new(Buf_c2);
    let c3 = state_new(Buf_c3);
    c1.data[0] = 220;
    c2.data[0] = 70;
    c3.data[0] = 30;
    a: u64 = c1.data[0];
    b: u64 = c2.data[0];
    c: u64 = c3.data[0];
    s: u64 = a - b;        // 150
    r: u64 = s - c;        // 120
    return r;
}
