// s90_cs_three_cell_diff.vuma — three cells, diff = 6 (250 - 200 - 44)
// Expected exit code: 6
//
// Three 8-byte cells. Store 250/200/44 via `*ptr = literal`, load
// all three, a - b - c -> 6. Uses `*ptr = literal` form (no offsets).
// Distinct from s86_cs_three_cell_diff (140), s82_cs_three_cell_diff
// (125) and s78_cs_three_cell_diff (148).
layout Buf_c1 = { data: [u8; 8] }
layout Buf_c2 = { data: [u8; 8] }
layout Buf_c3 = { data: [u8; 8] }

fn main() -> i32 {
    let c1 = state_new(Buf_c1);
    let c2 = state_new(Buf_c2);
    let c3 = state_new(Buf_c3);
    c1.data[0] = 250;
    c2.data[0] = 200;
    c3.data[0] = 44;
    a: u64 = c1.data[0];
    b: u64 = c2.data[0];
    c: u64 = c3.data[0];
    r: u64 = a - b - c;    // 6
    return r;
}
