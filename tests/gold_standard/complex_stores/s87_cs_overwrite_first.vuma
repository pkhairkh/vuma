// s87_cs_overwrite_first.vuma — overwrite c1 to 245, load = 245
// Expected exit code: 245
//
// Three 8-byte cells. Store 40 at c1, store 70 at c2, then
// overwrite c1 to 245, store 150 at c3. Load c1 -> 245 (the
// overwritten value). Uses `*ptr = literal` form. Distinct
// from s86_cs_overwrite_first (230), s82_cs_overwrite_middle
// (220) and s78_cs_overwrite_first (3).
layout Buf_c1 = { data: [u8; 8] }
layout Buf_c2 = { data: [u8; 8] }
layout Buf_c3 = { data: [u8; 8] }

fn main() -> i32 {
    let c1 = state_new(Buf_c1);
    let c2 = state_new(Buf_c2);
    let c3 = state_new(Buf_c3);
    c1.data[0] = 40;
    c2.data[0] = 70;
    c1.data[0] = 245;
    c3.data[0] = 150;
    v: u64 = c1.data[0];          // 245
    return v;
}
