// s47_cs_three_cell_diff.vuma — three cells, diff = 110 (220 - 80 - 30)
// Expected exit code: 110
//
// Three 8-byte cells. Store 220/80/30 via `*ptr = literal`, load all,
// subtract sequentially -> 110. Uses `*ptr = literal` form (no
// offsets). Distinct from s46_cs_three_cell_sum (195) and s42_cs_
// three_cell_xor (195).

layout Buf_c1 = { data: [u8; 8] }
layout Buf_c2 = { data: [u8; 8] }
layout Buf_c3 = { data: [u8; 8] }

fn main() -> i32 {
    let c1 = state_new(Buf_c1);
    let c2 = state_new(Buf_c2);
    let c3 = state_new(Buf_c3);
    c1.data[0] = 220;
    c2.data[0] = 80;
    c3.data[0] = 30;
    a: u64 = c1.data[0];
    b: u64 = c2.data[0];
    c: u64 = c3.data[0];
    t: u64 = a - b;        // 140
    d: u64 = t - c;        // 110
    return d;
}
