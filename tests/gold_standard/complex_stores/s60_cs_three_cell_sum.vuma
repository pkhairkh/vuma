// s60_cs_three_cell_sum.vuma — three cells, sum = 215 (70 + 85 + 60)
// Expected exit code: 215
//
// Three 8-byte cells. Store 70/85/60 via `*ptr = literal`, load
// all three, sum -> 215. Uses `*ptr = literal` form (no offsets).
// Distinct from s58_cs_three_cell_diff (120) and s57_cs_three_cell_
// diff (120).

layout Buf_c1 = { data: [u8; 8] }
layout Buf_c2 = { data: [u8; 8] }
layout Buf_c3 = { data: [u8; 8] }

fn main() -> i32 {
    let c1 = state_new(Buf_c1);
    let c2 = state_new(Buf_c2);
    let c3 = state_new(Buf_c3);
    c1.data[0] = 70;
    c2.data[0] = 85;
    c3.data[0] = 60;
    a: u64 = c1.data[0];
    b: u64 = c2.data[0];
    c: u64 = c3.data[0];
    t: u64 = a + b;
    s: u64 = t + c;        // 215
    return s;
}
