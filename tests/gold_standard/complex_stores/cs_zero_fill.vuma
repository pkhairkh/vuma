// cs_zero_fill.vuma — fill 4 bytes with 0, load
// Expected exit code: 0
//
// Stores four zero bytes (zero-fill pattern), then loads one back.

layout Buf_buf = { data: [u8; 8] }

fn main() -> i32 {
    let buf = state_new(Buf_buf);
    buf.data[0] = 0;
    buf.data[1] = 0;
    buf.data[2] = 0;
    buf.data[3] = 0;
    val: u32 = buf.data[0];
    return val;
}
