// s55_cs_three_cell_sum.vuma — three cells, sum = 255 (70 + 85 + 100)
// Expected exit code: 255
//
// Three 8-byte cells. Store 70/85/100 via `*ptr = literal`, load all
// three, sum sequentially -> 255. Uses `*ptr = literal` form (no
// offsets). Distinct from s54_cs_three_cell_diff (80) and
// s53_cs_three_cell_sum (220).

layout Buf_c1 = { data: [u8; 8] }
layout Buf_c2 = { data: [u8; 8] }
layout Buf_c3 = { data: [u8; 8] }

fn main() -> i32 {
    let c1 = state_new(Buf_c1);
    let c2 = state_new(Buf_c2);
    let c3 = state_new(Buf_c3);
    c1.data[0] = 70;
    c2.data[0] = 85;
    c3.data[0] = 100;
    a: u64 = c1.data[0];
    b: u64 = c2.data[0];
    c: u64 = c3.data[0];
    t: u64 = a + b;
    s: u64 = t + c;        // 255
    return s;
}
