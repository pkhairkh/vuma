// cs_store_load_store.vuma — store 42, load, store 99, load again
// Expected exit code: 99
//
// Exercises the store→load→store→load sequence on a single byte slot.
// After the second store the slot holds 99, so the final load yields 99.

layout Buf_buf = { data: [u8; 8] }

fn main() -> i32 {
    let buf = state_new(Buf_buf);
    buf.data[0] = 42;
    first: u32 = buf.data[0];
    buf.data[0] = 99;
    second: u32 = buf.data[0];
    return second;
}
