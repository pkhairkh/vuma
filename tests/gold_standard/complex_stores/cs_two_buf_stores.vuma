// s4_cs_two_buf_stores.vuma — two buffers, cross-sum of loads = 130
// Expected exit code: 130  (40 + 50 + 10 + 30)
//
// Two 8-byte buffers. Store 40 in buf1[0], 10 in buf1[8], 50 in
// buf2[0], 30 in buf2[8]. Load all four, sum. Tests multi-buffer,
// multi-offset store/load correctness.

layout Buf_buf1 = { data: [u8; 16] }
layout Buf_buf2 = { data: [u8; 16] }

fn main() -> i32 {
    let buf1 = state_new(Buf_buf1);
    let buf2 = state_new(Buf_buf2);
    buf1.data[0] = 40;
    buf1.data[8] = 10;
    buf2.data[0] = 50;
    buf2.data[8] = 30;
    a: u64 = buf1.data[0];
    b: u64 = buf1.data[8];
    c: u64 = buf2.data[0];
    d: u64 = buf2.data[8];
    s: u64 = a + b + c + d;
    return s;
}
