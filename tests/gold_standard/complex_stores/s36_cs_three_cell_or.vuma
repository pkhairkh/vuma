// s36_cs_three_cell_or.vuma — cells 128/64/32, OR = 224
// Expected exit code: 224
//
// Three 8-byte cells. Store 128/64/32 via `*ptr = literal`,
// load all three, OR -> 0xE0 = 224. All bitwise operands
// loaded into u64 variables first. Uses `*ptr = literal`
// form (no offsets).
// Distinct from s30_cs_three_cell_xor (xor, 0) and s27_cs_three_cell_or (different values).

layout Buf_c1 = { data: [u8; 8] }
layout Buf_c2 = { data: [u8; 8] }
layout Buf_c3 = { data: [u8; 8] }

fn main() -> i32 {
    let c1 = state_new(Buf_c1);
    let c2 = state_new(Buf_c2);
    let c3 = state_new(Buf_c3);
    c1.data[0] = 128;             // 0x80
    c2.data[0] = 64;              // 0x40
    c3.data[0] = 32;              // 0x20
    a: u64 = c1.data[0];
    b: u64 = c2.data[0];
    d: u64 = c3.data[0];
    x: u64 = a | b;        // 0xC0 = 192
    r: u64 = x | d;        // 0xE0 = 224
    return r;
}
