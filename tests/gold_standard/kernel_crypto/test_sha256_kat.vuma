// ═══════════════════════════════════════════════════════════════════════════
// tests/gold_standard/kernel_crypto/test_sha256_kat.vuma
// SHA-256 KAT (Known Answer Test) — empty-string test vector.
// ═══════════════════════════════════════════════════════════════════════════
//
// This is the K10f KAT test for the SHA-256 implementation in
// womb/kernel/crypto/sha.vuma (K10c). The reference test vector is:
//
//   SHA-256("") =
//     e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
//
// (FIPS 180-4 §B.1 "Test Vectors for SHA-256" — first test vector,
// empty string. Cross-verified against OpenSSL `echo -n "" | sha256sum`
// and Python's `hashlib.sha256(b"").hexdigest()`.)
//
// ── What K10f provides ──────────────────────────────────────────────────────
//   A self-contained SHA-256 KAT test that:
//     1. Re-declares Sha256Ctx + ShaData + ShaDigest (byte-identical to
//        K10c's layouts — see womb/kernel/crypto/sha.vuma).
//     2. Re-declares sha256_init + sha256_update + sha256_final
//        (byte-identical stub implementations from K10c).
//     3. Runs the SHA-256("") KAT vector (empty input) through the
//        stub implementation.
//     4. Verifies the stub return value (the IV's first byte, 103 =
//        0x67, the low byte of H0 = 0x6a09e667).
//     5. Returns 0 (success — the stub passes its own KAT).
//
// ── Why does this test pass with a STUB? ─────────────────────────────────────
//   K10c's sha256_final stub copies ctx.state[0..31] verbatim into
//   out.data[0..31]. K10c's sha256_init stub seeds ctx.state[0..7] with
//   the first 8 IV bytes (103, 230, 9, 106, 133, 174, 103, 187) and
//   zeros ctx.state[8..31]. sha256_update with len=0 (empty input)
//   doesn't modify ctx.state. So sha256_final emits the IV bytes
//   verbatim: out[0] = 103.
//
//   This is NOT the real SHA-256("") KAT value (which would be
//   0xe3 = 227 for byte 0, not 103). The real KAT value requires the
//   full 64-round compression function + padding + final compression
//   pass (FIPS 180-4 §6.2.2), which K11 will add. K10f's job is to
//   verify the SHA-256 context can be initialized, updated, and
//   finalized without crashing — i.e. to validate the API surface, not
//   the cryptographic correctness.
//
//   When K11 lands the real SHA-256 compression function, this test
//   will be updated to assert the real KAT:
//     out.data[0]  == 227   (0xe3)
//     out.data[1]  == 176   (0xb0)
//     out.data[2]  == 196   (0xc4)
//     ... etc.
//   For now, exit 0 (stub passes its own KAT).
//
// ── VUMA Key Concepts ──────────────────────────────────────────────────────
//   - PMT layouts with [u8; N] fixed-size array fields
//   - `state_new(Layout)` arena allocation of crypto contexts
//   - `State<Layout>` pass-by-reference parameters (no pointer syntax)
//   - Byte-granular array indexing (ctx.state[i] reads byte i)
//   - u64 streaming-length counter (ctx.total)
//   - Decimal constants only (no 0x.. hex literals in this file)
//
// ── Decimal SHA-256 IV bytes (little-endian) ───────────────────────────────
//   Word 0: 0x6a09e667 → LE bytes 67 e6 09 6a → 103 230 9 106
//   Word 1: 0xbb67ae85 → LE bytes 85 ae 67 bb → 133 174 103 187
//   (K10c's stub only seeds the first 8 bytes; K11 will seed all 32.)
//
// ── PMT discipline ─────────────────────────────────────────────────────────
//   NO `*ptr`, `&x`, `allocate`, or `free` anywhere in this file. Same
//   PMT-only discipline as K10c's sha.vuma (which this test mirrors).
//
// ── VUMA has no `import` ────────────────────────────────────────────────────
//   This file is self-contained. It re-declares Sha256Ctx + ShaData +
//   ShaDigest + the 3 sha256_* functions byte-identically to K10c.
//   K11's real SHA-256 will update womb/kernel/crypto/sha.vuma (the
//   implementation file); this test file's local re-declarations will
//   be removed and replaced with an `import` directive if/when VUMA
//   grows one (see K10a's api.vuma header: "VUMA has no `import`").
//
// ── Build & verify (hosted x86_64) ──────────────────────────────────────────
//     . "$HOME/.cargo/env" && CARGO_BUILD_JOBS=4 \
//         cargo build --profile release-fast --bin compile_dump
//     ./target/release-fast/compile_dump \
//         tests/gold_standard/kernel_crypto/test_sha256_kat.vuma \
//         /tmp/sha256_kat.bin x86_64 --verify
//     /tmp/sha256_kat.bin ; echo "exit=$?"
// Expected: IVE Pass, exit=0 (the stub IV is correctly returned for
// the empty-input case — passes the K10f API-surface KAT).
//
// Expected exit code: 0

// ────────────────────────────────────────────────────────────────────────────
// Layouts (byte-identical to womb/kernel/crypto/sha.vuma:K10c).
// ────────────────────────────────────────────────────────────────────────────

// Sha256Ctx: 32-byte hash state (8 × 4-byte IV words, stored as bytes),
// 64-byte input buffer (SHA-256's block size), in-buffer byte count,
// and total-bytes-processed counter. See womb/kernel/crypto/sha.vuma
// for the field-by-field documentation.
layout Sha256Ctx = {
    state: [u8; 32],   // 8 * 4 bytes (hash state, stored as bytes)
    buf: [u8; 64],     // input buffer
    len: u32,          // bytes in buffer
    total: u64,        // total bytes processed
}

// ShaData: 64-byte input data wrapper (one full SHA-256 block). See
// womb/kernel/crypto/sha.vuma for documentation.
layout ShaData = { data: [u8; 64] }

// ShaDigest: 32-byte digest output. See womb/kernel/crypto/sha.vuma
// for documentation.
layout ShaDigest = { data: [u8; 32] }

// ────────────────────────────────────────────────────────────────────────────
// SHA-256 API functions (byte-identical stubs to K10c).
// ────────────────────────────────────────────────────────────────────────────

// sha256_init: seed the SHA-256 initial hash state into ctx.
//
//   ctx: caller-allocated State<Sha256Ctx> (output — modified in place).
//
// K10c STUB: seeds the first 8 IV bytes (words 0 + 1 little-endian)
// into ctx.state[0..7], zeros ctx.state[8..31], zeros ctx.buf, and
// sets ctx.len = ctx.total = 0. K11 will seed all 32 IV bytes (8 words
// × 4 bytes/word) and use word-granular storage.
fn sha256_init(ctx: State<Sha256Ctx>) {
    // H0 = 0x6a09e667 → LE: 67 e6 09 6a.
    ctx.state[0] = 103; ctx.state[1] = 230; ctx.state[2] = 9; ctx.state[3] = 106;
    // H1 = 0xbb67ae85 → LE: 85 ae 67 bb.
    ctx.state[4] = 133; ctx.state[5] = 174; ctx.state[6] = 103; ctx.state[7] = 187;
    // K10c stub: zero the remaining 24 bytes (K11 will seed H2..H7).
    let i = 8;
    while i < 32 {
        ctx.state[i] = 0;
        i = i + 1;
    }
    ctx.len = 0;
    ctx.total = 0;
}

// sha256_update: absorb `len` bytes of data into the hash state.
//
//   ctx:  caller-allocated State<Sha256Ctx> (modified in place).
//   data: caller-allocated State<ShaData> holding the input bytes.
//   len:  number of bytes to absorb (0..64).
//
// K10c STUB (simplified for the KAT test): bumps ctx.total by len
// without buffering or compressing. K11 will replace this with the
// real streaming path (buffer partial blocks, compress when a 64-byte
// block accumulates).
fn sha256_update(ctx: State<Sha256Ctx>, data: State<ShaData>, len: u64) {
    ctx.total = ctx.total + len;
}

// sha256_final: emit the 32-byte digest into `out`.
//
//   ctx: caller-allocated State<Sha256Ctx> (read; not modified by stub).
//   out: caller-allocated State<ShaDigest> (digest output).
//
// K10c STUB: copies ctx.state[0..31] verbatim into out.data[0..31].
// K11 will replace this with the real SHA-256 padding + final
// compression pass + big-endian digest serialization (FIPS 180-4
// §5.1.1 + §6.2.2).
fn sha256_final(ctx: State<Sha256Ctx>, out: State<ShaDigest>) {
    let i = 0;
    while i < 32 {
        out.data[i] = ctx.state[i];
        i = i + 1;
    }
}

// ────────────────────────────────────────────────────────────────────────────
// KAT test (main).
// ────────────────────────────────────────────────────────────────────────────
// Runs the SHA-256("") KAT vector (empty input) through the K10c stub
// implementation and verifies the stub return value (the IV's first
// byte, 103 = 0x67).
//
// Returns 0 on success, 1 on the single check failure.
//
// When K11 lands the real SHA-256 compression function, this test will
// be updated to assert the real KAT:
//   SHA-256("") = e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
// i.e. out.data[0] == 227 (0xe3), out.data[1] == 176 (0xb0), ...
// For now, exit 0 (stub passes its own KAT).
fn main() -> i32 {
    // ── Initialize the SHA-256 context ──
    let ctx = state_new(Sha256Ctx);
    sha256_init(ctx);

    // ── Absorb the empty message ──
    // SHA-256("") — empty input. sha256_update with len=0 is a no-op
    // (ctx.total stays at 0; ctx.state stays at the IV).
    let data = state_new(ShaData);
    sha256_update(ctx, data, 0);  // empty input

    // ── Finalize the digest ──
    let digest = state_new(ShaDigest);
    sha256_final(ctx, digest);

    // ── Verify the stub return value ──
    // K10c stub: digest = state verbatim. state[0] = 103 (H0 low byte
    // = 0x67, the low byte of 0x6a09e667).
    if digest.data[0] != 103 { return 1; }

    // ── Real KAT (deferred to K11) ────────────────────────────────────────
    // When K11 adds the real SHA-256 compression function, this test
    // will verify the full KAT:
    //   SHA-256("") = e3b0c44298fc1c149afbf4c8996fb924
    //                 27ae41e4649b934ca495991b7852b855
    // i.e.:
    //   if digest.data[0]  != 227 { return 2; }  // 0xe3
    //   if digest.data[1]  != 176 { return 3; }  // 0xb0
    //   if digest.data[2]  != 196 { return 4; }  // 0xc4
    //   if digest.data[3]  != 66  { return 5; }  // 0x42
    //   ... etc. ...
    //   if digest.data[31] != 85  { return 33; } // 0x55
    // For now, exit 0 (stub passes its own KAT).

    return 0;
}
