// matrix_det — 2x2 matrix determinant and trace.
// Expected exit code: 10
//
// M = [[2.0, 3.0], [4.0, 5.0]]
// det = 2*5 - 3*4 = 10 - 12 = -2
// trace = 2 + 5 = 7
// Return floattoint(trace + det + 5.0) = floattoint(7 - 2 + 5) = 10.

fn main() -> i32 {
    m00: f64 = 2.0;
    m01: f64 = 3.0;
    m10: f64 = 4.0;
    m11: f64 = 5.0;
    det: f64 = m00 * m11 - m01 * m10;
    trace: f64 = m00 + m11;
    five: f64 = 5.0;
    result: f64 = trace + det + five;
    return floattoint(result);
}
