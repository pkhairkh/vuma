// bsearch_float — Binary search for 7.0 in a sorted f64 array.
// Expected exit code: 1
//
// Array: [1.0, 3.0, 5.0, 7.0, 9.0, 11.0, 13.0]
// Search for 7.0 — found at index 3.  Return 1 (found).
// Exercises:
//   - f64 < and == comparisons (the core of binary search)
//   - f64 array memory access
//   - inttofloat (mid index -> f64 for... no, we compare array[mid] to target)
//   - G1 fix critical: the < and == comparisons must use FP compare, not
//     integer CMP on bits (would break for negative floats, though this
//     test uses positives — still, exercises the G1-fixed path).

fn main() -> i32 {
    n: i64 = 7;
    ptr = allocate(56);  // 7 * 8
    // Fill: [1, 3, 5, 7, 9, 11, 13]
    v: i64 = 1;
    i: i64 = 0;
    while i < n {
        slot = ptr + (i * 8);
        vf: f64 = inttofloat(v);
        *(slot) = vf;
        v = v + 2;
        i = i + 1;
    }
    target: f64 = 7.0;
    lo: i64 = 0;
    hi: i64 = n - 1;
    found: i64 = 0;
    while lo <= hi {
        mid: i64 = (lo + hi) / 2;
        slot = ptr + (mid * 8);
        midval: f64 = *slot;
        if midval == target {
            found = 1;
            lo = hi + 1;  // force exit
        } else {
            if midval < target {
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }
    }
    free(ptr);
    return found;
}
