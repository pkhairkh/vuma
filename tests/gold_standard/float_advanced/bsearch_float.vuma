// bsearch_float — Binary search for 7.0 in a sorted f64 array.
// Expected exit code: 1
//
// Array: [1.0, 3.0, 5.0, 7.0, 9.0, 11.0, 13.0]
// Search for 7.0 — found at index 3.  Return 1 (found).
// Exercises:
//   - f64 < and == comparisons (the core of binary search)
//   - f64 array memory access via State<T> layout
//   - G1 fix critical: the < and == comparisons must use FP compare.

layout Array7 = { data: [f64; 7] }

fn main() -> i32 {
    let arr = state_new(Array7);
    // Fill: [1, 3, 5, 7, 9, 11, 13]
    let v = 1;
    let i = 0;
    while i < 7 {
        let vf = inttofloat(v);
        arr.data[i] = vf;
        v = v + 2;
        i = i + 1;
    }
    let target = 7.0;
    let lo = 0;
    let hi = 6;
    let found = 0;
    while lo <= hi {
        let mid = (lo + hi) / 2;
        let midval = arr.data[mid];
        if midval == target {
            found = 1;
            lo = hi + 1;  // force exit
        } else {
            if midval < target {
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }
    }
    return found;
}
