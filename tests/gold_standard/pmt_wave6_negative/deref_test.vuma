// deref_test.vuma — Wave 6 negative test: uses `*ptr` (dereference)
// Expected exit code: 42
//
// Default mode: compiles with deprecation warnings (allocate + deref),
// runs, exits 42.
// --pmt-only mode: hard compile error (pointer syntax '*ptr (deref)'
// rejected).
//
// The PMT replacement reads state fields via `state.field` (which lowers
// to a typed Load at the field's offset).

fn main() -> i32 {
    buf = allocate(8);
    *buf = 42;
    v = *buf;
    free(buf);
    return v;
}
