// addrof_test.vuma — Wave 6 negative test: uses `&main` (address-of)
// Expected exit code: 0
//
// Default mode: compiles with a deprecation warning for `&main`, runs,
// exits 0.  The address-of produces a `GetAddress("main")` relocation
// that resolves to main's entry point; the result is never dereferenced
// so the program returns 0 cleanly.
// --pmt-only mode: hard compile error (pointer syntax '&x (address-of)'
// rejected at the `&` token).
//
// The PMT model has no address-of: state buffers are first-class values
// produced by `state_new(Layout)` and consumed by transforms; there is no
// way (or need) to take the address of a stack local or function.

fn main() -> i32 {
    p = &main;
    return 0;
}
