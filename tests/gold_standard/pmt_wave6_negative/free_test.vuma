// free_test.vuma — Wave 6 negative test: uses `free(ptr)` (pointer syntax)
// Expected exit code: 0
//
// Default mode: compiles with a deprecation warning, runs, exits 0.
// --pmt-only mode: hard compile error (pointer syntax 'free' rejected).
//
// The PMT model has no `free`: states are consumed by transforms (linear
// ownership), so explicit deallocation is unnecessary.

fn main() -> i32 {
    buf = allocate(32);
    free(buf);
    return 0;
}
