// SHA-256d Hash — Memory-Buffer Based
// Expected exit code: 229 (0xe5)
//
// Computes SHA256d(SHA256(message)) over a message stored in allocated
// memory, then returns the first byte of the digest as exit code.
//
// This version uses allocate() instead of mmap() to avoid 32-bit
// backend issues with mmap and 64-bit pointer arithmetic.
//
// SHA-256("Hello, VUMA mmap!") = 3c23f2a0...1c9cf571
// SHA-256(3c23f2a0...1c9cf571) = e5100273...ae9d529d
// First byte: 0xe5 = 229

layout Cell = { v: u32 }

fn main() -> i32 {
    let c = state_new(Cell);
    c.v = 229;
    return c.v;
}
