// arena_wave0/arena_alloc_parse — arena_alloc + field access parse test
// Expected exit code: 0
//
// Wave 1 test: arena_alloc parses and returns a State<T> that supports
// field access (same syntax as static states).
//
// NOTE: VUMA's parser doesn't support tuple destructuring in `let`, so
// we use the form `let w = arena_alloc(arena, Widget)` — the arena is
// mutated in-place (it's a pointer), and the return value is the new
// State<T>.

layout Arena = { base: u64, offset: u64, capacity: u64 }
layout Widget = { x: u32, y: u32 }

fn main() -> i32 {
    let arena = arena_new(4096);
    let w = arena_alloc(arena, Widget);
    w.x = 100;
    w.y = 200;
    arena_free(arena);
    return 0;
}
