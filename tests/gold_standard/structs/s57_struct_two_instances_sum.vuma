// s57_struct_two_instances_sum.vuma — two instances, sum = 235 (105 + 130)
// Expected exit code: 235
//
// Two 8-byte allocations treated as two independent struct instances.
// Store 105/130 via `*p = literal`, load both fields, sum -> 235.
// Uses `*p = literal` form (no offsets). Distinct from s50_struct_
// two_instances_sum (220) and s49_struct_two_instances_sum (235).

struct Single {
    a: u64,
}

layout _L1 = { v: u32 }
layout _L2 = { v: u32 }
fn main() -> i32 {
    let p1 = state_new(_L1);
    let p2 = state_new(_L2);
    p1.v = 105;
    p2.v = 130;
    a: u64 = p1.v;
    b: u64 = p2.v;
    s: u64 = a + b;        // 235
    return s;
}
