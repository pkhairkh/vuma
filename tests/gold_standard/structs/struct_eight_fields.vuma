// struct_eight_fields.vuma — eight-field struct, sum all fields
// Expected exit code: 36
//
// Allocates an Eight struct (64 bytes, 8 × u64), stores 1..8 at
// offsets 0, 8, 16, ..., 56, then loads and sums them.
// 1 + 2 + 3 + ... + 8 = 36.

struct Eight {
    f0: u64,
    f1: u64,
    f2: u64,
    f3: u64,
    f4: u64,
    f5: u64,
    f6: u64,
    f7: u64,
}

layout _L1 = { data: [u8; 64] }
fn main() -> i32 {
    let e = state_new(_L1);
    e.data[0] = 1;
    e.data[8] = 2;
    e.data[16] = 3;
    e.data[24] = 4;
    e.data[32] = 5;
    e.data[40] = 6;
    e.data[48] = 7;
    e.data[56] = 8;
    v0: u64 = e.data[0];
    v1: u64 = e.data[8];
    v2: u64 = e.data[16];
    v3: u64 = e.data[24];
    v4: u64 = e.data[32];
    v5: u64 = e.data[40];
    v6: u64 = e.data[48];
    v7: u64 = e.data[56];
    sum: u64 = v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7;
    return sum;
}
