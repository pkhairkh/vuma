// s45_struct_two_instances_diff.vuma — two instances, diff = 90 (130 - 40)
// Expected exit code: 90
//
// Two 8-byte allocations treated as two independent struct
// instances. Store 130/40 via `*p = literal`, load both fields,
// subtract -> 90. Uses `*p = literal` form (no offsets). Distinct
// from s42_struct_two_instances_sum (sum, 205) and s34_struct_two_
// instances_sum (205).

struct Single {
    a: u64,
}

layout _L1 = { v: u32 }
layout _L2 = { v: u32 }
fn main() -> i32 {
    let p1 = state_new(_L1);
    let p2 = state_new(_L2);
    p1.v = 130;
    p2.v = 40;
    a: u64 = p1.v;
    b: u64 = p2.v;
    d: u64 = a - b;        // 90
    return d;
}
