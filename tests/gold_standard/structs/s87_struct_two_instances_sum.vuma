// s87_struct_two_instances_sum.vuma — two instances, sum = 185 (85 + 100)
// Expected exit code: 185
//
// Two 8-byte allocations treated as two independent struct
// instances. Store 85/100 via `*p = literal`, load both fields,
// sum -> 185. Uses `*p = literal` form (no offsets). Distinct
// from s86_struct_two_instances_sum (210), s82_struct_two_
// instances_sum (165) and s78_struct_two_instances_sum (3).
struct Single {
    a: u64,
}

layout _L1 = { v: u32 }
layout _L2 = { v: u32 }
fn main() -> i32 {
    let p1 = state_new(_L1);
    let p2 = state_new(_L2);
    p1.v = 85;
    p2.v = 100;
    a: u64 = p1.v;
    b: u64 = p2.v;
    s: u64 = a + b;        // 185
    return s;
}
