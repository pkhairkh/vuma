// s4_struct_field_sum.vuma — {a=10, b=20, c=30}; sum = 60
// Expected exit code: 60
//
// 24-byte struct (three u64 fields), stores 10/20/30 at offsets
// 0/8/16, loads all three, sums, returns 60.

struct Triple {
    a: u64,
    b: u64,
    c: u64,
}

layout _L1 = { data: [u8; 24] }
fn main() -> i32 {
    let p = state_new(_L1);
    p.data[0] = 10;
    p.data[8] = 20;
    p.data[16] = 30;
    a: u64 = p.data[0];
    b: u64 = p.data[8];
    c: u64 = p.data[16];
    s: u64 = a + b + c;
    return s;
}
