// s55_struct_field_load.vuma — store 175, load 175
// Expected exit code: 175
//
// Single 8-byte allocation treated as a one-field struct. Store 175
// via `*p = literal`, load and return 175. Uses `*p = literal` form
// (no offsets). Distinct from s50_struct_field_load (135) and
// s53_struct_field_load (152).

struct Single {
    a: u64,
}

layout _L1 = { v: u32 }
fn main() -> i32 {
    let p = state_new(_L1);
    p.v = 175;
    a: u64 = p.v;
    return a;
}
