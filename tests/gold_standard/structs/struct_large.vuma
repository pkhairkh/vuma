// struct_large.vuma — 64-byte struct (8 × u64), access last field
// Expected exit code: 42
//
// Allocates a 64-byte struct (8 u64 fields). Stores 42 only in the
// last field (offset 56) and returns it. Verifies that field access
// works at large constant offsets, not just the first few fields.

struct Large {
    f0: u64,
    f1: u64,
    f2: u64,
    f3: u64,
    f4: u64,
    f5: u64,
    f6: u64,
    f7: u64,
}

layout _L1 = { data: [u8; 64] }
fn main() -> i32 {
    let p = state_new(_L1);
    p.data[56] = 42;
    val: u64 = p.data[56];
    return val;
}
