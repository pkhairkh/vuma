// s84_struct_field_load.vuma — single field, store 35, load = 35
// Expected exit code: 35
//
// One 8-byte allocation treated as a single-field struct instance.
// Store 35 via `*p = literal`, load the field, return 35.
// Uses `*p = literal` form (no offsets). Distinct from s82_struct_
// field_load (25), s78_struct_field_load (1) and s74_struct_
// field_load (193).
struct Single {
    a: u64,
}

layout _L1 = { v: u32 }
fn main() -> i32 {
    let p1 = state_new(_L1);
    p1.v = 35;
    a: u64 = p1.v;
    return a;
}
