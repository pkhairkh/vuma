// s27_struct_field_load.vuma — store 205, load = 205
// Expected exit code: 205
//
// Single 8-byte allocation treated as a one-field struct. Store the
// literal 205 via `*p = literal`, load it back, return. Uses `*p =
// literal` form (no offsets). Distinct from s26_struct_field_load
// (different value, 222) and s22_struct_field_load (different value).

struct Single {
    a: u64,
}

layout _L1 = { v: u32 }
fn main() -> i32 {
    let p1 = state_new(_L1);
    p1.v = 205;
    a: u64 = p1.v;
    return a;
}
