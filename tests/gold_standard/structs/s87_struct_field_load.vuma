// s87_struct_field_load.vuma — single field, store 135, load = 135
// Expected exit code: 135
//
// One 8-byte allocation treated as a single-field struct instance.
// Store 135 via `*p = literal`, load the field, return 135.
// Uses `*p = literal` form (no offsets). Distinct from s86_struct_
// field_load (145), s78_struct_field_load (1) and s72_struct_
// field_load (225).
struct Single {
    a: u64,
}

layout _L1 = { v: u32 }
fn main() -> i32 {
    let p1 = state_new(_L1);
    p1.v = 135;
    a: u64 = p1.v;
    return a;
}
