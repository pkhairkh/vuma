// s86_struct_two_instances_sum.vuma — two instances, sum = 210 (95 + 115)
// Expected exit code: 210
//
// Two 8-byte allocations treated as two independent struct
// instances. Store 95/115 via `*p = literal`, load both fields,
// sum -> 210. Uses `*p = literal` form (no offsets). Distinct
// from s82_struct_two_instances_sum (165), s78_struct_two_
// instances_sum (3) and s74_struct_two_instances_sum (137).
struct Single {
    a: u64,
}

layout _L1 = { v: u32 }
layout _L2 = { v: u32 }
fn main() -> i32 {
    let p1 = state_new(_L1);
    let p2 = state_new(_L2);
    p1.v = 95;
    p2.v = 115;
    a: u64 = p1.v;
    b: u64 = p2.v;
    s: u64 = a + b;        // 210
    return s;
}
