// s90_struct_two_instances_diff.vuma — two instances, diff = 39 (200 - 161)
// Expected exit code: 39
//
// Two 8-byte allocations treated as two independent struct
// instances. Store 200/161 via `*p = literal`, load both fields,
// a - b -> 39. Uses `*p = literal` form (no offsets). Distinct
// from s86_struct_two_instances_sum (210), s82_struct_two_
// instances_sum (165) and s78_struct_two_instances_sum (3).
struct Single {
    a: u64,
}

layout _L1 = { v: u32 }
layout _L2 = { v: u32 }
fn main() -> i32 {
    let p1 = state_new(_L1);
    let p2 = state_new(_L2);
    p1.v = 200;
    p2.v = 161;
    a: u64 = p1.v;
    b: u64 = p2.v;
    d: u64 = a - b;        // 39
    return d;
}
