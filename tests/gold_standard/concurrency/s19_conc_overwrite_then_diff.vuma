// Migrated from concurrency/s19_conc_overwrite_then_diff.vuma
// Expected exit code: 20
//
// PMT migration: allocate/free/*ptr replaced with state_new(Layout)
// + field access. Buffer lifetime auto-managed.

layout Pair = { a: u32, b: u32 }

fn main() -> i32 {
    let __s = state_new(Pair);
    __s.a = 100;
    __s.a = 30;
    __s.b = 50;
    let a = __s.a;
    let b = __s.b;
    let s = b - a;
    return s;
}
