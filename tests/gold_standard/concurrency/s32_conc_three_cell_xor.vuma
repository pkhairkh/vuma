// Migrated from concurrency/s32_conc_three_cell_xor.vuma
// Expected exit code: 255
//
// PMT migration: allocate/free/*ptr replaced with state_new(Layout)
// + field access. Buffer lifetime auto-managed.

layout Triple = { a: u32, b: u32, c: u32 }

fn main() -> i32 {
    let __s = state_new(Triple);
    __s.a = 170;
    __s.b = 85;
    __s.c = 0;
    let v1 = __s.a;
    let v2 = __s.b;
    let v3 = __s.c;
    let t = v1 ^ v2;
    let r = t ^ v3;
    return r;
}
