layout Triple = { a: u32, b: u32, c: u32 }

fn main() -> i32 {
    let __s = state_new(Triple);
    __s.a = 200;
    __s.b = 55;
    __s.c = 30;
    let v1 = __s.a;
    let v2 = __s.b;
    let v3 = __s.c;
    let t = v1 - v2;
    let d = t - v3;
    return d;
}
