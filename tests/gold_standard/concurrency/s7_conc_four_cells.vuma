// Migrated from concurrency/s7_conc_four_cells.vuma
// Expected exit code: 50
//
// PMT migration: allocate/free/*ptr replaced with state_new(Layout)
// + field access. Buffer lifetime auto-managed.

layout Quad = { a: u32, b: u32, c: u32, d: u32 }

fn main() -> i32 {
    let __s = state_new(Quad);
    __s.a = 5;
    __s.b = 10;
    __s.c = 15;
    __s.d = 20;
    let v1 = __s.a;
    let v2 = __s.b;
    let v3 = __s.c;
    let v4 = __s.d;
    let t1 = v1 + v2;
    let t2 = v3 + v4;
    let s = t1 + t2;
    return s;
}
