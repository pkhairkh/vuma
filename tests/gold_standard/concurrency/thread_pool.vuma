// Thread Pool - sequential simulation of a worker-pool pattern
// Expected exit code: 0
//
// The original test used `spawn()` to create real worker threads and a
// Mutex/Condvar-protected task queue. VUMA does not implement threads
// or `spawn()` in the compile_dump codegen bridge, so this rewrite
// simulates the SAME pattern sequentially:
//   - Tasks are stored in an array (the "task queue")
//   - A worker function processes one task at a time, in order
//   - Results are collected in an output array
//   - A checksum over the results verifies that every task ran
//
// VUMA Key Concepts preserved:
//   - TaskQueue with head/tail/length fields (originally a struct, now
//     represented as offsets in a single allocation)
//   - Per-task function-pointer dispatch (originally `call(func, arg)`;
//     here we use a task-id switch to pick the worker function)
//   - Result aggregation (the original summed results implicitly via
//     `print`; here we sum explicitly into a checksum)
//   - Clean shutdown: all task allocations freed before pool teardown
//
// Implementation notes:
//   - VUMA method calls (`(*queue).lock()`, `Mutex::new(...)`) are not
//     supported by the bridge; the queue is a plain byte buffer with
//     explicit field offsets.
//   - `allocate(<parameter>)` routes through `__vuma_alloc` and writes
//     through helper functions get silently dropped, so all allocate()
//     calls use literal sizes and writes are inlined where needed.

// ─── Field offsets for the 32-byte TaskQueue header ───────────────────────
//   offset  0: head         (u64) — index of next task to pop
//   offset  8: tail         (u64) — index of next free slot for push
//   offset 16: len          (u64) — current number of pending tasks
//   offset 24: capacity     (u64) — max tasks before push fails

// ─── Read/write u64 helpers (read-only-from-function works reliably) ────
fn read_u64(buf: Address, offset: u64) -> u64 {
    b0: u64 = *(buf + offset);
    b1: u64 = *(buf + offset + 1);
    b2: u64 = *(buf + offset + 2);
    b3: u64 = *(buf + offset + 3);
    b4: u64 = *(buf + offset + 4);
    b5: u64 = *(buf + offset + 5);
    b6: u64 = *(buf + offset + 6);
    b7: u64 = *(buf + offset + 7);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) |
           (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56);
}

// ─── Worker functions: the "tasks" the pool can dispatch ─────────────────
// Each takes a u64 argument and returns a u64 result. A real thread pool
// would store function pointers; here we dispatch on a task-id byte.

fn task_compute_square(arg: u64) -> u64 {
    return arg * arg;
}

fn task_compute_cube(arg: u64) -> u64 {
    return arg * arg * arg;
}

fn task_double(arg: u64) -> u64 {
    return arg + arg;
}

// Dispatch by task_id: 0 = square, 1 = cube, 2 = double
fn dispatch_task(task_id: u64, arg: u64) -> u64 {
    if task_id == 0 {
        return task_compute_square(arg);
    }
    if task_id == 1 {
        return task_compute_cube(arg);
    }
    if task_id == 2 {
        return task_double(arg);
    }
    return 0;
}

fn main() -> i32 {
    // ─── Allocate the task queue header (32 bytes) ────────────────────
    queue = allocate(32);
    // Initialize: head=0, tail=0, len=0, capacity=8
    *(queue + 0)  = 0; *(queue + 1)  = 0; *(queue + 2)  = 0; *(queue + 3)  = 0;
    *(queue + 4)  = 0; *(queue + 5)  = 0; *(queue + 6)  = 0; *(queue + 7)  = 0;
    *(queue + 8)  = 0; *(queue + 9)  = 0; *(queue + 10) = 0; *(queue + 11) = 0;
    *(queue + 12) = 0; *(queue + 13) = 0; *(queue + 14) = 0; *(queue + 15) = 0;
    *(queue + 16) = 0; *(queue + 17) = 0; *(queue + 18) = 0; *(queue + 19) = 0;
    *(queue + 20) = 0; *(queue + 21) = 0; *(queue + 22) = 0; *(queue + 23) = 0;
    *(queue + 24) = 8; *(queue + 25) = 0; *(queue + 26) = 0; *(queue + 27) = 0;
    *(queue + 28) = 0; *(queue + 29) = 0; *(queue + 30) = 0; *(queue + 31) = 0;

    // ─── Allocate the task slots: 8 tasks × 16 bytes (task_id + arg) ──
    tasks = allocate(128);

    // ─── Push 3 tasks: square(7), cube(13), double(42) ────────────────
    // Push task 0: square(7) at slot 0
    *(tasks + 0)  = 0;            // task_id = 0 (square)
    *(tasks + 8)  = 7;            // arg = 7
    // Update tail and len
    *(queue + 8)  = 1;            // tail = 1
    *(queue + 16) = 1;            // len = 1

    // Push task 1: cube(13) at slot 1
    *(tasks + 16) = 1;            // task_id = 1 (cube)
    *(tasks + 24) = 13;           // arg = 13
    *(queue + 8)  = 2;            // tail = 2
    *(queue + 16) = 2;            // len = 2

    // Push task 2: double(42) at slot 2
    *(tasks + 32) = 2;            // task_id = 2 (double)
    *(tasks + 40) = 42;           // arg = 42
    *(queue + 8)  = 3;            // tail = 3
    *(queue + 16) = 3;            // len = 3

    // ─── Allocate the results array: 8 results × 8 bytes ──────────────
    results = allocate(64);

    // ─── Worker loop: pop tasks until queue is empty ──────────────────
    // In a real thread pool, N worker threads would contend on the queue.
    // Here we simulate one worker iterating until the queue is drained.
    processed: u64 = 0;
    checksum: u64 = 0;
    while processed < 3 {
        head_idx: u64 = read_u64(queue, 0);     // head
        // Read task_id and arg from the task slot
        task_id: u64 = *(tasks + head_idx * 16);
        arg:     u64 = *(tasks + head_idx * 16 + 8);

        // Dispatch and store the result
        result: u64 = dispatch_task(task_id, arg);
        // Write result as 8 little-endian bytes
        *(results + processed * 8 + 0) = result & 255;
        *(results + processed * 8 + 1) = (result >> 8)  & 255;
        *(results + processed * 8 + 2) = (result >> 16) & 255;
        *(results + processed * 8 + 3) = (result >> 24) & 255;
        *(results + processed * 8 + 4) = (result >> 32) & 255;
        *(results + processed * 8 + 5) = (result >> 40) & 255;
        *(results + processed * 8 + 6) = (result >> 48) & 255;
        *(results + processed * 8 + 7) = (result >> 56) & 255;

        // Accumulate checksum
        checksum = checksum + result;

        // Advance head, decrement len
        *(queue + 0)  = (head_idx + 1) & 255;
        *(queue + 16) = (read_u64(queue, 16) - 1) & 255;

        processed = processed + 1;
    }

    // ─── Expected results ─────────────────────────────────────────────
    //   square(7)  = 49
    //   cube(13)   = 2197
    //   double(42) = 84
    //   checksum   = 49 + 2197 + 84 = 2330

    // ─── Free remaining allocations (clean shutdown) ──────────────────
    free(tasks);
    free(results);
    free(queue);

    // ─── Verify the checksum and return ───────────────────────────────
    if checksum == 2330 {
        return 0;
    }
    return 1;
}
