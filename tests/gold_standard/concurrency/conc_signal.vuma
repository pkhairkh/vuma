// Migrated from concurrency/s4_conc_signal.vuma
// Expected exit code: 7
//
// PMT migration: allocate/free/*ptr replaced with state_new(Layout)
// + field access. Buffer lifetime auto-managed.

layout Pair = { a: u32, b: u32 }

fn main() -> i32 {
    let __s = state_new(Pair);
    __s.b = 7;
    __s.a = 1;
    let s = __s.a;
    let d = __s.b;
    let sum = s + d;
    return d;
}
