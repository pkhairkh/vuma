// Migrated from concurrency/s20_conc_overwrite_first.vuma
// Expected exit code: 180
//
// PMT migration: allocate/free/*ptr replaced with state_new(Layout)
// + field access. Buffer lifetime auto-managed.

layout Triple = { a: u32, b: u32, c: u32 }

fn main() -> i32 {
    let __s = state_new(Triple);
    __s.a = 20;
    __s.a = 100;
    __s.b = 50;
    __s.c = 30;
    let v1 = __s.a;
    let v2 = __s.b;
    let v3 = __s.c;
    let s = v1 + v2 + v3;
    return s;
}
