layout Triple = { a: u32, b: u32, c: u32 }

fn main() -> i32 {
    let __s = state_new(Triple);
    __s.a = 10;
    __s.b = 20;
    __s.c = 30;
    __s.c = 100;
    let v1 = __s.a;
    let v2 = __s.b;
    let v3 = __s.c;
    let t1 = v1 + v2;
    let s = t1 + v3;
    return s;
}
