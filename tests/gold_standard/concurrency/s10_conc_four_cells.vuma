// Migrated from concurrency/s10_conc_four_cells.vuma
// Expected exit code: 100
//
// PMT migration: allocate/free/*ptr replaced with state_new(Layout)
// + field access. Buffer lifetime auto-managed.

layout Quad = { a: u32, b: u32, c: u32, d: u32 }

fn main() -> i32 {
    let __s = state_new(Quad);
    __s.a = 10;
    __s.b = 20;
    __s.c = 30;
    __s.d = 40;
    let v1 = __s.a;
    let v2 = __s.b;
    let v3 = __s.c;
    let v4 = __s.d;
    let t1 = v1 + v2;
    let t2 = t1 + v3;
    let s = t2 + v4;
    return s;
}
