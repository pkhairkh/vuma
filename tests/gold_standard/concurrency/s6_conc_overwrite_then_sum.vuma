// Migrated from concurrency/s6_conc_overwrite_then_sum.vuma
// Expected exit code: 90
//
// PMT migration: allocate/free/*ptr replaced with state_new(Layout)
// + field access. Buffer lifetime auto-managed.

layout Pair = { a: u32, b: u32 }

fn main() -> i32 {
    let __s = state_new(Pair);
    __s.a = 10;
    __s.b = 35;
    __s.a = 55;
    let v1 = __s.a;
    let v2 = __s.b;
    let s = v1 + v2;
    return s;
}
