// ffi_wave0/borrow_attr — #[borrow] on an extern transform param (parse-only)
// Expected exit code: 0
//
// Test: #[borrow] is a valid FFI attribute on an extern transform parameter.
// It declares that C will read (but not mutate) the argument and will not
// hold the pointer after the call returns.

extern "C" {
    transform write(fd: i64, #[borrow] buf: Address, count: i64) -> i64;
}

transform main() -> i32 {
    return 0;
}
