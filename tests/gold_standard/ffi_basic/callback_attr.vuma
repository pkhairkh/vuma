// ffi_wave0/callback_attr — #[callback] on an extern transform (parse-only)
// Expected exit code: 0
//
// Test: #[callback] marks an extern transform as one that may invoke VUMA
// functions via a vuma_context_t during the call.

extern "C" {
    #[callback]
    transform sqlite3_exec(db: Address, sql: Address, cb: Address, arg: Address, err: Address) -> i32;
}

transform main() -> i32 {
    return 0;
}
