// ffi_wave0/unmarshal_attr — #[unmarshal(Layout)] on an extern transform (parse-only)
// Expected exit code: 0
//
// Test: #[unmarshal(Layout)] on an extern transform declares the return
// mode: the C return value is copied into ___pmt_buffer as a State<Layout>.

layout Response = { status: u32, data: u64 }

extern "C" {
    #[unmarshal(Response)]
    transform do_request(url: Address) -> i64;
}

transform main() -> i32 {
    return 0;
}
