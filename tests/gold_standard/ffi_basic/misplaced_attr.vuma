// ffi_wave0/misplaced_attr — #[foreign(raw)] on an extern transform is a parse error
// Expected: PARSE ERROR (not exit code 0)
//
// Negative test: #[foreign(raw)] is layout-only. Placing it on an
// extern transform must produce a parse error with a diagnostic mentioning that
// it belongs on a layout declaration.

extern "C" {
    #[foreign(raw)]
    transform bad_fn(x: i64) -> i64;
}

transform main() -> i32 {
    return 0;
}
