// ffi_wave0/foreign_consume_attr — #[foreign_consume(raw)] on an extern transform (parse-only)
// Expected exit code: 0
//
// Test: #[foreign_consume(raw)] marks an extern transform (e.g. a close
// function) as consuming its State<ForeignLayout> argument linearly. After
// the call, the state is consumed — post-close use is a linearity error.

layout DbHandle = { raw: u64 }

extern "C" {
    #[foreign_consume(raw)]
    transform sqlite3_close(db: State<DbHandle>);
}

transform main() -> i32 {
    return 0;
}
