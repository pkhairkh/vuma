// ffi_wave0/may_retain_attr — #[may_retain] on an extern transform param (parse-only)
// Expected exit code: 0
//
// Test: #[may_retain] declares that C may stash the pointer past
// the call return (e.g. epoll_ctl, sigaction). Forces scratchpad routing.

extern "C" {
    transform epoll_ctl(epfd: i32, op: i32, fd: i32, #[may_retain] ev: Address) -> i32;
}

transform main() -> i32 {
    return 0;
}
