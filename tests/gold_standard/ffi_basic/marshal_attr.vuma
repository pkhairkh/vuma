// ffi_wave0/marshal_attr — #[marshal] on an extern transform param (parse-only)
// Expected exit code: 0
//
// Test: #[marshal] forces the scratchpad marshalling path even when
// the type looks borrowable (e.g. for APIs requiring NUL-termination or
// C-ownership).

extern "C" {
    transform open(#[marshal] path: Address, flags: i32) -> i32;
}

transform main() -> i32 {
    return 0;
}
