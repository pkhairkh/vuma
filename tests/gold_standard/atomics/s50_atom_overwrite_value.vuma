// s50_atom_overwrite_value.vuma — overwrite to 220, atomic_load = 220
// Expected exit code: 220
//
// Single 8-byte cell. atomic_store 50, then atomic_store 220.
// atomic_load should return 220. On the current backend the load
// returns 0 -> exit 0. Will exit 220 once atomics are wired
// through. Distinct from s46_atom_overwrite_value (200) and
// s43_atom_overwrite_value (200).

layout _L1 = { v: u32 }
fn main() -> i32 {
    let c1 = state_new(_L1);
    c1.v = 50;
    c1.v = 220;
    v = c1.v;
    return v;
}
