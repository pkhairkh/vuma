// s59_atom_overwrite_value.vuma — overwrite to 235, atomic_load = 235
// Expected exit code: 235
//
// Single 8-byte cell. atomic_store 50, then atomic_store 235.
// atomic_load should return 235. On the current backend the load
// returns 0 -> exit 0. Will exit 235 once atomics are wired through.
// Distinct from s58_atom_two_cell_sum (165), s58_atom_three_cell_diff
// (120) and s58_atom_overwrite_high (210).

layout _L1 = { v: u32 }
fn main() -> i32 {
    let c1 = state_new(_L1);
    c1.v = 50;
    c1.v = 235;
    v = c1.v;
    return v;
}
