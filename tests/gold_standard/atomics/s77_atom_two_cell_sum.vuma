// s77_atom_two_cell_sum.vuma — two cells, atomic sum = 154 (130 + 24)
// Expected exit code: 154
//
// Two 8-byte cells. atomic_store 130/24, atomic_load each, sum
// -> 154. On the current backend the loads return 0 -> 0 + 0 = 0
// -> exit 0. Will exit 154 once atomics are wired through.
// Distinct from s70_atom_two_cell_sum (75), s66_atom_two_cell_sum
// (200) and s74_atom_two_cell_sum (179).

layout _L1 = { v: u32 }
layout _L2 = { v: u32 }
fn main() -> i32 {
    let c1 = state_new(_L1);
    let c2 = state_new(_L2);
    c1.v = 130;
    c2.v = 24;
    a = c1.v;
    b = c2.v;
    s: i32 = a + b;                   // 154
    return s;
}
