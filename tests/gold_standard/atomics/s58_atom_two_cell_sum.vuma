// s58_atom_two_cell_sum.vuma — two cells, atomic sum = 165 (90 + 75)
// Expected exit code: 165
// 
// Two 8-byte cells. atomic_store 90/75, atomic_load each, sum
// -> 165. On the current backend the loads return 0 -> 0 + 0 = 0
// -> exit 0. Will exit 165 once atomics are wired through. Distinct
// from s51_atom_two_cell_diff (60), s51_atom_three_cell_sum (250)
// and s51_atom_overwrite_value (245).

layout _L1 = { v: u32 }
layout _L2 = { v: u32 }
fn main() -> i32 {
    let c1 = state_new(_L1);
    let c2 = state_new(_L2);
    c1.v = 90;
    c2.v = 75;
    a = c1.v;
    b = c2.v;
    s: i32 = a + b;                   // 165
    return s;
}
