// s86_atom_two_cell_sum.vuma — two cells, atomic sum = 200 (130 + 70)
// Expected exit code: 200
//
// Two 8-byte cells. atomic_store 130/70, atomic_load each, sum
// -> 200. On the current backend the loads return 0 -> 0 + 0 = 0
// -> exit 0. Will exit 200 once atomics are wired through.
// Distinct from s82_atom_two_cell_sum (24), s78_atom_two_cell_sum
// (2) and s74_atom_two_cell_sum (90).
layout _L1 = { v: u32 }
layout _L2 = { v: u32 }
fn main() -> i32 {
    let c1 = state_new(_L1);
    let c2 = state_new(_L2);
    c1.v = 130;
    c2.v = 70;
    a = c1.v;
    b = c2.v;
    s: i32 = a + b;                   // 200
    return s;
}
