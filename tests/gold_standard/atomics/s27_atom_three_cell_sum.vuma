// s27_atom_three_cell_sum.vuma — atomic_store 10/20/30, sum = 60
// Observed on current x86_64 backend: 0 (FAIL — known bug)
//
// Three 8-byte cells. atomic_store 10/20/30, atomic_load all three, sum
// -> 60. On the current backend all loads return 0 -> exit 0. Will exit
// 60 once atomic ops are wired through. Distinct from
// s26_atom_three_cell_sum (different values) and s22_atom_three_cell_inc
// (incrementing values).
// Expected exit code: 60

layout _L1 = { v: u32 }
layout _L2 = { v: u32 }
layout _L3 = { v: u32 }
fn main() -> i32 {
    let c1 = state_new(_L1);
    let c2 = state_new(_L2);
    let c3 = state_new(_L3);
    c1.v = 10;
    c2.v = 20;
    c3.v = 30;
    a = c1.v;
    b = c2.v;
    c = c3.v;
    s = a + b + c;
    return s;
}
