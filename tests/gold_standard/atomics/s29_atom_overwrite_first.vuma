// s29_atom_overwrite_first.vuma — atomic_store 10/20/30, overwrite first with 100, sum = 150
// Expected exit code: 150
// Expected exit code (correct, post-bridge-fix): 150  (100 + 20 + 30)
//
// Three 8-byte cells. atomic_store 10/20/30 into each, then atomic_store 100 into the first cell (overwrite). atomic_load all three and sum -> 150. On the current backend all loads return 0 -> exit 0. Will exit 150 once atomic ops are wired through. Distinct from s26_atom_overwrite_max (single-cell overwrite, 250) and s22_atom_overwrite_load (overwrite pattern, 0xFF).

layout _L1 = { v: u32 }
layout _L2 = { v: u32 }
layout _L3 = { v: u32 }
fn main() -> i32 {
    let c1 = state_new(_L1);
    let c2 = state_new(_L2);
    let c3 = state_new(_L3);
    c1.v = 10;
    c2.v = 20;
    c3.v = 30;
    c1.v = 100;
    a = c1.v;
    b = c2.v;
    c = c3.v;
    t = a + b;
    s = t + c;
    return s;
}
