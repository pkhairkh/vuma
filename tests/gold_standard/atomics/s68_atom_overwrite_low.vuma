// s68_atom_overwrite_low.vuma — overwrite to 233, atomic_load = 233
// Expected exit code: 233
//
// Single 8-byte cell. atomic_store 50, then atomic_store 233.
// atomic_load should return 233. On the current backend the load
// returns 0 -> exit 0. Will exit 233 once atomics are wired
// through. Distinct from s66_atom_overwrite_high (correct 230),
// s62_atom_overwrite_low (240) and s58_atom_overwrite_high (210).
layout _L1 = { v: u32 }
fn main() -> i32 {
    let c1 = state_new(_L1);
    c1.v = 50;
    c1.v = 233;
    v = c1.v;
    return v;
}
