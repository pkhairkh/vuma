// s89_atom_three_cell_diff.vuma — three cells, atomic diff = 16 (106 - 60 - 30)
// Expected exit code: 16
//
// Three 8-byte cells. atomic_store 106/60/30, atomic_load each,
// a - b - d -> 16. On the current backend the loads return 0
// -> 0 - 0 - 0 = 0 -> exit 0. Will exit 16 once atomics are wired
// through. Distinct from s86_atom_three_cell_diff (170),
// s82_atom_three_cell_diff (26) and s78_atom_three_cell_diff (148).
layout _L1 = { v: u32 }
layout _L2 = { v: u32 }
layout _L3 = { v: u32 }
fn main() -> i32 {
    let c1 = state_new(_L1);
    let c2 = state_new(_L2);
    let c3 = state_new(_L3);
    c1.v = 106;
    c2.v = 60;
    c3.v = 30;
    a = c1.v;
    b = c2.v;
    c = c3.v;
    r: i32 = a - b - c;               // 16
    return r;
}
