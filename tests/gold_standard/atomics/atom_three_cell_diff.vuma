// s31_atom_three_cell_diff.vuma — three cells, atomic diff = 120 (200-50-30)
// Expected exit code: 120
//
// Three 8-byte cells. atomic_store 200/50/30, atomic_load each,
// subtract -> 120. On the current backend the load returns 0 -> exit 0.
// Will exit 120 once atomics are wired through. Distinct from
// s30_atom_three_cell_sum (sum, 150) and s28_atom_three_cell_sum
// (sum, 150).

layout _L1 = { v: u32 }
layout _L2 = { v: u32 }
layout _L3 = { v: u32 }
fn main() -> i32 {
    let c1 = state_new(_L1);
    let c2 = state_new(_L2);
    let c3 = state_new(_L3);
    c1.v = 200;
    c2.v = 50;
    c3.v = 30;
    a = c1.v;
    b = c2.v;
    c = c3.v;
    t: i32 = a - b;
    r: i32 = t - c;                 // 120
    return r;
}
