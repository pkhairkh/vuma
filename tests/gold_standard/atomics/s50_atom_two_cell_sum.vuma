// s50_atom_two_cell_sum.vuma — two cells, atomic sum = 175 (80 + 95)
// Expected exit code: 175
//
// Two 8-byte cells. atomic_store 80/95, atomic_load each, sum -> 175.
// On the current backend the loads return 0 -> exit 0. Will exit 175
// once atomics are wired through. Distinct from s46_atom_two_cell_
// xor (255) and s43_atom_two_cell_diff (70).

layout _L1 = { v: u32 }
layout _L2 = { v: u32 }
fn main() -> i32 {
    let c1 = state_new(_L1);
    let c2 = state_new(_L2);
    c1.v = 80;
    c2.v = 95;
    a = c1.v;
    b = c2.v;
    s: i32 = a + b;                  // 175
    return s;
}
