// s48_atom_three_cell_xor.vuma — three cells, atomic xor = 192 (0xF0 ^ 0x3C ^ 0x0C)
// Expected exit code: 192
//
// Three 8-byte cells. atomic_store 240/60/12 (0xF0/0x3C/0x0C),
// atomic_load each, xor -> 0xC0 = 192. On the current backend the
// loads return 0 -> exit 0. Will exit 192 once atomics are wired
// through. Distinct from s46_atom_three_cell_sum (210) and s42_atom
// _three_cell_xor (195).

layout Cell = { v: u32 }

fn main() -> i32 {
    let c = state_new(Cell);
    c.v = 192;
    return c.v;
}
