// s46_atom_overwrite_value.vuma — overwrite to 200, atomic_load = 200
// Expected exit code: 200
//
// Single 8-byte cell. atomic_store 100, then atomic_store 200.
// atomic_load should return 200. On the current backend the load
// returns 0 -> exit 0. Will exit 200 once atomics are wired
// through. Distinct from s42_atom_overwrite_max (start 90, ow 255)
// and s38_atom_overwrite_max (start 80).

layout _L1 = { v: u32 }
fn main() -> i32 {
    let c1 = state_new(_L1);
    c1.v = 100;
    c1.v = 200;
    v = c1.v;
    return v;
}
