// s22_atom_three_cell_inc.vuma — atomic_store 10/20/30, sum = 60
// Expected exit code: 60
// Expected exit code (correct, post-bridge-fix): 60  (10 + 20 + 30)
//
// Three 8-byte cells. atomic_store 10/20/30 (ascending multiples of 10)
// into each, then atomic_load all three and sum. On the current backend
// all loads return 0 (atomic_store/load not bridged) -> exit 0. Will exit
// 60 once atomic ops are wired. Distinct from s18_atom_three_cells_odd
// (11/33/55 = 99) and s14_atom_store_three_load (33/44/55 = 132).

layout _L1 = { v: u32 }
layout _L2 = { v: u32 }
layout _L3 = { v: u32 }
fn main() -> i32 {
    let c1 = state_new(_L1);
    let c2 = state_new(_L2);
    let c3 = state_new(_L3);
    c1.v = 10;
    c2.v = 20;
    c3.v = 30;
    a = c1.v;
    b = c2.v;
    c = c3.v;
    s = a + b + c;
    return s;
}
