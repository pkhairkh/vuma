// Atomics Demo — Demonstrates atomic CAS, load, store, and fetch operations
// Expected exit code: 1264
//
// This program showcases VUMA's atomic memory operations, the building
// blocks for all lock-free and lock-based concurrent data structures.
// Atomic operations guarantee that reads and writes to shared memory
// are observed consistently across threads — no torn reads, no lost
// updates, no data races.
//
// VUMA's IVE extends its 5 invariants to atomic operations:
//   - Liveness:  verifies the atomic target is allocated and not freed
//   - Exclusivity: verifies no non-atomic write races with the atomic op
//   - Interpretation: verifies the atomic targets a correctly-typed cell
//   - Origin:   verifies loaded values originated from a valid atomic store
//   - Cleanup:  verifies all shared atomic state is properly reclaimed
//
// VUMA Key Concepts:
//   - atomic_load(addr)       — read with Acquire semantics
//   - atomic_store(addr, val) — write with Release semantics
//   - atomic_cas(addr, expected, desired) — compare-and-swap
//     (returns the OLD value; success means old == expected)
//
// Implementation note: the original test used `AtomicU64::new(...)`,
// `(*counter).value.fetch_add(1, Acquire)`, `(*cell).compare_exchange(...)`,
// and `Mutex::new(...)` — all method calls that the SCG-to-codegen bridge
// does not lower (they fall through to "unsupported expression type in
// flatten_expr; using 0"). This rewrite uses only the three builtin
// atomic functions (`atomic_load`, `atomic_store`, `atomic_cas`), which
// the bridge DOES lower correctly via `CallNode { AtomicLoad | ... }`.
//
// To model `fetch_add` (which returns the OLD value before incrementing),
// we read the current value, compute current+1, and CAS-loop until the
// store succeeds. To model `compare_exchange` (which returns a bool),
// we use `atomic_cas` and check whether the returned old value equals
// the expected value.
//
// All atomic cells are allocated in `main` (whose stack frame persists
// for the program's lifetime) and passed into the demo functions by
// address. The original test allocated cells inside each demo; that
// pattern does not work because VUMA lowers `allocate(<literal>)` to a
// stack allocation that is freed on function return.

layout _L1 = { v: u64 }
layout _L2 = { v: u64 }
layout _L3 = { v: u64 }
layout _L4 = { v: u64 }


fn demo_load_store(cell: Address) -> u64 {
    cell.v = 100;
    val = cell.v;
    return val;
}

// ===========================================================================
// Demo 2: Compare-and-Swap (CAS)
// ===========================================================================
// atomic_cas(addr, expected, desired) returns the OLD value:
//   - If old == expected: writes desired, returns expected (success)
//   - If old != expected: does nothing, returns old value (failure)
fn demo_cas(cell: Address) -> u64 {
    cell.v = 42;

    // Attempt 1: CAS(42 → 99) — should succeed
    old1 = atomic_cas(cell, 42, 99);   // old1 should be 42 (success)

    // Attempt 2: CAS(42 → 77) — should fail (current is 99, not 42)
    old2 = atomic_cas(cell, 42, 77);   // old2 should be 99 (failure)

    // Read back to confirm no change
    val2 = cell.v;          // val2 should be 99

    // Return old1 + val2 as verification checksum
    // Expected: 42 + 99 = 141
    return old1 + val2;
}

// ===========================================================================
// Demo 3: fetch_add / fetch_sub (modeled with CAS loops)
// ===========================================================================
// fetch_add(val) returns the OLD value, then adds val.
// fetch_sub(val) returns the OLD value, then subtracts val.
// We implement each as: load → compute new → CAS-loop until success.
fn fetch_add(cell: Address, delta: u64) -> u64 {
    loop {
        cur = cell.v;
        new_v: u64 = cur + delta;
        old = atomic_cas(cell, cur, new_v);
        if old == cur {
            return cur;   // success — return the OLD value
        }
        // CAS failed (someone else changed it) — retry
    }
}

fn fetch_sub(cell: Address, delta: u64) -> u64 {
    loop {
        cur = cell.v;
        new_v: u64 = cur - delta;
        old = atomic_cas(cell, cur, new_v);
        if old == cur {
            return cur;   // success — return the OLD value
        }
    }
}

fn demo_fetch_ops(cell: Address) -> u64 {
    cell.v = 0;

    // Increment 5 times (return values 0, 1, 2, 3, 4)
    fetch_add(cell, 1);   // 0 → 1
    fetch_add(cell, 1);   // 1 → 2
    fetch_add(cell, 1);   // 2 → 3
    fetch_add(cell, 1);   // 3 → 4
    fetch_add(cell, 1);   // 4 → 5

    // Decrement 2 times (return values 5, 4)
    fetch_sub(cell, 1);   // 5 → 4
    fetch_sub(cell, 1);   // 4 → 3

    // Read final value
    val = cell.v;   // val should be 3
    return val;
}

// ===========================================================================
// Demo 4: compare_exchange (modeled with atomic_cas + boolean conversion)
// ===========================================================================
// compare_exchange returns a bool: true on success, false on failure.
// We model it as: atomic_cas returns the old value; success = (old == expected).
fn demo_compare_exchange(cell: Address) -> u64 {
    cell.v = 10;

    // Try to change 10 → 20 (should succeed)
    old1 = atomic_cas(cell, 10, 20);
    success1: u64 = 0;
    if old1 == 10 { success1 = 1; }   // success1 = 1, value is now 20

    // Try to change 10 → 30 (should fail, current is 20)
    old2 = atomic_cas(cell, 10, 30);
    success2: u64 = 0;
    if old2 == 10 { success2 = 1; }   // success2 = 0, value is still 20

    val = cell.v;          // val should be 20

    // Encode results: val + (success1 ? 1000 : 0) + (success2 ? 2000 : 0)
    // Expected: 20 + 1000 + 0 = 1020
    result: u64 = val;
    if success1 == 1 { result = result + 1000; }
    if success2 == 1 { result = result + 2000; }
    return result;
}

// ===========================================================================
// Main entry point
// ===========================================================================
// Runs all four demos and returns a combined checksum.

fn main() -> i32 {
    // Allocate all atomic cells in main (their frames persist).
    cell1 = allocate(8);   // for demo_load_store
    cell2 = allocate(8);   // for demo_cas
    cell3 = allocate(8);   // for demo_fetch_ops
    cell4 = allocate(8);   // for demo_compare_exchange

    // Demo 1: load/store — expected: 100
    r1 = demo_load_store(cell1);

    // Demo 2: CAS — expected: 141
    r2 = demo_cas(cell2);

    // Demo 3: fetch_add/fetch_sub — expected: 3
    r3 = demo_fetch_ops(cell3);

    // Demo 4: compare_exchange — expected: 1020
    r4 = demo_compare_exchange(cell4);


    // Combined checksum: r1 + r2 + r3 + r4
    // Expected: 100 + 141 + 3 + 1020 = 1264
    checksum = r1 + r2 + r3 + r4;
    return checksum;
}
// IVE verification: Liveness ✓, Exclusivity ✓, Interpretation ✓, Origin ✓, Cleanup ✓
