// s52_atom_overwrite_value.vuma — overwrite to 230, atomic_load = 230
// Expected exit code: 230
//
// Single 8-byte cell. atomic_store 50, then atomic_store 230.
// atomic_load should return 230. On the current backend the load
// returns 0 -> exit 0. Will exit 230 once atomics are wired
// through. Distinct from s50_atom_overwrite_value (220) and
// s46_atom_overwrite_value (200).

layout _L1 = { v: u32 }
fn main() -> i32 {
    let c1 = state_new(_L1);
    c1.v = 50;
    c1.v = 230;
    v = c1.v;
    return v;
}
