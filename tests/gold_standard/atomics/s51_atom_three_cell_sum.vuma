// s51_atom_three_cell_sum.vuma — three cells, atomic sum = 250 (70 + 85 + 95)
// Expected exit code: 250
//
// Three 8-byte cells. atomic_store 70/85/95, atomic_load each, sum
// -> 250. On the current backend the loads return 0 -> exit 0. Will
// exit 250 once atomics are wired through. Distinct from s50_atom_
// three_cell_xor (204) and s47_atom_three_cell_sum (240).

layout _L1 = { v: u32 }
layout _L2 = { v: u32 }
layout _L3 = { v: u32 }
fn main() -> i32 {
    let c1 = state_new(_L1);
    let c2 = state_new(_L2);
    let c3 = state_new(_L3);
    c1.v = 70;
    c2.v = 85;
    c3.v = 95;
    a = c1.v;
    b = c2.v;
    c = c3.v;
    t: i32 = a + b;
    s: i32 = t + c;                  // 250
    return s;
}
