// s88_atom_three_cell_diff.vuma — three cells, atomic diff = 165 (250 - 60 - 25)
// Expected exit code: 165
//
// Three 8-byte cells. atomic_store 250/60/25, atomic_load
// each, a - b - c -> 165. On the current backend the loads
// return 0 -> 0 - 0 - 0 = 0 -> exit 0. Will exit 165 once
// atomics are wired through. Distinct from s86_atom_three_
// cell_diff (170), s82_atom_three_cell_diff (26) and s78_
// atom_three_cell_diff (148).
layout _L1 = { v: u32 }
layout _L2 = { v: u32 }
layout _L3 = { v: u32 }
fn main() -> i32 {
    let c1 = state_new(_L1);
    let c2 = state_new(_L2);
    let c3 = state_new(_L3);
    c1.v = 250;
    c2.v = 60;
    c3.v = 25;
    a = c1.v;
    b = c2.v;
    c = c3.v;
    r: i32 = a - b - c;               // 165
    return r;
}
