// s38_atom_overwrite_max.vuma — overwrite to 255, atomic_load = 255
// Expected exit code: 255
//
// Single 8-byte cell. atomic_store 80, then atomic_store 255 (max
// u8). atomic_load should return 255. On the current backend the
// load returns 0 -> exit 0. Will exit 255 once atomics are wired
// through. Distinct from s34_atom_overwrite_max (same shape,
// different value) and s30_atom_two_cell_xor.

layout _L1 = { v: u32 }
fn main() -> i32 {
    let c1 = state_new(_L1);
    c1.v = 80;
    c1.v = 255;
    v = c1.v;
    return v;
}
