// s86_ls_three_node_diff.vuma — three nodes, diff = 130 (245 - 90 - 25)
// Expected exit code: 130
//
// Three 8-byte allocations treated as three independent "nodes".
// Store 245/90/25 via `*ptr = literal`, load all three,
// a - b - c -> 130. Uses `*ptr = literal` form (no offsets).
// Distinct from s82_ls_three_node_diff (140), s78_ls_three_node_
// diff (147) and s74_ls_three_node_diff (40).
layout Buf_n1 = { data: [u8; 8] }
layout Buf_n2 = { data: [u8; 8] }
layout Buf_n3 = { data: [u8; 8] }

fn main() -> i32 {
    let n1 = state_new(Buf_n1);
    let n2 = state_new(Buf_n2);
    let n3 = state_new(Buf_n3);
    n1.data[0] = 245;
    n2.data[0] = 90;
    n3.data[0] = 25;
    a: u64 = n1.data[0];
    b: u64 = n2.data[0];
    c: u64 = n3.data[0];
    r: u64 = a - b - c;    // 130
    return r;
}
