// s38_ls_three_node_diff.vuma — three nodes, diff = 160 (240 - 50 - 30)
// Expected exit code: 160
//
// Three 8-byte allocations treated as three independent "nodes".
// Store 240/50/30 via `*ptr = literal`, load all, subtract -> 160.
// Uses `*ptr = literal` form (no offsets). Distinct from s34_ls_
// three_node_diff (120) and s30_ls_three_node_diff.

layout Buf_n1 = { data: [u8; 8] }
layout Buf_n2 = { data: [u8; 8] }
layout Buf_n3 = { data: [u8; 8] }

fn main() -> i32 {
    let n1 = state_new(Buf_n1);
    let n2 = state_new(Buf_n2);
    let n3 = state_new(Buf_n3);
    n1.data[0] = 240;
    n2.data[0] = 50;
    n3.data[0] = 30;
    a: u64 = n1.data[0];
    b: u64 = n2.data[0];
    c: u64 = n3.data[0];
    t: u64 = a - b;
    d: u64 = t - c;
    return d;
}
