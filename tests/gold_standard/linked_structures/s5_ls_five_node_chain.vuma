// s5_ls_five_node_chain.vuma — five 8-byte nodes, sum = 150
// Expected exit code: 150  (10 + 20 + 30 + 40 + 50)
//
// 40-byte allocation treated as five 8-byte "nodes" at offsets
// 0/8/16/24/32. Stores 10/20/30/40/50, loads all five, sums,
// returns 150. Stresses the largest single-block chain in the suite.

layout Buf_block = { data: [u8; 40] }

fn main() -> i32 {
    let block = state_new(Buf_block);
    block.data[0] = 10;
    block.data[8] = 20;
    block.data[16] = 30;
    block.data[24] = 40;
    block.data[32] = 50;
    a: u64 = block.data[0];
    b: u64 = block.data[8];
    c: u64 = block.data[16];
    d: u64 = block.data[24];
    e: u64 = block.data[32];
    t1: u64 = a + b;
    t2: u64 = t1 + c;
    t3: u64 = t2 + d;
    s: u64 = t3 + e;
    return s;
}
