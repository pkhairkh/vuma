// s37_ls_overwrite_first.vuma — overwrite first node, sum = 25 + 90 + 80 = 195
// Expected exit code: 195
//
// Deterministic test in the linked_structures category. All operands loaded into typed
// variables before any bitwise op; all stores use `*ptr = literal` (or the
// `*ptr = variable + 0` workaround). Result lands in 0-255.
// Distinct from s33_ls_overwrite_value (overwrite single, 190) and s30_ls_overwrite_middle (overwrites middle).
layout Buf_n1 = { data: [u8; 8] }
layout Buf_n2 = { data: [u8; 8] }
layout Buf_n3 = { data: [u8; 8] }

fn main() -> i32 {
    let n1 = state_new(Buf_n1);
    let n2 = state_new(Buf_n2);
    let n3 = state_new(Buf_n3);
    n1.data[0] = 100;
    n2.data[0] = 90;
    n3.data[0] = 80;
    n1.data[0] = 25;
    a: u64 = n1.data[0];
    b: u64 = n2.data[0];
    c: u64 = n3.data[0];
    s: u64 = a + b + c;     // 195
    return s;
}
