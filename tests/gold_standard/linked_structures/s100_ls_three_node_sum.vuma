// s100_ls_three_node_sum.vuma — three nodes, sum = 58 (15 + 31 + 12)
// Expected exit code: 58
//
// Three 8-byte allocations treated as three independent
// "nodes". Store 15/31/12 via `*ptr = literal`, load all,
// a + b + c -> 58. Uses `*ptr = literal` form.
// Distinct from s97_ls_three_node_sum (22), s94_ls_three_node_sum (100), s90_ls_overwrite_value (32).
layout Buf_n1 = { data: [u8; 8] }
layout Buf_n2 = { data: [u8; 8] }
layout Buf_n3 = { data: [u8; 8] }

fn main() -> i32 {
    let n1 = state_new(Buf_n1);
    let n2 = state_new(Buf_n2);
    let n3 = state_new(Buf_n3);
    n1.data[0] = 15;
    n2.data[0] = 31;
    n3.data[0] = 12;
    a: u64 = n1.data[0];
    b: u64 = n2.data[0];
    c: u64 = n3.data[0];
    s: u64 = a + b + c;    // 58
    return s;
}
