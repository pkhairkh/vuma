// s3_ls_independent_allocs.vuma — 4 separate allocs, store and sum
// Expected exit code: 200  (40 + 50 + 60 + 50)
//
// Allocates four separate 8-byte nodes (no links between them), stores
// a distinct value in each, loads each back and returns the sum.
// Verifies independent allocations don't alias each other.

layout Buf_n1 = { data: [u8; 8] }
layout Buf_n2 = { data: [u8; 8] }
layout Buf_n3 = { data: [u8; 8] }
layout Buf_n4 = { data: [u8; 8] }

fn main() -> i32 {
    let n1 = state_new(Buf_n1);
    let n2 = state_new(Buf_n2);
    let n3 = state_new(Buf_n3);
    let n4 = state_new(Buf_n4);
    n1.data[0] = 40;
    n2.data[0] = 50;
    n3.data[0] = 60;
    n4.data[0] = 50;

    a: u64 = n1.data[0];
    b: u64 = n2.data[0];
    c: u64 = n3.data[0];
    d: u64 = n4.data[0];
    s1: u64 = a + b;
    s2: u64 = s1 + c;
    s3: u64 = s2 + d;

    return s3;
}
