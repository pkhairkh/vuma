// s62_ls_two_node_sum.vuma — two nodes, sum = 225 (130 + 95)
// Expected exit code: 225
// 
// Two 8-byte allocations treated as two independent "nodes".
// Store 130/95 via `*ptr = literal`, load both, sum -> 225. Uses
// `*ptr = literal` form (no offsets). Distinct from s51_ls_two_node_
// diff (70), s58_ls_two_node_sum (220) and s55_ls_two_node_sum (235).

layout Buf_n1 = { data: [u8; 8] }
layout Buf_n2 = { data: [u8; 8] }

fn main() -> i32 {
    let n1 = state_new(Buf_n1);
    let n2 = state_new(Buf_n2);
    n1.data[0] = 130;
    n2.data[0] = 95;
    a: u64 = n1.data[0];
    b: u64 = n2.data[0];
    s: u64 = a + b;        // 225
    return s;
}
