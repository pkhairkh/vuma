// s93_ls_overwrite_value.vuma — overwrite n1 to 8, load = 8
// Expected exit code: 8
//
// Single 8-byte "node". Store 5, then overwrite to 8, load -> 8
// (the overwritten value). Uses `*ptr = literal` form. Distinct
// from s90_ls_overwrite_value (32), s82_ls_overwrite_value (215) and s78_ls_overwrite_value (3).
layout Buf_n1 = { data: [u8; 8] }

fn main() -> i32 {
    let n1 = state_new(Buf_n1);
    n1.data[0] = 5;
    n1.data[0] = 8;
    v: u64 = n1.data[0];          // 8
    return v;
}
