// s46_ls_two_node_diff.vuma — two nodes, diff = 120 (200 - 80)
// Expected exit code: 120
//
// Two 8-byte allocations treated as two independent "nodes".
// Store 200/80 via `*ptr = literal`, load both, subtract -> 120.
// Uses `*ptr = literal` form (no offsets). Distinct from s42_ls_
// two_node_sum (200) and s38_ls_two_node_sum (175).

layout Buf_n1 = { data: [u8; 8] }
layout Buf_n2 = { data: [u8; 8] }

fn main() -> i32 {
    let n1 = state_new(Buf_n1);
    let n2 = state_new(Buf_n2);
    n1.data[0] = 200;
    n2.data[0] = 80;
    a: u64 = n1.data[0];
    b: u64 = n2.data[0];
    d: u64 = a - b;
    return d;
}
