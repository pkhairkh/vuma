// s16_ls_overwrite_value.vuma — single node, store 33 then overwrite with 200
// Expected exit code: 200
//
// 8-byte allocation treated as a single "node". Store 33 via `node.data[0] = 33`,
// then overwrite with 200 via `node.data[0] = 200` (literal overwrite, last write
// wins). Load and return 200. Uses `*ptr = literal` form (no offsets).
// Distinct from s9_ls_overwrite_node (10 then 50) and s4_ls_overwrite_node
// (different value pair).

layout Buf_node = { data: [u8; 8] }

fn main() -> i32 {
    let node = state_new(Buf_node);
    node.data[0] = 33;
    node.data[0] = 200;
    v: u64 = node.data[0];
    return v;
}
