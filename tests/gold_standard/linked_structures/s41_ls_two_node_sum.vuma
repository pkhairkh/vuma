// s41_ls_two_node_sum.vuma - two nodes, sum = 170 (105 + 65)
// Expected exit code: 170
//
// Two 8-byte allocations treated as two independent "nodes".
// Store 105/65 via `*ptr = literal`, load both, sum -> 170. Uses
// `*ptr = literal` form (no offsets). Distinct from s38_ls_two_
// node_sum (175) and s34_ls_two_node_sum (125).

layout Buf_n1 = { data: [u8; 8] }
layout Buf_n2 = { data: [u8; 8] }

fn main() -> i32 {
    let n1 = state_new(Buf_n1);
    let n2 = state_new(Buf_n2);
    n1.data[0] = 105;
    n2.data[0] = 65;
    a: u64 = n1.data[0];
    b: u64 = n2.data[0];
    s: u64 = a + b;
    return s;
}
