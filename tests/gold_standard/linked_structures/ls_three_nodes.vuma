// ls_three_nodes.vuma — 3 nodes with values 1, 1, 1, return sum
// Expected exit code: 3
//
// Creates three independent 8-byte nodes, stores 1 in each, sums
// their loaded values: 1 + 1 + 1 = 3. All stored values are ≤ 255.

layout Buf_n1 = { data: [u8; 8] }
layout Buf_n2 = { data: [u8; 8] }
layout Buf_n3 = { data: [u8; 8] }

fn main() -> i32 {
    let n1 = state_new(Buf_n1);
    let n2 = state_new(Buf_n2);
    let n3 = state_new(Buf_n3);
    n1.data[0] = 1;
    n2.data[0] = 1;
    n3.data[0] = 1;
    v1: u64 = n1.data[0];
    v2: u64 = n2.data[0];
    v3: u64 = n3.data[0];
    sum: u64 = v1 + v2 + v3;
    return sum;
}
