// GPIO Blink — Simulated hardware register access pattern
// Expected exit code: 0
//
// Demonstrates the memory-mapped I/O pattern used for hardware control.
// Since VUMA does not have map_device(), we simulate the GPIO register
// layout using allocate() and access registers via pointer arithmetic.

const GPIO_BASE_SIZE: u64 = 4096;

layout _L1 = { data: [u8; 256] }
fn gpio_set_output(gpio: Address, pin: u32) {
    // GPFSEL0 register at offset 0x00
    fsel: Address = gpio + 0;
    val: u32 = *fsel;
    // Clear 3 bits for this pin, set to output (001)
    mask: u32 = 7 << (pin * 3);
    val = val & (4294967295 ^ mask);
    val = val | (1 << (pin * 3));
    *fsel = val;
}

fn gpio_set(gpio: Address, pin: u32) {
    // GPSET0 register at offset 0x1c
    set_reg: Address = gpio + 28;
    *set_reg = 1 << pin;
}

fn gpio_clear(gpio: Address, pin: u32) {
    // GPCLR0 register at offset 0x28
    clr_reg: Address = gpio + 40;
    *clr_reg = 1 << pin;
}

fn main() -> i32 {
    // Simulate GPIO register space with allocate
    let gpio = state_new(_L1);

    led_pin: u32 = 25;

    // Simulate blink: set output, set high, clear, set high
    gpio_set_output(gpio, led_pin);
    gpio_set(gpio, led_pin);
    gpio_clear(gpio, led_pin);
    gpio_set(gpio, led_pin);

    return 0;
}
