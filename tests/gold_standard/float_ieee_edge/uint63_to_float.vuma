// uint63_to_float — Convert 2^63 (as unsigned) to f64 and back.
// Expected exit code: 0
//
// 2^63 = i64::MIN as bits (high bit set).  uinttofloat must treat it as
// unsigned 2^63 -> +9.22e18 (positive).  floattouint must round-trip.
// Return 0 if both checks pass.
//
// We construct 2^63 as (1 << 63) to avoid the parser limitation that
// -9223372036854775808 (i64::MIN) is parsed as unary minus applied to
// 9223372036854775808, which overflows i64 before the negation.

fn main() -> i32 {
    n: i64 = 1;
    n = n << 63;  // n = 2^63 = i64::MIN (high bit set)
    big: f64 = uinttofloat(n);
    zero: f64 = 0.0;
    if big > zero {
        // Round-trip: floattouint(big) should have the high bit set,
        // i.e. be negative as a signed i64 (< 0).
        back: i64 = floattouint(big);
        if back < 0 {
            return 0;  // both checks passed
        }
        return 2;  // round-trip failed (high bit not set)
    }
    return 1;  // sign check failed (uinttofloat produced negative)
}
