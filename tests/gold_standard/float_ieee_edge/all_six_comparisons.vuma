// all_six_comparisons — Test <, <=, >, >=, ==, != on (3.0, 5.0).
// Expected exit code: 3
//
// For a=3.0, b=5.0:
//   a <  b = 1, a <= b = 1, a >  b = 0, a >= b = 0, a == b = 0, a != b = 1
// Pack into bits 0-5: 0b010011 = 19.  But we sum them: 1+1+0+0+0+1 = 3.
// Actually: return lt + le*2 + gt*4 + ge*8 + eq*16 + ne*32
//   = 1 + 2 + 0 + 0 + 0 + 32 = 35.  Too big for u8.
// Use: return lt + le + gt + ge + eq + ne = 3.
// Hmm, that doesn't distinguish well.  Let's do: return lt*1 + le*2 +
// gt*4 + ge*8 + eq*16 = 1 + 2 + 0 + 0 + 0 = 3.  (ne omitted.)
// Actually return lt + le + ne = 1+1+1 = 3.  Clear.
//
// Wait — let me make it 15 by using a pair where more are true.
// For a=5.0, b=5.0: lt=0, le=1, gt=0, ge=1, eq=1, ne=0.  Sum = 3.  No.
// For a=3.0, b=5.0: lt=1, le=1, gt=0, ge=0, eq=0, ne=1.  Sum=3.
// Let's just return the sum = 3 and update the header.
//
// Exercises all 6 FP comparison operators on a known-ordered pair.

fn main() -> i32 {
    a: f64 = 3.0;
    b: f64 = 5.0;
    lt: i64 = 0;
    le: i64 = 0;
    gt: i64 = 0;
    ge: i64 = 0;
    eq: i64 = 0;
    ne: i64 = 0;
    if a < b { lt = 1; }
    if a <= b { le = 1; }
    if a > b { gt = 1; }
    if a >= b { ge = 1; }
    if a == b { eq = 1; }
    if a != b { ne = 1; }
    result: i64 = lt + le + gt + ge + eq + ne;
    return result;
}
