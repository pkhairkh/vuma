// f64_array_sum — sum a 5-element f64 array of 2.0 each = 10.0 -> 10
// Expected exit code: 10

layout Array5 = { data: [f64; 5] }

fn main() -> i32 {
    a = state_new(Array5);
    i: i64 = 0;
    while i < 5 {
        a.data[i] = 2.0;
        i = i + 1;
    }
    total: f64 = 0.0;
    j: i64 = 0;
    while j < 5 {
        val: f64 = a.data[j];
        total = total + val;
        j = j + 1;
    }
    result: i64 = floattoint(total);
    return result;
}
