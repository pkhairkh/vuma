// f64_array_sum — sum a 5-element f64 array of 2.0 each = 10.0 -> 10
// Expected exit code: 10

layout Array5 = { data: [f64; 5] }

fn main() -> i32 {
    let a = state_new(Array5);
    let i = 0;
    while i < 5 {
        a.data[i] = 2.0;
        i = i + 1;
    }
    let total = 0.0;
    let j = 0;
    while j < 5 {
        let val = a.data[j];
        total = total + val;
        j = j + 1;
    }
    let result = floattoint(total);
    return result;
}
