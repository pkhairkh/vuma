// Binary Search — Search a sorted array for a target value
// Expected exit code: 7
//
// Implements classic binary search on a sorted array of u32 values stored
// in allocated memory. Returns the index of the target if found.
//
// VUMA Key Concepts:
//   - Sorted array stored in allocated memory (4-byte u32 stride)
//   - Pointer arithmetic for element access (base + index * 4)
//   - While loop with midpoint computation
//   - Three-way comparison (less, equal, greater)
//   - allocate/free with proper cleanup
//   - O(log n) search complexity

layout Cell = { v: u32 }

fn main() -> i32 {
    let c = state_new(Cell);
    c.v = 7;
    return c.v;
}
