// Migrated from pointers/ptr_temp_swap.vuma
// Expected exit code: 1
//
// PMT migration: allocate/free/*ptr replaced with state_new(Layout)
// + field access. Buffer lifetime auto-managed.

layout Pair = { a: u32, b: u32 }

fn main() -> i32 {
    let __s = state_new(Pair);
    __s.a = 1;
    __s.b = 2;
    let va = __s.a;
    let vb = __s.b;
    let tmp = va;
    va = vb;
    vb = tmp;
    __s.b = vb;
    let result = __s.b;
    return result;
}
