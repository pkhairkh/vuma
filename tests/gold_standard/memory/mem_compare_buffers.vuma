// mem_compare_buffers.vuma — compare two buffers
// Expected exit code: 0
//
// Allocates two buffers, fills both with the same pattern, compares them.
// Returns 0 if they match, 1 if they differ.

layout _L1 = { v: u32 }
layout _L2 = { v: u32 }
fn main() -> i32 {
    let a = state_new(_L1);
    let b = state_new(_L2);
    a.data[0] = 10;
    a.data[1] = 20;
    a.data[2] = 30;
    a.data[3] = 40;
    a.data[4] = 50;
    a.data[5] = 60;
    a.data[6] = 70;
    a.data[7] = 80;
    b.data[0] = 10;
    b.data[1] = 20;
    b.data[2] = 30;
    b.data[3] = 40;
    b.data[4] = 50;
    b.data[5] = 60;
    b.data[6] = 70;
    b.data[7] = 80;
    equal: u32 = 1;
    i: u32 = 0;
    while i < 8 {
        va: u32 = *(a + i);
        vb: u32 = *(b + i);
        if va != vb { equal = 0; }
        i = i + 1;
    }
    if equal == 1 { return 0; }
    return 1;
}
