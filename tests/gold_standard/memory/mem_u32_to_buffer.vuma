// mem_u32_to_buffer.vuma — write u32 as 4 bytes
// Expected exit code: 18
//
// Decomposes u32 0x12345678 into 4 big-endian bytes and stores them.
// Returns the first byte (0x12 = 18).

layout _L1 = { v: u32 }
fn main() -> i32 {
    let buf = state_new(_L1);
    val: u32 = 0x12345678;
    buf.data[0] = ((val >> 24) & 255);
    buf.data[1] = ((val >> 16) & 255);
    buf.data[2] = ((val >> 8) & 255);
    buf.data[3] = (val & 255);
    b0: u32 = buf.data[0];
    return b0;
}
