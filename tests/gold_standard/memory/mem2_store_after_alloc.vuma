// mem2_store_after_alloc — allocate, then store, then load
// Expected exit code: 42
//
// Validates that the canonical allocate→store→load sequence works on a
// freshly-allocated buffer (the cell is writable immediately after
// allocation returns).  Straight-line code only.

layout Cell = { v: u32 }

fn main() -> i32 {
    let c = state_new(Cell);
    c.v = 42;
    return c.v;
}
