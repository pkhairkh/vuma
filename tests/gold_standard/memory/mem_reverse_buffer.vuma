// mem_reverse_buffer.vuma — reverse buffer contents in place
// Expected exit code: 0
//
// Fills a buffer with values 1..8, reverses in place, verifies the
// reversal: position i should now hold value (8 - i).

layout _L1 = { v: u32 }
fn main() -> i32 {
    let buf = state_new(_L1);
    // Fill with 1..8
    buf.data[0] = 1;
    buf.data[1] = 2;
    buf.data[2] = 3;
    buf.data[3] = 4;
    buf.data[4] = 5;
    buf.data[5] = 6;
    buf.data[6] = 7;
    buf.data[7] = 8;
    // Reverse in place
    i: u32 = 0;
    while i < 4 {
        j: u32 = 8 - 1 - i;
        vi: u32 = buf.data[i];
        vj: u32 = buf.data[j];
    buf.data[i] = vj;
    buf.data[j] = vi;
        i = i + 1;
    }
    // Verify: position 0 should be 8, position 7 should be 1
    v0: u32 = buf.data[0];
    v7: u32 = buf.data[7];
    if v0 == 8 {
        if v7 == 1 { return 0; }
    }
    return 1;
}
