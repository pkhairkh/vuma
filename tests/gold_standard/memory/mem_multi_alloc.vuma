// Migrated from memory/mem_multi_alloc.vuma
// Expected exit code: 60
//
// PMT migration: allocate/free/*ptr replaced with state_new(Layout)
// + field access. Buffer lifetime auto-managed.

layout Triple = { a: u32, b: u32, c: u32 }

fn main() -> i32 {
    let __s = state_new(Triple);
    __s.a = 10;
    __s.b = 20;
    __s.c = 30;
    let va = __s.a;
    let vb = __s.b;
    let vc = __s.c;
    let sum = va + vb + vc;
    return sum;
}
