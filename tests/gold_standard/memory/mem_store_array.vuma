// mem_store_array.vuma — store array of values
// Expected exit code: 0
//
// Stores 8 byte values (0..7) into a buffer at consecutive offsets,
// then verifies integrity by re-loading and summing. Sum should be 28.

layout _L1 = { a: u32, b: u32 }
fn main() -> i32 {
    let buf = state_new(_L1);
    buf.data[0] = 0;
    buf.data[1] = 1;
    buf.data[2] = 2;
    buf.data[3] = 3;
    buf.data[4] = 4;
    buf.data[5] = 5;
    buf.data[6] = 6;
    buf.data[7] = 7;
    sum: u32 = 0;
    b0: u32 = buf.data[0]; sum = sum + b0;
    b1: u32 = buf.data[1]; sum = sum + b1;
    b2: u32 = buf.data[2]; sum = sum + b2;
    b3: u32 = buf.data[3]; sum = sum + b3;
    b4: u32 = buf.data[4]; sum = sum + b4;
    b5: u32 = buf.data[5]; sum = sum + b5;
    b6: u32 = buf.data[6]; sum = sum + b6;
    b7: u32 = buf.data[7]; sum = sum + b7;
    if sum == 28 { return 0; }
    return 1;
}
