// Migrated from memory/s10_mem_quad_buf_sum.vuma
// Expected exit code: 100
//
// PMT migration: allocate/free/*ptr replaced with state_new(Layout)
// + field access. Buffer lifetime auto-managed.

layout Quad = { a: u32, b: u32, c: u32, d: u32 }

fn main() -> i32 {
    let __s = state_new(Quad);
    __s.a = 10;
    __s.b = 20;
    __s.c = 30;
    __s.d = 40;
    let va = __s.a;
    let vb = __s.b;
    let vc = __s.c;
    let vd = __s.d;
    let t1 = va + vb;
    let t2 = t1 + vc;
    let s = t2 + vd;
    return s;
}
