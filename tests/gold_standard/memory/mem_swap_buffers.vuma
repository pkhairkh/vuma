// mem_swap_buffers.vuma — swap contents of two buffers
// Expected exit code: 0
//
// Fills buf_a with 1..4 and buf_b with 5..8, swaps them via a temp buffer,
// verifies that buf_a now contains 5..8 and buf_b contains 1..4.

layout _L1 = { v: u32 }
layout _L2 = { v: u32 }
layout _L3 = { v: u32 }
fn main() -> i32 {
    let a = state_new(_L1);
    let b = state_new(_L2);
    let tmp = state_new(_L3);
    a.data[0] = 1; *(a + 1) = 2; *(a + 2) = 3; *(a + 3) = 4;
    b.data[0] = 5; *(b + 1) = 6; *(b + 2) = 7; *(b + 3) = 8;
    // Swap: tmp = a; a = b; b = tmp
    i: u32 = 0;
    while i < 4 {
        va: u32 = *(a + i);
        *(tmp + i) = va;
        vb: u32 = *(b + i);
        *(a + i) = vb;
        vt: u32 = *(tmp + i);
        *(b + i) = vt;
        i = i + 1;
    }
    // Verify
    ok: u32 = 1;
    a0: u32 = a.data[0];
    if a0 != 5 { ok = 0; }
    b0: u32 = b.data[0];
    if b0 != 1 { ok = 0; }
    if ok == 1 { return 0; }
    return 1;
}
