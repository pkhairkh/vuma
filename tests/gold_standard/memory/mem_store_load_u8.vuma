// mem_store_load_u8.vuma — store/load u8 (single byte)
// Expected exit code: 200
//
// Stores a single byte value at the start of a buffer and loads it back.

layout _L1 = { v: u32 }
fn main() -> i32 {
    let buf = state_new(_L1);
    buf.data[0] = 200;
    val: u32 = buf.data[0];
    return val;
}
