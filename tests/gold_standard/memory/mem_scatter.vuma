// mem_scatter.vuma — scatter values to non-contiguous locations
// Expected exit code: 0
//
// Scatters 4 values from a contiguous source buffer to non-contiguous
// locations in a destination buffer (offsets 0, 4, 8, 12). Verifies the
// scattered values are at the correct offsets.

layout _L1 = { v: u32 }
layout _L2 = { a: u32, b: u32 }
fn main() -> i32 {
    let src = state_new(_L1);
    let dst = state_new(_L2);
    // Source: [10, 20, 30, 40]
    src.data[0] = 10;
    src.data[1] = 20;
    src.data[2] = 30;
    src.data[3] = 40;
    // Scatter to dst at offsets 0, 4, 8, 12
    s0: u32 = src.data[0]; dst.data[0] = s0;
    s1: u32 = src.data[1]; dst.data[4] = s1;
    s2: u32 = src.data[2]; dst.data[8] = s2;
    s3: u32 = src.data[3]; dst.data[12] = s3;
    // Verify
    d0: u32 = dst.data[0];
    d4: u32 = dst.data[4];
    d8: u32 = dst.data[8];
    d12: u32 = dst.data[12];
    if d0 == 10 {
        if d4 == 20 {
            if d8 == 30 {
                if d12 == 40 { return 0; }
            }
        }
    }
    return 1;
}
