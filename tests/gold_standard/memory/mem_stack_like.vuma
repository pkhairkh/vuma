// mem_stack_like.vuma — simulate a stack (push/pop in memory)
// Expected exit code: 0
//
// Simulates a stack in a memory buffer. Pushes 3 values, then pops them
// and verifies LIFO order. Top of stack pointer advances/retreats.

layout _L1 = { v: u32 }
fn main() -> i32 {
    let stack = state_new(_L1);
    top: u32 = 0;
    // Push 10, 20, 30
    stack.data[top] = 10; top = top + 1;
    stack.data[top] = 20; top = top + 1;
    stack.data[top] = 30; top = top + 1;
    // Pop three times (LIFO: 30, 20, 10)
    top = top - 1;
    pop3: u32 = stack.data[top];
    top = top - 1;
    pop2: u32 = stack.data[top];
    top = top - 1;
    pop1: u32 = stack.data[top];
    if pop3 == 30 {
        if pop2 == 20 {
            if pop1 == 10 { return 0; }
        }
    }
    return 1;
}
