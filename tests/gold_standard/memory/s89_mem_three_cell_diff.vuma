layout Triple = { a: u32, b: u32, c: u32 }

fn main() -> i32 {
    let __s = state_new(Triple);
    __s.a = 80;
    __s.b = 45;
    __s.c = 15;
    let a = __s.a;
    let b = __s.b;
    let d = __s.c;
