// mem_string_compare.vuma — compare two strings
// Expected exit code: 0
//
// Compares two null-terminated strings stored in buffers. Returns 0 if
// equal, 1 if not.

layout _L1 = { v: u32 }
layout _L2 = { v: u32 }
fn main() -> i32 {
    let a = state_new(_L1);
    let b = state_new(_L2);
    a.data[0] = 65; *(a + 1) = 66; *(a + 2) = 67; *(a + 3) = 0;
    b.data[0] = 65; *(b + 1) = 66; *(b + 2) = 67; *(b + 3) = 0;
    equal: u32 = 1;
    i: u32 = 0;
    while i < 4 {
        va: u32 = *(a + i);
        vb: u32 = *(b + i);
        if va != vb { equal = 0; }
        i = i + 1;
    }
    if equal == 1 { return 0; }
    return 1;
}
