// Migrated from memory/s48_mem_overwrite_first.vuma
// Expected exit code: 240
//
// PMT migration: allocate/free/*ptr replaced with state_new(Layout)
// + field access. Buffer lifetime auto-managed.

layout Triple = { a: u32, b: u32, c: u32 }

fn main() -> i32 {
    let __s = state_new(Triple);
    __s.a = 40;
    __s.b = 70;
    __s.c = 90;
    __s.a = 80;
    let a = __s.a;
    let b = __s.b;
    let c = __s.c;
    let t = a + b;
    let s = t + c;
    return s;
}
