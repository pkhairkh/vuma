// inbounds_last_index — Access at last valid index
// Expected exit code: 7
//
// Bounds positive test: allocate an 8-byte buffer (via PMT
// state_new of a layout containing a `[u8; 8]` array field), write
// the value 7 to index 7 (the last valid index, == length-1), then
// read it back. With bounds-check IR (always on in VUMA 2.0), the index
// 7 is within `[0, 8)` so the injected `UGe(7, 8)` check evaluates to
// false → no `__oob_trap` fires. (In legacy mode without bounds-check
// IR, the access is well-defined and the Load returns 7.)
//
// VUMA Key Concepts:
//   - state_new(Layout) allocation (PMT idiom)
//   - layout with fixed-size array field: `data: [u8; 8]`
//   - boundary case: index == length-1 (last valid index)
//   - exercises the bounds-check injection site at the edge of the
//     valid range — adjacent to the off-by-one trap in oob_offbyone.

layout Buf = { data: [u8; 8] }

transform main() -> i32 {
    let b = state_new(Buf);
    b.data[7] = 7;
    return b.data[7];
}
