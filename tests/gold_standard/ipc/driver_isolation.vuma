// driver_isolation — Wave 49-64: driver isolation marker test.
//
// Driver isolation (per-driver sandboxes with IRQ routing) is
// implemented in ipc.rs (DriverWorkerConfig, TrustedDriverRegistry).
// This .vuma test verifies that the basic channel infrastructure
// still works when driver-isolation-aware code is compiled.
//
// Expected exit code: 42
fn main() -> i32 {
    ch = channel_open<i64>();
    pid = spawn_worker();
    if pid == 0 {
        x = channel_recv(ch);
        channel_close(ch);
        return x as i32;
    }
    channel_send(ch, 42);
    status = wait_worker(pid);
    channel_close(ch);
    return status;
}
