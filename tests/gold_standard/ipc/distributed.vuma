// distributed — Wave 77-88: distributed channel marker test.
//
// Distributed channels (DistributedChannel, NodeRegistry) are
// implemented in ipc.rs. This .vuma test verifies that the basic
// channel infrastructure works when distributed-channel-aware code
// is compiled.
//
// Expected exit code: 42
fn main() -> i32 {
    ch = channel_open<i64>();
    pid = spawn_worker();
    if pid == 0 {
        x = channel_recv(ch);
        channel_close(ch);
        return x as i32;
    }
    channel_send(ch, 42);
    status = wait_worker(pid);
    channel_close(ch);
    return status;
}
