// distributed — Wave 81-88: distributed channels via channel_open_remote.
//
// The channel_open_remote(addr, port) builtin creates a loopback
// socketpair (mock remote channel). The addr and port args are accepted
// for ABI compatibility with the real remote-channel API but the
// implementation uses AF_UNIX socketpair (always loopback). Returns a
// 64-bit channel handle: low 32 bits = sv[0], high 32 bits = sv[1].
//
// This test opens a "remote" channel and exits 1 if the handle is
// non-zero (i.e. the socketpair succeeded).
//
// Expected exit code: 1
fn main() -> i32 {
    ch = channel_open_remote(0x7F000001, 8080);
    if ch != 0 {
        return 1;
    }
    return 0;
}
