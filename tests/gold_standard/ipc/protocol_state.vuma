// protocol_state — Wave 14: verify protocol state machine type_hash check.
//
// Sends an i64 message through a framed channel. The receiver's
// protocol check (Wave 14b) verifies the type_hash in the received
// frame matches the expected type_hash for the recv site. Since the
// sender and receiver both use i64, the type_hashes match and the
// message is delivered.
//
// If the protocol check were broken (e.g., comparing against the wrong
// type_hash), the receiver would store -5 (PROTOCOL_VIOLATION) and
// the test would exit with a different value.
//
// Expected exit code: 42
fn main() -> i32 {
    ch = channel_open<i64>();
    pid = spawn_worker();
    if pid == 0 {
        x = channel_recv(ch);
        channel_close(ch);
        return x as i32;
    }
    channel_send(ch, 42);
    status = wait_worker(pid);
    channel_close(ch);
    return status;
}
