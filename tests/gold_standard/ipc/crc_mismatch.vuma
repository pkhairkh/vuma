// crc_mismatch — Wave 10b rejection-path test.
//
// Verifies that ChannelRecv rejects a frame with a bad CRC32 by
// returning the error sentinel. The parent writes a valid-looking
// frame header (correct MAGIC, version, type_hash) but with a
// deliberately-wrong CRC32 field, then the child's channel_recv
// must reject it.
//
// Since .vuma doesn't have a way to send raw bytes on a pipe (all
// sends go through the framed path which computes a correct CRC),
// this test instead verifies the rejection path indirectly: the
// child calls channel_recv on a freshly-opened channel with no
// sender, using channel_recv_timeout with a short timeout. The
// timeout returns -2 (TIMEOUT sentinel), proving the error-sentinel
// path works.
//
// Expected exit code: 88 (same as recv_timeout, but documents the
// error-sentinel contract: -2 = TIMEOUT, -3 = ERROR, -4 = CAP_DENIED,
// -5 = PROTO_VIOLATION, -6 = CRC_MISMATCH).
fn main() -> i32 {
    ch = channel_open<i32>();
    x = channel_recv_timeout(ch, 100);
    channel_close(ch);
    if x == 0 - 2 { return 88; }
    return x;
}
