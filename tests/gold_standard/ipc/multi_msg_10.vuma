// multi_msg_10 — Send 10 messages, receive 10 in order
// Expected exit code: 55
fn main() -> i32 {
    ch = channel_open<i32>();
    pid = spawn_worker();
    if pid == 0 {
        sum = 0;
        i = 0;
        while i < 10 {
            x = channel_recv(ch);
            sum = sum + x;
            i = i + 1;
        }
        channel_close(ch);
        return sum;
    }
    i = 0;
    while i < 10 {
        channel_send(ch, i);
        i = i + 1;
    }
    status = wait_worker(pid);
    channel_close(ch);
    return status;
}
