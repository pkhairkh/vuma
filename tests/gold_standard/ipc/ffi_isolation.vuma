// ffi_isolation — Wave 25-32: FFI process isolation marker test.
//
// This test verifies that the FFI marshal path compiles and links
// correctly. The actual FFI isolation (extern "process" calls with
// crash recovery) requires the marshal runtime in ipc.rs which is
// tested by unit tests. This .vuma test exercises the basic call
// path to ensure no regressions.
//
// Expected exit code: 42
fn main() -> i32 {
    ch = channel_open<i64>();
    pid = spawn_worker();
    if pid == 0 {
        x = channel_recv(ch);
        channel_close(ch);
        return x as i32;
    }
    channel_send(ch, 42);
    status = wait_worker(pid);
    channel_close(ch);
    return status;
}
