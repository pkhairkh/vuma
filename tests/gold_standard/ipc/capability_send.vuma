// capability_send — Wave 12: verify capability-presence check on receive.
//
// Sends a message WITHOUT capabilities (cap_count=0, the default from
// Wave 10a's ChannelSend codegen). The receiver's capability check
// (Wave 12b) should accept the message and deliver the payload.
//
// If the receiver incorrectly rejects the message (e.g., treats
// cap_count=0 as an error), the recv would return -1 or -4 instead
// of the sent value, and the test would fail.
//
// Expected exit code: 42
fn main() -> i32 {
    ch = channel_open<i64>();
    pid = spawn_worker();
    if pid == 0 {
        x = channel_recv(ch);
        channel_close(ch);
        return x as i32;
    }
    channel_send(ch, 42);
    status = wait_worker(pid);
    channel_close(ch);
    return status;
}
