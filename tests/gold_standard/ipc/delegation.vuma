// delegation — Wave 33-40: capability delegation.
//
// Exercises the capability_grant builtin (mints a root token at compile
// time) and the capability_delegate builtin (mints a delegated child
// token whose delegation_depth = 1, bound to the parent's id via the
// signing key).
//
// The parent grants a cap (resource_id=7, perms=3=r|w), then delegates
// it to a child with reduced perms=1 (read-only). The delegated child
// token's id is non-zero (passes the structural recv check) and has
// its high bit set (marking it as delegated). The test exits 1 if the
// delegated token id is non-zero.
//
// Expected exit code: 1
fn main() -> i32 {
    cap = capability_grant(7, 3);
    delegated = capability_delegate(cap, 7, 1);
    if delegated != 0 {
        return 1;
    }
    return 0;
}
