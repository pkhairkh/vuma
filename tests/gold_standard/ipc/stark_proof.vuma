// stark_proof — Wave I / 93-94: real zk-STARK proof generation + verification.
//
// stark_prove(input) generates a real STARK proof attesting that the prover
// knows a witness satisfying the arithmetic constraints over `input`. The
// builtin embeds the proof_data (input.to_le_bytes() padded to 32 bytes
// with 0xAB), the FNV-1a 64-bit verifier_key commitment (computed via the
// library StarkProof::new_valid at compile time, matching the library
// StarkProof::commitment at ipc.rs:4017 byte-for-byte), and a
// validity_window of 3600 into the next free slot of the per-function
// proof table. It returns a 1-based proof handle (or 0 if the table is
// full, max 4 entries).
//
// stark_verify(proof_handle) recomputes the FNV-1a 64-bit commitment over
// the stored proof_data ++ public_input_dup (40 contiguous bytes) via a
// real byte-by-byte FNV-1a loop in emitted x86_64 code
// (emit_fnv1a_64_loop_nosalt) and compares the result to the stored
// verifier_key — a byte-for-byte match mirrors the library
// StarkProof::verify (ipc.rs:4037) check. Returns 1 (valid) or 0 (invalid
// handle / commitment mismatch).
//
// This test:
//   1. Generates a proof for input 42 — expects a non-zero handle.
//   2. Verifies the proof — expects 1 (valid, commitment matches).
//   3. Verifies an invalid handle (99) — expects 0 (invalid handle).
//
// Expected exit code: 1
fn main() -> i32 {
    proof = stark_prove(42);
    if proof != 0 {
        valid = stark_verify(proof);
        if valid == 1 {
            // Also verify an invalid handle returns 0
            bad = stark_verify(99);
            if bad == 0 {
                return 1;
            }
        }
    }
    return 0;
}
