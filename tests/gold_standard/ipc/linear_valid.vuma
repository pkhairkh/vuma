// linear_valid — Wave 95: linear-type checking (each variable used once).
//
// A linear variable is one that must be used exactly once — using it
// twice is a linear-type violation (a "double-use"). This program is
// a linearly-valid program: each variable is bound and then used in
// exactly one subsequent operation, so the IVE linear_check function
// (in src/ive/src/borrow_region.rs) accepts it.
//
// Linear flow:
//   x = 1          (bind x)
//   y = x + 1      (use x once → bind y) — x consumed
//   z = y - 1      (use y once → bind z) — y consumed
//   return z       (use z once)          — z consumed
//
// Each variable is used exactly once; no double-uses. The program
// returns 1.
//
// Expected exit code: 1
fn main() -> i32 {
    x = 1;
    y = x + 1;
    z = y - 1;
    if z == 1 {
        return 1;
    }
    return 0;
}
