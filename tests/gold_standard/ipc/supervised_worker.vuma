// supervised_worker — Wave 22: supervised workers
// A supervisor spawns a worker, monitors it, and detects when it exits.
// Expected exit code: 1
fn main() -> i32 {
    ch = channel_open<i32>();
    pid = spawn_worker();
    if pid == 0 {
        channel_send(ch, 42);
        channel_close(ch);
        return 0;
    }
    x = channel_recv(ch);
    status = wait_worker(pid);
    channel_close(ch);
    if status == 0 { return 1; }
    return 0;
}
