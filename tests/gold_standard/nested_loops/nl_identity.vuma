// nl_identity.vuma — 2x2 identity matrix, return [0][0]
// Expected exit code: 1
//
// Builds a 2x2 identity matrix in memory via nested loops. Each cell at
// (i,j) is set to (i == j) cast to u32 — 1 on the diagonal, 0 elsewhere.
// Returns cell (0,0), which should be 1.
// NOW PASSING until the for-body assignment propagation bug is fixed.

layout _L1 = { a: u32, b: u32 }
fn main() -> i32 {
    let m = state_new(_L1);
    for i in 0..2 {
        for j in 0..2 {
            eq: bool = (i == j);
            v: u64 = eq;
            off: u64 = (i * 2 + j) * 4;
            *(m + off) = v;
        }
    }
    out: u32 = m.data[0];
    return out;
}
