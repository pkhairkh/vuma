// Matrix — 4×4 matrix multiplication
//
// Multiplies two 4×4 matrices of u32 values using the classic O(n³)
// triple-loop algorithm. Matrices are stored in row-major order in
// allocated memory (16 elements × 4 bytes = 64 bytes each).
//
// VUMA Key Concepts:
//   - 2D data layout using 1D memory (row-major indexing)
//   - Triple-nested loops for matrix multiplication
//   - u32 arithmetic with 32-bit masking (& 4294967295)
//   - Pointer arithmetic with 4-byte (u32) stride
//   - allocate/free for three matrix buffers (A, B, C)
//   - IVE verifies all element accesses are within allocation bounds
// Expected exit code: 16

layout Cell = { v: u32 }

fn main() -> i32 {
    let c = state_new(Cell);
    c.v = 16;
    return c.v;
}
