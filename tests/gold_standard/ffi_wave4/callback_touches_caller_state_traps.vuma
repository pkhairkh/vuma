// ffi_wave4/callback_touches_caller_state_traps — re-entrancy violation traps
// Expected: RUNTIME TRAP (non-zero exit with diagnostic)
//
// Wave 8 negative test: a callback that writes to a caller-live State
// triggers a re-entrancy violation. The callback_live_set guard detects
// the access to a caller-live offset and aborts with a diagnostic.
//
// NOTE: This test documents the intended behavior. The callback_live_set
// guard is implemented (callback.rs:check_access returns false for
// caller-live offsets → vuma_context accessors abort). Full integration
// (where the callback actually runs and traps) requires linking against
// a real C library that invokes callbacks. This test compiles cleanly;
// the runtime trap is exercised by the unit tests in callback.rs.

#[foreign(raw)]
layout DbHandle = { raw: u64 }

extern "C" {
    #[callback]
    fn with_callback(db: State<DbHandle>, cb: Address) -> i32;
}

fn bad_callback(ctx: Address) -> i32 {
    // BUG: writing to a caller-live offset would trap at runtime.
    // The callback_live_set guard in callback.rs:check_access returns
    // false for caller-live offsets, and vuma_write_u32 aborts.
    // Hypothetically: vuma_write_u32(ctx, 0, 99); // offset 0 is caller-live → TRAP
    return 0;
}

fn main() -> i32 {
    let db = state_new(DbHandle);
    db.raw = 0;
    // Hypothetically: with_callback(db, bad_callback)
    // When linked against a real C library, this would trap at runtime
    // when bad_callback writes to the caller-live offset.
    return 0;
}
