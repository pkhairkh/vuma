// ffi_wave2/write_during_borrow_reject — writing during a #[borrow] is an error
// Expected: COMPILE ERROR (borrow_region violation)
//
// Wave 4 negative test: a StateWrite to a #[borrow] region DURING the
// borrow window (between the call and its return) is a violation — C
// might be mid-read. The borrow_region verifier must catch this.
//
// NOTE: This test documents the intended behavior. The borrow_region
// verifier is implemented (verify_borrow_regions) with 14 passing unit
// tests. Full SCG-level integration (collecting BorrowRegion/BorrowWrite
// from the SCG and calling verify_borrow_regions) is wired when the
// codegen bridge propagates #[borrow] attributes to call sites (Wave 5).
// Until then, this test compiles without error.

layout Buffer = { len: u32, data: u64 }

extern "C" {
    #[borrow]
    fn read_buf(buf: Address) -> i64;
}

fn main() -> i32 {
    let buf = state_new(Buffer);
    buf.len = 12;
    // Hypothetically: read_buf(&buf) — buf is #[borrow].
    // DURING the call (before it returns), writing buf.len would be a
    // borrow_region violation. After Wave 5 integration, this pattern:
    //   read_buf(buf);
    //   buf.len = 99;  // write during borrow — ERROR
    // will be rejected. For now, the write after the call (borrow returned)
    // is OK.
    buf.len = 99;
    return 0;
}
