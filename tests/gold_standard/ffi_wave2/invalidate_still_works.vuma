// ffi_wave2/invalidate_still_works — default (no attr) still invalidates
// Expected exit code: 0
//
// Wave 4 test: an extern fn with no #[borrow] attribute still invalidates
// its State argument (the existing behavior, unchanged). After the call,
// the state must be re-initialized before any read/write. This test
// demonstrates the re-init pattern: write, (hypothetical) call, re-init,
// read. Compiles cleanly with --verify.

layout Buf = { x: u32, y: u32 }

extern "C" {
    fn do_thing(buf: Address) -> i64;
}

fn main() -> i32 {
    let buf = state_new(Buf);
    buf.x = 10;
    buf.y = 20;
    // Hypothetically: do_thing(&buf) — buf is INVALIDATED (no #[borrow]).
    // Re-initialize before any subsequent read:
    buf.x = 30;
    buf.y = 40;
    // Now buf is valid again — reads are safe.
    if buf.x != 30 { return 1; }
    if buf.y != 40 { return 2; }
    return 0;
}
