// ffi_wave2/borrow_preserved — #[borrow] preserves state after the call
// Expected exit code: 0
//
// Wave 4 test: a foreign function declared with #[borrow] on its State
// argument promises not to mutate it. After the call, the state is
// PRESERVED — subsequent reads are still valid (no re-initialization
// required). The borrow_region verifier confirms no StateWrite occurs
// during the borrow window.
//
// This test declares the extern but does not actually call it (to remain
// backend-portable). The state manipulation around the (hypothetical)
// call site compiles cleanly: write before, read after.

layout Buffer = { len: u32, data: u64 }

extern "C" {
    #[borrow]
    fn state_size(buf: Address) -> i64;
}

fn main() -> i32 {
    let buf = state_new(Buffer);
    buf.len = 12;
    // Hypothetically: state_size(&buf) — buf is #[borrow], so preserved.
    // After the call, buf.len is still valid (no re-init needed).
    if buf.len != 12 { return 1; }
    return 0;
}
