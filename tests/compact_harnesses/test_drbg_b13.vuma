// drbg batch 13 (vector 13)
import "/home/z/my-project/workdir/vuma/womb/crypto/drbg/drbg.vuma"::{DrbgCtx, DrbgData, DrbgOut, drbg_init, drbg_generate};

transform main() -> i32 {
    let drbg = state_new(DrbgCtx);
    let entropy = state_new(DrbgData);
    let out = state_new(DrbgOut);
    entropy.bytes[0] = 221;
    entropy.bytes[1] = 252;
    entropy.bytes[2] = 27;
    entropy.bytes[3] = 58;
    entropy.bytes[4] = 89;
    entropy.bytes[5] = 120;
    entropy.bytes[6] = 151;
    entropy.bytes[7] = 182;
    entropy.bytes[8] = 213;
    entropy.bytes[9] = 244;
    entropy.bytes[10] = 19;
    entropy.bytes[11] = 50;
    entropy.bytes[12] = 81;
    entropy.bytes[13] = 112;
    entropy.bytes[14] = 143;
    entropy.bytes[15] = 174;
    entropy.bytes[16] = 205;
    entropy.bytes[17] = 236;
    entropy.bytes[18] = 11;
    entropy.bytes[19] = 42;
    entropy.bytes[20] = 73;
    entropy.bytes[21] = 104;
    entropy.bytes[22] = 135;
    entropy.bytes[23] = 166;
    entropy.bytes[24] = 197;
    entropy.bytes[25] = 228;
    entropy.bytes[26] = 3;
    entropy.bytes[27] = 34;
    entropy.bytes[28] = 65;
    entropy.bytes[29] = 96;
    entropy.bytes[30] = 127;
    entropy.bytes[31] = 158;
    drbg_init(drbg, entropy, 32, entropy, 0);
    drbg_generate(drbg, out, 32);
    let oi: u32 = 0;
    while oi < 32 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
