// drbg batch 17 (vector 17)
import "/home/z/my-project/workdir/vuma/womb/crypto/drbg/drbg.vuma"::{DrbgCtx, DrbgData, DrbgOut, drbg_init, drbg_generate};

transform main() -> i32 {
    let drbg = state_new(DrbgCtx);
    let entropy = state_new(DrbgData);
    let out = state_new(DrbgOut);
    entropy.bytes[0] = 33;
    entropy.bytes[1] = 64;
    entropy.bytes[2] = 95;
    entropy.bytes[3] = 126;
    entropy.bytes[4] = 157;
    entropy.bytes[5] = 188;
    entropy.bytes[6] = 219;
    entropy.bytes[7] = 250;
    entropy.bytes[8] = 25;
    entropy.bytes[9] = 56;
    entropy.bytes[10] = 87;
    entropy.bytes[11] = 118;
    entropy.bytes[12] = 149;
    entropy.bytes[13] = 180;
    entropy.bytes[14] = 211;
    entropy.bytes[15] = 242;
    entropy.bytes[16] = 17;
    entropy.bytes[17] = 48;
    entropy.bytes[18] = 79;
    entropy.bytes[19] = 110;
    entropy.bytes[20] = 141;
    entropy.bytes[21] = 172;
    entropy.bytes[22] = 203;
    entropy.bytes[23] = 234;
    entropy.bytes[24] = 9;
    entropy.bytes[25] = 40;
    entropy.bytes[26] = 71;
    entropy.bytes[27] = 102;
    entropy.bytes[28] = 133;
    entropy.bytes[29] = 164;
    entropy.bytes[30] = 195;
    entropy.bytes[31] = 226;
    drbg_init(drbg, entropy, 32, entropy, 0);
    drbg_generate(drbg, out, 32);
    let oi: u32 = 0;
    while oi < 32 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
