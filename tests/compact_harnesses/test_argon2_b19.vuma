// argon2 batch 19 (vector 19)
// argon2id 'final'/'vectorsalt' t=1 m=8 p=1 dklen=32
import "/home/z/my-project/workdir/vuma/womb/crypto/hash/blake2.vuma"::{Blake2bCtx, Blake2bData, Blake2bDigest, blake2b_init_64, blake2b_update, blake2b_final};
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/argon2.vuma"::{Argon2Buf, argon2id};

transform main() -> i32 {
    let password = state_new(Argon2Buf);
    let salt = state_new(Argon2Buf);
    let out = state_new(Argon2Buf);
    password.bytes[0] = 102;
    password.bytes[1] = 105;
    password.bytes[2] = 110;
    password.bytes[3] = 97;
    password.bytes[4] = 108;
    salt.bytes[0] = 118;
    salt.bytes[1] = 101;
    salt.bytes[2] = 99;
    salt.bytes[3] = 116;
    salt.bytes[4] = 111;
    salt.bytes[5] = 114;
    salt.bytes[6] = 115;
    salt.bytes[7] = 97;
    salt.bytes[8] = 108;
    salt.bytes[9] = 116;
    argon2id(password, 5, salt, 10, 1, 8, 1, out, 32);
    let oi: u32 = 0;
    while oi < 32 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
