    while ci < 32 { prk_key.bytes[ci] = prk.bytes[ci]; ci = ci + 1; }
    hkdf_expand_sha256(prk_key, info, 7, okm, 31);
    oi = 0;
    while oi < 31 {
        print_int(1000 + (okm.bytes[oi] as u32));
        oi = oi + 1;
    }
