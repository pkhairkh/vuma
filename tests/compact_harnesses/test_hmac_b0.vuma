// hmac batch 0 (vectors 0-1)
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hmac.vuma"::{HmacKey, HmacMsg, HmacOut, hmac_sha256};

transform main() -> i32 {
    let key = state_new(HmacKey);
    let msg = state_new(HmacMsg);
    let out = state_new(HmacOut);
    let oi: u32 = 0;
    // V0: RFC4231 Case 1 (20-byte key)
    msg.bytes[0] = 72;
    msg.bytes[1] = 105;
    msg.bytes[2] = 32;
    msg.bytes[3] = 84;
    msg.bytes[4] = 104;
    msg.bytes[5] = 101;
    msg.bytes[6] = 114;
    msg.bytes[7] = 101;
    key.bytes[0] = 11;
    key.bytes[1] = 11;
    key.bytes[2] = 11;
    key.bytes[3] = 11;
    key.bytes[4] = 11;
    key.bytes[5] = 11;
    key.bytes[6] = 11;
    key.bytes[7] = 11;
    key.bytes[8] = 11;
    key.bytes[9] = 11;
    key.bytes[10] = 11;
    key.bytes[11] = 11;
    key.bytes[12] = 11;
    key.bytes[13] = 11;
    key.bytes[14] = 11;
    key.bytes[15] = 11;
    key.bytes[16] = 11;
    key.bytes[17] = 11;
    key.bytes[18] = 11;
    key.bytes[19] = 11;
    hmac_sha256(key, 20, msg, 8, out);
    oi = 0;
    while oi < 32 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    // V1: RFC4231 Case 2 (Jefe)
    msg.bytes[0] = 119;
    msg.bytes[1] = 104;
    msg.bytes[2] = 97;
    msg.bytes[3] = 116;
    msg.bytes[4] = 32;
    msg.bytes[5] = 100;
    msg.bytes[6] = 111;
    msg.bytes[7] = 32;
    msg.bytes[8] = 121;
    msg.bytes[9] = 97;
    msg.bytes[10] = 32;
    msg.bytes[11] = 119;
    msg.bytes[12] = 97;
    msg.bytes[13] = 110;
    msg.bytes[14] = 116;
    msg.bytes[15] = 32;
    msg.bytes[16] = 102;
    msg.bytes[17] = 111;
    msg.bytes[18] = 114;
    msg.bytes[19] = 32;
    msg.bytes[20] = 110;
    msg.bytes[21] = 111;
    msg.bytes[22] = 116;
    msg.bytes[23] = 104;
    msg.bytes[24] = 105;
    msg.bytes[25] = 110;
    msg.bytes[26] = 103;
    msg.bytes[27] = 63;
    key.bytes[0] = 74;
    key.bytes[1] = 101;
    key.bytes[2] = 102;
    key.bytes[3] = 101;
    hmac_sha256(key, 4, msg, 28, out);
    oi = 0;
    while oi < 32 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}