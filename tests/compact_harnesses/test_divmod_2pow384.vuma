// Test divmod with upper bits: 2^384 mod P-256
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, Bn512Ctx, bn256_divmod_512, bn256_zero, bn256_set_u32};
import "/home/z/my-project/workdir/vuma/womb/crypto/asym/ecdsa_p256.vuma"::{B32, p256_p, be32_to_bn256};

transform main() -> i32 {
    let dividend = state_new(Bn512Ctx);
    let divisor = state_new(Bn256Ctx);
    let quotient = state_new(Bn512Ctx);
    let remainder = state_new(Bn256Ctx);

    // dividend = 2^384 (limb[6] = 1)
    dividend.limbs[6] = 1;

    let p_be = state_new(B32);
    p256_p(p_be);
    be32_to_bn256(divisor, p_be);

    bn256_divmod_512(dividend, divisor, quotient, remainder);

    // Output remainder (4 limbs)
    let oi: u32 = 0;
    while oi < 4 {
        let v = remainder.limbs[oi];
        print_int(1000 + (((v >> 56) & 255) as u32));
        print_int(1000 + (((v >> 48) & 255) as u32));
        print_int(1000 + (((v >> 40) & 255) as u32));
        print_int(1000 + (((v >> 32) & 255) as u32));
        print_int(1000 + (((v >> 24) & 255) as u32));
        print_int(1000 + (((v >> 16) & 255) as u32));
        print_int(1000 + (((v >> 8) & 255) as u32));
        print_int(1000 + ((v & 255) as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
