// cmac batch 4 (vector 4) — AES-256-CMAC random #0 (msg_len=1)
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/aes256.vuma"::{AesCtx, AesKey, AesBlock, aes256_init, aes_encrypt_block};
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hmac.vuma"::{HmacKey, HmacMsg, HmacOut, hmac_sha256, hmac_sha512};
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/cmac_bcrypt_kdf.vuma"::{KcCtx, aes_cmac_kdf};

transform main() -> i32 {
    let key = state_new(AesKey);
    let msg = state_new(HmacMsg);
    let out = state_new(AesBlock);
    key.data[0] = 110;
    key.data[1] = 200;
    key.data[2] = 152;
    key.data[3] = 125;
    key.data[4] = 241;
    key.data[5] = 238;
    key.data[6] = 28;
    key.data[7] = 235;
    key.data[8] = 98;
    key.data[9] = 128;
    key.data[10] = 142;
    key.data[11] = 123;
    key.data[12] = 150;
    key.data[13] = 223;
    key.data[14] = 118;
    key.data[15] = 114;
    key.data[16] = 54;
    key.data[17] = 21;
    key.data[18] = 34;
    key.data[19] = 132;
    key.data[20] = 160;
    key.data[21] = 5;
    key.data[22] = 70;
    key.data[23] = 225;
    key.data[24] = 179;
    key.data[25] = 240;
    key.data[26] = 0;
    key.data[27] = 167;
    key.data[28] = 180;
    key.data[29] = 116;
    key.data[30] = 107;
    key.data[31] = 74;
    msg.bytes[0] = 107;
    aes_cmac_kdf(key, msg, 1, out);
    let oi: u32 = 0;
    while oi < 16 {
        print_int(1000 + (out.data[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
