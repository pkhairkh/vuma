import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, bn256_bitlen, bn256_cmp, bn256_get_bit, bn256_mod_add, bn256_mod_exp, bn256_mod_inv, bn256_mod_mul, bn256_mod_sub, bn256_set_u32, bn256_copy, bn256_zero, bn256_add, bn256_rshift1, bn256_sub};
import "/home/z/my-project/workdir/vuma/womb/crypto/asym/ed25519.vuma"::{B32, ed25519_keygen};

transform main() -> i32 {
    let priv = state_new(B32);
    let pub_out = state_new(B32);
    priv.bytes[0] = 185;
    priv.bytes[1] = 69;
    priv.bytes[2] = 136;
    priv.bytes[3] = 154;
    priv.bytes[4] = 97;
    priv.bytes[5] = 137;
    priv.bytes[6] = 170;
    priv.bytes[7] = 119;
    priv.bytes[8] = 11;
    priv.bytes[9] = 177;
    priv.bytes[10] = 60;
    priv.bytes[11] = 233;
    priv.bytes[12] = 8;
    priv.bytes[13] = 74;
    priv.bytes[14] = 124;
    priv.bytes[15] = 124;
    priv.bytes[16] = 137;
    priv.bytes[17] = 90;
    priv.bytes[18] = 94;
    priv.bytes[19] = 235;
    priv.bytes[20] = 81;
    priv.bytes[21] = 91;
    priv.bytes[22] = 13;
    priv.bytes[23] = 157;
    priv.bytes[24] = 79;
    priv.bytes[25] = 233;
    priv.bytes[26] = 126;
    priv.bytes[27] = 154;
    priv.bytes[28] = 101;
    priv.bytes[29] = 255;
    priv.bytes[30] = 222;
