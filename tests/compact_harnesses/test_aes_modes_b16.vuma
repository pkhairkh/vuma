// aes_modes batch 16 (vector 16)
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/aes128.vuma"::{AesCtx, AesKey, aes128_init};
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/aes_modes.vuma"::{AesModeBuf, AesIv, aes_ecb_encrypt, aes_ecb_decrypt, aes_cbc_encrypt, aes_cbc_decrypt, aes_ctr_crypt};

transform main() -> i32 {
    let ctx = state_new(AesCtx);
    let key = state_new(AesKey);
    let iv = state_new(AesIv);
    let buf = state_new(AesModeBuf);
    let out = state_new(AesModeBuf);
    key.data[0] = 0;
    key.data[1] = 1;
    key.data[2] = 2;
    key.data[3] = 3;
    key.data[4] = 4;
    key.data[5] = 5;
    key.data[6] = 6;
    key.data[7] = 7;
    key.data[8] = 8;
    key.data[9] = 9;
    key.data[10] = 10;
    key.data[11] = 11;
    key.data[12] = 12;
    key.data[13] = 13;
    key.data[14] = 14;
    key.data[15] = 15;
    iv.bytes[0] = 0;
    iv.bytes[1] = 0;
    iv.bytes[2] = 0;
    iv.bytes[3] = 0;
    iv.bytes[4] = 0;
    iv.bytes[5] = 0;
    iv.bytes[6] = 0;
    iv.bytes[7] = 0;
    iv.bytes[8] = 0;
    iv.bytes[9] = 0;
    iv.bytes[10] = 0;
    iv.bytes[11] = 0;
    iv.bytes[12] = 0;
    iv.bytes[13] = 0;
    iv.bytes[14] = 0;
    iv.bytes[15] = 0;
    buf.bytes[0] = 0;
    buf.bytes[1] = 17;
    buf.bytes[2] = 34;
    buf.bytes[3] = 51;
    buf.bytes[4] = 68;
    buf.bytes[5] = 85;
    buf.bytes[6] = 102;
    buf.bytes[7] = 119;
    buf.bytes[8] = 136;
    buf.bytes[9] = 153;
    buf.bytes[10] = 170;
    buf.bytes[11] = 187;
    buf.bytes[12] = 204;
    buf.bytes[13] = 221;
    buf.bytes[14] = 238;
    buf.bytes[15] = 255;
    aes128_init(ctx, key);
    aes_ecb_encrypt(ctx, buf, out, 1);
    let oi: u32 = 0;
    while oi < 16 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
