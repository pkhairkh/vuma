import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, bn256_set_u32, bn256_zero};
import "/home/z/my-project/workdir/vuma/womb/crypto/asym/secp256k1.vuma"::{B32, secp256k1_point_double_bn, secp256k1_p, secp256k1_gx, secp256k1_gy, be32_to_bn256, bn256_to_be32};

transform main() -> i32 {
    let p_be = state_new(B32);
    let gx_be = state_new(B32);
    let gy_be = state_new(B32);
    secp256k1_p(p_be);
    secp256k1_gx(gx_be);
    secp256k1_gy(gy_be);
    let p_bn = state_new(Bn256Ctx);
    let gx_bn = state_new(Bn256Ctx);
    let gy_bn = state_new(Bn256Ctx);
    be32_to_bn256(p_bn, p_be);
    be32_to_bn256(gx_bn, gx_be);
    be32_to_bn256(gy_bn, gy_be);

    // Double G
    let rx = state_new(Bn256Ctx);
    let ry = state_new(Bn256Ctx);
    secp256k1_point_double_bn(rx, ry, gx_bn, gy_bn, p_bn);

    let rx_be = state_new(B32);
    let ry_be = state_new(B32);
    bn256_to_be32(rx_be, rx);
    bn256_to_be32(ry_be, ry);

    // Print
    let i: u32 = 0;
    while i < 32 { print_int(1000 + (rx_be.bytes[i] as u32)); i = i + 1; }
    print_int(999);
    i = 0;
    while i < 32 { print_int(1000 + (ry_be.bytes[i] as u32)); i = i + 1; }
    print_int(999);
    return 0;
}
