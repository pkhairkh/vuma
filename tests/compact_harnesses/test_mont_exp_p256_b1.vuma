// Test bn256_mod_exp with P-256 prime, full 256-bit exponent
// 2^(P-1) mod P = 1 (Fermat's little theorem, since P is prime)
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, bn256_mod_exp, bn256_zero};

transform main() -> i32 {
    let a = state_new(Bn256Ctx);
    let exp = state_new(Bn256Ctx);
    let m = state_new(Bn256Ctx);
    let r = state_new(Bn256Ctx);

    // m = P-256 prime
    m.limbs[0] = ((4294967295 as u64) << 32) | (4294967295 as u64);
    m.limbs[1] = 4294967295 as u64;
    m.limbs[2] = 0;
    m.limbs[3] = ((4294967295 as u64) << 32) | (1 as u64);

    // a = 2
    bn256_zero(a);
    a.limbs[0] = 2;

    // exp = P - 1 (256-bit exponent — full range test)
    // P-1 = 0xFFFFFFFF00000001000000000000000000000000FFFFFFFFFFFFFFFFFFFFFFFE
    // LE: limb[0]=0xFFFFFFFFFFFFFFFE, limb[1]=0x00000000FFFFFFFF,
    //     limb[2]=0, limb[3]=0xFFFFFFFF00000001
    exp.limbs[0] = ((4294967295 as u64) << 32) | (4294967294 as u64);  // 0xFFFFFFFFFFFFFFFE
    exp.limbs[1] = 4294967295 as u64;
    exp.limbs[2] = 0;
    exp.limbs[3] = ((4294967295 as u64) << 32) | (1 as u64);

    bn256_mod_exp(r, a, exp, m);

    // Output r as 32 bytes big-endian
    let oi: u32 = 0;
    while oi < 4 {
        let v = r.limbs[3 - oi];
        print_int(1000 + (((v >> 56) & 255) as u32));
        print_int(1000 + (((v >> 48) & 255) as u32));
        print_int(1000 + (((v >> 40) & 255) as u32));
        print_int(1000 + (((v >> 32) & 255) as u32));
        print_int(1000 + (((v >> 24) & 255) as u32));
        print_int(1000 + (((v >> 16) & 255) as u32));
        print_int(1000 + (((v >> 8) & 255) as u32));
        print_int(1000 + ((v & 255) as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
