// bignum batch 15 (vector 15) — op=add
// bn256_add 15
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, bn256_add};

transform main() -> i32 {
    let a = state_new(Bn256Ctx);
    let b = state_new(Bn256Ctx);
    let r = state_new(Bn256Ctx);

    a.limbs[0] = ((693847829 as u64) << 32) | (3274958945 as u64);
    a.limbs[1] = ((4095250239 as u64) << 32) | (2316615266 as u64);
    a.limbs[2] = ((3961824197 as u64) << 32) | (3344175247 as u64);
    a.limbs[3] = ((3944899549 as u64) << 32) | (2277851678 as u64);

    b.limbs[0] = ((2572447412 as u64) << 32) | (2456273 as u64);
    b.limbs[1] = ((2098545541 as u64) << 32) | (1392239675 as u64);
    b.limbs[2] = ((480468219 as u64) << 32) | (83651970 as u64);
    b.limbs[3] = ((1558990517 as u64) << 32) | (3990448177 as u64);

    bn256_add(r, a, b);
    let oi: u32 = 0;
    while oi < 4 {
        let v = r.limbs[3 - oi];
        print_int(1000 + (((v >> 56) & 255) as u32));
        print_int(1000 + (((v >> 48) & 255) as u32));
        print_int(1000 + (((v >> 40) & 255) as u32));
        print_int(1000 + (((v >> 32) & 255) as u32));
        print_int(1000 + (((v >> 24) & 255) as u32));
        print_int(1000 + (((v >> 16) & 255) as u32));
        print_int(1000 + (((v >> 8) & 255) as u32));
        print_int(1000 + ((v & 255) as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
