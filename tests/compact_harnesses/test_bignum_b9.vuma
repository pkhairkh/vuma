// bignum batch 9 (vector 9) — op=add
// bn256_add 9
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, bn256_add};

transform main() -> i32 {
    let a = state_new(Bn256Ctx);
    let b = state_new(Bn256Ctx);
    let r = state_new(Bn256Ctx);

    a.limbs[0] = ((3083418319 as u64) << 32) | (3763970286 as u64);
    a.limbs[1] = ((913224047 as u64) << 32) | (1351531223 as u64);
    a.limbs[2] = ((2144181937 as u64) << 32) | (2815087637 as u64);
    a.limbs[3] = ((3799685197 as u64) << 32) | (1699226064 as u64);

    b.limbs[0] = ((2761027762 as u64) << 32) | (3927951973 as u64);
    b.limbs[1] = ((613628803 as u64) << 32) | (1970753705 as u64);
    b.limbs[2] = ((599707677 as u64) << 32) | (1137651678 as u64);
    b.limbs[3] = ((3199703321 as u64) << 32) | (1059257080 as u64);

    bn256_add(r, a, b);
    let oi: u32 = 0;
    while oi < 4 {
        let v = r.limbs[3 - oi];
        print_int(1000 + (((v >> 56) & 255) as u32));
        print_int(1000 + (((v >> 48) & 255) as u32));
        print_int(1000 + (((v >> 40) & 255) as u32));
        print_int(1000 + (((v >> 32) & 255) as u32));
        print_int(1000 + (((v >> 24) & 255) as u32));
        print_int(1000 + (((v >> 16) & 255) as u32));
        print_int(1000 + (((v >> 8) & 255) as u32));
        print_int(1000 + ((v & 255) as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
