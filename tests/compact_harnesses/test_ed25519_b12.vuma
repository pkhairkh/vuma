import "/home/z/my-project/workdir/vuma/womb/crypto/asym/ed25519.vuma"::{B32, B64, B256, ed25519_sign};

transform main() -> i32 {
    let priv = state_new(B32);
    let msg = state_new(B256);
    let sig = state_new(B64);
    priv.bytes[0] = 102;
    priv.bytes[1] = 246;
    priv.bytes[2] = 202;
    priv.bytes[3] = 168;
    priv.bytes[4] = 217;
    priv.bytes[5] = 153;
    priv.bytes[6] = 205;
    priv.bytes[7] = 255;
    priv.bytes[8] = 19;
    priv.bytes[9] = 82;
    priv.bytes[10] = 169;
    priv.bytes[11] = 241;
    priv.bytes[12] = 89;
    priv.bytes[13] = 245;
    priv.bytes[14] = 139;
    priv.bytes[15] = 95;
    priv.bytes[16] = 138;
    priv.bytes[17] = 130;
    priv.bytes[18] = 1;
    priv.bytes[19] = 120;
    priv.bytes[20] = 123;
    priv.bytes[21] = 233;
    priv.bytes[22] = 246;
    priv.bytes[23] = 28;
