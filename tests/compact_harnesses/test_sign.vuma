// Test: call ecdsa_p256_sign and time it with debug markers.
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, bn256_set_u32, bn256_copy, bn256_zero, bn256_is_zero, bn256_bitlen, bn256_cmp};
import "/home/z/my-project/workdir/vuma/womb/crypto/asym/ecdsa_p256.vuma"::{B32, B256, ecdsa_p256_sign, p256_gx, p256_gy, p256_p, p256_n, be32_to_bn256, swap_endian_32, rfc6979_p256_k, p256_scalar_mul_bn, p256_sha256_hash};

transform main() -> i32 {
    let msg = state_new(B256);
    let privkey = state_new(B32);
    let r_out = state_new(B32);
    let s_out = state_new(B32);

    // msg = "ecdsa test 0" (12 bytes)
    msg.bytes[0] = 101; msg.bytes[1] = 99; msg.bytes[2] = 100; msg.bytes[3] = 115;
    msg.bytes[4] = 97; msg.bytes[5] = 32; msg.bytes[6] = 116; msg.bytes[7] = 101;
    msg.bytes[8] = 115; msg.bytes[9] = 116; msg.bytes[10] = 32; msg.bytes[11] = 48;

    // privkey (same as vector 0)
    privkey.bytes[0] = 183; privkey.bytes[1] = 230; privkey.bytes[2] = 173; privkey.bytes[3] = 5;
    privkey.bytes[4] = 228; privkey.bytes[5] = 48; privkey.bytes[6] = 2; privkey.bytes[7] = 38;
    privkey.bytes[8] = 160; privkey.bytes[9] = 131; privkey.bytes[10] = 226; privkey.bytes[11] = 118;
    privkey.bytes[12] = 6; privkey.bytes[13] = 4; privkey.bytes[14] = 38; privkey.bytes[15] = 135;
    privkey.bytes[16] = 119; privkey.bytes[17] = 221; privkey.bytes[18] = 252; privkey.bytes[19] = 235;
    privkey.bytes[20] = 43; privkey.bytes[21] = 78; privkey.bytes[22] = 85; privkey.bytes[23] = 131;
    privkey.bytes[24] = 115; privkey.bytes[25] = 134; privkey.bytes[26] = 45; privkey.bytes[27] = 38;
    privkey.bytes[28] = 208; privkey.bytes[29] = 99; privkey.bytes[30] = 233; privkey.bytes[31] = 138;

    print_int(1111);  // before sign
    ecdsa_p256_sign(msg, 12, privkey, r_out, s_out);
    print_int(2222);  // after sign

    // Print first 4 bytes of r
    print_int(1000 + (r_out.bytes[0] as u32));
    print_int(1000 + (r_out.bytes[1] as u32));
    print_int(1000 + (r_out.bytes[2] as u32));
    print_int(1000 + (r_out.bytes[3] as u32));
    print_int(999);
    return 0;
}
