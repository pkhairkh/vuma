import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/des_rc4_aria_camellia.vuma"::{DesWord, tdes_ede3_encrypt_block};

transform main() -> i32 {
    let buf = state_new(DesWord);
    let out = state_new(DesWord);
    let k1 = state_new(DesWord);
    let k2 = state_new(DesWord);
    let k3 = state_new(DesWord);
    buf.bytes[0] = 224;
    buf.bytes[1] = 189;
    buf.bytes[2] = 231;
    buf.bytes[3] = 74;
    buf.bytes[4] = 233;
    buf.bytes[5] = 242;
    buf.bytes[6] = 193;
    buf.bytes[7] = 217;
    k1.bytes[0] = 41;
    k1.bytes[1] = 228;
    k1.bytes[2] = 144;
    k1.bytes[3] = 9;
    k1.bytes[4] = 157;
    k1.bytes[5] = 3;
    k1.bytes[6] = 193;
    k1.bytes[7] = 170;
    k2.bytes[0] = 108;
    k2.bytes[1] = 137;
    k2.bytes[2] = 103;
    k2.bytes[3] = 162;
    k2.bytes[4] = 237;
    k2.bytes[5] = 6;
    k2.bytes[6] = 170;
    k2.bytes[7] = 145;
    k3.bytes[0] = 51;
    k3.bytes[1] = 48;
