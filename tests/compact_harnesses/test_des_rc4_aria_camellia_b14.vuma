// des_rc4_aria_camellia batch 14 (vector 14)
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/des_rc4_aria_camellia.vuma"::{DesWord, tdes_ede3_encrypt_block};

transform main() -> i32 {
    let buf = state_new(DesWord);
    let out = state_new(DesWord);
    let k1 = state_new(DesWord);
    let k2 = state_new(DesWord);
    let k3 = state_new(DesWord);
    k1.bytes[0] = 124;
    k1.bytes[1] = 185;
    k1.bytes[2] = 246;
    k1.bytes[3] = 51;
    k1.bytes[4] = 112;
    k1.bytes[5] = 173;
    k1.bytes[6] = 234;
    k1.bytes[7] = 39;
    k2.bytes[0] = 100;
    k2.bytes[1] = 161;
    k2.bytes[2] = 222;
    k2.bytes[3] = 27;
    k2.bytes[4] = 88;
    k2.bytes[5] = 149;
    k2.bytes[6] = 210;
    k2.bytes[7] = 15;
    k3.bytes[0] = 76;
    k3.bytes[1] = 137;
    k3.bytes[2] = 198;
    k3.bytes[3] = 3;
    k3.bytes[4] = 64;
    k3.bytes[5] = 125;
    k3.bytes[6] = 186;
    k3.bytes[7] = 247;
    buf.bytes[0] = 188;
    buf.bytes[1] = 15;
    buf.bytes[2] = 98;
    buf.bytes[3] = 181;
    buf.bytes[4] = 8;
    buf.bytes[5] = 91;
    buf.bytes[6] = 174;
    buf.bytes[7] = 1;
    tdes_ede3_encrypt_block(buf, k1, k2, k3, out);
    let oi: u32 = 0;
    while oi < 8 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
