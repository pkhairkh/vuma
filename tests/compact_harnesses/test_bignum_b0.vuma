// bignum batch 0 (vector 0)
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, bn256_add};

transform main() -> i32 {
    let a = state_new(Bn256Ctx);
    let b = state_new(Bn256Ctx);
    let r = state_new(Bn256Ctx);
    a.limbs[0] = ((478163327 as u64) << 32) | (2746317213 as u64);
    a.limbs[1] = ((3184935163 as u64) << 32) | (107420369 as u64);
    a.limbs[2] = ((1051802512 as u64) << 32) | (1181241943 as u64);
    a.limbs[3] = ((599310825 as u64) << 32) | (958682846 as u64);
    b.limbs[0] = ((440213415 as u64) << 32) | (3163119785 as u64);
    b.limbs[1] = ((3181143731 as u64) << 32) | (2906402157 as u64);
    b.limbs[2] = ((2342331444 as u64) << 32) | (3831882064 as u64);
    b.limbs[3] = ((2536146025 as u64) << 32) | (373399426 as u64);
    bn256_add(r, a, b);
    let oi: u32 = 0;
    while oi < 4 {
        let v = r.limbs[oi];
        print_int(1000 + ((v & 255) as u32));
        print_int(1000 + (((v >> 8) & 255) as u32));
        print_int(1000 + (((v >> 16) & 255) as u32));
        print_int(1000 + (((v >> 24) & 255) as u32));
        print_int(1000 + (((v >> 32) & 255) as u32));
        print_int(1000 + (((v >> 40) & 255) as u32));
        print_int(1000 + (((v >> 48) & 255) as u32));
        print_int(1000 + (((v >> 56) & 255) as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
