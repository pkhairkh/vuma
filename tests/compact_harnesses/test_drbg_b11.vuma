// drbg batch 11 (vector 11)
// DRBG: 16-byte entropy, no nonce, 32 bytes (v2)
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hmac.vuma"::{HmacKey, HmacMsg, HmacOut, hmac_sha256};
import "/home/z/my-project/workdir/vuma/womb/crypto/drbg/drbg.vuma"::{DrbgCtx, DrbgData, DrbgOut, drbg_init, drbg_generate};

transform main() -> i32 {
    let drbg = state_new(DrbgCtx);
    let entropy = state_new(DrbgData);
    let nonce = state_new(DrbgData);
    let out = state_new(DrbgOut);
    entropy.bytes[0] = 255;
    entropy.bytes[1] = 238;
    entropy.bytes[2] = 221;
    entropy.bytes[3] = 204;
    entropy.bytes[4] = 187;
    entropy.bytes[5] = 170;
    entropy.bytes[6] = 153;
    entropy.bytes[7] = 136;
    entropy.bytes[8] = 119;
    entropy.bytes[9] = 102;
    entropy.bytes[10] = 85;
    entropy.bytes[11] = 68;
    entropy.bytes[12] = 51;
    entropy.bytes[13] = 34;
    entropy.bytes[14] = 17;
    entropy.bytes[15] = 0;
    drbg_init(drbg, entropy, 16, nonce, 0);
    drbg_generate(drbg, out, 32);
    let oi: u32 = 0;
    while oi < 32 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
