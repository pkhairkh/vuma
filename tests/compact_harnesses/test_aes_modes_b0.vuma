    buf.bytes[10] = 126;
    buf.bytes[11] = 17;
    buf.bytes[12] = 115;
    buf.bytes[13] = 147;
    buf.bytes[14] = 23;
    buf.bytes[15] = 42;
    aes128_init(ctx, key);
    aes_ecb_encrypt(ctx, buf, out, 1);
