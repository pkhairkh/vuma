import "/home/z/my-project/workdir/vuma/womb/crypto/asym/ed25519.vuma"::{B32, B64, B256, ed25519_sign};

transform main() -> i32 {
    let priv = state_new(B32);
    let msg = state_new(B256);
    let sig = state_new(B64);
    priv.bytes[0] = 178;
    priv.bytes[1] = 108;
    priv.bytes[2] = 235;
    priv.bytes[3] = 23;
    priv.bytes[4] = 240;
    priv.bytes[5] = 226;
    priv.bytes[6] = 238;
    priv.bytes[7] = 147;
    priv.bytes[8] = 21;
    priv.bytes[9] = 67;
    priv.bytes[10] = 157;
    priv.bytes[11] = 73;
    priv.bytes[12] = 28;
    priv.bytes[13] = 230;
    priv.bytes[14] = 150;
    priv.bytes[15] = 75;
    priv.bytes[16] = 146;
    priv.bytes[17] = 100;
    priv.bytes[18] = 252;
    priv.bytes[19] = 248;
    priv.bytes[20] = 253;
    priv.bytes[21] = 22;
    priv.bytes[22] = 25;
    priv.bytes[23] = 194;
    priv.bytes[24] = 126;
    priv.bytes[25] = 228;
    priv.bytes[26] = 224;
    priv.bytes[27] = 121;
