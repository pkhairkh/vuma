    msg.bytes[4] = 38;
    msg.bytes[5] = 239;
    msg.bytes[6] = 117;
    msg.bytes[7] = 38;
    msg.bytes[8] = 80;
    msg.bytes[9] = 61;
    msg.bytes[10] = 60;
    msg.bytes[11] = 101;
    msg.bytes[12] = 146;
    msg.bytes[13] = 170;
    msg.bytes[14] = 150;
    msg.bytes[15] = 88;
    ed25519_sign(priv, msg, 16, sig);
    let oi: u32 = 0;
    while oi < 64 {
        print_int(1000 + (sig.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
