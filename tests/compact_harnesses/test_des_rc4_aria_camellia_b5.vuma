// des_rc4_aria_camellia batch 5 (vector 5)
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/des_rc4_aria_camellia.vuma"::{Rc4Buf, Rc4Sbox, rc4_crypt};

transform main() -> i32 {
    let buf = state_new(Rc4Buf);
    let out = state_new(Rc4Buf);
    let key = state_new(Rc4Buf);
    key.bytes[0] = 0;
    key.bytes[1] = 67;
    key.bytes[2] = 134;
    key.bytes[3] = 201;
    key.bytes[4] = 12;
    buf.bytes[0] = 0;
    buf.bytes[1] = 89;
    buf.bytes[2] = 178;
    buf.bytes[3] = 11;
    buf.bytes[4] = 100;
    buf.bytes[5] = 189;
    buf.bytes[6] = 22;
    buf.bytes[7] = 111;
    rc4_crypt(key, 5, buf, 8, out);
    let oi: u32 = 0;
    while oi < 8 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
