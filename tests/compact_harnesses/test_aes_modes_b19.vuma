// aes_modes batch 19 (vector 19)
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/aes128.vuma"::{AesCtx, AesKey, aes128_init};
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/aes_modes.vuma"::{AesModeBuf, AesIv, aes_ecb_encrypt, aes_ecb_decrypt, aes_cbc_encrypt, aes_cbc_decrypt, aes_ctr_crypt};

transform main() -> i32 {
    let ctx = state_new(AesCtx);
    let key = state_new(AesKey);
    let iv = state_new(AesIv);
    let buf = state_new(AesModeBuf);
    let out = state_new(AesModeBuf);
    key.data[0] = 43;
    key.data[1] = 126;
    key.data[2] = 21;
    key.data[3] = 22;
    key.data[4] = 40;
    key.data[5] = 174;
    key.data[6] = 210;
    key.data[7] = 166;
    key.data[8] = 171;
    key.data[9] = 247;
    key.data[10] = 21;
    key.data[11] = 136;
    key.data[12] = 9;
    key.data[13] = 207;
    key.data[14] = 79;
    key.data[15] = 60;
    iv.bytes[0] = 80;
    iv.bytes[1] = 134;
    iv.bytes[2] = 203;
    iv.bytes[3] = 155;
    iv.bytes[4] = 80;
    iv.bytes[5] = 114;
    iv.bytes[6] = 25;
    iv.bytes[7] = 238;
    iv.bytes[8] = 149;
    iv.bytes[9] = 219;
    iv.bytes[10] = 17;
    iv.bytes[11] = 58;
    iv.bytes[12] = 145;
    iv.bytes[13] = 118;
    iv.bytes[14] = 120;
    iv.bytes[15] = 178;
    buf.bytes[0] = 115;
    buf.bytes[1] = 190;
    buf.bytes[2] = 214;
    buf.bytes[3] = 184;
    buf.bytes[4] = 227;
    buf.bytes[5] = 193;
    buf.bytes[6] = 116;
    buf.bytes[7] = 59;
    buf.bytes[8] = 113;
    buf.bytes[9] = 22;
    buf.bytes[10] = 230;
    buf.bytes[11] = 158;
    buf.bytes[12] = 34;
    buf.bytes[13] = 34;
    buf.bytes[14] = 149;
    buf.bytes[15] = 22;
    aes128_init(ctx, key);
    aes_cbc_decrypt(ctx, iv, buf, out, 1);
    let oi: u32 = 0;
    while oi < 16 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
