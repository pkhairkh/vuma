// drbg batch 6 (vector 6)
import "/home/z/my-project/workdir/vuma/womb/crypto/drbg/drbg.vuma"::{DrbgCtx, DrbgData, DrbgOut, drbg_init, drbg_generate};

transform main() -> i32 {
    let drbg = state_new(DrbgCtx);
    let entropy = state_new(DrbgData);
    let out = state_new(DrbgOut);
    entropy.bytes[0] = 102;
    entropy.bytes[1] = 133;
    entropy.bytes[2] = 164;
    entropy.bytes[3] = 195;
    entropy.bytes[4] = 226;
    entropy.bytes[5] = 1;
    entropy.bytes[6] = 32;
    entropy.bytes[7] = 63;
    entropy.bytes[8] = 94;
    entropy.bytes[9] = 125;
    entropy.bytes[10] = 156;
    entropy.bytes[11] = 187;
    entropy.bytes[12] = 218;
    entropy.bytes[13] = 249;
    entropy.bytes[14] = 24;
    entropy.bytes[15] = 55;
    entropy.bytes[16] = 86;
    entropy.bytes[17] = 117;
    entropy.bytes[18] = 148;
    entropy.bytes[19] = 179;
    entropy.bytes[20] = 210;
    entropy.bytes[21] = 241;
    entropy.bytes[22] = 16;
    entropy.bytes[23] = 47;
    entropy.bytes[24] = 78;
    entropy.bytes[25] = 109;
    entropy.bytes[26] = 140;
    entropy.bytes[27] = 171;
    entropy.bytes[28] = 202;
    entropy.bytes[29] = 233;
    entropy.bytes[30] = 8;
    entropy.bytes[31] = 39;
    drbg_init(drbg, entropy, 32, entropy, 0);
    drbg_generate(drbg, out, 32);
    let oi: u32 = 0;
    while oi < 32 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
