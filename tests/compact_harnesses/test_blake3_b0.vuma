// blake3 batch 0 (vectors 0-2)
import "/home/z/my-project/workdir/vuma/womb/crypto/hash/blake3.vuma"::{Blake3Data, Blake3Digest, blake3_oneshot};

transform main() -> i32 {
    let data = state_new(Blake3Data);
    let out = state_new(Blake3Digest);
    let oi: u32 = 0;
    // V0: blake3(empty)
    blake3_oneshot(data, 0, out);
    oi = 0;
    while oi < 32 {
        print_int(1000 + (out.data[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    // V1: blake3(NIST abc)
    data.data[0] = 97;
    data.data[1] = 98;
    data.data[2] = 99;
    blake3_oneshot(data, 3, out);
    oi = 0;
    while oi < 32 {
        print_int(1000 + (out.data[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    // V2: blake3(single byte)
    data.data[0] = 97;
    blake3_oneshot(data, 1, out);
    oi = 0;
    while oi < 32 {
        print_int(1000 + (out.data[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}