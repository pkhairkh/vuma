// cmac batch 1 (vector 1) — NIST SP 800-38B AES-256-CMAC 16-byte msg
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/aes256.vuma"::{AesCtx, AesKey, AesBlock, aes256_init, aes_encrypt_block};
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hmac.vuma"::{HmacKey, HmacMsg, HmacOut, hmac_sha256, hmac_sha512};
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/cmac_bcrypt_kdf.vuma"::{KcCtx, aes_cmac_kdf};

transform main() -> i32 {
    let key = state_new(AesKey);
    let msg = state_new(HmacMsg);
    let out = state_new(AesBlock);
    key.data[0] = 96;
    key.data[1] = 61;
    key.data[2] = 235;
    key.data[3] = 16;
    key.data[4] = 21;
    key.data[5] = 202;
    key.data[6] = 113;
    key.data[7] = 190;
    key.data[8] = 43;
    key.data[9] = 115;
    key.data[10] = 174;
    key.data[11] = 240;
    key.data[12] = 133;
    key.data[13] = 125;
    key.data[14] = 119;
    key.data[15] = 129;
    key.data[16] = 31;
    key.data[17] = 53;
    key.data[18] = 44;
    key.data[19] = 7;
    key.data[20] = 59;
    key.data[21] = 97;
    key.data[22] = 8;
    key.data[23] = 215;
    key.data[24] = 45;
    key.data[25] = 152;
    key.data[26] = 16;
    key.data[27] = 163;
    key.data[28] = 9;
    key.data[29] = 20;
    key.data[30] = 223;
    key.data[31] = 244;
    msg.bytes[0] = 107;
    msg.bytes[1] = 193;
    msg.bytes[2] = 190;
    msg.bytes[3] = 226;
    msg.bytes[4] = 46;
    msg.bytes[5] = 64;
    msg.bytes[6] = 159;
    msg.bytes[7] = 150;
    msg.bytes[8] = 233;
    msg.bytes[9] = 61;
    msg.bytes[10] = 126;
    msg.bytes[11] = 17;
    msg.bytes[12] = 115;
    msg.bytes[13] = 147;
    msg.bytes[14] = 23;
    msg.bytes[15] = 42;
    aes_cmac_kdf(key, msg, 16, out);
    let oi: u32 = 0;
    while oi < 16 {
        print_int(1000 + (out.data[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
