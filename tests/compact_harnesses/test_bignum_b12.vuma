// bignum batch 12 (vector 12)
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, bn256_add};

transform main() -> i32 {
    let a = state_new(Bn256Ctx);
    let b = state_new(Bn256Ctx);
    let r = state_new(Bn256Ctx);
    a.limbs[0] = ((2010258946 as u64) << 32) | (4278308761 as u64);
    a.limbs[1] = ((1079815404 as u64) << 32) | (2272528809 as u64);
    a.limbs[2] = ((2376087131 as u64) << 32) | (4170749881 as u64);
    a.limbs[3] = ((4047709743 as u64) << 32) | (3697020653 as u64);
    b.limbs[0] = ((2921794983 as u64) << 32) | (49310608 as u64);
    b.limbs[1] = ((491995979 as u64) << 32) | (3095476665 as u64);
    b.limbs[2] = ((3800137469 as u64) << 32) | (2927923735 as u64);
    b.limbs[3] = ((3224995600 as u64) << 32) | (2306270004 as u64);
    bn256_add(r, a, b);
    let oi: u32 = 0;
    while oi < 4 {
        let v = r.limbs[oi];
        print_int(1000 + ((v & 255) as u32));
        print_int(1000 + (((v >> 8) & 255) as u32));
        print_int(1000 + (((v >> 16) & 255) as u32));
        print_int(1000 + (((v >> 24) & 255) as u32));
        print_int(1000 + (((v >> 32) & 255) as u32));
        print_int(1000 + (((v >> 40) & 255) as u32));
        print_int(1000 + (((v >> 48) & 255) as u32));
        print_int(1000 + (((v >> 56) & 255) as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
