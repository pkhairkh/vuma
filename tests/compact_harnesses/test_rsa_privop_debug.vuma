    d.bytes[112] = 45;  d.bytes[113] = 136; d.bytes[114] = 116; d.bytes[115] = 111;
    d.bytes[116] = 216; d.bytes[117] = 253; d.bytes[118] = 154; d.bytes[119] = 93;
    d.bytes[120] = 106; d.bytes[121] = 141; d.bytes[122] = 225; d.bytes[123] = 112;
    d.bytes[124] = 134; d.bytes[125] = 150; d.bytes[126] = 253; d.bytes[127] = 34;

    // n_hex = af08640f6698ce6d8dabf65b201af60a7d4f4abf34fd0f3d86...
    n.bytes[ 0] = 175; n.bytes[ 1] = 8;   n.bytes[ 2] = 100; n.bytes[ 3] = 15;
    n.bytes[ 4] = 102; n.bytes[ 5] = 152; n.bytes[ 6] = 206; n.bytes[ 7] = 109;
