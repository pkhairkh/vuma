transform main() -> i32 {
    let padded = state_new(Rsa256);
    let d = state_new(Rsa256);
    let n = state_new(Rsa256);
    let sig = state_new(Rsa256);

    // Padded message: 0001 FF...FF 00 3031300d... 1f6b17ab...
    // (precomputed: 128 bytes for 1024-bit key)
    padded.bytes[ 0] = 0; padded.bytes[ 1] = 1;
    let i: u32 = 2;
    while i < 98 { padded.bytes[i] = 255; i = i + 1; }
    padded.bytes[98] = 0;
    // DigestInfo prefix (19 bytes)
    padded.bytes[ 99] = 48; padded.bytes[100] = 49; padded.bytes[101] = 48; padded.bytes[102] = 13;
    padded.bytes[103] = 6;  padded.bytes[104] = 9;  padded.bytes[105] = 96; padded.bytes[106] = 134;
    padded.bytes[107] = 72; padded.bytes[108] = 1;  padded.bytes[109] = 101; padded.bytes[110] = 3;
    padded.bytes[111] = 4;  padded.bytes[112] = 2;  padded.bytes[113] = 1;  padded.bytes[114] = 5;
    padded.bytes[115] = 0;  padded.bytes[116] = 4;  padded.bytes[117] = 32;
    // SHA-256 hash of "rsa test message 0" = 1f6b17ab9ef2848c91ad2a5199525ee7aeac05f593dd548ad588f7dde3d196b9
    padded.bytes[118] = 31;  padded.bytes[119] = 107; padded.bytes[120] = 23;  padded.bytes[121] = 171;
    padded.bytes[122] = 158; padded.bytes[123] = 242; padded.bytes[124] = 132; padded.bytes[125] = 140;
    padded.bytes[126] = 145; padded.bytes[127] = 173;

    // d_hex = 2afdb39df8c43587c11168bc2f219027396a1d60e381f899532363e55b4bc886...
    d.bytes[ 0] = 42;  d.bytes[ 1] = 253; d.bytes[ 2] = 179; d.bytes[ 3] = 157;
    d.bytes[ 4] = 248; d.bytes[ 5] = 196; d.bytes[ 6] = 53;  d.bytes[ 7] = 135;
    d.bytes[ 8] = 193; d.bytes[ 9] = 17;  d.bytes[10] = 104; d.bytes[11] = 188;
    d.bytes[12] = 47;  d.bytes[13] = 33;  d.bytes[14] = 144; d.bytes[15] = 39;
    d.bytes[16] = 57;  d.bytes[17] = 106; d.bytes[18] = 29;  d.bytes[19] = 96;
