    n.bytes[60] = 134; n.bytes[61] = 174; n.bytes[62] = 186; n.bytes[63] = 241;
    n.bytes[64] = 175; n.bytes[65] = 167; n.bytes[66] = 114; n.bytes[67] = 245;
    n.bytes[68] = 179; n.bytes[69] = 4;   n.bytes[70] = 174; n.bytes[71] = 106;
    n.bytes[72] = 168; n.bytes[73] = 16;  n.bytes[74] = 169; n.bytes[75] = 236;
    n.bytes[76] = 202; n.bytes[77] = 85;  n.bytes[78] = 205; n.bytes[79] = 237;
    n.bytes[80] = 194; n.bytes[81] = 124; n.bytes[82] = 52;  n.bytes[83] = 237;
    n.bytes[84] = 193; n.bytes[85] = 61;  n.bytes[86] = 152; n.bytes[87] = 177;
    n.bytes[88] = 214; n.bytes[89] = 64;  n.bytes[90] = 77;  n.bytes[91] = 148;
    n.bytes[92] = 31;  n.bytes[93] = 26;  n.bytes[94] = 129; n.bytes[95] = 101;
    n.bytes[96] = 208; n.bytes[97] = 229; n.bytes[98] = 1;   n.bytes[99] = 160;
    n.bytes[100] = 155; n.bytes[101] = 93; n.bytes[102] = 177; n.bytes[103] = 163;
    n.bytes[104] = 122; n.bytes[105] = 105; n.bytes[106] = 127; n.bytes[107] = 22;
    n.bytes[108] = 50;  n.bytes[109] = 39; n.bytes[110] = 92;  n.bytes[111] = 6;
    n.bytes[112] = 5;   n.bytes[113] = 194; n.bytes[114] = 49; n.bytes[115] = 161;
    n.bytes[116] = 93;  n.bytes[117] = 49; n.bytes[118] = 8;   n.bytes[119] = 202;
    n.bytes[120] = 5;   n.bytes[121] = 175; n.bytes[122] = 205; n.bytes[123] = 147;
    n.bytes[124] = 63;  n.bytes[125] = 44; n.bytes[126] = 49; n.bytes[127] = 145;

    // sig = padded^d mod n (key_bytes = 128 for 1024-bit key)
    rsa_private_op(sig, padded, d, n, 128);

    // Output first 16 bytes of signature
    let oi: u32 = 0;
    while oi < 16 {
        print_int(1000 + (sig.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
