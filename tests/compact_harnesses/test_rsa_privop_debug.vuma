    n.bytes[20] = 52;  n.bytes[21] = 253; n.bytes[22] = 15;  n.bytes[23] = 61;
    n.bytes[24] = 134; n.bytes[25] = 161; n.bytes[26] = 120; n.bytes[27] = 2;
    n.bytes[28] = 153; n.bytes[29] = 75;  n.bytes[30] = 198; n.bytes[31] = 98;
