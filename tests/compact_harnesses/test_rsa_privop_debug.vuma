    d.bytes[24] = 83;  d.bytes[25] = 35;  d.bytes[26] = 99;  d.bytes[27] = 229;
    d.bytes[28] = 91;  d.bytes[29] = 75;  d.bytes[30] = 200; d.bytes[31] = 134;
    d.bytes[32] = 0;   d.bytes[33] = 91;  d.bytes[34] = 5;   d.bytes[35] = 69;
    d.bytes[36] = 164; d.bytes[37] = 248; d.bytes[38] = 205; d.bytes[39] = 220;
    d.bytes[40] = 250; d.bytes[41] = 163; d.bytes[42] = 168; d.bytes[43] = 234;
    d.bytes[44] = 83;  d.bytes[45] = 83;  d.bytes[46] = 88;  d.bytes[47] = 197;
    d.bytes[48] = 196; d.bytes[49] = 247; d.bytes[50] = 206; d.bytes[51] = 81;
    d.bytes[52] = 161; d.bytes[53] = 3;   d.bytes[54] = 129; d.bytes[55] = 2;
    d.bytes[56] = 72;  d.bytes[57] = 71;  d.bytes[58] = 41;  d.bytes[59] = 146;
    d.bytes[60] = 74;  d.bytes[61] = 68;  d.bytes[62] = 194; d.bytes[63] = 210;
    d.bytes[64] = 152; d.bytes[65] = 48;  d.bytes[66] = 6;   d.bytes[67] = 29;
    d.bytes[68] = 214; d.bytes[69] = 155; d.bytes[70] = 237; d.bytes[71] = 152;
    d.bytes[72] = 176; d.bytes[73] = 125; d.bytes[74] = 57;  d.bytes[75] = 185;
    d.bytes[76] = 234; d.bytes[77] = 153; d.bytes[78] = 175; d.bytes[79] = 221;
    d.bytes[80] = 120; d.bytes[81] = 110; d.bytes[82] = 246; d.bytes[83] = 233;
    d.bytes[84] = 170; d.bytes[85] = 98;  d.bytes[86] = 101; d.bytes[87] = 99;
    d.bytes[88] = 32;  d.bytes[89] = 63;  d.bytes[90] = 164; d.bytes[91] = 81;
    d.bytes[92] = 94;  d.bytes[93] = 71;  d.bytes[94] = 16;  d.bytes[95] = 178;
    d.bytes[96] = 25;  d.bytes[97] = 57;  d.bytes[98] = 158; d.bytes[99] = 94;
    d.bytes[100] = 127; d.bytes[101] = 135; d.bytes[102] = 21;  d.bytes[103] = 116;
