// scrypt batch 14 (vector 14)
// scrypt(pw=b'P@ssw0rd!', salt=b'$4lty$4lt', N=16, r=1, p=1, dklen=64)
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hmac.vuma"::{HmacKey, HmacMsg};
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/pbkdf2.vuma"::{pbkdf2_hmac_sha256};
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/scrypt.vuma"::{scrypt};

transform main() -> i32 {
    let pass = state_new(HmacKey);
    let salt = state_new(HmacMsg);
    let out = state_new(HmacMsg);
    pass.bytes[0] = 80;
    pass.bytes[1] = 64;
    pass.bytes[2] = 115;
    pass.bytes[3] = 115;
    pass.bytes[4] = 119;
    pass.bytes[5] = 48;
    pass.bytes[6] = 114;
    pass.bytes[7] = 100;
    pass.bytes[8] = 33;
    salt.bytes[0] = 36;
    salt.bytes[1] = 52;
    salt.bytes[2] = 108;
    salt.bytes[3] = 116;
    salt.bytes[4] = 121;
    salt.bytes[5] = 36;
    salt.bytes[6] = 52;
    salt.bytes[7] = 108;
    salt.bytes[8] = 116;
    scrypt(pass, 9, salt, 9, 16, 1, 1, out, 64);
    let oi: u32 = 0;
    while oi < 64 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
