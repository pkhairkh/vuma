// aes_extra_modes batch 4 (vector 4)
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/aes128.vuma"::{AesCtx, AesKey, aes128_init};
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/aes_extra_modes.vuma"::{AesXBuf, AesXBlock, aes_cmac};

transform main() -> i32 {
    let key = state_new(AesKey);
    let msg = state_new(AesXBuf);
    let out = state_new(AesXBuf);
    key.data[0] = 0;
    key.data[1] = 31;
    key.data[2] = 62;
    key.data[3] = 93;
    key.data[4] = 124;
    key.data[5] = 155;
    key.data[6] = 186;
    key.data[7] = 217;
    key.data[8] = 248;
    key.data[9] = 23;
    key.data[10] = 54;
    key.data[11] = 85;
    key.data[12] = 116;
    key.data[13] = 147;
    key.data[14] = 178;
    key.data[15] = 209;
    msg.bytes[0] = 0;
    aes_cmac(key, msg, 1, out);
    let oi: u32 = 0;
    while oi < 16 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
