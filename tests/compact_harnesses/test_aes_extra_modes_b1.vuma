// aes_extra_modes batch 1 (vector 1)
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/aes128.vuma"::{AesCtx, AesKey, aes128_init};
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/aes_extra_modes.vuma"::{AesXBuf, AesXBlock, aes_cmac};

transform main() -> i32 {
    let key = state_new(AesKey);
    let msg = state_new(AesXBuf);
    let out = state_new(AesXBuf);
    key.data[0] = 43;
    key.data[1] = 126;
    key.data[2] = 21;
    key.data[3] = 22;
    key.data[4] = 40;
    key.data[5] = 174;
    key.data[6] = 210;
    key.data[7] = 166;
    key.data[8] = 171;
    key.data[9] = 247;
    key.data[10] = 21;
    key.data[11] = 136;
    key.data[12] = 9;
    key.data[13] = 207;
    key.data[14] = 79;
    key.data[15] = 60;
    msg.bytes[0] = 107;
    msg.bytes[1] = 193;
    msg.bytes[2] = 190;
    msg.bytes[3] = 226;
    msg.bytes[4] = 46;
    msg.bytes[5] = 64;
    msg.bytes[6] = 159;
    msg.bytes[7] = 150;
    msg.bytes[8] = 233;
    msg.bytes[9] = 61;
    msg.bytes[10] = 126;
    msg.bytes[11] = 17;
    msg.bytes[12] = 115;
    msg.bytes[13] = 147;
    msg.bytes[14] = 23;
    msg.bytes[15] = 42;
    aes_cmac(key, msg, 16, out);
    let oi: u32 = 0;
    while oi < 16 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
