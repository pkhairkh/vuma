    msg.bytes[9] = 116;
    msg.bytes[10] = 32;
    msg.bytes[11] = 57;
    privkey.bytes[0] = 62;
    privkey.bytes[1] = 103;
    privkey.bytes[2] = 201;
    privkey.bytes[3] = 228;
    privkey.bytes[4] = 221;
    privkey.bytes[5] = 11;
    privkey.bytes[6] = 252;
    privkey.bytes[7] = 8;
    privkey.bytes[8] = 46;
    privkey.bytes[9] = 237;
    privkey.bytes[10] = 171;
