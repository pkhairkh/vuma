    msg.bytes[11] = 49;
    msg.bytes[12] = 49;
    privkey.bytes[0] = 1;
    privkey.bytes[1] = 223;
    privkey.bytes[2] = 19;
    privkey.bytes[3] = 157;
    privkey.bytes[4] = 72;
    privkey.bytes[5] = 29;
    privkey.bytes[6] = 136;
    privkey.bytes[7] = 18;
    privkey.bytes[8] = 237;
    privkey.bytes[9] = 0;
