// Debug: trace Newton iteration for mont_mu directly in the harness
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx};

transform main() -> i32 {
    // m0 = 0xFFFF...FF (P-256 low limb)
    let m0: u64 = 18446744073709551615;

    let y: u64 = 1;
    let zero_u64: u64 = 0;
    let two_u64: u64 = 2;

    // Output m0 first
    print_int(5000 + ((m0 >> 32) as u32));  // high 32 bits
    print_int(5000 + ((m0 & 4294967295) as u32));  // low 32 bits
    print_int(4999);  // delimiter

    let i = 0;
    while i < 6 {
        let my: u64 = m0 * y;
        let neg_my: u64 = zero_u64 - my;
        let t: u64 = neg_my + two_u64;
        y = y * t;

        // Output y after each iteration (high 32, low 32)
        print_int(6000 + ((y >> 32) as u32));
        print_int(6000 + ((y & 4294967295) as u32));
        // Also output my and t for debugging
        print_int(7000 + ((my >> 32) as u32));
        print_int(7000 + ((my & 4294967295) as u32));
        print_int(8000 + ((t >> 32) as u32));
        print_int(8000 + ((t & 4294967295) as u32));
        print_int(5999);  // iteration delimiter

        i = i + 1;
    }

    // Output final mprime = 0 - y
    let mprime: u64 = zero_u64 - y;
    print_int(9000 + ((mprime >> 32) as u32));
    print_int(9000 + ((mprime & 4294967295) as u32));
    print_int(999);
    return 0;
}
