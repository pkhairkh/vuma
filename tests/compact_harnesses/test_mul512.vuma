// Test: bn256_mul_512 with known values.
// 4000000000 * 4000000000 = 16000000000000000000
// = 0xDE0B6B3A763FFFF * 10 + ... let me compute:
// 4000000000 = 0xEE6B2800
// 0xEE6B2800 * 0xEE6B2800 = ?
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, Bn512Ctx, Bn64Ctx, bn256_set_u32, bn256_zero, bn256_mul_512, bn_mul_u64};

transform main() -> i32 {
    let a = state_new(Bn256Ctx);
    let b = state_new(Bn256Ctx);
    let r = state_new(Bn512Ctx);
    bn256_set_u32(a, 4000000000);
    bn256_set_u32(b, 4000000000);
    bn256_mul_512(r, a, b);
    // Expected: 4000000000 * 4000000000 = 16000000000000000000
    // = 0xDE0B6B3A763FFFF * 16 = no, let me compute properly
    // 4*10^9 * 4*10^9 = 16*10^18 = 0xDE0B6B3A7640000 * 16 = 0xDE0B6B3A76400000
    // Wait: 16 * 10^18 = 16000000000000000000
    // = 0xDE0B6B3A7640000 * 10 = no
    // 2^64 = 18446744073709551616
    // 16*10^18 = 16000000000000000000 < 2^64
    // 16000000000000000000 in hex:
    //   = 0xDE0B6B3A763FFFF * 16 + ... let me just compute
    // Actually: 4000000000 = 4 * 10^9. (4*10^9)^2 = 16*10^18.
    // 16*10^18 = 16,000,000,000,000,000,000
    // limbs[0] = low 64 bits, limbs[1] = next 64 bits
    // Print all 8 limbs
    let i: u32 = 0;
    while i < 8 {
        print_int(1000 + (r.limbs[i] as u32));
        i = i + 1;
    }
    print_int(999);
    return 0;
}
