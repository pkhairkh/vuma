// bignum batch 11 (vector 11)
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, bn256_add};

transform main() -> i32 {
    let a = state_new(Bn256Ctx);
    let b = state_new(Bn256Ctx);
    let r = state_new(Bn256Ctx);
    a.limbs[0] = ((3246059658 as u64) << 32) | (390452952 as u64);
    a.limbs[1] = ((3698408854 as u64) << 32) | (202363285 as u64);
    a.limbs[2] = ((656448479 as u64) << 32) | (470939445 as u64);
    a.limbs[3] = ((687117441 as u64) << 32) | (2694860228 as u64);
    b.limbs[0] = ((2922644564 as u64) << 32) | (3401954956 as u64);
    b.limbs[1] = ((2561557300 as u64) << 32) | (1813163240 as u64);
    b.limbs[2] = ((1652563013 as u64) << 32) | (272849424 as u64);
    b.limbs[3] = ((2559321289 as u64) << 32) | (1639042338 as u64);
    bn256_add(r, a, b);
    let oi: u32 = 0;
    while oi < 4 {
        let v = r.limbs[oi];
        print_int(1000 + ((v & 255) as u32));
        print_int(1000 + (((v >> 8) & 255) as u32));
        print_int(1000 + (((v >> 16) & 255) as u32));
        print_int(1000 + (((v >> 24) & 255) as u32));
        print_int(1000 + (((v >> 32) & 255) as u32));
        print_int(1000 + (((v >> 40) & 255) as u32));
        print_int(1000 + (((v >> 48) & 255) as u32));
        print_int(1000 + (((v >> 56) & 255) as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
