// aes_extra_modes batch 8 (vector 8)
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/aes128.vuma"::{AesCtx, AesKey, aes128_init};
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/aes_extra_modes.vuma"::{AesXBuf, AesXBlock, aes_cmac};

transform main() -> i32 {
    let key = state_new(AesKey);
    let msg = state_new(AesXBuf);
    let out = state_new(AesXBuf);
    key.data[0] = 68;
    key.data[1] = 99;
    key.data[2] = 130;
    key.data[3] = 161;
    key.data[4] = 192;
    key.data[5] = 223;
    key.data[6] = 254;
    key.data[7] = 29;
    key.data[8] = 60;
    key.data[9] = 91;
    key.data[10] = 122;
    key.data[11] = 153;
    key.data[12] = 184;
    key.data[13] = 215;
    key.data[14] = 246;
    key.data[15] = 21;
    msg.bytes[0] = 92;
    aes_cmac(key, msg, 1, out);
    let oi: u32 = 0;
    while oi < 16 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
