// scrypt batch 12 (vector 12)
// scrypt(pw=b'longerpasswordvalue', salt=b'saltsalt', N=16, r=1, p=1, dklen=64)
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hmac.vuma"::{HmacKey, HmacMsg};
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/pbkdf2.vuma"::{pbkdf2_hmac_sha256};
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/scrypt.vuma"::{scrypt};

transform main() -> i32 {
    let pass = state_new(HmacKey);
    let salt = state_new(HmacMsg);
    let out = state_new(HmacMsg);
    pass.bytes[0] = 108;
    pass.bytes[1] = 111;
    pass.bytes[2] = 110;
    pass.bytes[3] = 103;
    pass.bytes[4] = 101;
    pass.bytes[5] = 114;
    pass.bytes[6] = 112;
    pass.bytes[7] = 97;
    pass.bytes[8] = 115;
    pass.bytes[9] = 115;
    pass.bytes[10] = 119;
    pass.bytes[11] = 111;
    pass.bytes[12] = 114;
    pass.bytes[13] = 100;
    pass.bytes[14] = 118;
    pass.bytes[15] = 97;
    pass.bytes[16] = 108;
    pass.bytes[17] = 117;
    pass.bytes[18] = 101;
    salt.bytes[0] = 115;
    salt.bytes[1] = 97;
    salt.bytes[2] = 108;
    salt.bytes[3] = 116;
    salt.bytes[4] = 115;
    salt.bytes[5] = 97;
    salt.bytes[6] = 108;
    salt.bytes[7] = 116;
    scrypt(pass, 19, salt, 8, 16, 1, 1, out, 64);
    let oi: u32 = 0;
    while oi < 64 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
