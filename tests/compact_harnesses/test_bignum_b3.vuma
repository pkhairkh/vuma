// bignum batch 3 (vector 3)
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, bn256_add};

transform main() -> i32 {
    let a = state_new(Bn256Ctx);
    let b = state_new(Bn256Ctx);
    let r = state_new(Bn256Ctx);
    a.limbs[0] = ((3279182318 as u64) << 32) | (4111198819 as u64);
    a.limbs[1] = ((438989805 as u64) << 32) | (1445662585 as u64);
    a.limbs[2] = ((1631775357 as u64) << 32) | (398340369 as u64);
    a.limbs[3] = ((1541804686 as u64) << 32) | (415393687 as u64);
    b.limbs[0] = ((1477278577 as u64) << 32) | (3639960595 as u64);
    b.limbs[1] = ((1136108454 as u64) << 32) | (2592983555 as u64);
    b.limbs[2] = ((186618211 as u64) << 32) | (3466589567 as u64);
    b.limbs[3] = ((1973214822 as u64) << 32) | (3134174160 as u64);
    bn256_add(r, a, b);
    let oi: u32 = 0;
    while oi < 4 {
        let v = r.limbs[oi];
        print_int(1000 + ((v & 255) as u32));
        print_int(1000 + (((v >> 8) & 255) as u32));
        print_int(1000 + (((v >> 16) & 255) as u32));
        print_int(1000 + (((v >> 24) & 255) as u32));
        print_int(1000 + (((v >> 32) & 255) as u32));
        print_int(1000 + (((v >> 40) & 255) as u32));
        print_int(1000 + (((v >> 48) & 255) as u32));
        print_int(1000 + (((v >> 56) & 255) as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
