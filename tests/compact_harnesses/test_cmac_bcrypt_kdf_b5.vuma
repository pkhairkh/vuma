// cmac batch 5 (vector 5) — AES-256-CMAC random #1 (msg_len=8)
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/aes256.vuma"::{AesCtx, AesKey, AesBlock, aes256_init, aes_encrypt_block};
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hmac.vuma"::{HmacKey, HmacMsg, HmacOut, hmac_sha256, hmac_sha512};
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/cmac_bcrypt_kdf.vuma"::{KcCtx, aes_cmac_kdf};

transform main() -> i32 {
    let key = state_new(AesKey);
    let msg = state_new(HmacMsg);
    let out = state_new(AesBlock);
    key.data[0] = 254;
    key.data[1] = 45;
    key.data[2] = 71;
    key.data[3] = 17;
    key.data[4] = 18;
    key.data[5] = 140;
    key.data[6] = 105;
    key.data[7] = 225;
    key.data[8] = 138;
    key.data[9] = 164;
    key.data[10] = 69;
    key.data[11] = 110;
    key.data[12] = 104;
    key.data[13] = 30;
    key.data[14] = 128;
    key.data[15] = 105;
    key.data[16] = 92;
    key.data[17] = 40;
    key.data[18] = 240;
    key.data[19] = 106;
    key.data[20] = 124;
    key.data[21] = 67;
    key.data[22] = 166;
    key.data[23] = 185;
    key.data[24] = 229;
    key.data[25] = 146;
    key.data[26] = 241;
    key.data[27] = 239;
    key.data[28] = 176;
    key.data[29] = 201;
    key.data[30] = 253;
    key.data[31] = 15;
    msg.bytes[0] = 224;
    msg.bytes[1] = 26;
    msg.bytes[2] = 121;
    msg.bytes[3] = 84;
    msg.bytes[4] = 130;
    msg.bytes[5] = 244;
    msg.bytes[6] = 95;
    msg.bytes[7] = 26;
    aes_cmac_kdf(key, msg, 8, out);
    let oi: u32 = 0;
    while oi < 16 {
        print_int(1000 + (out.data[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
