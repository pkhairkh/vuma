// bignum batch 13 (vector 13)
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, bn256_add};

transform main() -> i32 {
    let a = state_new(Bn256Ctx);
    let b = state_new(Bn256Ctx);
    let r = state_new(Bn256Ctx);
    a.limbs[0] = ((3301106403 as u64) << 32) | (1146005448 as u64);
    a.limbs[1] = ((1461042543 as u64) << 32) | (2752909971 as u64);
    a.limbs[2] = ((1260573448 as u64) << 32) | (479112937 as u64);
    a.limbs[3] = ((679282378 as u64) << 32) | (1867302554 as u64);
    b.limbs[0] = ((13938521 as u64) << 32) | (1948728483 as u64);
    b.limbs[1] = ((3101361778 as u64) << 32) | (4096608204 as u64);
    b.limbs[2] = ((3091004939 as u64) << 32) | (3761759725 as u64);
    b.limbs[3] = ((4174227595 as u64) << 32) | (1131247330 as u64);
    bn256_add(r, a, b);
    let oi: u32 = 0;
    while oi < 4 {
        let v = r.limbs[oi];
        print_int(1000 + ((v & 255) as u32));
        print_int(1000 + (((v >> 8) & 255) as u32));
        print_int(1000 + (((v >> 16) & 255) as u32));
        print_int(1000 + (((v >> 24) & 255) as u32));
        print_int(1000 + (((v >> 32) & 255) as u32));
        print_int(1000 + (((v >> 40) & 255) as u32));
        print_int(1000 + (((v >> 48) & 255) as u32));
        print_int(1000 + (((v >> 56) & 255) as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
