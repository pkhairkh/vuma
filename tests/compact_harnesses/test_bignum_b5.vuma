// bignum batch 5 (vector 5)
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, bn256_add};

transform main() -> i32 {
    let a = state_new(Bn256Ctx);
    let b = state_new(Bn256Ctx);
    let r = state_new(Bn256Ctx);
    a.limbs[0] = ((298737106 as u64) << 32) | (3026113008 as u64);
    a.limbs[1] = ((2840104345 as u64) << 32) | (196814233 as u64);
    a.limbs[2] = ((3320303242 as u64) << 32) | (978815630 as u64);
    a.limbs[3] = ((4231494220 as u64) << 32) | (1242911821 as u64);
    b.limbs[0] = ((3673561638 as u64) << 32) | (342703921 as u64);
    b.limbs[1] = ((3721519026 as u64) << 32) | (999829240 as u64);
    b.limbs[2] = ((1632629719 as u64) << 32) | (433797840 as u64);
    b.limbs[3] = ((1947382419 as u64) << 32) | (1193887545 as u64);
    bn256_add(r, a, b);
    let oi: u32 = 0;
    while oi < 4 {
        let v = r.limbs[oi];
        print_int(1000 + ((v & 255) as u32));
        print_int(1000 + (((v >> 8) & 255) as u32));
        print_int(1000 + (((v >> 16) & 255) as u32));
        print_int(1000 + (((v >> 24) & 255) as u32));
        print_int(1000 + (((v >> 32) & 255) as u32));
        print_int(1000 + (((v >> 40) & 255) as u32));
        print_int(1000 + (((v >> 48) & 255) as u32));
        print_int(1000 + (((v >> 56) & 255) as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
