// bignum batch 6 (vector 6)
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, bn256_add};

transform main() -> i32 {
    let a = state_new(Bn256Ctx);
    let b = state_new(Bn256Ctx);
    let r = state_new(Bn256Ctx);
    a.limbs[0] = ((3582477022 as u64) << 32) | (2730243887 as u64);
    a.limbs[1] = ((698594025 as u64) << 32) | (1566942273 as u64);
    a.limbs[2] = ((1525876051 as u64) << 32) | (1589915144 as u64);
    a.limbs[3] = ((2878380452 as u64) << 32) | (899825838 as u64);
    b.limbs[0] = ((3014295294 as u64) << 32) | (1146660997 as u64);
    b.limbs[1] = ((2935814872 as u64) << 32) | (4022900809 as u64);
    b.limbs[2] = ((306671447 as u64) << 32) | (2783290795 as u64);
    b.limbs[3] = ((2727210979 as u64) << 32) | (2616197747 as u64);
    bn256_add(r, a, b);
    let oi: u32 = 0;
    while oi < 4 {
        let v = r.limbs[oi];
        print_int(1000 + ((v & 255) as u32));
        print_int(1000 + (((v >> 8) & 255) as u32));
        print_int(1000 + (((v >> 16) & 255) as u32));
        print_int(1000 + (((v >> 24) & 255) as u32));
        print_int(1000 + (((v >> 32) & 255) as u32));
        print_int(1000 + (((v >> 40) & 255) as u32));
        print_int(1000 + (((v >> 48) & 255) as u32));
        print_int(1000 + (((v >> 56) & 255) as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
