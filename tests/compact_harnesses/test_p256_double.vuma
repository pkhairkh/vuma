// Test p256_affine_double directly: 2*G should give 2G
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, Bn512Ctx, Bn64Ctx, bn256_mod_mul_mont, bn256_mod_inv_fermat, bn256_mont_mul, bn256_mont_mu, bn256_mont_r2, bn256_mod_inv, bn256_mod_add, bn256_mod_sub, bn256_mod_mul, bn256_mod_exp, bn256_zero, bn256_set_u32, bn256_copy, bn256_cmp, bn256_sub, bn256_add, bn256_is_zero, bn256_bitlen, bn256_get_bit, bn256_lshift1, bn256_mul_512, bn256_divmod_512, bn256_rshift1, bn256_mod, bn_mul_u64};
import "/home/z/my-project/workdir/vuma/womb/crypto/hash/sha256_sha224.vuma"::{Sha256Ctx, Sha256Data, Sha256Digest, Sha256W, Sha256K, sha256_init, sha256_update, sha256_final};
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hmac.vuma"::{HmacKey, HmacMsg, HmacOut, HmacBuf, hmac_sha256};
import "/home/z/my-project/workdir/vuma/womb/crypto/asym/ecdsa_p256.vuma"::{B32, B256, B128, p256_gx, p256_gy, p256_p, be32_to_bn256, bn256_to_be32, p256_affine_double};

transform main() -> i32 {
    print_int(5001);

    let gx_be = state_new(B32);
    let gy_be = state_new(B32);
    let p_be = state_new(B32);
    p256_gx(gx_be);
    p256_gy(gy_be);
    p256_p(p_be);

    let gx_bn = state_new(Bn256Ctx);
    let gy_bn = state_new(Bn256Ctx);
    let p_bn = state_new(Bn256Ctx);
    be32_to_bn256(gx_bn, gx_be);
    be32_to_bn256(gy_bn, gy_be);
    be32_to_bn256(p_bn, p_be);

    print_int(5002);

    // a = p - 3
    let a_bn = state_new(Bn256Ctx);
    bn256_copy(a_bn, p_bn);
    let lo = a_bn.limbs[0];
    a_bn.limbs[0] = lo - 3;

    // rx, ry = 2*G
    let rx_bn = state_new(Bn256Ctx);
    let ry_bn = state_new(Bn256Ctx);

    print_int(5003);

    p256_affine_double(rx_bn, ry_bn, gx_bn, gy_bn, a_bn, p_bn);

    print_int(5004);

    // Output rx as 32 bytes big-endian
    let rx_be = state_new(B32);
    bn256_to_be32(rx_be, rx_bn);
    let oi: u32 = 0;
    while oi < 32 {
        print_int(1000 + (rx_be.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
