transform main() -> i32 {
    print_int(1001);

    let k = state_new(B32);
    let px = state_new(B32);
    let py = state_new(B32);
    let rx = state_new(B32);
    let ry = state_new(B32);

    print_int(1002);  // all 5 allocated

    // Test: write to each state
    k.bytes[0] = 1;
    px.bytes[0] = 2;
    py.bytes[0] = 3;
    rx.bytes[0] = 4;
    ry.bytes[0] = 5;

    print_int(1003);  // writes done

    // Test: while loop
    let i = 0;
    while i < 31 { k.bytes[i] = 0; i = i + 1; }
    k.bytes[31] = 1;

    print_int(1004);  // while loop done

    p256_gx(px);
    p256_gy(py);

    print_int(1005);  // gx/gy done

    print_int(999);
