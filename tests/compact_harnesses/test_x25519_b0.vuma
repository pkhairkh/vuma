// x25519 batch 0 (vector 0) — RFC 7748 §6.1 Alice base point scalar mult
import "/home/z/my-project/workdir/vuma/womb/crypto/asym/x25519.vuma"::{X25519Bytes, x25519_base};

transform main() -> i32 {
    let priv = state_new(X25519Bytes);
    let out = state_new(X25519Bytes);
    priv.data[0] = 119;
    priv.data[1] = 7;
    priv.data[2] = 109;
    priv.data[3] = 10;
    priv.data[4] = 115;
    priv.data[5] = 24;
    priv.data[6] = 165;
    priv.data[7] = 125;
    priv.data[8] = 60;
    priv.data[9] = 22;
    priv.data[10] = 193;
    priv.data[11] = 114;
    priv.data[12] = 81;
    priv.data[13] = 178;
    priv.data[14] = 102;
    priv.data[15] = 69;
    priv.data[16] = 223;
    priv.data[17] = 76;
    priv.data[18] = 47;
    priv.data[19] = 135;
    priv.data[20] = 235;
    priv.data[21] = 192;
    priv.data[22] = 153;
    priv.data[23] = 42;
    priv.data[24] = 177;
    priv.data[25] = 119;
    priv.data[26] = 251;
    priv.data[27] = 165;
    priv.data[28] = 29;
    priv.data[29] = 185;
    priv.data[30] = 44;
    priv.data[31] = 42;
    x25519_base(out, priv);
    let oi: u32 = 0;
    while oi < 32 {
        print_int(1000 + (out.data[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
