// pbkdf2 batch 10 (vector 10)
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hmac.vuma"::{HmacKey, HmacMsg, HmacOut};
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/pbkdf2.vuma"::{pbkdf2_hmac_sha256};

transform main() -> i32 {
    let pass = state_new(HmacKey);
    let salt = state_new(HmacMsg);
    let out = state_new(HmacMsg);
    // V10: PBKDF2-sha256(iters=2,dklen=32)
    pass.bytes[0] = 97;
    pass.bytes[1] = 110;
    pass.bytes[2] = 111;
    pass.bytes[3] = 116;
    pass.bytes[4] = 104;
    pass.bytes[5] = 101;
    pass.bytes[6] = 114;
    salt.bytes[0] = 97;
    salt.bytes[1] = 110;
    salt.bytes[2] = 111;
    salt.bytes[3] = 116;
    salt.bytes[4] = 104;
    salt.bytes[5] = 101;
    salt.bytes[6] = 114;
    pbkdf2_hmac_sha256(pass, 7, salt, 7, 2, out, 32);
    let oi: u32 = 0;
    while oi < 32 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
