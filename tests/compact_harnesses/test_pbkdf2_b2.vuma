// pbkdf2 batch 2 (vectors 10-11)
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hmac.vuma"::{HmacKey, HmacMsg, HmacOut};
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/pbkdf2.vuma"::{pbkdf2_hmac_sha256};

transform main() -> i32 {
    let pass = state_new(HmacKey);
    let salt = state_new(HmacMsg);
    let out = state_new(HmacMsg);
    let oi: u32 = 0;
    // V10: PBKDF2-sha256(iters=1,dklen=16)
    salt.bytes[0] = 78;
    salt.bytes[1] = 97;
    salt.bytes[2] = 67;
    salt.bytes[3] = 108;
    pass.bytes[0] = 116;
    pass.bytes[1] = 101;
    pass.bytes[2] = 115;
    pass.bytes[3] = 116;
    pbkdf2_hmac_sha256(pass, 4, salt, 4, 1, out, 16);
    oi = 0;
    while oi < 16 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    // V11: PBKDF2-sha256(iters=2,dklen=32)
    salt.bytes[0] = 115;
    salt.bytes[1] = 97;
    salt.bytes[2] = 108;
    salt.bytes[3] = 116;
    salt.bytes[4] = 118;
    salt.bytes[5] = 97;
    salt.bytes[6] = 108;
    salt.bytes[7] = 117;
    salt.bytes[8] = 101;
    pass.bytes[0] = 115;
    pass.bytes[1] = 101;
    pass.bytes[2] = 99;
    pass.bytes[3] = 114;
    pass.bytes[4] = 101;
    pass.bytes[5] = 116;
    pbkdf2_hmac_sha256(pass, 6, salt, 9, 2, out, 32);
    oi = 0;
    while oi < 32 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}