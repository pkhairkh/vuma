import "/home/z/my-project/workdir/vuma/womb/crypto/post_quantum/ml_kem.vuma"::{MlKemBuf, compress_at, decompress_at, poly_zero_at};

transform main() -> i32 {
    let poly = state_new(MlKemBuf);
    let dec = state_new(MlKemBuf);

    // Set poly[0..3] to known values
    poly_zero_at(poly, 0);
    let i: u32 = 0;
    while i < 4 {
        let off = i * 4;
        let v: u32 = 0;
        if i == 0 { v = 100; }
        if i == 1 { v = 1000; }
        if i == 2 { v = 3000; }
        if i == 3 { v = 3328; }
        poly.bytes[off] = (v & 255) as u8;
        poly.bytes[off + 1] = ((v >> 8) & 255) as u8;
        poly.bytes[off + 2] = 0;
        poly.bytes[off + 3] = 0;
        i = i + 1;
    }

    // Compress in-place
    compress_at(poly, 0, 11);

    // Print compressed
    i = 0;
    while i < 4 {
        let off = i * 4;
        let v = (poly.bytes[off] as u32) | ((poly.bytes[off + 1] as u32) << 8) | ((poly.bytes[off + 2] as u32) << 16) | ((poly.bytes[off + 3] as u32) << 24);
        print_int(1000 + v);
        i = i + 1;
    }
    print_int(999);

    // Copy compressed to dec, then decompress in-place
    i = 0;
    while i < 16 {
        dec.bytes[i] = poly.bytes[i];
        i = i + 1;
    }
    decompress_at(dec, 0, 11);

    // Print decompressed
    i = 0;
    while i < 4 {
        let off = i * 4;
        let v = (dec.bytes[off] as u32) | ((dec.bytes[off + 1] as u32) << 8) | ((dec.bytes[off + 2] as u32) << 16) | ((dec.bytes[off + 3] as u32) << 24);
        print_int(1000 + v);
        i = i + 1;
    }
    print_int(999);

    return 0;
}
