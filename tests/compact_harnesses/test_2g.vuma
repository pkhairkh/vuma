// Test: p256_scalar_mul_base with k=2, print result.
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, bn256_set_u32, bn256_zero, bn256_is_zero};
import "/home/z/my-project/workdir/vuma/womb/crypto/asym/ecdsa_p256.vuma"::{B32, p256_scalar_mul_base, bn256_to_be32};

transform main() -> i32 {
    let k = state_new(Bn256Ctx);
    bn256_set_u32(k, 2);
    let rx = state_new(Bn256Ctx);
    let ry = state_new(Bn256Ctx);
    p256_scalar_mul_base(rx, ry, k);
    // Print rx and ry as 32-byte BE
    let rx_be = state_new(B32);
    let ry_be = state_new(B32);
    bn256_to_be32(rx_be, rx);
    bn256_to_be32(ry_be, ry);
    let i: u32 = 0;
    while i < 32 { print_int(1000 + (rx_be.bytes[i] as u32)); i = i + 1; }
    print_int(999);
    i = 0;
    while i < 32 { print_int(1000 + (ry_be.bytes[i] as u32)); i = i + 1; }
    print_int(999);
    return 0;
}
