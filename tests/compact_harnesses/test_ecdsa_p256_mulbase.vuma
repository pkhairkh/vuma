// Test p256_scalar_mul_base with k=1 (should return G)
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, Bn512Ctx, Bn64Ctx, bn256_mod_mul, bn256_mod_inv, bn256_mod_add, bn256_mod_sub, bn256_mod_exp, bn256_mont_mul, bn256_mont_mu, bn256_mont_r2, bn256_zero, bn256_set_u32, bn256_copy, bn256_cmp, bn256_sub, bn256_add, bn256_is_zero, bn256_bitlen, bn256_get_bit, bn256_lshift1, bn256_mul_512, bn256_divmod_512, bn256_rshift1, bn256_mod, bn_mul_u64, bn256_mod_mul_mont, bn256_mod_inv_fermat};
import "/home/z/my-project/workdir/vuma/womb/crypto/hash/sha256_sha224.vuma"::{Sha256Ctx, Sha256Data, Sha256Digest, Sha256W, Sha256K, sha256_init, sha256_update, sha256_final};
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hmac.vuma"::{HmacKey, HmacMsg, HmacOut, HmacBuf, hmac_sha256};
import "/home/z/my-project/workdir/vuma/womb/crypto/asym/ecdsa_p256.vuma"::{B32, B256, B128, p256_gx, p256_gy, p256_p, be32_to_bn256, bn256_to_be32, p256_scalar_mul_base};

transform do_mul(rx_be: State<B32>) {
    let k_be = state_new(B32);
    let i = 0;
    while i < 31 { k_be.bytes[i] = 0; i = i + 1; }
    k_be.bytes[31] = 1;

    let k_bn = state_new(Bn256Ctx);
    be32_to_bn256(k_bn, k_be);

    let rx_bn = state_new(Bn256Ctx);
    let ry_bn = state_new(Bn256Ctx);

    p256_scalar_mul_base(rx_bn, ry_bn, k_bn);

    bn256_to_be32(rx_be, rx_bn);
}

transform main() -> i32 {
    let rx_be = state_new(B32);
    do_mul(rx_be);

    let oi: u32 = 0;
    while oi < 32 {
        print_int(1000 + (rx_be.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
