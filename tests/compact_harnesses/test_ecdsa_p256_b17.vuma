    msg.bytes[11] = 49;
    msg.bytes[12] = 55;
    privkey.bytes[0] = 48;
    privkey.bytes[1] = 112;
    privkey.bytes[2] = 226;
    privkey.bytes[3] = 52;
    privkey.bytes[4] = 115;
    privkey.bytes[5] = 187;
    privkey.bytes[6] = 53;
    privkey.bytes[7] = 55;
    privkey.bytes[8] = 12;
    privkey.bytes[9] = 48;
