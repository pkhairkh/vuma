// drbg batch 14 (vector 14)
import "/home/z/my-project/workdir/vuma/womb/crypto/drbg/drbg.vuma"::{DrbgCtx, DrbgData, DrbgOut, drbg_init, drbg_generate};

transform main() -> i32 {
    let drbg = state_new(DrbgCtx);
    let entropy = state_new(DrbgData);
    let out = state_new(DrbgOut);
    entropy.bytes[0] = 238;
    entropy.bytes[1] = 13;
    entropy.bytes[2] = 44;
    entropy.bytes[3] = 75;
    entropy.bytes[4] = 106;
    entropy.bytes[5] = 137;
    entropy.bytes[6] = 168;
    entropy.bytes[7] = 199;
    entropy.bytes[8] = 230;
    entropy.bytes[9] = 5;
    entropy.bytes[10] = 36;
    entropy.bytes[11] = 67;
    entropy.bytes[12] = 98;
    entropy.bytes[13] = 129;
    entropy.bytes[14] = 160;
    entropy.bytes[15] = 191;
    entropy.bytes[16] = 222;
    entropy.bytes[17] = 253;
    entropy.bytes[18] = 28;
    entropy.bytes[19] = 59;
    entropy.bytes[20] = 90;
    entropy.bytes[21] = 121;
    entropy.bytes[22] = 152;
    entropy.bytes[23] = 183;
    entropy.bytes[24] = 214;
    entropy.bytes[25] = 245;
    entropy.bytes[26] = 20;
    entropy.bytes[27] = 51;
    entropy.bytes[28] = 82;
    entropy.bytes[29] = 113;
    entropy.bytes[30] = 144;
    entropy.bytes[31] = 175;
    drbg_init(drbg, entropy, 32, entropy, 0);
    drbg_generate(drbg, out, 32);
    let oi: u32 = 0;
    while oi < 32 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
