import "/home/z/my-project/workdir/vuma/womb/crypto/asym/ecdsa_p256.vuma"::{B32, p256_gx, p256_gy};

transform main() -> i32 {
    print_int(1111);  // start

    let px = state_new(B32);
    print_int(2222);  // px allocated

    p256_gx(px);
    print_int(3333);  // p256_gx done

    // Output px
    let i = 0;
    while i < 32 {
        print_int(1000 + (px.bytes[i] as u32));
        i = i + 1;
    }
    print_int(999);
    return 0;
}
