transform main() -> i32 {
    let buf = state_new(Rc4Buf);
    let out = state_new(Rc4Buf);
    let key = state_new(Rc4Buf);
    key.bytes[0] = 123;
    key.bytes[1] = 190;
    key.bytes[2] = 1;
    key.bytes[3] = 68;
    key.bytes[4] = 135;
    key.bytes[5] = 202;
    key.bytes[6] = 13;
    key.bytes[7] = 80;
    key.bytes[8] = 147;
    key.bytes[9] = 214;
    key.bytes[10] = 25;
    key.bytes[11] = 92;
    key.bytes[12] = 159;
    key.bytes[13] = 226;
    buf.bytes[0] = 129;
    buf.bytes[1] = 218;
    buf.bytes[2] = 51;
    buf.bytes[3] = 140;
    buf.bytes[4] = 229;
    buf.bytes[5] = 62;
    buf.bytes[6] = 151;
    buf.bytes[7] = 240;
    buf.bytes[8] = 73;
    buf.bytes[9] = 162;
    buf.bytes[10] = 251;
    buf.bytes[11] = 84;
    buf.bytes[12] = 173;
    buf.bytes[13] = 6;
    buf.bytes[14] = 95;
    buf.bytes[15] = 184;
    buf.bytes[16] = 17;
