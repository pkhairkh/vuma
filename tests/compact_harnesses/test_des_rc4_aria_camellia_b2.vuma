// des_rc4_aria_camellia batch 2 (vector 2)
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/des_rc4_aria_camellia.vuma"::{DesWord, des_encrypt_block};

transform main() -> i32 {
    let buf = state_new(DesWord);
    let out = state_new(DesWord);
    let key = state_new(DesWord);
    key.bytes[0] = 37;
    key.bytes[1] = 110;
    key.bytes[2] = 183;
    key.bytes[3] = 0;
    key.bytes[4] = 73;
    key.bytes[5] = 146;
    key.bytes[6] = 219;
    key.bytes[7] = 36;
    buf.bytes[0] = 53;
    buf.bytes[1] = 150;
    buf.bytes[2] = 247;
    buf.bytes[3] = 88;
    buf.bytes[4] = 185;
    buf.bytes[5] = 26;
    buf.bytes[6] = 123;
    buf.bytes[7] = 220;
    des_encrypt_block(buf, key, out);
    let oi: u32 = 0;
    while oi < 8 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
