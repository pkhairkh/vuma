transform main() -> i32 {
    let priv = state_new(B32);
    let pub_out = state_new(B32);
    priv.bytes[0] = 112;
    priv.bytes[1] = 221;
    priv.bytes[2] = 132;
    priv.bytes[3] = 225;
    priv.bytes[4] = 89;
    priv.bytes[5] = 52;
    priv.bytes[6] = 11;
