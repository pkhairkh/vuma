// drbg batch 18 (vector 18)
// DRBG: 8-byte entropy, no nonce, 80 bytes
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hmac.vuma"::{HmacKey, HmacMsg, HmacOut, hmac_sha256};
import "/home/z/my-project/workdir/vuma/womb/crypto/drbg/drbg.vuma"::{DrbgCtx, DrbgData, DrbgOut, drbg_init, drbg_generate};

transform main() -> i32 {
    let drbg = state_new(DrbgCtx);
    let entropy = state_new(DrbgData);
    let nonce = state_new(DrbgData);
    let out = state_new(DrbgOut);
    entropy.bytes[0] = 17;
    entropy.bytes[1] = 34;
    entropy.bytes[2] = 51;
    entropy.bytes[3] = 68;
    entropy.bytes[4] = 85;
    entropy.bytes[5] = 102;
    entropy.bytes[6] = 119;
    entropy.bytes[7] = 136;
    drbg_init(drbg, entropy, 8, nonce, 0);
    drbg_generate(drbg, out, 80);
    let oi: u32 = 0;
    while oi < 80 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
