transform main() -> i32 {
    let ctx = state_new(AesCtx);
    let key = state_new(AesKey);
    let iv = state_new(CfbOfbIv);
    let buf = state_new(CfbOfbBuf);
    let out = state_new(CfbOfbBuf);
    key.data[0] = 43;
    key.data[1] = 126;
    key.data[2] = 21;
    key.data[3] = 22;
    key.data[4] = 40;
    key.data[5] = 174;
    key.data[6] = 210;
    key.data[7] = 166;
    key.data[8] = 171;
    key.data[9] = 247;
    key.data[10] = 21;
    key.data[11] = 136;
    key.data[12] = 9;
    key.data[13] = 207;
    key.data[14] = 79;
    key.data[15] = 60;
    iv.bytes[0] = 59;
    iv.bytes[1] = 63;
    iv.bytes[2] = 217;
    iv.bytes[3] = 46;
    iv.bytes[4] = 183;
    iv.bytes[5] = 45;
    iv.bytes[6] = 173;
    iv.bytes[7] = 32;
    iv.bytes[8] = 51;
    iv.bytes[9] = 52;
    iv.bytes[10] = 73;
    iv.bytes[11] = 248;
    iv.bytes[12] = 232;
    iv.bytes[13] = 60;
    iv.bytes[14] = 251;
    iv.bytes[15] = 74;
    buf.bytes[0] = 174;
    buf.bytes[1] = 45;
    buf.bytes[2] = 138;
    buf.bytes[3] = 87;
    buf.bytes[4] = 30;
    buf.bytes[5] = 3;
    buf.bytes[6] = 172;
    buf.bytes[7] = 156;
    buf.bytes[8] = 158;
    buf.bytes[9] = 183;
    buf.bytes[10] = 111;
    buf.bytes[11] = 172;
    buf.bytes[12] = 69;
    buf.bytes[13] = 175;
    buf.bytes[14] = 142;
    buf.bytes[15] = 81;
    aes128_init(ctx, key);
    aes_cfb128_encrypt(ctx, iv, buf, out, 1);
    let oi: u32 = 0;
    while oi < 16 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
