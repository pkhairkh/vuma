// aes_extra_modes batch 12 (vector 12)
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/aes128.vuma"::{AesCtx, AesKey, aes128_init};
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/aes_extra_modes.vuma"::{AesXBuf, AesXBlock, aes_cmac};

transform main() -> i32 {
    let key = state_new(AesKey);
    let msg = state_new(AesXBuf);
    let out = state_new(AesXBuf);
    key.data[0] = 136;
    key.data[1] = 167;
    key.data[2] = 198;
    key.data[3] = 229;
    key.data[4] = 4;
    key.data[5] = 35;
    key.data[6] = 66;
    key.data[7] = 97;
    key.data[8] = 128;
    key.data[9] = 159;
    key.data[10] = 190;
    key.data[11] = 221;
    key.data[12] = 252;
    key.data[13] = 27;
    key.data[14] = 58;
    key.data[15] = 89;
    msg.bytes[0] = 184;
    aes_cmac(key, msg, 1, out);
    let oi: u32 = 0;
    while oi < 16 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
