// bignum batch 14 (vector 14)
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, bn256_add};

transform main() -> i32 {
    let a = state_new(Bn256Ctx);
    let b = state_new(Bn256Ctx);
    let r = state_new(Bn256Ctx);
    a.limbs[0] = ((3272602734 as u64) << 32) | (2150000991 as u64);
    a.limbs[1] = ((2180476188 as u64) << 32) | (767303988 as u64);
    a.limbs[2] = ((457031004 as u64) << 32) | (3919706735 as u64);
    a.limbs[3] = ((2685643886 as u64) << 32) | (3738848790 as u64);
    b.limbs[0] = ((3614942327 as u64) << 32) | (1281810600 as u64);
    b.limbs[1] = ((2180395476 as u64) << 32) | (2744267175 as u64);
    b.limbs[2] = ((854316681 as u64) << 32) | (2615507143 as u64);
    b.limbs[3] = ((1605947756 as u64) << 32) | (656439677 as u64);
    bn256_add(r, a, b);
    let oi: u32 = 0;
    while oi < 4 {
        let v = r.limbs[oi];
        print_int(1000 + ((v & 255) as u32));
        print_int(1000 + (((v >> 8) & 255) as u32));
        print_int(1000 + (((v >> 16) & 255) as u32));
        print_int(1000 + (((v >> 24) & 255) as u32));
        print_int(1000 + (((v >> 32) & 255) as u32));
        print_int(1000 + (((v >> 40) & 255) as u32));
        print_int(1000 + (((v >> 48) & 255) as u32));
        print_int(1000 + (((v >> 56) & 255) as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
