    msg.bytes[10] = 32;
    msg.bytes[11] = 50;
    privkey.bytes[0] = 75;
    privkey.bytes[1] = 83;
    privkey.bytes[2] = 179;
    privkey.bytes[3] = 187;
    privkey.bytes[4] = 233;
    privkey.bytes[5] = 22;
    privkey.bytes[6] = 86;
    privkey.bytes[7] = 87;
    privkey.bytes[8] = 94;
    privkey.bytes[9] = 162;
    privkey.bytes[10] = 20;
