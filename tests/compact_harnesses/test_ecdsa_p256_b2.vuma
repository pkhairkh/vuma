    privkey.bytes[29] = 156;
    privkey.bytes[30] = 122;
    privkey.bytes[31] = 41;
    ecdsa_p256_sign(msg, 12, privkey, r_out, s_out);
    let oi: u32 = 0;
    while oi < 32 { print_int(1000 + (r_out.bytes[oi] as u32)); oi = oi + 1; }
    print_int(999);
