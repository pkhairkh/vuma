// Test byte-by-byte mod_l directly
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, Bn512Ctx, bn256_mod_add, bn256_set_u32, bn256_copy, bn256_zero, bn256_cmp};
import "/home/z/my-project/workdir/vuma/womb/crypto/asym/ed25519.vuma"::{B32, B64, ed25519_l, b32_to_bn256, bn256_to_b32};

transform main() -> i32 {
    let L_le = state_new(B32);
    ed25519_l(L_le);
    let L_bn = state_new(Bn256Ctx);
    b32_to_bn256(L_bn, L_le);

    // Test: hash = 0x0302 = 770 (LE: bytes[0]=2, bytes[1]=3)
    // 770 mod L = 770 (since 770 < L)
    let hash = state_new(B64);
    let z: u32 = 0;
    while z < 64 { hash.bytes[z] = 0; z = z + 1; }
    hash.bytes[0] = 2;
    hash.bytes[1] = 3;

    // Manual byte-by-byte: rem = 0; for i in 63..0: rem = (rem*256 + hash[i]) mod L
    let rem = state_new(Bn256Ctx);
    bn256_zero(rem);

    let i: u32 = 64;
    while i > 0 {
        i = i - 1;

        // rem = rem * 256 (8 doublings)
        let d: u32 = 0;
        while d < 8 {
            // Use temp to avoid aliasing
            let tmp = state_new(Bn256Ctx);
            bn256_copy(tmp, rem);
            bn256_mod_add(rem, rem, tmp, L_bn);
            d = d + 1;
        }

        // rem = rem + hash.bytes[i]
        let byte_bn = state_new(Bn256Ctx);
        bn256_set_u32(byte_bn, hash.bytes[i] as u32);
        bn256_mod_add(rem, rem, byte_bn, L_bn);
    }

    let out = state_new(B32);
    bn256_to_b32(out, rem);
    let oi: u32 = 0;
    while oi < 32 { print_int(1000 + (out.bytes[oi] as u32)); oi = oi + 1; }
    print_int(999);

    // Test with actual r_hash
    let r_hash = state_new(B64);
    r_hash.bytes[ 0] = 0x43; r_hash.bytes[ 1] = 0x55; r_hash.bytes[ 2] = 0xdd; r_hash.bytes[ 3] = 0x03;
    r_hash.bytes[ 4] = 0xa5; r_hash.bytes[ 5] = 0x78; r_hash.bytes[ 6] = 0xd0; r_hash.bytes[ 7] = 0x07;
    r_hash.bytes[ 8] = 0xd5; r_hash.bytes[ 9] = 0x2a; r_hash.bytes[10] = 0x39; r_hash.bytes[11] = 0xf4;
    r_hash.bytes[12] = 0x2a; r_hash.bytes[13] = 0x8a; r_hash.bytes[14] = 0x5f; r_hash.bytes[15] = 0xa0;
    r_hash.bytes[16] = 0xfe; r_hash.bytes[17] = 0x73; r_hash.bytes[18] = 0x9e; r_hash.bytes[19] = 0x76;
    r_hash.bytes[20] = 0x2a; r_hash.bytes[21] = 0x2a; r_hash.bytes[22] = 0x8d; r_hash.bytes[23] = 0x9d;
    r_hash.bytes[24] = 0x6e; r_hash.bytes[25] = 0x64; r_hash.bytes[26] = 0x30; r_hash.bytes[27] = 0x05;
    r_hash.bytes[28] = 0xdf; r_hash.bytes[29] = 0x0e; r_hash.bytes[30] = 0xd9; r_hash.bytes[31] = 0x53;
    r_hash.bytes[32] = 0x53; r_hash.bytes[33] = 0x26; r_hash.bytes[34] = 0xdd; r_hash.bytes[35] = 0xed;
    r_hash.bytes[36] = 0x78; r_hash.bytes[37] = 0xdb; r_hash.bytes[38] = 0x23; r_hash.bytes[39] = 0x42;
    r_hash.bytes[40] = 0x90; r_hash.bytes[41] = 0x88; r_hash.bytes[42] = 0xb2; r_hash.bytes[43] = 0x40;
    r_hash.bytes[44] = 0x99; r_hash.bytes[45] = 0x7d; r_hash.bytes[46] = 0xa9; r_hash.bytes[47] = 0xbf;
    r_hash.bytes[48] = 0xb4; r_hash.bytes[49] = 0xf6; r_hash.bytes[50] = 0xe5; r_hash.bytes[51] = 0xf0;
    r_hash.bytes[52] = 0x88; r_hash.bytes[53] = 0x9a; r_hash.bytes[54] = 0x5b; r_hash.bytes[55] = 0x07;
    r_hash.bytes[56] = 0x49; r_hash.bytes[57] = 0x48; r_hash.bytes[58] = 0x7e; r_hash.bytes[59] = 0x01;
    r_hash.bytes[60] = 0x56; r_hash.bytes[61] = 0x71; r_hash.bytes[62] = 0x30; r_hash.bytes[63] = 0x08;

    let rem2 = state_new(Bn256Ctx);
    bn256_zero(rem2);

    let i2: u32 = 64;
    while i2 > 0 {
        i2 = i2 - 1;
        let d2: u32 = 0;
        while d2 < 8 {
            let tmp2 = state_new(Bn256Ctx);
            bn256_copy(tmp2, rem2);
            bn256_mod_add(rem2, rem2, tmp2, L_bn);
            d2 = d2 + 1;
        }
        let byte_bn2 = state_new(Bn256Ctx);
        bn256_set_u32(byte_bn2, r_hash.bytes[i2] as u32);
        bn256_mod_add(rem2, rem2, byte_bn2, L_bn);
    }

    let out2 = state_new(B32);
    bn256_to_b32(out2, rem2);
    let oi2: u32 = 0;
    while oi2 < 32 { print_int(1000 + (out2.bytes[oi2] as u32)); oi2 = oi2 + 1; }
    print_int(999);

    return 0;
}
