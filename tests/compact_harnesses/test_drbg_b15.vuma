// drbg batch 15 (vector 15)
import "/home/z/my-project/workdir/vuma/womb/crypto/drbg/drbg.vuma"::{DrbgCtx, DrbgData, DrbgOut, drbg_init, drbg_generate};

transform main() -> i32 {
    let drbg = state_new(DrbgCtx);
    let entropy = state_new(DrbgData);
    let out = state_new(DrbgOut);
    entropy.bytes[0] = 255;
    entropy.bytes[1] = 30;
    entropy.bytes[2] = 61;
    entropy.bytes[3] = 92;
    entropy.bytes[4] = 123;
    entropy.bytes[5] = 154;
    entropy.bytes[6] = 185;
    entropy.bytes[7] = 216;
    entropy.bytes[8] = 247;
    entropy.bytes[9] = 22;
    entropy.bytes[10] = 53;
    entropy.bytes[11] = 84;
    entropy.bytes[12] = 115;
    entropy.bytes[13] = 146;
    entropy.bytes[14] = 177;
    entropy.bytes[15] = 208;
    entropy.bytes[16] = 239;
    entropy.bytes[17] = 14;
    entropy.bytes[18] = 45;
    entropy.bytes[19] = 76;
    entropy.bytes[20] = 107;
    entropy.bytes[21] = 138;
    entropy.bytes[22] = 169;
    entropy.bytes[23] = 200;
    entropy.bytes[24] = 231;
    entropy.bytes[25] = 6;
    entropy.bytes[26] = 37;
    entropy.bytes[27] = 68;
    entropy.bytes[28] = 99;
    entropy.bytes[29] = 130;
    entropy.bytes[30] = 161;
    entropy.bytes[31] = 192;
    drbg_init(drbg, entropy, 32, entropy, 0);
    drbg_generate(drbg, out, 32);
    let oi: u32 = 0;
    while oi < 32 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
