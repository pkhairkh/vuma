// drbg batch 15 (vector 15)
// DRBG: 32-byte entropy (binary), 32 bytes
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hmac.vuma"::{HmacKey, HmacMsg, HmacOut, hmac_sha256};
import "/home/z/my-project/workdir/vuma/womb/crypto/drbg/drbg.vuma"::{DrbgCtx, DrbgData, DrbgOut, drbg_init, drbg_generate};

transform main() -> i32 {
    let drbg = state_new(DrbgCtx);
    let entropy = state_new(DrbgData);
    let nonce = state_new(DrbgData);
    let out = state_new(DrbgOut);
    entropy.bytes[0] = 0;
    entropy.bytes[1] = 1;
    entropy.bytes[2] = 2;
    entropy.bytes[3] = 3;
    entropy.bytes[4] = 4;
    entropy.bytes[5] = 5;
    entropy.bytes[6] = 6;
    entropy.bytes[7] = 7;
    entropy.bytes[8] = 8;
    entropy.bytes[9] = 9;
    entropy.bytes[10] = 10;
    entropy.bytes[11] = 11;
    entropy.bytes[12] = 12;
    entropy.bytes[13] = 13;
    entropy.bytes[14] = 14;
    entropy.bytes[15] = 15;
    entropy.bytes[16] = 16;
    entropy.bytes[17] = 17;
    entropy.bytes[18] = 18;
    entropy.bytes[19] = 19;
    entropy.bytes[20] = 20;
    entropy.bytes[21] = 21;
    entropy.bytes[22] = 22;
    entropy.bytes[23] = 23;
    entropy.bytes[24] = 24;
    entropy.bytes[25] = 25;
    entropy.bytes[26] = 26;
    entropy.bytes[27] = 27;
    entropy.bytes[28] = 28;
    entropy.bytes[29] = 29;
    entropy.bytes[30] = 30;
    entropy.bytes[31] = 31;
    drbg_init(drbg, entropy, 32, nonce, 0);
    drbg_generate(drbg, out, 32);
    let oi: u32 = 0;
    while oi < 32 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
