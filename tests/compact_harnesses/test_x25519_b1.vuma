// x25519 batch 1 (vector 1) — RFC 7748 §6.1 Alice × Bob's pubkey
import "/home/z/my-project/workdir/vuma/womb/crypto/asym/x25519.vuma"::{X25519Bytes, x25519_scalarmult};

transform main() -> i32 {
    let priv = state_new(X25519Bytes);
    let out = state_new(X25519Bytes);
    priv.data[0] = 119;
