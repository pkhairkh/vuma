// drbg batch 3 (vector 3)
import "/home/z/my-project/workdir/vuma/womb/crypto/drbg/drbg.vuma"::{DrbgCtx, DrbgData, DrbgOut, drbg_init, drbg_generate};

transform main() -> i32 {
    let drbg = state_new(DrbgCtx);
    let entropy = state_new(DrbgData);
    let out = state_new(DrbgOut);
    entropy.bytes[0] = 51;
    entropy.bytes[1] = 82;
    entropy.bytes[2] = 113;
    entropy.bytes[3] = 144;
    entropy.bytes[4] = 175;
    entropy.bytes[5] = 206;
    entropy.bytes[6] = 237;
    entropy.bytes[7] = 12;
    entropy.bytes[8] = 43;
    entropy.bytes[9] = 74;
    entropy.bytes[10] = 105;
    entropy.bytes[11] = 136;
    entropy.bytes[12] = 167;
    entropy.bytes[13] = 198;
    entropy.bytes[14] = 229;
    entropy.bytes[15] = 4;
    entropy.bytes[16] = 35;
    entropy.bytes[17] = 66;
    entropy.bytes[18] = 97;
    entropy.bytes[19] = 128;
    entropy.bytes[20] = 159;
    entropy.bytes[21] = 190;
    entropy.bytes[22] = 221;
    entropy.bytes[23] = 252;
    entropy.bytes[24] = 27;
    entropy.bytes[25] = 58;
    entropy.bytes[26] = 89;
    entropy.bytes[27] = 120;
    entropy.bytes[28] = 151;
    entropy.bytes[29] = 182;
    entropy.bytes[30] = 213;
    entropy.bytes[31] = 244;
    drbg_init(drbg, entropy, 32, entropy, 0);
    drbg_generate(drbg, out, 32);
    let oi: u32 = 0;
    while oi < 32 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
