// drbg batch 3 (vector 3)
// DRBG: 32-byte entropy, no nonce, 32 bytes
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hmac.vuma"::{HmacKey, HmacMsg, HmacOut, hmac_sha256};
import "/home/z/my-project/workdir/vuma/womb/crypto/drbg/drbg.vuma"::{DrbgCtx, DrbgData, DrbgOut, drbg_init, drbg_generate};

transform main() -> i32 {
    let drbg = state_new(DrbgCtx);
    let entropy = state_new(DrbgData);
    let nonce = state_new(DrbgData);
    let out = state_new(DrbgOut);
    entropy.bytes[0] = 0;
    entropy.bytes[1] = 17;
    entropy.bytes[2] = 34;
    entropy.bytes[3] = 51;
    entropy.bytes[4] = 68;
    entropy.bytes[5] = 85;
    entropy.bytes[6] = 102;
    entropy.bytes[7] = 119;
    entropy.bytes[8] = 136;
    entropy.bytes[9] = 153;
    entropy.bytes[10] = 170;
    entropy.bytes[11] = 187;
    entropy.bytes[12] = 204;
    entropy.bytes[13] = 221;
    entropy.bytes[14] = 238;
    entropy.bytes[15] = 255;
    entropy.bytes[16] = 0;
    entropy.bytes[17] = 17;
    entropy.bytes[18] = 34;
    entropy.bytes[19] = 51;
    entropy.bytes[20] = 68;
    entropy.bytes[21] = 85;
    entropy.bytes[22] = 102;
    entropy.bytes[23] = 119;
    entropy.bytes[24] = 136;
    entropy.bytes[25] = 153;
    entropy.bytes[26] = 170;
    entropy.bytes[27] = 187;
    entropy.bytes[28] = 204;
    entropy.bytes[29] = 221;
    entropy.bytes[30] = 238;
    entropy.bytes[31] = 255;
    drbg_init(drbg, entropy, 32, nonce, 0);
    drbg_generate(drbg, out, 32);
    let oi: u32 = 0;
    while oi < 32 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
