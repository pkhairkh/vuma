// argon2 batch 11 (vector 11)
// argon2id 'somepassword'/'minimums' t=1 m=8 p=1 dklen=32
import "/home/z/my-project/workdir/vuma/womb/crypto/hash/blake2.vuma"::{Blake2bCtx, Blake2bData, Blake2bDigest, blake2b_init_64, blake2b_update, blake2b_final};
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/argon2.vuma"::{Argon2Buf, argon2id};

transform main() -> i32 {
    let password = state_new(Argon2Buf);
    let salt = state_new(Argon2Buf);
    let out = state_new(Argon2Buf);
    password.bytes[0] = 115;
    password.bytes[1] = 111;
    password.bytes[2] = 109;
    password.bytes[3] = 101;
    password.bytes[4] = 112;
    password.bytes[5] = 97;
    password.bytes[6] = 115;
    password.bytes[7] = 115;
    password.bytes[8] = 119;
    password.bytes[9] = 111;
    password.bytes[10] = 114;
    password.bytes[11] = 100;
    salt.bytes[0] = 109;
    salt.bytes[1] = 105;
    salt.bytes[2] = 110;
    salt.bytes[3] = 105;
    salt.bytes[4] = 109;
    salt.bytes[5] = 117;
    salt.bytes[6] = 109;
    salt.bytes[7] = 115;
    argon2id(password, 12, salt, 8, 1, 8, 1, out, 32);
    let oi: u32 = 0;
    while oi < 32 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
