// Test bn256_mod_mul_mont WITHOUT ecdsa_p256 import
// Load P-256 prime directly as LE limbs
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, bn256_mod_mul_mont, bn256_set_u32, bn256_zero};

transform main() -> i32 {
    let a = state_new(Bn256Ctx);
    let b = state_new(Bn256Ctx);
    let m = state_new(Bn256Ctx);
    let r = state_new(Bn256Ctx);

    bn256_set_u32(a, 3);
    bn256_set_u32(b, 5);

    // P-256 prime LE limbs
    m.limbs[0] = ((4294967295 as u64) << 32) | (4294967295 as u64);  // 0xFFFFFFFFFFFFFFFF
    m.limbs[1] = 4294967295 as u64;  // 0x00000000FFFFFFFF
    m.limbs[2] = 0;
    m.limbs[3] = ((4294967295 as u64) << 32) | (1 as u64);  // 0xFFFFFFFF00000001

    bn256_mod_mul_mont(r, a, b, m);

    // r should be 15
    let v = r.limbs[0];
    print_int(1000 + ((v >> 56) as u32));
    print_int(1000 + (((v >> 48) & 255) as u32));
    print_int(1000 + (((v >> 40) & 255) as u32));
    print_int(1000 + (((v >> 32) & 255) as u32));
    print_int(1000 + (((v >> 24) & 255) as u32));
    print_int(1000 + (((v >> 16) & 255) as u32));
    print_int(1000 + (((v >> 8) & 255) as u32));
    print_int(1000 + ((v & 255) as u32));
    print_int(999);
    return 0;
}
