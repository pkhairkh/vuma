// drbg batch 12 (vector 12)
import "/home/z/my-project/workdir/vuma/womb/crypto/drbg/drbg.vuma"::{DrbgCtx, DrbgData, DrbgOut, drbg_init, drbg_generate};

transform main() -> i32 {
    let drbg = state_new(DrbgCtx);
    let entropy = state_new(DrbgData);
    let out = state_new(DrbgOut);
    entropy.bytes[0] = 204;
    entropy.bytes[1] = 235;
    entropy.bytes[2] = 10;
    entropy.bytes[3] = 41;
    entropy.bytes[4] = 72;
    entropy.bytes[5] = 103;
    entropy.bytes[6] = 134;
    entropy.bytes[7] = 165;
    entropy.bytes[8] = 196;
    entropy.bytes[9] = 227;
    entropy.bytes[10] = 2;
    entropy.bytes[11] = 33;
    entropy.bytes[12] = 64;
    entropy.bytes[13] = 95;
    entropy.bytes[14] = 126;
    entropy.bytes[15] = 157;
    entropy.bytes[16] = 188;
    entropy.bytes[17] = 219;
    entropy.bytes[18] = 250;
    entropy.bytes[19] = 25;
    entropy.bytes[20] = 56;
    entropy.bytes[21] = 87;
    entropy.bytes[22] = 118;
    entropy.bytes[23] = 149;
    entropy.bytes[24] = 180;
    entropy.bytes[25] = 211;
    entropy.bytes[26] = 242;
    entropy.bytes[27] = 17;
    entropy.bytes[28] = 48;
    entropy.bytes[29] = 79;
    entropy.bytes[30] = 110;
    entropy.bytes[31] = 141;
    drbg_init(drbg, entropy, 32, entropy, 0);
    drbg_generate(drbg, out, 32);
    let oi: u32 = 0;
    while oi < 32 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
