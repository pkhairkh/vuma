// hkdf batch 0 (vectors 0-1)
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hmac.vuma"::{HmacKey, HmacMsg, HmacOut};
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hkdf.vuma"::{hkdf_extract_sha256, hkdf_expand_sha256};

transform main() -> i32 {
    let salt = state_new(HmacKey);
    let ikm = state_new(HmacMsg);
    let info = state_new(HmacMsg);
    let okm = state_new(HmacMsg);
    let prk = state_new(HmacOut);
    let prk_key = state_new(HmacKey);
    let oi: u32 = 0;
    // V0: RFC5869 Case 1
    info.bytes[0] = 240;
    info.bytes[1] = 241;
    info.bytes[2] = 242;
    info.bytes[3] = 243;
    info.bytes[4] = 244;
    info.bytes[5] = 245;
    info.bytes[6] = 246;
    info.bytes[7] = 247;
    info.bytes[8] = 248;
    info.bytes[9] = 249;
    ikm.bytes[0] = 11;
    ikm.bytes[1] = 11;
    ikm.bytes[2] = 11;
    ikm.bytes[3] = 11;
    ikm.bytes[4] = 11;
    ikm.bytes[5] = 11;
    ikm.bytes[6] = 11;
    ikm.bytes[7] = 11;
    ikm.bytes[8] = 11;
    ikm.bytes[9] = 11;
    ikm.bytes[10] = 11;
    ikm.bytes[11] = 11;
    ikm.bytes[12] = 11;
    ikm.bytes[13] = 11;
    ikm.bytes[14] = 11;
    ikm.bytes[15] = 11;
    ikm.bytes[16] = 11;
    ikm.bytes[17] = 11;
    ikm.bytes[18] = 11;
    ikm.bytes[19] = 11;
    ikm.bytes[20] = 11;
    ikm.bytes[21] = 11;
    salt.bytes[0] = 0;
    salt.bytes[1] = 1;
    salt.bytes[2] = 2;
    salt.bytes[3] = 3;
    salt.bytes[4] = 4;
    salt.bytes[5] = 5;
    salt.bytes[6] = 6;
    salt.bytes[7] = 7;
    salt.bytes[8] = 8;
    salt.bytes[9] = 9;
    salt.bytes[10] = 10;
    salt.bytes[11] = 11;
    salt.bytes[12] = 12;
    hkdf_extract_sha256(salt, 13, ikm, 22, prk);
    let ci: u32 = 0;
    while ci < 32 { prk_key.bytes[ci] = prk.bytes[ci]; ci = ci + 1; }
    hkdf_expand_sha256(prk_key, info, 10, okm, 42);
    oi = 0;
    while oi < 42 {
        print_int(1000 + (okm.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    // V1: RFC5869 Case 2
    ikm.bytes[0] = 11;
    ikm.bytes[1] = 11;
    ikm.bytes[2] = 11;
    ikm.bytes[3] = 11;
    ikm.bytes[4] = 11;
    ikm.bytes[5] = 11;
    ikm.bytes[6] = 11;
    ikm.bytes[7] = 11;
    ikm.bytes[8] = 11;
    ikm.bytes[9] = 11;
    ikm.bytes[10] = 11;
    ikm.bytes[11] = 11;
    ikm.bytes[12] = 11;
    ikm.bytes[13] = 11;
    ikm.bytes[14] = 11;
    ikm.bytes[15] = 11;
    ikm.bytes[16] = 11;
    ikm.bytes[17] = 11;
    ikm.bytes[18] = 11;
    ikm.bytes[19] = 11;
    ikm.bytes[20] = 11;
    ikm.bytes[21] = 11;
    hkdf_extract_sha256(salt, 0, ikm, 22, prk);
    let ci: u32 = 0;
    while ci < 32 { prk_key.bytes[ci] = prk.bytes[ci]; ci = ci + 1; }
    hkdf_expand_sha256(prk_key, info, 0, okm, 42);
    oi = 0;
    while oi < 42 {
        print_int(1000 + (okm.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}