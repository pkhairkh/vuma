// ed25519 batch 16 (vector 16) — sign
// seed=eafb4e0cc9ef943a... msg_len=16 -> sig (64 bytes)
import "/home/z/my-project/workdir/vuma/womb/crypto/hash/sha512.vuma"::{Sha512Ctx, Sha512Data, Sha512Digest, sha512_init, sha512_update, sha512_final};
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, bn256_bitlen, bn256_cmp, bn256_get_bit, bn256_mod_add, bn256_mod_exp, bn256_mod_inv, bn256_mod_inv_fermat, bn256_mont_mul, bn256_mont_mu, bn256_mont_r2, bn256_mod_mul, bn256_mod_sub, bn256_set_u32, bn256_copy, bn256_zero, bn256_add, bn256_rshift1, bn256_sub};
import "/home/z/my-project/workdir/vuma/womb/crypto/asym/ed25519.vuma"::{B32, B64, B256, ed25519_sign};

transform main() -> i32 {
    let priv = state_new(B32);
    let msg = state_new(B256);
    let sig = state_new(B64);
    priv.bytes[0] = 234;
    priv.bytes[1] = 251;
    priv.bytes[2] = 78;
    priv.bytes[3] = 12;
    priv.bytes[4] = 201;
    priv.bytes[5] = 239;
    priv.bytes[6] = 148;
    priv.bytes[7] = 58;
    priv.bytes[8] = 121;
    priv.bytes[9] = 17;
    priv.bytes[10] = 170;
    priv.bytes[11] = 128;
    priv.bytes[12] = 205;
    priv.bytes[13] = 155;
    priv.bytes[14] = 255;
    priv.bytes[15] = 105;
    priv.bytes[16] = 50;
    priv.bytes[17] = 27;
    priv.bytes[18] = 65;
    priv.bytes[19] = 194;
    priv.bytes[20] = 10;
    priv.bytes[21] = 44;
    priv.bytes[22] = 152;
    priv.bytes[23] = 252;
    priv.bytes[24] = 80;
    priv.bytes[25] = 20;
    priv.bytes[26] = 211;
    priv.bytes[27] = 244;
    priv.bytes[28] = 7;
    priv.bytes[29] = 180;
    priv.bytes[30] = 159;
    priv.bytes[31] = 160;
    msg.bytes[0] = 112;
    msg.bytes[1] = 12;
    msg.bytes[2] = 49;
    msg.bytes[3] = 172;
    msg.bytes[4] = 255;
    msg.bytes[5] = 27;
    msg.bytes[6] = 177;
    msg.bytes[7] = 69;
    msg.bytes[8] = 109;
    msg.bytes[9] = 236;
    msg.bytes[10] = 184;
    msg.bytes[11] = 137;
    msg.bytes[12] = 59;
    msg.bytes[13] = 189;
    msg.bytes[14] = 214;
    msg.bytes[15] = 102;
    ed25519_sign(priv, msg, 16, sig);
    let oi: u32 = 0;
    while oi < 64 {
        print_int(1000 + (sig.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
