// bignum batch 7 (vector 7)
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, bn256_add};

transform main() -> i32 {
    let a = state_new(Bn256Ctx);
    let b = state_new(Bn256Ctx);
    let r = state_new(Bn256Ctx);
    a.limbs[0] = ((2294113287 as u64) << 32) | (735034881 as u64);
    a.limbs[1] = ((1051454923 as u64) << 32) | (3131575764 as u64);
    a.limbs[2] = ((1985392498 as u64) << 32) | (701808367 as u64);
    a.limbs[3] = ((1159417075 as u64) << 32) | (1629748727 as u64);
    b.limbs[0] = ((3974524834 as u64) << 32) | (4249970406 as u64);
    b.limbs[1] = ((2955633092 as u64) << 32) | (2748778024 as u64);
    b.limbs[2] = ((943239974 as u64) << 32) | (2392080953 as u64);
    b.limbs[3] = ((1392783743 as u64) << 32) | (2940395823 as u64);
    bn256_add(r, a, b);
    let oi: u32 = 0;
    while oi < 4 {
        let v = r.limbs[oi];
        print_int(1000 + ((v & 255) as u32));
        print_int(1000 + (((v >> 8) & 255) as u32));
        print_int(1000 + (((v >> 16) & 255) as u32));
        print_int(1000 + (((v >> 24) & 255) as u32));
        print_int(1000 + (((v >> 32) & 255) as u32));
        print_int(1000 + (((v >> 40) & 255) as u32));
        print_int(1000 + (((v >> 48) & 255) as u32));
        print_int(1000 + (((v >> 56) & 255) as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
