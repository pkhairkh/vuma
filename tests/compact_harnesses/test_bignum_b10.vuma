// bignum batch 10 (vector 10)
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, bn256_add};

transform main() -> i32 {
    let a = state_new(Bn256Ctx);
    let b = state_new(Bn256Ctx);
    let r = state_new(Bn256Ctx);
    a.limbs[0] = ((2314889832 as u64) << 32) | (2411057787 as u64);
    a.limbs[1] = ((3208399878 as u64) << 32) | (1128466620 as u64);
    a.limbs[2] = ((1840109255 as u64) << 32) | (2510777721 as u64);
    a.limbs[3] = ((2506254832 as u64) << 32) | (3856119925 as u64);
    b.limbs[0] = ((1554762903 as u64) << 32) | (1715412119 as u64);
    b.limbs[1] = ((4283481572 as u64) << 32) | (941975480 as u64);
    b.limbs[2] = ((594130308 as u64) << 32) | (4284391408 as u64);
    b.limbs[3] = ((2119634399 as u64) << 32) | (2188398760 as u64);
    bn256_add(r, a, b);
    let oi: u32 = 0;
    while oi < 4 {
        let v = r.limbs[oi];
        print_int(1000 + ((v & 255) as u32));
        print_int(1000 + (((v >> 8) & 255) as u32));
        print_int(1000 + (((v >> 16) & 255) as u32));
        print_int(1000 + (((v >> 24) & 255) as u32));
        print_int(1000 + (((v >> 32) & 255) as u32));
        print_int(1000 + (((v >> 40) & 255) as u32));
        print_int(1000 + (((v >> 48) & 255) as u32));
        print_int(1000 + (((v >> 56) & 255) as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
