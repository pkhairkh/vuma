// bignum batch 10 (vector 10)
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, bn256_add};

transform main() -> i32 {
    let a = state_new(Bn256Ctx);
    let b = state_new(Bn256Ctx);
    let r = state_new(Bn256Ctx);
    a.limbs[0] = 9942376124693992059;
    a.limbs[1] = 13779972549628856508;
    a.limbs[2] = 7903209073802702201;
    a.limbs[3] = 10764282542738094197;
    b.limbs[0] = 6677655823134432407;
    b.limbs[1] = 18397413265700644792;
    b.limbs[2] = 2551770246706798576;
    b.limbs[3] = 9103760425370013864;
    bn256_add(r, a, b);
    // Output 32 bytes (4 or 8 u64 limbs LE)
    let oi: u32 = 0;
    let nlimbs: u32 = 4;
    while oi < nlimbs {
        let v = r.limbs[oi];
        print_int(1000 + ((v & 255) as u32));
        print_int(1000 + (((v >> 8) & 255) as u32));
        print_int(1000 + (((v >> 16) & 255) as u32));
        print_int(1000 + (((v >> 24) & 255) as u32));
        print_int(1000 + (((v >> 32) & 255) as u32));
        print_int(1000 + (((v >> 40) & 255) as u32));
        print_int(1000 + (((v >> 48) & 255) as u32));
        print_int(1000 + (((v >> 56) & 255) as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
