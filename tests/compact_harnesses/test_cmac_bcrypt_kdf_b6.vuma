    msg.bytes[13] = 32;
    msg.bytes[14] = 60;
    aes_cmac_kdf(key, msg, 15, out);
    let oi: u32 = 0;
    while oi < 16 {
        print_int(1000 + (out.data[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
