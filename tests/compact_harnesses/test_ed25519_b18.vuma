import "/home/z/my-project/workdir/vuma/womb/crypto/asym/ed25519.vuma"::{B32, B64, B256, ed25519_sign};

transform main() -> i32 {
    let priv = state_new(B32);
    let msg = state_new(B256);
    let sig = state_new(B64);
    priv.bytes[0] = 190;
    priv.bytes[1] = 80;
    priv.bytes[2] = 229;
    priv.bytes[3] = 148;
    priv.bytes[4] = 137;
    priv.bytes[5] = 73;
    priv.bytes[6] = 202;
    priv.bytes[7] = 107;
    priv.bytes[8] = 247;
    priv.bytes[9] = 245;
    priv.bytes[10] = 156;
    priv.bytes[11] = 118;
    priv.bytes[12] = 69;
    priv.bytes[13] = 227;
    priv.bytes[14] = 117;
    priv.bytes[15] = 61;
    priv.bytes[16] = 241;
    priv.bytes[17] = 89;
    priv.bytes[18] = 36;
    priv.bytes[19] = 120;
    priv.bytes[20] = 215;
    priv.bytes[21] = 12;
    priv.bytes[22] = 224;
    priv.bytes[23] = 159;
