// scrypt batch 17 (vector 17)
// scrypt(pw=b'testpw', salt=b'testsalt', N=32, r=1, p=1, dklen=64)
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hmac.vuma"::{HmacKey, HmacMsg};
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/pbkdf2.vuma"::{pbkdf2_hmac_sha256};
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/scrypt.vuma"::{scrypt};

transform main() -> i32 {
    let pass = state_new(HmacKey);
    let salt = state_new(HmacMsg);
    let out = state_new(HmacMsg);
    pass.bytes[0] = 116;
    pass.bytes[1] = 101;
    pass.bytes[2] = 115;
    pass.bytes[3] = 116;
    pass.bytes[4] = 112;
    pass.bytes[5] = 119;
    salt.bytes[0] = 116;
    salt.bytes[1] = 101;
    salt.bytes[2] = 115;
    salt.bytes[3] = 116;
    salt.bytes[4] = 115;
    salt.bytes[5] = 97;
    salt.bytes[6] = 108;
    salt.bytes[7] = 116;
    scrypt(pass, 6, salt, 8, 32, 1, 1, out, 64);
    let oi: u32 = 0;
    while oi < 64 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
