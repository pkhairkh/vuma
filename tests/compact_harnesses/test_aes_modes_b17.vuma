// aes_modes batch 17 (vector 17)
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/aes128.vuma"::{AesCtx, AesKey, aes128_init};
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/aes_modes.vuma"::{AesModeBuf, AesIv, aes_ecb_encrypt, aes_ecb_decrypt, aes_cbc_encrypt, aes_cbc_decrypt, aes_ctr_crypt};

transform main() -> i32 {
    let ctx = state_new(AesCtx);
    let key = state_new(AesKey);
    let iv = state_new(AesIv);
    let buf = state_new(AesModeBuf);
    let out = state_new(AesModeBuf);
    key.data[0] = 43;
    key.data[1] = 126;
    key.data[2] = 21;
    key.data[3] = 22;
    key.data[4] = 40;
    key.data[5] = 174;
    key.data[6] = 210;
    key.data[7] = 166;
    key.data[8] = 171;
    key.data[9] = 247;
    key.data[10] = 21;
    key.data[11] = 136;
    key.data[12] = 9;
    key.data[13] = 207;
    key.data[14] = 79;
    key.data[15] = 60;
    iv.bytes[0] = 0;
    iv.bytes[1] = 1;
    iv.bytes[2] = 2;
    iv.bytes[3] = 3;
    iv.bytes[4] = 4;
    iv.bytes[5] = 5;
    iv.bytes[6] = 6;
    iv.bytes[7] = 7;
    iv.bytes[8] = 8;
    iv.bytes[9] = 9;
    iv.bytes[10] = 10;
    iv.bytes[11] = 11;
    iv.bytes[12] = 12;
    iv.bytes[13] = 13;
    iv.bytes[14] = 14;
    iv.bytes[15] = 15;
    buf.bytes[0] = 118;
    buf.bytes[1] = 73;
    buf.bytes[2] = 171;
    buf.bytes[3] = 172;
    buf.bytes[4] = 129;
    buf.bytes[5] = 25;
    buf.bytes[6] = 178;
    buf.bytes[7] = 70;
    buf.bytes[8] = 206;
    buf.bytes[9] = 233;
    buf.bytes[10] = 142;
    buf.bytes[11] = 155;
    buf.bytes[12] = 18;
    buf.bytes[13] = 233;
    buf.bytes[14] = 25;
    buf.bytes[15] = 125;
    aes128_init(ctx, key);
    aes_cbc_decrypt(ctx, iv, buf, out, 1);
    let oi: u32 = 0;
    while oi < 16 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
