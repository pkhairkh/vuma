    des_init(ctx, key);
    des_encrypt_block(ctx, pt, ct);
    oi = 0;
    while oi < 8 {
        print_int(1000 + (ct.data[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    // V3: DES-ECB random
    pt.data[0] = 244;
    pt.data[1] = 29;
    pt.data[2] = 146;
    pt.data[3] = 99;
    pt.data[4] = 96;
    pt.data[5] = 25;
    pt.data[6] = 222;
    pt.data[7] = 191;
    key.data[0] = 92;
    key.data[1] = 101;
    key.data[2] = 58;
    key.data[3] = 235;
    key.data[4] = 72;
