// des batch 0 (vectors 0-4)
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/des.vuma"::{DesCtx, DesKey, DesBlock, des_init, des_encrypt_block};

transform main() -> i32 {
    let ctx = state_new(DesCtx);
    let key = state_new(DesKey);
    let pt = state_new(DesBlock);
    let ct = state_new(DesBlock);
    let oi: u32 = 0;
    // V0: FIPS-81 App B
    pt.data[0] = 1;
    pt.data[1] = 35;
    pt.data[2] = 69;
    pt.data[3] = 103;
    pt.data[4] = 137;
    pt.data[5] = 171;
