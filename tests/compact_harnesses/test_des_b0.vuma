    oi = 0;
    while oi < 8 {
        print_int(1000 + (ct.data[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    // V4: DES-ECB random
    pt.data[0] = 36;
    pt.data[1] = 141;
    pt.data[2] = 66;
    pt.data[3] = 83;
    pt.data[4] = 144;
    pt.data[5] = 137;
    pt.data[6] = 142;
    pt.data[7] = 175;
    key.data[0] = 140;
    key.data[1] = 213;
    key.data[2] = 234;
    key.data[3] = 219;
    key.data[4] = 120;
