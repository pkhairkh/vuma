    key.data[3] = 153;
    key.data[4] = 188;
    key.data[5] = 214;
    key.data[6] = 47;
    key.data[7] = 0;
    des_init(ctx, key);
    des_encrypt_block(ctx, pt, ct);
    oi = 0;
    while oi < 8 {
        print_int(1000 + (ct.data[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
