    key.data[6] = 166;
    key.data[7] = 231;
    des_init(ctx, key);
    des_encrypt_block(ctx, pt, ct);
    oi = 0;
    while oi < 8 {
        print_int(1000 + (ct.data[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    // V2: DES-ECB random
    pt.data[0] = 196;
    pt.data[1] = 173;
    pt.data[2] = 226;
    pt.data[3] = 115;
    pt.data[4] = 48;
