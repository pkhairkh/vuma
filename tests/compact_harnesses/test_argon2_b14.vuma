// argon2 batch 14 (vector 14)
// argon2id 'a'*16/'b'*16 t=1 m=8 p=1 dklen=32
import "/home/z/my-project/workdir/vuma/womb/crypto/hash/blake2.vuma"::{Blake2bCtx, Blake2bData, Blake2bDigest, blake2b_init_64, blake2b_update, blake2b_final};
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/argon2.vuma"::{Argon2Buf, argon2id};

transform main() -> i32 {
    let password = state_new(Argon2Buf);
    let salt = state_new(Argon2Buf);
    let out = state_new(Argon2Buf);
    password.bytes[0] = 97;
    password.bytes[1] = 97;
    password.bytes[2] = 97;
    password.bytes[3] = 97;
    password.bytes[4] = 97;
    password.bytes[5] = 97;
    password.bytes[6] = 97;
    password.bytes[7] = 97;
    password.bytes[8] = 97;
    password.bytes[9] = 97;
    password.bytes[10] = 97;
    password.bytes[11] = 97;
    password.bytes[12] = 97;
    password.bytes[13] = 97;
    password.bytes[14] = 97;
    password.bytes[15] = 97;
    salt.bytes[0] = 98;
    salt.bytes[1] = 98;
    salt.bytes[2] = 98;
    salt.bytes[3] = 98;
    salt.bytes[4] = 98;
    salt.bytes[5] = 98;
    salt.bytes[6] = 98;
    salt.bytes[7] = 98;
    salt.bytes[8] = 98;
    salt.bytes[9] = 98;
    salt.bytes[10] = 98;
    salt.bytes[11] = 98;
    salt.bytes[12] = 98;
    salt.bytes[13] = 98;
    salt.bytes[14] = 98;
    salt.bytes[15] = 98;
    argon2id(password, 16, salt, 16, 1, 8, 1, out, 32);
    let oi: u32 = 0;
    while oi < 32 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
