import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, bn256_bitlen, bn256_cmp, bn256_get_bit, bn256_mod_add, bn256_mod_exp, bn256_mod_inv, bn256_mod_mul, bn256_mod_sub, bn256_set_u32, bn256_copy, bn256_zero, bn256_add, bn256_rshift1, bn256_sub};
import "/home/z/my-project/workdir/vuma/womb/crypto/asym/ed25519.vuma"::{B32, ed25519_keygen};

transform main() -> i32 {
    let priv = state_new(B32);
    let pub_out = state_new(B32);
    priv.bytes[0] = 104;
    priv.bytes[1] = 124;
    priv.bytes[2] = 63;
    priv.bytes[3] = 252;
    priv.bytes[4] = 91;
    priv.bytes[5] = 84;
    priv.bytes[6] = 147;
    priv.bytes[7] = 73;
    priv.bytes[8] = 245;
    priv.bytes[9] = 149;
    priv.bytes[10] = 246;
    priv.bytes[11] = 79;
    priv.bytes[12] = 12;
    priv.bytes[13] = 162;
    priv.bytes[14] = 150;
    priv.bytes[15] = 230;
    priv.bytes[16] = 142;
    priv.bytes[17] = 149;
    priv.bytes[18] = 185;
    priv.bytes[19] = 19;
    priv.bytes[20] = 116;
    priv.bytes[21] = 142;
    priv.bytes[22] = 165;
    priv.bytes[23] = 173;
    priv.bytes[24] = 107;
    priv.bytes[25] = 53;
    priv.bytes[26] = 73;
    priv.bytes[27] = 221;
    priv.bytes[28] = 64;
    priv.bytes[29] = 66;
    priv.bytes[30] = 250;
    priv.bytes[31] = 181;
    ed25519_keygen(priv, pub_out);
