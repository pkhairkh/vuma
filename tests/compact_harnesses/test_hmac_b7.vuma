// hmac batch 7 (vectors 35-36)
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hmac.vuma"::{HmacKey, HmacMsg, HmacOut, hmac_sha256};

transform main() -> i32 {
    let key = state_new(HmacKey);
    let msg = state_new(HmacMsg);
    let out = state_new(HmacOut);
    let oi: u32 = 0;
    // V35: 16B key+64B msg
    msg.bytes[0] = 2;
    msg.bytes[1] = 2;
    msg.bytes[2] = 2;
    msg.bytes[3] = 2;
    msg.bytes[4] = 2;
    msg.bytes[5] = 2;
    msg.bytes[6] = 2;
    msg.bytes[7] = 2;
    msg.bytes[8] = 2;
    msg.bytes[9] = 2;
    msg.bytes[10] = 2;
    msg.bytes[11] = 2;
    msg.bytes[12] = 2;
    msg.bytes[13] = 2;
    msg.bytes[14] = 2;
    msg.bytes[15] = 2;
    msg.bytes[16] = 2;
    msg.bytes[17] = 2;
    msg.bytes[18] = 2;
    msg.bytes[19] = 2;
    msg.bytes[20] = 2;
    msg.bytes[21] = 2;
    msg.bytes[22] = 2;
    msg.bytes[23] = 2;
    msg.bytes[24] = 2;
    msg.bytes[25] = 2;
    msg.bytes[26] = 2;
    msg.bytes[27] = 2;
    msg.bytes[28] = 2;
    msg.bytes[29] = 2;
    msg.bytes[30] = 2;
    msg.bytes[31] = 2;
    msg.bytes[32] = 2;
    msg.bytes[33] = 2;
    msg.bytes[34] = 2;
    msg.bytes[35] = 2;
    msg.bytes[36] = 2;
    msg.bytes[37] = 2;
    msg.bytes[38] = 2;
    msg.bytes[39] = 2;
    msg.bytes[40] = 2;
    msg.bytes[41] = 2;
    msg.bytes[42] = 2;
    msg.bytes[43] = 2;
    msg.bytes[44] = 2;
    msg.bytes[45] = 2;
    msg.bytes[46] = 2;
    msg.bytes[47] = 2;
    msg.bytes[48] = 2;
    msg.bytes[49] = 2;
    msg.bytes[50] = 2;
    msg.bytes[51] = 2;
    msg.bytes[52] = 2;
    msg.bytes[53] = 2;
    msg.bytes[54] = 2;
    msg.bytes[55] = 2;
    msg.bytes[56] = 2;
    msg.bytes[57] = 2;
    msg.bytes[58] = 2;
    msg.bytes[59] = 2;
    msg.bytes[60] = 2;
    msg.bytes[61] = 2;
    msg.bytes[62] = 2;
    msg.bytes[63] = 2;
    key.bytes[0] = 1;
    key.bytes[1] = 1;
    key.bytes[2] = 1;
    key.bytes[3] = 1;
    key.bytes[4] = 1;
    key.bytes[5] = 1;
    key.bytes[6] = 1;
    key.bytes[7] = 1;
    key.bytes[8] = 1;
    key.bytes[9] = 1;
    key.bytes[10] = 1;
    key.bytes[11] = 1;
    key.bytes[12] = 1;
    key.bytes[13] = 1;
    key.bytes[14] = 1;
    key.bytes[15] = 1;
    hmac_sha256(key, 16, msg, 64, out);
    oi = 0;
    while oi < 32 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    // V36: text
    msg.bytes[0] = 116;
    msg.bytes[1] = 101;
    msg.bytes[2] = 115;
    msg.bytes[3] = 116;
    msg.bytes[4] = 32;
    msg.bytes[5] = 109;
    msg.bytes[6] = 101;
    msg.bytes[7] = 115;
    msg.bytes[8] = 115;
    msg.bytes[9] = 97;
    msg.bytes[10] = 103;
    msg.bytes[11] = 101;
    key.bytes[0] = 116;
    key.bytes[1] = 101;
    key.bytes[2] = 115;
    key.bytes[3] = 116;
    key.bytes[4] = 32;
    key.bytes[5] = 107;
    key.bytes[6] = 101;
    key.bytes[7] = 121;
    hmac_sha256(key, 8, msg, 12, out);
    oi = 0;
    while oi < 32 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}