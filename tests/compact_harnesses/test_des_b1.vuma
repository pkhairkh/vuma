    key.data[3] = 203;
    key.data[4] = 168;
    key.data[5] = 193;
    key.data[6] = 102;
    key.data[7] = 167;
    des_init(ctx, key);
    des_encrypt_block(ctx, pt, ct);
    oi = 0;
    while oi < 8 {
        print_int(1000 + (ct.data[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
