    oi = 0;
    while oi < 8 {
        print_int(1000 + (ct.data[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    // V8: DES-ECB random
    pt.data[0] = 228;
    pt.data[1] = 77;
    pt.data[2] = 2;
    pt.data[3] = 19;
    pt.data[4] = 80;
    pt.data[5] = 73;
    pt.data[6] = 78;
    pt.data[7] = 111;
    key.data[0] = 76;
    key.data[1] = 149;
    key.data[2] = 170;
    key.data[3] = 155;
