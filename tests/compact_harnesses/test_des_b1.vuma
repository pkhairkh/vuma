    des_encrypt_block(ctx, pt, ct);
    oi = 0;
    while oi < 8 {
        print_int(1000 + (ct.data[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    // V7: DES-ECB random
    pt.data[0] = 180;
