// pbkdf2 batch 7 (vectors 35-36)
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hmac.vuma"::{HmacKey, HmacMsg, HmacOut};
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/pbkdf2.vuma"::{pbkdf2_hmac_sha256};

transform main() -> i32 {
    let pass = state_new(HmacKey);
    let salt = state_new(HmacMsg);
    let out = state_new(HmacMsg);
    let oi: u32 = 0;
    // V35: PBKDF2-sha256(iters=2,dklen=32)
    salt.bytes[0] = 115;
    salt.bytes[1] = 97;
    salt.bytes[2] = 108;
    salt.bytes[3] = 116;
    salt.bytes[4] = 49;
    salt.bytes[5] = 50;
    salt.bytes[6] = 51;
    pass.bytes[0] = 116;
    pass.bytes[1] = 101;
    pass.bytes[2] = 115;
    pass.bytes[3] = 116;
    pass.bytes[4] = 49;
    pass.bytes[5] = 50;
    pass.bytes[6] = 51;
    pbkdf2_hmac_sha256(pass, 7, salt, 7, 2, out, 32);
    oi = 0;
    while oi < 32 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    // V36: PBKDF2-sha256(iters=3,dklen=48)
    salt.bytes[0] = 83;
    salt.bytes[1] = 64;
    salt.bytes[2] = 108;
    salt.bytes[3] = 116;
    pass.bytes[0] = 80;
    pass.bytes[1] = 64;
    pass.bytes[2] = 115;
    pass.bytes[3] = 115;
    pass.bytes[4] = 119;
    pass.bytes[5] = 48;
    pass.bytes[6] = 114;
    pass.bytes[7] = 100;
    pbkdf2_hmac_sha256(pass, 8, salt, 4, 3, out, 48);
    oi = 0;
    while oi < 48 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}