import "/home/z/my-project/workdir/vuma/womb/crypto/asym/ed25519.vuma"::{B32, B64, B256, ed25519_sign};

transform main() -> i32 {
    let priv = state_new(B32);
    let msg = state_new(B256);
    let sig = state_new(B64);
    priv.bytes[0] = 16;
    priv.bytes[1] = 29;
    priv.bytes[2] = 114;
    priv.bytes[3] = 73;
    priv.bytes[4] = 47;
    priv.bytes[5] = 101;
    priv.bytes[6] = 40;
    priv.bytes[7] = 250;
    priv.bytes[8] = 88;
    priv.bytes[9] = 203;
    priv.bytes[10] = 184;
    priv.bytes[11] = 135;
    priv.bytes[12] = 239;
    priv.bytes[13] = 171;
    priv.bytes[14] = 9;
    priv.bytes[15] = 199;
    priv.bytes[16] = 164;
    priv.bytes[17] = 22;
    priv.bytes[18] = 27;
    priv.bytes[19] = 38;
    priv.bytes[20] = 133;
    priv.bytes[21] = 230;
    priv.bytes[22] = 111;
    priv.bytes[23] = 18;
    priv.bytes[24] = 197;
