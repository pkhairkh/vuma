// des_rc4_aria_camellia batch 1 (vector 1)
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/des_rc4_aria_camellia.vuma"::{DesWord, des_encrypt_block};

transform main() -> i32 {
    let buf = state_new(DesWord);
    let out = state_new(DesWord);
    let key = state_new(DesWord);
    key.bytes[0] = 0;
    key.bytes[1] = 73;
    key.bytes[2] = 146;
    key.bytes[3] = 219;
    key.bytes[4] = 36;
    key.bytes[5] = 109;
    key.bytes[6] = 182;
    key.bytes[7] = 255;
    buf.bytes[0] = 0;
    buf.bytes[1] = 97;
    buf.bytes[2] = 194;
    buf.bytes[3] = 35;
    buf.bytes[4] = 132;
    buf.bytes[5] = 229;
    buf.bytes[6] = 70;
    buf.bytes[7] = 167;
    des_encrypt_block(buf, key, out);
    let oi: u32 = 0;
    while oi < 8 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
