import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/des_rc4_aria_camellia.vuma"::{DesWord, tdes_ede3_encrypt_block};

transform main() -> i32 {
    let buf = state_new(DesWord);
    let out = state_new(DesWord);
    let k1 = state_new(DesWord);
    let k2 = state_new(DesWord);
    let k3 = state_new(DesWord);
    k1.bytes[0] = 0;
    k1.bytes[1] = 3;
    k1.bytes[2] = 6;
    k1.bytes[3] = 9;
    k1.bytes[4] = 12;
    k1.bytes[5] = 15;
    k1.bytes[6] = 18;
    k1.bytes[7] = 21;
    k2.bytes[0] = 13;
    k2.bytes[1] = 18;
    k2.bytes[2] = 23;
    k2.bytes[3] = 28;
    k2.bytes[4] = 33;
    k2.bytes[5] = 38;
    k2.bytes[6] = 43;
    k2.bytes[7] = 48;
    k3.bytes[0] = 29;
    k3.bytes[1] = 36;
    k3.bytes[2] = 43;
    k3.bytes[3] = 50;
    k3.bytes[4] = 57;
    k3.bytes[5] = 64;
    k3.bytes[6] = 71;
    k3.bytes[7] = 78;
    buf.bytes[0] = 47;
    buf.bytes[1] = 58;
    buf.bytes[2] = 69;
    buf.bytes[3] = 80;
    buf.bytes[4] = 91;
    buf.bytes[5] = 102;
    buf.bytes[6] = 113;
    buf.bytes[7] = 124;
    tdes_ede3_encrypt_block(buf, k1, k2, k3, out);
    let oi: u32 = 0;
    while oi < 8 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
