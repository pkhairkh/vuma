// drbg batch 7 (vector 7)
import "/home/z/my-project/workdir/vuma/womb/crypto/drbg/drbg.vuma"::{DrbgCtx, DrbgData, DrbgOut, drbg_init, drbg_generate};

transform main() -> i32 {
    let drbg = state_new(DrbgCtx);
    let entropy = state_new(DrbgData);
    let out = state_new(DrbgOut);
    entropy.bytes[0] = 119;
    entropy.bytes[1] = 150;
    entropy.bytes[2] = 181;
    entropy.bytes[3] = 212;
    entropy.bytes[4] = 243;
    entropy.bytes[5] = 18;
    entropy.bytes[6] = 49;
    entropy.bytes[7] = 80;
    entropy.bytes[8] = 111;
    entropy.bytes[9] = 142;
    entropy.bytes[10] = 173;
    entropy.bytes[11] = 204;
    entropy.bytes[12] = 235;
    entropy.bytes[13] = 10;
    entropy.bytes[14] = 41;
    entropy.bytes[15] = 72;
    entropy.bytes[16] = 103;
    entropy.bytes[17] = 134;
    entropy.bytes[18] = 165;
    entropy.bytes[19] = 196;
    entropy.bytes[20] = 227;
    entropy.bytes[21] = 2;
    entropy.bytes[22] = 33;
    entropy.bytes[23] = 64;
    entropy.bytes[24] = 95;
    entropy.bytes[25] = 126;
    entropy.bytes[26] = 157;
    entropy.bytes[27] = 188;
    entropy.bytes[28] = 219;
    entropy.bytes[29] = 250;
    entropy.bytes[30] = 25;
    entropy.bytes[31] = 56;
    drbg_init(drbg, entropy, 32, entropy, 0);
    drbg_generate(drbg, out, 32);
    let oi: u32 = 0;
    while oi < 32 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
