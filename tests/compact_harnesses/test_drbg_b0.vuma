// drbg batch 0 (vector 0)
import "/home/z/my-project/workdir/vuma/womb/crypto/drbg/drbg.vuma"::{DrbgCtx, DrbgData, DrbgOut, drbg_init, drbg_generate};

transform main() -> i32 {
    let drbg = state_new(DrbgCtx);
    let entropy = state_new(DrbgData);
    let out = state_new(DrbgOut);
    entropy.bytes[0] = 0;
    entropy.bytes[1] = 31;
    entropy.bytes[2] = 62;
    entropy.bytes[3] = 93;
    entropy.bytes[4] = 124;
    entropy.bytes[5] = 155;
    entropy.bytes[6] = 186;
    entropy.bytes[7] = 217;
    entropy.bytes[8] = 248;
    entropy.bytes[9] = 23;
    entropy.bytes[10] = 54;
    entropy.bytes[11] = 85;
    entropy.bytes[12] = 116;
    entropy.bytes[13] = 147;
    entropy.bytes[14] = 178;
    entropy.bytes[15] = 209;
    entropy.bytes[16] = 240;
    entropy.bytes[17] = 15;
    entropy.bytes[18] = 46;
    entropy.bytes[19] = 77;
    entropy.bytes[20] = 108;
    entropy.bytes[21] = 139;
    entropy.bytes[22] = 170;
    entropy.bytes[23] = 201;
    entropy.bytes[24] = 232;
    entropy.bytes[25] = 7;
    entropy.bytes[26] = 38;
    entropy.bytes[27] = 69;
    entropy.bytes[28] = 100;
    entropy.bytes[29] = 131;
    entropy.bytes[30] = 162;
    entropy.bytes[31] = 193;
    drbg_init(drbg, entropy, 32, entropy, 0);
    drbg_generate(drbg, out, 32);
    let oi: u32 = 0;
    while oi < 32 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
