// blake2 batch 0 (vectors 0-2)
import "/home/z/my-project/workdir/vuma/womb/crypto/hash/blake2.vuma"::{Blake2bData, Blake2bDigest, blake2b_oneshot};

transform main() -> i32 {
    let data = state_new(Blake2bData);
    let out = state_new(Blake2bDigest);
    let oi: u32 = 0;
    // V0: blake2b(empty)
    blake2b_oneshot(data, 0, out);
    oi = 0;
    while oi < 64 {
        print_int(1000 + (out.data[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    // V1: blake2b(NIST abc)
    data.data[0] = 97;
    data.data[1] = 98;
    data.data[2] = 99;
    blake2b_oneshot(data, 3, out);
    oi = 0;
    while oi < 64 {
        print_int(1000 + (out.data[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    // V2: blake2b(single byte)
    data.data[0] = 97;
    blake2b_oneshot(data, 1, out);
    oi = 0;
    while oi < 64 {
        print_int(1000 + (out.data[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}