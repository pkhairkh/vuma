// bignum batch 22 (vector 22)
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, bn256_sub};

transform main() -> i32 {
    let a = state_new(Bn256Ctx);
    let b = state_new(Bn256Ctx);
    let r = state_new(Bn256Ctx);
    a.limbs[0] = 9947110392639011130;
    a.limbs[1] = 13343499577104216175;
    a.limbs[2] = 16277094700513352822;
    a.limbs[3] = 10629228785065517402;
    b.limbs[0] = 4482507869643667449;
    b.limbs[1] = 8724810724676522399;
    b.limbs[2] = 7508930986792984477;
    b.limbs[3] = 1740003900829643871;
    bn256_sub(r, a, b);
    // Output 32 bytes (4 or 8 u64 limbs LE)
    let oi: u32 = 0;
    let nlimbs: u32 = 4;
    while oi < nlimbs {
        let v = r.limbs[oi];
        print_int(1000 + ((v & 255) as u32));
        print_int(1000 + (((v >> 8) & 255) as u32));
        print_int(1000 + (((v >> 16) & 255) as u32));
        print_int(1000 + (((v >> 24) & 255) as u32));
        print_int(1000 + (((v >> 32) & 255) as u32));
        print_int(1000 + (((v >> 40) & 255) as u32));
        print_int(1000 + (((v >> 48) & 255) as u32));
        print_int(1000 + (((v >> 56) & 255) as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
