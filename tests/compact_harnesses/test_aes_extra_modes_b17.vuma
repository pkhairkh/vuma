// aes_extra_modes batch 17 (vector 17)
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/aes128.vuma"::{AesCtx, AesKey, aes128_init};
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/aes_extra_modes.vuma"::{AesXBuf, AesXBlock, aes_cmac};

transform main() -> i32 {
    let key = state_new(AesKey);
    let msg = state_new(AesXBuf);
    let out = state_new(AesXBuf);
    key.data[0] = 221;
    key.data[1] = 252;
    key.data[2] = 27;
    key.data[3] = 58;
    key.data[4] = 89;
    key.data[5] = 120;
    key.data[6] = 151;
    key.data[7] = 182;
    key.data[8] = 213;
    key.data[9] = 244;
    key.data[10] = 19;
    key.data[11] = 50;
    key.data[12] = 81;
    key.data[13] = 112;
    key.data[14] = 143;
    key.data[15] = 174;
    msg.bytes[0] = 43;
    msg.bytes[1] = 86;
    msg.bytes[2] = 129;
    msg.bytes[3] = 172;
    msg.bytes[4] = 215;
    msg.bytes[5] = 2;
    msg.bytes[6] = 45;
    msg.bytes[7] = 88;
    msg.bytes[8] = 131;
    msg.bytes[9] = 174;
    msg.bytes[10] = 217;
    msg.bytes[11] = 4;
    msg.bytes[12] = 47;
    msg.bytes[13] = 90;
    msg.bytes[14] = 133;
    msg.bytes[15] = 176;
    msg.bytes[16] = 219;
    aes_cmac(key, msg, 17, out);
    let oi: u32 = 0;
    while oi < 16 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
