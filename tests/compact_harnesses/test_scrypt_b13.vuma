// scrypt batch 13 (vector 13)
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hmac.vuma"::{HmacKey, HmacMsg};
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/scrypt.vuma"::{scrypt};

transform main() -> i32 {
    let pass = state_new(HmacKey);
    let salt = state_new(HmacMsg);
    let out = state_new(HmacMsg);
    pass.bytes[0] = 104;
    pass.bytes[1] = 101;
    pass.bytes[2] = 108;
    pass.bytes[3] = 108;
    pass.bytes[4] = 111;
    salt.bytes[0] = 119;
    salt.bytes[1] = 111;
    salt.bytes[2] = 114;
    salt.bytes[3] = 108;
    salt.bytes[4] = 100;
    scrypt(pass, 5, salt, 5, 32, 1, 1, out, 32);
    let oi: u32 = 0;
    while oi < 32 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
