import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, bn256_mod_add, bn256_mod_inv, bn256_mod_inv_fermat, bn256_mod_mul, bn256_mod_sub, bn256_mod_exp, bn256_set_u32, bn256_copy, bn256_zero, bn256_add, bn256_sub, bn256_cmp, bn256_is_zero, bn256_bitlen, bn256_get_bit, bn256_mont_mul, bn256_mont_mu, bn256_mont_r2, bn256_rshift1, bn256_lshift1, bn_mul_u64};
import "/home/z/my-project/workdir/vuma/womb/crypto/hash/sha256_sha224.vuma"::{Sha256Ctx, Sha256Data, Sha256Digest, sha256_init, sha256_update, sha256_final};
import "/home/z/my-project/workdir/vuma/womb/crypto/mac_kdf/hmac.vuma"::{HmacKey, HmacMsg, HmacOut, HmacBuf, hmac_sha256, hmac_sha256_hash};
import "/home/z/my-project/workdir/vuma/womb/crypto/asym/secp256k1.vuma"::{B32, B256, secp256k1_sign, secp256k1_p, secp256k1_n, secp256k1_gx, secp256k1_gy, be32_to_bn256, b32_to_bn256, swap_endian_32, secp256k1_sha256_hash, rfc6979_secp256k1_k, secp256k1_scalar_mul_bn, bn256_to_be32};

transform print_be32(label: u32, b: State<B32>) {
    print_int(label);
    let i: u32 = 0;
    while i < 32 { print_int(1000 + (b.bytes[i] as u32)); i = i + 1; }
    print_int(999);
}

transform main() -> i32 {
    let msg = state_new(B256);
    let privkey = state_new(B32);
    msg.bytes[0] = 101; msg.bytes[1] = 99; msg.bytes[2] = 100; msg.bytes[3] = 115; msg.bytes[4] = 97; msg.bytes[5] = 32; msg.bytes[6] = 116; msg.bytes[7] = 101; msg.bytes[8] = 115; msg.bytes[9] = 116; msg.bytes[10] = 32; msg.bytes[11] = 48; 
    privkey.bytes[0] = 230; privkey.bytes[1] = 253; privkey.bytes[2] = 203; privkey.bytes[3] = 79; privkey.bytes[4] = 168; privkey.bytes[5] = 195; privkey.bytes[6] = 246; privkey.bytes[7] = 65; privkey.bytes[8] = 214; privkey.bytes[9] = 118; privkey.bytes[10] = 71; privkey.bytes[11] = 85; privkey.bytes[12] = 40; privkey.bytes[13] = 46; privkey.bytes[14] = 233; privkey.bytes[15] = 223; privkey.bytes[16] = 85; privkey.bytes[17] = 129; privkey.bytes[18] = 7; privkey.bytes[19] = 50; privkey.bytes[20] = 163; privkey.bytes[21] = 105; privkey.bytes[22] = 165; privkey.bytes[23] = 141; privkey.bytes[24] = 220; privkey.bytes[25] = 100; privkey.bytes[26] = 59; privkey.bytes[27] = 190; privkey.bytes[28] = 26; privkey.bytes[29] = 54; privkey.bytes[30] = 104; privkey.bytes[31] = 15; 

    // Step 1: h = SHA-256(msg)
    let h_be = state_new(B32);
    secp256k1_sha256_hash(msg, 12, h_be);
    print_be32(1001, h_be);

    // Step 2: k = rfc6979
    let n_be = state_new(B32);
    secp256k1_n(n_be);
    let n_le = state_new(B32);
    swap_endian_32(n_le, n_be);
    let k_le = state_new(B32);
    rfc6979_secp256k1_k(privkey, h_be, n_le, k_le);
    let k_be = state_new(B32);
    swap_endian_32(k_be, k_le);
    print_be32(1002, k_be);

    // Step 3: k*G
    let k_bn = state_new(Bn256Ctx);
    b32_to_bn256(k_bn, k_le);
    let p_be = state_new(B32);
    let gx_be = state_new(B32);
    let gy_be = state_new(B32);
    secp256k1_p(p_be);
    secp256k1_gx(gx_be);
    secp256k1_gy(gy_be);
    let p_bn = state_new(Bn256Ctx);
    let gx_bn = state_new(Bn256Ctx);
    let gy_bn = state_new(Bn256Ctx);
    let n_bn = state_new(Bn256Ctx);
    be32_to_bn256(p_bn, p_be);
    be32_to_bn256(gx_bn, gx_be);
    be32_to_bn256(gy_bn, gy_be);
    be32_to_bn256(n_bn, n_be);
    let rx = state_new(Bn256Ctx);
    let ry = state_new(Bn256Ctx);
    secp256k1_scalar_mul_bn(rx, ry, k_bn, gx_bn, gy_bn, p_bn);
    let rx_be = state_new(B32);
    let ry_be = state_new(B32);
    bn256_to_be32(rx_be, rx);
    bn256_to_be32(ry_be, ry);
    print_be32(1003, rx_be);

    // Step 4: r = rx mod n
    let r_bn = state_new(Bn256Ctx);
    bn256_copy(r_bn, rx);
    if bn256_cmp(r_bn, n_bn) != 2 { bn256_sub(r_bn, r_bn, n_bn); }
    let r_be = state_new(B32);
    bn256_to_be32(r_be, r_bn);
    print_be32(1005, r_be);

    // Step 5: s = k^(-1) * (h + r*d) mod n
    let h_bn = state_new(Bn256Ctx);
    let d_bn = state_new(Bn256Ctx);
    be32_to_bn256(h_bn, h_be);
    be32_to_bn256(d_bn, privkey);
    if bn256_cmp(d_bn, n_bn) != 2 { bn256_sub(d_bn, d_bn, n_bn); }
    if bn256_cmp(h_bn, n_bn) != 2 { bn256_sub(h_bn, h_bn, n_bn); }
    let k_inv = state_new(Bn256Ctx);
    let rd = state_new(Bn256Ctx);
    let h_rd = state_new(Bn256Ctx);
    let s_bn = state_new(Bn256Ctx);
    bn256_mod_inv_fermat(k_inv, k_bn, n_bn);
    bn256_mod_mul(rd, r_bn, d_bn, n_bn);
    bn256_mod_add(h_rd, h_bn, rd, n_bn);
    bn256_mod_mul(s_bn, k_inv, h_rd, n_bn);
    let s_be = state_new(B32);
    bn256_to_be32(s_be, s_bn);
    print_be32(1006, s_be);

    return 0;
}
