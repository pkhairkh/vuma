// bignum batch 27 (vector 27)
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, Bn512Ctx, bn256_mul_512};

transform main() -> i32 {
    let a = state_new(Bn256Ctx);
    let b = state_new(Bn256Ctx);
    let r = state_new(Bn512Ctx);
    a.limbs[0] = 13433169699312644154;
    a.limbs[1] = 14768325111238658311;
    a.limbs[2] = 2015657872592376414;
    a.limbs[3] = 3534213002786500868;
    b.limbs[0] = 9892726009100339183;
    b.limbs[1] = 2585906988015179389;
    b.limbs[2] = 3384756894773047137;
    b.limbs[3] = 8533981636164762649;
    bn256_mul_512(r, a, b);
    // Output 64 bytes (4 or 8 u64 limbs LE)
    let oi: u32 = 0;
    let nlimbs: u32 = 8;
    while oi < nlimbs {
        let v = r.limbs[oi];
        print_int(1000 + ((v & 255) as u32));
        print_int(1000 + (((v >> 8) & 255) as u32));
        print_int(1000 + (((v >> 16) & 255) as u32));
        print_int(1000 + (((v >> 24) & 255) as u32));
        print_int(1000 + (((v >> 32) & 255) as u32));
        print_int(1000 + (((v >> 40) & 255) as u32));
        print_int(1000 + (((v >> 48) & 255) as u32));
        print_int(1000 + (((v >> 56) & 255) as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
