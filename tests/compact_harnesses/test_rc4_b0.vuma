// rc4 batch 0 (vectors 0-4)
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/rc4.vuma"::{Rc4Ctx, Rc4Key, Rc4Buf, rc4_init, rc4_crypt};

transform main() -> i32 {
    let ctx = state_new(Rc4Ctx);
    let key = state_new(Rc4Key);
    let data = state_new(Rc4Buf);
    let oi: u32 = 0;
    // V0: Known RC4 vector
    data.bytes[0] = 0;
    data.bytes[1] = 0;
    data.bytes[2] = 0;
    data.bytes[3] = 0;
    data.bytes[4] = 0;
    data.bytes[5] = 0;
    data.bytes[6] = 0;
    data.bytes[7] = 0;
    key.bytes[0] = 1;
    key.bytes[1] = 2;
    key.bytes[2] = 3;
    key.bytes[3] = 4;
    key.bytes[4] = 5;
    rc4_init(ctx, key, 5);
    rc4_crypt(ctx, data, 8);
    oi = 0;
    while oi < 8 {
        print_int(1000 + (data.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    // V1: Known RC4 vector
    data.bytes[0] = 0;
