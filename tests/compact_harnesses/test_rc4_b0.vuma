    key.bytes[29] = 30;
    key.bytes[30] = 31;
    rc4_init(ctx, key, 31);
    rc4_crypt(ctx, data, 16);
    oi = 0;
    while oi < 16 {
        print_int(1000 + (data.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    // V2: Known RC4 vector
    data.bytes[0] = 0;
    data.bytes[1] = 0;
    data.bytes[2] = 0;
    data.bytes[3] = 0;
    data.bytes[4] = 0;
    data.bytes[5] = 0;
    data.bytes[6] = 0;
    data.bytes[7] = 0;
    key.bytes[0] = 235;
    rc4_init(ctx, key, 1);
    rc4_crypt(ctx, data, 8);
    oi = 0;
    while oi < 8 {
        print_int(1000 + (data.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    // V3: Known RC4 vector
    data.bytes[0] = 0;
