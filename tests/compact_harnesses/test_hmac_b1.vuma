    key.bytes[15] = 170;
    key.bytes[16] = 170;
    key.bytes[17] = 170;
    key.bytes[18] = 170;
    key.bytes[19] = 170;
    hmac_sha256(key, 20, msg, 50, out);
    oi = 0;
    while oi < 32 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    // V6: RFC4231 Case 4 (25-byte key)
    msg.bytes[0] = 205;
    msg.bytes[1] = 205;
    msg.bytes[2] = 205;
    msg.bytes[3] = 205;
    msg.bytes[4] = 205;
    msg.bytes[5] = 205;
