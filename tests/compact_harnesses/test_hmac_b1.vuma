    msg.bytes[44] = 221;
    msg.bytes[45] = 221;
    msg.bytes[46] = 221;
    msg.bytes[47] = 221;
    msg.bytes[48] = 221;
    msg.bytes[49] = 221;
    key.bytes[0] = 170;
    key.bytes[1] = 170;
    key.bytes[2] = 170;
    key.bytes[3] = 170;
    key.bytes[4] = 170;
    key.bytes[5] = 170;
    key.bytes[6] = 170;
    key.bytes[7] = 170;
