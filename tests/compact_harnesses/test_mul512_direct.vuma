// Direct test of bn256_mul_512: compute Gx * Gx and output 512-bit result
import "/home/z/my-project/workdir/vuma/womb/crypto/bignum/bignum.vuma"::{Bn256Ctx, Bn512Ctx, bn256_mul_512, bn256_zero, bn256_set_u32};
import "/home/z/my-project/workdir/vuma/womb/crypto/asym/ecdsa_p256.vuma"::{B32, p256_gx, be32_to_bn256};

transform main() -> i32 {
    let gx_be = state_new(B32);
    let gx_bn = state_new(Bn256Ctx);
    let prod = state_new(Bn512Ctx);
    p256_gx(gx_be);
    be32_to_bn256(gx_bn, gx_be);

    // prod = gx_bn * gx_bn (512-bit result, no mod)
    bn256_mul_512(prod, gx_bn, gx_bn);

    // Output all 8 limbs of prod
    let oi: u32 = 0;
    while oi < 8 {
        let v = prod.limbs[oi];
        print_int(1000 + (((v >> 56) & 255) as u32));
        print_int(1000 + (((v >> 48) & 255) as u32));
        print_int(1000 + (((v >> 40) & 255) as u32));
        print_int(1000 + (((v >> 32) & 255) as u32));
        print_int(1000 + (((v >> 24) & 255) as u32));
        print_int(1000 + (((v >> 16) & 255) as u32));
        print_int(1000 + (((v >> 8) & 255) as u32));
        print_int(1000 + ((v & 255) as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
