// des_rc4_aria_camellia batch 6 (vector 6)
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/des_rc4_aria_camellia.vuma"::{Rc4Buf, Rc4Sbox, rc4_crypt};

transform main() -> i32 {
    let buf = state_new(Rc4Buf);
    let out = state_new(Rc4Buf);
    let key = state_new(Rc4Buf);
    key.bytes[0] = 41;
    key.bytes[1] = 108;
    key.bytes[2] = 175;
    key.bytes[3] = 242;
    key.bytes[4] = 53;
    key.bytes[5] = 120;
    key.bytes[6] = 187;
    key.bytes[7] = 254;
    buf.bytes[0] = 43;
    buf.bytes[1] = 132;
    buf.bytes[2] = 221;
    buf.bytes[3] = 54;
    buf.bytes[4] = 143;
    buf.bytes[5] = 232;
    buf.bytes[6] = 65;
    buf.bytes[7] = 154;
    buf.bytes[8] = 243;
    buf.bytes[9] = 76;
    buf.bytes[10] = 165;
    buf.bytes[11] = 254;
    rc4_crypt(key, 8, buf, 12, out);
    let oi: u32 = 0;
    while oi < 12 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
