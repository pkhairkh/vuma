// aes_extra_modes batch 13 (vector 13)
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/aes128.vuma"::{AesCtx, AesKey, aes128_init};
import "/home/z/my-project/workdir/vuma/womb/crypto/symmetric/aes_extra_modes.vuma"::{AesXBuf, AesXBlock, aes_cmac};

transform main() -> i32 {
    let key = state_new(AesKey);
    let msg = state_new(AesXBuf);
    let out = state_new(AesXBuf);
    key.data[0] = 153;
    key.data[1] = 184;
    key.data[2] = 215;
    key.data[3] = 246;
    key.data[4] = 21;
    key.data[5] = 52;
    key.data[6] = 83;
    key.data[7] = 114;
    key.data[8] = 145;
    key.data[9] = 176;
    key.data[10] = 207;
    key.data[11] = 238;
    key.data[12] = 13;
    key.data[13] = 44;
    key.data[14] = 75;
    key.data[15] = 106;
    msg.bytes[0] = 207;
    msg.bytes[1] = 250;
    msg.bytes[2] = 37;
    msg.bytes[3] = 80;
    msg.bytes[4] = 123;
    msg.bytes[5] = 166;
    msg.bytes[6] = 209;
    msg.bytes[7] = 252;
    msg.bytes[8] = 39;
    msg.bytes[9] = 82;
    msg.bytes[10] = 125;
    msg.bytes[11] = 168;
    msg.bytes[12] = 211;
    msg.bytes[13] = 254;
    msg.bytes[14] = 41;
    msg.bytes[15] = 84;
    msg.bytes[16] = 127;
    aes_cmac(key, msg, 17, out);
    let oi: u32 = 0;
    while oi < 16 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
