    salt.bytes[14] = 62;
    hkdf_extract_sha256(salt, 15, ikm, 39, prk);
    let ci: u32 = 0;
    while ci < 32 { prk_key.bytes[ci] = prk.bytes[ci]; ci = ci + 1; }
    hkdf_expand_sha256(prk_key, info, 15, okm, 63);
    oi = 0;
    while oi < 63 {
        print_int(1000 + (okm.bytes[oi] as u32));
