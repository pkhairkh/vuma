// drbg batch 9 (vector 9)
import "/home/z/my-project/workdir/vuma/womb/crypto/drbg/drbg.vuma"::{DrbgCtx, DrbgData, DrbgOut, drbg_init, drbg_generate};

transform main() -> i32 {
    let drbg = state_new(DrbgCtx);
    let entropy = state_new(DrbgData);
    let out = state_new(DrbgOut);
    entropy.bytes[0] = 153;
    entropy.bytes[1] = 184;
    entropy.bytes[2] = 215;
    entropy.bytes[3] = 246;
    entropy.bytes[4] = 21;
    entropy.bytes[5] = 52;
    entropy.bytes[6] = 83;
    entropy.bytes[7] = 114;
    entropy.bytes[8] = 145;
    entropy.bytes[9] = 176;
    entropy.bytes[10] = 207;
    entropy.bytes[11] = 238;
    entropy.bytes[12] = 13;
    entropy.bytes[13] = 44;
    entropy.bytes[14] = 75;
    entropy.bytes[15] = 106;
    entropy.bytes[16] = 137;
    entropy.bytes[17] = 168;
    entropy.bytes[18] = 199;
    entropy.bytes[19] = 230;
    entropy.bytes[20] = 5;
    entropy.bytes[21] = 36;
    entropy.bytes[22] = 67;
    entropy.bytes[23] = 98;
    entropy.bytes[24] = 129;
    entropy.bytes[25] = 160;
    entropy.bytes[26] = 191;
    entropy.bytes[27] = 222;
    entropy.bytes[28] = 253;
    entropy.bytes[29] = 28;
    entropy.bytes[30] = 59;
    entropy.bytes[31] = 90;
    drbg_init(drbg, entropy, 32, entropy, 0);
    drbg_generate(drbg, out, 32);
    let oi: u32 = 0;
    while oi < 32 {
        print_int(1000 + (out.bytes[oi] as u32));
        oi = oi + 1;
    }
    print_int(999);
    return 0;
}
